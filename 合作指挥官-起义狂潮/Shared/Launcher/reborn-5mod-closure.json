    {
      "name": "Liberty.SC2Mod",
      "description": "官方自由之翼基础数据 mod"
    },
    {
      "name": "Swarm.SC2Mod",
      "description": "官方虫群之心基础数据 mod"
    }
  ],
  "consumers": [
    {
      "name": "RebornBridge.SC2Mod",
      "path": "Mods/Reborn/RebornBridge.SC2Mod",
      "description": "Reborn 桥接 mod，依赖本闭包的全部 5 个 mod"
    },
    {
      "name": "RebornMapAdapter.SC2Mod",
      "path": "Mods/Reborn/RebornMapAdapter.SC2Mod",
      "description": "Reborn 地图适配器，依赖本闭包的全部 5 个 mod"
    }
  ]
}
