{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schemaVersion": 1,
  "closureName": "Reborn5ModClosure",
  "description": "Reborn 地图依赖的 5 个源 mod 容器闭包清单（源包 v0.71）。定义闭包内 mod 的依赖关系、外部依赖和下游消费者，确保同步到 SC2 live 目录时形成完整依赖闭包，不依赖外部未声明的 mod。",
  "sourcePackage": "v0.71",
  "mods": [
    {
      "name": "crys_swarm_assets.SC2Mod",
      "path": "Mods/crys_swarm_assets.SC2Mod",
      "dataCenterId": "Platform.CrysSwarmAssets",
      "dataCenterManifest": "Mods/crys_swarm_assets.DataCenter.json",
      "containerType": "mpq",
      "closureRole": "assets",
      "dependsOn": []
    },
    {
      "name": "sibirens_starhooks_common.SC2Mod",
      "path": "Mods/sibirens_starhooks_common.SC2Mod",
      "dataCenterId": "Platform.SibirensStarhooksCommon",
      "dataCenterManifest": "Mods/sibirens_starhooks_common.DataCenter.json",
      "containerType": "mpq",
      "closureRole": "common",
      "dependsOn": []
    },
    {
      "name": "sibirens_starhooks_swarmstoryutils.SC2Mod",
      "path": "Mods/sibirens_starhooks_swarmstoryutils.SC2Mod",
      "dataCenterId": "Capability.SibirensSwarmStoryUtils",
      "dataCenterManifest": "Mods/sibirens_starhooks_swarmstoryutils.DataCenter.json",
      "containerType": "mpq",
      "closureRole": "story-utils",
      "dependsOn": ["sibirens_starhooks_common.SC2Mod"]
    },
    {
      "name": "sibirens_sundries_swarm_reborn.SC2Mod",
      "path": "Mods/sibirens_sundries_swarm_reborn.SC2Mod",
      "dataCenterId": "Capability.SibirensSundriesReborn",
