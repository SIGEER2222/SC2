      "containerType": "mpq",
      "closureRole": "sundries",
      "dependsOn": ["sibirens_starhooks_common.SC2Mod", "crys_swarm_assets.SC2Mod"]
    },
    {
      "name": "crys_the_swarm_reborn.SC2Mod",
      "path": "Mods/crys_the_swarm_reborn.SC2Mod",
      "dataCenterId": "MapFamily.CrysReborn",
      "dataCenterManifest": "Mods/crys_the_swarm_reborn.SC2Mod/DataCenter.json",
      "containerType": "directory",
      "closureRole": "main-data",
      "dependsOn": [
        "crys_swarm_assets.SC2Mod",
        "sibirens_starhooks_common.SC2Mod",
        "sibirens_starhooks_swarmstoryutils.SC2Mod",
        "sibirens_sundries_swarm_reborn.SC2Mod"
      ]
    }
  ],
  "externalDependencies": [
    {
      "name": "Void.SC2Mod",
      "description": "官方虚空之遗基础数据 mod（SC2 公共依赖）"
