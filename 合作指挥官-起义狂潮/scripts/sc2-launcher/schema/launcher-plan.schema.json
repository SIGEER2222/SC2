{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "launcher-plan.schema.json",
  "title": "LauncherCompatibilityPlan (transitional, CompositionPlan-like)",
  "description": "Transitional plan format emitted by sc2-launcher. Will be replaced by the formal CompositionPlan (scripts/sc2-composer/schema/CompositionPlan.schema.json) once sc2-composer can generate equivalent plans. The 'kind' field is intentionally 'LauncherCompatibilityPlan' (not 'CompositionPlan') to avoid confusing the two formats.",
  "type": "object",
  "required": ["schemaVersion", "kind", "compositionId", "mapProfile", "slots", "dependencyLayers", "galaxyInjection", "documentRewrite", "validation", "migration"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "LauncherCompatibilityPlan" },
    "compositionId": { "type": "string", "minLength": 1 },
    "mapProfile": { "type": "string", "minLength": 1 },
    "sourceMap": { "type": "string" },
    "generatedMap": { "type": "string" },
    "slots": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["commander"],
        "properties": {
          "commander": { "type": "string", "minLength": 1 },
          "commanderPackage": { "type": "string" }
        }
      }
    },
    "dependencyLayers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["layer", "name", "entries"],
        "properties": {
          "layer": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "source": { "type": "string" },
                "reason": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "galaxyInjection": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "owner", "reason"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "owner": { "type": "string" },
          "source": { "type": "string" },
          "reason": { "type": "string" },
          "selectedCommanderRequired": { "type": "boolean" },
          "compatibilityOnly": { "type": "boolean" }
        }
      }
    },
    "documentRewrite": {
      "type": "object",
      "required": ["DocumentHeader", "DocumentInfo"],
      "properties": {
        "DocumentHeader": { "type": "array", "items": { "type": "string" } },
        "DocumentInfo": { "type": "array", "items": { "type": "string" } }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "configSchema": { "type": "string" },
        "documentRoundtrip": { "type": "string" },
        "galaxyChecker": { "type": "string" },
        "runtimeSmoke": { "type": "string" }
      }
    },
    "migration": {
      "type": "object",
      "description": "Declares this format is transitional and how it maps to the formal CompositionPlan.",
      "required": ["targetSchema", "status"],
      "properties": {
        "targetSchema": {
          "type": "string",
          "const": "scripts/sc2-composer/schema/CompositionPlan.schema.json"
        },
        "status": {
          "type": "string",
          "enum": ["transitional", "deprecated", "migrated"]
        },
        "knownDebt": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "reason", "removalCondition"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "reason": { "type": "string" },
              "removalCondition": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
