{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "alenger-mods.schema.json",
  "title": "Alenger mod set required by CoreRuntime AdapterBootstrap",
  "type": "object",
  "required": ["mods", "dependencyPaths"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "description": { "type": "string" },
    "mods": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "dependencyPaths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
