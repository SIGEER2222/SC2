{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "commander-units-mapping.schema.json",
  "title": "Commander → CommanderUnits mod suffix mapping",
  "type": "object",
  "required": ["mappings"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "description": { "type": "string" },
    "mappings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 },
      "description": "Commander id → CommanderUnits mod suffix (e.g. TerranRaynor → Raynor)"
    }
  }
}
