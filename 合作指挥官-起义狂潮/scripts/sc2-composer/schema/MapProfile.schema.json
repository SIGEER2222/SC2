{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MapProfile",
  "description": "地图机器可读契约，描述地图族、指挥官槽位、依赖、Bank 保护与胜负条件。基于现有 zexpedition03.json 结构。详见 docs/指挥官地图组合框架设计.md 第 4.4 节。",
  "type": "object",
  "required": [
    "schemaVersion",
    "mapFamily",
    "mapId",
    "mapName",
    "mapAdapter",
    "entryType",
    "commanderSlots",
    "pairPatches",
    "requiredDependencies",
    "bankProtection",
    "victoryCondition",
    "defeatCondition"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Schema 版本号，当前固定为 1。"
    },
    "mapFamily": {
      "type": "string",
      "description": "地图族 ID，如 RebornHotS、7vs1、XM。同族地图共享 MapAdapter。",
      "minLength": 1
    },
    "mapId": {
      "type": "string",
      "description": "地图唯一 ID，如 ZExpedition3。",
      "minLength": 1
    },
    "mapName": {
      "type": "string",
      "description": "地图显示名称，如 Harvest of Screams。",
      "minLength": 1
    },
    "mapAdapter": {
      "type": "string",
      "description": "地图适配器标识，决定生命周期 hook 映射，如 reborn、7vs1。",
      "minLength": 1
    },
    "entryType": {
      "type": "string",
      "enum": ["direct", "indirect"],
      "description": "地图入口类型。direct=直接启动地图；indirect=需通过中间启动器加载。"
    },
    "commanderSlots": {
      "type": "array",
      "description": "可用指挥官槽位列表。commanderId 可为空表示运行时选择。",
      "items": {
        "type": "object",
        "required": ["slotIndex", "playerId"],
        "additionalProperties": false,
        "properties": {
          "slotIndex": {
            "type": "integer",
            "minimum": 0,
            "description": "槽位序号，从 0 开始。"
          },
          "playerId": {
            "type": "integer",
            "minimum": 1,
            "description": "对应的 SC2 玩家 ID。"
          },
          "commanderId": {
            "type": ["string", "null"],
            "description": "指挥官 ID，如 TerranRaynor。为 null 表示运行时由用户选择。"
          },
          "startPosition": {
            "type": ["string", "null"],
            "description": "出生点标识，default 表示使用地图默认出生点。"
          },
          "allowRuntimeOverride": {
            "type": "boolean",
            "description": "允许运行时通过启动参数覆盖指挥官选择。true 表示当 commanderId 为 null 时由启动器解析实际指挥官。"
          }
        }
      },
      "minItems": 1
    },
    "pairPatches": {
      "type": "array",
      "description": "特定指挥官与地图组合所需的补丁清单。",
      "items": {
        "type": "object",
        "required": ["commanderId", "patchPath"],
        "additionalProperties": false,
        "properties": {
          "commanderId": {
            "type": "string",
            "description": "目标指挥官 ID。"
          },
          "patchPath": {
            "type": "string",
            "description": "PairPatch manifest 相对路径。"
          },
          "reason": {
            "type": "string",
            "description": "补丁存在原因。"
          }
        }
      }
    },
    "requiredDependencies": {
      "type": "object",
      "description": "地图所需依赖声明。always 为始终加载；commander 为按选中指挥官展开。",
      "required": ["always"],
      "additionalProperties": false,
      "properties": {
        "always": {
          "type": "array",
          "description": "始终加载的依赖列表，支持 file: 前缀。",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "commander": {
          "type": "array",
          "description": "按指挥官展开的依赖列表，每个条目对应一个 commanderId。",
          "items": {
            "type": "object",
            "required": ["commanderId", "dependencies"],
            "additionalProperties": false,
            "properties": {
              "commanderId": {
                "type": "string",
                "description": "指挥官 ID。"
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "该指挥官所需的额外依赖。"
              }
            }
          }
        }
      }
    },
    "bankProtection": {
      "type": "object",
      "description": "Bank 保护配置，防止指挥官运行时误写剧情 Bank。",
      "required": ["protectedBanks", "playerBanks"],
      "additionalProperties": false,
      "properties": {
        "protectedBanks": {
          "type": "array",
          "description": "受保护的地图/剧情 Bank 名称列表，指挥官运行时禁止写入。",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "playerBanks": {
          "type": "object",
          "description": "玩家 ID 到指挥官 Bank 名称的映射，如 {\"1\": \"cryswarmcoop\"}。",
          "patternProperties": {
            "^[0-9]+$": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    "victoryCondition": {
      "type": "object",
      "description": "胜利条件声明。",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["native", "custom"],
          "description": "native=使用地图原生胜利触发器；custom=由组合 bootstrap 控制。"
        },
        "trigger": {
          "type": "string",
          "description": "Galaxy 触发器函数名，type 为 native 时必填。"
        }
      }
    },
    "defeatCondition": {
      "type": "object",
      "description": "失败条件声明。",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["native", "custom"],
          "description": "native=使用地图原生失败触发器；custom=由组合 bootstrap 控制。"
        },
        "trigger": {
          "type": "string",
          "description": "Galaxy 触发器函数名，type 为 native 时必填。"
        }
      }
    }
  }
}
