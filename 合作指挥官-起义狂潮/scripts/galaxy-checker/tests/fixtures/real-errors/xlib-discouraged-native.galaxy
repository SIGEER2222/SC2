void libKMIS_gf_TestCreateUnits(int lp_p, point lp_location) {
    // 可安全转换 - createStyle=c_unitCreateIgnorePlacement
    UnitCreate(1, "Marine", c_unitCreateIgnorePlacement, lp_p, lp_location, 270.0);
    // 可安全转换 - 常量 createStyle
    UnitCreate(1, "ZergDropPod", c_unitCreateIgnorePlacement, lp_p, lp_location, 270.0);
    // 不安全 - createStyle=0（c_unitCreateConstruct），转换会改变放置验证行为
    string lv_unitType = "Marine";
    int lp_flags = 0;
    point lv_placement = lp_location;
    fixed lp_facing = 270.0;
    UnitCreate(1, lv_unitType, lp_flags, lp_p, lv_placement, lp_facing);
    // 不安全 - createStyle=0
    UnitCreate(1, "ProphecyCamera", 0, lp_p, UnitGetPosition(lp_location), libNtve_gf_RandomAngle());
}
