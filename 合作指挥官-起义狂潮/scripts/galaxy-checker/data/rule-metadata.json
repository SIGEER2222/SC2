{
  "version": "1.0",
  "description": "规则工程化元数据，与 ADR 冻结的语义对齐。由 IssueEnricher 在报告生成时注入。",
  "rules": {
    "XLIB_MISSING_INCLUDE": {
      "confidence": "low",
      "autoFixable": false,
      "runtimeRisk": "low",
      "suggestedOwner": "CompositionPlan.resolver",
      "notes": "无 CompositionPlan 时 95% 误报；有上下文后升为 high confidence"
    },
    "XLIB_UNDEFINED_CROSS_REF": {
      "confidence": "low",
      "autoFixable": false,
      "runtimeRisk": "high",
      "suggestedOwner": "CompositionPlan.resolver",
      "notes": "无 CompositionPlan 时 95% 误报；真实错误会导致 ScriptError"
    },
    "CATALOG_INVALID_UNIT_REF": {
      "confidence": "medium",
      "autoFixable": false,
      "runtimeRisk": "medium",
      "suggestedOwner": "DataCenter.catalogExporter",
      "notes": "部分误报（catalog-ids.json 未含全部 mod）；真实缺失会导致运行时创建失败"
    },
    "SEM_UNDECLARED_VARIABLE": {
      "confidence": "low",
      "autoFixable": false,
      "runtimeRisk": "high",
      "suggestedOwner": "CompositionPlan.resolver",
      "notes": "无 CompositionPlan 时 95% 误报（变量定义在父级 mod）；真实错误会导致 ScriptError"
    },
    "XLIB_DISCOURAGED_NATIVE": {
      "confidence": "high",
      "autoFixable": true,
      "runtimeRisk": "low",
      "suggestedOwner": "Fixer.UnitCreateWrapper",
      "notes": "100% 真实问题；UnitCreate 可自动包装为 libNtve_gf_CreateUnitsAtPoint2"
    },
    "XLIB_DISALLOWED_NATIVE": {
      "confidence": "high",
      "autoFixable": false,
      "runtimeRisk": "high",
      "suggestedOwner": "manual",
      "notes": "黑名单 native，需人工修复"
    },
    "SEM_UNDECLARED_FUNCTION": {
      "confidence": "low",
      "autoFixable": false,
      "runtimeRisk": "high",
      "suggestedOwner": "CompositionPlan.resolver"
    },
    "SEM_ARGUMENT_COUNT_MISMATCH": {
      "confidence": "high",
      "autoFixable": false,
      "runtimeRisk": "medium",
      "suggestedOwner": "manual"
    },
    "SEM_DUPLICATE_DECLARATION": {
      "confidence": "high",
      "autoFixable": false,
      "runtimeRisk": "medium",
      "suggestedOwner": "manual"
    },
    "SEM_VOID_IN_CONDITION": {
      "confidence": "high",
      "autoFixable": false,
      "runtimeRisk": "medium",
      "suggestedOwner": "manual"
    },
    "SEM_RETURN_TYPE_MISMATCH": {
      "confidence": "high",
      "autoFixable": false,
      "runtimeRisk": "low",
      "suggestedOwner": "manual"
    },
    "SEM_ASSIGNMENT_TYPE_MISMATCH": {
      "confidence": "high",
      "autoFixable": false,
      "runtimeRisk": "low",
      "suggestedOwner": "manual"
    },
    "SYNTAX_PARSE_ERROR": {
      "confidence": "high",
      "autoFixable": false,
      "runtimeRisk": "high",
      "suggestedOwner": "manual"
    },
    "PROJ_UTF8_BOM": {
      "confidence": "high",
      "autoFixable": true,
      "runtimeRisk": "high",
      "suggestedOwner": "Fixer.BomStripper"
    },
    "PROJ_ENCODING_INVALID": {
      "confidence": "high",
      "autoFixable": false,
      "runtimeRisk": "medium",
      "suggestedOwner": "manual"
    }
  },
  "contextDependentRules": [
    "XLIB_MISSING_INCLUDE",
    "XLIB_UNDEFINED_CROSS_REF",
    "SEM_UNDECLARED_VARIABLE",
    "SEM_UNDECLARED_FUNCTION"
  ],
  "contextUpgradeConfidence": {
    "low": "high",
    "medium": "high"
