void SoundPlayScene(soundlink lp_soundLink, playergroup lp_players, unitgroup lp_units, string lp_animation);
void SoundPlay(soundlink lp_soundLink, playergroup lp_players, fixed lp_volume, fixed lp_offset);
void SoundPlayOnUnit(soundlink lp_soundLink, playergroup lp_players, unit lp_unit, fixed lp_height, fixed lp_volume, fixed lp_offset);
void SoundPlayAtPoint(soundlink lp_soundLink, playergroup lp_players, point lp_location, fixed lp_height, fixed lp_volume, fixed lp_offset);
