{
  "name": "galaxy-checker",
  "version": "0.1.0",
  "description": "Galaxy 脚本静态检查器（AI 可调用）",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "galaxy-check": "dist/cli.mjs",
    "galaxy-checker-baseline": "dist/baseline-compare.mjs"
  },
  "scripts": {
    "build": "tsc && esbuild dist/cli.js --bundle --platform=node --format=esm --outfile=dist/cli.mjs && esbuild dist/baseline-compare.js --bundle --platform=node --format=esm --outfile=dist/baseline-compare.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chevrotain": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
