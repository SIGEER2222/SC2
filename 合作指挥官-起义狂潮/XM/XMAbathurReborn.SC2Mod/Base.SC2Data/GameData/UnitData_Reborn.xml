<?xml version="1.0" encoding="utf-8"?>
<Catalog>
    <!-- ===== Stage 2-B: 9 Conflict Units (Reborn versions, parent=original) ===== -->
    <!-- 每个 Reborn 单位继承目标 mod 原单位的全部属性，仅替换 CardLayouts 为 Reborn Purchase 按钮。 -->
    <!-- 不引用源 mod 的非 Abathur 能力（NPSwarm/MalevolentOmen/ShadowofChange 等），避免目标 mod 中不存在时报错。 -->

    <!-- 1. BrutaliskReborn：3 个 Brutalisk Purchase -->
    <CUnit id="BrutaliskReborn" parent="Brutalisk">
        <AbilArray Link="BrutaliskTramplingCarapacePurchaseReborn"/>
        <AbilArray Link="BrutaliskSavageRendPurchaseReborn"/>
        <AbilArray Link="BrutaliskFleshRecompositionPurchaseReborn"/>
        <CardLayouts index="0">
            <LayoutButtons Face="BrutaliskTramplingCarapaceReborn" Type="AbilCmd" AbilCmd="BrutaliskTramplingCarapacePurchaseReborn,Execute" Row="1" Column="0"/>
            <LayoutButtons Face="BrutaliskSavageRendReborn" Type="AbilCmd" AbilCmd="BrutaliskSavageRendPurchaseReborn,Execute" Row="1" Column="1"/>
            <LayoutButtons Face="BrutaliskFleshRecompositionReborn" Type="AbilCmd" AbilCmd="BrutaliskFleshRecompositionPurchaseReborn,Execute" Row="1" Column="2"/>
        </CardLayouts>
    </CUnit>

