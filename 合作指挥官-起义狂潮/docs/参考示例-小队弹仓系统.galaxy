//==================================================================================================
// 小队弹仓系统 - 独立参考实现
//
// 模仿巢虫领主(CBroodLord)的 CAbilArmMagazine 弹仓机制：
//   - 英雄单位携带一支小队，初始 2 个成员，最大补充到 4 个
//   - 每 6 秒补充一个空槽位（清理死亡成员后补满）
//   - 每 2 秒检查跟随距离，距离英雄 > 3 则移动到英雄附近
//   - 英雄头上显示"小队: X/4"槽位数（模仿航母的拦截机计数显示）
//   - 小队成员移速(2.8) > 英雄移速(2.25)，避免跟丢
//
// 实现方式：方案B - 触发器手动管理（不依赖 CAbilArmMagazine 数据定义，
//           纯 galaxy 触发器模拟，便于在没有单位数据修改权限的地图上复用）
//
// 关键 API：
//   - libNtve_gf_CreateUnitsWithDefaultFacing  生成单位（不要直接用 UnitCreate，会编译失败）
//   - UnitSetPropertyFixed(unit, c_unitPropMovementSpeed, value)  设置移速
//   - UnitSetInfoText(unit, info, tip, subTip)  头顶信息显示
//   - TimerCreate / TimerStart(timer, period, repeat, c_timeGame)  周期定时器
//   - TriggerAddEventTimer(trigger, timer)  定时器事件绑定
//   - UnitIssueOrder(unit, OrderTargetingPoint(AbilityCommand("move",0), point), queue)  下达移动命令
//
// 常见陷阱（galaxy-checker 的 SEM_INVALID_TEXT_CONCAT 规则可静态检测）：
//   ✗ StringToText("小队: ") + IntToText(1)        // text + text 非法，SC2 编译报"不正确的类型"
//   ✓ StringToText("小队: " + IntToString(1))       // 先 string 拼接，再转 text
//
// 测试地图：Maps/光晕测试 by Pirate.SC2Map（仅依赖 Liberty mod）
//==================================================================================================

//--------------------------------------------------------------------------------------------------
// 全局变量
//--------------------------------------------------------------------------------------------------
unit    gv_hero;              // 英雄单位
unit[4] gv_squad;             // 小队成员槽位（固定 4 槽，null 表示空槽）
trigger gt_spawnHero;         // 地图初始化：生成英雄 + 初始小队 + 启动定时器
trigger gt_replenish;         // 周期补充：每 6 秒清理死亡成员并补充空槽
trigger gt_followHero;        // 周期跟随：每 2 秒让远离的小队成员移动到英雄附近
timer   gv_replenishTimer;    // 补充定时器（6 秒周期）
timer   gv_followTimer;       // 跟随定时器（2 秒周期）

//--------------------------------------------------------------------------------------------------
// 触发器1：地图初始化 - 生成英雄 + 初始2个Marine + 启动周期定时器
//--------------------------------------------------------------------------------------------------
bool gt_spawnHero_Func (bool testConds, bool runActions) {
    point lv_center;
    point lv_heroPos;
    fixed lv_x;
    fixed lv_y;

    if (!runActions) {
        return true;
    }

    // 初始资源（测试用）
    PlayerModifyPropertyInt(1, c_playerPropMinerals, c_playerPropOperSetTo, 99999);
    PlayerModifyPropertyInt(1, c_playerPropVespene, c_playerPropOperSetTo, 99999);
    PlayerModifyPropertyInt(1, c_playerPropSuppliesLimit, c_playerPropOperSetTo, 500);

    // 在可玩区域中心生成英雄
    // 注意：用 Marine 作为英雄（光晕地图仅依赖 Liberty mod，无 RaynorMarine）
    lv_center = RegionGetCenter(RegionPlayableMap());
    lv_x = PointGetX(lv_center);
    lv_y = PointGetY(lv_center);
    // 保护：确保 y 坐标非负，避免单位生成失败
    if (lv_y < 5.0) {
        lv_y = 5.0;
    }
    lv_heroPos = Point(lv_x, lv_y);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "Marine", c_unitCreateIgnorePlacement, 1, lv_heroPos);
    gv_hero = UnitLastCreated();

    // 初始 2 个 Marine，分布在英雄两侧
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "Marine", c_unitCreateIgnorePlacement, 1, Point(lv_x + 2.0, lv_y));
    gv_squad[0] = UnitLastCreated();
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "Marine", c_unitCreateIgnorePlacement, 1, Point(lv_x - 2.0, lv_y));
    gv_squad[1] = UnitLastCreated();
    gv_squad[2] = null;
    gv_squad[3] = null;

    // 给小队 Marine 设置更高移速（2.8 > 英雄Marine 2.25），避免跟丢
    UnitSetPropertyFixed(gv_squad[0], c_unitPropMovementSpeed, 2.8);
    UnitSetPropertyFixed(gv_squad[1], c_unitPropMovementSpeed, 2.8);

    // 英雄头上显示"弹仓系统"技能信息和初始槽位数（模仿航母拦截机计数）
    UnitSetInfoText(gv_hero, StringToText("小队: 2/4"), StringToText("弹仓系统"), StringToText("模仿巢虫领主弹仓"));

    // 选中英雄，方便玩家操作
    UnitSelect(gv_hero, 1, true);

    // 启动周期定时器：补充(6秒) + 跟随(2秒)
    // 注意：触发器在 _Init 中默认 disabled，这里显式 enable
    gv_replenishTimer = TimerCreate();
    TimerStart(gv_replenishTimer, 6.0, true, c_timeGame);
    TriggerAddEventTimer(gt_replenish, gv_replenishTimer);
    TriggerEnable(gt_replenish, true);

    gv_followTimer = TimerCreate();
    TimerStart(gv_followTimer, 2.0, true, c_timeGame);
    TriggerAddEventTimer(gt_followHero, gv_followTimer);
    TriggerEnable(gt_followHero, true);

    // 调试输出
    TriggerDebugOutput(1, StringToText("[SQUAD] 英雄已生成 + 初始2个Marine小队, 定时器已启动"), false);

    return true;
}

void gt_spawnHero_Init () {
    gt_spawnHero = TriggerCreate("gt_spawnHero_Func");
    TriggerAddEventMapInit(gt_spawnHero);
}

//--------------------------------------------------------------------------------------------------
// 触发器2：周期补充（每6秒）- 清理死亡成员 + 补充空槽到最大4个
//--------------------------------------------------------------------------------------------------
bool gt_replenish_Func (bool testConds, bool runActions) {
    int lv_i;
    int lv_emptySlot;
    int lv_aliveCount;
    point lv_heroPos;
    fixed lv_x;
    fixed lv_y;

    if (!runActions) {
        return true;
    }

    // 英雄死亡则不补充
    if (gv_hero == null || !UnitIsAlive(gv_hero)) {
        return true;
    }

    // 清理已死的小队成员槽位
    for (lv_i = 0; lv_i <= 3; lv_i += 1) {
        if (gv_squad[lv_i] != null) {
            if (!UnitIsAlive(gv_squad[lv_i])) {
                gv_squad[lv_i] = null;
            }
        }
    }

    // 找第一个空槽补充
    lv_emptySlot = -1;
    for (lv_i = 0; lv_i <= 3; lv_i += 1) {
        if (gv_squad[lv_i] == null) {
            lv_emptySlot = lv_i;
            break;
        }
    }

    if (lv_emptySlot >= 0) {
        lv_heroPos = UnitGetPosition(gv_hero);
        lv_x = PointGetX(lv_heroPos);
        lv_y = PointGetY(lv_heroPos);
        if (lv_y < 5.0) {
            lv_y = 5.0;
        }
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "Marine", c_unitCreateIgnorePlacement, 1, Point(lv_x + 2.0, lv_y + 2.0));
        gv_squad[lv_emptySlot] = UnitLastCreated();
        // 给小队 Marine 设置更高移速，避免跟丢
        UnitSetPropertyFixed(gv_squad[lv_emptySlot], c_unitPropMovementSpeed, 2.8);
        // 注意：string 拼接后再 StringToText，不能用 text + text
        TriggerDebugOutput(1, StringToText("[SQUAD] 补充Marine到槽位" + IntToString(lv_emptySlot)), false);
    }

    // 统计当前存活小队数量并更新英雄头上的槽位显示
    lv_aliveCount = 0;
    for (lv_i = 0; lv_i <= 3; lv_i += 1) {
        if (gv_squad[lv_i] != null && UnitIsAlive(gv_squad[lv_i])) {
            lv_aliveCount += 1;
        }
    }
    UnitSetInfoText(gv_hero, StringToText("小队: " + IntToString(lv_aliveCount) + "/4"), StringToText("弹仓系统"), StringToText(""));
    TriggerDebugOutput(1, StringToText("[SQUAD] 当前小队数量=" + IntToString(lv_aliveCount) + "/4"), false);

    return true;
}

void gt_replenish_Init () {
    gt_replenish = TriggerCreate("gt_replenish_Func");
    // 默认 disabled，由 gt_spawnHero_Func 在启动定时器时 enable
    TriggerEnable(gt_replenish, false);
}

//--------------------------------------------------------------------------------------------------
// 触发器3：周期跟随（每2秒）- 距离英雄 > 3 则移动到英雄附近
//--------------------------------------------------------------------------------------------------
bool gt_followHero_Func (bool testConds, bool runActions) {
    int lv_i;
    point lv_heroPos;
    point lv_marinePos;
    fixed lv_distSq;

    if (!runActions) {
        return true;
    }

    // 英雄死亡则不跟随
    if (gv_hero == null || !UnitIsAlive(gv_hero)) {
        return true;
    }

    lv_heroPos = UnitGetPosition(gv_hero);

    for (lv_i = 0; lv_i <= 3; lv_i += 1) {
        if (gv_squad[lv_i] != null && UnitIsAlive(gv_squad[lv_i])) {
            lv_marinePos = UnitGetPosition(gv_squad[lv_i]);
            // 距离平方 > 9（即距离 > 3）才下达移动命令，缩短跟随距离避免散开过远
            lv_distSq = ((PointGetX(lv_marinePos) - PointGetX(lv_heroPos)) * (PointGetX(lv_marinePos) - PointGetX(lv_heroPos))) + ((PointGetY(lv_marinePos) - PointGetY(lv_heroPos)) * (PointGetY(lv_marinePos) - PointGetY(lv_heroPos)));
            if (lv_distSq > 9.0) {
                UnitIssueOrder(gv_squad[lv_i], OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffset(lv_heroPos, 2.0, 0.0)), c_orderQueueAddToEnd);
            }
        }
    }

    return true;
}

void gt_followHero_Init () {
    gt_followHero = TriggerCreate("gt_followHero_Func");
    // 默认 disabled，由 gt_spawnHero_Func 在启动定时器时 enable
    TriggerEnable(gt_followHero, false);
}

//--------------------------------------------------------------------------------------------------
// 触发器初始化（在 InitTriggers 中调用）
//--------------------------------------------------------------------------------------------------
// gt_spawnHero_Init();
// gt_replenish_Init();
// gt_followHero_Init();
