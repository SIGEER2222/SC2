//--------------------------------------------------------------------------------------------------
// Trigger: Orbital Scans
//--------------------------------------------------------------------------------------------------
bool gt_OrbitalScans_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup auto16139802_g;
    int auto16139802_u;
    unit auto16139802_var;

    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == gv_pLAYER02_TOSH))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    Wait(1.0, c_timeGame);
    if ((UnitGroupCount(UnitGroupAlliance(gv_pLAYER02_TOSH, c_unitAllianceEnemy, RegionCircle(UnitGetPosition(EventUnit()), 15.0), UnitFilter((1 << c_targetFilterCloaked), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) > 0)) {
        auto16139802_g = UnitGroup("OrbitalCommand", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        auto16139802_u = UnitGroupCount(auto16139802_g, c_unitCountAll);
        for (;; auto16139802_u -= 1) {
            auto16139802_var = UnitGroupUnitFromEnd(auto16139802_g, auto16139802_u);
            if (auto16139802_var == null) { break; }
            if ((UnitGetPropertyFixed(auto16139802_var, c_unitPropEnergy, c_unitPropCurrent) >= 50.0) && (libNtve_gf_UnitInRegion(EventUnitDamageSourceUnit(), RegionCircle(UnitGetPosition(auto16139802_var), 50.0)) == true)) {
                UnitIssueOrder(auto16139802_var, OrderTargetingPoint(AbilityCommand("ScannerSweep", 0), UnitGetPosition(EventUnitDamageSourceUnit())), c_orderQueueReplace);
                if ((gv_scanPerformed == false)) {
                    gv_scanPerformed = true;
                    TriggerQueueEnter();
                    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
                    libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
                    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TTosh03BTosh00052", 0), c_transmissionDurationAdd, 0.0, true);
                    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
                    TriggerQueueExit();
                }

                TriggerEnable(TriggerGetCurrent(), false);
                Wait(12.0, c_timeGame);
                TriggerEnable(TriggerGetCurrent(), true);
                break;
            }

        }
    }

    return true;
}

