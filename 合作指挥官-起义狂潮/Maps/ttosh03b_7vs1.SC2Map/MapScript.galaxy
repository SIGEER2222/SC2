        UnitBehaviorAdd(auto1757DA24_var, "Detector20", auto1757DA24_var, 1);
    }
    TriggerEnable(gt_EndTrapPhase, true);
    Wait(libNtve_gf_DifficultyValueFixed(90.0, 90.0, 70.0, 50.0), c_timeGame);
    gv_sENDMORE = true;
    return true;
}

