//--------------------------------------------------------------------------------------------------
// Trigger: Aggressive Enemies
//--------------------------------------------------------------------------------------------------
bool gt_AggressiveEnemies_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup autoBD074AB8_g;
    int autoBD074AB8_u;
    unit autoBD074AB8_var;

    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnitDamageSourceUnit()) == 1))) {
            return false;
        }

        if (!((UnitGetOwner(EventUnit()) != 1))) {
            return false;
        }

        if (!((UnitGetOwner(EventUnit()) == gv_pLAYER02_TOSH))) {
            return false;
        }

        if (!((UnitGetOwner(EventUnit()) != gv_pLAYER05_ULTRA))) {
            return false;
        }

        if (!((UnitGetOwner(EventUnit()) != gv_pLAYER8_REINFORCEMENTS))) {
            return false;
        }

        if (!(((UnitGetType(EventUnit()) != "WidowMineBurrowed") || (UnitGetType(EventUnit()) != "SwarmHostBurrowedMP")))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    AISetUnitSuicide(EventUnit(), true);
    AISetUnitScriptControlled(EventUnit(), false);
    UnitGroupAdd(gv_aggroGroup, EventUnit());
    autoBD074AB8_g = UnitGroup(null, gv_pLAYER02_TOSH, RegionCircle(UnitGetPosition(EventUnit()), 8.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    autoBD074AB8_u = UnitGroupCount(autoBD074AB8_g, c_unitCountAll);
    for (;; autoBD074AB8_u -= 1) {
        autoBD074AB8_var = UnitGroupUnitFromEnd(autoBD074AB8_g, autoBD074AB8_u);
        if (autoBD074AB8_var == null) { break; }
        if ((UnitGetType(autoBD074AB8_var) != "WidowMineBurrowed") && (UnitGetType(autoBD074AB8_var) != "SwarmHostBurrowedMP")) {
            AISetUnitSuicide(autoBD074AB8_var, true);
            AISetUnitScriptControlled(autoBD074AB8_var, false);
            UnitGroupAdd(gv_aggroGroup, autoBD074AB8_var);
        }

    }
    return true;
}

