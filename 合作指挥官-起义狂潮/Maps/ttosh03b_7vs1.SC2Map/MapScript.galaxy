//--------------------------------------------------------------------------------------------------
// Trigger: Start Game Q
//--------------------------------------------------------------------------------------------------
bool gt_StartGameQ_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    libE0EAE146_gf_StartGame();
    lib67C0F0E7_gf_ObjectiveNew(true, StringExternal("Param/Value/8704BF80"), 1, false, 0, 0);
    lib67C0F0E7_gf_ObjectiveNew(true, StringExternal("Param/Value/D9382FC1"), 2, false, 0, 0);
    lib67C0F0E7_gf_ObjectiveNew(true, StringExternal("Param/Value/2C828FC0"), 3, false, 0, 0);
    lib67C0F0E7_gf_ObjectiveNew(false, StringExternal("Param/Value/BCDBA433"), 1, true, 0, 2);
    lib67C0F0E7_gf_ObjectiveNew(false, StringExternal("Param/Value/0A63D7D6"), 2, true, 0, UnitCount("Spectre", 2, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    Wait(2.0, c_timeReal);
    lib67C0F0E7_gf_ObjectiveSet(true, 1, lib67C0F0E7_ge_ObjectiveSet_Show);
    Wait(2.0, c_timeGame);
    lib67C0F0E7_gf_ObjectiveSet(true, 2, lib67C0F0E7_ge_ObjectiveSet_Show);
    Wait(2.0, c_timeReal);
    lib67C0F0E7_gf_ObjectiveSet(true, 3, lib67C0F0E7_ge_ObjectiveSet_Show);
    TriggerQueueEnter();
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
    libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
    // Transmission - SoundLink("TTosh03BRaynor00016", 0)
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TTosh03BRaynor00016", 0), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TTosh03BNova00002", 0), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    lib67C0F0E7_gf_ObjectiveSet(false, 1, lib67C0F0E7_ge_ObjectiveSet_Show);
    lib67C0F0E7_gf_ObjectiveSet(false, 2, lib67C0F0E7_ge_ObjectiveSet_Show);
    TriggerQueueExit();
    return true;
}

