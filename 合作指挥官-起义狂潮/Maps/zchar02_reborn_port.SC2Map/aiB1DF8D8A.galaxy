    aiB1DF8D8A_wave6_run(p, target, true);
    aiB1DF8D8A_wave7_run(p, target, true);

    while (true) {
        aiB1DF8D8A_wave4_run(p, target, true);
        aiB1DF8D8A_wave5_run(p, target, true);
        aiB1DF8D8A_wave6_run(p, target, true);
        aiB1DF8D8A_wave7_run(p, target, true);
    }

    return true;
}

