bool aiB1DF8D8A_waves_runFunc (bool c, bool a) {
    int p = aiB1DF8D8A_waves_runPlayer;
    playergroup target = aiB1DF8D8A_waves_runTarget;

    if (p < 0 || p >= 16) {
        return false;
    }

