    int p = aiB1DF8D8A_wave1_runPlayer;
    playergroup target = aiB1DF8D8A_wave1_runTarget;
    int d;
    point gatherPoint = null;
    int ta = 0;
    int tg = 0;
    int ts = 0;
    int tf = 0;
    int td = 0;

    if (p < 0 || p >= 16) {
        return false;
    }
    d = PlayerDifficulty(p);
    if (!aiB1DF8D8A_wave1_enabled[p]) {
        td = 0;
        if (td > 0) {
            Wait(td, c_timeAI);
        }
        return true;
    }

    aiB1DF8D8A_customData[p] = "";

    ta = 0;
    if (d == 1) { ta = 120; }
    if (d == 2) { ta = 120; }
    if (d == 3) { ta = 120; }
    if (d == 4) { ta = 120; }
    tg = 0;
    ts = ta;
    if (tg > 0 && tg < ta) {
        Wait(ta - tg, c_timeAI);
        ts = tg;
    }
    AIAttackWaveSetTargetPlayer(p, target);

    gatherPoint = aiB1DF8D8A_defGather[p];
    AIAttackWaveSetGatherPoint(p, gatherPoint);

    AIAttackWaveClearWaypoints(p);

    AIAttackWaveAddUnits(2, 10, "ZerglingToxic");
    AIAttackWaveAddUnits(3, 10, "ZerglingToxic");
    AIAttackWaveAddUnits(4, 10, "ZerglingToxic");
    AIAttackWaveAddUnits(5, 10, "ZerglingToxic");

    AIAttackWaveSend(p, ts, false);
    aiB1DF8D8A_wave1_lastWave[p] = WaveLastCreated();
    aiB1DF8D8A_lastWave[p] = aiB1DF8D8A_wave1_lastWave[p];
    Wait(ts, c_timeAI);
    tf = 0;
    if (tf > 0) {
        Wait(tf, c_timeAI);
    }

    return true;
}

