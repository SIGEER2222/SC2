void libE0EAE146_gf_AbathurRebornSetUpgradeAtLeast (int lp_player, string lp_upgrade, int lp_level) {
    int lv_currentLevel;

    lv_currentLevel = TechTreeUpgradeCount(lp_player, lp_upgrade, c_techCountCompleteOnly);
    if (lv_currentLevel < lp_level) {
        TechTreeUpgradeAddLevel(lp_player, lp_upgrade, (lp_level - lv_currentLevel));
    }
}

bool libE0EAE146_gf_AbathurRebornSeedBankStringIfEmpty (string lp_section, string lp_key, string lp_value) {
    if ((BankKeyExists(BankLastCreated(), lp_section, lp_key) == false) || (BankValueGetAsString(BankLastCreated(), lp_section, lp_key) == "")) {
        BankValueSetFromString(BankLastCreated(), lp_section, lp_key, lp_value);
        return true;
    }
    return false;
}

