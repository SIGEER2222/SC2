//--------------------------------------------------------------------------------------------------
// Trigger: Hybridforschung
//--------------------------------------------------------------------------------------------------
bool gt_Hybridforschung_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_SetAlliance(1, 3, 7);
    UnitIssueOrder(EventUnit(), Order(AbilityCommand("move", 2)), c_orderQueueReplace);
    VisRevealArea(1, RegionFromId(11), 25.0, false);
    libNtve_gf_CinematicMode(true, PlayerGroupAll(), c_transitionDurationDefault);
    CinematicFade(false, 1.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    CameraApplyInfo(1, CameraInfoFromId(679), 0.0, -1, 10, true);
    CinematicFade(true, 1.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/48410BCF"));
    Wait(5.0, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/BF0824E5"));
    Wait(8.0, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/A23D3C92"));
    Wait(7.0, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UnitRemove(UnitFromId(161));
    Wait(1.0, c_timeGame);
    CameraApplyInfo(1, CameraInfoFromId(730), 2.5, -1, 10, true);
    Wait(2.0, c_timeGame);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/4DF8F059"));
    Wait(4.0, c_timeGame);
    CinematicFade(false, 1.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    CameraApplyInfo(1, CameraInfoFromId(742), 0.0, -1, 10, true);
    CinematicFade(true, 0.5, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    CinematicFade(false, 0.5, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    CameraApplyInfo(1, CameraInfoFromId(741), 0.0, -1, 10, true);
    CinematicFade(true, 3.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    libNtve_gf_CinematicMode(false, PlayerGroupAll(), c_transitionDurationDefault);
    Wait(2.0, c_timeGame);
    libNtve_gf_SetAlliance(1, 3, 5);
    TriggerEnable(TriggerGetCurrent(), false);
    return true;
}

