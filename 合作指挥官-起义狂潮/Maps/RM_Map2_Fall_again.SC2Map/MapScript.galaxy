//--------------------------------------------------------------------------------------------------
bool gt_Start1_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    VisRevealerCreate(1, RegionFromId(3));
    gv_aufdeckerStart = VisRevealerLastCreated();
    libNtve_gf_CinematicMode(true, PlayerGroupAll(), c_transitionDurationDefault);
    CinematicDataRun(1, PlayerGroupAll(), false);
    CinematicFade(false, 0.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    CinematicFade(true, 1.5, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaCinematic, StringExternal("Param/Value/5BEBE5FD"));
    UnitIssueOrder(UnitFromId(724), OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(726)), c_orderQueueReplace);
    libNtve_gf_ShowHideUnit(UnitFromId(792), false);
    TriggerEnable(TriggerGetCurrent(), false);
    return true;
}

