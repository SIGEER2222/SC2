//--------------------------------------------------------------------------------------------------
// Trigger: Hy
//--------------------------------------------------------------------------------------------------
bool gt_Hy_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_CinematicMode(true, PlayerGroupAll(), c_transitionDurationDefault);
    CinematicFade(false, 1.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    CameraApplyInfo(1, CameraInfoFromId(1074), 0.0, -1, 10, true);
    CinematicFade(true, 1.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    ObjectiveSetState(gv_hauptmissionen[0], c_objectiveStateCompleted);
    TriggerExecute(gt_WiedersehenmachtfreudeMission2KI3, true, false);
