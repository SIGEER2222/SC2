//--------------------------------------------------------------------------------------------------
// Trigger: Tychus Spawned Flammer Dies
//--------------------------------------------------------------------------------------------------
bool gt_TychusSpawnedFlammerDies_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnit()) == "Flammer"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gv_anzahlFlammer=gv_anzahlFlammer - 1;
    if ((gv_anzahlFlammer < gv_maxAnzahlFlammer)) {
        UnitAbilityEnable(UnitFromId(722), "SpawnFlammer", true);
    }
    else {
    }
    return true;
}

