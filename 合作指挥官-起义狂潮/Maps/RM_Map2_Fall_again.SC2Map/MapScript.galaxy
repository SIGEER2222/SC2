//--------------------------------------------------------------------------------------------------
// Trigger: Ziel
//--------------------------------------------------------------------------------------------------
bool gt_Ziel_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_MakeUnitInvulnerable(UnitFromId(723), true);
    libNtve_gf_MakeUnitInvulnerable(UnitFromId(738), true);
    libNtve_gf_MakeUnitInvulnerable(UnitFromId(722), true);
    libNtve_gf_CinematicMode(true, PlayerGroupAll(), c_transitionDurationDefault);
    CinematicFade(false, 1.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    CameraApplyInfo(1, CameraInfoFromId(1606), 0.0, -1, 10, true);
    CinematicFade(true, 1.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    CameraApplyInfo(1, CameraInfoFromId(1605), 5.0, -1, 10, true);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/3D9C3C85"));
    Wait(3.0, c_timeGame);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/EB2AF183"));
    Wait(5.0, c_timeGame);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/F42D7866"));
    Wait(8.0, c_timeGame);
    CameraApplyInfo(1, CameraInfoFromId(1607), 4.0, -1, 10, true);
    Wait(4.0, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/2CB0AFAE"));
    Wait(10.0, c_timeGame);
    libNtve_gf_CinematicMode(false, PlayerGroupAll(), c_transitionDurationDefault);
    GameOver(1, c_gameOverVictory, true, true);
    return true;
}

