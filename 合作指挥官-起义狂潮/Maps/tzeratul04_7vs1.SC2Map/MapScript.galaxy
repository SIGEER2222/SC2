//--------------------------------------------------------------------------------------------------
// Trigger: Update Leaderboard - Zerg or Hybrid Killed
//--------------------------------------------------------------------------------------------------
bool gt_UpdateLeaderboardZergorHybridKilled_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_gameOver == false))) {
            return false;
        }

        if (!((PlayerGroupHasPlayer(gv_pg, UnitGetOwner(libNtve_gf_KillingUnit())) == true))) {
            return false;
        }

        if (!((PlayerGroupHasPlayer(gv_eg, UnitGetOwner(EventUnit())) == true))) {
            return false;
        }

        if (!((UnitTypeTestAttribute(UnitGetType(EventUnit()), c_unitAttributeStructure) != true))) {
            return false;
        }

        if (!((UnitTypeTestAttribute(UnitGetType(EventUnit()), c_unitAttributeSummoned) != true))) {
            return false;
        }

        if (!((UnitTypeTestFlag(UnitGetType(EventUnit()), c_unitFlagWorker) == false))) {
            return false;
        }

        if (!((UnitHasBehavior2(EventUnit(), "MinorGoal") == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gv_killCount += 1;
    if ((UnitTypeTestAttribute(UnitGetType(libNtve_gf_KillingUnit()), c_unitAttributeHeroic) == true)) {
        gv_statHeroKills += 1;
    }

    if (((UnitGetType(EventUnit()) == "HybridDestroyer") || (UnitGetType(EventUnit()) == "HybridReaver"))) {
        gv_hybridSlain += 1;
    }

    if ((gv_killCount >= gv_sTAGE_01_KILL_QUOTA)) {
        TriggerExecute(gt_PrimaryKillCountComplete, true, false);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_UpdateLeaderboardZergorHybridKilled_Init () {
    gt_UpdateLeaderboardZergorHybridKilled = TriggerCreate("gt_UpdateLeaderboardZergorHybridKilled_Func");
    TriggerAddEventUnitDied(gt_UpdateLeaderboardZergorHybridKilled, null);
}

