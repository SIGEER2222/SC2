//--------------------------------------------------------------------------------------------------
// Trigger: All Out Attack
//--------------------------------------------------------------------------------------------------
bool gt_AllOutAttack_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unitgroup lv_ug;

    // Automatic Variable Declarations
    unitgroup autoDB672C5F_g;
    int autoDB672C5F_u;
    unit autoDB672C5F_var;
    unitgroup auto695611B5_g;
    int auto695611B5_u;
    unit auto695611B5_var;

    // Variable Initialization
    lv_ug = UnitGroupEmpty();

    // Conditions
    if (testConds) {
        if (!((EventDialogControl() == gv_allOutDialogButton))) {
            return false;
        }

        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    TriggerStop(gt_AirAttack);
    DialogDestroy(gv_allOutDialog);
    SoundtrackPlay(PlayerGroupAll(), c_soundtrackCategoryMusic, "PAiur06_Music_Main", c_soundtrackCueAny, c_soundtrackIndexAny, true);
    TriggerExecute(gt_TransmissionAllOutAssaultQ, true, false);
    UnitGroupAddUnitGroup(lv_ug, UnitGroup(null, gv_p3_ARTANIS, RegionFromId(5), UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    UnitGroupAddUnitGroup(lv_ug, UnitGroup(null, gv_p9_VORAZUN, RegionFromId(5), UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    UnitGroupAddUnitGroup(lv_ug, UnitGroup(null, gv_p11_KARAX, RegionFromId(5), UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    while ((UnitGroupCount(lv_ug, c_unitCountAlive) >= 20)) {
        autoDB672C5F_g = UnitGroupFilter(null, c_playerAny, lv_ug, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 20);
        autoDB672C5F_u = UnitGroupCount(autoDB672C5F_g, c_unitCountAll);
        for (;; autoDB672C5F_u -= 1) {
            autoDB672C5F_var = UnitGroupUnitFromEnd(autoDB672C5F_g, autoDB672C5F_u);
            if (autoDB672C5F_var == null) { break; }
            UnitIssueOrder(autoDB672C5F_var, OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(983943936)), c_orderQueueReplace);
            UnitIssueOrder(autoDB672C5F_var, OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(gv_amon)), c_orderQueueAddToEnd);
            AISetUnitScriptControlled(autoDB672C5F_var, false);
            AISetUnitSuicide(autoDB672C5F_var, true);
            UnitGroupRemove(lv_ug, autoDB672C5F_var);
        }
        Wait(0.125, c_timeGame);
    }
    Wait(30.0, c_timeGame);
    while (true) {
        UnitGroupAddUnitGroup(lv_ug, UnitGroupIdle(3, false));
        UnitGroupAddUnitGroup(lv_ug, UnitGroupIdle(9, false));
        UnitGroupAddUnitGroup(lv_ug, UnitGroupIdle(11, false));
        while ((UnitGroupCount(lv_ug, c_unitCountAlive) >= 20)) {
            auto695611B5_g = UnitGroupFilter(null, c_playerAny, lv_ug, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 20);
            auto695611B5_u = UnitGroupCount(auto695611B5_g, c_unitCountAll);
            for (;; auto695611B5_u -= 1) {
                auto695611B5_var = UnitGroupUnitFromEnd(auto695611B5_g, auto695611B5_u);
                if (auto695611B5_var == null) { break; }
                UnitIssueOrder(auto695611B5_var, OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(154)), c_orderQueueReplace);
                UnitIssueOrder(auto695611B5_var, OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(gv_amon)), c_orderQueueAddToEnd);
                AISetUnitScriptControlled(auto695611B5_var, false);
                AISetUnitSuicide(auto695611B5_var, true);
                UnitGroupRemove(lv_ug, auto695611B5_var);
            }
            Wait(0.125, c_timeGame);
        }
        Wait(30.0, c_timeGame);
    }
    return true;
}

