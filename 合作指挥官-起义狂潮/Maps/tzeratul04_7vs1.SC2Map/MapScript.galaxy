    for (;; auto78F9B2D4_u -= 1) {
        auto78F9B2D4_var = UnitGroupUnitFromEnd(auto78F9B2D4_g, auto78F9B2D4_u);
        if (auto78F9B2D4_var == null) { break; }
        libNtve_gf_PauseUnit(auto78F9B2D4_var, false);
    }
    return true;
}

