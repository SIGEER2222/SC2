//--------------------------------------------------------------------------------------------------
bool gt_StartGameStage1_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    libE0EAE146_gf_StartGame();
    TextExpressionSetToken("Param/Expression/2300BE84", "A", IntToText(gv_sTAGE_01_KILL_QUOTA));
    lib67C0F0E7_gf_ObjectiveNew(true, TextExpressionAssemble("Param/Expression/2300BE84"), 1, false, 0, 0);
    lib67C0F0E7_gf_ObjectiveNew(true, StringExternal("Param/Value/7B4B22E7"), 2, false, 0, 0);
    lib67C0F0E7_gf_ObjectiveNew(false, StringExternal("Param/Value/DE7E49A8"), 1, true, 3, 3);
    lib67C0F0E7_gf_ObjectiveNew(false, StringExternal("Param/Value/AED35CEC"), 2, false, 0, 0);
    UnitFlashSelection(gv_zeratul, 5.0);
    VisRevealerCreate(1, RegionFromId(88));
    VisRevealerCreate(1, RegionFromId(87));
    Wait(1.0, c_timeGame);
    lib67C0F0E7_gf_ObjectiveSet(true, 1, lib67C0F0E7_ge_ObjectiveSet_Show);
    Wait(1.0, c_timeGame);
    lib67C0F0E7_gf_ObjectiveSet(true, 2, lib67C0F0E7_ge_ObjectiveSet_Show);
    Wait(1.0, c_timeGame);
    lib67C0F0E7_gf_ObjectiveSet(false, 1, lib67C0F0E7_ge_ObjectiveSet_Show);
    Wait(1.0, c_timeGame);
    lib67C0F0E7_gf_ObjectiveSet(false, 2, lib67C0F0E7_ge_ObjectiveSet_Show);
    TriggerExecute(gt_CreateLeaderboard, true, false);
    Wait(10.0, c_timeGame);
    TriggerExecute(gt_CreateAllOutAttackButton, true, false);
    Wait(10.0, c_timeGame);
    TriggerExecute(gt_TransmissionTemplarsStoreKnowledgeQ, true, true);
    Wait(5.0, c_timeGame);
    TriggerExecute(gt_TransmissionArtanisFinalSpeechQ, true, false);
    Wait(65.0, c_timeGame);
    TriggerExecute(gt_TransmissionDarkVoicePronouncementQ, true, false);
    TriggerExecute(gt_ActivateHeroWayGate, true, false);
    Wait(240.0, c_timeGame);
    TriggerEnable(gt_WarpedinTemplarBehavior, false);
    TriggerExecute(gt_NewTech01PhoenixQ, true, false);
    gf_ActivateBullies(ge_BullyPhase_Early);
    Wait(60.0, c_timeGame);
    TriggerExecute(gt_TransmissionZergswarmingflanksQ, true, false);
    return true;
}

