//--------------------------------------------------------------------------------------------------
// Trigger: P7 Infested Attack Waves
//--------------------------------------------------------------------------------------------------
bool gt_P7InfestedAttackWaves_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_aI;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_aI = 7;

    // Actions
    if (!runActions) {
        return true;
    }

    AIAttackWaveSetTargetPlayer(lv_aI, PlayerGroupAlliance(c_playerGroupEnemy, lv_aI));
    AIAttackWaveSetGatherPoint(lv_aI, PointFromId(130769834));
    Wait(120.0, c_timeGame);
    AIAttackWaveAddUnits4(12, 12, 15, 20, "InfestedCivilian");
    AIAttackWaveAddUnits4(4, 4, 5, 6, "InfestorTerran");
    AIAttackWaveSend(lv_aI, 180, true);
    AIAttackWaveAddUnits4(20, 20, 25, 30, "InfestedCivilian");
    AIAttackWaveAddUnits4(2, 2, 3, 4, "Hunterling");
    AIAttackWaveAddUnits4(0, 0, 0, 1, "Infestor");
    AIAttackWaveSend(lv_aI, 180, true);
    AIAttackWaveAddUnits4(8, 8, 10, 12, "InfestorTerran");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Choker");
    AIAttackWaveAddUnits4(1, 1, 2, 3, "InfestedAbomination");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Overseer");
    AIAttackWaveSend(lv_aI, 180, true);
    AIAttackWaveAddUnits4(30, 30, 40, 50, "InfestedCivilian");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Spotter");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Kaboomer");
    AIAttackWaveAddUnits4(2, 2, 2, 3, "InfestedAbomination");
    AIAttackWaveSend(lv_aI, 180, true);
    AIAttackWaveAddUnits4(20, 20, 25, 30, "InfestedCivilian");
    AIAttackWaveAddUnits4(8, 8, 10, 12, "InfestorTerran");
    AIAttackWaveAddUnits4(1, 1, 2, 2, "InfestedAbomination");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Overseer");
    AIAttackWaveSend(lv_aI, 180, true);
    while (true) {
        Wait(1.0, c_timeGame);
        AIAttackWaveAddUnits4(20, 20, 25, 30, "InfestedCivilian");
        AIAttackWaveAddUnits4(8, 8, 10, 12, "InfestorTerran");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Choker");
        AIAttackWaveSend(lv_aI, 180, true);
        AIAttackWaveAddUnits4(20, 20, 25, 30, "InfestedCivilian");
        AIAttackWaveAddUnits4(1, 1, 2, 2, "InfestedAbomination");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Spotter");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Kaboomer");
        AIAttackWaveSend(lv_aI, 180, true);
        AIAttackWaveAddUnits4(20, 20, 25, 30, "InfestedCivilian");
        AIAttackWaveAddUnits4(8, 8, 10, 12, "InfestorTerran");
        AIAttackWaveAddUnits4(1, 1, 2, 2, "InfestedAbomination");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Overseer");
        AIAttackWaveSend(lv_aI, 180, true);
    }
    return true;
}

