//--------------------------------------------------------------------------------------------------
// Trigger: Infested Marine Clearer
//--------------------------------------------------------------------------------------------------
bool gt_InfestedMarineClearer_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup auto02A5190E_g;
    int auto02A5190E_u;
    unit auto02A5190E_var;

    // Actions
    if (!runActions) {
        return true;
    }

    auto02A5190E_g = UnitGroup("InfestorTerran", gv_p07_INFESTED, RegionFromId(56), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    auto02A5190E_u = UnitGroupCount(auto02A5190E_g, c_unitCountAll);
    for (;; auto02A5190E_u -= 1) {
        auto02A5190E_var = UnitGroupUnitFromEnd(auto02A5190E_g, auto02A5190E_u);
        if (auto02A5190E_var == null) { break; }
        AISetUnitSuicide(auto02A5190E_var, true);
    }
    return true;
}

