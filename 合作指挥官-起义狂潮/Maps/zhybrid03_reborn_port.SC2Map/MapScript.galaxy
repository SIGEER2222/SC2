    libSwaC_gf_SendTransmissionCampaign(UnitFromId(708), "zBriefing_Hybrid03|Line00020", c_transmissionDurationAdd, 0.0, true, libSwaC_ge_CampaignTransmissionPortraitOptioins_HidePortraitAfter, libSwaC_ge_CampaignTransmissionCueSoundOptions_DefaultCueSoundBehavior);
    libSwaC_gf_SendTransmissionCampaign(gv_kerrigan, "zBriefing_Hybrid03|Line00023", c_transmissionDurationAdd, 0.0, true, libSwaC_ge_CampaignTransmissionPortraitOptioins_HidePortraitAfter, libSwaC_ge_CampaignTransmissionCueSoundOptions_DefaultCueSoundBehavior);
    libSwaC_gf_SendTransmissionCampaign(gv_unitStukov, "zBriefing_Hybrid03|Line00014", c_transmissionDurationAdd, 0.0, true, libSwaC_ge_CampaignTransmissionPortraitOptioins_HidePortraitAfter, libSwaC_ge_CampaignTransmissionCueSoundOptions_DefaultCueSoundBehavior);
    libSwaC_gf_SendTransmissionCampaign(gv_unitStukov, "zBriefing_Hybrid03|Line00021", c_transmissionDurationAdd, 0.0, true, libSwaC_ge_CampaignTransmissionPortraitOptioins_HidePortraitAfter, libSwaC_ge_CampaignTransmissionCueSoundOptions_DefaultCueSoundBehavior);
    while (!((libNtve_gf_UnitInRegion(gv_unitStukov, RegionCircle(PointFromId(1189), 1.0)) == true))) {
        Wait(0.1, c_timeGame);
    }
    UnitIssueOrder(UnitFromId(686), OrderTargetingPoint(AbilityCommand("move", 4), UnitGetPosition(gv_unitStukov)), c_orderQueueAddToEnd);
    UnitIssueOrder(UnitFromId(695), OrderTargetingPoint(AbilityCommand("move", 4), UnitGetPosition(gv_unitStukov)), c_orderQueueAddToEnd);
    UnitIssueOrder(gv_unitStukov, OrderTargetingPoint(AbilityCommand("move", 4), UnitGetPosition(gv_kerrigan)), c_orderQueueAddToEnd);
    libSwaC_gf_SendTransmissionCampaign(gv_unitStukov, "zBriefing_Hybrid03|Line00016", c_transmissionDurationAdd, 0.0, true, libSwaC_ge_CampaignTransmissionPortraitOptioins_HidePortraitAfter, libSwaC_ge_CampaignTransmissionCueSoundOptions_DefaultCueSoundBehavior);
