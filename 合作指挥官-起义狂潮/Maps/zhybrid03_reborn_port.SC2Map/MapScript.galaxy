    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("InfestedStukovPortrait3D"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "", "Talk", null, StringExternal("Param/Value/63893E50"), StringExternal("Param/Value/A9F56E3A"), 6.0, c_transmissionDurationSet, true, c_maxPlayers, false);
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("Hatchery_RCZ_Portrait"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "", "Talk", null, StringExternal("Param/Value/B3FB4A02"), StringExternal("Param/Value/A790A658"), 6.0, c_transmissionDurationSet, true, c_maxPlayers, false);
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("InfestedStukovPortrait3D"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "", "Talk", null, StringExternal("Param/Value/568B64D4"), StringExternal("Param/Value/3FF039E3"), 6.0, c_transmissionDurationSet, true, c_maxPlayers, false);
