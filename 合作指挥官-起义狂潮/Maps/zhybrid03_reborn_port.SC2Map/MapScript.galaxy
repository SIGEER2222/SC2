//--------------------------------------------------------------------------------------------------
bool gt_StukovHeroAI_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((TriggerIsEnabled(gt_StukovWesternExpansion2) == false)) {
        libNtve_gf_AICast(gv_unitStukov, OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(720525922)));
    }
    else {
        if ((TriggerIsEnabled(gt_StukovWesternExpansion) == false)) {
            libNtve_gf_AICast(gv_unitStukov, OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(1757836225)));
        }
        else {
            libNtve_gf_AICast(gv_unitStukov, OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(1492825761)));
        }
    }
    return true;
}

