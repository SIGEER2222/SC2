            }

        }
        Wait(1.0, c_timeAI);
        auto2020BFEA_g = gv_hybridGroup;
        auto2020BFEA_u = UnitGroupCount(auto2020BFEA_g, c_unitCountAll);
        for (;; auto2020BFEA_u -= 1) {
            auto2020BFEA_var = UnitGroupUnitFromEnd(auto2020BFEA_g, auto2020BFEA_u);
