        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    autoD9133A8F_g = UnitGroup(null, gv_pLAYER_02_DOMINION, RegionCircle(UnitGetPosition(gv_voidThrasher), 15.0), UnitFilter(0, 0, (1 << c_targetFilterHeroic) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    autoD9133A8F_u = UnitGroupCount(autoD9133A8F_g, c_unitCountAll);
    for (;; autoD9133A8F_u -= 1) {
        autoD9133A8F_var = UnitGroupUnitFromEnd(autoD9133A8F_g, autoD9133A8F_u);
        if (autoD9133A8F_var == null) { break; }
        if ((UnitGetType(autoD9133A8F_var) != "ShadowCloudEpilogue01") && (AIIsNotUsableInWaves(autoD9133A8F_var) == false) && (AIUnitGetWave(autoD9133A8F_var) == null)) {
            UnitGroupAdd(lv_attackGroup, autoD9133A8F_var);
        }

    }
    if ((UnitGroupCount(lv_attackGroup, c_unitCountAlive) > 0)) {
        lv_attackGatherPoint = UnitGroupCenterOfGroup(lv_attackGroup);
        AIAttackWaveSetGatherPoint(gv_pLAYER_02_DOMINION, lv_attackGatherPoint);
        AIAttackWaveUseGroup(gv_pLAYER_02_DOMINION, lv_attackGroup);
        AIAttackWaveSend(gv_pLAYER_02_DOMINION, 0, true);
    }

    return true;
}

