    gv_ultra1 = UnitLastCreated();
    libNtve_gf_CreateUnitsAtPoint2(1, "Ultralisk", 0, gv_pLAYER_01_USER, PointFromId(1199));
    gv_ultra2 = UnitLastCreated();
