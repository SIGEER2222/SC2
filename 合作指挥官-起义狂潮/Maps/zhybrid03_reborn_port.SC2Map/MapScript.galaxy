//--------------------------------------------------------------------------------------------------
bool gt_StukovWesternExpansion_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGroupCount(UnitGroupAlliance(1, c_unitAllianceEnemy, RegionFromId(56), UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterBenign - 32))), 0), c_unitCountAlive) == 0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    AIToggleBulliesInRegion(gv_pLAYER_02_DOMINION22223, RegionFromId(56), true);
    AIToggleBulliesInRegion(gv_pLAYER_02_DOMINION22223, RegionFromId(35), true);
    PlayerModifyPropertyInt(gv_pLAYER_02_DOMINION22223, c_playerPropMinerals, c_playerPropOperAdd, 2000);
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("InfestedStukovPortraitAddition"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "", "Talk", null, StringExternal("Param/Value/F05DD0CC"), StringExternal("Param/Value/7D78CBEA"), 6.0, c_transmissionDurationSet, true, c_maxPlayers, false);
    Wait(60.0, c_timeGame);
    AIToggleBulliesInRegion(gv_pLAYER_02_DOMINION22223, RegionFromId(56), true);
    Wait(60.0, c_timeGame);
    AIToggleBulliesInRegion(gv_pLAYER_02_DOMINION22223, RegionFromId(56), true);
    return true;
}

