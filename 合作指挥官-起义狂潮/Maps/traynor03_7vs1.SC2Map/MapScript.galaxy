    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((TriggerGetExecCount(TriggerGetCurrent()) == 2)) {
        TriggerEnable(TriggerGetCurrent(), false);
        TriggerStop(gt_P2Attack);
    }

    return true;
}

