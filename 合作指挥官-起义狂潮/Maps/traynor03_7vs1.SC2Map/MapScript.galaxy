bool gt_Initialization_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    libE0EAE146_gf_InitializeConfiguredMapScenario("traynor03_7vs1", false, null, gt_Init01Technology, true, gt_Init02Players, gt_Init03Units, gt_Init04Music, gt_Init05Environment, gt_Init06Difficulties, null, gt_IntroSequence);
    return true;
}

