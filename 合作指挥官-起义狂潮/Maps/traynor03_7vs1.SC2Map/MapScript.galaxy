//--------------------------------------------------------------------------------------------------
// Trigger: P3 Attack Waves
//--------------------------------------------------------------------------------------------------
bool gt_P3AttackWaves_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_aI;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_aI = 3;

    // Actions
    if (!runActions) {
        return true;
    }

    AIAttackWaveSetTargetPlayer(lv_aI, PlayerGroupAlliance(c_playerGroupEnemy, lv_aI));
    AIAttackWaveSetGatherPoint(lv_aI, PointFromId(1803897782));
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(363), false);
    AIAttackWaveAddUnits4(8, 8, 10, 12, "Zergling");
    AIAttackWaveAddUnits4(2, 2, 3, 4, "Roach");
    AIAttackWaveSend(lv_aI, 180, true);
    Wait(60.0, c_timeGame);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(363), false);
    AIAttackWaveAddUnits4(3, 3, 4, 6, "Mutalisk");
    TriggerExecute(gt_TransmissionTychusIncomingAirUnitsQ, true, false);
    AIAttackWaveSend(lv_aI, 60, true);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(363), false);
    AIAttackWaveAddUnits4(8, 8, 9, 10, "Zergling");
    AIAttackWaveAddUnits4(1, 1, 2, 3, "Queen");
    AIAttackWaveAddUnits4(2, 2, 3, 4, "Hydralisk");
    AIAttackWaveSend(lv_aI, 180, true);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(363), false);
    AIAttackWaveAddUnits4(4, 4, 5, 6, "Hydralisk");
    AIAttackWaveAddUnits4(1, 1, 2, 3, "Queen");
    AIAttackWaveAddUnits4(2, 2, 3, 4, "Roach");
    AIAttackWaveSend(lv_aI, 180, true);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(363), false);
    AIAttackWaveAddUnits4(1, 1, 1, 2, "Queen");
    AIAttackWaveAddUnits4(4, 4, 5, 6, "Hydralisk");
    AIAttackWaveAddUnits4(10, 10, 12, 15, "Zergling");
    AIAttackWaveSend(lv_aI, 180, true);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(363), false);
    AIAttackWaveAddUnits4(4, 4, 5, 6, "Mutalisk");
    AIAttackWaveAddUnits4(2, 2, 2, 3, "Queen");
    AIAttackWaveAddUnits4(4, 4, 5, 6, "Roach");
    AIAttackWaveSend(lv_aI, 180, true);
    while (true) {
        Wait(1.0, c_timeGame);
        AIAttackWaveAddWaypoint(lv_aI, PointFromId(363), false);
        AIAttackWaveAddUnits4(8, 8, 9, 10, "Zergling");
        AIAttackWaveAddUnits4(1, 1, 2, 3, "Queen");
        AIAttackWaveAddUnits4(4, 4, 5, 6, "Hydralisk");
        AIAttackWaveSend(lv_aI, 180, true);
        AIAttackWaveAddUnits4(4, 4, 5, 6, "Hydralisk");
        AIAttackWaveAddUnits4(2, 2, 3, 4, "Queen");
        AIAttackWaveAddUnits4(2, 2, 3, 4, "Baneling");
        AIAttackWaveAddUnits4(4, 4, 5, 6, "Roach");
        AIAttackWaveSend(lv_aI, 180, true);
        AIAttackWaveAddWaypoint(lv_aI, PointFromId(363), false);
        AIAttackWaveAddUnits4(2, 2, 3, 4, "Queen");
        AIAttackWaveAddUnits4(4, 4, 5, 6, "Hydralisk");
        AIAttackWaveAddUnits4(10, 10, 12, 15, "Zergling");
        AIAttackWaveSend(lv_aI, 180, true);
        AIAttackWaveAddUnits4(5, 5, 6, 7, "Mutalisk");
        AIAttackWaveAddUnits4(2, 2, 3, 4, "Queen");
        AIAttackWaveAddUnits4(4, 4, 5, 6, "Roach");
        AIAttackWaveSend(lv_aI, 180, true);
    }
    return true;
}

