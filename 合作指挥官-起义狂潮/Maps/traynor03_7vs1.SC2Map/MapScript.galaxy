// Trigger: Victory Zerg Destroyed
//--------------------------------------------------------------------------------------------------
bool gt_VictoryZergDestroyed_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_gameOver == false))) {
            return false;
        }

        if (!((UnitGroupCount(UnitGroup(null, gv_pLAYER02_ZERG, null, UnitFilter((1 << c_targetFilterPreventDefeat), 0, 0, (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) <= 5))) {
            return false;
        }

        if (!((UnitGroupCount(UnitGroup(null, gv_pLAYER03_ZERG, null, UnitFilter((1 << c_targetFilterPreventDefeat), 0, 0, (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) <= 5))) {
            return false;
        }

        if (!((UnitGroupCount(UnitGroup(null, gv_pLAYER04_ZERG, null, UnitFilter((1 << c_targetFilterPreventDefeat), 0, 0, (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) <= 5))) {
            return false;
        }

        if (!((UnitGroupCount(UnitGroup(null, gv_pLAYER05_ZERG_NOAI, null, UnitFilter((1 << c_targetFilterPreventDefeat), 0, 0, (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) <= 5))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    gv_structuresLostAndSalvaged = (PlayerScoreValueGetAsInt(gv_pLAYER01_USER, "StructuresLostCount") + PlayerScoreValueGetAsInt(gv_pLAYER01_USER, "StructuresFriendlyFireCount") + PlayerScoreValueGetAsInt(gv_pLAYER01_USER, "StructuresSalvagedCount"));
    gv_gameOver = true;
    lib67C0F0E7_gf_ObjectiveSet(true, 2, lib67C0F0E7_ge_ObjectiveSet_Finish);
    lib67C0F0E7_gf_ObjectiveSet(true, 3, lib67C0F0E7_ge_ObjectiveSet_Finish);
    TriggerExecute(gt_VictoryQ2, true, true);
    return true;
}

