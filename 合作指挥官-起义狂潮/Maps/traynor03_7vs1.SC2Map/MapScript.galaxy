//--------------------------------------------------------------------------------------------------
// Trigger: Blue Drop Pods
//--------------------------------------------------------------------------------------------------
bool gt_BlueDropPods_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unitgroup lv_lastGroup;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_lastGroup = UnitGroupEmpty();

    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == 1))) {
            return false;
        }

        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    libCamp_gf_CreateMissionAutosavePoint(StringExternal("Param/Value/B5E9056A"));
    libNtve_gf_CreateUnitsAtPoint2(20, "Zergling", 0, gv_pLAYER05_ZERG_NOAI, RegionGetCenter(RegionFromId(84)));
    lv_lastGroup = UnitLastCreatedGroup();
    libNtve_gf_CreateUnitsAtPoint2(8, "Roach", 0, gv_pLAYER05_ZERG_NOAI, RegionGetCenter(RegionFromId(84)));
    UnitGroupAddUnitGroup(lv_lastGroup, UnitLastCreatedGroup());
    libNtve_gf_CreateUnitsAtPoint2(2, "Ultralisk", 0, gv_pLAYER05_ZERG_NOAI, RegionGetCenter(RegionFromId(84)));
    UnitGroupAddUnitGroup(lv_lastGroup, UnitLastCreatedGroup());
    libCamp_gf_CreateDropPod(libCamp_ge_DropPodRace_Zerg, RegionGetCenter(RegionFromId(84)), UnitLastCreatedGroup(), true);
    AISetGroupSuicide(lv_lastGroup, true);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_BlueDropPods_Init () {
    gt_BlueDropPods = TriggerCreate("gt_BlueDropPods_Func");
    TriggerAddEventUnitRegion(gt_BlueDropPods, null, RegionFromId(84), true);
}

