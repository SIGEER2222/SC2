//--------------------------------------------------------------------------------------------------
// Trigger: Rebel Marines 01 Rescued
//--------------------------------------------------------------------------------------------------
bool gt_RebelMarines01Rescued_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup auto14DC20EB_g;
    int auto14DC20EB_u;
    unit auto14DC20EB_var;

    // Conditions
    if (testConds) {
        if (!((gv_gameOver == false))) {
            return false;
        }

        if (!((gv_inCinematic == false))) {
            return false;
        }

        if (!((UnitTypeTestAttribute(UnitGetType(EventUnit()), c_unitAttributeUser1) == false))) {
            return false;
        }

        if (!((UnitGetOwner(EventUnit()) == 1))) {
            return false;
        }

        if (!((TriggerGetExecCount(TriggerGetCurrent()) == 0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    TriggerEnable(gt_RebelMarines01Dead, false);
    gv_rebelFightersRescued += 1;
    UnitKill(gv_rebelMarinesBeacon01);
    auto14DC20EB_g = UnitGroup(null, 6, EventUnitRegion(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    auto14DC20EB_u = UnitGroupCount(auto14DC20EB_g, c_unitCountAll);
    for (;; auto14DC20EB_u -= 1) {
        auto14DC20EB_var = UnitGroupUnitFromEnd(auto14DC20EB_g, auto14DC20EB_u);
        if (auto14DC20EB_var == null) { break; }
        libNtve_gf_RescueUnit(auto14DC20EB_var, gv_pLAYER01_USER, true);
    }
    libE0EAE146_gf_Bon1();
    lib67C0F0E7_gf_PingDestroyI(1);
    if ((lib67C0F0E7_gf_ObjectiveMultiNow(false, 1) == 2)) {
        lib67C0F0E7_gf_ObjectiveSet(false, 1, lib67C0F0E7_ge_ObjectiveSet_FinishM);
    }
    else {
        lib67C0F0E7_gf_ObjectiveSet(false, 1, lib67C0F0E7_ge_ObjectiveSet_Add);
    }
    TriggerExecute(gt_TransmissionRebelMarines01RescuedQ, true, false);
    return true;
}

