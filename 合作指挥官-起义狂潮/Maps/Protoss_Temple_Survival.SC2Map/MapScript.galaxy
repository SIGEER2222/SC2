//--------------------------------------------------------------------------------------------------
// Trigger: Victory
//--------------------------------------------------------------------------------------------------
bool gt_Victory_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_ShowHideBossBar(false, 1);
    UnitGroupLoopBegin(UnitGroup(null, 2, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
        UnitKill(UnitGroupLoopCurrent());
    }
    UnitGroupLoopEnd();
    TriggerEnable(gt_RepeatingAttackWave, false);
    TriggerEnable(gt_ZergWave1G, false);
    TriggerEnable(gt_ZergWave2G, false);
    TriggerEnable(gt_ZergWave3G, false);
    TriggerEnable(gt_ZergWave4G, false);
    TriggerEnable(gt_ZergWave5G, false);
    TriggerEnable(gt_ZergAir1G, false);
    TriggerEnable(gt_ZergAir2G, false);
    libLbty_gf_AutoRevealRegion(RegionEntireMap(), RegionEntireMap(), 1);
    CinematicFade(false, 3.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    libNtve_gf_CinematicMode(true, PlayerGroupAll(), 0.0);
    CameraApplyInfo(1, CameraInfoFromId(713), 0.0, -1, 10, true);
    CinematicFade(true, 3.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(gv_zeratul, true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/EAFCD432"), StringExternal("Param/Value/EFAC0EDE"), 8.0, c_transmissionDurationSet, false);
    CameraApplyInfo(1, CameraInfoFromId(899), 10.0, -1, 10, true);
    Wait(15.0, c_timeGame);
    libNtve_gf_CinematicMode(false, PlayerGroupAll(), 0.0);
    GameOver(1, c_gameOverVictory, true, true);
    return true;
}

