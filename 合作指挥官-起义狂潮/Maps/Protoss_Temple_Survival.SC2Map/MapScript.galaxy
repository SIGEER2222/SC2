//--------------------------------------------------------------------------------------------------
// Trigger: Boss wave
//--------------------------------------------------------------------------------------------------
bool gt_Bosswave_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_CreateUnitsWithDefaultFacing(3, "Zergling", 0, 2, PointFromId(137));
    AIAttackWaveUseGroup(2, UnitLastCreatedGroup());
    libNtve_gf_CreateUnitsWithDefaultFacing(3, "Roach", 0, 2, PointFromId(137));
    AIAttackWaveUseGroup(2, UnitLastCreatedGroup());
    libNtve_gf_CreateUnitsWithDefaultFacing(3, "Hydralisk", 0, 2, PointFromId(137));
    AIAttackWaveUseGroup(2, UnitLastCreatedGroup());
    libNtve_gf_CreateUnitsWithDefaultFacing(3, "Mutalisk", 0, 2, PointFromId(137));
    AIAttackWaveUseGroup(2, UnitLastCreatedGroup());
    libNtve_gf_CreateUnitsWithDefaultFacing(3, "Ultralisk", 0, 2, PointFromId(137));
    AIAttackWaveUseGroup(2, UnitLastCreatedGroup());
    libNtve_gf_CreateUnitsWithDefaultFacing(3, "BroodLord", 0, 2, PointFromId(137));
    AIAttackWaveUseGroup(2, UnitLastCreatedGroup());
    libNtve_gf_CreateUnitsWithDefaultFacing(2, "HybridReaver", 0, 2, PointFromId(137));
    AIAttackWaveUseGroup(2, UnitLastCreatedGroup());
    libNtve_gf_DisplayBossBar(1, "Assets\\Textures\\ui_chatbaricons_protoss_individual.dds", StringExternal("Param/Value/41CB6BC4"), 100, PlayerGroupAll());
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "Maar", 0, 2, PointFromId(137));
    AIAttackWaveUseUnit(2, UnitLastCreated());
    gv_boss = UnitLastCreated();
    libNtve_gf_SetBossBarBoss(1, UnitLastCreated(), true);
    AIAttackWaveSetGatherEarlyNoReplace(2);
    AIAttackWaveSend(2, 1, false);
    TriggerEnable(gt_Victory, true);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(1);
    libCamp_gf_SendTransmissionCampaign(gv_boss, SoundLink("TZeratul02HybridProtoss00017", -1), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(2);
    return true;
}

