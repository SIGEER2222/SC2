void gt_IdleUnits_Init () {
    gt_IdleUnits = TriggerCreate("gt_IdleUnits_Func");
    TriggerAddEventUnitBecomesIdle(gt_IdleUnits, null, true);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Repeating Attack Wave
//--------------------------------------------------------------------------------------------------
bool gt_RepeatingAttackWave_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    while (true) {
        Wait(20.0, c_timeGame);
        libNtve_gf_CreateUnitsWithDefaultFacing(3, "Zergling", 0, 2, PointFromId(137));
        AIAttackWaveUseGroup(2, UnitLastCreatedGroup());
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "Roach", 0, 2, PointFromId(137));
        AIAttackWaveUseUnit(2, UnitLastCreated());
        AIAttackWaveSetGatherEarlyNoReplace(2);
        AIAttackWaveSend(2, 1, false);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_RepeatingAttackWave_Init () {
    gt_RepeatingAttackWave = TriggerCreate("gt_RepeatingAttackWave_Func");
}

