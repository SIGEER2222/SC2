    TriggerAddEventTimer(gt_ZergAir1G, gv_zergGlobalTimer);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Zerg Air 2G
//--------------------------------------------------------------------------------------------------
bool gt_ZergAir2G_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(0.5, c_timeGame);
    libNtve_gf_CreateUnitsWithDefaultFacing(4, "Mutalisk", 0, 2, PointFromId(125));
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "BroodLord", 0, 2, PointFromId(125));
    UnitGroupIssueOrder(UnitGroupIdle(2, false), OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(104)), c_orderQueueReplace);
    Wait(0.2, c_timeGame);
    libNtve_gf_CreateUnitsWithDefaultFacing(4, "Mutalisk", 0, 2, PointFromId(1160));
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "BroodLord", 0, 2, PointFromId(1160));
    UnitGroupIssueOrder(UnitGroupIdle(2, false), OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(1157)), c_orderQueueReplace);
    Wait(0.2, c_timeGame);
    libNtve_gf_CreateUnitsWithDefaultFacing(3, "Mutalisk", 0, 2, PointFromId(189));
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "BroodLord", 0, 2, PointFromId(189));
    UnitGroupIssueOrder(UnitGroupIdle(2, false), OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(182)), c_orderQueueReplace);
    Wait(0.2, c_timeGame);
    libNtve_gf_CreateUnitsWithDefaultFacing(3, "Mutalisk", 0, 2, PointFromId(1162));
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "BroodLord", 0, 2, PointFromId(1162));
    UnitGroupIssueOrder(UnitGroupIdle(2, false), OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(1158)), c_orderQueueReplace);
    Wait(0.2, c_timeGame);
    libNtve_gf_CreateUnitsWithDefaultFacing(3, "Mutalisk", 0, 2, PointFromId(1156));
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "BroodLord", 0, 2, PointFromId(1156));
    UnitGroupIssueOrder(UnitGroupIdle(2, false), OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(374)), c_orderQueueReplace);
    Wait(0.2, c_timeGame);
    libNtve_gf_CreateUnitsWithDefaultFacing(3, "Mutalisk", 0, 2, PointFromId(1161));
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "BroodLord", 0, 2, PointFromId(1161));
    UnitGroupIssueOrder(UnitGroupIdle(2, false), OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(1159)), c_orderQueueReplace);
    return true;
}

