//--------------------------------------------------------------------------------------------------
// Trigger: Map Start
//--------------------------------------------------------------------------------------------------
bool gt_MapStart_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    GameSetSpeedValue(c_gameSpeedNormal);
    MeleeInitUnitsForPlayer(1, "Prot", PointFromId(136));
    MeleeInitUnitsForPlayer(1, "Prot", PointFromId(1090));
    UnitGroupAdd(gv_nexusGroup, UnitGroupClosestToPoint(UnitGroup(null, 1, RegionFromId(2), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), PointFromId(136)));
    UnitGroupAdd(gv_nexusGroup, UnitGroupClosestToPoint(UnitGroup(null, 1, RegionFromId(3), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), PointFromId(1090)));
    CameraSetBounds(PlayerGroupAll(), RegionFromId(5), true);
    libNtve_gf_PlayAnimationOnDoodadsInRegion(RegionEntireMap(), "MonlythLightBridge", c_animNameDefault, "Stand Work", c_animFlagPlayForever, c_animTimeDefault);
    libNtve_gf_SwooshCamera(1, ((CameraInfoGetValue(CameraInfoDefault(), c_cameraValueDistance)) + 8.0), CameraInfoGetValue(CameraInfoDefault(), c_cameraValueDistance), PlayerStartLocation(1), 1.5);
    AIMeleeStart(2);
    AICampaignStart(2);
    AIAttackWaveSetTargetPlayer(2, PlayerGroupSingle(1));
    PlayerModifyPropertyInt(1, c_playerPropMinerals, c_playerPropOperSetTo, 50);
    TimerStart(gv_zergGlobalTimer, 60.0, true, c_timeGame);
    TimerStart(gv_bossTimer, 1500.0, false, c_timeGame);
    TimerWindowCreate(TimerLastStarted(), StringExternal("Param/Value/8712BDB8"), true, false);
    TriggerEnable(gt_ZergWave2G, false);
    TriggerEnable(gt_ZergWave3G, false);
    TriggerEnable(gt_ZergWave4G, false);
    TriggerEnable(gt_ZergWave5G, false);
    TriggerEnable(gt_ZergAir1G, false);
    TriggerEnable(gt_ZergAir2G, false);
    TriggerEnable(gt_Victory, false);
    TriggerExecute(gt_LightCycle, true, false);
    TriggerExecute(gt_StoneZealotOff, true, false);
    TriggerExecute(gt_RepeatingAttackWave, true, false);
    TriggerExecute(gt_StartWaveSet, true, false);
    Wait(3.0, c_timeGame);
    UnitFlashSelection(gv_zeratul, 10.0);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(1);
    libCamp_gf_SendTransmissionCampaign(gv_zeratul, SoundLink("TZeratul02Zeratul00012", -1), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(2);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_MapStart_Init () {
    gt_MapStart = TriggerCreate("gt_MapStart_Func");
    TriggerAddEventMapInit(gt_MapStart);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Light Cycle
//--------------------------------------------------------------------------------------------------
bool gt_LightCycle_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    GameSetLighting("AiurFlashbackStart", 0.0);
    while (true) {
        GameSetLighting("Aiur", 45.0);
        Wait(46.0, c_timeGame);
        GameSetLighting("Shakuras", 45.0);
        Wait(46.0, c_timeGame);
        GameSetLighting("BelShirSunset", 45.0);
        Wait(46.0, c_timeGame);
        GameSetLighting("AiurEndLightRed", 100.0);
        Wait(101.0, c_timeGame);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_LightCycle_Init () {
    gt_LightCycle = TriggerCreate("gt_LightCycle_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Break Free
//--------------------------------------------------------------------------------------------------
bool gt_BreakFree_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((UnitGetPropertyFixed(UnitFromId(52), c_unitPropEnergy, c_unitPropCurrent) == 0.0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitKill(UnitFromId(52));
    Wait(1.0, c_timeGame);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "Tassadar", 0, 1, PointFromId(908));
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_BreakFree_Init () {
    gt_BreakFree = TriggerCreate("gt_BreakFree_Func");
    TriggerAddEventUnitProperty(gt_BreakFree, UnitRefFromUnit(UnitFromId(52)), c_unitPropEnergy);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Stone Zealot Off
//--------------------------------------------------------------------------------------------------
bool gt_StoneZealotOff_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    UnitGroupLoopBegin(UnitGroup("StoneZealot", 0, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
        libNtve_gf_PauseUnit(UnitGroupLoopCurrent(), true);
        UnitSetState(UnitGroupLoopCurrent(), c_unitStateTargetable, false);
        UnitSetState(UnitGroupLoopCurrent(), c_unitStateSelectable, false);
        UnitSetState(UnitGroupLoopCurrent(), c_unitStateInvulnerable, true);
        UnitSetState(UnitGroupLoopCurrent(), c_unitStateStatusBar, false);
        UnitSetState(UnitGroupLoopCurrent(), c_unitStateFidget, false);
        libNtve_gf_PlayAnimation(libNtve_gf_MainActorofUnit(UnitGroupLoopCurrent()), c_animNameDefault, "Stand Work", c_animFlagPlayForever, c_animTimeDefault);
    }
    UnitGroupLoopEnd();
    UnitGroupLoopBegin(UnitGroup("StoneZealot", 0, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
        UnitGroupAdd(gv_stoneZealot, UnitGroupLoopCurrent());
    }
    UnitGroupLoopEnd();
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_StoneZealotOff_Init () {
    gt_StoneZealotOff = TriggerCreate("gt_StoneZealotOff_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Nexus Switch
//--------------------------------------------------------------------------------------------------
bool gt_NexusSwitch_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnitProgressUnit()) == "Nexus"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitGroupAdd(gv_nexusGroup, EventUnitProgressUnit());
    if ((libNtve_gf_UnitInRegion(UnitGroupClosestToPoint(gv_nexusGroup, PointFromId(767)), RegionFromId(2)) == true) && (libNtve_gf_UnitInRegion(UnitGroupClosestToPoint(gv_nexusGroup, PointFromId(777)), RegionFromId(1)) == true) && (libNtve_gf_UnitInRegion(UnitGroupClosestToPoint(gv_nexusGroup, PointFromId(778)), RegionFromId(3)) == true) && (libNtve_gf_UnitInRegion(UnitGroupClosestToPoint(gv_nexusGroup, PointFromId(905)), RegionFromId(4)) == true) && (libNtve_gf_UnitInRegion(UnitGroupClosestToPoint(gv_nexusGroup, PointFromId(689)), RegionFromId(6)) == true) && (libNtve_gf_UnitInRegion(UnitGroupClosestToPoint(gv_nexusGroup, PointFromId(756)), RegionFromId(7)) == true)) {
        UnitGroupLoopBegin(UnitGroup("StoneZealot", 0, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
        for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
            UnitSetTeamColorIndex(UnitGroupLoopCurrent(), PlayerGetColorIndex(gv_player1, false));
            libNtve_gf_ClearAnimation(libNtve_gf_MainActorofUnit(UnitGroupLoopCurrent()), c_animNameDefault);
            libNtve_gf_TurnAllAnimationPropertiesOff(libNtve_gf_MainActorofUnit(UnitGroupLoopCurrent()));
            libNtve_gf_PlayAnimation(libNtve_gf_MainActorofUnit(UnitGroupLoopCurrent()), c_animNameDefault, "Stand Work End", c_animFlagNonLooping, c_animTimeDefault);
            SoundPlayAtPoint(SoundLink("Thor_Movement", -1), PlayerGroupAll(), UnitGetPosition(UnitGroupLoopCurrent()), 0.0, 100.0, 0.0);
            libNtve_gf_ShareVisionofUnit(UnitGroupLoopCurrent(), true, 1);
        }
        UnitGroupLoopEnd();
        Wait(3.534, c_timeGame);
        UnitGroupLoopBegin(UnitGroup("StoneZealot", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
        for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
            UnitSetOwner(UnitGroupLoopCurrent(), 1, true);
            libNtve_gf_PauseUnit(UnitGroupLoopCurrent(), false);
            UnitSetState(UnitGroupLoopCurrent(), c_unitStateInvulnerable, false);
            UnitSetState(UnitGroupLoopCurrent(), c_unitStateTargetable, true);
            UnitSetState(UnitGroupLoopCurrent(), c_unitStateSelectable, true);
            UnitSetState(UnitGroupLoopCurrent(), c_unitStateStatusBar, true);
        }
        UnitGroupLoopEnd();
    }
    else {
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_NexusSwitch_Init () {
    gt_NexusSwitch = TriggerCreate("gt_NexusSwitch_Func");
    TriggerAddEventUnitConstructProgress(gt_NexusSwitch, null, c_unitProgressStageComplete);
}

