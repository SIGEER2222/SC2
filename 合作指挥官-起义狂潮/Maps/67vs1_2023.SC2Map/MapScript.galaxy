void lib1_gf_AllyAIGuardPlayer (int lp_player) {
    point lv_home;
    point lv_mid;
    unitgroup lv_units;
    int lv_count;
    int lv_guardCount;
    unit lv_unit;

    lv_home = lib1_gf_AllyAIHomePoint(lp_player);
    lv_mid = Point(96.0, 96.0);
    lv_units = UnitGroup(null, lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterWorker) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_count = UnitGroupCount(lv_units, c_unitCountAlive);
    lv_guardCount = 0;

    for (;; lv_count -= 1) {
        lv_unit = UnitGroupUnitFromEnd(lv_units, lv_count);
        if (lv_unit == null) {
            break;
        }

        AISetUnitScriptControlled(lv_unit, true);
        if ((UnitGetType(lv_unit) == "SiegeTank") || (UnitGetType(lv_unit) == "SiegeTankSieged")) {
            if (DistanceBetweenPoints(UnitGetPosition(lv_unit), lv_home) > 14.0) {
                UnitIssueOrder(lv_unit, OrderTargetingPoint(AbilityCommand("attack", 0), lib1_gf_AllyAITankPoint(lp_player)), c_orderQueueReplace);
            }
            else {
                if ((UnitGetType(lv_unit) == "SiegeTank") && (UnitOrder(lv_unit, 0) == null)) {
                    UnitIssueOrder(lv_unit, Order(AbilityCommand("SiegeMode", 0)), c_orderQueueReplace);
                }
            }
            continue;
        }
        if (DistanceBetweenPoints(UnitGetPosition(lv_unit), lv_home) > 38.0) {
            UnitIssueOrder(lv_unit, OrderTargetingPoint(AbilityCommand("attack", 0), lv_home), c_orderQueueReplace);
        }
        else {
            if ((UnitOrder(lv_unit, 0) == null) && (lv_guardCount < 14)) {
                UnitIssueOrder(lv_unit, OrderTargetingPoint(AbilityCommand("attack", 0), lv_mid), c_orderQueueReplace);
                UnitIssueOrder(lv_unit, OrderTargetingPoint(AbilityCommand("attack", 0), lv_home), c_orderQueueAddToEnd);
                lv_guardCount += 1;
            }
        }
    }
}

void lib1_gf_AllyAIStartPlayer (int lp_player) {
    lib1_gf_AllyAIConfigurePlayerSlot(lp_player);
    lib1_gf_AllyAIEnsurePlayerLoaded(lp_player);
    lib1_gf_AllyAISetEconomyAndTech(lp_player);
    AICampaignStart(lp_player);
    lib1_gf_AllyAIRefreshStock(lp_player);
    AIToggleBulliesInRegion(lp_player, RegionEntireMap(), true);
    AISetDifficulty(lp_player, c_diffRepairDamage, true);
    AISetDifficulty(lp_player, c_diffOptimizeGas, true);
    AISetDifficulty(lp_player, c_diffDefendWithPeons, true);
    AISetDifficulty(lp_player, c_diffEnableDangerMap, true);
    AISetDifficulty(lp_player, c_diffNormalTargetPrio, true);
    AISetDifficulty(lp_player, c_diffAutoBuildPrereqs, true);
    AISetDifficulty(lp_player, c_diffAllowBuildInDanger, true);
    AISetDifficulty(lp_player, c_diffSetRallyPoints, true);
    AISetDifficulty(lp_player, c_diffAllowLongDistanceMining, true);
    AISetDifficulty(lp_player, c_diffBalancePeonsAcrossBases, true);
    AISetDifficulty(lp_player, c_diffWaveLeashing, true);
    AISetDifficulty(lp_player, c_diffAdvancedRetreatLogic, true);
    AISetDifficulty(lp_player, c_diffSetRallyPoints, true);
    lib1_gf_AllyAIGuardPlayer(lp_player);
    lib1_gf_AllyAIOrderWorkersToMine(lp_player);
    lib1_gf_AllyAISiegeHomeTanks(lp_player);
}

