//--------------------------------------------------------------------------------------------------
// Trigger: Ally AI Start
//--------------------------------------------------------------------------------------------------
bool lib1_gt_AllyAIStart_Func (bool testConds, bool runActions) {
    int lv_player;

    if (!runActions) {
        return true;
    }

    lv_player = 2;
    for ( ; lv_player <= 7 ; lv_player += 1 ) {
        if (lib1_gf_AllyAIShouldControlPlayer(lv_player)) {
            lib1_gf_AllyAIStartPlayer(lv_player);
        }
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void lib1_gt_AllyAIStart_Init () {
    lib1_gt_AllyAIStart = TriggerCreate("lib1_gt_AllyAIStart_Func");
    TriggerAddEventTimeElapsed(lib1_gt_AllyAIStart, 1.0, c_timeGame);
    TriggerAddEventTimeElapsed(lib1_gt_AllyAIStart, 3.0, c_timeGame);
    TriggerAddEventTimeElapsed(lib1_gt_AllyAIStart, 8.0, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Ally AI Economy
//--------------------------------------------------------------------------------------------------
bool lib1_gt_AllyAIEconomy_Func (bool testConds, bool runActions) {
    int lv_player;

    if (!runActions) {
        return true;
    }

    lv_player = 2;
    for ( ; lv_player <= 7 ; lv_player += 1 ) {
        if (lib1_gf_AllyAIShouldControlPlayer(lv_player)) {
            lib1_gf_AllyAIConfigurePlayerSlot(lv_player);
            lib1_gf_AllyAIEnsurePlayerLoaded(lv_player);
            lib1_gf_AllyAISetEconomyAndTech(lv_player);
            lib1_gf_AllyAIRefreshStock(lv_player);
            lib1_gf_AllyAIOrderWorkersToMine(lv_player);
            lib1_gf_AllyAISiegeHomeTanks(lv_player);
        }
    }
    return true;
}

