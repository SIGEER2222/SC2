bool lib1_gf_AllyAIShouldControlPlayer (int lp_player) {
    if (lp_player < 2) {
        return false;
    }

    if (lp_player > 7) {
        return false;
    }

    if ((PlayerStatus(lp_player) == c_playerStatusActive) && (PlayerType(lp_player) == c_playerTypeUser)) {
        return false;
    }

    return true;
}

point lib1_gf_AllyAIHomePoint (int lp_player) {
    if (lp_player == 2) {
        return PointFromId(19);
    }

    if (lp_player == 3) {
        return PointFromId(24);
    }

    if (lp_player == 4) {
        return PointFromId(25);
    }

    if (lp_player == 5) {
        return PointFromId(26);
    }

    if (lp_player == 6) {
        return PointFromId(27);
    }

    if (lp_player == 7) {
        return PointFromId(306);
    }

    return PointFromId(5);
}

point lib1_gf_AllyAISpawnOffset (int lp_player, fixed lp_x, fixed lp_y) {
    fixed lv_x;
    fixed lv_y;

    lv_x = lp_x;
    lv_y = lp_y;
    if ((lp_player >= 2) && (lp_player <= 6)) {
        lv_x = -lp_x;
    }
    if ((lp_player == 2) || (lp_player == 3)) {
        lv_y = -lp_y;
    }

    return PointWithOffset(lib1_gf_AllyAIHomePoint(lp_player), lv_x, lv_y);
}

point lib1_gf_AllyAIBasePoint (int lp_player) {
    return lib1_gf_AllyAISpawnOffset(lp_player, 14.0, 12.0);
}

