int lib1_gf_AllyAICountNearbyType (int lp_player, string lp_unitType, point lp_center, fixed lp_radius) {
    return UnitGroupCount(UnitGroup(lp_unitType, lp_player, RegionCircle(lp_center, lp_radius), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive);
}

unit lib1_gf_AllyAINearestMineral (point lp_center) {
    unitgroup lv_minerals;
    unit lv_target;

    lv_minerals = UnitGroup("MineralField", c_playerAny, RegionCircle(lp_center, 18.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    UnitGroupAddUnitGroup(lv_minerals, UnitGroup("RichMineralField", c_playerAny, RegionCircle(lp_center, 18.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    lv_target = libNtve_gf_ClosestUnitToPoint(lp_center, lv_minerals);
    if (lv_target != null) {
        return lv_target;
    }

    lv_minerals = UnitGroup("MineralField", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    UnitGroupAddUnitGroup(lv_minerals, UnitGroup("RichMineralField", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    return libNtve_gf_ClosestUnitToPoint(lp_center, lv_minerals);
}

void lib1_gf_AllyAIOrderWorkersToMine (int lp_player) {
    point lv_base;
    unit lv_mineral;
    unitgroup lv_workers;
    int lv_count;
    unit lv_worker;

    lv_base = lib1_gf_AllyAIBasePoint(lp_player);
    lv_mineral = lib1_gf_AllyAINearestMineral(lv_base);
    if (lv_mineral == null) {
        return;
    }

    lv_workers = UnitGroup("SCV", lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_count = UnitGroupCount(lv_workers, c_unitCountAlive);
    for (;; lv_count -= 1) {
        lv_worker = UnitGroupUnitFromEnd(lv_workers, lv_count);
        if (lv_worker == null) {
            break;
        }
        if (DistanceBetweenPoints(UnitGetPosition(lv_worker), lv_base) > 35.0) {
            continue;
        }
        if (UnitOrder(lv_worker, 0) == null) {
            UnitIssueOrder(lv_worker, OrderTargetingUnit(AbilityCommand("SCVHarvest", 0), lv_mineral), c_orderQueueReplace);
        }
    }
}

void lib1_gf_AllyAISiegeHomeTanks (int lp_player) {
    point lv_home;
    unitgroup lv_tanks;
    int lv_count;
    unit lv_tank;

    lv_home = lib1_gf_AllyAIHomePoint(lp_player);
    lv_tanks = UnitGroup("SiegeTank", lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_count = UnitGroupCount(lv_tanks, c_unitCountAlive);
    for (;; lv_count -= 1) {
        lv_tank = UnitGroupUnitFromEnd(lv_tanks, lv_count);
        if (lv_tank == null) {
            break;
        }
        if (DistanceBetweenPoints(UnitGetPosition(lv_tank), lv_home) > 18.0) {
            continue;
        }
        if (UnitOrder(lv_tank, 0) == null) {
            UnitIssueOrder(lv_tank, Order(AbilityCommand("SiegeMode", 0)), c_orderQueueReplace);
        }
    }
}

void lib1_gf_AllyAIRefreshStock (int lp_player) {
    AIEnableStock(lp_player);
    AIClearStock(lp_player);
    AIHarvestBonus(lp_player, 1.6);
    AISetStockTown(lp_player, "CommandCenter", "Refinery");
    AISetStockExpand(lp_player, "CommandCenter", 2);
    AISetStockFarms(lp_player, "SupplyDepot", true);
    AISetStockPeons(lp_player, 28, "SCV", false, true);
    AISetStock(lp_player, 2, "Barracks");
    AISetStock(lp_player, 1, "Factory");
    AISetStock(lp_player, 1, "Starport");
    AISetStock(lp_player, 1, "EngineeringBay");
    AISetStock(lp_player, 1, "Armory");
    AISetStock(lp_player, 1, "Bunker");
    AISetStock(lp_player, 2, "MissileTurret");
    AISetStock(lp_player, 24, "Marine");
    AISetStock(lp_player, 8, "Marauder");
    AISetStock(lp_player, 4, "Medic");
    AISetStock(lp_player, 4, "SiegeTank");
    AISetStock(lp_player, 6, "Viking");
    AISetStock(lp_player, 2, "Battlecruiser");
}

void lib1_gf_AllyAISetFullAlliance (int lp_source, int lp_target) {
    PlayerSetAlliance(lp_source, c_allianceIdPassive, lp_target, true);
    PlayerSetAlliance(lp_source, c_allianceIdVision, lp_target, true);
    PlayerSetAlliance(lp_source, c_allianceIdControl, lp_target, true);
    PlayerSetAlliance(lp_source, c_allianceIdSpend, lp_target, true);
    PlayerSetAlliance(lp_source, c_allianceIdTrade, lp_target, true);
    PlayerSetAlliance(lp_source, c_allianceIdSeekHelp, lp_target, true);
    PlayerSetAlliance(lp_source, c_allianceIdGiveHelp, lp_target, true);
    PlayerSetAlliance(lp_source, c_allianceIdChat, lp_target, true);
    PlayerSetAlliance(lp_source, c_allianceIdDefeat, lp_target, true);
    PlayerSetAlliance(lp_source, c_allianceIdPushable, lp_target, true);
    PlayerSetAlliance(lp_source, c_allianceIdPower, lp_target, true);
}

void lib1_gf_AllyAIConfigurePlayerSlot (int lp_player) {
    int lv_ally;

    if ((lp_player < 2) || (lp_player > 7)) {
        return;
    }

    PlayerSetDifficulty(lp_player, 2);
    PlayerSetRace(lp_player, "Terr");
    PlayerSetState(lp_player, c_playerStateDisplayInLeaderPanel, true);
    PlayerSetState(lp_player, c_playerStateDisplayInViewMenu, true);
    PlayerSetState(lp_player, c_playerStateShowScore, true);
    PlayerSetState(lp_player, c_playerStateContinueEnabled, false);

    lv_ally = 1;
    while (lv_ally <= 7) {
        if (lv_ally != lp_player) {
            lib1_gf_AllyAISetFullAlliance(lp_player, lv_ally);
            lib1_gf_AllyAISetFullAlliance(lv_ally, lp_player);
        }
        lv_ally += 1;
    }

    PlayerSetAlliance(lp_player, c_allianceIdPassive, 8, false);
    PlayerSetAlliance(lp_player, c_allianceIdVision, 8, false);
    PlayerSetAlliance(8, c_allianceIdPassive, lp_player, false);
    PlayerSetAlliance(8, c_allianceIdVision, lp_player, false);
}

