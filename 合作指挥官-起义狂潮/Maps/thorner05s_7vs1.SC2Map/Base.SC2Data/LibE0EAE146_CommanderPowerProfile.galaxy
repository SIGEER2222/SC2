void libE0EAE146_gf_CommanderPowerApplyRaynorPositivePrestige (int lp_player) {
    int lv_prestigeMask;

    lv_prestigeMask = libE0EAE146_gf_CommanderPowerPrestigeMask("Raynor");
    if (lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_prestigeMask, 0)) {
        libE0EAE146_gf_CommanderPowerSetUpgradeAtLeast(lp_player, "CommanderPrestigeRaynorBio", 1);
        libE0EAE146_gf_CommanderPowerSetUpgradeAtLeast(lp_player, "CommanderPrestigeRaynorBioMarineUpgrade", 1);
        libE0EAE146_gf_CommanderPowerSetUpgradeAtLeast(lp_player, "CommanderPrestigeRaynorBioFirebatUpgrade", 1);
        libE0EAE146_gf_CommanderPowerSetUpgradeAtLeast(lp_player, "CommanderPrestigeRaynorBioUpgradeTerranInfantryArmorLevel1", 1);
        libE0EAE146_gf_CommanderPowerSetUpgradeAtLeast(lp_player, "CommanderPrestigeRaynorBioUpgradeTerranInfantryArmorLevel2", 1);
        libE0EAE146_gf_CommanderPowerSetUpgradeAtLeast(lp_player, "CommanderPrestigeRaynorBioUpgradeTerranInfantryArmorLevel3", 1);
    }
    if (lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_prestigeMask, 1)) {
        libE0EAE146_gf_CommanderPowerSetUpgradeAtLeast(lp_player, "CommanderPrestigeRaynorMechAfterburners", 1);
    }
    if (lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_prestigeMask, 2)) {
        libE0EAE146_gf_CommanderPowerSetUpgradeAtLeast(lp_player, "CommanderPrestigeRaynorAir", 1);
    }
}

