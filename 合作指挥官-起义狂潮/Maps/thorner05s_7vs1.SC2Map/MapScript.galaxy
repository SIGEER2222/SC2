//--------------------------------------------------------------------------------------------------
// Trigger: Start AI
//--------------------------------------------------------------------------------------------------
bool gt_StartAI_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup autoB4ED4600_g;
    int autoB4ED4600_u;
    unit autoB4ED4600_var;

    // Actions
    if (!runActions) {
        return true;
    }

    CampaignInitAI();
    TriggerExecute(gt_P12AirSurvivorAttacks, true, false);
    TriggerExecute(gt_P2InfantrySurvivorAttacks, true, false);
    TriggerExecute(gt_P5MoebiusThrallsAttacks, true, false);
    TriggerExecute(gt_P8MechSurvivorAttacks, true, false);
    TriggerExecute(gt_P9EnthralledSurvivorAttacks, true, false);
    TriggerExecute(gt_MoebiusMastermindsAttacks, true, false);
    TriggerExecute(gt_BlightspreaderAttackWaves, true, false);
    TriggerExecute(gt_LeviathanAttackWaves, true, false);
    TriggerExecute(gt_HybridThrallsAttackWaves, true, false);
    TriggerExecute(gt_ReinforceRegionsWithBullies, true, false);
    autoB4ED4600_g = UnitGroup("Bunker", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
    autoB4ED4600_u = UnitGroupCount(autoB4ED4600_g, c_unitCountAll);
    for (;; autoB4ED4600_u -= 1) {
        autoB4ED4600_var = UnitGroupUnitFromEnd(autoB4ED4600_g, autoB4ED4600_u);
        if (autoB4ED4600_var == null) { break; }
        UnitCargoCreate(autoB4ED4600_var, "MengskMarine", libNtve_gf_DifficultyValueInt(4, 4, 4, 4));
        UnitCargoCreate(autoB4ED4600_var, "MengskMarauder", libNtve_gf_DifficultyValueInt(1, 1, 1, 1));
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_StartAI_Init () {
    gt_StartAI = TriggerCreate("gt_StartAI_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Reinforce Regions With Bullies
//--------------------------------------------------------------------------------------------------
bool gt_ReinforceRegionsWithBullies_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    AIToggleBulliesInRegion(gv_p04_HYBRID_THRALLS, RegionFromId(12), true);
    AIToggleBulliesInRegion(gv_p05_MOEBIUSTHRALLS, RegionFromId(12), true);
    AIToggleBulliesInRegion(gv_p06_MOEBISMASTERMINDS, RegionFromId(12), true);
    AIToggleBulliesInRegion(gv_p07_BLIGHTSPREADER, RegionFromId(12), true);
    AIToggleBulliesInRegion(gv_p09_ENTRALLEDDOMINION, RegionFromId(12), true);
    AIToggleBulliesInRegion(gv_p10_LEVIATHANBROOD, RegionFromId(12), true);
    Wait(600.0, c_timeGame);
    Wait(300.0, c_timeGame);
    Wait(300.0, c_timeGame);
    Wait(300.0, c_timeGame);
    AIToggleBulliesInRegion(gv_p05_MOEBIUSTHRALLS, RegionFromId(30), true);
    Wait(300.0, c_timeGame);
    AIToggleBulliesInRegion(gv_p06_MOEBISMASTERMINDS, RegionFromId(22), true);
    AIToggleBulliesInRegion(gv_p10_LEVIATHANBROOD, RegionFromId(37), true);
    Wait(300.0, c_timeGame);
    Wait(300.0, c_timeGame);
    AIToggleBulliesInRegion(gv_p06_MOEBISMASTERMINDS, RegionFromId(21), true);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_ReinforceRegionsWithBullies_Init () {
    gt_ReinforceRegionsWithBullies = TriggerCreate("gt_ReinforceRegionsWithBullies_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: P13 Khalai Attack Waves
//--------------------------------------------------------------------------------------------------
bool gt_P13KhalaiAttackWaves_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_aI;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_aI = 13;

    // Actions
    if (!runActions) {
        return true;
    }

    AIAttackWaveSetTargetPlayer(lv_aI, gv_hybridPlayers);
    AIAttackWaveSetGatherPoint(lv_aI, PointFromId(432995704));
    Wait(180.0, c_timeGame);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(1590082320), false);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(1275363609), false);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(1164942976), false);
    AIAttackWaveAddUnits4(5, 5, 6, 6, "ZealotAiur");
    AIAttackWaveAddUnits4(3, 3, 4, 4, "Dragoon");
    AIAttackWaveAddUnits4(2, 2, 2, 2, "SentryAiur");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Observer");
    AIAttackWaveSend(lv_aI, 180, true);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(1590082320), false);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(1275363609), false);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(1164942976), false);
    AIAttackWaveAddUnits4(5, 5, 6, 6, "ZealotAiur");
    AIAttackWaveAddUnits4(3, 3, 4, 4, "Dragoon");
    AIAttackWaveAddUnits4(2, 2, 2, 2, "SentryAiur");
    AIAttackWaveAddUnits4(1, 1, 2, 2, "ImmortalAiur");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Observer");
    AIAttackWaveSend(lv_aI, 180, true);
    AIAttackWaveAddWaypoint(lv_aI, UnitGetPosition(gv_reactorCore), false);
    AIAttackWaveAddUnits4(5, 5, 6, 6, "ZealotAiur");
    AIAttackWaveAddUnits4(4, 4, 5, 6, "Dragoon");
    AIAttackWaveAddUnits4(1, 1, 1, 2, "SentryAiur");
    AIAttackWaveAddUnits4(2, 2, 2, 2, "HighArchonTemplar");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Observer");
    AIAttackWaveAddUnits4(1, 1, 1, 2, "ImmortalAiur");
    AIAttackWaveSend(lv_aI, 180, true);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(1590082320), false);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(1275363609), false);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(1164942976), false);
    AIAttackWaveAddUnits4(5, 5, 6, 6, "ZealotAiur");
    AIAttackWaveAddUnits4(4, 4, 5, 6, "Dragoon");
    AIAttackWaveAddUnits4(3, 3, 3, 3, "Archon");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Observer");
    AIAttackWaveAddUnits4(3, 3, 3, 3, "Reaver");
    AIAttackWaveSend(lv_aI, 180, true);
    while (true) {
        Wait(1.0, c_timeGame);
        AIAttackWaveAddWaypoint(lv_aI, PointFromId(1590082320), false);
        AIAttackWaveAddWaypoint(lv_aI, PointFromId(1275363609), false);
        AIAttackWaveAddWaypoint(lv_aI, PointFromId(1164942976), false);
        AIAttackWaveAddUnits4(8, 8, 8, 8, "ZealotAiur");
        AIAttackWaveAddUnits4(3, 3, 4, 4, "Dragoon");
        AIAttackWaveAddUnits4(2, 2, 2, 2, "SentryAiur");
        AIAttackWaveAddUnits4(3, 3, 3, 3, "ImmortalAiur");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Observer");
        AIAttackWaveSend(lv_aI, 180, true);
        AIAttackWaveAddWaypoint(lv_aI, PointFromId(1590082320), false);
        AIAttackWaveAddWaypoint(lv_aI, PointFromId(1275363609), false);
        AIAttackWaveAddWaypoint(lv_aI, PointFromId(1164942976), false);
        AIAttackWaveAddUnits4(5, 5, 6, 6, "ZealotAiur");
        AIAttackWaveAddUnits4(4, 4, 5, 6, "Dragoon");
        AIAttackWaveAddUnits4(1, 1, 1, 2, "SentryAiur");
        AIAttackWaveAddUnits4(3, 3, 3, 3, "HighArchonTemplar");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Observer");
        AIAttackWaveAddUnits4(3, 3, 3, 3, "ImmortalAiur");
        AIAttackWaveSend(lv_aI, 180, true);
        AIAttackWaveAddWaypoint(lv_aI, UnitGetPosition(gv_reactorCore), false);
        AIAttackWaveAddUnits4(8, 8, 8, 8, "ZealotAiur");
        AIAttackWaveAddUnits4(4, 4, 5, 6, "Dragoon");
        AIAttackWaveAddUnits4(4, 4, 4, 5, "Archon");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Observer");
        AIAttackWaveAddUnits4(3, 3, 3, 3, "Reaver");
        AIAttackWaveSend(lv_aI, 180, true);
    }
    return true;
}

