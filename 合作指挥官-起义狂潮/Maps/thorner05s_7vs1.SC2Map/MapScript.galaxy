//--------------------------------------------------------------------------------------------------
// Trigger: Battlefront Tug of War
//--------------------------------------------------------------------------------------------------
bool gt_BattlefrontTugofWar_Func (bool testConds, bool runActions) {
    // Variable Declarations
    region lv_bullyRegion;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_bullyRegion = RegionFromId(24);

    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitGroupCount(UnitGroupAlliance(gv_p08_DOOMINIONSURVIVORSBROWN, c_unitAllianceEnemy, lv_bullyRegion, UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) == 0)) {
        AIToggleBulliesInRegion(gv_p08_DOOMINIONSURVIVORSBROWN, lv_bullyRegion, true);
    }
    else {
        AIToggleBulliesInRegion(gv_p08_DOOMINIONSURVIVORSBROWN, lv_bullyRegion, false);
    }
    if ((UnitGroupCount(UnitGroupAlliance(gv_p14_NERAZIM, c_unitAllianceEnemy, lv_bullyRegion, UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) == 0)) {
        AIToggleBulliesInRegion(gv_p14_NERAZIM, lv_bullyRegion, true);
    }
    else {
        AIToggleBulliesInRegion(gv_p14_NERAZIM, lv_bullyRegion, false);
    }
    if ((UnitGroupCount(UnitGroupAlliance(gv_p09_ENTRALLEDDOMINION, c_unitAllianceEnemy, lv_bullyRegion, UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) == 0)) {
        AIToggleBulliesInRegion(gv_p09_ENTRALLEDDOMINION, lv_bullyRegion, true);
    }
    else {
        AIToggleBulliesInRegion(gv_p09_ENTRALLEDDOMINION, lv_bullyRegion, false);
    }
    return true;
}

