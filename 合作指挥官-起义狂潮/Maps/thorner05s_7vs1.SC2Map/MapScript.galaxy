//--------------------------------------------------------------------------------------------------
// Trigger: Blightspreader Attack Waves
//--------------------------------------------------------------------------------------------------
bool gt_BlightspreaderAttackWaves_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_aI;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_aI = gv_p07_BLIGHTSPREADER;

    // Actions
    if (!runActions) {
        return true;
    }

    AIAttackWaveSetTargetPlayer(lv_aI, PlayerGroupAlliance(c_playerGroupEnemy, lv_aI));
    AIAttackWaveSetGatherPoint(lv_aI, PointFromId(770956654));
    Wait(240.0, c_timeGame);
    while (true) {
        Wait(1.0, c_timeGame);
        AIAttackWaveAddWaypoint(lv_aI, PointFromId(1505065936), false);
        AIAttackWaveAddUnits4(4, 4, 5, 6, "RoachCorpser");
        AIAttackWaveAddUnits4(2, 2, 2, 3, "Ravager");
        AIAttackWaveAddUnits4(2, 2, 3, 4, "Baneling");
        AIAttackWaveSend(lv_aI, 180, true);
        AIAttackWaveAddWaypoint(lv_aI, PointFromId(1505065936), false);
        AIAttackWaveAddUnits4(2, 2, 2, 3, "SwarmHostMP");
        AIAttackWaveAddUnits4(2, 2, 3, 3, "Queen");
        AIAttackWaveAddUnits4(3, 3, 4, 5, "RoachVile");
        AIAttackWaveSend(lv_aI, 180, true);
        AIAttackWaveAddWaypoint(lv_aI, PointFromId(1505065936), false);
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Kaboomer");
        AIAttackWaveAddUnits4(4, 4, 5, 6, "RoachCorpser");
        AIAttackWaveAddUnits4(1, 1, 2, 2, "BroodLord");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "HybridDestroyer");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Overseer");
        AIAttackWaveSend(lv_aI, 180, true);
        AIAttackWaveAddWaypoint(lv_aI, PointFromId(1505065936), false);
        AIAttackWaveAddUnits4(1, 1, 1, 2, "Infestor");
        AIAttackWaveAddUnits4(2, 2, 3, 4, "SwarmHostMP");
        AIAttackWaveAddUnits4(1, 1, 1, 2, "HotSNoxious");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Choker");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Overseer");
        AIAttackWaveSend(lv_aI, 180, true);
        AIAttackWaveAddWaypoint(lv_aI, PointFromId(1505065936), false);
        AIAttackWaveAddUnits4(5, 5, 6, 8, "Baneling");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Kaboomer");
        AIAttackWaveAddUnits4(2, 2, 3, 4, "Queen");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Overseer");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "HybridReaver");
        AIAttackWaveAddUnits4(1, 1, 1, 2, "Viper");
        AIAttackWaveSend(lv_aI, 180, true);
        AIAttackWaveAddWaypoint(lv_aI, PointFromId(1505065936), false);
        AIAttackWaveAddUnits4(4, 4, 5, 6, "RoachCorpser");
        AIAttackWaveAddUnits4(2, 2, 3, 4, "BroodLord");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Choker");
        AIAttackWaveAddUnits4(2, 2, 2, 3, "Infestor");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Overseer");
        AIAttackWaveSend(lv_aI, 180, true);
    }
    return true;
}

