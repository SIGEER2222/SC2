    lib67C0F0E7_gf_SetPGAllianceBetweenPG(lv_pg, gv_hybridPlayers, 1);
    lib67C0F0E7_gf_SetPGAllianceBetweenPG(lv_pg, PlayerGroupSingle(1), 1);
