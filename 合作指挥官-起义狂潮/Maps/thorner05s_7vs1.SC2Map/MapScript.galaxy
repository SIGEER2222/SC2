// Trigger: Missile Strikes
//--------------------------------------------------------------------------------------------------
bool gt_MissileStrikes_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unitgroup lv_plasmaTargets;
    unit lv_target;
    int lv_targetCount;
    int lv_desiredCasts;

    // Automatic Variable Declarations
    int auto5CE07217_n;
    int auto5CE07217_i;

    // Variable Initialization
    lv_plasmaTargets = UnitGroupEmpty();

    // Conditions
    if (testConds) {
        if (!((gv_hybridBusy == false))) {
            return false;
        }

        if (!((gv_gameOver == false))) {
            return false;
        }

        if (!((gv_hazrad != null))) {
            return false;
        }

        if (!((UnitIsAlive(gv_hazrad) == true))) {
            return false;
        }

        if (!((UnitGroupCount(gf_EnemiesWithinRange(gv_hazrad, 12.0, UnitFilter((1 << c_targetFilterGround), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32)))), c_unitCountAlive) >= 1))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    gv_hybridBusy = true;
    lv_plasmaTargets = gf_EnemiesWithinRange(gv_hazrad, 15.0, UnitFilter((1 << c_targetFilterGround), 0, (1 << c_targetFilterWorker) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))));
    auto5CE07217_n = gv_missileStrikeCount;
    for (auto5CE07217_i = 1; auto5CE07217_i <= auto5CE07217_n; auto5CE07217_i += 1) {
        lv_target = UnitGroupRandomUnit(lv_plasmaTargets, c_unitCountAlive);
        UnitCreateEffectPoint(gv_hazrad, "TitanMechMissileShot", UnitGetPosition(lv_target));
        Wait(0.5, c_timeGame);
    }
    gv_hybridBusy = false;
    Wait(20.0, c_timeGame);
    TriggerEnable(TriggerGetCurrent(), true);
    return true;
}

