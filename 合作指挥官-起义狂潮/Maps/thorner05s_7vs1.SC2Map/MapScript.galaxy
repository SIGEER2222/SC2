    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == 1))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    UnitIssueOrder(UnitFromId(1232259093), OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(163)), c_orderQueueReplace);
    TriggerQueueEnter();
    libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TValerian02ADominionMarine600039", c_soundIndexAny), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TValerian02ARaynor00072", c_soundIndexAny), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    TriggerQueueExit();
    return true;
}

