//--------------------------------------------------------------------------------------------------
bool gt_VictoryCoreDestroyed_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_gameOver == false))) {
            return false;
        }

        if (!((TriggerGetExecCount(TriggerGetCurrent()) == 0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    TriggerEnable(gt_DefeatBaseDead, false);
    TriggerEnable(gt_DefeatIntroFailed, false);
    TriggerEnable(gt_HybridRespawnTimer, false);
    gv_gameOver = true;
    TriggerExecute(gt_VictoryQ, true, true);
    return true;
}

