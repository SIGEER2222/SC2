string gf_ResolveUnitTypeWithFallback3 (string lp_primary, string lp_fallbackA, string lp_fallbackB) {
    string lv_unitType;

    lv_unitType = libE0EAE146_gf_CatalogUnitOrEmpty(lp_primary);
    if (lv_unitType != "") {
        return lv_unitType;
    }

    lv_unitType = libE0EAE146_gf_CatalogUnitOrEmpty(lp_fallbackA);
    if (lv_unitType != "") {
        return lv_unitType;
    }

    return libE0EAE146_gf_CatalogUnitOrEmpty(lp_fallbackB);
}

void gf_CreateUnitsWithDefaultFacingFallback3 (int lp_count, string lp_primary, string lp_fallbackA, string lp_fallbackB, int lp_player, point lp_spawnPoint) {
    string lv_unitType;

    lv_unitType = gf_ResolveUnitTypeWithFallback3(lp_primary, lp_fallbackA, lp_fallbackB);
    if (lv_unitType == "") {
        return;
    }

    libNtve_gf_CreateUnitsWithDefaultFacing(lp_count, lv_unitType, 0, lp_player, lp_spawnPoint);
}
