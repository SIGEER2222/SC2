        AIAttackWaveAddUnits4(4, 4, 5, 6, "MengskHellion");
        AIAttackWaveAddUnits4(5, 5, 6, 8, "MengskMarine");
        AIAttackWaveAddUnits4(1, 1, 1, 2, "Raven");
        AIAttackWaveSend(lv_aI, 180, true);
        AIAttackWaveAddUnits4(4, 4, 5, 6, "MengskVikingFighter");
        AIAttackWaveAddUnits4(4, 4, 5, 6, "Battlecruiser");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "MengskBC");
        AIAttackWaveAddUnits4(3, 3, 4, 5, "MengskHellion");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "ScienceVessel");
        AIAttackWaveSend(lv_aI, 180, true);
    }
    return true;
}

