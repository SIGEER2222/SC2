//--------------------------------------------------------------------------------------------------
// Trigger: Start Game Main
//--------------------------------------------------------------------------------------------------
bool gt_StartGameMain_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    // 7vs1 hybrid: keep XM runtime + commander selection state, but avoid

    // spawning the legacy XM base because CoopZeroPop owns the playable start.
    lib67C0F0E7_gf_ObjectiveNew(true, StringExternal("Param/Value/B16D45DF"), 1, false, 0, 0);
    lib67C0F0E7_gf_ObjectiveNew(true, StringExternal("Param/Value/3683DAA8"), 2, true, 0, 5);
    lib67C0F0E7_gf_ObjectiveNew(false, StringExternal("Param/Value/7C4A0757"), 1, true, 0, 2);
