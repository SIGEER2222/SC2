//--------------------------------------------------------------------------------------------------
// Trigger: powerplant
//--------------------------------------------------------------------------------------------------
bool gt_powerplant_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    UnitGroupLoopBegin(UnitGroup(null, 1, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    while (!UnitGroupLoopDone()) {
        UnitIssueOrder(UnitGroupLoopCurrent(), Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();
    VisRevealArea(1, RegionFromId(16), 20.0, false);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(1892), true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/30FD0D4A"), StringExternal("Param/Value/BAE059D0"), 10.0, c_transmissionDurationAdd, false);
    CameraApplyInfo(1, CameraInfoFromId(1985), 1.0, -1, 10, true);
    return true;
}

