    Wait(2.0, c_timeReal);
    UnitIssueOrder(UnitFromId(517), Order(AbilityCommand("SecurityGateDiagonalULBRLowered", 0)), c_orderQueueReplace);
    Wait(3.0, c_timeReal);
    CameraApplyInfo(1, CameraInfoFromId(1899), 0.0, -1, 10, true);
    CameraApplyInfo(1, CameraInfoFromId(1900), 12.0, -1, 10, true);
