//--------------------------------------------------------------------------------------------------
// Trigger: Start
//--------------------------------------------------------------------------------------------------
bool gt_Start_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    UnitCargoCreate(UnitFromId(1), "Marine", 5);
    UnitCargoCreate(UnitFromId(1), "Medic", 2);
    libNtve_gf_MakeUnitUncommandable(UnitFromId(1), true);
    UnitIssueOrder(UnitFromId(1), OrderTargetingPoint(AbilityCommand("SpecOpsDropshipTransport", 2), PointFromId(2)), c_orderQueueReplace);
    UnitIssueOrder(UnitFromId(1), OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(3)), c_orderQueueAddToEnd);
    TriggerEnable(gt_ultralisk2, false);
    TriggerEnable(gt_Diamondbacks2, false);
    libNtve_gf_AddUnitGroupToUnitGroup(UnitGroup(null, 2, RegionFromId(18), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), gv_powergroup);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_Start_Init () {
    gt_Start = TriggerCreate("gt_Start_Func");
    TriggerAddEventMapInit(gt_Start);
}

