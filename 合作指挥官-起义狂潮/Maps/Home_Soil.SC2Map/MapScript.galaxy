void gt_powerplant_Init () {
    gt_powerplant = TriggerCreate("gt_powerplant_Func");
    TriggerAddEventUnitRegion(gt_powerplant, null, RegionFromId(15), true);
}

//--------------------------------------------------------------------------------------------------
// Trigger: win
//--------------------------------------------------------------------------------------------------
bool gt_win_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == 1))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    ObjectiveSetState(DataTableGetObjective(true, "obj3"), c_objectiveStateCompleted);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(1892), true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/E3F1ADE1"), StringExternal("Param/Value/2ABFAFAB"), 4.0, c_transmissionDurationAdd, false);
    Wait(3.0, c_timeReal);
    GameOver(1, c_gameOverVictory, true, true);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_win_Init () {
    gt_win = TriggerCreate("gt_win_Func");
    TriggerAddEventUnitRegion(gt_win, null, RegionFromId(19), true);
}

//--------------------------------------------------------------------------------------------------
// Trigger: intro
//--------------------------------------------------------------------------------------------------
bool gt_intro_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    CinematicFade(false, 0.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    libNtve_gf_CinematicMode(true, PlayerGroupAll(), 0.0);
    libNtve_gf_GlobalCinematicSetting(true);
    CameraApplyInfo(1, CameraInfoFromId(2008), 0.0, -1, 10, true);
    CameraApplyInfo(1, CameraInfoFromId(2009), 16.0, -1, 10, true);
    CinematicFade(true, 1.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    Wait(1.0, c_timeReal);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(1892), true, false, "Talk"), libNtve_gf_CinematicPortrait(2), "Talk", null, StringExternal("Param/Value/4EDD114F"), StringExternal("Param/Value/7648D73C"), 8.0, c_transmissionDurationAdd, false);
    Wait(8.0, c_timeReal);
    CinematicFade(false, 1.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    Wait(1.0, c_timeReal);
    UnitSetPosition(UnitFromId(1892), PointFromId(2), false);
    libNtve_gf_GlobalCinematicSetting(false);
    CameraApplyInfo(1, CameraInfoFromId(2010), 0.0, -1, 10, true);
    libNtve_gf_CinematicMode(false, PlayerGroupAll(), 1.0);
    CinematicFade(true, 1.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    Wait(1.0, c_timeReal);
    ObjectiveCreate(StringExternal("Param/Value/96AFA351"), StringExternal("Param/Value/1431B0EE"), c_objectiveStateActive, true);
    DataTableSetObjective(true, "obj1", ObjectiveLastCreated());
    Wait(1.0, c_timeReal);
    ObjectiveCreate(StringExternal("Param/Value/A68DB222"), StringExternal("Param/Value/FF46D65D"), c_objectiveStateActive, true);
    DataTableSetObjective(true, "obj2", ObjectiveLastCreated());
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_intro_Init () {
    gt_intro = TriggerCreate("gt_intro_Func");
    TriggerAddEventMapInit(gt_intro);
}

