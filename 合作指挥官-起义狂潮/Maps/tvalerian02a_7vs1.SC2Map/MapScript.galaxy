void gf_CreateUnburrowingUnits (int lp_qty, string lp_type, point lp_loc) {
    // Variable Declarations
    unitgroup lv_unitGroup;

    // Automatic Variable Declarations
    int auto7F6C0283_ae;
    int auto7F6C0283_var;
    unitgroup auto5A17B323_g;
    int auto5A17B323_u;
    unit auto5A17B323_var;

    // Variable Initialization
    lv_unitGroup = UnitGroupEmpty();

    // Implementation
    if ((lp_qty >= 1) && (lp_type != null)) {
        auto7F6C0283_ae = lp_qty;
        auto7F6C0283_var = 1;
        for ( ; auto7F6C0283_var <= auto7F6C0283_ae; auto7F6C0283_var += 1 ) {
            UnitCreate(1, lp_type, 0, gv_p2_JORMUNGAND, lp_loc, libNtve_gf_RandomAngle());
            UnitSetPropertyFixed(UnitLastCreated(), c_unitPropEnergyPercent, 100.0);
            UnitGroupAdd(lv_unitGroup, UnitLastCreated());
        }
        auto5A17B323_g = lv_unitGroup;
        auto5A17B323_u = UnitGroupCount(auto5A17B323_g, c_unitCountAll);
        for (;; auto5A17B323_u -= 1) {
            auto5A17B323_var = UnitGroupUnitFromEnd(auto5A17B323_g, auto5A17B323_u);
            if (auto5A17B323_var == null) { break; }
            gf_ActivateAI(auto5A17B323_var);
        }
    }

}

