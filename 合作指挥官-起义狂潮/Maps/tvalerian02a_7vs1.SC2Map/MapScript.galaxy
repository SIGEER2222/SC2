        return true;
    }

    Wait(300.0, c_timeGame);
    RegionAddRegion(gv_nydusSpawnRegions, RegionFromId(26));
    RegionAddRegion(gv_nydusSpawnRegions, RegionFromId(28));
    Wait(300.0, c_timeGame);
    Wait(300.0, c_timeGame);
    Wait(300.0, c_timeGame);
    RegionAddRegion(gv_nydusSpawnRegions, RegionFromId(29));
    RegionAddRegion(gv_nydusSpawnRegions, RegionFromId(30));
    gv_nydusSpawnCount += libNtve_gf_DifficultyValueInt(0, 0, 1, 0);
    Wait(300.0, c_timeGame);
    RegionAddRegion(gv_nydusSpawnRegions, RegionFromId(31));
    RegionAddRegion(gv_nydusSpawnRegions, RegionFromId(33));
    gv_nydusSpawnCount += libNtve_gf_DifficultyValueInt(1, 1, 0, 1);
    Wait(300.0, c_timeGame);
    RegionAddRegion(gv_nydusSpawnRegions, RegionFromId(34));
    RegionAddRegion(gv_nydusSpawnRegions, RegionFromId(35));
    Wait(300.0, c_timeGame);
    RegionAddRegion(gv_nydusSpawnRegions, RegionFromId(36));
    RegionAddRegion(gv_nydusSpawnRegions, RegionFromId(4));
    gv_nydusSpawnCount += libNtve_gf_DifficultyValueInt(0, 0, 1, 1);
    return true;
}

