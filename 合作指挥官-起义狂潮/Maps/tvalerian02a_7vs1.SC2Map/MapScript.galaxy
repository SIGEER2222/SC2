        UnitKill(auto6173242E_var);
    }
    auto51C898A6_g = UnitGroup("Drone", gv_p5_GRENDEL, null, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
