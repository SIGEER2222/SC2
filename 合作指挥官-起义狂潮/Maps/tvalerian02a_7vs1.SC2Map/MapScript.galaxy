//--------------------------------------------------------------------------------------------------
bool gt_PlantSWCharge_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == 1))) {
            return false;
        }

        if (!((UnitFilterMatch(EventUnit(), 1, UnitFilter((1 << c_targetFilterWorker), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterSummoned - 32)))) == true))) {
            return false;
        }

        if (!((TriggerGetExecCount(TriggerGetCurrent()) == 0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(gt_GrendelDroneReinforcements, false);
    TimerPause(gv_caveTimer, true);
    libNtve_gf_UnitCreateFacingPoint(1, "NukePack", 0, 0, UnitGetPosition(UnitFromId(1998)), UnitGetPosition(EventUnit()));
    libNtve_gf_MakeUnitInvulnerable(UnitLastCreated(), true);
    UnitKill(UnitFromId(1998));
    TimerStart(gv_sWDetTimer, 60.0, false, c_timeGame);
    gv_sWDetTimerWindow = TimerWindowLastCreated();
    TriggerExecute(gt_ChargePlantedQ, true, false);
    return true;
}

