    AIAttackWaveAddUnits4(5, 5, 6, 6, "MengskMarine");
    AIAttackWaveAddUnits4(3, 3, 3, 3, "MengskFirebat");
    AIAttackWaveAddUnits4(3, 3, 3, 3, "MengskMedic");
    AIAttackWaveAddUnits4(2, 2, 2, 2, "Thor");
    AIAttackWaveSend(lv_aI, 200, true);
    AIAttackWaveAddUnits4(3, 3, 3, 3, "Ghost");
    AIAttackWaveAddUnits4(3, 3, 3, 3, "MengskFirebat");
    AIAttackWaveAddUnits4(5, 5, 6, 6, "Reaper");
    AIAttackWaveAddUnits4(4, 4, 4, 4, "Diamondback");
    AIAttackWaveAddUnits4(4, 4, 4, 4, "SiegeTank");
    AIAttackWaveAddUnits4(1, 1, 1, 2, "MengskMedic");
    AIAttackWaveSend(lv_aI, 200, true);
    AIAttackWaveAddUnits4(3, 3, 3, 3, "WarHound");
    AIAttackWaveAddUnits4(6, 6, 7, 7, "MengskMarine");
    AIAttackWaveAddUnits4(4, 4, 4, 4, "MengskMedic");
    AIAttackWaveAddUnits4(1, 1, 1, 2, "MengskMarauder");
    AIAttackWaveAddUnits4(3, 3, 4, 4, "SiegeTank");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Thor");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Ghost");
    AIAttackWaveSend(lv_aI, 240, true);
    while (true) {
        Wait(1.0, c_timeGame);
        AIAttackWaveAddUnits4(3, 3, 3, 3, "Reaper");
        AIAttackWaveAddUnits4(3, 3, 3, 3, "Goliath");
        AIAttackWaveAddUnits4(5, 5, 6, 6, "Ghost");
        AIAttackWaveAddUnits4(5, 5, 6, 6, "MengskMarine");
        AIAttackWaveAddUnits4(4, 4, 4, 4, "MengskFirebat");
        AIAttackWaveAddUnits4(3, 3, 3, 3, "MengskMedic");
        AIAttackWaveSend(lv_aI, 200, true);
        AIAttackWaveAddUnits4(4, 4, 4, 4, "Ghost");
        AIAttackWaveAddUnits4(3, 3, 3, 3, "WarHound");
        AIAttackWaveAddUnits4(5, 5, 6, 6, "Reaper");
        AIAttackWaveAddUnits4(4, 4, 4, 4, "MengskFirebat");
        AIAttackWaveAddUnits4(4, 4, 4, 4, "MengskSiegeTank");
        AIAttackWaveAddUnits4(1, 1, 1, 2, "MengskMedic");
        AIAttackWaveSend(lv_aI, 200, true);
        AIAttackWaveAddUnits4(3, 3, 3, 3, "WarHound");
