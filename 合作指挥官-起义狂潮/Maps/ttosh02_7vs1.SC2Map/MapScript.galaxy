        if (!((UnitIsAlive(UnitFromId(2648)) == true))) {
            return false;
        }

        if (!((UnitGroupHasUnit(gv_nEDefendersGroup, EventUnit()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
