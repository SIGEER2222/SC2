//--------------------------------------------------------------------------------------------------
// Trigger: Tosh Attack Waves
//--------------------------------------------------------------------------------------------------
bool gt_ToshAttackWaves_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_aI;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_aI = 8;

    // Actions
    if (!runActions) {
        return true;
    }

    AIAttackWaveSetTargetPlayer(lv_aI, PlayerGroupAlliance(c_playerGroupEnemy, lv_aI));
    AIAttackWaveSetGatherPoint(lv_aI, PointFromId(1936945268));
    Wait(150.0, c_timeGame);
    AIAttackWaveAddUnits4(7, 7, 8, 10, "Reaper");
    AIAttackWaveAddUnits4(3, 3, 3, 4, "Goliath");
    AIAttackWaveSend(lv_aI, 140, true);
    AIAttackWaveAddUnits4(7, 7, 8, 10, "Reaper");
    AIAttackWaveAddUnits4(2, 2, 3, 3, "Wraith");
    AIAttackWaveAddUnits4(2, 2, 2, 3, "Medic");
    AIAttackWaveSend(lv_aI, 140, true);
    AIAttackWaveAddUnits4(3, 3, 4, 5, "Goliath");
    AIAttackWaveAddUnits4(2, 2, 2, 3, "Medic");
    AIAttackWaveAddUnits4(3, 3, 4, 5, "Spectre");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Raven");
    AIAttackWaveSend(lv_aI, 140, true);
    AIAttackWaveAddUnits4(3, 3, 3, 4, "Goliath");
    AIAttackWaveAddUnits4(6, 6, 7, 8, "Wraith");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Raven");
    AIAttackWaveSend(lv_aI, 140, true);
    AIAttackWaveAddUnits4(7, 7, 8, 10, "Reaper");
    AIAttackWaveAddUnits4(3, 3, 3, 4, "Goliath");
    AIAttackWaveAddUnits4(3, 3, 3, 4, "Medic");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Raven");
    AIAttackWaveSend(lv_aI, 180, true);
    while (true) {
        Wait(1.0, c_timeGame);
        AIAttackWaveAddUnits4(3, 3, 4, 5, "Goliath");
        AIAttackWaveAddUnits4(2, 2, 2, 3, "Medic");
        AIAttackWaveAddUnits4(3, 3, 4, 5, "Spectre");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Raven");
        AIAttackWaveSend(lv_aI, 140, true);
        AIAttackWaveAddUnits4(3, 3, 3, 4, "Goliath");
        AIAttackWaveAddUnits4(6, 6, 7, 8, "Wraith");
        AIAttackWaveAddUnits4(2, 2, 2, 2, "Spectre");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Raven");
        AIAttackWaveSend(lv_aI, 140, true);
        AIAttackWaveAddUnits4(7, 7, 8, 10, "Reaper");
        AIAttackWaveAddUnits4(3, 3, 3, 4, "Goliath");
        AIAttackWaveAddUnits4(3, 3, 3, 4, "Medic");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Raven");
        AIAttackWaveSend(lv_aI, 140, true);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_ToshAttackWaves_Init () {
    gt_ToshAttackWaves = TriggerCreate("gt_ToshAttackWaves_Func");
}

