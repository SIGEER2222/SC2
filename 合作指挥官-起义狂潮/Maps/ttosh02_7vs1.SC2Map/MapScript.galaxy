//--------------------------------------------------------------------------------------------------
bool gt_ToshKills_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!(((UnitGetOwner(libNtve_gf_KillingUnit()) == gv_p8_TOSH)))) {
            return false;
        }

        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gv_allyKills += 1;
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_ToshKills_Init () {
    gt_ToshKills = TriggerCreate("gt_ToshKills_Func");
    TriggerAddEventUnitDied(gt_ToshKills, null);
}

