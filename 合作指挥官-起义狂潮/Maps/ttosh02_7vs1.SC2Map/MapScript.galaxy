    AIAttackWaveAddUnits4(1, 1, 1, 2, "Monitor");
    AIAttackWaveSend(lv_aI, 180, true);
    while (true) {
        Wait(1.0, c_timeGame);
        AIAttackWaveAddUnits4(10, 10, 12, 14, "Zealot");
        AIAttackWaveAddUnits4(2, 2, 3, 4, "VoidRayTaldarim");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Carrier");
        AIAttackWaveSend(lv_aI, 180, true);
        AIAttackWaveAddUnits4(5, 5, 6, 8, "Scout");
        AIAttackWaveAddUnits4(4, 4, 5, 6, "Stalker");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Observer");
        AIAttackWaveSend(lv_aI, 180, true);
