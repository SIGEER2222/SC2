    AIToggleBulliesInRegion(gv_p13_VOIDSHADESDEVOURER, RegionFromId(59), true);
    Wait(120.0, c_timeGame);
    AIToggleBulliesInRegion(gv_p6_FORWARDGUARD, RegionFromId(60), true);
    Wait(240.0, c_timeGame);
    AIToggleBulliesInRegion(gv_p10_VOIDSHADESRIGHT, RegionFromId(49), true);
    Wait(240.0, c_timeGame);
    AIToggleBulliesInRegion(gv_p6_FORWARDGUARD, RegionFromId(60), false);
    AIToggleBulliesInRegion(gv_p6_FORWARDGUARD, RegionFromId(49), true);
    Wait(120.0, c_timeGame);
    AIToggleBulliesInRegion(gv_p11_VOIDSHADESLEFT, RegionFromId(56), true);
    AIToggleBulliesInRegion(gv_p10_VOIDSHADESRIGHT, RegionFromId(50), true);
    Wait(120.0, c_timeGame);
    AIToggleBulliesInRegion(gv_p6_FORWARDGUARD, RegionFromId(62), true);
    Wait(180.0, c_timeGame);
    AIToggleBulliesInRegion(gv_p12_VOIDSHADESTOP, RegionFromId(53), true);
    AIToggleBulliesInRegion(gv_p11_VOIDSHADESLEFT, RegionFromId(57), true);
    AIToggleBulliesInRegion(gv_p4_PROTOSS_WEST_ESCORTS, RegionFromId(57), true);
    AIToggleBulliesInRegion(gv_p7_DEATHFLEET, RegionFromId(61), true);
    Wait(180.0, c_timeGame);
    AIToggleBulliesInRegion(gv_p7_DEATHFLEET, RegionFromId(58), true);
    AIToggleBulliesInRegion(gv_p4_PROTOSS_WEST_ESCORTS, RegionFromId(54), true);
    Wait(120.0, c_timeGame);
    AIToggleBulliesInRegion(gv_p12_VOIDSHADESTOP, RegionFromId(54), true);
    AIToggleBulliesInRegion(gv_p7_DEATHFLEET, RegionFromId(63), true);
    AIToggleBulliesInRegion(gv_p2_PROTOSS_EAST_ATTACKERS, RegionFromId(64), true);
    AIToggleBulliesInRegion(gv_p2_PROTOSS_EAST_ATTACKERS, RegionFromId(53), true);
