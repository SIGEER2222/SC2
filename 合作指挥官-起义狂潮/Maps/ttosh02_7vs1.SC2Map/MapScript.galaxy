//--------------------------------------------------------------------------------------------------
// Trigger: Start Game
//--------------------------------------------------------------------------------------------------
bool gt_StartGame_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    libE0EAE146_gf_StartGame();
    if ((PlayerCommander(gv_p1_USER) == "Stukov")) {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "SIInfestedBunker", 0, gv_p1_USER, PointWithOffsetPolar(PlayerStartLocation(gv_p1_USER), 4.0, 180.0));
    }
    if ((PlayerCommander(gv_p1_USER) == "Abathur")) {
        libE0EAE146_gv_abathurBiomassTestPickupCreated = true;
        libE0EAE146_gf_InitializeAbathurBiomass(gv_p1_USER, "BiomassPickupDummy");
        libE0EAE146_gf_AbathurCreateUnitsWithFullBiomass(1, "Roach", gv_p1_USER, PointWithOffsetPolar(PlayerStartLocation(gv_p1_USER), 4.0, 0.0));
    }
    libNtve_gf_ShareVisionofUnit(UnitFromId(34), true, gv_p1_USER);
    TimerStart(gv_protossAggroTimer, 180.0, false, c_timeGame);
    lib67C0F0E7_gf_ObjectiveNew(true, StringExternal("Param/Value/3675CDE7"), 1, true, 0, 7);
    lib67C0F0E7_gf_ObjectiveNew(true, StringExternal("Param/Value/55562D6E"), 2, true, 0, 7);
    lib67C0F0E7_gf_ObjectiveNew(false, StringExternal("Param/Value/4E24E59C"), 1, true, 0, 3);
    lib67C0F0E7_gf_ObjectiveNew(false, StringExternal("Param/Value/619C3E29"), 2, false, 0, 3);
    Wait(1.0, c_timeReal);
    lib67C0F0E7_gf_ObjectiveSet(true, 1, lib67C0F0E7_ge_ObjectiveSet_Show);
    Wait(1.0, c_timeReal);
    lib67C0F0E7_gf_ObjectiveSet(true, 2, lib67C0F0E7_ge_ObjectiveSet_Show);
    Wait(1.0, c_timeReal);
    lib67C0F0E7_gf_ObjectiveSet(false, 1, lib67C0F0E7_ge_ObjectiveSet_Show);
    Wait(1.0, c_timeReal);
    lib67C0F0E7_gf_ObjectiveSet(false, 2, lib67C0F0E7_ge_ObjectiveSet_Show);
    Wait(8.0, c_timeReal);
    TriggerExecute(gt_GoliathandGatherTerrazineTipsQ, true, false);
    Wait(4.0, c_timeGame);
    Wait(8.0, c_timeReal);
    return true;
}

