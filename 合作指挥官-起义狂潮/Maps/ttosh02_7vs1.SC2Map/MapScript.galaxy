        AIAttackWaveAddUnits4(1, 1, 1, 2, "Tempest");
        AIAttackWaveAddUnits4(2, 2, 3, 4, "Stalker");
        AIAttackWaveAddUnits4(1, 1, 1, 2, "Monitor");
        AIAttackWaveSend(lv_aI, 180, true);
    }
    return true;
}

