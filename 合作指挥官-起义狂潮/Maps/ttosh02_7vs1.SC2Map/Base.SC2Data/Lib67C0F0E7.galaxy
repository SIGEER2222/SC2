include "TriggerLibs/NativeLib"

const int lib67C0F0E7_ge_ObjectiveSet_Add = 0;
const int lib67C0F0E7_ge_ObjectiveSet_Minus = 1;
const int lib67C0F0E7_ge_ObjectiveSet_Defeat = 2;
const int lib67C0F0E7_ge_ObjectiveSet_Finish = 3;
const int lib67C0F0E7_ge_ObjectiveSet_FinishM = 4;
const int lib67C0F0E7_ge_ObjectiveSet_Hide = 5;
const int lib67C0F0E7_ge_ObjectiveSet_Show = 6;

void lib67C0F0E7_InitLib () {
}

bool lib67C0F0E7_gf_BitMaskTrueIndex (int lp_bit, int lp_index) {
    int lv_i;
    lv_i = (1 << lp_index);
    return ((lp_bit & lv_i) == lv_i);
}

void lib67C0F0E7_gf_AIIgnoreCost (int lp_p) {
    PlayerSetState(lp_p, c_playerStateMineralCostIgnored, true);
    PlayerSetState(lp_p, c_playerStateVespeneCostIgnored, true);
    PlayerSetState(lp_p, c_playerStateFoodIgnored, true);
}

void lib67C0F0E7_gf_SetAllianceTo (int lp_p1, int lp_p2, int lp_aG) {
    PlayerSetAlliance(lp_p1, c_allianceIdPassive, lp_p2, lib67C0F0E7_gf_BitMaskTrueIndex(lp_aG, 0));
    PlayerSetAlliance(lp_p1, c_allianceIdVision, lp_p2, lib67C0F0E7_gf_BitMaskTrueIndex(lp_aG, 1));
    PlayerSetAlliance(lp_p1, c_allianceIdControl, lp_p2, lib67C0F0E7_gf_BitMaskTrueIndex(lp_aG, 2));
    PlayerSetAlliance(lp_p1, c_allianceIdSpend, lp_p2, lib67C0F0E7_gf_BitMaskTrueIndex(lp_aG, 3));
    PlayerSetAlliance(lp_p1, c_allianceIdTrade, lp_p2, lib67C0F0E7_gf_BitMaskTrueIndex(lp_aG, 4));
    PlayerSetAlliance(lp_p1, c_allianceIdSeekHelp, lp_p2, lib67C0F0E7_gf_BitMaskTrueIndex(lp_aG, 5));
    PlayerSetAlliance(lp_p1, c_allianceIdGiveHelp, lp_p2, lib67C0F0E7_gf_BitMaskTrueIndex(lp_aG, 6));
    PlayerSetAlliance(lp_p1, c_allianceIdChat, lp_p2, lib67C0F0E7_gf_BitMaskTrueIndex(lp_aG, 7));
    PlayerSetAlliance(lp_p1, c_allianceIdDefeat, lp_p2, lib67C0F0E7_gf_BitMaskTrueIndex(lp_aG, 8));
    PlayerSetAlliance(lp_p1, c_allianceIdPushable, lp_p2, lib67C0F0E7_gf_BitMaskTrueIndex(lp_aG, 9));
    PlayerSetAlliance(lp_p1, c_allianceIdPower, lp_p2, lib67C0F0E7_gf_BitMaskTrueIndex(lp_aG, 10));
}

void lib67C0F0E7_gf_SetAllianceBetween (int lp_p1, int lp_p2, int lp_aG) {
    lib67C0F0E7_gf_SetAllianceTo(lp_p1, lp_p2, lp_aG);
    lib67C0F0E7_gf_SetAllianceTo(lp_p2, lp_p1, lp_aG);
}

void lib67C0F0E7_gf_SetPGAlliance (playergroup lp_pG, int lp_alliance) {
    int lv_i;
    int lv_p1;
    int lv_p2;

    lv_i = PlayerGroupCount(lp_pG);
    if (lv_i < 2) {
        return;
    }

    lv_p1 = 1;
    for (; (lv_p1 <= (lv_i - 1)); lv_p1 += 1) {
        lv_p2 = lv_p1 + 1;
        for (; (lv_p2 <= lv_i); lv_p2 += 1) {
            lib67C0F0E7_gf_SetAllianceBetween(PlayerGroupPlayer(lp_pG, lv_p1), PlayerGroupPlayer(lp_pG, lv_p2), lp_alliance);
        }
    }
}

void lib67C0F0E7_gf_SetPGAllianceBetweenPG (playergroup lp_sourcePlayers, playergroup lp_targetPlayers, int lp_aG) {
    int lv_p1;
    int lv_p2;

    lv_p1 = -1;
    while (true) {
        lv_p1 = PlayerGroupNextPlayer(lp_sourcePlayers, lv_p1);
        if (lv_p1 < 0) {
            break;
        }

        lv_p2 = -1;
        while (true) {
            lv_p2 = PlayerGroupNextPlayer(lp_targetPlayers, lv_p2);
            if (lv_p2 < 0) {
                break;
            }
            lib67C0F0E7_gf_SetAllianceBetween(lv_p1, lv_p2, lp_aG);
        }
    }
}

string lib67C0F0E7_gf_ObjectiveKey (bool lp_typeP, int lp_index) {
    if (lp_typeP == true) {
        return ("MainObjective" + IntToString(lp_index));
    }
    return ("MinorObjective" + IntToString(lp_index));
}

void lib67C0F0E7_gf_ObjectiveNew (bool lp_typeP, text lp_text, int lp_index, bool lp_isMulti, int lp_now, int lp_total) {
    string lv_key;

    lv_key = lib67C0F0E7_gf_ObjectiveKey(lp_typeP, lp_index);
    ObjectiveCreate(lp_text, StringToText(""), c_objectiveStateHidden, lp_typeP);
    DataTableSetObjective(true, lv_key, ObjectiveLastCreated());
    DataTableSetText(true, (lv_key + "Text"), lp_text);
    DataTableSetInt(true, (lv_key + "Now"), lp_now);
    DataTableSetInt(true, (lv_key + "Total"), lp_total);
}

void lib67C0F0E7_gf_ObjectiveSet (bool lp_typeP, int lp_index, int lp_set) {
    string lv_key;
    int lv_now;

    lv_key = lib67C0F0E7_gf_ObjectiveKey(lp_typeP, lp_index);
    if (lp_set == lib67C0F0E7_ge_ObjectiveSet_Show) {
        ObjectiveSetState(DataTableGetObjective(true, lv_key), c_objectiveStateActive);
    }
    else if ((lp_set == lib67C0F0E7_ge_ObjectiveSet_Finish) || (lp_set == lib67C0F0E7_ge_ObjectiveSet_FinishM)) {
        ObjectiveSetState(DataTableGetObjective(true, lv_key), c_objectiveStateCompleted);
    }
    else if (lp_set == lib67C0F0E7_ge_ObjectiveSet_Defeat) {
        ObjectiveSetState(DataTableGetObjective(true, lv_key), c_objectiveStateFailed);
    }
    else if (lp_set == lib67C0F0E7_ge_ObjectiveSet_Hide) {
        ObjectiveSetState(DataTableGetObjective(true, lv_key), c_objectiveStateHidden);
    }
    else if (lp_set == lib67C0F0E7_ge_ObjectiveSet_Add) {
        lv_now = DataTableGetInt(true, (lv_key + "Now"));
        DataTableSetInt(true, (lv_key + "Now"), (lv_now + 1));
    }
    else if (lp_set == lib67C0F0E7_ge_ObjectiveSet_Minus) {
        lv_now = DataTableGetInt(true, (lv_key + "Now"));
        DataTableSetInt(true, (lv_key + "Now"), (lv_now - 1));
    }
}

void lib67C0F0E7_gf_Defeat () {
    GameOver(1, c_gameOverDefeat, false, false);
}
