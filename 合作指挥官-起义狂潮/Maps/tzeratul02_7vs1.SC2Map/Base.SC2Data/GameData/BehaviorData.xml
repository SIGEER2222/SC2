        <MaxStackCount value="50"/>
        <Duration value="50"/>
        <Modification MoveSpeedMultiplier="1.01" AttackSpeedMultiplier="1.02"/>
    </CBehaviorBuff>
    <CBehaviorAttribute id="ShapePeartzeratul02">
        <BehaviorFlags index="Permanent" value="1"/>
        <EditorCategories value="AbilityorEffectType:Units"/>
        <Modification>
            <StateFlags index="SuppressLifeRegen" value="1"/>
            <StateFlags index="SuppressShieldsRegen" value="1"/>
            <StateFlags index="SuppressEnergyRegen" value="1"/>
        </Modification>
    </CBehaviorAttribute>
