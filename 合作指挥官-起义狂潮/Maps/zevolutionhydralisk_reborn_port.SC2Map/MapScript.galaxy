    while (true) {
        for (auto63754EC2_i = 1; auto63754EC2_i <= auto63754EC2_n; auto63754EC2_i += 1) {
            AIAttackWaveAddUnits4(1, 1, 1, 1, "UmojanLabMicrobot");
