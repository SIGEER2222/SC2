//--------------------------------------------------------------------------------------------------
bool gt_VoidThrasherEncounter_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup auto0D5921C5_g;
    int auto0D5921C5_u;
    unit auto0D5921C5_var;

    // Actions
    if (!runActions) {
        return true;
    }

    auto0D5921C5_g = UnitGroup("VoidThrasher", gv_pLAYER_02_DOMINION12, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    auto0D5921C5_u = UnitGroupCount(auto0D5921C5_g, c_unitCountAll);
    for (;; auto0D5921C5_u -= 1) {
        auto0D5921C5_var = UnitGroupUnitFromEnd(auto0D5921C5_g, auto0D5921C5_u);
        if (auto0D5921C5_var == null) { break; }
        if ((UnitGetPropertyFixed(auto0D5921C5_var, c_unitPropVitalityPercent, c_unitPropCurrent) <= 75.0) && (UnitGroupCount(UnitGroup("NydusCanal", c_playerAny, RegionCircle(UnitGetPosition(auto0D5921C5_var), 12.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) < 3)) {
            gf_CreateNydusWormAtPoint(RegionRandomPoint(RegionCircle(UnitGetPosition(auto0D5921C5_var), 4.0)), RegionCircle(UnitGetPosition(auto0D5921C5_var), 12.0));
        }

    }
    return true;
}

