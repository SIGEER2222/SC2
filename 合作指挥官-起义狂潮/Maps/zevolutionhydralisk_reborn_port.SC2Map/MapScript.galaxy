//--------------------------------------------------------------------------------------------------
// Trigger: Raynor Waves
//--------------------------------------------------------------------------------------------------
bool gt_RaynorWaves_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_alternator;

    // Automatic Variable Declarations
    int auto84A3194D_val;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    Wait(5.0, c_timeAI);
    AIAttackWaveSetTargetPlayer(gv_pLAYER_02_DOMINION, gv_enemyPlayers);
    while (true) {
        gf_SetWaveWaypoints(ge_PRESET_WaveOrigin_Raynor);
        if (lv_alternator >= 2) {
            lv_alternator = 1;
        }
        else {
            lv_alternator = lv_alternator + 1;
        }
        if ((gv_raynorWaveBoost == true) && (lv_alternator == 1)) {
            AIAttackWaveAddUnits4(1, 1, 1, 1, "Thor");
        }

        if ((lv_alternator == 2)) {
            AIAttackWaveAddUnits4(1, 1, 1, 1, "Raven");
        }

        auto84A3194D_val = gv_raynorProgressCount;
        if (auto84A3194D_val == 0) {
            AIAttackWaveAddUnits4(4, 4, 4, 4, "Marine");
            AIAttackWaveAddUnits4(2, 2, 2, 2, "WarPig");
            AIAttackWaveAddUnits4(1, 1, 1, 1, "Goliath");
            AIAttackWaveAddUnits4(1, 1, 1, 1, "HammerSecurity");
            AIAttackWaveAddUnits4(1, 1, 1, 1, "VikingFighter");
        }
        else if (auto84A3194D_val == 1) {
            AIAttackWaveAddUnits4(4, 4, 4, 4, "Marine");
            AIAttackWaveAddUnits4(2, 2, 2, 2, "WarPig");
            AIAttackWaveAddUnits4(2, 2, 2, 2, "HammerSecurity");
            AIAttackWaveAddUnits4(1, 1, 1, 1, "Goliath");
