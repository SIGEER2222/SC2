//--------------------------------------------------------------------------------------------------
// Trigger: Moebius Corps North Waves
//--------------------------------------------------------------------------------------------------
bool gt_MoebiusCorpsNorthWaves_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(60.0, c_timeAI);
    AIAttackWaveSetTargetPlayer(gv_pLAYER_02_DOMINION7, gv_fren);
    while (true) {
        AIAttackWaveAddWaypoint(gv_pLAYER_02_DOMINION7, PointFromId(806), false);
        AIAttackWaveAddWaypoint(gv_pLAYER_02_DOMINION7, PointFromId(726), false);
        AIAttackWaveAddWaypoint(gv_pLAYER_02_DOMINION7, PointFromId(3), false);
        AIAttackWaveAddUnits4(2, 2, 4, 4, "Marine");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Goliath");
        if ((GameGetMissionTime() >= 600.0)) {
            AIAttackWaveAddUnits4(2, 2, 2, 2, "Marine");
            AIAttackWaveAddUnits4(1, 1, 1, 1, "Marauder");
        }

        if ((GameGetMissionTime() >= 1200.0)) {
            AIAttackWaveAddUnits4(1, 1, 1, 1, "HellionTank");
        }

        AIAttackWaveSend(gv_pLAYER_02_DOMINION7, 0, false);
