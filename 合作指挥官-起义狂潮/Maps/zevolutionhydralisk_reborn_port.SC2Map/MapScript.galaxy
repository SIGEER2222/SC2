//--------------------------------------------------------------------------------------------------
// Trigger: Moebius Corps South Waves
//--------------------------------------------------------------------------------------------------
bool gt_MoebiusCorpsSouthWaves_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(60.0, c_timeAI);
    AIAttackWaveSetTargetPlayer(gv_pLAYER_02_DOMINION8, gv_fren);
    while (true) {
        AIAttackWaveAddWaypoint(gv_pLAYER_02_DOMINION8, PointFromId(886), false);
        AIAttackWaveAddWaypoint(gv_pLAYER_02_DOMINION8, PointFromId(893), false);
        AIAttackWaveAddWaypoint(gv_pLAYER_02_DOMINION8, PointFromId(4), false);
        AIAttackWaveAddUnits4(2, 2, 2, 2, "Reaper");
        AIAttackWaveAddUnits4(2, 2, 2, 2, "Vulture");
        if ((GameGetMissionTime() >= 600.0)) {
            AIAttackWaveAddUnits4(1, 1, 1, 1, "Predator");
        }

        if ((GameGetMissionTime() >= 1200.0)) {
            AIAttackWaveAddUnits4(1, 1, 1, 1, "Wraith");
        }

        AIAttackWaveSend(gv_pLAYER_02_DOMINION8, 0, false);
        Wait(20.0, c_timeAI);
    }
    return true;
}

