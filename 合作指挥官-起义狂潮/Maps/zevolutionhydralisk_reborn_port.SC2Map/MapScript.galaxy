//--------------------------------------------------------------------------------------------------
// Trigger: Cheat
//--------------------------------------------------------------------------------------------------
bool gt_Cheat_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    const int auto02DB7170_n = 3;
    int auto02DB7170_i;
    unitgroup auto1B8ACA0E_g;
    int auto1B8ACA0E_u;
    unit auto1B8ACA0E_var;

    // Actions
    if (!runActions) {
        return true;
    }

    for (auto02DB7170_i = 1; auto02DB7170_i <= auto02DB7170_n; auto02DB7170_i += 1) {
        auto1B8ACA0E_g = UnitGroupAlliance(1, c_unitAllianceEnemy, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        auto1B8ACA0E_u = UnitGroupCount(auto1B8ACA0E_g, c_unitCountAll);
        for (;; auto1B8ACA0E_u -= 1) {
            auto1B8ACA0E_var = UnitGroupUnitFromEnd(auto1B8ACA0E_g, auto1B8ACA0E_u);
            if (auto1B8ACA0E_var == null) { break; }
            UnitKill(auto1B8ACA0E_var);
        }
    }
    return true;
}

