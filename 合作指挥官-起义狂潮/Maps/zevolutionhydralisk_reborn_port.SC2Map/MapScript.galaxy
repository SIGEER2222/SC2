//--------------------------------------------------------------------------------------------------
// Trigger: Start Game Q
//--------------------------------------------------------------------------------------------------
bool gt_StartGameQ_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TriggerExecute(lib48DF4533_gt_SwarmSetup, true, false);
    TriggerExecute(lib48DF4533_gt_AllyDepots, true, false);
    UIAlertPoint("Trigger", gv_pLAYER_01_USER, StringExternal("Param/Value/1F43E1F4"), null, UnitGetPosition(UnitFromId(45)));
    libLbty_gf_OrderWorkerstoGatherNearbyResources(RegionPlayableMap(), gv_pLAYER_01_USER);
    TriggerExecute(gt_ArtanisWaves, true, false);
    TriggerExecute(gt_RaynorWaves, true, false);
    TriggerExecute(gt_ValerianWaves, true, false);
    TriggerExecute(gt_MengskWavesFlavor, true, false);
    TriggerExecute(gt_MengskWavesSerious, true, false);
    TriggerExecute(gt_WarfieldWaves, true, false);
    TriggerExecute(gt_HybridWaveController, true, false);
    TriggerExecute(gt_MoebiusCorpsNorthWaves, true, false);
    TriggerExecute(gt_MoebiusCorpsSouthWaves, true, false);
    TriggerExecute(gt_IhanRiiWaves, true, false);
    TriggerExecute(gt_GoldenArmadaWaves, true, false);
    TriggerExecute(gt_OvermindWavesFlavor, true, false);
    TriggerExecute(gt_OvermindWavesSerious, true, false);
    TriggerExecute(gt_TaldarimWaves, true, false);
    TriggerExecute(gt_VoidRiftController, true, false);
    TriggerExecute(gt_BonusObjectiveWait, true, false);
    ObjectiveCreate(StringExternal("Param/Value/6C005681"), StringExternal("Param/Value/F8D7E456"), c_objectiveStateActive, true);
    DataTableSetObjective(true, "Challenge3Keystone", ObjectiveLastCreated());
    ObjectiveCreate(StringExternal("Param/Value/290A0CEF"), StringExternal("Param/Value/A8BCFF84"), c_objectiveStateActive, true);
    DataTableSetObjective(true, "Challenge3Flagships", ObjectiveLastCreated());
    if ((lib48DF4533_gf_SetAllHatcheriesRallyPoints2() == true)) {
        TriggerExecute(gt_ThrasherSpawnLogic, true, false);
        TriggerEnable(gt_VoidThrasherAttacksScreenShake, true);
        TriggerEnable(gt_VoidThrasherDies, true);
        TriggerEnable(gt_VoidThrasherEncounter, true);
    }

    Wait(3.0, c_timeReal);
    TriggerQueueEnter();
    UIAlertPoint("Trigger", gv_pLAYER_01_USER, StringExternal("Param/Value/6E44248E"), null, UnitGetPosition(UnitFromId(2136)));
    VisRevealArea(gv_pLAYER_01_USER, RegionFromId(9), 4.0, false);
    libSwaC_gf_CreateObjectivePing(true, PointFromId(5), StringExternal("Param/Value/0E87931E"));
    Wait(2.0, c_timeReal);
    TriggerQueueExit();
    Wait(5.0, c_timeReal);
    libNtve_gf_SetUpgradeLevelForPlayer(gv_pLAYER_02_DOMINION5, "Warfield", 1);
    Wait(12.0, c_timeReal);
    TriggerExecute(gt_RaynorIntroQ, true, false);
    Wait(20.0, c_timeReal);
    return true;
}

