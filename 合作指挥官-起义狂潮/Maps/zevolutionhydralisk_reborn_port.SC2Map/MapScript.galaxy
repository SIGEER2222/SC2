    }

    PlayerGroupAdd(gv_fren, gv_pLAYER_01_USER);
    PlayerGroupAdd(gv_fren, gv_pLAYER_02_DOMINION);
    PlayerGroupAdd(gv_fren, gv_pLAYER_02_DOMINION2);
    PlayerGroupAdd(gv_fren, gv_pLAYER_02_DOMINION4);
    PlayerGroupAdd(gv_fren, gv_pLAYER_02_DOMINION3);
