    gt_DudesCarDestroyedAgainQ = TriggerCreate("gt_DudesCarDestroyedAgainQ_Func");
    TriggerAddEventUnitDied(gt_DudesCarDestroyedAgainQ, UnitRefFromUnit(UnitFromId(2132)));
