    PlayerGroupAdd(gv_enemyPlayers, gv_pLAYER_02_DOMINION10);
    PlayerGroupAdd(gv_enemyPlayers, gv_pLAYER_02_DOMINION11);
    PlayerGroupAdd(gv_enemyPlayers, gv_pLAYER_02_DOMINION12);
    libNtve_gf_SetPlayerGroupAlliance(gv_fren, libNtve_ge_AllianceSetting_AllyWithSharedVisionAndPushable);
    libNtve_gf_SetPlayerGroupAlliance(gv_enemyPlayers, libNtve_ge_AllianceSetting_AllyWithSharedVisionAndPushable);
    libNtve_gf_SetAllianceBetweenTwoPlayerGroups(gv_fren, gv_enemyPlayers, libNtve_ge_AllianceSetting_Enemy);
    libNtve_gf_SetAllianceBetweenTwoPlayerGroups(gv_enemyPlayers, gv_fren, libNtve_ge_AllianceSetting_Enemy);
    libNtve_gf_SetAllianceAspectForPlayerGroup(gv_fren, c_allianceIdPower, true);
    PlayerModifyPropertyInt(gv_pLAYER_01_USER, c_playerPropMinerals, c_playerPropOperSetTo, 300);
    PlayerModifyPropertyInt(gv_pLAYER_01_USER, c_playerPropVespene, c_playerPropOperSetTo, 100);
    libNtve_gf_SetUpgradeLevelForPlayer(gv_pLAYER_01_USER, "HeroicShieldCleanUp", 1);
    auto781CE6EB_g = gv_enemyPlayers;
    auto781CE6EB_var = -1;
    while (true) {
        auto781CE6EB_var = PlayerGroupNextPlayer(auto781CE6EB_g, auto781CE6EB_var);
        if (auto781CE6EB_var < 0) { break; }
        PlayerModifyPropertyInt(auto781CE6EB_var, c_playerPropMinerals, c_playerPropOperSetTo, 5000);
        PlayerModifyPropertyInt(auto781CE6EB_var, c_playerPropVespene, c_playerPropOperSetTo, 5000);
        PlayerSetState(auto781CE6EB_var, c_playerStateFoodIgnored, true);
        PlayerSetState(auto781CE6EB_var, c_playerStateVespeneCostIgnored, true);
        PlayerSetState(auto781CE6EB_var, c_playerStateMineralCostIgnored, true);
        AIAttackWaveSetTargetPlayer(auto781CE6EB_var, gv_fren);
    }
    autoA919A7F9_g = gv_fren;
    autoA919A7F9_var = -1;
    while (true) {
        autoA919A7F9_var = PlayerGroupNextPlayer(autoA919A7F9_g, autoA919A7F9_var);
        if (autoA919A7F9_var < 0) { break; }
        if ((autoA919A7F9_var != 1)) {
            PlayerModifyPropertyInt(autoA919A7F9_var, c_playerPropMinerals, c_playerPropOperSetTo, 5000);
            PlayerModifyPropertyInt(autoA919A7F9_var, c_playerPropVespene, c_playerPropOperSetTo, 5000);
        }
        else {
            PlayerModifyPropertyInt(autoA919A7F9_var, c_playerPropMinerals, c_playerPropOperSetTo, 400);
            PlayerModifyPropertyInt(autoA919A7F9_var, c_playerPropVespene, c_playerPropOperSetTo, 200);
        }
    }
    PlayerSetState(gv_pLAYER_02_DOMINION3, c_playerStateFoodIgnored, true);
    PlayerSetState(gv_pLAYER_02_DOMINION3, c_playerStateVespeneCostIgnored, true);
    PlayerSetState(gv_pLAYER_02_DOMINION3, c_playerStateMineralCostIgnored, true);
    PlayerSetState(gv_pLAYER_02_DOMINION, c_playerStateFoodIgnored, true);
    PlayerSetState(gv_pLAYER_02_DOMINION, c_playerStateVespeneCostIgnored, true);
    PlayerSetState(gv_pLAYER_02_DOMINION, c_playerStateMineralCostIgnored, true);
    libNtve_gf_SetAllianceAspectForPlayerGroup(gv_fren, c_allianceIdSeekHelp, false);
    return true;
}

