//--------------------------------------------------------------------------------------------------
// Trigger: Artanis Progress 1
//--------------------------------------------------------------------------------------------------
bool gt_ArtanisProgress1_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGroupCount(UnitGroupAlliance(gv_pLAYER_01_USER, c_unitAllianceEnemy, RegionFromId(32), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) <= 2))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    gv_artanisProgress += 1;
    PlayerModifyPropertyInt(gv_pLAYER_02_DOMINION4, c_playerPropMinerals, c_playerPropOperAdd, 1500);
    PlayerModifyPropertyInt(gv_pLAYER_02_DOMINION4, c_playerPropVespene, c_playerPropOperAdd, 500);
    AIToggleBulliesInRegion(gv_pLAYER_02_DOMINION4, RegionFromId(32), true);
    AIToggleBulliesInRegion(gv_pLAYER_02_DOMINION3, RegionFromId(32), true);
    AIToggleBulliesInRegion(gv_pLAYER_02_DOMINION11, RegionFromId(32), false);
    AIToggleBulliesInRegion(gv_pLAYER_02_DOMINION10, RegionFromId(32), false);
    AIToggleBulliesInRegion(gv_pLAYER_02_DOMINION6, RegionFromId(32), false);
    AIToggleBulliesInRegion(gv_pLAYER_02_DOMINION8, RegionFromId(32), false);
    TriggerQueueEnter();
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("ArtanisEx2Portrait"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "", "Talk", SoundLink("AICommunication_ProtossAICommand_268", -1), StringExternal("Param/Value/DE81A6C4"), StringExternal("Param/Value/6D47B2F8"), 6.0, c_transmissionDurationAdd, true, c_maxPlayers, false);
    TriggerExecute(gt_Artanis1, true, false);
    TriggerQueueExit();
    return true;
}

