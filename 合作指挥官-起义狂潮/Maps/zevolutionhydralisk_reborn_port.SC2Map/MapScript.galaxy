    AIToggleBulliesInRegion(gv_pLAYER_02_DOMINION5, RegionFromId(38), true);
    Wait(60.0, c_timeAI);
    while (true) {
        AIAttackWaveSetTargetPlayer(gv_pLAYER_02_DOMINION5, gv_enemyPlayers);
        AIAttackWaveAddWaypoint(gv_pLAYER_02_DOMINION5, PointFromId(516307681), false);
        AIAttackWaveAddWaypoint(gv_pLAYER_02_DOMINION5, PointFromId(581684617), false);
        for (auto824A5363_i = 1; auto824A5363_i <= auto824A5363_n; auto824A5363_i += 1) {
            AIAttackWaveAddUnits4(1, 1, 1, 1, "Spartan");
        }
        for (autoA013433A_i = 1; autoA013433A_i <= autoA013433A_n; autoA013433A_i += 1) {
            AIAttackWaveAddUnits4(1, 1, 1, 1, "Apothecary");
        }
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Raven");
        if ((GameGetMissionTime() >= 300.0)) {
            for (auto0B31B75E_i = 1; auto0B31B75E_i <= auto0B31B75E_n; auto0B31B75E_i += 1) {
                AIAttackWaveAddUnits4(1, 1, 1, 1, "Incinerator");
            }
        }

        if ((GameGetMissionTime() >= 600.0)) {
            for (auto5382BB31_i = 1; auto5382BB31_i <= auto5382BB31_n; auto5382BB31_i += 1) {
                AIAttackWaveAddUnits4(1, 1, 1, 1, "Devastator");
            }
        }

        if ((GameGetMissionTime() >= 900.0)) {
            for (auto3B92AB31_i = 1; auto3B92AB31_i <= auto3B92AB31_n; auto3B92AB31_i += 1) {
                AIAttackWaveAddUnits4(1, 1, 1, 1, "Juggernaut");
            }
        }

        if ((gv_warfieldProgress >= 1)) {
            AIAttackWaveAddUnits4(1, 1, 1, 1, "Grizzly");
        }

        if ((gv_warfieldProgress >= 2)) {
            AIAttackWaveAddUnits4(1, 1, 1, 1, "UmojanLabWarbot");
        }

        if ((gv_warfieldProgress >= 3)) {
            AIAttackWaveAddUnits4(1, 1, 1, 1, "MarzaDreadnought");
        }

        AIAttackWaveSend(gv_pLAYER_02_DOMINION5, 0, false);
        Wait(60.0, c_timeAI);
    }
    return true;
}

