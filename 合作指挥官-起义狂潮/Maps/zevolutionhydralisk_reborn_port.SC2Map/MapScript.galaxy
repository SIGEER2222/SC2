//--------------------------------------------------------------------------------------------------
// Trigger: Victory Recover the Keystone Completed
//--------------------------------------------------------------------------------------------------
bool gt_VictoryRecovertheKeystoneCompleted_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    playergroup auto5A9A174A_g;
    int auto5A9A174A_var;

    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }

        if (!((UnitGroupCount(UnitGroupAlliance(gv_pLAYER_01_USER, c_unitAllianceEnemy, RegionCircle(UnitGetPosition(UnitFromId(2136)), 10.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) == 0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    TriggerEnable(gt_DefeatBaseDead, false);
    TriggerEnable(gt_DefeatAllyDead, false);
    ObjectiveSetState(DataTableGetObjective(true, "Challenge3Flagships"), c_objectiveStateCompleted);
    TriggerExecute(gt_ObjectiveRecovertheKeystoneComplete, true, false);
    auto5A9A174A_g = lib48DF4533_gv_coop_group;
    auto5A9A174A_var = -1;
    while (true) {
        auto5A9A174A_var = PlayerGroupNextPlayer(auto5A9A174A_g, auto5A9A174A_var);
        if (auto5A9A174A_var < 0) { break; }
        BankLoad("cryswarmcoop", auto5A9A174A_var);
        BankValueSetFromFlag(BankLastCreated(), "Maps", "Hydralisk", true);
        BankSave(BankLastCreated());
    }
    Wait(2.0, c_timeReal);
    TriggerStop(gt_ArtanisWaves);
    TriggerStop(gt_GoldenArmadaWaves);
    TriggerStop(gt_HybridWaveController);
    TriggerStop(gt_IhanRiiWaves);
    TriggerStop(gt_MengskWavesFlavor);
    TriggerStop(gt_MengskWavesSerious);
    TriggerStop(gt_MoebiusCorpsNorthWaves);
    TriggerStop(gt_MoebiusCorpsSouthWaves);
