    TriggerStop(gt_RaynorWaves);
    TriggerStop(gt_TaldarimWaves);
    TriggerStop(gt_ValerianWaves);
    TriggerStop(gt_WarfieldWaves);
    TriggerExecute(gt_VictoryQ, true, false);
    return true;
}

