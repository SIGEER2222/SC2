        AIAttackWaveAddUnits4(1, 1, 1, 1, "TeslaTank");
        for (autoDD4D84B8_i = 1; autoDD4D84B8_i <= autoDD4D84B8_n; autoDD4D84B8_i += 1) {
            AIAttackWaveAddUnits4(1, 1, 1, 1, "Raven");
        }
        if ((GameGetMissionTime() >= 300.0)) {
            for (autoE2C29EC4_i = 1; autoE2C29EC4_i <= autoE2C29EC4_n; autoE2C29EC4_i += 1) {
                AIAttackWaveAddUnits4(1, 1, 1, 1, "Predator");
            }
            for (auto4DBB9DBE_i = 1; auto4DBB9DBE_i <= auto4DBB9DBE_n; auto4DBB9DBE_i += 1) {
                AIAttackWaveAddUnits4(1, 1, 1, 1, "UmojanLabMicrobot");
            }
        }

        if ((GameGetMissionTime() >= 600.0)) {
            for (auto2C04BB8F_i = 1; auto2C04BB8F_i <= auto2C04BB8F_n; auto2C04BB8F_i += 1) {
                AIAttackWaveAddUnits4(1, 1, 1, 1, "Battlecruiser");
            }
            for (autoE4E81B51_i = 1; autoE4E81B51_i <= autoE4E81B51_n; autoE4E81B51_i += 1) {
                AIAttackWaveAddUnits4(1, 1, 1, 1, "UmojanLabMicrobot");
            }
        }

        if ((gv_raynorProgressCount >= 1)) {
            AIAttackWaveAddUnits4(1, 1, 1, 1, "UmojanLabWarbot");
        }

        if ((gv_raynorProgressCount >= 2)) {
            AIAttackWaveAddUnits4(1, 1, 1, 1, "NovaEradicator");
        }

        AIAttackWaveSend(gv_pLAYER_02_DOMINION3, 0, false);
        Wait(180.0, c_timeAI);
    }
    return true;
}

