//--------------------------------------------------------------------------------------------------
// Trigger: Thrasher Spawn Logic
//--------------------------------------------------------------------------------------------------
bool gt_ThrasherSpawnLogic_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    const int auto499EB569_n = 10;
    int auto499EB569_i;

    // Actions
    if (!runActions) {
        return true;
    }

    for (auto499EB569_i = 1; auto499EB569_i <= auto499EB569_n; auto499EB569_i += 1) {
        Wait(240.0, c_timeGame);
        gv_spawnIndex += 1;
        VisRevealerCreate(gv_pLAYER_01_USER, RegionCircle(gv_voidThrashers.lv_location[gv_spawnIndex], 6.0));
        gv_voidThrashers.lv_revealer[gv_spawnIndex] = VisRevealerLastCreated();
        UIAlertPoint("Trigger", gv_pLAYER_01_USER, StringExternal("Param/Value/AABF747F"), null, gv_voidThrashers.lv_location[gv_spawnIndex]);
        TimerStart(gv_thrasherSpawnTimer, 6.0, false, c_timeAI);
        gf_SpawnVoidThrasher(gv_spawnIndex);
        if ((RegionContainsPoint(RegionCircle(gv_voidThrashers.lv_location[gv_spawnIndex], 32.0), CameraGetTarget(gv_pLAYER_01_USER)) == true)) {
            SoundPlayForPlayer(SoundLink("Zerus03_Zurvan_CS_Intro", 0), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
            CameraShake(gv_pLAYER_01_USER, "Medium", "Earthquake", 3.0, 1.0, 6.0);
        }

        libNtve_gf_WaitForTimer(gv_thrasherSpawnTimer, 0.0, false);
        libNtve_gf_CreatePingFacingAngle(PlayerGroupAll(), "PingAlert", UnitGetPosition(gv_voidThrashers.lv_thrasher[gv_spawnIndex]), ColorWithAlpha(100.00, 0.00, 0.00, 0.00), 0.0, 270.0);
        gv_voidThrashers.lv_ping[gv_spawnIndex] = PingLastCreated();
        PingSetTooltip(PingLastCreated(), StringExternal("Param/Value/8A4EE6B6"));
        PingSetScale(PingLastCreated(), 0.8);
        PingSetUnit(PingLastCreated(), gv_voidThrashers.lv_thrasher[gv_spawnIndex]);
        libNtve_gf_MakeUnitInvulnerable(gv_voidThrashers.lv_thrasher[gv_spawnIndex], false);
        Wait(2.0, c_timeGame);
        gf_VoidThrasherAI(gv_spawnIndex);
    }
    return true;
}

