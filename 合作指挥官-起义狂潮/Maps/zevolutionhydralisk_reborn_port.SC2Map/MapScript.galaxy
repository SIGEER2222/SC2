        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    PingSetVisible(gv_voidThrashers.lv_ping[gv_spawnIndex], false);
    Wait(2.0, c_timeAI);
    VisRevealerDestroy(gv_voidThrashers.lv_revealer[gv_spawnIndex]);
    return true;
}

