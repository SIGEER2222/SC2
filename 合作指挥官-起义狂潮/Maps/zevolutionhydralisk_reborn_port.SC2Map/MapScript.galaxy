//--------------------------------------------------------------------------------------------------
bool gt_VoidThrasherDies_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnit()) == "VoidThrasher"))) {
