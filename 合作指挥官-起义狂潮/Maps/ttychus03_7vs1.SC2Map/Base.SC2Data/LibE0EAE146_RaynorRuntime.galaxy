    TechTreeUnitAllow(lp_player, lp_unit, false);
}

void libE0EAE146_gf_RaynorAllowAbilityIfPresent (int lp_player, string lp_abil, int lp_cmdIndex) {
    if ((lp_abil == "") || (!CatalogEntryIsValid(c_gameCatalogAbil, lp_abil))) {
        return;
