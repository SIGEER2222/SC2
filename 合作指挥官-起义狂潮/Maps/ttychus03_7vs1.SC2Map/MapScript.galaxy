void gf_KerriganAttackAI (int lp_owner, unit lp_hunter, unitgroup lp_nearbyUnits) {
    // Variable Declarations
    unitgroup lv_uG;
    aifilter lv_targetFilter;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_uG = UnitGroupEmpty();
    lv_targetFilter = AIFilter(lp_owner);

    // Implementation
    AISetFilterRange(lv_targetFilter, lp_hunter, 6.0);
    lv_uG = AIGetFilterGroup(lv_targetFilter, lp_nearbyUnits);
    if ((UnitGroupCount(lv_uG, c_unitCountAlive) == 0)) {
        return ;
    }

    if ((UnitGroupCount(lv_uG, c_unitCountAlive) >= 4) && (UnitAbilityGetCooldown(lp_hunter, "Tychus03OmegaStorm", "Abil/OmegaStorm") == 0.0) && (UnitGetPropertyInt(lp_hunter, c_unitPropEnergy, c_unitPropCurrent) >= 100)) {
        libNtve_gf_AICast(lp_hunter, OrderTargetingPoint(AbilityCommand("Tychus03OmegaStorm", 0), UnitGroupCenterOfGroup(lv_uG)));
        return ;
    }

}

void gf_AbandonedBuildingtychus03AI (int lp_owner, unit lp_hunter, unitgroup lp_nearbyUnits) {
    // Automatic Variable Declarations
    // Implementation
    if ((UnitGroupCount(lp_nearbyUnits, c_unitCountAlive) == 0)) {
        return ;
    }

    if ((UnitGetPropertyInt(lp_hunter, c_unitPropLife, c_unitPropCurrent) <= 7000)) {
        UnitIssueOrder(lp_hunter, Order(AbilityCommand("AbandonedBuildingtychus03LiftOff", 0)), c_orderQueueReplace);
        return ;
    }

}

void gf_AddAirAttackWaypoints (int lp_player) {
    // Automatic Variable Declarations
    // Implementation
    AIAttackWaveAddWaypoint(lp_player, PointFromId(119), false);
    AIAttackWaveAddWaypoint(lp_player, PointFromId(401), false);
    AIAttackWaveAddWaypoint(lp_player, PointFromId(402), false);
}

