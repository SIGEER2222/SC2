//--------------------------------------------------------------------------------------------------
bool gt_StartGame_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup auto23173B9E_g;
    int auto23173B9E_u;
    unit auto23173B9E_var;

    // Actions
    if (!runActions) {
        return true;
    }

    libE0EAE146_gf_StartGame();
    SoundtrackPlay(PlayerGroupAll(), c_soundtrackCategoryMusic, "TTychus03MusicIntro", c_soundtrackCueAny, c_soundtrackIndexAny, false);
    lib67C0F0E7_gf_ObjectiveNew(true, StringExternal("Param/Value/A93DF1F4"), 1, true, 0, 5);
    lib67C0F0E7_gf_ObjectiveNew(true, StringExternal("Param/Value/7D5E64ED"), 2, true, 0, 5);
    lib67C0F0E7_gf_ObjectiveNew(false, StringExternal("Param/Value/005B0140"), 1, false, 0, 0);
    lib67C0F0E7_gf_ObjectiveNew(false, StringExternal("Param/Value/8E4C8ACE"), 2, false, 0, 0);
    Wait(1.0, c_timeGame);
    lib67C0F0E7_gf_ObjectiveSet(true, 1, lib67C0F0E7_ge_ObjectiveSet_Show);
    Wait(1.0, c_timeGame);
    lib67C0F0E7_gf_ObjectiveSet(true, 2, lib67C0F0E7_ge_ObjectiveSet_Show);
    auto23173B9E_g = gv_tG;
    auto23173B9E_u = UnitGroupCount(auto23173B9E_g, c_unitCountAll);
    for (;; auto23173B9E_u -= 1) {
        auto23173B9E_var = UnitGroupUnitFromEnd(auto23173B9E_g, auto23173B9E_u);
        if (auto23173B9E_var == null) { break; }
        lib67C0F0E7_gf_PingUnitU(auto23173B9E_var, "PingObjective", Color(0.00, 100.00, 0.00));
        Wait(1.0, c_timeGame);
    }
    Wait(20.0, c_timeGame);
    TriggerExecute(gt_CreateMedivacIntro, true, false);
    Wait(1.0, c_timeGame);
    Wait(4.0, c_timeGame);
    TriggerExecute(gt_TransmissionMedivacIntroQ, true, false);
    lib67C0F0E7_gf_ObjectiveSet(false, 1, lib67C0F0E7_ge_ObjectiveSet_Show);
    lib67C0F0E7_gf_PingUnitU(UnitFromId(490463695), "PingTriangle", Color(100.00, 100.00, 0.00));
    Wait(12.0, c_timeGame);
    TriggerExecute(gt_KerriganTauntsRaynor1Q, true, false);
    Wait(30.0, c_timeGame);
    TriggerExecute(gt_TransmissionBrutaliskFoundQ, true, false);
    lib67C0F0E7_gf_ObjectiveSet(false, 2, lib67C0F0E7_ge_ObjectiveSet_Show);
    lib67C0F0E7_gf_PingUnitU(UnitFromId(1178), "PingTriangle", Color(100.00, 100.00, 0.00));
    return true;
}

