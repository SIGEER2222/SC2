//--------------------------------------------------------------------------------------------------
// Trigger: Main
//--------------------------------------------------------------------------------------------------
bool gt_Main_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitGetOwner(libNtve_gf_KillingUnit()) == 1)) {
        lib67C0F0E7_gf_ObjectiveSet(true, 1, lib67C0F0E7_ge_ObjectiveSet_Add);
        TriggerExecute(gt_TransmissionCoreIsDestroyedQ, true, false);
        if ((lib67C0F0E7_gf_ObjectiveMultiNow(true, 1) == 5)) {
            gv_gameOver = true;
            TriggerExecute(gt_VictoryQ, true, false);
        }
        else {
            if ((gv_t == EventUnit())) {
                AIAttackWaveCancel(AIUnitGetWave(gv_uNIT_KERRIGAN));
                gv_t = UnitGroupRandomUnit(gv_tG, c_unitCountAlive);
                AIAttackWaveUseUnit(7, gv_uNIT_KERRIGAN);
                AIAttackWaveSetTargetUnit(7, gv_t);
                AIAttackWaveSend(7, 0, true);
            }

        }
    }
    else {
        lib67C0F0E7_gf_ObjectiveSet(true, 2, lib67C0F0E7_ge_ObjectiveSet_Add);
        AIAttackWaveCancel(AIUnitGetWave(gv_uNIT_KERRIGAN));
        if ((lib67C0F0E7_gf_ObjectiveMultiNow(true, 2) == 5)) {
            gv_state = false;
            TriggerExecute(gt_DefeatPrimaryObjectiveFailed, true, false);
        }
        else {
            Wait(30.0, c_timeGame);
            gv_t = UnitGroupRandomUnit(gv_tG, c_unitCountAlive);
            AIAttackWaveUseUnit(7, gv_uNIT_KERRIGAN);
            AIAttackWaveSetTargetUnit(7, gv_t);
            AIAttackWaveSend(7, 0, true);
        }
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_Main_Init () {
    gt_Main = TriggerCreate("gt_Main_Func");
    TriggerAddEventUnitDied(gt_Main, UnitRefFromUnit(UnitFromId(1538376746)));
    TriggerAddEventUnitDied(gt_Main, UnitRefFromUnit(UnitFromId(2011667625)));
    TriggerAddEventUnitDied(gt_Main, UnitRefFromUnit(UnitFromId(2015551774)));
    TriggerAddEventUnitDied(gt_Main, UnitRefFromUnit(UnitFromId(1974515564)));
    TriggerAddEventUnitDied(gt_Main, UnitRefFromUnit(UnitFromId(1097673837)));
    TriggerAddEventUnitDied(gt_Main, UnitRefFromUnit(UnitFromId(1317262391)));
    TriggerAddEventUnitDied(gt_Main, UnitRefFromUnit(UnitFromId(1535935149)));
    TriggerAddEventUnitDied(gt_Main, UnitRefFromUnit(UnitFromId(585840159)));
    TriggerAddEventUnitDied(gt_Main, UnitRefFromUnit(UnitFromId(1781681811)));
}

