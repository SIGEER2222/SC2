void gt_BriefingKerrgianSpawn_Init () {
    gt_BriefingKerrgianSpawn = TriggerCreate("gt_BriefingKerrgianSpawn_Func");
    TriggerAddEventUnitRegion(gt_BriefingKerrgianSpawn, null, RegionFromId(89), true);
}

