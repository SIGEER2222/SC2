//--------------------------------------------------------------------------------------------------
// Trigger: Kerrigan
//--------------------------------------------------------------------------------------------------
bool gt_Kerrigan_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    int auto4952478F_val;

    // Actions
    if (!runActions) {
        return true;
    }

    PingSetVisible(DataTableGetPing(true, ("Ping" + IntToString(1))), false);
    AIAttackWaveCancel(AIUnitGetWave(gv_uNIT_KERRIGAN));
    lib67C0F0E7_gf_UnitAddAttributePoint(gv_uNIT_KERRIGAN, "ttychus03", false, 1);
    gv_state = false;
    auto4952478F_val = TriggerGetExecCount(TriggerGetCurrent());
    if (auto4952478F_val == 2) {
        TriggerExecute(gt_KerriganTauntsRaynor2Q, true, false);
    }
    else if (auto4952478F_val == 4) {
        TriggerExecute(gt_KerriganTauntsRaynor3Q, true, false);
    }
    else {
    }
    Wait(30.0, c_timeGame);
    UnitSetPosition(EventUnit(), PointFromId(902020644), false);
    UnitRevive(EventUnit());
    UnitSetPropertyFixed(EventUnit(), c_unitPropLifePercent, 100.0);
    PingSetVisible(DataTableGetPing(true, ("Ping" + IntToString(1))), true);
    Wait(30.0, c_timeGame);
    gv_t = UnitGroupRandomUnit(gv_tG, c_unitCountAlive);
    AIAttackWaveUseUnit(7, gv_uNIT_KERRIGAN);
    AIAttackWaveSetTargetUnit(7, gv_t);
    AIAttackWaveSend(7, 0, true);
    return true;
}

