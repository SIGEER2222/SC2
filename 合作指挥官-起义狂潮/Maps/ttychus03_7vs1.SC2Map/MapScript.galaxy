//--------------------------------------------------------------------------------------------------
bool gt_CreateMedivacIntro_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    string autoBEEAC669_val;

    // Conditions
    if (testConds) {
        if (!((gv_gameOver == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    autoBEEAC669_val = libE0EAE146_gv_commander;
    if (autoBEEAC669_val == "Mira") {
        libNtve_gf_CreateUnitsAtPoint2(1, "MedivacMira", 0, gv_p01_USER, PointFromId(999));
        UnitIssueOrder(UnitLastCreated(), OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(618516690)), c_orderQueueReplace);
        libNtve_gf_CreateUnitsAtPoint2(1, "MedivacMira", 0, gv_p01_USER, PointFromId(2827));
        UnitIssueOrder(UnitLastCreated(), OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(462539341)), c_orderQueueReplace);
    }
    else if (autoBEEAC669_val == "Mengsk") {
        libNtve_gf_CreateUnitsAtPoint2(1, "MedivacMengsk", 0, gv_p01_USER, PointFromId(999));
        UnitIssueOrder(UnitLastCreated(), OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(618516690)), c_orderQueueReplace);
        libNtve_gf_CreateUnitsAtPoint2(1, "MedivacMengsk", 0, gv_p01_USER, PointFromId(2827));
        UnitIssueOrder(UnitLastCreated(), OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(462539341)), c_orderQueueReplace);
    }
    else {
        libNtve_gf_CreateUnitsAtPoint2(1, "Medivac", 0, gv_p01_USER, PointFromId(999));
        UnitIssueOrder(UnitLastCreated(), OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(618516690)), c_orderQueueReplace);
        libNtve_gf_CreateUnitsAtPoint2(1, "Medivac", 0, gv_p01_USER, PointFromId(2827));
        UnitIssueOrder(UnitLastCreated(), OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(462539341)), c_orderQueueReplace);
    }
    return true;
}

