include "TriggerLibs/NativeLib"
include "TriggerLibs/LibertyLib"
include "TriggerLibs/CampaignLib"
include "LibA070801C"
include "Lib67C0F0E7"
include "LibC0F50AA6"
include "Lib81FF3B49"
include "LibDF8E6945"
include "Lib0940FFB7"
include "Lib975E2FE9"
include "LibE0EAE146"
include "LibEmptyTestCatalog"

// 当前测试的指挥官名（通过聊天指令 -c <Commander> 切换）
// 可用指挥官：Kerrigan, Raynor, Tychus, Nova, Swann, Horner, Mengsk, Stukov,
//             Stetmann, Artanis, Vorazun, Zeratul, Karax, Alarak, Fenix,
//             Abathur, AbathurReborn, Zagara, Dehaka
string gv_currentCommander = "Kerrigan";

void InitLibs () {
    libNtve_InitLib();
    libLbty_InitLib();
    libCamp_InitLib();
    libA070801C_InitLib();
    lib67C0F0E7_InitLib();
    libC0F50AA6_InitLib();
    lib81FF3B49_InitLib();
    libDF8E6945_InitLib();
    lib0940FFB7_InitLib();
    lib975E2FE9_InitLib();
    libE0EAE146_InitLib();
    libEmptyTestCatalog_InitLib();
}

//--------------------------------------------------------------------------------------------------
// 单位生成触发器
// 在地图初始化时生成当前指挥官的所有单位
// 也可通过 gt_cmd_switch 切换指挥官后重新调用
//--------------------------------------------------------------------------------------------------
trigger gt_spawn;

bool gt_spawn_Func (bool testConds, bool runActions) {
    int lv_u;
    int lv_total;
    int lv_row;
    int lv_col;
    int lv_perRow;
    fixed lv_spacing;
    fixed lv_x;
    fixed lv_y;
    point lv_pos;
    string lv_unitType;
    int lv_unitCount;
    int lv_skipped;
    int lv_created;

    if (!runActions) {
        return true;
    }

    // 初始资源：99999 矿物 + 99999 气体 + 500 人口上限
    PlayerModifyPropertyInt(1, c_playerPropMinerals, c_playerPropOperSetTo, 99999);
    PlayerModifyPropertyInt(1, c_playerPropVespene, c_playerPropOperSetTo, 99999);
    PlayerModifyPropertyInt(1, c_playerPropSuppliesLimit, c_playerPropOperSetTo, 500);

    lv_perRow = 14;
    lv_spacing = 3.0;
    lv_total = 0;
    lv_skipped = 0;
    lv_created = 0;

    // 使用 LibEmptyTestCatalog API 获取当前指挥官的单位列表
    lv_unitCount = libEmptyTestCatalog_gf_UnitCountOf(gv_currentCommander);

    for (lv_u = 0; lv_u < lv_unitCount; lv_u += 1) {
        lv_unitType = libEmptyTestCatalog_gf_UnitAt(gv_currentCommander, lv_u);
        if (lv_unitType != "") {
            if (CatalogEntryIsValid(c_gameCatalogUnit, lv_unitType) == false) {
                UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringToText("SKIP: ") + StringToText(lv_unitType));
                lv_skipped += 1;
            }
            else {
                lv_col = lv_total - (lv_total / lv_perRow) * lv_perRow;
                lv_row = lv_total / lv_perRow;
                lv_x = 40.0 + (lv_col * lv_spacing);
                lv_y = 85.0 - (lv_row * lv_spacing);
                lv_pos = Point(lv_x, lv_y);
                libNtve_gf_CreateUnitsWithDefaultFacing(1, lv_unitType, c_unitCreateIgnorePlacement, 1, lv_pos);
                lv_total += 1;
                lv_created += 1;
            }
        }
    }

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug,
        StringToText("[") + StringToText(gv_currentCommander) + StringToText("] created=") + IntToText(lv_created)
        + StringToText(" skipped=") + IntToText(lv_skipped));

    return true;
}

void gt_spawn_Init () {
    gt_spawn = TriggerCreate("gt_spawn_Func");
    TriggerAddEventMapInit(gt_spawn);
}

//--------------------------------------------------------------------------------------------------
// 周期性重置资源/人口上限
// mod 初始化可能修改人口上限，用循环每秒重置覆盖
//--------------------------------------------------------------------------------------------------
trigger gt_resetResources;

bool gt_resetResources_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }

    while (true) {
        PlayerModifyPropertyInt(1, c_playerPropMinerals, c_playerPropOperSetTo, 99999);
        PlayerModifyPropertyInt(1, c_playerPropVespene, c_playerPropOperSetTo, 99999);
        PlayerModifyPropertyInt(1, c_playerPropSuppliesLimit, c_playerPropOperSetTo, 500);
        Wait(1.0, c_timeReal);
    }

    return true;
}

void gt_resetResources_Init () {
    gt_resetResources = TriggerCreate("gt_resetResources_Func");
    TriggerAddEventTimeElapsed(gt_resetResources, 1.0, c_timeReal);
}

//--------------------------------------------------------------------------------------------------
// 切换指挥官指令: -c <Commander>
// 示例: -c Kerrigan, -c Raynor, -c Abathur, -c Nova
// 切换后清除所有 P1 单位并重新生成
//--------------------------------------------------------------------------------------------------
trigger gt_cmd_switch;

bool gt_cmd_switch_Func (bool testConds, bool runActions) {
    string lv_msg;
    string lv_cmd;
    unitgroup lv_group;
    int lv_count;
    unit lv_unit;

    if (!runActions) {
        return true;
    }

    lv_msg = EventChatMessage(false);
    lv_cmd = StringWord(lv_msg, 2);

    if (libEmptyTestCatalog_gf_CommanderIndex(lv_cmd) < 0) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug,
            StringToText("[ERROR] 未知指挥官: ") + StringToText(lv_cmd));
        return true;
    }

    gv_currentCommander = lv_cmd;

    // 移除所有 P1 单位（排除导弹和死单位）
    lv_group = UnitGroup(null, 1, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
    lv_count = UnitGroupCount(lv_group, c_unitCountAll);
    while (lv_count > 0) {
        lv_unit = UnitGroupUnit(lv_group, 1);
        if (lv_unit == null) { break; }
        UnitRemove(lv_unit);
        lv_count -= 1;
    }

    // 重新生成当前指挥官的单位
    gt_spawn_Func(true, true);

    return true;
}

void gt_cmd_switch_Init () {
    gt_cmd_switch = TriggerCreate("gt_cmd_switch_Func");
    TriggerAddEventChatMessage(gt_cmd_switch, c_playerAny, "-c ", false);
}

void InitTriggers () {
    gt_spawn_Init();
    gt_resetResources_Init();
    gt_cmd_switch_Init();
}

void InitMap () {
    InitLibs();
    InitTriggers();
}
