include "TriggerLibs/NativeLib"
include "LibEmptyTestCatalog"

// 生成的指挥官过滤，空字符串 = 生成所有指挥官
string gv_spawnCommanderFilter = "Reborn";

// F2 排除选中功能相关全局变量
unitgroup gv_excludedUnits;      // 被排除选中的单位组（不再被 F2 选中）
bool gv_excludeMode = false;     // 排除模式开关（开启后选中单位将其从 F2 排除）

void InitLibs () {
    libNtve_InitLib();
    libEmptyTestCatalog_InitLib();
}

trigger gt_spawn;

bool gt_spawn_Func (bool testConds, bool runActions) {
    int lv_c;
    int lv_u;
    int lv_total;
    int lv_row;
    int lv_col;
    int lv_perRow;
    fixed lv_spacing;
    fixed lv_x;
    fixed lv_y;
    point lv_pos;
    string lv_unitType;
    int lv_unitCount;
    int lv_skipped;
    int lv_created;

    if (!runActions) {
        return true;
    }

    // 初始资源：99999 矿物 + 99999 气体 + 500 人口上限
    PlayerModifyPropertyInt(1, c_playerPropMinerals, c_playerPropOperSetTo, 99999);
    PlayerModifyPropertyInt(1, c_playerPropVespene, c_playerPropOperSetTo, 99999);
    PlayerModifyPropertyInt(1, c_playerPropSuppliesLimit, c_playerPropOperSetTo, 500);

    // 给玩家 1 授予 Abathur 升级
    // mod 的 lib48DF4533_gt_AbathurAbilities 触发器需要此升级才会给刺蛇/跳虫/爆虫/蟑螂等
    // 单位注入 Purchase 能力（HydraliskCripple, BanelingCreep, AdrenalineOverdose 等）
    // mod 的 CommanderStart 初始化也会检查此升级，启用 Purchase 能力的 TechTree
    libNtve_gf_SetUpgradeLevelForPlayer(1, "Abathur", 1);

    // 启用 mod 的 Abathur Abilities 触发器（默认禁用）
    // 该触发器在单位进入地图时给刺蛇/跳虫/爆虫/蟑螂/王虫注入 Purchase 能力
    // 需要先设置 Abathur 升级，否则触发器条件不满足
    TriggerEnable(lib48DF4533_gt_AbathurAbilities, true);

    // 解锁基地工蜂升级能力按钮（mod 的 gt_Abathur 触发器负责解锁，但测试地图未走 mod 标准
    // SwarmSetup 初始化流程，且 gt_Abathur 依赖 gv_coop_group 玩家组，需 bank 加载才会填充，
    // 测试地图无 bank，故直接 TechTreeAbilityAllow 解锁 Restricted 按钮状态）
    TechTreeAbilityAllow(1, AbilityCommand("MineralEfficiency", 0), true);
    TechTreeAbilityAllow(1, AbilityCommand("VespeneEfficiency", 0), true);
    TechTreeAbilityAllow(1, AbilityCommand("CombatDrone", 0), true);
    TechTreeAbilityAllow(1, AbilityCommand("FastMorphing", 0), true);
    TechTreeAbilityAllow(1, AbilityCommand("NaturalCamouflage", 0), true);
    TechTreeAbilityAllow(1, AbilityCommand("Cliffjumper", 0), true);

    // 解锁 Abathur 进化分支变种（mod 默认锁定，需要 TechTreeUnitAllow 显式解锁）
    TechTreeUnitAllow(1, "RoachCorpser", true);
    TechTreeUnitAllow(1, "RoachVile", true);
    TechTreeUnitAllow(1, "SwarmHostSplitA", true);
    TechTreeUnitAllow(1, "SwarmHostSplitB", true);
    TechTreeUnitAllow(1, "HotSRaptor", true);
    TechTreeUnitAllow(1, "HotSSwarmling", true);
    TechTreeUnitAllow(1, "HydraliskImpaler", true);
    TechTreeUnitAllow(1, "HydraliskLurker", true);
    TechTreeUnitAllow(1, "HotSNoxious", true);
    TechTreeUnitAllow(1, "HotSTorrasque", true);
    TechTreeUnitAllow(1, "Devourer", true);

    // 解锁 Purchase 能力（mod 的 AbathurAbilities 触发器只对刺蛇/跳虫/爆虫/蟑螂/王虫家族解锁，
    // 雷兽/飞龙/宿主/穿刺者/潜伏者等需要手动解锁）
    // 注意：TechTreeAbilityAllow 报错"能力无效"，暂时注释掉
    // Ultralisk 家族
    // TechTreeAbilityAllow(1, AbilityCommand("UltraliskElectricShockPurchase", 0), true);
    // TechTreeAbilityAllow(1, AbilityCommand("UltraliskHighVoltagePurchase", 0), true);
    // TechTreeAbilityAllow(1, AbilityCommand("UltraliskLightningRaidPurchase", 0), true);
    // TechTreeAbilityAllow(1, AbilityCommand("UltraliskThunderstormPurchase", 0), true);
    // Mutalisk 家族
    // TechTreeAbilityAllow(1, AbilityCommand("AbathurMutaliskExplosiveGlaivePurchase", 0), true);
    // TechTreeAbilityAllow(1, AbilityCommand("AbathurMutaliskViciousGlaivePurchase", 0), true);
    // TechTreeAbilityAllow(1, AbilityCommand("AbathurMutaliskRapidRegenerationPurchase", 0), true);
    // SwarmHost 家族
    // TechTreeAbilityAllow(1, AbilityCommand("AbathurHostRapidIncubationPurchase", 0), true);
    // TechTreeAbilityAllow(1, AbilityCommand("AbathurHostLocustSpeedPurchase", 0), true);
    // TechTreeAbilityAllow(1, AbilityCommand("AbathurHostPressurizedGlandsPurchase", 0), true);
    // HydraliskImpaler 变种
    // TechTreeAbilityAllow(1, AbilityCommand("AbathurImpalerArmorPiercingSpinesPurchase", 0), true);
    // TechTreeAbilityAllow(1, AbilityCommand("AbathurImpalerEarthveinGlidePurchase", 0), true);
    // TechTreeAbilityAllow(1, AbilityCommand("AbathurImpalerAftershockImpalePurchase", 0), true);
    // HydraliskLurker 变种
    // TechTreeAbilityAllow(1, AbilityCommand("AbathurLurkerRiftSpinesPurchase", 0), true);
    // TechTreeAbilityAllow(1, AbilityCommand("AbathurLurkerStalkerGlidePurchase", 0), true);
    // TechTreeAbilityAllow(1, AbilityCommand("AbathurLurkerVenomAmbushPurchase", 0), true);

    lv_perRow = 14;
    lv_spacing = 3.0;
    lv_total = 0;
    lv_skipped = 0;
    lv_created = 0;

    for (lv_c = 0; lv_c < gv_c_EmptyTestCommanderCount; lv_c += 1) {
        if (gv_spawnCommanderFilter == "" || gv_EmptyTestCommanders[lv_c] == gv_spawnCommanderFilter) {
            lv_unitCount = gv_EmptyTestUnitCounts[lv_c];

            for (lv_u = 0; lv_u < lv_unitCount; lv_u += 1) {
                lv_unitType = gv_EmptyTestUnits[gv_EmptyTestUnitOffsets[lv_c] + lv_u];
                if (lv_unitType != "") {
                    if (CatalogEntryIsValid(c_gameCatalogUnit, lv_unitType) == false) {
                        // 调试输出：被跳过的无效单位
                        UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringToText("SKIP: ") + StringToText(lv_unitType));
                        lv_skipped += 1;
                    }
                    else {
                        lv_col = lv_total - (lv_total / lv_perRow) * lv_perRow;
                        lv_row = lv_total / lv_perRow;
                        lv_x = 40.0 + (lv_col * lv_spacing);
                        lv_y = 85.0 - (lv_row * lv_spacing);
                        lv_pos = Point(lv_x, lv_y);
                        libNtve_gf_CreateUnitsWithDefaultFacing(1, lv_unitType, c_unitCreateIgnorePlacement, 1, lv_pos);
                        lv_total += 1;
                        lv_created += 1;
                    }
                }
            }
        }
    }

    // 调试输出：创建和跳过的总数
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug,
        StringToText("Total created=") + IntToText(lv_created)
        + StringToText(" skipped=") + IntToText(lv_skipped));

    return true;
}

void gt_spawn_Init () {
    gt_spawn = TriggerCreate("gt_spawn_Func");
    TriggerAddEventMapInit(gt_spawn);
}

// 周期性重置资源/人口上限的触发器
// mod 初始化会用 c_playerPropOperAdd/Subtract 修改人口上限覆盖我们的 SetTo，
// 用 while+Wait 循环每秒重置一次，确保覆盖 mod 的任何修改
trigger gt_resetResources;

bool gt_resetResources_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }

    while (true) {
        // 重置资源/人口上限（覆盖 mod 初始化的修改）
        PlayerModifyPropertyInt(1, c_playerPropMinerals, c_playerPropOperSetTo, 99999);
        PlayerModifyPropertyInt(1, c_playerPropVespene, c_playerPropOperSetTo, 99999);
        PlayerModifyPropertyInt(1, c_playerPropSuppliesLimit, c_playerPropOperSetTo, 500);
        Wait(1.0, c_timeReal);
    }

    return true;
}

void gt_resetResources_Init () {
    gt_resetResources = TriggerCreate("gt_resetResources_Func");
    TriggerAddEventTimeElapsed(gt_resetResources, 1.0, c_timeReal);
}

//--------------------------------------------------------------------------------------------------
// F2 排除选中功能
// 为玩家1所有建筑添加"排除选中"能力（AHExcludeFromSelectAll，即时技能）
// 点击基地按钮 → 切换"排除模式" → 选中任何单位将其从 F2 选中中排除
// 再次点击按钮 → 关闭排除模式
// 聊天指令 -unlock → 恢复所有被排除的单位
//--------------------------------------------------------------------------------------------------

// 给玩家1所有建筑添加"排除选中"能力
void gf_AddExcludeAbilityToAllBuildings () {
    unitgroup autoGroup;
    int autoCount;
    unit autoUnit;

    autoGroup = UnitGroup(null, 1, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
    autoCount = UnitGroupCount(autoGroup, c_unitCountAll);
    for (;; autoCount -= 1) {
        autoUnit = UnitGroupUnitFromEnd(autoGroup, autoCount);
        if (autoUnit == null) { break; }
        UnitAbilityAdd(autoUnit, "AHExcludeFromSelectAll");
    }
}

// 触发器: 单位生成完成后给所有 P1 建筑添加排除选中能力
trigger gt_applyExclusionButtons;
bool gt_applyExclusionButtons_Func (bool testConds, bool runActions) {
    if (!runActions) { return true; }
    gf_AddExcludeAbilityToAllBuildings();
    return true;
}
void gt_applyExclusionButtons_Init () {
    gt_applyExclusionButtons = TriggerCreate("gt_applyExclusionButtons_Func");
    TriggerAddEventMapInit(gt_applyExclusionButtons);
}

// 触发器: 排除选中能力被使用（基地按钮点击）→ 切换"排除模式"
trigger gt_excludeAbilityUsed;
bool gt_excludeAbilityUsed_Func (bool testConds, bool runActions) {
    abilcmd lv_abil;

    if (!runActions) { return true; }

    lv_abil = EventUnitAbility();

    if (!((lv_abil == AbilityCommand("AHExcludeFromSelectAll", 0)))) {
        return false;
    }

    gv_excludeMode = !gv_excludeMode;
    if (gv_excludeMode) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringToText("[EXCLUDE ON] 排除模式已开启，选中单位将其从 F2 排除"));
    } else {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringToText("[EXCLUDE OFF] 排除模式已关闭"));
    }
    return true;
}
void gt_excludeAbilityUsed_Init () {
    gt_excludeAbilityUsed = TriggerCreate("gt_excludeAbilityUsed_Func");
    TriggerAddEventUnitAbility(gt_excludeAbilityUsed, null, null, c_unitAbilStageExecute, false);
}

// 触发器: 单位被选中（排除模式下生效）
// 在排除模式下，玩家选中的单位会变为不可选中，不再被 F2 选中
trigger gt_unitSelected;
bool gt_unitSelected_Func (bool testConds, bool runActions) {
    unit lv_selected;

    if (!runActions) { return true; }

    if (!gv_excludeMode) { return false; }

    lv_selected = EventUnit();
    if ((lv_selected == null)) { return false; }

    UnitSetState(lv_selected, c_unitStateSelectable, false);
    UnitGroupAdd(gv_excludedUnits, lv_selected);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringToText("[LOCK] 单位已从 F2 排除，输入 -unlock 恢复"));
    return true;
}
void gt_unitSelected_Init () {
    gt_unitSelected = TriggerCreate("gt_unitSelected_Func");
    TriggerAddEventUnitSelected(gt_unitSelected, null, c_playerAny, true);
}

// 指令: -unlock (恢复所有被排除的单位)
trigger gt_cmd_unlock;
bool gt_cmd_unlock_Func (bool testConds, bool runActions) {
    unitgroup autoGroup;
    int autoCount;
    unit autoUnit;

    if (!runActions) { return true; }

    autoGroup = gv_excludedUnits;
    autoCount = UnitGroupCount(autoGroup, c_unitCountAll);
    for (;; autoCount -= 1) {
        autoUnit = UnitGroupUnitFromEnd(autoGroup, autoCount);
        if (autoUnit == null) { break; }
        UnitSetState(autoUnit, c_unitStateSelectable, true);
    }
    UnitGroupClear(gv_excludedUnits);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringToText("[UNLOCK] 所有单位已恢复可选中"));
    return true;
}
void gt_cmd_unlock_Init () {
    gt_cmd_unlock = TriggerCreate("gt_cmd_unlock_Func");
    TriggerAddEventChatMessage(gt_cmd_unlock, c_playerAny, "-unlock", true);
}

void InitTriggers () {
    gt_spawn_Init();
    gt_resetResources_Init();
    gt_applyExclusionButtons_Init();
    gt_excludeAbilityUsed_Init();
    gt_unitSelected_Init();
    gt_cmd_unlock_Init();
}

void InitMap () {
    InitLibs();
    InitTriggers();
}
