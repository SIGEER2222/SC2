//--------------------------------------------------------------------------------------------------
// Attack Wave Sequence
//--------------------------------------------------------------------------------------------------
trigger ai12324980_waves_trigger = null;
int ai12324980_waves_runPlayer;
playergroup ai12324980_waves_runTarget;

//--------------------------------------------------------------------------------------------------
void ai12324980_waves_init () {
    ai12324980_waves_trigger = TriggerCreate("ai12324980_waves_runFunc");
}

//--------------------------------------------------------------------------------------------------
bool ai12324980_waves_runFunc (bool c, bool a) {
    int p = ai12324980_waves_runPlayer;
    playergroup target = ai12324980_waves_runTarget;

    if (p < 0 || p >= 16) {
        return false;
    }

    ai12324980_wave1_run(p, target, true);
    ai12324980_wave2_run(p, target, true);
    ai12324980_wave3_run(p, target, true);
    ai12324980_wave4_run(p, target, true);
    ai12324980_wave5_run(p, target, true);
    ai12324980_wave6_run(p, target, true);

    while (true) {
        ai12324980_wave6_run(p, target, true);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void ai12324980_waves_run (int p, playergroup target) {
    ai12324980_waves_runPlayer = p;
    ai12324980_waves_runTarget = PlayerGroupCopy(target);

    TriggerExecute(ai12324980_waves_trigger, false, false);
}

//--------------------------------------------------------------------------------------------------
void ai12324980_waves_enable (int p, bool val) {
    if (p < 0 || p >= 16) {
        return;
    }

    ai12324980_wave1_enable(p, val);
    ai12324980_wave2_enable(p, val);
    ai12324980_wave3_enable(p, val);
    ai12324980_wave4_enable(p, val);
    ai12324980_wave5_enable(p, val);
    ai12324980_wave6_enable(p, val);
}

//--------------------------------------------------------------------------------------------------
void ai12324980_waves_stop () {
    TriggerStop(ai12324980_waves_trigger);

    TriggerStop(ai12324980_wave1_trigger);
    TriggerStop(ai12324980_wave2_trigger);
    TriggerStop(ai12324980_wave3_trigger);
    TriggerStop(ai12324980_wave4_trigger);
    TriggerStop(ai12324980_wave5_trigger);
    TriggerStop(ai12324980_wave6_trigger);
}

