//--------------------------------------------------------------------------------------------------
void ai12324980_wave1_init () {
    int init_i;

    for (init_i = 0; init_i <= 16; init_i += 1) {
        ai12324980_wave1_enabled[init_i] = true;
        ai12324980_wave1_lastWave[init_i] = null;
    }

    ai12324980_wave1_trigger = TriggerCreate("ai12324980_wave1_runFunc");
}

