//--------------------------------------------------------------------------------------------------
// Start
//--------------------------------------------------------------------------------------------------
bool ai12324980_initialized = false;

//--------------------------------------------------------------------------------------------------
void ai12324980_start (int p) {
    int init_i;

    if (p < 0 || p >= 16) {
        return;
    }
    if (!ai12324980_initialized) {
        ai12324980_wave1_init();
        ai12324980_wave2_init();
        ai12324980_wave3_init();
        ai12324980_wave4_init();
        ai12324980_wave5_init();
        ai12324980_wave6_init();
        ai12324980_waves_init();

        for (init_i = 0; init_i <= 16; init_i += 1) {
            ai12324980_defGather[init_i] = PointFromId(1469604949);
        }

        ai12324980_initialized = true;
    }

    AICampaignStart(p);
}
