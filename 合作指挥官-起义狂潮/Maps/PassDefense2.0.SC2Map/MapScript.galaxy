//--------------------------------------------------------------------------------------------------
void gt_Initial_Init () {
    gt_Initial = TriggerCreate("gt_Initial_Func");
    TriggerAddEventMapInit(gt_Initial);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Initials2 (Wonton's)
//--------------------------------------------------------------------------------------------------
bool gt_Initials2Wontons_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    TechTreeUpgradeAddLevel(1, "GhostMoebiusReactor", 1);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_Initials2Wontons_Init () {
    gt_Initials2Wontons = TriggerCreate("gt_Initials2Wontons_Func");
    TriggerAddEventMapInit(gt_Initials2Wontons);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Leaver
//--------------------------------------------------------------------------------------------------
bool gt_Leaver_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    if ((PlayerStatus(1) == c_playerStatusActive)) {
        UnitGroupLoopBegin(UnitGroup(null, 3, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
        while (!UnitGroupLoopDone()) {
            UnitSetOwner(UnitGroupLoopCurrent(), 1, true);
            UnitGroupLoopStep();
        }
        UnitGroupLoopEnd();
    }
    else {
        UnitGroupLoopBegin(UnitGroup(null, 1, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
        while (!UnitGroupLoopDone()) {
            UnitSetOwner(UnitGroupLoopCurrent(), 3, true);
            UnitGroupLoopStep();
        }
        UnitGroupLoopEnd();
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_Leaver_Init () {
    gt_Leaver = TriggerCreate("gt_Leaver_Func");
    TriggerAddEventPlayerLeft(gt_Leaver, c_playerAny, c_gameResultUndecided);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Time
//--------------------------------------------------------------------------------------------------
bool gt_Time_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    TimerStart(gv_time, 524288.0, false, c_timeGame);
    TimerWindowCreate(gv_time, StringExternal("Param/Value/C375D4C6"), true, true);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_Time_Init () {
    gt_Time = TriggerCreate("gt_Time_Func");
    TriggerAddEventMapInit(gt_Time);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Kill Add
//--------------------------------------------------------------------------------------------------
bool gt_KillAdd_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!(((PlayerGroupHasPlayer(PlayerGroupAlliance(c_playerGroupAlly, UnitGetOwner(EventUnit())), UnitGetOwner(EventUnitDamageSourceUnit())) == false) && (UnitGetOwner(EventUnitDamageSourceUnit()) != UnitGetOwner(EventUnit()))))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gv_kills[UnitGetOwner(EventUnitDamageSourceUnit())]=gv_kills[UnitGetOwner(EventUnitDamageSourceUnit())] + 1;
    BoardItemSetText(gv_lBoard, 2, (UnitGetOwner(EventUnitDamageSourceUnit()) + 1), IntToText(gv_kills[UnitGetOwner(EventUnitDamageSourceUnit())]));
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_KillAdd_Init () {
    gt_KillAdd = TriggerCreate("gt_KillAdd_Func");
    TriggerAddEventUnitDied(gt_KillAdd, null);
}

