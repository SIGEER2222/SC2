timer gv_time;
int gv_lBoard;
int[4] gv_kills;

void InitGlobals () {
    int init_i;

    gv_nydusBool = true;
    gv_cSS = null;
    gv_counter = 0;
    gv_time = TimerCreate();
    gv_lBoard = c_boardNone;
    init_i = 0;
    while (init_i <= 3) {
        gv_kills[init_i] = 0;
        init_i = init_i + 1;
    }
}

