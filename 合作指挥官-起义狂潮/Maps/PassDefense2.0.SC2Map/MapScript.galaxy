    gt_SuppDep3 = TriggerCreate("gt_SuppDep3_Func");
    TriggerEnable(gt_SuppDep3, false);
    TriggerAddEventUnitRangePoint(gt_SuppDep3, UnitRefFromVariable("gv_cSS"), PointFromId(167), 1.0, true);
}

//--------------------------------------------------------------------------------------------------
// Trigger: SuppDep4
//--------------------------------------------------------------------------------------------------
bool gt_SuppDep4_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnit()) == "Marine2"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitRemove(EventUnit());
    gv_counter = (gv_counter + 1);
    if ((gv_counter == 4)) {
        PortraitCreate(25, 150, c_anchorBottomRight, 237, 360, "MarinePortrait", "", "Default", true, true);
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaCinematic, StringExternal("Param/Value/8368DBDC"));
        UnitSetHeight(gv_cSS, 3.0, 3.0);
        libNtve_gf_MakeUnitFacePoint(gv_cSS, PointFromId(325), 3.0);
        UnitSetHeight(gv_cSS, 4.5, 3.0);
        UnitIssueOrder(gv_cSS, OrderTargetingPoint(AbilityCommand("move42", 0), PointFromId(325)), c_orderQueueReplace);
        UnitIssueOrder(gv_cSS, OrderTargetingPoint(AbilityCommand("move42", 0), PointFromId(286)), c_orderQueueAddToEnd);
        Wait(6.0, c_timeGame);
        UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
        PortraitDestroyAll();
        PlayerCreateEffectPoint(1, "nukeDetonate", UnitGetPosition(UnitFromId(168)));
        PlayerCreateEffectPoint(1, "nukeDetonate", UnitGetPosition(UnitFromId(168)));
        PlayerCreateEffectPoint(1, "nukeDetonate", UnitGetPosition(UnitFromId(168)));
        PlayerCreateEffectPoint(1, "nukeDetonate", UnitGetPosition(UnitFromId(168)));
        Wait(2.2, c_timeGame);
        CinematicFade(false, 1.0, c_fadeStyleNormal, Color(100.00, 100.00, 100.00), 0.0, true);
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaDirective, StringExternal("Param/Value/ACE81D3A"));
        Wait(4.0, c_timeGame);
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaCinematic, StringExternal("Param/Value/D7CBADC6"));
        Wait(6.0, c_timeGame);
        GameOver(1, c_gameOverVictory, true, true);
        GameOver(3, c_gameOverVictory, true, true);
    }
    else {
    }
    return true;
}

