    gt_Level = TriggerCreate("gt_Level_Func");
    TriggerAddEventUnitGainLevel(gt_Level, UnitRefFromUnit(UnitFromId(53)));
}

//--------------------------------------------------------------------------------------------------
// Trigger: Initial
//--------------------------------------------------------------------------------------------------
bool gt_Initial_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_a;

    // Variable Initialization
    lv_a = 1;

    // Actions
    if (!runActions) {
        return true;
    }

    UnitAbilityEnable(UnitFromId(53), "HunterSeekerMissile", false);
    UnitAbilityEnable(UnitFromId(53), "PsiStorm", false);
    UnitAbilityEnable(UnitFromId(53), "Snipe", false);
    UnitAbilityEnable(UnitFromId(53), "AutoTurret", false);
    UnitAbilityEnable(UnitFromId(53), "nuke", false);
    UnitAbilityEnable(UnitFromId(53), "PersonalCloaking", false);
    UnitAbilityEnable(UnitFromId(53), "PlacePointDefenseDrone", false);
    libNtve_gf_MakeUnitInvulnerable(UnitFromId(238), true);
    gv_object[1] = ObjectiveLastCreated();
    AIGoodGame(1);
    PlayerModifyPropertyInt(1, c_playerPropMinerals, c_playerPropOperAdd, 50);
    TechTreeUpgradeAddLevel(1, "ReaperSpeed", 1);
    TechTreeUpgradeAddLevel(1, "NeosteelFrame", 1);
    CameraPan(1, PointFromId(220), 0.0, -1, 0, false);
    CameraPan(3, PointFromId(220), 0.0, -1, 0, false);
    libNtve_gf_CinematicMode(true, PlayerGroupAll(), c_transitionDurationImmediate);
    libNtve_gf_SetAlliance(1, 2, 5);
    if ((PlayerStatus(3) == c_playerStatusActive)) {
        libNtve_gf_SetAlliance(3, 2, 5);
        libNtve_gf_SetAlliance(1, 3, 1);
        TechTreeUpgradeAddLevel(3, "PsiStormTech", 1);
        TechTreeUpgradeAddLevel(3, "PersonalCloaking", 1);
        TechTreeUpgradeAddLevel(3, "HunterSeeker", 1);
        UnitCreate(1, "Medivac", 0, 3, UnitGetPosition(UnitFromId(142)), 270.0);
        UnitSetOwner(UnitFromId(53), 3, true);
        UnitSetOwner(UnitFromId(142), 3, true);
        Wait(0.2, c_timeGame);
        BoardCreate(3, 4, StringExternal("Param/Value/83BEB8D4"), Color(100.00, 100.00, 100.00));
        gv_lBoard = BoardLastCreated();
        BoardItemSetText(gv_lBoard, 1, 1, StringExternal("Param/Value/93D8DCD0"));
        BoardItemSetText(gv_lBoard, 2, 1, StringExternal("Param/Value/874B6DA6"));
        PlayerGroupLoopBegin(PlayerGroupAll());
        while (!PlayerGroupLoopDone()) {
            BoardPlayerAdd(BoardLastCreated(), PlayerGroupLoopCurrent());
            PlayerGroupLoopStep();
        }
        PlayerGroupLoopEnd();
        BoardItemSetText(gv_lBoard, 1, 2, PlayerName(1));
        BoardItemSetText(gv_lBoard, 1, 2, IntToText(1));
        BoardItemSetText(gv_lBoard, 2, 2, IntToText(gv_kills[1]));
        BoardItemSetText(gv_lBoard, 1, 3, PlayerName(3));
        BoardItemSetText(gv_lBoard, 1, 3, IntToText(3));
        BoardItemSetText(gv_lBoard, 2, 3, IntToText(gv_kills[3]));
        BoardItemSetText(gv_lBoard, 1, 4, PlayerName(2));
        BoardItemSetText(gv_lBoard, 1, 4, IntToText(2));
        BoardItemSetText(gv_lBoard, 2, 4, IntToText(gv_kills[2]));
    }
    else {
        TechTreeUpgradeAddLevel(1, "PsiStormTech", 1);
        TechTreeUpgradeAddLevel(1, "PersonalCloaking", 1);
        TechTreeUpgradeAddLevel(1, "HunterSeeker", 1);
        Wait(0.2, c_timeGame);
        BoardCreate(3, 3, StringExternal("Param/Value/D92F888B"), Color(100.00, 100.00, 100.00));
        gv_lBoard = BoardLastCreated();
        BoardItemSetText(gv_lBoard, 1, 1, StringExternal("Param/Value/4E772921"));
        BoardItemSetText(gv_lBoard, 2, 1, StringExternal("Param/Value/C3F16CA6"));
        PlayerGroupLoopBegin(PlayerGroupAll());
        while (!PlayerGroupLoopDone()) {
            BoardPlayerAdd(BoardLastCreated(), PlayerGroupLoopCurrent());
            PlayerGroupLoopStep();
        }
        PlayerGroupLoopEnd();
        BoardItemSetText(gv_lBoard, 1, 2, PlayerName(1));
        BoardItemSetText(gv_lBoard, 1, 2, IntToText(1));
        BoardItemSetText(gv_lBoard, 2, 2, IntToText(gv_kills[1]));
        BoardItemSetText(gv_lBoard, 1, 3, PlayerName(2));
        BoardItemSetText(gv_lBoard, 1, 3, IntToText(2));
        BoardItemSetText(gv_lBoard, 2, 3, IntToText(gv_kills[2]));
    }
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDirective, StringExternal("Param/Value/AC989513"));
    Wait(3.7, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDirective, StringExternal("Param/Value/BB2C3B70"));
    Wait(3.7, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDirective, StringExternal("Param/Value/679798F9"));
    Wait(3.7, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    Wait(0.7, c_timeGame);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDirective, StringExternal("Param/Value/9A8B3521"));
    Wait(3.7, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    Wait(0.7, c_timeGame);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDirective, StringExternal("Param/Value/04A6F7B6"));
    Wait(3.8, c_timeGame);
