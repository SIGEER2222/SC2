    gt_SuppDep4 = TriggerCreate("gt_SuppDep4_Func");
    TriggerEnable(gt_SuppDep4, false);
    TriggerAddEventUnitRange(gt_SuppDep4, null, UnitFromId(168), 3.0, true);
