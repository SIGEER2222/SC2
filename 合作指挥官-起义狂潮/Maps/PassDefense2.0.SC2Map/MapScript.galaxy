//--------------------------------------------------------------------------------------------------
// Trigger: SuppDep3
//--------------------------------------------------------------------------------------------------
bool gt_SuppDep3_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unitgroup lv_rine;
    unitgroup lv_ling;

    // Variable Initialization
    lv_rine = UnitGroupEmpty();
    lv_ling = UnitGroupEmpty();

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(gt_Barrack1, false);
    TriggerEnable(gt_Barrack2, false);
    TriggerEnable(gt_Starport, false);
    TriggerEnable(gt_TerranRein, false);
    TriggerEnable(gt_Loss, false);
    TriggerEnable(gt_Worm5, false);
    TriggerEnable(gt_Worm4, false);
    TriggerEnable(gt_Worm3, false);
    TriggerEnable(gt_Worm2, false);
    TriggerEnable(gt_Worm1, false);
    TriggerEnable(gt_RearDefault, false);
    TriggerEnable(gt__300Spawn, false);
    TriggerEnable(gt_Muts, false);
    TriggerEnable(gt_CaveSpawn, false);
    TriggerEnable(gt_Megawave, false);
    TriggerEnable(gt_SS1, false);
    TriggerEnable(gt_SS2, false);
    TriggerEnable(gt_Hive, false);
    TriggerEnable(gt_DefaultLings, false);
    TriggerEnable(gt_MassLings, false);
    TriggerEnable(gt_Hydras, false);
    TriggerEnable(gt_Ultras, false);
    TriggerEnable(gt_RoachSpawn, false);
    TriggerEnable(gt_Whipcrack, false);
    TriggerEnable(gt_CornerMuts, false);
    TriggerEnable(gt_Endwave, false);
    TriggerEnable(gt_EndCave, false);
    TriggerEnable(gt_SuppDep3, false);
    TriggerEnable(gt_SuppDep4, true);
    TriggerStop(gt_Initial);
    TriggerEnable(gt_KillAdd, false);
    PortraitDestroyAll();
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    libNtve_gf_HideGameUI(false, PlayerGroupAll());
    UnitGroupLoopBegin(UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    while (!UnitGroupLoopDone()) {
        UnitRemove(UnitGroupLoopCurrent());
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();
    UnitCreate(1, "Battlecruiser22", 0, UnitGetOwner(UnitFromId(316)), UnitGetPosition(UnitFromId(168)), 225.0);
    gv_cSS = UnitLastCreated();
    UnitCreate(4, "Marine2", 0, UnitGetOwner(UnitFromId(316)), PointFromId(309), 315.0);
    lv_rine = UnitLastCreatedGroup();
    UnitSetOwner(UnitFromId(316), 0, false);
    UnitSetHeight(gv_cSS, 2.5, 0.0);
    libNtve_gf_CinematicMode(true, PlayerGroupAll(), c_transitionDurationDefault);
    CameraApplyInfo(1, CameraInfoFromId(326), 0.0, -1, 0, true);
    CameraApplyInfo(3, CameraInfoFromId(326), 0.0, -1, 0, true);
    TriggerExecute(gt_SuppDep5, false, false);
    PortraitCreate(25, 150, c_anchorBottomRight, 237, 360, "GhostPortrait", "", "Default", true, true);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaCinematic, StringExternal("Param/Value/71475B0E"));
    UnitGroupLoopBegin(lv_rine);
    while (!UnitGroupLoopDone()) {
        UnitIssueOrder(UnitGroupLoopCurrent(), OrderTargetingUnit(AbilityCommand("move3", 0), UnitFromId(168)), c_orderQueueReplace);
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();
    Wait(6.0, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    PortraitDestroyAll();
    UnitCreate(12, "Zergling", 0, 2, PointFromId(300), 315.0);
    lv_ling = UnitLastCreatedGroup();
    UnitGroupLoopBegin(lv_ling);
    while (!UnitGroupLoopDone()) {
        UnitIssueOrder(UnitGroupLoopCurrent(), OrderTargetingUnit(AbilityCommand("attack", 0), UnitFromId(168)), c_orderQueueReplace);
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();
    return true;
}

