//--------------------------------------------------------------------------------------------------
// Trigger: Level
//--------------------------------------------------------------------------------------------------
bool gt_Level_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    UnitAbilityEnable(UnitFromId(53), "HunterSeekerMissile", true);
    UnitAbilityEnable(UnitFromId(53), "PsiStorm", true);
    UnitAbilityEnable(UnitFromId(53), "Snipe", true);
    UnitAbilityEnable(UnitFromId(53), "AutoTurret", true);
    UnitAbilityEnable(UnitFromId(53), "nuke", true);
    UnitAbilityEnable(UnitFromId(53), "PersonalCloaking", true);
    UnitAbilityEnable(UnitFromId(53), "PlacePointDefenseDrone", true);
    if ((UnitLevel(UnitFromId(53)) >= 5)) {
        UnitSetPropertyFixed(UnitFromId(53), c_unitPropLifeMax, (UnitGetPropertyFixed(UnitFromId(53), c_unitPropLifeMax, c_unitPropCurrent) + 25.0));
        UnitSetPropertyFixed(UnitFromId(53), c_unitPropShieldsMax, (UnitGetPropertyFixed(UnitFromId(53), c_unitPropShieldsMax, c_unitPropCurrent) + 5.0));
        UnitSetPropertyFixed(UnitFromId(53), c_unitPropEnergyMax, (UnitGetPropertyFixed(UnitFromId(53), c_unitPropEnergyMax, c_unitPropCurrent) + 100.0));
        if ((UnitLevel(UnitFromId(53)) >= 8)) {
        }
        else {
        }
    }
    else {
    }
    return true;
}

