    if (w == 1) { return ai10165012_wave1_createdWave(p); }
    if (w == 2) { return ai10165012_wave2_createdWave(p); }
    if (w == 3) { return ai10165012_wave3_createdWave(p); }
    if (w == 4) { return ai10165012_wave4_createdWave(p); }
    if (w == 5) { return ai10165012_wave5_createdWave(p); }
    return null;
}

//--------------------------------------------------------------------------------------------------
void ai10165012_wave_run (int w, int p, playergroup target, bool wait) {
    if (w == 1) { ai10165012_wave1_run(p, target, wait); }
    if (w == 2) { ai10165012_wave2_run(p, target, wait); }
    if (w == 3) { ai10165012_wave3_run(p, target, wait); }
    if (w == 4) { ai10165012_wave4_run(p, target, wait); }
    if (w == 5) { ai10165012_wave5_run(p, target, wait); }
}

//--------------------------------------------------------------------------------------------------
// Attack Wave Sequence
//--------------------------------------------------------------------------------------------------
trigger ai10165012_waves_trigger = null;
int ai10165012_waves_runPlayer;
playergroup ai10165012_waves_runTarget;

//--------------------------------------------------------------------------------------------------
void ai10165012_waves_init () {
    ai10165012_waves_trigger = TriggerCreate("ai10165012_waves_runFunc");
}

//--------------------------------------------------------------------------------------------------
bool ai10165012_waves_runFunc (bool c, bool a) {
    int p = ai10165012_waves_runPlayer;
    playergroup target = ai10165012_waves_runTarget;

    if (p < 0 || p >= 16) {
        return false;
    }

    ai10165012_wave1_run(p, target, true);
    ai10165012_wave2_run(p, target, true);
    ai10165012_wave3_run(p, target, true);
    ai10165012_wave4_run(p, target, true);
    ai10165012_wave5_run(p, target, true);

    while (true) {
        ai10165012_wave5_run(p, target, true);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void ai10165012_waves_run (int p, playergroup target) {
    ai10165012_waves_runPlayer = p;
    ai10165012_waves_runTarget = PlayerGroupCopy(target);

    TriggerExecute(ai10165012_waves_trigger, false, false);
}

//--------------------------------------------------------------------------------------------------
void ai10165012_waves_enable (int p, bool val) {
    if (p < 0 || p >= 16) {
        return;
    }

    ai10165012_wave1_enable(p, val);
    ai10165012_wave2_enable(p, val);
    ai10165012_wave3_enable(p, val);
    ai10165012_wave4_enable(p, val);
    ai10165012_wave5_enable(p, val);
}

//--------------------------------------------------------------------------------------------------
void ai10165012_waves_stop () {
    TriggerStop(ai10165012_waves_trigger);

    TriggerStop(ai10165012_wave1_trigger);
    TriggerStop(ai10165012_wave2_trigger);
    TriggerStop(ai10165012_wave3_trigger);
    TriggerStop(ai10165012_wave4_trigger);
    TriggerStop(ai10165012_wave5_trigger);
}

//--------------------------------------------------------------------------------------------------
// Configuration
//--------------------------------------------------------------------------------------------------
void ai10165012_setDefGather (int p, point val) {
    if (p < 0 || p >= 16) {
        return;
    }
    ai10165012_defGather[p] = val;
}

//--------------------------------------------------------------------------------------------------
string ai10165012_getCustomData (int p) {
    if (p < 0 || p >= 16) {
        return null;
    }
    return ai10165012_customData[p];
}

//--------------------------------------------------------------------------------------------------
wave ai10165012_getLastWave (int p) {
    if (p < 0 || p >= 16) {
        return null;
    }
    return ai10165012_lastWave[p];
}

//--------------------------------------------------------------------------------------------------
// Start
//--------------------------------------------------------------------------------------------------
bool ai10165012_initialized = false;

//--------------------------------------------------------------------------------------------------
void ai10165012_start (int p) {
    int init_i;

    if (p < 0 || p >= 16) {
        return;
    }
    if (!ai10165012_initialized) {
        ai10165012_wave1_init();
        ai10165012_wave2_init();
        ai10165012_wave3_init();
        ai10165012_wave4_init();
        ai10165012_wave5_init();
        ai10165012_waves_init();

        for (init_i = 0; init_i <= 16; init_i += 1) {
            ai10165012_defGather[init_i] = PointFromId(157);
        }

        ai10165012_initialized = true;
    }

    AICampaignStart(p);
}
