//--------------------------------------------------------------------------------------------------
void ai10165012_wave1_init () {
    int init_i;

    for (init_i = 0; init_i <= 16; init_i += 1) {
        ai10165012_wave1_enabled[init_i] = true;
        ai10165012_wave1_lastWave[init_i] = null;
    }

    ai10165012_wave1_trigger = TriggerCreate("ai10165012_wave1_runFunc");
}

//--------------------------------------------------------------------------------------------------
void ai10165012_wave1_enable (int p, bool val) {
    if (p < 0 || p >= 16) {
        return;
    }
    ai10165012_wave1_enabled[p] = val;
}

//--------------------------------------------------------------------------------------------------
bool ai10165012_wave1_isEnabled (int p) {
    if (p < 0 || p >= 16) {
        return false;
    }
