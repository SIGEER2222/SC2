//--------------------------------------------------------------------------------------------------
bool ai10165012_wave1_runFunc (bool c, bool a) {
    int p = ai10165012_wave1_runPlayer;
    playergroup target = ai10165012_wave1_runTarget;
    int d;
    point gatherPoint = null;
    int ta = 0;
    int tg = 0;
    int ts = 0;
    int tf = 0;
    int td = 0;

    if (p < 0 || p >= 16) {
        return false;
    }
    d = PlayerDifficulty(p);
    if (!ai10165012_wave1_enabled[p]) {
        td = 0;
        if (td > 0) {
            Wait(td, c_timeAI);
        }
        return true;
    }

    ai10165012_customData[p] = "";

    ta = 0;
    if (d == 1) { ta = 300; }
    if (d == 2) { ta = 300; }
    if (d == 3) { ta = 300; }
    if (d == 4) { ta = 300; }
    tg = 0;
    ts = ta;
    if (tg > 0 && tg < ta) {
        Wait(ta - tg, c_timeAI);
        ts = tg;
    }
    AIAttackWaveSetTargetPlayer(p, target);

    gatherPoint = ai10165012_defGather[p];
    AIAttackWaveSetGatherPoint(p, gatherPoint);

    AIAttackWaveClearWaypoints(p);

    AIAttackWaveAddUnits(2, 8, "WarPig");
    AIAttackWaveAddUnits(3, 8, "WarPig");
    AIAttackWaveAddUnits(4, 8, "WarPig");
    AIAttackWaveAddUnits(5, 8, "WarPig");

    AIAttackWaveAddUnits(2, 4, "DevilDog");
    AIAttackWaveAddUnits(3, 4, "DevilDog");
    AIAttackWaveAddUnits(4, 4, "DevilDog");
    AIAttackWaveAddUnits(5, 4, "DevilDog");

    AIAttackWaveAddUnits(2, 2, "HammerSecurity");
    AIAttackWaveAddUnits(3, 2, "HammerSecurity");
    AIAttackWaveAddUnits(4, 2, "HammerSecurity");
    AIAttackWaveAddUnits(5, 2, "HammerSecurity");

    AIAttackWaveAddUnits(2, 2, "MercMedic");
    AIAttackWaveAddUnits(3, 2, "MercMedic");
    AIAttackWaveAddUnits(4, 2, "MercMedic");
    AIAttackWaveAddUnits(5, 2, "MercMedic");

    AIAttackWaveSend(p, ts, false);
    ai10165012_wave1_lastWave[p] = WaveLastCreated();
    ai10165012_lastWave[p] = ai10165012_wave1_lastWave[p];
    Wait(ts, c_timeAI);
    tf = 0;
    if (tf > 0) {
        Wait(tf, c_timeAI);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void ai10165012_wave1_run (int p, playergroup target, bool wait) {
    ai10165012_wave1_runPlayer = p;
    ai10165012_wave1_runTarget = PlayerGroupCopy(target);

    TriggerExecute(ai10165012_wave1_trigger, false, wait);
}

