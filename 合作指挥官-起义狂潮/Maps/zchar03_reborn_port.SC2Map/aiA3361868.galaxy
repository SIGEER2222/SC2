//--------------------------------------------------------------------------------------------------
// Start
//--------------------------------------------------------------------------------------------------
bool aiA3361868_initialized = false;

//--------------------------------------------------------------------------------------------------
void aiA3361868_start (int p) {
    int init_i;

    if (p < 0 || p >= 16) {
        return;
    }
    if (!aiA3361868_initialized) {
        aiA3361868_wave1_init();
        aiA3361868_wave2_init();
        aiA3361868_wave3_init();
        aiA3361868_wave4_init();
        aiA3361868_wave5_init();
        aiA3361868_wave6_init();
        aiA3361868_wave7_init();
        aiA3361868_wave8_init();
        aiA3361868_wave9_init();
        aiA3361868_wave10_init();
        aiA3361868_waves_init();

        for (init_i = 0; init_i <= 16; init_i += 1) {
            aiA3361868_defGather[init_i] = PointFromId(0);
        }

        aiA3361868_initialized = true;
    }

    AICampaignStart(p);
}
