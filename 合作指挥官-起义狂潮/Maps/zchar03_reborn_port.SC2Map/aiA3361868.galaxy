//--------------------------------------------------------------------------------------------------
bool aiA3361868_wave1_runFunc (bool c, bool a) {
    int p = aiA3361868_wave1_runPlayer;
    playergroup target = aiA3361868_wave1_runTarget;
    int d;
    point gatherPoint = null;
    int ta = 0;
    int tg = 0;
    int ts = 0;
    int tf = 0;
    int td = 0;

    if (p < 0 || p >= 16) {
        return false;
    }
    d = PlayerDifficulty(p);
    if (!aiA3361868_wave1_enabled[p]) {
        td = 0;
        if (td > 0) {
            Wait(td, c_timeAI);
        }
        return true;
    }

    aiA3361868_customData[p] = "";

    ta = 0;
    if (d == 1) { ta = 360; }
    if (d == 2) { ta = 360; }
    if (d == 3) { ta = 360; }
    if (d == 4) { ta = 360; }
    tg = 0;
    ts = ta;
    if (tg > 0 && tg < ta) {
        Wait(ta - tg, c_timeAI);
        ts = tg;
    }
    AIAttackWaveSetTargetPlayer(p, target);

    gatherPoint = aiA3361868_defGather[p];
    AIAttackWaveSetGatherPoint(p, gatherPoint);

    AIAttackWaveClearWaypoints(p);

    AIAttackWaveAddUnits(2, 4, "Hellion");
    AIAttackWaveAddUnits(3, 5, "Hellion");
    AIAttackWaveAddUnits(4, 6, "Hellion");
    AIAttackWaveAddUnits(5, 7, "Hellion");

    AIAttackWaveSend(p, ts, false);
    aiA3361868_wave1_lastWave[p] = WaveLastCreated();
    aiA3361868_lastWave[p] = aiA3361868_wave1_lastWave[p];
    Wait(ts, c_timeAI);
    tf = 0;
    if (tf > 0) {
        Wait(tf, c_timeAI);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void aiA3361868_wave1_run (int p, playergroup target, bool wait) {
    aiA3361868_wave1_runPlayer = p;
    aiA3361868_wave1_runTarget = PlayerGroupCopy(target);

    TriggerExecute(aiA3361868_wave1_trigger, false, wait);
}

