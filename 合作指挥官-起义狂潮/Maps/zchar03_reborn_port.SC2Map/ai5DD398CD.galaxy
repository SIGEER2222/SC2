    ai5DD398CD_wave3_run(p, target, true);
    ai5DD398CD_wave4_run(p, target, true);
    ai5DD398CD_wave5_run(p, target, true);
    ai5DD398CD_wave6_run(p, target, true);
    ai5DD398CD_wave7_run(p, target, true);
    ai5DD398CD_wave8_run(p, target, true);
    ai5DD398CD_wave9_run(p, target, true);

    while (true) {
        ai5DD398CD_wave9_run(p, target, true);
    }

    return true;
}

