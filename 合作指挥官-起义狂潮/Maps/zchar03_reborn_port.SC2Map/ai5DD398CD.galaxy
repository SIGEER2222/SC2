//--------------------------------------------------------------------------------------------------
bool ai5DD398CD_wave1_runFunc (bool c, bool a) {
    int p = ai5DD398CD_wave1_runPlayer;
    playergroup target = ai5DD398CD_wave1_runTarget;
    int d;
    point gatherPoint = null;
    int ta = 0;
    int tg = 0;
    int ts = 0;
    int tf = 0;
    int td = 0;

    if (p < 0 || p >= 16) {
        return false;
    }
    d = PlayerDifficulty(p);
    if (!ai5DD398CD_wave1_enabled[p]) {
        td = 0;
        if (td > 0) {
            Wait(td, c_timeAI);
        }
        return true;
    }

    ai5DD398CD_customData[p] = "";

    ta = 0;
    if (d == 1) { ta = 240; }
    if (d == 2) { ta = 240; }
    if (d == 3) { ta = 240; }
    if (d == 4) { ta = 240; }
    tg = 0;
    ts = ta;
    if (tg > 0 && tg < ta) {
        Wait(ta - tg, c_timeAI);
        ts = tg;
    }
    AIAttackWaveSetTargetPlayer(p, target);

    gatherPoint = ai5DD398CD_defGather[p];
    AIAttackWaveSetGatherPoint(p, gatherPoint);

    AIAttackWaveClearWaypoints(p);

    AIAttackWaveAddUnits(2, 4, "MutaliskChar");
    AIAttackWaveAddUnits(3, 4, "MutaliskChar");
    AIAttackWaveAddUnits(4, 4, "MutaliskChar");
    AIAttackWaveAddUnits(5, 4, "MutaliskChar");

    AIAttackWaveSend(p, ts, false);
    ai5DD398CD_wave1_lastWave[p] = WaveLastCreated();
    ai5DD398CD_lastWave[p] = ai5DD398CD_wave1_lastWave[p];
    Wait(ts, c_timeAI);
    tf = 0;
    if (tf > 0) {
        Wait(tf, c_timeAI);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void ai5DD398CD_wave1_run (int p, playergroup target, bool wait) {
    ai5DD398CD_wave1_runPlayer = p;
    ai5DD398CD_wave1_runTarget = PlayerGroupCopy(target);

    TriggerExecute(ai5DD398CD_wave1_trigger, false, wait);
}

