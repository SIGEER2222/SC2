//--------------------------------------------------------------------------------------------------
bool ai5DD398CD_initialized = false;

//--------------------------------------------------------------------------------------------------
void ai5DD398CD_start (int p) {
    int init_i;

    if (p < 0 || p >= 16) {
        return;
    }
    if (!ai5DD398CD_initialized) {
        ai5DD398CD_wave1_init();
        ai5DD398CD_wave2_init();
        ai5DD398CD_wave3_init();
        ai5DD398CD_wave4_init();
        ai5DD398CD_wave5_init();
        ai5DD398CD_wave6_init();
        ai5DD398CD_wave7_init();
        ai5DD398CD_wave8_init();
        ai5DD398CD_wave9_init();
        ai5DD398CD_waves_init();

        for (init_i = 0; init_i <= 16; init_i += 1) {
            ai5DD398CD_defGather[init_i] = PointFromId(918);
        }

        ai5DD398CD_initialized = true;
    }

    AICampaignStart(p);
}
