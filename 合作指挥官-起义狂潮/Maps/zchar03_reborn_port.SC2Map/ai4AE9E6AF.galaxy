trigger ai4AE9E6AF_waves_trigger = null;
int ai4AE9E6AF_waves_runPlayer;
playergroup ai4AE9E6AF_waves_runTarget;

//--------------------------------------------------------------------------------------------------
void ai4AE9E6AF_waves_init () {
    ai4AE9E6AF_waves_trigger = TriggerCreate("ai4AE9E6AF_waves_runFunc");
}

//--------------------------------------------------------------------------------------------------
bool ai4AE9E6AF_waves_runFunc (bool c, bool a) {
    int p = ai4AE9E6AF_waves_runPlayer;
    playergroup target = ai4AE9E6AF_waves_runTarget;

    if (p < 0 || p >= 16) {
        return false;
    }

    ai4AE9E6AF_wave4_run(p, target, true);
    ai4AE9E6AF_wave3_run(p, target, true);
    ai4AE9E6AF_wave5_run(p, target, true);
