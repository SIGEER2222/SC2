//--------------------------------------------------------------------------------------------------
void ai4AE9E6AF_start (int p) {
    int init_i;

    if (p < 0 || p >= 16) {
        return;
    }
    if (!ai4AE9E6AF_initialized) {
        ai4AE9E6AF_wave4_init();
        ai4AE9E6AF_wave3_init();
