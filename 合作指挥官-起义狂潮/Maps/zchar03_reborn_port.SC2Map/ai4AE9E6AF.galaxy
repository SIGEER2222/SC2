    ai4AE9E6AF_wave2_run(p, target, true);
    ai4AE9E6AF_wave11_run(p, target, true);

    while (true) {
        ai4AE9E6AF_wave10_run(p, target, true);
        ai4AE9E6AF_wave1_run(p, target, true);
        ai4AE9E6AF_wave2_run(p, target, true);
        ai4AE9E6AF_wave11_run(p, target, true);
    }

    return true;
}

