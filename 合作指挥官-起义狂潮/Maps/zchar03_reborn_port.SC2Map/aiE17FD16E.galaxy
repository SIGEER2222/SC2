//--------------------------------------------------------------------------------------------------
// Start
//--------------------------------------------------------------------------------------------------
bool aiE17FD16E_initialized = false;

//--------------------------------------------------------------------------------------------------
void aiE17FD16E_start (int p) {
    int init_i;

    if (p < 0 || p >= 16) {
        return;
    }
    if (!aiE17FD16E_initialized) {
        aiE17FD16E_wave1_init();
        aiE17FD16E_wave2_init();
        aiE17FD16E_wave3_init();
        aiE17FD16E_wave4_init();
        aiE17FD16E_wave5_init();
        aiE17FD16E_wave6_init();
        aiE17FD16E_wave7_init();
        aiE17FD16E_wave8_init();
        aiE17FD16E_wave9_init();
        aiE17FD16E_waves_init();

        for (init_i = 0; init_i <= 16; init_i += 1) {
            aiE17FD16E_defGather[init_i] = PointFromId(959983195);
        }

        aiE17FD16E_initialized = true;
    }

    AICampaignStart(p);
}
