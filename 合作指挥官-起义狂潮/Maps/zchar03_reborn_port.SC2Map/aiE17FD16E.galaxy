//--------------------------------------------------------------------------------------------------
// Attack Wave Sequence
//--------------------------------------------------------------------------------------------------
trigger aiE17FD16E_waves_trigger = null;
int aiE17FD16E_waves_runPlayer;
playergroup aiE17FD16E_waves_runTarget;

//--------------------------------------------------------------------------------------------------
void aiE17FD16E_waves_init () {
    aiE17FD16E_waves_trigger = TriggerCreate("aiE17FD16E_waves_runFunc");
}

//--------------------------------------------------------------------------------------------------
bool aiE17FD16E_waves_runFunc (bool c, bool a) {
    int p = aiE17FD16E_waves_runPlayer;
    playergroup target = aiE17FD16E_waves_runTarget;

    if (p < 0 || p >= 16) {
        return false;
    }

    aiE17FD16E_wave1_run(p, target, true);
    aiE17FD16E_wave2_run(p, target, true);
    aiE17FD16E_wave3_run(p, target, true);
    aiE17FD16E_wave4_run(p, target, true);
    aiE17FD16E_wave5_run(p, target, true);
    aiE17FD16E_wave6_run(p, target, true);
    aiE17FD16E_wave7_run(p, target, true);
    aiE17FD16E_wave8_run(p, target, true);
    aiE17FD16E_wave9_run(p, target, true);

    while (true) {
        aiE17FD16E_wave7_run(p, target, true);
        aiE17FD16E_wave8_run(p, target, true);
        aiE17FD16E_wave9_run(p, target, true);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void aiE17FD16E_waves_run (int p, playergroup target) {
    aiE17FD16E_waves_runPlayer = p;
    aiE17FD16E_waves_runTarget = PlayerGroupCopy(target);

    TriggerExecute(aiE17FD16E_waves_trigger, false, false);
}

//--------------------------------------------------------------------------------------------------
void aiE17FD16E_waves_enable (int p, bool val) {
    if (p < 0 || p >= 16) {
        return;
    }

    aiE17FD16E_wave1_enable(p, val);
    aiE17FD16E_wave2_enable(p, val);
    aiE17FD16E_wave3_enable(p, val);
    aiE17FD16E_wave4_enable(p, val);
    aiE17FD16E_wave5_enable(p, val);
    aiE17FD16E_wave6_enable(p, val);
    aiE17FD16E_wave7_enable(p, val);
    aiE17FD16E_wave8_enable(p, val);
    aiE17FD16E_wave9_enable(p, val);
}

//--------------------------------------------------------------------------------------------------
void aiE17FD16E_waves_stop () {
    TriggerStop(aiE17FD16E_waves_trigger);

    TriggerStop(aiE17FD16E_wave1_trigger);
    TriggerStop(aiE17FD16E_wave2_trigger);
    TriggerStop(aiE17FD16E_wave3_trigger);
    TriggerStop(aiE17FD16E_wave4_trigger);
    TriggerStop(aiE17FD16E_wave5_trigger);
    TriggerStop(aiE17FD16E_wave6_trigger);
    TriggerStop(aiE17FD16E_wave7_trigger);
    TriggerStop(aiE17FD16E_wave8_trigger);
    TriggerStop(aiE17FD16E_wave9_trigger);
}

