//--------------------------------------------------------------------------------------------------
// Attack Wave Sequence
//--------------------------------------------------------------------------------------------------
trigger ai61836405_waves_trigger = null;
int ai61836405_waves_runPlayer;
playergroup ai61836405_waves_runTarget;

//--------------------------------------------------------------------------------------------------
void ai61836405_waves_init () {
    ai61836405_waves_trigger = TriggerCreate("ai61836405_waves_runFunc");
}

//--------------------------------------------------------------------------------------------------
bool ai61836405_waves_runFunc (bool c, bool a) {
    int p = ai61836405_waves_runPlayer;
    playergroup target = ai61836405_waves_runTarget;

    if (p < 0 || p >= 16) {
        return false;
    }

    ai61836405_wave1_run(p, target, true);
    ai61836405_wave2_run(p, target, true);
    ai61836405_wave3_run(p, target, true);
    ai61836405_wave4_run(p, target, true);
    ai61836405_wave5_run(p, target, true);
    ai61836405_wave6_run(p, target, true);
    ai61836405_wave7_run(p, target, true);

    while (true) {
        ai61836405_wave7_run(p, target, true);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void ai61836405_waves_run (int p, playergroup target) {
    ai61836405_waves_runPlayer = p;
    ai61836405_waves_runTarget = PlayerGroupCopy(target);

    TriggerExecute(ai61836405_waves_trigger, false, false);
}

//--------------------------------------------------------------------------------------------------
void ai61836405_waves_enable (int p, bool val) {
    if (p < 0 || p >= 16) {
        return;
    }

    ai61836405_wave1_enable(p, val);
    ai61836405_wave2_enable(p, val);
    ai61836405_wave3_enable(p, val);
    ai61836405_wave4_enable(p, val);
    ai61836405_wave5_enable(p, val);
    ai61836405_wave6_enable(p, val);
    ai61836405_wave7_enable(p, val);
}

//--------------------------------------------------------------------------------------------------
void ai61836405_waves_stop () {
    TriggerStop(ai61836405_waves_trigger);

    TriggerStop(ai61836405_wave1_trigger);
    TriggerStop(ai61836405_wave2_trigger);
    TriggerStop(ai61836405_wave3_trigger);
    TriggerStop(ai61836405_wave4_trigger);
    TriggerStop(ai61836405_wave5_trigger);
    TriggerStop(ai61836405_wave6_trigger);
    TriggerStop(ai61836405_wave7_trigger);
}

