//--------------------------------------------------------------------------------------------------
// Start
//--------------------------------------------------------------------------------------------------
bool ai61836405_initialized = false;

//--------------------------------------------------------------------------------------------------
void ai61836405_start (int p) {
    int init_i;

    if (p < 0 || p >= 16) {
        return;
    }
    if (!ai61836405_initialized) {
        ai61836405_wave1_init();
        ai61836405_wave2_init();
        ai61836405_wave3_init();
        ai61836405_wave4_init();
        ai61836405_wave5_init();
        ai61836405_wave6_init();
        ai61836405_wave7_init();
        ai61836405_waves_init();

        for (init_i = 0; init_i <= 16; init_i += 1) {
            ai61836405_defGather[init_i] = PointFromId(917);
        }

        ai61836405_initialized = true;
    }

    AICampaignStart(p);
}
