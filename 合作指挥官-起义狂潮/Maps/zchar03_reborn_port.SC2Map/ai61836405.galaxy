//--------------------------------------------------------------------------------------------------
void ai61836405_wave1_init () {
    int init_i;

    for (init_i = 0; init_i <= 16; init_i += 1) {
        ai61836405_wave1_enabled[init_i] = true;
        ai61836405_wave1_lastWave[init_i] = null;
    }

    ai61836405_wave1_trigger = TriggerCreate("ai61836405_wave1_runFunc");
}

//--------------------------------------------------------------------------------------------------
void ai61836405_wave1_enable (int p, bool val) {
    if (p < 0 || p >= 16) {
        return;
    }
    ai61836405_wave1_enabled[p] = val;
}

//--------------------------------------------------------------------------------------------------
bool ai61836405_wave1_isEnabled (int p) {
    if (p < 0 || p >= 16) {
        return false;
    }
    return ai61836405_wave1_enabled[p];
}

//--------------------------------------------------------------------------------------------------
wave ai61836405_wave1_createdWave (int p) {
    if (p < 0 || p >= 16) {
        return null;
    }
    return ai61836405_wave1_lastWave[p];
}

//--------------------------------------------------------------------------------------------------
bool ai61836405_wave1_runFunc (bool c, bool a) {
    int p = ai61836405_wave1_runPlayer;
    playergroup target = ai61836405_wave1_runTarget;
    int d;
    point gatherPoint = null;
    int ta = 0;
    int tg = 0;
    int ts = 0;
    int tf = 0;
    int td = 0;

    if (p < 0 || p >= 16) {
        return false;
    }
    d = PlayerDifficulty(p);
    if (!ai61836405_wave1_enabled[p]) {
        td = 0;
        if (td > 0) {
            Wait(td, c_timeAI);
        }
        return true;
    }

    ai61836405_customData[p] = "";

    ta = 0;
    if (d == 1) { ta = 300; }
    if (d == 2) { ta = 300; }
    if (d == 3) { ta = 300; }
    if (d == 4) { ta = 300; }
    tg = 0;
    ts = ta;
    if (tg > 0 && tg < ta) {
        Wait(ta - tg, c_timeAI);
        ts = tg;
    }
    AIAttackWaveSetTargetPlayer(p, target);

    gatherPoint = ai61836405_defGather[p];
    AIAttackWaveSetGatherPoint(p, gatherPoint);

    AIAttackWaveClearWaypoints(p);

    AIAttackWaveAddUnits(2, 6, "Marine");
    AIAttackWaveAddUnits(3, 6, "Marine");
    AIAttackWaveAddUnits(4, 8, "Marine");
    AIAttackWaveAddUnits(5, 8, "Marine");

    AIAttackWaveSend(p, ts, false);
    ai61836405_wave1_lastWave[p] = WaveLastCreated();
    ai61836405_lastWave[p] = ai61836405_wave1_lastWave[p];
    Wait(ts, c_timeAI);
    tf = 0;
    if (tf > 0) {
        Wait(tf, c_timeAI);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void ai61836405_wave1_run (int p, playergroup target, bool wait) {
    ai61836405_wave1_runPlayer = p;
    ai61836405_wave1_runTarget = PlayerGroupCopy(target);

    TriggerExecute(ai61836405_wave1_trigger, false, wait);
}

