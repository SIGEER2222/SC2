    AIAttackWaveSetGatherPoint(p, gatherPoint);

    AIAttackWaveClearWaypoints(p);

    AIAttackWaveAddUnits(2, 6, "Marine");
    AIAttackWaveAddUnits(3, 6, "Marine");
    AIAttackWaveAddUnits(4, 6, "Marine");
    AIAttackWaveAddUnits(5, 6, "Marine");

    AIAttackWaveAddUnits(2, 4, "Marauder");
    AIAttackWaveAddUnits(3, 4, "Marauder");
    AIAttackWaveAddUnits(4, 4, "Marauder");
    AIAttackWaveAddUnits(5, 4, "Marauder");

    AIAttackWaveAddUnits(2, 4, "Firebat");
    AIAttackWaveAddUnits(3, 4, "Firebat");
    AIAttackWaveAddUnits(4, 4, "Firebat");
    AIAttackWaveAddUnits(5, 4, "Firebat");

    AIAttackWaveSend(p, ts, false);
    ai61836405_wave7_lastWave[p] = WaveLastCreated();
    ai61836405_lastWave[p] = ai61836405_wave7_lastWave[p];
    Wait(ts, c_timeAI);
    tf = 0;
    if (tf > 0) {
        Wait(tf, c_timeAI);
    }

    return true;
}

