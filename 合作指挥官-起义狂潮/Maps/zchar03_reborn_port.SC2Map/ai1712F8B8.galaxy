//--------------------------------------------------------------------------------------------------
bool ai1712F8B8_waves_runFunc (bool c, bool a) {
    int p = ai1712F8B8_waves_runPlayer;
    playergroup target = ai1712F8B8_waves_runTarget;

    if (p < 0 || p >= 16) {
        return false;
    }

    ai1712F8B8_wave1_run(p, target, true);
    ai1712F8B8_wave2_run(p, target, true);
    ai1712F8B8_wave3_run(p, target, true);
    ai1712F8B8_wave4_run(p, target, true);
