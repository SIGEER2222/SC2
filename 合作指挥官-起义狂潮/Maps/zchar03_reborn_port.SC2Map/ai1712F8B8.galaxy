    ai1712F8B8_wave7_run(p, target, true);
    ai1712F8B8_wave8_run(p, target, true);

    while (true) {
        ai1712F8B8_wave6_run(p, target, true);
        ai1712F8B8_wave7_run(p, target, true);
        ai1712F8B8_wave8_run(p, target, true);
