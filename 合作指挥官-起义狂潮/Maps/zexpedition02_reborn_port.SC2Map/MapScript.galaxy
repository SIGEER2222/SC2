//--------------------------------------------------------------------------------------------------
bool gt_SzayelIntro_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(10.0, c_timeReal);
    TriggerQueueEnter();
    BankLoad("cryswarmcoop", 1);
    if ((lib48DF4533_gf_SetAllHatcheriesRallyPoints4() == true)) {
        TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("SzayelPortrait"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "", "Talk", null, StringExternal("Param/Value/DFD4757A"), StringExternal("Param/Value/844150D6"), 6.0, c_transmissionDurationAdd, true, c_maxPlayers, false);
    }

    if ((BankValueGetAsString(BankLastCreated(), "Bonuses", "Kaldir1Choice") == "Spare")) {
        TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("SzayelPortrait"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "", "Talk", null, StringExternal("Param/Value/C9B9E5CF"), StringExternal("Param/Value/04C74037"), 7.0, c_transmissionDurationAdd, true, c_maxPlayers, false);
