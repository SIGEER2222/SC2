    Wait(210.0, c_timeGame);
    libNtve_gf_SetUpgradeLevelForPlayer(gv_izshasHost, "ZergFlyerWeaponsLevel2", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(gv_izshasHost, "ZergFlyerArmorsLevel2", 1);
