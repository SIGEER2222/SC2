//--------------------------------------------------------------------------------------------------
// Trigger: Trigger Defenses Southeast
//--------------------------------------------------------------------------------------------------
bool gt_TriggerDefensesSoutheast_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGroupCount(UnitGroupAlliance(1, c_unitAllianceEnemy, RegionFromId(12), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) <= 1))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    AIToggleBulliesInRegion(gv_pLAYER_01_USER2, RegionFromId(12), true);
    PlayerModifyPropertyInt(gv_pLAYER_01_USER2, c_playerPropMinerals, c_playerPropOperAdd, 1500);
    PlayerModifyPropertyInt(gv_pLAYER_01_USER2, c_playerPropVespene, c_playerPropOperAdd, 1000);
    return true;
}

