//--------------------------------------------------------------------------------------------------
// Trigger: Enslaved Zerg Waves
//--------------------------------------------------------------------------------------------------
bool gt_EnslavedZergWaves_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    const int auto4C8E9626_n = 12;
    int auto4C8E9626_i;
    const int autoEE50E391_n = 4;
    int autoEE50E391_i;
    const int auto3C6C6860_n = 2;
    int auto3C6C6860_i;
    const int auto59151E95_n = 4;
    int auto59151E95_i;
    const int auto74BF1832_n = 2;
    int auto74BF1832_i;
    const int auto1CC726F1_n = 2;
    int auto1CC726F1_i;
    int autoAE2BEFE6_val;

    // Actions
    if (!runActions) {
        return true;
    }

    Wait(180.0, c_timeGame);
    while (true) {
        AIAttackWaveSetTargetPlayer(gv_enslavedZerg, PlayerGroupAlliance(c_playerGroupEnemy, gv_enslavedZerg));
        for (auto4C8E9626_i = 1; auto4C8E9626_i <= auto4C8E9626_n; auto4C8E9626_i += 1) {
            AIAttackWaveAddUnits4(1, 1, 1, 1, "Zergling");
        }
        for (autoEE50E391_i = 1; autoEE50E391_i <= autoEE50E391_n; autoEE50E391_i += 1) {
            AIAttackWaveAddUnits4(1, 1, 1, 1, "Roach");
        }
        for (auto3C6C6860_i = 1; auto3C6C6860_i <= auto3C6C6860_n; auto3C6C6860_i += 1) {
            AIAttackWaveAddUnits4(1, 1, 1, 1, "Hydralisk");
        }
        if ((PlayerGetAlliance(gv_enslavedZerg, c_allianceIdVision, gv_pLAYER_01_USER) == true)) {
            for (auto59151E95_i = 1; auto59151E95_i <= auto59151E95_n; auto59151E95_i += 1) {
                AIAttackWaveAddUnits4(1, 1, 1, 1, "Zergling");
            }
            for (auto74BF1832_i = 1; auto74BF1832_i <= auto74BF1832_n; auto74BF1832_i += 1) {
                AIAttackWaveAddUnits4(1, 1, 1, 1, "Roach");
            }
            for (auto1CC726F1_i = 1; auto1CC726F1_i <= auto1CC726F1_n; auto1CC726F1_i += 1) {
                AIAttackWaveAddUnits4(1, 1, 1, 1, "Hydralisk");
            }
        }

        if ((PlayerGetAlliance(gv_enslavedZerg, c_allianceIdVision, gv_pLAYER_01_USER) == false)) {
            autoAE2BEFE6_val = RandomInt(1, 3);
            if (autoAE2BEFE6_val == 1) {
                AIAttackWaveAddWaypoint(gv_enslavedZerg, PointFromId(449243336), false);
            }
            else if (autoAE2BEFE6_val == 2) {
                AIAttackWaveAddWaypoint(gv_enslavedZerg, PointFromId(757506692), false);
            }
            else {
            }
        }

        AIAttackWaveSend(gv_enslavedZerg, 0, false);
        Wait(180.0, c_timeGame);
    }
    return true;
}

