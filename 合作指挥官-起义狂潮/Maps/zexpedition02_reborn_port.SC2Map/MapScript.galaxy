//--------------------------------------------------------------------------------------------------
// Trigger: Start AI
//--------------------------------------------------------------------------------------------------
bool gt_StartAI_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    AINearestTownBullyRebuild(gv_daelaamProtoss, true);
    AINearestTownBullyRebuild(gv_shakurasProtoss, true);
    AINearestTownBullyRebuild(gv_khalaiProtoss, true);
    cai_startall();
    cai_runall();
    cai_waves_run(gv_daelaamProtoss, PlayerGroupSingle(1));
    AIToggleBulliesInRegion(gv_pLAYER_01_USER2, RegionFromId(2), true);
    AIToggleBulliesInRegion(gv_enslavedZerg, RegionFromId(37), true);
    AIToggleBulliesInRegion(gv_shakurasProtoss, RegionFromId(21), true);
    AIToggleBulliesInRegion(gv_khalaiProtoss, RegionFromId(38), true);
    AIToggleBulliesInRegion(gv_izshasHost, RegionFromId(40), true);
    AIToggleBulliesInRegion(gv_khalaiProtoss, RegionFromId(6), true);
    if ((libHots_gf_DifficultyValueInt2(0, 0, 1) == 1)) {
        TriggerExecute(gt_StartUpgradesHard, true, false);
    }
    else {
        TriggerExecute(gt_StartUpgradesNormal, true, false);
    }
    return true;
}

