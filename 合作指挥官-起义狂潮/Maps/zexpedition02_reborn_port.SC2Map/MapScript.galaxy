//--------------------------------------------------------------------------------------------------
// Trigger: Dark Archons
//--------------------------------------------------------------------------------------------------
bool gt_DarkArchons_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGroupCount(UnitGroup("DarkArchon", gv_shakurasProtoss, RegionFromId(37), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) == 0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    ObjectiveSetState(DataTableGetObjective(true, "Kaldir2Archons"), c_objectiveStateCompleted);
    PlayerGroupAdd(gv_fren, gv_enslavedZerg);
    PlayerGroupRemove(gv_protossPlayers, gv_enslavedZerg);
    libNtve_gf_SetPlayerGroupAlliance(gv_fren, libNtve_ge_AllianceSetting_AllyWithSharedVisionAndPushable);
    libNtve_gf_SetAllianceBetweenTwoPlayerGroups(gv_fren, gv_protossPlayers, libNtve_ge_AllianceSetting_Enemy);
    libNtve_gf_SetAllianceBetweenTwoPlayerGroups(gv_protossPlayers, gv_fren, libNtve_ge_AllianceSetting_Enemy);
    AISetAPM(gv_enslavedZerg, 9001);
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSource(), c_invalidPortraitId, "", "Talk", null, StringExternal("Param/Value/6D4C6D88"), StringExternal("Param/Value/B07534F7"), 7.0, c_transmissionDurationAdd, true, c_maxPlayers, false);
    return true;
}

