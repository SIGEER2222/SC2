//--------------------------------------------------------------------------------------------------
bool gt_EnslavedZergAllianceExpand_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGroupCount(UnitGroupAlliance(1, c_unitAllianceEnemy, RegionFromId(29), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) <= 2))) {
            return false;
        }

        if (!((libNtve_gf_PlayerIsEnemy(gv_enslavedZerg, gv_pLAYER_01_USER, libNtve_ge_PlayerRelation_AllyMutual) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    AIToggleBulliesInRegion(gv_enslavedZerg, RegionFromId(29), true);
    AIToggleBulliesInRegion(gv_pLAYER_01_USER2, RegionFromId(29), true);
    PlayerModifyPropertyInt(gv_enslavedZerg, c_playerPropMinerals, c_playerPropOperAdd, 1500);
    PlayerModifyPropertyInt(gv_enslavedZerg, c_playerPropVespene, c_playerPropOperAdd, 1000);
    PlayerModifyPropertyInt(gv_pLAYER_01_USER2, c_playerPropMinerals, c_playerPropOperAdd, 1500);
    PlayerModifyPropertyInt(gv_pLAYER_01_USER2, c_playerPropVespene, c_playerPropOperAdd, 1000);
    TriggerQueueEnter();
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("ZergAdjutantPortrait"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "", "Talk", null, StringExternal("Param/Value/6B673544"), StringExternal("Param/Value/0D6DD1A4"), 7.0, c_transmissionDurationAdd, true, c_maxPlayers, false);
    TriggerQueueExit();
    return true;
}

