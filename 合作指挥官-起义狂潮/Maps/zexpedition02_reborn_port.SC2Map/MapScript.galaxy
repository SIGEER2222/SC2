//--------------------------------------------------------------------------------------------------
// Trigger: Izsha Helper
//--------------------------------------------------------------------------------------------------
bool gt_IzshaHelper_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitGroupCount(UnitGroup("Igniter", gv_izshasHost, RegionFromId(40), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) < 3)) {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "Igniter", c_unitCreateIgnorePlacement, gv_izshasHost, PointFromId(1196790041));
        libSwaC_gf_CreateDropPod(libSwaC_ge_DropPodRace_Zerg, RegionRandomPoint(RegionFromId(40)), UnitLastCreatedGroup(), false, gv_izshasHost);
    }
    else {
        if ((UnitGroupCount(UnitGroup("Ravager", gv_izshasHost, RegionFromId(40), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) < 1)) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "Ravager", c_unitCreateIgnorePlacement, gv_izshasHost, PointFromId(1196790041));
            libSwaC_gf_CreateDropPod(libSwaC_ge_DropPodRace_Zerg, RegionRandomPoint(RegionFromId(40)), UnitLastCreatedGroup(), false, gv_izshasHost);
        }
        else {
            if ((UnitGroupCount(UnitGroup("Hydralisk", gv_izshasHost, RegionFromId(40), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) < 2)) {
                libNtve_gf_CreateUnitsWithDefaultFacing(1, "Hydralisk", c_unitCreateIgnorePlacement, gv_izshasHost, PointFromId(1196790041));
                libSwaC_gf_CreateDropPod(libSwaC_ge_DropPodRace_Zerg, RegionRandomPoint(RegionFromId(40)), UnitLastCreatedGroup(), false, gv_izshasHost);
            }
            else {
                if ((UnitGroupCount(UnitGroup("Mutalisk", gv_izshasHost, RegionFromId(40), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) < 2)) {
                    libNtve_gf_CreateUnitsWithDefaultFacing(1, "Mutalisk", c_unitCreateIgnorePlacement, gv_izshasHost, PointFromId(1196790041));
                    libSwaC_gf_CreateDropPod(libSwaC_ge_DropPodRace_Zerg, RegionRandomPoint(RegionFromId(40)), UnitLastCreatedGroup(), false, gv_izshasHost);
                }
                else {
                    if ((UnitGroupCount(UnitGroup("Queen", gv_izshasHost, RegionFromId(40), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) == 0)) {
                        libNtve_gf_CreateUnitsWithDefaultFacing(1, "Queen", c_unitCreateIgnorePlacement, gv_izshasHost, PointFromId(1196790041));
                        libSwaC_gf_CreateDropPod(libSwaC_ge_DropPodRace_Zerg, RegionRandomPoint(RegionFromId(40)), UnitLastCreatedGroup(), false, gv_izshasHost);
                    }

                }
            }
        }
    }
    return true;
}

