    libNtve_gf_CreateUnitsWithDefaultFacing(8, "Mutalisk", c_unitCreateIgnorePlacement, gv_izshasHost, PointFromId(28193991));
    AIAttackWaveUseGroup(gv_izshasHost, UnitLastCreatedGroup());
    AIAttackWaveSend(gv_izshasHost, 0, false);
