//--------------------------------------------------------------------------------------------------
bool gt_IzshaWaves_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    AIAttackWaveSetTargetPlayer(gv_izshasHost, PlayerGroupSingle(gv_daelaamProtoss));
    Wait(110.0, c_timeGame);
    libNtve_gf_CreateUnitsWithDefaultFacing(2, "Mutalisk", c_unitCreateIgnorePlacement, gv_izshasHost, PointFromId(28193991));
    AIAttackWaveUseGroup(gv_izshasHost, UnitLastCreatedGroup());
    AIAttackWaveSend(gv_izshasHost, 0, false);
    Wait(210.0, c_timeGame);
    libNtve_gf_CreateUnitsWithDefaultFacing(2, "Mutalisk", c_unitCreateIgnorePlacement, gv_izshasHost, PointFromId(28193991));
    libNtve_gf_SetUpgradeLevelForPlayer(gv_izshasHost, "ZergFlyerWeaponsLevel1", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(gv_izshasHost, "ZergFlyerArmorsLevel1", 1);
