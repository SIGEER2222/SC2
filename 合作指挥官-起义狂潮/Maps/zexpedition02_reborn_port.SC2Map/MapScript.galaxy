    AIAttackWaveUseGroup(gv_izshasHost, UnitLastCreatedGroup());
    AIAttackWaveSend(gv_izshasHost, 0, false);
    Wait(210.0, c_timeGame);
    libNtve_gf_CreateUnitsWithDefaultFacing(6, "Mutalisk", c_unitCreateIgnorePlacement, gv_izshasHost, PointFromId(28193991));
    AIAttackWaveUseGroup(gv_izshasHost, UnitLastCreatedGroup());
    AIAttackWaveSend(gv_izshasHost, 0, false);
    Wait(210.0, c_timeGame);
    libNtve_gf_SetUpgradeLevelForPlayer(gv_izshasHost, "ZergFlyerWeaponsLevel3", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(gv_izshasHost, "ZergFlyerArmorsLevel3", 1);
    libNtve_gf_CreateUnitsWithDefaultFacing(7, "Mutalisk", c_unitCreateIgnorePlacement, gv_izshasHost, PointFromId(28193991));
    AIAttackWaveUseGroup(gv_izshasHost, UnitLastCreatedGroup());
