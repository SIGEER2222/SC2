    aiC8B8F737_wave5_enable(p, val);
    aiC8B8F737_wave10_enable(p, val);
    aiC8B8F737_wave2_enable(p, val);
    aiC8B8F737_wave1_enable(p, val);
    aiC8B8F737_wave4_enable(p, val);
    aiC8B8F737_wave6_enable(p, val);
}

