    AIAttackWaveAddUnits(3, 1, "WarHound");
    AIAttackWaveAddUnits(4, 2, "WarHound");
    AIAttackWaveAddUnits(5, 3, "WarHound");

    AIAttackWaveSend(p, ts, false);
    aiC8B8F737_wave4_lastWave[p] = WaveLastCreated();
    aiC8B8F737_lastWave[p] = aiC8B8F737_wave4_lastWave[p];
    Wait(ts, c_timeAI);
    tf = 0;
    if (tf > 0) {
        Wait(tf, c_timeAI);
    }

    return true;
}

