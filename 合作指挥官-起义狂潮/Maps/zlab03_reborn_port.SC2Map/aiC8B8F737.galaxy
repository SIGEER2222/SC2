void aiC8B8F737_waves_run (int p, playergroup target) {
    aiC8B8F737_waves_runPlayer = p;
    aiC8B8F737_waves_runTarget = PlayerGroupCopy(target);

    TriggerExecute(aiC8B8F737_waves_trigger, false, false);
}

