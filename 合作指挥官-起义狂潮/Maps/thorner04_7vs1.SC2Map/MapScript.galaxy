    unitgroup lv_medivacs;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_attackers = UnitGroupCopy(gv_killTeamAttackers);
    lv_medivacs = UnitGroupCopy(gv_killTeamMedivacs);

