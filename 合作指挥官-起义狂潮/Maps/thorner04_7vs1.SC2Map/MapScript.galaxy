//--------------------------------------------------------------------------------------------------
// Trigger: Reinforce Regions With Bullies
//--------------------------------------------------------------------------------------------------
bool gt_ReinforceRegionsWithBullies_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    AIToggleBulliesInRegion(gv_p05_DOMINION_RAIDER, RegionFromId(41), true);
    AIToggleBulliesInRegion(gv_p04_DOMINION_AIR, RegionFromId(8), true);
    AIToggleBulliesInRegion(gv_p03_DOMINION_SIEGE, RegionFromId(40), true);
    AIToggleBulliesInRegion(gv_p02_DOMINION_INFANTRY, RegionEntireMap(), true);
    Wait(300.0, c_timeGame);
    AIToggleBulliesInRegion(gv_p9_MINELAYERGARRISON, RegionFromId(62), true);
    AIToggleBulliesInRegion(gv_p9_MINELAYERGARRISON, RegionFromId(63), true);
    AIToggleBulliesInRegion(gv_p9_MINELAYERGARRISON, RegionFromId(41), true);
    AIToggleBulliesInRegion(gv_p10_AERIALPATROLS, RegionFromId(40), true);
    AIToggleBulliesInRegion(gv_p02_DOMINION_INFANTRY, RegionFromId(8), true);
    Wait(300.0, c_timeGame);
    gv_zergIntensity += 1;
    gv_fleetIntensity += 1;
    AIToggleBulliesInRegion(gv_p04_DOMINION_AIR, RegionFromId(45), true);
    AIToggleBulliesInRegion(gv_p9_MINELAYERGARRISON, RegionFromId(44), true);
    AIToggleBulliesInRegion(gv_p9_MINELAYERGARRISON, RegionFromId(45), true);
    AIToggleBulliesInRegion(gv_p03_DOMINION_SIEGE, RegionFromId(66), true);
    Wait(300.0, c_timeGame);
    AIToggleBulliesInRegion(gv_p9_MINELAYERGARRISON, RegionFromId(64), true);
    AIToggleBulliesInRegion(gv_p9_MINELAYERGARRISON, RegionFromId(65), true);
    AIToggleBulliesInRegion(gv_p05_DOMINION_RAIDER, RegionFromId(66), true);
    gv_zergIntensity += 1;
    gv_nukeIntensity += 1;
    Wait(300.0, c_timeGame);
    gv_fleetIntensity += 1;
    gv_zergIntensity += 1;
    AIToggleBulliesInRegion(gv_p03_DOMINION_SIEGE, RegionFromId(64), true);
    Wait(300.0, c_timeGame);
    gv_fleetIntensity += 1;
    gv_nukeIntensity += 1;
    gv_zergIntensity += 1;
    Wait(300.0, c_timeGame);
    while (true) {
        gv_nukeIntensity += 1;
        gv_fleetIntensity += 1;
        gv_zergIntensity += 1;
        Wait(300.0, c_timeGame);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_ReinforceRegionsWithBullies_Init () {
    gt_ReinforceRegionsWithBullies = TriggerCreate("gt_ReinforceRegionsWithBullies_Func");
}

