//--------------------------------------------------------------------------------------------------
// Trigger: Start AI
//--------------------------------------------------------------------------------------------------
bool gt_StartAI_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    gv_mechWaypointArray[0] = PointFromId(302);
    gv_mechWaypointArray[1] = PointFromId(1220);
    AISetGroupScriptControlled(UnitGroup("SCV", gv_p03_DOMINION_SIEGE, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), false);
    AICampaignStart(gv_p02_DOMINION_INFANTRY);
    AICampaignStart(gv_p03_DOMINION_SIEGE);
    AICampaignStart(gv_p04_DOMINION_AIR);
    AICampaignStart(gv_p05_DOMINION_RAIDER);
    AICampaignStart(gv_p08_DOMINION);
    AICampaignStart(gv_p9_MINELAYERGARRISON);
    AICampaignStart(gv_p10_AERIALPATROLS);
    AICampaignStart(gv_p11_DOGSOFWAR);
    AICampaignStart(gv_p12_NUKINGGHOSTS);
    AICampaignStart(gv_p13_FLEET);
    AICampaignStart(gv_p14_KILLTEAMS);
    AIAttackWaveSetTargetPlayer(gv_p03_DOMINION_SIEGE, PlayerGroupSingle(gv_p01_USER));
    AIAttackWaveSetTargetPlayer(gv_p04_DOMINION_AIR, PlayerGroupSingle(gv_p01_USER));
    AIAttackWaveSetTargetPlayer(gv_p05_DOMINION_RAIDER, PlayerGroupSingle(gv_p01_USER));
    AIAttackWaveSetGatherPoint(gv_p03_DOMINION_SIEGE, PointFromId(1070));
    AIAttackWaveSetGatherPoint(gv_p04_DOMINION_AIR, PointFromId(1071));
    AIAttackWaveSetGatherPoint(gv_p05_DOMINION_RAIDER, PointFromId(1069));
    TriggerExecute(gt_P5ShadowOpsAttacks, true, false);
    TriggerExecute(gt_P4FleetAttacks, true, false);
    TriggerExecute(gt_P3AlphaSquadronAttacks, true, false);
    TriggerExecute(gt_ReinforceRegionsWithBullies, true, false);
    TriggerExecute(gt_AerialPatrols, true, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_StartAI_Init () {
    gt_StartAI = TriggerCreate("gt_StartAI_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: P5 Shadow Ops Attacks
//--------------------------------------------------------------------------------------------------
bool gt_P5ShadowOpsAttacks_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_aI;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_aI = 5;

    // Actions
    if (!runActions) {
        return true;
    }

    AIAttackWaveSetTargetPlayer(lv_aI, PlayerGroupSingle(1));
    AIAttackWaveSetGatherPoint(lv_aI, PointFromId(1069));
    Wait(60.0, c_timeGame);
    AIAttackWaveAddUnits4(2, 2, 2, 3, "MengskMedic");
    AIAttackWaveAddUnits4(0, 0, 1, 2, "MengskFirebat");
    AIAttackWaveAddUnits4(6, 6, 7, 8, "MengskMarine");
    AIAttackWaveSend(lv_aI, 180, true);
    AIAttackWaveAddUnits4(2, 2, 3, 4, "MengskFirebat");
    AIAttackWaveAddUnits4(4, 4, 5, 6, "Reaper");
    AIAttackWaveAddUnits4(1, 1, 2, 2, "MengskMarauder");
    AIAttackWaveAddUnits4(2, 2, 2, 3, "MengskMedic");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Raven");
    AIAttackWaveSend(lv_aI, 180, true);
    AIAttackWaveAddUnits4(8, 8, 9, 10, "MengskMarine");
    AIAttackWaveAddUnits4(2, 2, 3, 4, "Ghost");
    AIAttackWaveAddUnits4(2, 2, 2, 3, "MengskMedic");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Raven");
    AIAttackWaveSend(lv_aI, 180, true);
    AIAttackWaveAddUnits4(2, 2, 3, 4, "MengskHellion");
    AIAttackWaveAddUnits4(4, 4, 5, 6, "MengskMarine");
    AIAttackWaveAddUnits4(3, 3, 4, 6, "MengskFirebat");
    AIAttackWaveAddUnits4(2, 2, 3, 4, "MengskMedic");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Raven");
    AIAttackWaveSend(lv_aI, 180, true);
    AIAttackWaveAddUnits4(4, 4, 5, 6, "MengskMarauder");
    AIAttackWaveAddUnits4(4, 4, 5, 6, "Reaper");
    AIAttackWaveAddUnits4(2, 2, 3, 4, "MengskMedic");
    AIAttackWaveAddUnits4(4, 4, 5, 6, "Ghost");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Raven");
    AIAttackWaveSend(lv_aI, 180, true);
    AIAttackWaveAddUnits4(2, 2, 3, 4, "MengskHellion");
    AIAttackWaveAddUnits4(6, 6, 8, 10, "MengskMarine");
    AIAttackWaveAddUnits4(3, 3, 4, 6, "MengskFirebat");
    AIAttackWaveAddUnits4(2, 2, 3, 4, "MengskMedic");
    AIAttackWaveAddUnits4(0, 0, 0, 1, "TitanMechAssault");
    AIAttackWaveSend(lv_aI, 180, true);
    while (true) {
        Wait(1.0, c_timeGame);
        AIAttackWaveAddUnits4(2, 2, 3, 4, "MengskHellion");
        AIAttackWaveAddUnits4(6, 6, 7, 8, "MengskMarine");
        AIAttackWaveAddUnits4(7, 7, 8, 10, "MengskFirebat");
        AIAttackWaveAddUnits4(2, 2, 3, 4, "MengskMedic");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Raven");
        AIAttackWaveSend(lv_aI, 180, true);
        AIAttackWaveAddUnits4(2, 2, 3, 4, "Cyclone");
        AIAttackWaveAddUnits4(6, 6, 7, 8, "MengskMarine");
        AIAttackWaveAddUnits4(7, 7, 8, 10, "MengskFirebat");
        AIAttackWaveAddUnits4(2, 2, 3, 4, "MengskMedic");
        AIAttackWaveAddUnits4(1, 1, 2, 3, "Raven");
        AIAttackWaveSend(lv_aI, 180, true);
        AIAttackWaveAddUnits4(4, 4, 5, 6, "MengskMarauder");
        AIAttackWaveAddUnits4(6, 6, 7, 8, "Reaper");
        AIAttackWaveAddUnits4(2, 2, 3, 4, "MengskMedic");
        AIAttackWaveAddUnits4(6, 6, 8, 10, "Ghost");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Raven");
        AIAttackWaveSend(lv_aI, 180, true);
        AIAttackWaveAddUnits4(2, 2, 3, 4, "MengskHellion");
        AIAttackWaveAddUnits4(6, 6, 8, 10, "MengskMarine");
        AIAttackWaveAddUnits4(3, 3, 4, 6, "MengskFirebat");
        AIAttackWaveAddUnits4(2, 2, 3, 4, "MengskMedic");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "TitanMechAssault");
        AIAttackWaveSend(lv_aI, 180, true);
    }
    return true;
}

