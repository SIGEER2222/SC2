//--------------------------------------------------------------------------------------------------
// Trigger: Send Air Base Kill Team 1
//--------------------------------------------------------------------------------------------------
bool gt_SendAirBaseKillTeam1_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_attackerCount;

    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((gv_gameOver == false))) {
            return false;
        }

        if (!((gv_inCinematic == false))) {
            return false;
        }

        if (!((TriggerGetExecCount(TriggerGetCurrent()) == 0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gf_DropKillTeamViaHercules(libNtve_gf_DifficultyValueInt(4, 4, 5, 6), "Reaper", libNtve_gf_DifficultyValueInt(1, 1, 2, 2), "MengskHellion", PointFromId(1555), PointFromId(1075));
    gf_DropKillTeamViaHercules(libNtve_gf_DifficultyValueInt(2, 2, 2, 3), "MengskMarauder", libNtve_gf_DifficultyValueInt(1, 1, 1, 2), "WarHound", PointFromId(1555), PointFromId(1075));
    gf_DropKillTeamViaHercules(libNtve_gf_DifficultyValueInt(7, 7, 8, 10), "MengskMarine", 0, null, PointFromId(1555), PointFromId(1075));
    if ((gv_killTeamsSent >= 3)) {
        gf_DropKillTeamViaHercules(libNtve_gf_DifficultyValueInt(2, 2, 2, 3), "Cyclone", libNtve_gf_DifficultyValueInt(2, 2, 3, 4), "MengskFirebat", PointFromId(1555), PointFromId(1075));
        gf_DropKillTeamViaHercules(libNtve_gf_DifficultyValueInt(3, 3, 4, 5), "Reaper", libNtve_gf_DifficultyValueInt(2, 2, 3, 4), "MengskHellion", PointFromId(1557), PointFromId(1558));
    }

    if ((gv_killTeamsSent >= 6)) {
        gf_DropKillTeamViaHercules(libNtve_gf_DifficultyValueInt(2, 2, 2, 3), "Cyclone", libNtve_gf_DifficultyValueInt(2, 2, 3, 4), "MengskFirebat", PointFromId(1555), PointFromId(1075));
        gf_DropKillTeamViaHercules(libNtve_gf_DifficultyValueInt(2, 2, 2, 3), "MengskFirebat", libNtve_gf_DifficultyValueInt(2, 2, 3, 4), "MengskMedic", PointFromId(1555), PointFromId(1075));
    }

    if ((GameGetMissionTime() >= 1200.0)) {
        libNtve_gf_UnitCreateFacingPoint(libNtve_gf_DifficultyValueInt(2, 2, 3, 4), "Wraith", 0, gv_p08_DOMINION, PointFromId(1555), PointFromId(1553));
        UnitGroupIssueOrder(UnitLastCreatedGroup(), OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(UnitFromId(808))), c_orderQueueAddToEnd);
    }

    gf_WaitForDropsAndAttack(UnitGetPosition(UnitFromId(808)));
    if ((RandomInt(0, 1) == 0)) {
        UnitCreate(libNtve_gf_DifficultyValueInt(1, 1, 1, 2), "ScienceVessel", 0, gv_p08_DOMINION, PointFromId(1076), 270.0);
    }
    else {
        UnitCreate(libNtve_gf_DifficultyValueInt(1, 1, 1, 2), "ScienceVessel", 0, gv_p08_DOMINION, PointFromId(1076), 270.0);
    }
    UnitSetPropertyFixed(UnitLastCreated(), c_unitPropEnergyPercent, 100.0);
    AIAttackWaveSetGatherPoint(gv_p08_DOMINION, UnitGetPosition(UnitFromId(808)));
    AIAttackWaveSetTargetRegion(gv_p08_DOMINION, RegionCircle(UnitGetPosition(UnitFromId(808)), 10.0), 0);
    AIAttackWaveAddWaypoint(gv_p08_DOMINION, PointFromId(1414), false);
    AIAttackWaveAddWaypoint(gv_p08_DOMINION, PointFromId(1413), false);
    AIAttackWaveAddWaypoint(gv_p08_DOMINION, PointFromId(1415), false);
    AIAttackWaveUseUnit(gv_p08_DOMINION, UnitLastCreated());
    AIAttackWaveSend(gv_p08_DOMINION, 0, false);
    gv_killTeamsSent += 1;
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_SendAirBaseKillTeam1_Init () {
    gt_SendAirBaseKillTeam1 = TriggerCreate("gt_SendAirBaseKillTeam1_Func");
}

