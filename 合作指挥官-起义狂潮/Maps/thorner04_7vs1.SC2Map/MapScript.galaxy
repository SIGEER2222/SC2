//--------------------------------------------------------------------------------------------------
// Trigger: Disable Right Red Bullies
//--------------------------------------------------------------------------------------------------
bool gt_DisableRightRedBullies_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitIsAlive(UnitFromId(149)) == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    AIToggleBulliesInRegion(gv_p02_DOMINION_INFANTRY, RegionFromId(71), false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_DisableRightRedBullies_Init () {
    gt_DisableRightRedBullies = TriggerCreate("gt_DisableRightRedBullies_Func");
    TriggerAddEventTimePeriodic(gt_DisableRightRedBullies, 30.0, c_timeGame);
