//--------------------------------------------------------------------------------------------------
// Trigger: Superweapon Init
//--------------------------------------------------------------------------------------------------
bool gt_SuperweaponInit_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TimerStart(gv_killTeamTimer, libNtve_gf_DifficultyValueFixed(2000.0, 2000.0, 1800.0, 1680.0), false, c_timeGame);
    TimerWindowSetAnchor(TimerWindowLastCreated(), c_anchorTopRight, 0, 0);
    gv_killTeamTimerWindow = TimerWindowLastCreated();
    Wait(180.0, c_timeGame);
    RegionAddRegion(gv_cerberusSpawnRegions, RegionFromId(53));
    RegionAddRegion(gv_cerberusSpawnRegions, RegionFromId(54));
    if ((gv_zergDisabled == false)) {
        TriggerExecute(gt_CerberusDrop, true, false);
        TimerStart(gv_zergTimer, libNtve_gf_DifficultyValueFixed(300.0, 300.0, 270.0, 240.0), true, c_timeGame);
        TimerWindowSetAnchor(TimerWindowLastCreated(), c_anchorTopRight, 0, 10);
        gv_zergTimerWindow = TimerWindowLastCreated();
    }
    else {
        UnitKill(UnitFromId(1255911208));
        TriggerEnable(gt_CerberusDrop, false);
    }
    Wait(180.0, c_timeGame);
    RegionAddRegion(gv_ghostSpawnRegions, RegionFromId(56));
    RegionAddRegion(gv_ghostSpawnRegions, RegionFromId(57));
    RegionAddRegion(gv_ghostSpawnRegions, RegionFromId(58));
    RegionAddRegion(gv_ghostSpawnRegions, RegionFromId(59));
    RegionAddRegion(gv_ghostSpawnRegions, RegionFromId(60));
    RegionAddRegion(gv_ghostSpawnRegions, RegionFromId(61));
    if ((gv_nukesDisabled == false)) {
        TriggerExecute(gt_NuclearArsenal, true, false);
        TimerStart(gv_nukeTimer, libNtve_gf_DifficultyValueFixed(360.0, 360.0, 330.0, 300.0), true, c_timeGame);
        TimerWindowSetAnchor(TimerWindowLastCreated(), c_anchorTopRight, 0, 20);
        gv_nukeTimerWindow = TimerWindowLastCreated();
    }
    else {
        UnitKill(UnitFromId(587346314));
        TriggerEnable(gt_NuclearArsenal, false);
    }
    Wait(180.0, c_timeGame);
    if ((gv_fleetDisabled == false)) {
        gv_fleetWarpRegions[0] = RegionFromId(48);
        gv_fleetWarpRegions[1] = RegionFromId(49);
        gv_fleetWarpRegions[2] = RegionFromId(50);
        gv_fleetWarpRegions[3] = RegionFromId(51);
        TriggerExecute(gt_FleetHarass, true, false);
        TimerStart(gv_fleetTimer, libNtve_gf_DifficultyValueFixed(300.0, 300.0, 300.0, 270.0), true, c_timeGame);
        TimerWindowSetAnchor(TimerWindowLastCreated(), c_anchorTopRight, 0, 30);
        gv_fleetTimerWindow = TimerWindowLastCreated();
    }
    else {
        UnitKill(UnitFromId(1371595777));
        TriggerEnable(gt_FleetHarass, false);
    }
    return true;
}

