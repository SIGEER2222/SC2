//--------------------------------------------------------------------------------------------------
// Trigger: Send Raider Base Kill Team 2
//--------------------------------------------------------------------------------------------------
bool gt_SendRaiderBaseKillTeam2_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_attackerCount;

    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((gv_gameOver == false))) {
            return false;
        }

        if (!((gv_inCinematic == false))) {
            return false;
        }

        if (!((TriggerGetExecCount(TriggerGetCurrent()) == 0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_UnitCreateFacingPoint(libNtve_gf_DifficultyValueInt(3, 3, 4, 6), "VikingFighter", 0, gv_p08_DOMINION, PointFromId(1565), PointFromId(1553));
    UnitGroupIssueOrder(UnitLastCreatedGroup(), OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(1553)), c_orderQueueReplace);
    UnitGroupIssueOrder(UnitLastCreatedGroup(), Order(AbilityCommand("AssaultMode", 0)), c_orderQueueAddToEnd);
    UnitGroupIssueOrder(UnitLastCreatedGroup(), OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(UnitFromId(807))), c_orderQueueAddToEnd);
    libNtve_gf_UnitCreateFacingPoint(libNtve_gf_DifficultyValueInt(8, 8, 9, 10), "Wraith", 0, gv_p08_DOMINION, PointFromId(1565), PointFromId(1553));
    UnitGroupIssueOrder(UnitLastCreatedGroup(), OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(UnitFromId(807))), c_orderQueueAddToEnd);
    if ((gv_killTeamsSent >= 3)) {
        libNtve_gf_UnitCreateFacingPoint(libNtve_gf_DifficultyValueInt(4, 4, 5, 6), "Banshee", 0, gv_p08_DOMINION, PointFromId(572), PointFromId(1553));
        UnitGroupIssueOrder(UnitLastCreatedGroup(), OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(UnitFromId(807))), c_orderQueueAddToEnd);
        gf_DropKillTeamViaHercules(libNtve_gf_DifficultyValueInt(2, 2, 3, 3), "MengskMarauder", libNtve_gf_DifficultyValueInt(1, 1, 2, 2), "MengskFirebat", PointFromId(1567), PointFromId(1568));
    }

    if ((gv_killTeamsSent >= 6)) {
        gf_DropKillTeamViaHercules(libNtve_gf_DifficultyValueInt(2, 2, 3, 3), "MengskMedic", libNtve_gf_DifficultyValueInt(1, 1, 2, 2), "Ghost", PointFromId(1567), PointFromId(1568));
    }

    if ((GameGetMissionTime() >= 1200.0)) {
        libNtve_gf_UnitCreateFacingPoint(libNtve_gf_DifficultyValueInt(2, 2, 3, 4), "MengskVikingFighter", 0, gv_p08_DOMINION, PointFromId(572), PointFromId(1552));
        UnitGroupIssueOrder(UnitLastCreatedGroup(), OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(UnitFromId(807))), c_orderQueueAddToEnd);
        libNtve_gf_UnitCreateFacingPoint(libNtve_gf_DifficultyValueInt(2, 2, 3, 3), "Wraith", 0, gv_p08_DOMINION, PointFromId(1566), PointFromId(1552));
        UnitGroupIssueOrder(UnitLastCreatedGroup(), OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(UnitFromId(807))), c_orderQueueAddToEnd);
    }

    gf_WaitForDropsAndAttack(UnitGetPosition(UnitFromId(807)));
    UnitCreate(libNtve_gf_DifficultyValueInt(1, 1, 1, 2), "ScienceVessel", 0, gv_p08_DOMINION, libNtve_gf_RandomPointBetweenPoints(PointFromId(572), PointFromId(591)), 270.0);
    UnitSetPropertyFixed(UnitLastCreated(), c_unitPropEnergyPercent, 100.0);
    AIAttackWaveSetGatherPoint(gv_p08_DOMINION, UnitGetPosition(UnitFromId(807)));
    AIAttackWaveSetTargetRegion(gv_p08_DOMINION, RegionCircle(UnitGetPosition(UnitFromId(807)), 10.0), 0);
    AIAttackWaveAddWaypoint(gv_p08_DOMINION, PointFromId(1419), false);
    AIAttackWaveAddWaypoint(gv_p08_DOMINION, PointFromId(1516), false);
    AIAttackWaveAddWaypoint(gv_p08_DOMINION, PointFromId(1517), false);
    AIAttackWaveUseUnit(gv_p08_DOMINION, UnitLastCreated());
    AIAttackWaveSend(gv_p08_DOMINION, 0, false);
    gv_killTeamsSent += 1;
    return true;
}

