bool gt_FleetHarass_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unitgroup lv_jumpTargets;

    // Automatic Variable Declarations
    unitgroup auto24DA3453_g;
    int auto24DA3453_u;
    unit auto24DA3453_var;
    int auto1CB1F58F_n;
    int auto1CB1F58F_i;

    // Variable Initialization
    lv_jumpTargets = UnitGroupEmpty();

    // Actions
    if (!runActions) {
        return true;
    }

    auto24DA3453_g = UnitGroup(null, gv_p01_USER, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    auto24DA3453_u = UnitGroupCount(auto24DA3453_g, c_unitCountAll);
    for (;; auto24DA3453_u -= 1) {
        auto24DA3453_var = UnitGroupUnitFromEnd(auto24DA3453_g, auto24DA3453_u);
        if (auto24DA3453_var == null) { break; }
        UnitGroupAdd(lv_jumpTargets, auto24DA3453_var);
    }
    auto1CB1F58F_n = gv_fleetIntensity;
    for (auto1CB1F58F_i = 1; auto1CB1F58F_i <= auto1CB1F58F_n; auto1CB1F58F_i += 1) {
        libNtve_gf_UnitCreateFacingPoint(1, "Battlecruiser", 0, gv_p13_FLEET, RegionRandomPoint(RegionFromId(47)), PlayerStartLocation(1));
        UnitIssueOrder(UnitLastCreated(), OrderTargetingPoint(AbilityCommand("Hyperjump", 0), UnitGetPosition(UnitGroupRandomUnit(lv_jumpTargets, c_unitCountAlive))), c_orderQueueReplace);
        AISetUnitScriptControlled(UnitLastCreated(), false);
        AISetUnitSuicide(UnitLastCreated(), true);
