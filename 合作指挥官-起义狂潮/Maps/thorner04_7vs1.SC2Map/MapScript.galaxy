//--------------------------------------------------------------------------------------------------
// Trigger: Kill Team Timer Expire
//--------------------------------------------------------------------------------------------------
bool gt_KillTeamTimerExpire_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TimerWindowDestroy(gv_killTeamTimerWindow);
    RegionAddRegion(gv_killTeamSpawnRegions, RegionFromId(58));
    TriggerQueueEnter();
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
    libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("THorner04Warfield00036", 0), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    TriggerQueueExit();
    gf_SpawnKillTeam(gv_p14_KILLTEAMS, RegionRandomPoint(gv_killTeamSpawnRegions));
    Wait(180.0, c_timeGame);
    gf_SpawnKillTeam(gv_p14_KILLTEAMS, RegionRandomPoint(gv_killTeamSpawnRegions));
    Wait(180.0, c_timeGame);
    gv_killTeamIntensity += 1;
    gf_SpawnKillTeam(gv_p14_KILLTEAMS, RegionRandomPoint(gv_killTeamSpawnRegions));
    Wait(180.0, c_timeGame);
    gf_SpawnKillTeam(gv_p14_KILLTEAMS, RegionRandomPoint(gv_killTeamSpawnRegions));
    Wait(180.0, c_timeGame);
    gf_SpawnKillTeam(gv_p14_KILLTEAMS, RegionRandomPoint(gv_killTeamSpawnRegions));
    gf_SpawnKillTeam(gv_p14_KILLTEAMS, RegionRandomPoint(gv_killTeamSpawnRegions));
    Wait(180.0, c_timeGame);
    gv_killTeamIntensity += 1;
    gf_SpawnKillTeam(gv_p14_KILLTEAMS, RegionRandomPoint(gv_killTeamSpawnRegions));
    gf_SpawnKillTeam(gv_p14_KILLTEAMS, RegionRandomPoint(gv_killTeamSpawnRegions));
    while (true) {
        Wait(180.0, c_timeGame);
        gf_SpawnKillTeam(gv_p14_KILLTEAMS, RegionRandomPoint(gv_killTeamSpawnRegions));
        gf_SpawnKillTeam(gv_p14_KILLTEAMS, RegionRandomPoint(gv_killTeamSpawnRegions));
    }
    return true;
}

