//--------------------------------------------------------------------------------------------------
// Trigger: Nuclear Arsenal
//--------------------------------------------------------------------------------------------------
bool gt_NuclearArsenal_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    int auto4775E86F_n;
    int auto4775E86F_i;
    unitgroup auto521DA17E_g;
    int auto521DA17E_u;
    unit auto521DA17E_var;

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerExecute(gt_NukeRepeatTransmission, true, false);
    gv_availableTargets = UnitGroupAlliance(gv_p12_NUKINGGHOSTS, c_unitAllianceEnemy, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterUser1) | (1 << c_targetFilterMissile), (1 << (c_targetFilterStasis - 32)) | (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32)) | (1 << (c_targetFilterSummoned - 32))), 0);
    auto4775E86F_n = gv_nukeIntensity;
    for (auto4775E86F_i = 1; auto4775E86F_i <= auto4775E86F_n; auto4775E86F_i += 1) {
        auto521DA17E_g = gv_availableTargets;
        auto521DA17E_u = UnitGroupCount(auto521DA17E_g, c_unitCountAll);
        for (;; auto521DA17E_u -= 1) {
            auto521DA17E_var = UnitGroupUnitFromEnd(auto521DA17E_g, auto521DA17E_u);
            if (auto521DA17E_var == null) { break; }
            if (((UnitGetPropertyInt(auto521DA17E_var, c_unitPropLife, c_unitPropCurrent) <= 200))) {
                UnitGroupRemove(gv_availableTargets, auto521DA17E_var);
            }

        }
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "Ghost", 0, gv_p12_NUKINGGHOSTS, RegionRandomPoint(gv_ghostSpawnRegions));
        gf_MakeGhostNuke(UnitLastCreated());
        Wait((10.0 / gv_nukeIntensity), c_timeAI);
    }
    return true;
}

