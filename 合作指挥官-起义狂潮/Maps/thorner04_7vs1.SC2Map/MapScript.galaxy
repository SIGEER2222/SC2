bool auto_gf_MakeGhostNuke_TriggerFunc (bool testConds, bool runActions) {
    unit lp_ghost = auto_gf_MakeGhostNuke_lp_ghost;

    // Variable Declarations
    unit lv_ghost;
    unitgroup lv_silos;
    unitgroup lv_closestTargets;
