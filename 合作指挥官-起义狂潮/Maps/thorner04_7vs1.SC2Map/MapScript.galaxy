    int autoF9367F6F_val;

    // Variable Initialization
    lv_silos = UnitGroupEmpty();
    lv_closestTargets = UnitGroupEmpty();
    lv_availableTargetsLocal = UnitGroupEmpty();

    // Implementation
    lv_ghost = lp_ghost;
    UnitSetPropertyFixed(lv_ghost, c_unitPropEnergyPercent, 100.0);
    UnitAbilityEnable(lv_ghost, "EMP", false);
    UnitAbilityEnable(lv_ghost, "Snipe", false);
    AISetUnitScriptControlled(lv_ghost, true);
    UnitGroupAddUnitGroup(lv_silos, UnitGroup("GhostAcademy", gv_p12_NUKINGGHOSTS, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0));
    auto4AC51629_g = lv_silos;
    auto4AC51629_u = UnitGroupCount(auto4AC51629_g, c_unitCountAll);
    for (;; auto4AC51629_u -= 1) {
        auto4AC51629_var = UnitGroupUnitFromEnd(auto4AC51629_g, auto4AC51629_u);
        if (auto4AC51629_var == null) { break; }
        UnitMagazineArm(auto4AC51629_var, AbilityCommand("ArmSiloWithNuke", 0), 1);
    }
    Wait(4.0, c_timeGame);
    UnitIssueOrder(lv_ghost, Order(AbilityCommand("GhostCloak", 0)), c_orderQueueReplace);
    autoF9367F6F_val = RandomInt(0, 1);
    if (autoF9367F6F_val == 0) {
        lv_nukeUnit = UnitGroupClosestToPoint(gv_availableTargets, UnitGetPosition(lv_ghost));
        UnitGroupRemove(gv_availableTargets, lv_nukeUnit);
        UnitIssueOrder(lv_ghost, OrderTargetingPoint(AbilityCommand("TacNukeStrike", 0), RegionRandomPoint(RegionCircle(UnitGetPosition(lv_nukeUnit), 1.0))), c_orderQueueReplace);
    }
    else if (autoF9367F6F_val == 1) {
        lv_nukeUnit = UnitGroupRandomUnit(gv_availableTargets, c_unitCountAlive);
        UnitGroupRemove(gv_availableTargets, lv_nukeUnit);
        UnitIssueOrder(lv_ghost, OrderTargetingPoint(AbilityCommand("TacNukeStrike", 0), RegionRandomPoint(RegionCircle(UnitGetPosition(lv_nukeUnit), 1.0))), c_orderQueueReplace);
    }
    else {
    }
    UnitIssueOrder(lv_ghost, OrderTargetingPoint(AbilityCommand("TacNukeStrike", 0), RegionRandomPoint(RegionCircle(UnitGetPosition(UnitGroupClosestToPoint(gv_availableTargets, UnitGetPosition(lv_ghost))), 1.0))), c_orderQueueReplace);
    Wait(1.0, c_timeGame);
    while (!(((UnitIsAlive(lv_ghost) == false) || (UnitOrderHasAbil(lv_ghost, "TacNukeStrike") == false)))) {
        Wait(0.5, c_timeGame);
    }
    UnitIssueOrder(lv_ghost, Order(AbilityCommand("TacNukeStrike", 1)), c_orderQueueReplace);
    UnitIssueOrder(lv_ghost, Order(AbilityCommand("GhostCloak", 1)), c_orderQueueReplace);
    AISetUnitScriptControlled(lv_ghost, false);
    AISetUnitSuicide(lv_ghost, true);
    return true;
}

trigger auto_gf_DropNuke_Trigger = null;
point auto_gf_DropNuke_lp_cHOSEN_POINT;

void gf_DropNuke (point lp_cHOSEN_POINT) {
    auto_gf_DropNuke_lp_cHOSEN_POINT = lp_cHOSEN_POINT;

    if (auto_gf_DropNuke_Trigger == null) {
        auto_gf_DropNuke_Trigger = TriggerCreate("auto_gf_DropNuke_TriggerFunc");
    }

    TriggerExecute(auto_gf_DropNuke_Trigger, false, false);
}

bool auto_gf_DropNuke_TriggerFunc (bool testConds, bool runActions) {
    point lp_cHOSEN_POINT = auto_gf_DropNuke_lp_cHOSEN_POINT;

    // Variable Declarations
    actor lv_dropEffect;
    sound lv_nukeSound;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    libNtve_gf_CreateModelAtPoint("GhostNukeIndicator", lp_cHOSEN_POINT);
    lv_dropEffect = libNtve_gf_ActorLastCreated();
    libNtve_gf_CreatePingFacingAngle(PlayerGroupAll(), "PingWarning", lp_cHOSEN_POINT, ColorWithAlpha(100.00, 0.00, 0.00, 0.00), 0.0, 270.0);
    PingSetTooltip(PingLastCreated(), StringExternal("Param/Value/27D40CB2"));
    SoundChannelSetVolume(PlayerGroupAll(), c_soundCategoryCombat, 20.0, 0.0);
    SoundPlay(SoundLink("Alert_TerranCalldownLaunch", -1), PlayerGroupAll(), 100.0, 0.0);
    SoundWait(SoundLastPlayed(), 0.0, c_soundOffsetEnd);
    SoundChannelSetVolume(PlayerGroupAll(), c_soundCategoryCombat, 100.0, 0.0);
    SoundPlay(SoundLink("Ghost_NukeSeek", -1), PlayerGroupAll(), 100.0, 0.0);
    lv_nukeSound = SoundLastPlayed();
    Wait(12.5, c_timeAI);
    libNtve_gf_KillModel(lv_dropEffect);
    PingDestroy(PingLastCreated());
    Wait(0.5, c_timeAI);
    SoundStop(lv_nukeSound, true);
    return true;
}

