    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    lv_chosenUnit = gv_pickedUnit;
    TextTagCreate(StringExternal("Param/Value/B35796C7"), 30, UnitGetPosition(lv_chosenUnit), 1.0, true, false, PlayerGroupAll());
