//--------------------------------------------------------------------------------------------------
bool lib48DF4533_gt_AIResearch2_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unitgroup lv_researchstructures;

    // Automatic Variable Declarations
    unitgroup auto09AA66D5_g;
    int auto09AA66D5_u;
    unit auto09AA66D5_var;

    // Variable Initialization
    lv_researchstructures = UnitGroupEmpty();

    // Actions
    if (!runActions) {
        return true;
    }

    lv_researchstructures = libNtve_gf_UnitsInRegionWithAllianceToPlayerMatchingCondition("EngineeringBay", "Armory", "EvolutionChamber", 1, c_unitAllianceAlly, null, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    UnitGroupAddUnitGroup(lv_researchstructures, libNtve_gf_UnitsInRegionWithAllianceToPlayerMatchingCondition("Spire", "CyberneticsCore", "Forge", 1, c_unitAllianceAlly, null, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    auto09AA66D5_g = lv_researchstructures;
    auto09AA66D5_u = UnitGroupCount(auto09AA66D5_g, c_unitCountAll);
    for (;; auto09AA66D5_u -= 1) {
        auto09AA66D5_var = UnitGroupUnitFromEnd(auto09AA66D5_g, auto09AA66D5_u);
        if (auto09AA66D5_var == null) { break; }
        if (((PlayerType(UnitGetOwner(auto09AA66D5_var)) == c_playerTypeComputer) || (TechTreeUpgradeCount(UnitGetOwner(auto09AA66D5_var), "AutoAutoResearch", c_techCountCompleteOnly) == 1))) {
            UnitBehaviorAdd(auto09AA66D5_var, "AutoUpgrade", auto09AA66D5_var, 1);
        }

    }
    return true;
}

