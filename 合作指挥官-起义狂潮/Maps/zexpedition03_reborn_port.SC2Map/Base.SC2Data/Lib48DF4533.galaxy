//--------------------------------------------------------------------------------------------------
// Trigger: Change Difficulty
//--------------------------------------------------------------------------------------------------
bool lib48DF4533_gt_ChangeDifficulty_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    string autoDD1D2F36_val;

    // Actions
    if (!runActions) {
        return true;
    }

    BankLoad("cryswarmcoop", EventPlayer());
    PlayerSetDifficulty(1, 1);
    PlayerSetDifficulty(14, 1);
    PlayerSetDifficulty(1, 2);
    PlayerSetDifficulty(14, 2);
    PlayerSetDifficulty(1, 3);
    PlayerSetDifficulty(14, 3);
    PlayerSetDifficulty(1, 4);
    PlayerSetDifficulty(14, 4);
    PlayerSetDifficulty(1, 4);
    PlayerSetDifficulty(14, 4);
    autoDD1D2F36_val = EventChatMessage(false);
    if (autoDD1D2F36_val == "-casual") {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/lib_48DF4533_5D46FF7E"));
        BankValueSetFromInt(BankLastCreated(), "Settings", "Difficulty", 1);
        BankSave(BankLastCreated());
        Wait(3.0, c_timeGame);
        RestartGame(PlayerGroupAll());
    }
    else if (autoDD1D2F36_val == "-normal") {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/lib_48DF4533_A5433A6A"));
        BankValueSetFromInt(BankLastCreated(), "Settings", "Difficulty", 2);
        BankSave(BankLastCreated());
        Wait(3.0, c_timeGame);
        RestartGame(PlayerGroupAll());
    }
    else if (autoDD1D2F36_val == "-hard") {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/lib_48DF4533_78D41A33"));
        BankValueSetFromInt(BankLastCreated(), "Settings", "Difficulty", 3);
        BankSave(BankLastCreated());
        Wait(3.0, c_timeGame);
        RestartGame(PlayerGroupAll());
    }
    else if (autoDD1D2F36_val == "-brutal") {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/lib_48DF4533_19723B8D"));
        BankValueSetFromInt(BankLastCreated(), "Settings", "Difficulty", 4);
        BankSave(BankLastCreated());
        Wait(3.0, c_timeGame);
        RestartGame(PlayerGroupAll());
    }
    else if (autoDD1D2F36_val == "-ruthless") {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/lib_48DF4533_7BC1763B"));
        BankValueSetFromInt(BankLastCreated(), "Settings", "Difficulty", 5);
        BankSave(BankLastCreated());
        Wait(3.0, c_timeGame);
        RestartGame(PlayerGroupAll());
    }
    else {
    }
    return true;
}

