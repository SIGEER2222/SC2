//--------------------------------------------------------------------------------------------------
// Trigger: Mengsk Training
//--------------------------------------------------------------------------------------------------
bool lib48DF4533_gt_MengskTraining_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((TechTreeUpgradeCount(EventPlayer(), "Mengsk", c_techCountCompleteOnly) == 1))) {
            return false;
        }

        if (!((UnitHasBehavior2(EventUnit(), "GarrisonAI") == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitBehaviorAdd(EventUnitProgressUnit(), "DogsofWarTraits", EventUnitProgressUnit(), 1);
    UnitGroupAdd(lib48DF4533_gv_dogsofwar, EventUnitProgressUnit());
    return true;
}

