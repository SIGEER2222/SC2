bool lib48DF4533_gt_SetMineralFieldValue_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unitgroup lv_mineralfields;

    // Automatic Variable Declarations
    unitgroup autoC79A53E7_g;
    int autoC79A53E7_u;
    unit autoC79A53E7_var;

    // Variable Initialization
    lv_mineralfields = UnitGroupEmpty();

    // Actions
    if (!runActions) {
        return true;
    }

    lv_mineralfields = UnitGroup("BattleStationMineralField", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    UnitGroupAddUnitGroup(lv_mineralfields, UnitGroup("MineralField", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    UnitGroupAddUnitGroup(lv_mineralfields, UnitGroup("MineralFieldOpaque", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    UnitGroupAddUnitGroup(lv_mineralfields, UnitGroup("PurifierMineralField", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    UnitGroupAddUnitGroup(lv_mineralfields, UnitGroup("RichMineralField", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    UnitGroupAddUnitGroup(lv_mineralfields, UnitGroup("UmojanLabMineralField", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    autoC79A53E7_g = lv_mineralfields;
    autoC79A53E7_u = UnitGroupCount(autoC79A53E7_g, c_unitCountAll);
    for (;; autoC79A53E7_u -= 1) {
        autoC79A53E7_var = UnitGroupUnitFromEnd(autoC79A53E7_g, autoC79A53E7_u);
        if (autoC79A53E7_var == null) { break; }
        UnitSetPropertyFixed(autoC79A53E7_var, c_unitPropResources, StringToInt(StringWord(EventChatMessage(false), 2)));
    }
    return true;
}

