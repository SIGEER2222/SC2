//--------------------------------------------------------------------------------------------------
// Trigger: Ally Resources
//--------------------------------------------------------------------------------------------------
bool lib48DF4533_gt_AllyResources_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    playergroup autoD38E7D4C_g;
    int autoD38E7D4C_var;

    // Actions
    if (!runActions) {
        return true;
    }

    autoD38E7D4C_g = PlayerGroupAlliance(c_playerGroupAlly, 1);
    autoD38E7D4C_var = -1;
    while (true) {
        autoD38E7D4C_var = PlayerGroupNextPlayer(autoD38E7D4C_g, autoD38E7D4C_var);
        if (autoD38E7D4C_var < 0) { break; }
        PlayerModifyPropertyInt(autoD38E7D4C_var, c_playerPropMinerals, c_playerPropOperAdd, 5000);
        PlayerModifyPropertyInt(autoD38E7D4C_var, c_playerPropVespene, c_playerPropOperAdd, 5000);
        PlayerModifyPropertyInt(autoD38E7D4C_var, c_playerPropSuppliesMade, c_playerPropOperAdd, 200);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void lib48DF4533_gt_AllyResources_Init () {
    lib48DF4533_gt_AllyResources = TriggerCreate("lib48DF4533_gt_AllyResources_Func");
    TriggerAddEventChatMessage(lib48DF4533_gt_AllyResources, c_playerAny, "-ar", true);
}

