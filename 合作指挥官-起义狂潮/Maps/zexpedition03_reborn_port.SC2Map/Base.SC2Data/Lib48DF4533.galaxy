bool lib48DF4533_gt_KerriganLevels_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    playergroup auto723858C2_g;
    int auto723858C2_var;

    // Actions
    if (!runActions) {
        return true;
    }

    while (true) {
        auto723858C2_g = lib48DF4533_gv_coop_group;
        auto723858C2_var = -1;
        while (true) {
            auto723858C2_var = PlayerGroupNextPlayer(auto723858C2_g, auto723858C2_var);
            if (auto723858C2_var < 0) { break; }
            if ((TechTreeUpgradeCount(auto723858C2_var, "Kerrigan", c_techCountCompleteOnly) == 1)) {
                lib48DF4533_gf_SetHeroPanelUnit(1, lib48DF4533_gf_FindKerrigan(auto723858C2_var));
                lib48DF4533_gf_ZS_ApplyKerriganModelUpgrades(auto723858C2_var);
                lib48DF4533_gf_SetKerriganLevel(lib48DF4533_gf_FindKerrigan(auto723858C2_var), lib48DF4533_gf_CalculateKerriganLevel(auto723858C2_var));
            }

        }
        Wait(3.0, c_timeGame);
    }
    return true;
}

