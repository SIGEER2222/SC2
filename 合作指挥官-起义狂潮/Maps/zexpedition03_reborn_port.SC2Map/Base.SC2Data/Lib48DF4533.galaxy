//--------------------------------------------------------------------------------------------------
bool lib48DF4533_gt_DisableAutoDrones_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    string autoCE25D731_val;

    // Conditions
    if (testConds) {
        if (!(((libNtve_gf_TriggeringProgressUnitType() == "Drone") || (libNtve_gf_TriggeringProgressUnitType() == "SCV") || (libNtve_gf_TriggeringProgressUnitType() == "Probe")))) {
            return false;
        }

        if (!((UnitCurrentWorkerCount(EventUnit()) >= (UnitIdealWorkerCount(EventUnit()) - 1)))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    autoCE25D731_val = UnitGetType(EventUnit());
    if (autoCE25D731_val == "Hatchery") {
        UnitIssueOrder(EventUnit(), OrderSetAutoCast(AbilityCommand("TrainQueen", 3), false), c_orderQueueReplace);
    }
    else if (autoCE25D731_val == "Lair") {
        UnitIssueOrder(EventUnit(), OrderSetAutoCast(AbilityCommand("TrainQueen", 3), false), c_orderQueueReplace);
    }
    else if (autoCE25D731_val == "Hive") {
        UnitIssueOrder(EventUnit(), OrderSetAutoCast(AbilityCommand("TrainQueen", 3), false), c_orderQueueReplace);
    }
    else if (autoCE25D731_val == "PrimalTownHall") {
        UnitIssueOrder(EventUnit(), OrderSetAutoCast(AbilityCommand("PrimalTrain", 4), false), c_orderQueueReplace);
    }
    else if (autoCE25D731_val == "Nexus") {
        UnitIssueOrder(EventUnit(), OrderSetAutoCast(AbilityCommand("NexusTrain", 0), false), c_orderQueueReplace);
    }
    else if (autoCE25D731_val == "CommandCenter") {
        UnitIssueOrder(EventUnit(), OrderSetAutoCast(AbilityCommand("CommandCenterTrain", 0), false), c_orderQueueReplace);
    }
    else if (autoCE25D731_val == "OrbitalCommand") {
        UnitIssueOrder(EventUnit(), OrderSetAutoCast(AbilityCommand("CommandCenterTrain", 0), false), c_orderQueueReplace);
    }
    else if (autoCE25D731_val == "PlanetaryFortress") {
        UnitIssueOrder(EventUnit(), OrderSetAutoCast(AbilityCommand("CommandCenterTrain", 0), false), c_orderQueueReplace);
    }
    else {
    }
    return true;
}

