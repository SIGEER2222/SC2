//--------------------------------------------------------------------------------------------------
// Trigger: Commanders
//--------------------------------------------------------------------------------------------------
bool lib48DF4533_gt_Commanders_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_iconx;
    int lv_icony;
    int lv_namex;
    int lv_namey;
    int lv_infox;
    int lv_infoy;
    int lv_xoffset;
    int lv_yoffset;
    playergroup lv_thisguy;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_icony = 200;
    lv_namex = 180;
    lv_namey = 150;
    lv_infox = 100;
    lv_infoy = 200;
    lv_xoffset = 500;
    lv_yoffset = 150;
    lv_thisguy = PlayerGroupEmpty();

    // Conditions
    if (testConds) {
        if (!((EventDialogControl() == lib48DF4533_gv_commandersButton))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    BankLoad("cryswarmcoop", EventPlayer());
    lv_thisguy = PlayerGroupSingle(EventPlayer());
    DialogControlSetVisible(lib48DF4533_gv_mutationsPanel, lv_thisguy, false);
    DialogControlSetVisible(lib48DF4533_gv_evolutionsPanel, lv_thisguy, false);
    DialogControlSetVisible(lib48DF4533_gv_unityPanel, lv_thisguy, false);
    DialogControlSetVisible(lib48DF4533_gv_settingsPanel, lv_thisguy, false);
    DialogControlSetVisible(lib48DF4533_gv_mapsPanel, lv_thisguy, false);
    DialogControlSetVisible(lib48DF4533_gv_commandersPanel, lv_thisguy, false);
    libNtve_gf_SetDialogItemToggled(lib48DF4533_gv_unityButton, false, lv_thisguy);
    libNtve_gf_SetDialogItemToggled(lib48DF4533_gv_commandersButton, true, lv_thisguy);
    libNtve_gf_SetDialogItemToggled(lib48DF4533_gv_mutationsButton, false, lv_thisguy);
    libNtve_gf_SetDialogItemToggled(lib48DF4533_gv_evolutionsButton, false, lv_thisguy);
    libNtve_gf_SetDialogItemToggled(lib48DF4533_gv_settingsButton, false, lv_thisguy);
