//--------------------------------------------------------------------------------------------------
// Trigger: CCM Button
//--------------------------------------------------------------------------------------------------
bool lib48DF4533_gt_CCMButton_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!(((libSwaC_gf_CurrentMap() == "ZStoryChar") || (libSwaC_gf_CurrentMap() == "ZStorySpace") || (libSwaC_gf_CurrentMap() == "ZStoryExpedition") || (libSwaC_gf_CurrentMap() == "ZStoryKorhal") || (libSwaC_gf_CurrentMap() == "ZStoryHybrid") || (libSwaC_gf_CurrentMap() == "ZStoryZerus")))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((lib48DF4533_gv_cCMButtonDialog == c_invalidDialogId)) {
        DialogCreate(250, 100, c_anchorBottom, 0, 200, true);
        DialogSetImageVisible(DialogLastCreated(), false);
        lib48DF4533_gv_cCMButtonDialog = DialogLastCreated();
        libNtve_gf_CreateDialogItemButton(lib48DF4533_gv_cCMButtonDialog, 250, 100, c_anchorCenter, 0, 0, StringToText(""), StringExternal("Param/Value/lib_48DF4533_AD27CAAD"), "");
        libNtve_gf_SetDialogItemBorderVisible(DialogControlLastCreated(), false, PlayerGroupAll());
        lib48DF4533_gv_openUIButton = DialogControlLastCreated();
    }

    if (((lib281DEC45_gf_CurrentStoryActivity() == lib281DEC45_ge_StoryActivities_ViewingRoom) && (lib281DEC45_gf_CurrentRoom() == lib281DEC45_ge_Rooms_StoryRoomMainSet))) {
        DialogSetVisible(lib48DF4533_gv_cCMButtonDialog, PlayerGroupAll(), true);
    }
    else {
        DialogSetVisible(lib48DF4533_gv_cCMButtonDialog, PlayerGroupAll(), false);
    }
    return true;
}

