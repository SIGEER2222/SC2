//--------------------------------------------------------------------------------------------------
// Trigger: Open UI
//--------------------------------------------------------------------------------------------------
bool lib48DF4533_gt_OpenUI_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((EventDialogControl() == lib48DF4533_gv_openUIButton))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lib48DF4533_gf_ZSS_StopStoryActivity(lib281DEC45_gf_CurrentStoryActivity());
    SoundChannelMute(PlayerGroupAll(), c_soundCategorySAmbient, true);
    TriggerExecute(lib48DF4533_gt_UICreation, true, false);
    DialogSetVisible(lib48DF4533_gv_cCMButtonDialog, PlayerGroupAll(), false);
    return true;
}

