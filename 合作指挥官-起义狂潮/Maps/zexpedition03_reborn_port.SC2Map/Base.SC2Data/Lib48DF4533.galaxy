            return false;
        }

        if (!((EventUnitDamageDeathCheck(c_deathTypeRemove) == false))) {
            return false;
        }

        if (!((libSwaC_gf_CurrentMap() != "ZSpace2"))) {
            return false;
        }

        if (!((libSwaC_gf_CurrentMap() != "ZZerus3"))) {
            return false;
        }

        if (!((libSwaC_gf_CurrentMap() != "ZLab2"))) {
            return false;
