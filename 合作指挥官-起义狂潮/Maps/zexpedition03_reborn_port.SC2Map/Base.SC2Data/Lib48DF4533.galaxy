//--------------------------------------------------------------------------------------------------
// Trigger: Mengsk Production
//--------------------------------------------------------------------------------------------------
bool lib48DF4533_gt_MengskProduction_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((TechTreeUpgradeCount(UnitGetOwner(EventUnitCreatedUnit()), "Mengsk", c_techCountCompleteOnly) == 1))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitHasBehavior2(EventUnitCreatedUnit(), "MengskVeterancy") == true)) {
        UnitGroupAdd(lib48DF4533_gv_royalguard, EventUnitCreatedUnit());
    }

    if (((UnitGetType(EventUnitCreatedUnit()) == "SpawnedZergling") || (UnitGetType(EventUnitCreatedUnit()) == "SpawnedBaneling") || (UnitGetType(EventUnitCreatedUnit()) == "SpawnedRoach") || (UnitGetType(EventUnitCreatedUnit()) == "SpawnedHydralisk") || (UnitGetType(EventUnitCreatedUnit()) == "SpawnedMutalisk") || (UnitGetType(EventUnitCreatedUnit()) == "SpawnedUltralisk") || (UnitGetType(EventUnitCreatedUnit()) == "Overseer"))) {
        UnitBehaviorAdd(EventUnitCreatedUnit(), "DogsofWarTraits", EventUnitCreatedUnit(), 1);
        UnitGroupAdd(lib48DF4533_gv_dogsofwar, EventUnitCreatedUnit());
    }

    return true;
}

