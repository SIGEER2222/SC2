//--------------------------------------------------------------------------------------------------
bool lib48DF4533_gt_AllyDepots_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup autoA37DB308_g;
    int autoA37DB308_u;
    unit autoA37DB308_var;

    // Actions
    if (!runActions) {
        return true;
    }

    while (true) {
        autoA37DB308_g = UnitGroup("SupplyDepot", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        autoA37DB308_u = UnitGroupCount(autoA37DB308_g, c_unitCountAll);
        for (;; autoA37DB308_u -= 1) {
            autoA37DB308_var = UnitGroupUnitFromEnd(autoA37DB308_g, autoA37DB308_u);
            if (autoA37DB308_var == null) { break; }
            if ((PlayerType(UnitGetOwner(autoA37DB308_var)) == c_playerTypeComputer)) {
                UnitIssueOrder(autoA37DB308_var, Order(AbilityCommand("SupplyDepotLower", 0)), c_orderQueueReplace);
            }

        }
        Wait(5.0, c_timeGame);
    }
    return true;
}

