void lib48DF4533_gt_ChangeDifficulty_Init () {
    lib48DF4533_gt_ChangeDifficulty = TriggerCreate("lib48DF4533_gt_ChangeDifficulty_Func");
    TriggerAddEventChatMessage(lib48DF4533_gt_ChangeDifficulty, c_playerAny, "-casual", true);
    TriggerAddEventChatMessage(lib48DF4533_gt_ChangeDifficulty, c_playerAny, "-normal", true);
    TriggerAddEventChatMessage(lib48DF4533_gt_ChangeDifficulty, c_playerAny, "-hard", true);
    TriggerAddEventChatMessage(lib48DF4533_gt_ChangeDifficulty, c_playerAny, "-brutal", true);
    TriggerAddEventChatMessage(lib48DF4533_gt_ChangeDifficulty, c_playerAny, "-ruthless", true);
}

