//--------------------------------------------------------------------------------------------------
bool lib48DF4533_gt_ReturnAllyResources_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    playergroup auto4E74CC4D_g;
    int auto4E74CC4D_var;

    // Actions
    if (!runActions) {
        return true;
    }

    auto4E74CC4D_g = PlayerGroupAlliance(c_playerGroupAlly, 1);
    auto4E74CC4D_var = -1;
    while (true) {
        auto4E74CC4D_var = PlayerGroupNextPlayer(auto4E74CC4D_g, auto4E74CC4D_var);
        if (auto4E74CC4D_var < 0) { break; }
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, ((PlayerName(auto4E74CC4D_var) + StringExternal("Param/Value/lib_48DF4533_EB092261")) + IntToText(PlayerGetPropertyInt(auto4E74CC4D_var, c_playerPropMinerals)) + StringExternal("Param/Value/lib_48DF4533_BA5D6AEE") + IntToText(PlayerGetPropertyInt(auto4E74CC4D_var, c_playerPropVespene))));
    }
    return true;
}

