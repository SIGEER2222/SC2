//--------------------------------------------------------------------------------------------------
// Trigger: Reconstitution
//--------------------------------------------------------------------------------------------------
bool lib48DF4533_gt_Reconstitution_Func (bool testConds, bool runActions) {
    // Variable Declarations
    string lv_behavior;

    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((TechTreeUpgradeCount(EventPlayer(), "K5Reconstitution", c_techCountCompleteOnly) == 1))) {
            return false;
        }

        if (!((EventUnitDamageDeathCheck(c_deathTypeRemove) == false))) {
            return false;
        }

        if (!((UnitHasBehavior2(EventUnit(), "WarpingInDummy") == false))) {
            return false;
        }

        if (!(((UnitGetType(EventUnit()) == "Zergling") || (UnitGetType(EventUnit()) == "HotSSwarmling") || (UnitGetType(EventUnit()) == "Pygalisk") || (UnitGetType(EventUnit()) == "ZerglingToxic") || (UnitGetType(EventUnit()) == "HotSRaptor") || (UnitGetType(EventUnit()) == "PrimalZergling2") || (UnitGetType(EventUnit()) == "TempleGuard") || (UnitGetType(EventUnit()) == "Zealot") || (UnitGetType(EventUnit()) == "ZealotAiur") || (UnitGetType(EventUnit()) == "Brute") || (UnitGetType(EventUnit()) == "Anchorite") || (UnitGetType(EventUnit()) == "ZealotShakuras") || (UnitGetType(EventUnit()) == "InfestedCivilian") || (UnitGetType(EventUnit()) == "InfestedCultist") || (UnitGetType(EventUnit()) == "Marine") || (UnitGetType(EventUnit()) == "WarPig") || (UnitGetType(EventUnit()) == "CauldronBorn") || (UnitGetType(EventUnit()) == "Spartan")))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitRevive(EventUnit());
    UnitBehaviorAdd(EventUnit(), "Reviving", EventUnit(), 1);
    UnitBehaviorSetDuration(EventUnit(), "Reviving", UnitTypeGetCost(UnitGetType(EventUnit()), c_unitCostMinerals));
    Wait(1.0, c_timeGame);
    UnitSetPosition(EventUnit(), lib48DF4533_gf_ReconstitutionTarget(UnitGetOwner(EventUnit())), true);
    return true;
}

//--------------------------------------------------------------------------------------------------
void lib48DF4533_gt_Reconstitution_Init () {
    lib48DF4533_gt_Reconstitution = TriggerCreate("lib48DF4533_gt_Reconstitution_Func");
    TriggerEnable(lib48DF4533_gt_Reconstitution, false);
    TriggerAddEventUnitDied(lib48DF4533_gt_Reconstitution, null);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Recycle
//--------------------------------------------------------------------------------------------------
bool lib48DF4533_gt_Recycle_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((TechTreeUpgradeCount(EventPlayer(), "K5Recycle", c_techCountCompleteOnly) == 1))) {
            return false;
        }

        if (!((UnitHasBehavior2(EventUnit(), "WarpingInDummy") == false))) {
            return false;
        }

        if (!(((UnitGetType(EventUnit()) == "Zergling") || (UnitGetType(EventUnit()) == "HotSSwarmling") || (UnitGetType(EventUnit()) == "Pygalisk") || (UnitGetType(EventUnit()) == "ZerglingToxic") || (UnitGetType(EventUnit()) == "HotSRaptor") || (UnitGetType(EventUnit()) == "PrimalZergling2") || (UnitGetType(EventUnit()) == "TempleGuard") || (UnitGetType(EventUnit()) == "Zealot") || (UnitGetType(EventUnit()) == "ZealotAiur") || (UnitGetType(EventUnit()) == "Anchorite") || (UnitGetType(EventUnit()) == "Brute") || (UnitGetType(EventUnit()) == "ZealotShakuras") || (UnitGetType(EventUnit()) == "InfestedCivilian") || (UnitGetType(EventUnit()) == "InfestedCultist") || (UnitGetType(EventUnit()) == "Marine") || (UnitGetType(EventUnit()) == "WarPig") || (UnitGetType(EventUnit()) == "CauldronBorn") || (UnitGetType(EventUnit()) == "Spartan")))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    PlayerModifyPropertyInt(EventPlayer(), c_playerPropMinerals, c_playerPropOperAdd, (UnitTypeGetCost(UnitGetType(EventUnit()), c_unitCostMinerals) / 5));
    PlayerModifyPropertyInt(EventPlayer(), c_playerPropVespene, c_playerPropOperAdd, (UnitTypeGetCost(UnitGetType(EventUnit()), c_unitCostVespene) / 5));
    return true;
}

