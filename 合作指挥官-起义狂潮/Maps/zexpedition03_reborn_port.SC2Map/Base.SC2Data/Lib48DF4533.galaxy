    }

    lv_randint = RandomInt(0, 100);
    if ((((PlayerRace(EventPlayer()) != "Zerg") && (lv_randint <= 33)) || ((PlayerRace(EventPlayer()) == "Zerg") && (lv_randint <= 10)))) {
        UnitRevive(EventUnit());
        UnitBehaviorAdd(EventUnit(), "PermanentSuppressFoodUsed", EventUnit(), 1);
        UnitBehaviorAdd(EventUnit(), "NPSwarm", EventUnit(), 1);
        UnitBehaviorAdd(EventUnit(), "RavagingInfestation", EventUnit(), 1);
        UnitSetOwner(EventUnit(), libNtve_gf_KillingPlayer(), false);
    }

    return true;
}

