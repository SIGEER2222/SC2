//--------------------------------------------------------------------------------------------------
// Trigger: Dehaka Viper Experience
//--------------------------------------------------------------------------------------------------
bool lib48DF4533_gt_DehakaViperExperience_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((TechTreeUpgradeCount(EventPlayer(), "Dehaka", c_techCountCompleteOnly) == 1))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) == "Viper"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitXPGetCurrentLevel(EventUnit(), null) < 5)) {
        UnitXPAddXP(EventUnit(), null, EventUnitSpentVitalAmount());
    }

    return true;
}

