//--------------------------------------------------------------------------------------------------
bool lib48DF4533_gt_NydusWorms_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnitCreatedUnit()) == "GreaterNydusWorm"))) {
            return false;
        }

        if (!(((UnitGetOwner(EventUnit()) == 1) || (UnitGetOwner(EventUnit()) == 14)))) {
            return false;
        }

        if (!((PlayerType(14) == c_playerTypeUser))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    PlayerCreateEffectUnit(1, "NydusSelfDummy", EventUnitCreatedUnit());
    if ((UnitGetOwner(EventUnitCreatedUnit()) == 1)) {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "GreaterNydusWorm", c_unitCreateIgnorePlacement | c_unitCreateIgnoreBirth, 14, UnitGetPosition(EventUnitCreatedUnit()));
        UnitBehaviorAdd(EventUnitCreatedUnit(), "AllyWormConjoined", EventUnitCreatedUnit(), 1);
        UnitBehaviorAdd(UnitLastCreated(), "AllyWormConjoined", UnitLastCreated(), 1);
    }
    else {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "GreaterNydusWorm", c_unitCreateIgnorePlacement | c_unitCreateIgnoreBirth, 1, UnitGetPosition(EventUnitCreatedUnit()));
        UnitBehaviorAdd(EventUnitCreatedUnit(), "AllyWormConjoined", EventUnitCreatedUnit(), 1);
        UnitBehaviorAdd(UnitLastCreated(), "AllyWormConjoined", UnitLastCreated(), 1);
    }
    PlayerCreateEffectUnit(UnitGetOwner(UnitLastCreated()), "NydusAllyDummy", UnitLastCreated());
    return true;
}

