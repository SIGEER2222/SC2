    // Variable Declarations
    int lv_allyPlayer;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    if ((EventPlayer() == 1)) {
        lv_allyPlayer = 14;
    }
    else {
        lv_allyPlayer = 1;
    }
    CameraPan(EventPlayer(), CameraGetTarget(lv_allyPlayer), 0.0, -1, 10.0, false);
    return true;
}

