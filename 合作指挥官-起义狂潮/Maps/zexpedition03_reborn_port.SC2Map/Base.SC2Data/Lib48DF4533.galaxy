//--------------------------------------------------------------------------------------------------
// Trigger: License Check
//--------------------------------------------------------------------------------------------------
bool lib48DF4533_gt_LicenseCheck_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    playergroup autoF4EADDBD_g;
    int autoF4EADDBD_var;

    // Actions
    if (!runActions) {
        return true;
    }

    autoF4EADDBD_g = lib48DF4533_gv_coop_group;
    autoF4EADDBD_var = -1;
    while (true) {
        autoF4EADDBD_var = PlayerGroupNextPlayer(autoF4EADDBD_g, autoF4EADDBD_var);
        if (autoF4EADDBD_var < 0) { break; }
        if ((GameIsOnline() == true)) {
            if ((PlayerHasLicense(autoF4EADDBD_var, 259) == false)) {
                UIDisplayMessage(PlayerGroupSingle(autoF4EADDBD_var), c_messageAreaChat, StringExternal("Param/Value/lib_48DF4533_49058EA4"));
                Wait(10.0, c_timeGame);
                KickFromGame(PlayerGroupSingle(autoF4EADDBD_var));
            }

        }

    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void lib48DF4533_gt_LicenseCheck_Init () {
    lib48DF4533_gt_LicenseCheck = TriggerCreate("lib48DF4533_gt_LicenseCheck_Func");
    TriggerAddEventMapInit(lib48DF4533_gt_LicenseCheck);
}

