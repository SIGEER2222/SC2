//--------------------------------------------------------------------------------------------------
// Trigger: Auto Group Rally
//--------------------------------------------------------------------------------------------------
bool lib48DF4533_gt_AutoGroupRally_Func (bool testConds, bool runActions) {
    // Variable Declarations
    playergroup lv_thisguy;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_thisguy = PlayerGroupEmpty();

    // Conditions
    if (testConds) {
        if (!((EventDialogControl() == lib48DF4533_gv_autoGroupRally))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_thisguy = PlayerGroupSingle(EventPlayer());
    BankLoad("cryswarmcoop", EventPlayer());
    BankValueSetFromInt(BankLastCreated(), "Settings", "Auto Group Rally", DialogControlGetSelectedItem(EventDialogControl(), EventPlayer()));
    BankSave(BankLastCreated());
    DialogControlSelectItem(lib48DF4533_gv_autoGroupRally, lv_thisguy, BankValueGetAsInt(BankLastCreated(), "Settings", "Auto Group Rally"));
    return true;
}

