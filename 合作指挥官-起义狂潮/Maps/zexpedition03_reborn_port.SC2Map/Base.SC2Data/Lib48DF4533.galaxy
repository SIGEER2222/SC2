        if (!((UnitTypeTestFlag(UnitGetType(EventUnitProgressUnit()), c_unitFlagUncommandable) == false))) {
            return false;
        }

        if (!((UnitTypeTestAttribute(UnitGetType(EventUnitProgressUnit()), c_unitAttributeStructure) == false))) {
            return false;
        }

        if (!((UnitGetType(EventUnitProgressUnit()) != "Overlord"))) {
            return false;
        }

        if (!((UnitRallyPointTargetUnit(EventUnit(), 1, 1) != null))) {
            return false;
        }

        if (!((UnitTypeTestAttribute(UnitGetType(UnitRallyPointTargetUnit(EventUnit(), 1, 1)), c_unitAttributeStructure) == false))) {
            return false;
        }

        if (!((TechTreeUpgradeCount(UnitGetOwner(EventUnitProgressUnit()), "GroupRally", c_techCountCompleteOnly) == 1))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_CopyUnitControlGroups(UnitRallyPointTargetUnit(EventUnit(), 1, 1), EventUnitProgressUnit());
    return true;
}

