//--------------------------------------------------------------------------------------------------
// Trigger: Dehaka Experience Damage
//--------------------------------------------------------------------------------------------------
bool lib48DF4533_gt_DehakaExperienceDamage_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_dyingunit;
    unit lv_sourceunit;
    unitgroup lv_validhosts;
    fixed lv_xp;
    unitgroup lv_veteranunits;
    int lv_veterancount;
    fixed lv_xpradius;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_dyingunit = EventUnit();
    lv_sourceunit = EventUnitDamageSourceUnit();
    lv_validhosts = UnitGroupEmpty();
    lv_xp = EventUnitDamageAmount();
    lv_veteranunits = UnitGroupEmpty();
    lv_xpradius = 15.0;

    // Conditions
    if (testConds) {
        if (!((TechTreeUpgradeCount(EventUnitDamageSourcePlayer(), "Dehaka", c_techCountCompleteOnly) == 1))) {
            return false;
        }

        if (!((UnitFilterMatch(EventUnit(), 1, UnitFilter(0, 0, (1 << c_targetFilterPlayer) | (1 << c_targetFilterAlly) | (1 << c_targetFilterNeutral) | (1 << c_targetFilterRawResource) | (1 << c_targetFilterHarvestableResource) | (1 << c_targetFilterMissile) | (1 << c_targetFilterDestructible) | (1 << c_targetFilterItem) | (1 << c_targetFilterUncommandable), (1 << (c_targetFilterHallucination - 32)))) == true))) {
            return false;
        }

        if (!((libNtve_gf_KillingPlayer() != c_playerAny))) {
            return false;
        }

        if (!((EventUnitDamageDeathCheck(c_deathTypeRemove) == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitHasBehavior2(EventUnitDamageSourceUnit(), "PrimalHostTimedLife") == true)) {
        lv_sourceunit = UnitBehaviorEffectUnit(EventUnitDamageSourceUnit(), "PrimalHostTimedLife", c_effectUnitCaster, 0);
    }

    if ((UnitXPGetCurrentLevel(lv_sourceunit, null) < 5)) {
        UnitXPAddXP(lv_sourceunit, null, lv_xp);
    }

    return true;
}

