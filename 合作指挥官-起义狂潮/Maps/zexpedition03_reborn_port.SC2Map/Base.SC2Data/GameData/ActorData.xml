<?xml version="1.0" encoding="utf-8"?>
<Catalog>
    <!--                                                                                         -->
    <!-- Expedition Protoss Frozen Solid                                            -->
    <!--                                                                                         -->
    <CActorSimple id="FrozenSolidTinter">
        <On Terms="Behavior.DeadlyChill1.On" Send="Create"/>
        <On Terms="Behavior.DeadlyChill1.On" Target="_Unit" Send="SetTintColor 150,150,255 0.250000 OneShot FrozenSolidTint"/>
        <On Terms="Behavior.DeadlyChill1.Off" Target="_Unit" Send="ClearTintColor 0.250000 FrozenSolidTint"/>
        <On Terms="Behavior.DeadlyChill1.Off" Send="Destroy"/>
        <On Terms="Behavior.DeadlyChill2.On" Send="Create"/>
        <On Terms="Behavior.DeadlyChill2.On" Target="_Unit" Send="SetTintColor 150,150,255 0.250000 OneShot FrozenSolidTint"/>
        <On Terms="Behavior.DeadlyChill2.Off" Target="_Unit" Send="ClearTintColor 0.250000 FrozenSolidTint"/>
        <On Terms="Behavior.DeadlyChill2.Off" Send="Destroy"/>
        <On Terms="Behavior.DeadlyChill3.On" Send="Create"/>
        <On Terms="Behavior.DeadlyChill3.On" Target="_Unit" Send="SetTintColor 150,150,255 0.250000 OneShot FrozenSolidTint"/>
        <On Terms="Behavior.DeadlyChill3.Off" Target="_Unit" Send="ClearTintColor 0.250000 FrozenSolidTint"/>
        <On Terms="Behavior.DeadlyChill3.Off" Send="Destroy"/>
    </CActorSimple>
</Catalog>
