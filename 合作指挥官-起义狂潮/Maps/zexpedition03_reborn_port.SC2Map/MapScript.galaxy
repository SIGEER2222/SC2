//--------------------------------------------------------------------------------------------------
// Trigger: Start Game Q
//--------------------------------------------------------------------------------------------------
bool gt_StartGameQ_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    if ((TechTreeUnitIsAllowed(1, "Hydralisk") == true)) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, StringExternal("Param/Value/B3C23233"));
    }

    TimerStart(gv_timercountdown, 1500.0, false, c_timeGame);
    libSwaC_gf_TimerWindowCreate2(TimerLastStarted(), StringExternal("Param/Value/2A692555"), true, false, libSwaC_ge_CampaignTimerPositiveNegativeOptions_Positive);
    gv_timerwindow = TimerWindowLastCreated();
    libSwaC_gf_DisplayArmyButton(false);
    TriggerExecute(gt_StartAI, true, false);
    TriggerEnable(gt_KhalaiOutpostAlly, true);
    TriggerEnable(gt_DaelaamOutpostAlly, true);
    TriggerEnable(gt_ShakurasOutpostAlly, true);
    TriggerEnable(gt_DefeatBaseDead, true);
    TriggerEnable(gt_IzshaReclamationWaves, true);
    TriggerExecute(gt_TaldarimMinorWaves, true, false);
    TriggerExecute(gt_TaldarimNormalWaves, true, false);
    TriggerExecute(gt_TaldarimCanOpeners, true, false);
    ObjectiveCreate(StringExternal("Param/Value/A3E7554E"), StringExternal("Param/Value/891B1F04"), c_objectiveStateActive, true);
    DataTableSetObjective(true, "Kaldir3Survive", ObjectiveLastCreated());
    Wait(15.0, c_timeGame);
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("EvolutionMasterPortrait"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "", "Talk", null, StringExternal("Param/Value/F1E76E05"), StringExternal("Param/Value/C08B1DFE"), 7.0, c_transmissionDurationSet, false, c_maxPlayers, false);
    ObjectiveCreate(StringExternal("Param/Value/D31C246C"), StringExternal("Param/Value/82AF7DF0"), c_objectiveStateActive, false);
    DataTableSetObjective(true, "Kaldir3North", ObjectiveLastCreated());
    MinimapPing(PlayerGroupAll(), PointFromId(1247128437), 30.0, Color(100.00, 100.00, 0.00));
    ObjectiveCreate(StringExternal("Param/Value/08CE7B54"), StringExternal("Param/Value/37BF0782"), c_objectiveStateActive, false);
    DataTableSetObjective(true, "Kaldir3South", ObjectiveLastCreated());
    MinimapPing(PlayerGroupAll(), PointFromId(1324377658), 30.0, Color(100.00, 100.00, 0.00));
    Wait(38.0, c_timeGame);
    if ((lib48DF4533_gf_SetAllHatcheriesRallyPoints2() == true)) {
        TriggerEnable(gt_RaiderRuthlessShuttles, true);
        TriggerEnable(gt_RaiderShuttleWarpCommands, true);
        TriggerEnable(gt_RaiderWarps, true);
    }

    TriggerExecute(gt_RaynorYap, true, false);
    Wait(180.0, c_timeGame);
    TriggerExecute(gt_LasarraYap, true, false);
    Wait(180.0, c_timeGame);
    TriggerExecute(gt_AlarakYap, true, false);
    Wait(180.0, c_timeGame);
    TriggerExecute(gt_SzayelYap, true, false);
    Wait(180.0, c_timeGame);
    TriggerExecute(gt_LasarraYap2, true, false);
    Wait(180.0, c_timeGame);
    TriggerExecute(gt_AlarakYap2, true, false);
    Wait(180.0, c_timeGame);
    TriggerExecute(gt_RaynorYap2, true, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_StartGameQ_Init () {
    gt_StartGameQ = TriggerCreate("gt_StartGameQ_Func");
}

