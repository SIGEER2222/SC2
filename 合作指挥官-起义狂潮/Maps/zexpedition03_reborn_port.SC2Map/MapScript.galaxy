//--------------------------------------------------------------------------------------------------
// Trigger: Izsha Reclamation Waves
//--------------------------------------------------------------------------------------------------
bool gt_IzshaReclamationWaves_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((TriggerIsEnabled(gt_KhalaiOutpostEnemy) == true)) {
        AIAttackWaveAddUnits4(4, 4, 4, 4, "Mutalisk");
        AIAttackWaveAddWaypoint(gv_izshasHost, PointFromId(770320552), false);
        AIAttackWaveAddWaypoint(gv_izshasHost, PointFromId(790964166), false);
        AIAttackWaveSend(gv_izshasHost, 0, false);
    }

    if ((TriggerIsEnabled(gt_DaelaamOutpostEnemy) == true)) {
        AIAttackWaveAddUnits4(4, 4, 4, 4, "Mutalisk");
        AIAttackWaveAddWaypoint(gv_izshasHost, PointFromId(1811562419), false);
        AIAttackWaveAddWaypoint(gv_izshasHost, PointFromId(1205742299), false);
        AIAttackWaveSend(gv_izshasHost, 0, false);
    }

    if ((TriggerIsEnabled(gt_ShakurasOutpostEnemy) == true)) {
        AIAttackWaveAddUnits4(4, 4, 4, 4, "Mutalisk");
        AIAttackWaveAddWaypoint(gv_izshasHost, PointFromId(67444513), false);
        AIAttackWaveAddWaypoint(gv_izshasHost, PointFromId(798315725), false);
        AIAttackWaveSend(gv_izshasHost, 0, false);
    }

    return true;
}

