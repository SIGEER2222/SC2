    if (!runActions) {
        return true;
    }

    CameraApplyInfo(1, CameraInfoFromId(1708183647), 0.0, -1, 10.0, true);
    TriggerExecute(gt_IntroMusic, true, false);
    if ((lib48DF4533_gf_SetAllHatcheriesRallyPoints4() == true)) {
        if ((lib48DF4533_gf_SetAllHatcheriesRallyPoints3("Kaldir 3 Intro") == true)) {
            TriggerSkippableBegin(PlayerGroupAll(), 0, null, true, false);
        }

    }
    else {
        TriggerSkippableBegin(PlayerGroupAll(), 0, null, true, false);
    }
    gv_cinematicCompleted = false;
    CinematicFade(true, 2.0, c_fadeStyleNormal, ColorWithAlpha(0.00, 0.00, 0.00, 0.00), 0.0, true);
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSource(), c_invalidPortraitId, "", "Talk", null, StringExternal("Param/Value/74419984"), StringExternal("Param/Value/68A9F351"), 5.0, c_transmissionDurationAdd, true, c_maxPlayers, false);
    for (autoBF593561_i = 1; autoBF593561_i <= autoBF593561_n; autoBF593561_i += 1) {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "Zealot", 0, gv_taldarimBerserkers, PointFromId(1679712375));
        libNtve_gf_ChangeUnitDamage(UnitLastCreated(), libNtve_ge_UnitDamageTakenDealt_Damage_Deal, libNtve_ge_UnitDamageChangeOption_No);
        libNtve_gf_ChangeUnitDamage(UnitLastCreated(), libNtve_ge_UnitDamageTakenDealt_Damage_Take, libNtve_ge_UnitDamageChangeOption_Minimal);
        AISetUnitSuicide(UnitLastCreated(), true);
        UnitIssueOrder(UnitLastCreated(), OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(790964166)), c_orderQueueReplace);
        UnitGroupAdd(gv_cinematicTempUnits, UnitLastCreated());
        Wait(0.1, c_timeGame);
    }
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSource(), c_invalidPortraitId, "", "Talk", null, StringExternal("Param/Value/030BC559"), StringExternal("Param/Value/2E7F94AB"), 7.0, c_transmissionDurationAdd, true, c_maxPlayers, false);
    CameraApplyInfo(1, CameraInfoFromId(854737579), 3.0, -1, 10.0, true);
    for (auto182AFD33_i = 1; auto182AFD33_i <= auto182AFD33_n; auto182AFD33_i += 1) {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "Slayer", 0, gv_taldarimBerserkers, PointFromId(1679712375));
        libNtve_gf_ChangeUnitDamage(UnitLastCreated(), libNtve_ge_UnitDamageTakenDealt_Damage_Deal, libNtve_ge_UnitDamageChangeOption_No);
        libNtve_gf_ChangeUnitDamage(UnitLastCreated(), libNtve_ge_UnitDamageTakenDealt_Damage_Take, libNtve_ge_UnitDamageChangeOption_Minimal);
        AISetUnitSuicide(UnitLastCreated(), true);
        UnitIssueOrder(UnitLastCreated(), OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(790964166)), c_orderQueueReplace);
        UnitGroupAdd(gv_cinematicTempUnits, UnitLastCreated());
        Wait(0.1, c_timeGame);
    }
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSource(), c_invalidPortraitId, "", "Talk", null, StringExternal("Param/Value/C5456C5A"), StringExternal("Param/Value/E0A693D3"), 7.0, c_transmissionDurationAdd, true, c_maxPlayers, false);
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSource(), c_invalidPortraitId, "", "Talk", null, StringExternal("Param/Value/F35A950D"), StringExternal("Param/Value/B7AA2292"), 5.0, c_transmissionDurationAdd, true, c_maxPlayers, false);
    CameraApplyInfo(1, CameraInfoFromId(1708183647), 3.0, -1, 10.0, true);
    Wait(3.0, c_timeGame);
    libNtve_gf_CreateModelAtPoint("LasarraWarpIn", UnitGetPosition(gv_introLasarra));
    gv_warpInActor = libNtve_gf_ActorLastCreated();
    ActorSend(gv_warpInActor, libNtve_gf_SetFacing(405.0));
    SoundPlay(SoundLink("Event_Exp3_LassaraWarpInStart", -1), PlayerGroupAll(), 100.0, 0.0);
    gv_introWarpSound1 = SoundLastPlayed();
    SoundPlay(SoundLink("Event_Exp3_LassaraWarpInFinish", -1), PlayerGroupAll(), 100.0, 0.0);
    gv_introWarpSound2 = SoundLastPlayed();
    Wait(2.0, c_timeGame);
    SoundPlay(SoundLink("Event_Exp3_LassaraWarpInFinish", -1), PlayerGroupAll(), 0.0, 0.0);
    gv_introWarpSound1 = SoundLastPlayed();
    libNtve_gf_KillModel(gv_warpInActor);
    libNtve_gf_ShowHideUnit(gv_introLasarra, true);
    gv_lasarraActor = libNtve_gf_MainActorofUnit(gv_introLasarra);
