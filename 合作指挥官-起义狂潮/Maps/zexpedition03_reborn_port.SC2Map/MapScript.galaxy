    AIToggleBulliesInRegion(gv_daelaamProtoss, RegionFromId(2), true);
    AIToggleBulliesInRegion(gv_theSwarm, RegionFromId(2), true);
    AIToggleBulliesInRegion(gv_izshasHost, RegionFromId(2), true);
    AIToggleBulliesInRegion(gv_theSwarm, RegionFromId(3), true);
