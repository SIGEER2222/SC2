//--------------------------------------------------------------------------------------------------
// Trigger: Taldarim Minor Waves
//--------------------------------------------------------------------------------------------------
bool gt_TaldarimMinorWaves_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_number;

    // Automatic Variable Declarations
    int auto166D35C8_val;

    // Variable Initialization
    lv_number = 1;

    // Actions
    if (!runActions) {
        return true;
    }

    while (true) {
        Wait(10.0, c_timeGame);
        if ((UnitGroupCount(UnitGroup(null, gv_taldarimBerserkers, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) < 200) && ((UnitGroupCount(UnitGroup(null, gv_player1, RegionFromId(10), UnitFilter((1 << c_targetFilterVisible), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))), 0), c_unitCountAlive) == 0) && (UnitGroupCount(UnitGroup(null, gv_karasssLegion, RegionFromId(10), UnitFilter((1 << c_targetFilterVisible), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))), 0), c_unitCountAlive) == 0))) {
            if ((GameGetMissionTime() < 300.0)) {
                libNtve_gf_CreateUnitsWithDefaultFacing(2, "Zealot", c_unitCreateIgnorePlacement, gv_taldarimBerserkers, RegionRandomPoint(RegionFromId(1)));
                AIAttackWaveUseGroup(gv_taldarimBerserkers, UnitLastCreatedGroup());
            }

            if ((GameGetMissionTime() < 600.0)) {
                libNtve_gf_CreateUnitsWithDefaultFacing(1, "Zealot", c_unitCreateIgnorePlacement, gv_taldarimBerserkers, RegionRandomPoint(RegionFromId(1)));
                AIAttackWaveUseGroup(gv_taldarimBerserkers, UnitLastCreatedGroup());
            }
            else {
                libNtve_gf_CreateUnitsWithDefaultFacing(1, "Brute", c_unitCreateIgnorePlacement, gv_taldarimBerserkers, RegionRandomPoint(RegionFromId(1)));
                AIAttackWaveUseGroup(gv_taldarimBerserkers, UnitLastCreatedGroup());
            }
            if ((GameGetMissionTime() >= libNtve_gf_DifficultyValueInt(1200, 1200, 1050, 900))) {
                libNtve_gf_CreateUnitsWithDefaultFacing(1, "Slayer", c_unitCreateIgnorePlacement, gv_taldarimBerserkers, RegionRandomPoint(RegionFromId(1)));
                AIAttackWaveUseGroup(gv_taldarimBerserkers, UnitLastCreatedGroup());
            }

            auto166D35C8_val = lv_number;
            if (auto166D35C8_val == 1) {
                AIAttackWaveAddWaypoint(gv_taldarimBerserkers, PointFromId(770320552), false);
            }
            else if (auto166D35C8_val == 2) {
                AIAttackWaveAddWaypoint(gv_taldarimBerserkers, PointFromId(1811562419), false);
            }
            else if (auto166D35C8_val == 3) {
                AIAttackWaveAddWaypoint(gv_taldarimBerserkers, PointFromId(67444513), false);
            }
            else {
            }
            AIAttackWaveSend(gv_taldarimBerserkers, 0, false);
            if (lv_number >= 3) {
                lv_number = 1;
            }
            else {
                lv_number = lv_number + 1;
            }
        }

    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_TaldarimMinorWaves_Init () {
    gt_TaldarimMinorWaves = TriggerCreate("gt_TaldarimMinorWaves_Func");
}

