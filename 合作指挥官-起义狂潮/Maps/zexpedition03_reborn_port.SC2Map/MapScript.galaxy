    if (!runActions) {
        return true;
    }

    lib48DF4533_gf_MissionClear("Convergence");
    gv_gameOver = true;
    gv_inCinematic = true;
    TriggerEnable(gt_DefeatBaseDead, false);
    TriggerStop(gt_DefeatBaseDead);
    Wait(2.0, c_timeReal);
    libSwaC_gf_RunMissionVictorySequence(gt_VictoryQ);
    return true;
}

