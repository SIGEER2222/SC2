//--------------------------------------------------------------------------------------------------
// Trigger: Tame Ursadons
//--------------------------------------------------------------------------------------------------
bool gt_TameUrsadons_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((EventUnit() == UnitFromId(1322199118))) {
        ObjectiveSetState(DataTableGetObjective(true, "Kaldir3South"), c_objectiveStateCompleted);
    }
    else {
        ObjectiveSetState(DataTableGetObjective(true, "Kaldir3North"), c_objectiveStateCompleted);
    }
    if ((ObjectiveGetState(DataTableGetObjective(true, "Kaldir3North")) == c_objectiveStateCompleted) && (ObjectiveGetState(DataTableGetObjective(true, "Kaldir3South")) == c_objectiveStateCompleted)) {
        TriggerEnable(TriggerGetCurrent(), false);
        lib48DF4533_gf_StoreBonusObjective("Kaldir 3");
        PlayerGroupAdd(gv_fren, gv_ursadons);
        libNtve_gf_SetPlayerGroupAlliance(gv_fren, libNtve_ge_AllianceSetting_AllyWithSharedVisionAndPushable);
        TriggerQueueEnter();
        if ((lib48DF4533_gf_SetAllHatcheriesRallyPoints4() == true)) {
            TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("UrsadonPortrait"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "", "Talk", null, StringExternal("Param/Value/1F5E8CC7"), StringExternal("Param/Value/AFEFFA5A"), 6.0, c_transmissionDurationAdd, true, c_maxPlayers, false);
            TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("KerriganPortrait2"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "", "Talk", null, StringExternal("Param/Value/8D7C08E0"), StringExternal("Param/Value/38BB7069"), 6.0, c_transmissionDurationAdd, true, c_maxPlayers, false);
            TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("UrsadonPortrait"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "", "Talk", null, StringExternal("Param/Value/A4BBDD3E"), StringExternal("Param/Value/90B26BFC"), 5.0, c_transmissionDurationAdd, true, c_maxPlayers, false);
            TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("EvolutionMasterPortrait"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "", "Talk", null, StringExternal("Param/Value/D22C7ED2"), StringExternal("Param/Value/D4EED367"), 6.0, c_transmissionDurationAdd, true, c_maxPlayers, false);
            TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("KerriganPortrait2"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "", "Talk", null, StringExternal("Param/Value/1A30D1B2"), StringExternal("Param/Value/1EE590C2"), 8.0, c_transmissionDurationAdd, true, c_maxPlayers, false);
            TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("UrsadonPortrait"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "", "Talk", null, StringExternal("Param/Value/3E26FE04"), StringExternal("Param/Value/C9C99A90"), 6.0, c_transmissionDurationAdd, true, c_maxPlayers, false);
            TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("KerriganPortrait2"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "", "Talk", null, StringExternal("Param/Value/E26B4521"), StringExternal("Param/Value/C3B0D3B5"), 7.0, c_transmissionDurationAdd, true, c_maxPlayers, false);
        }

        TriggerExecute(gt_UrsadonAttacks, true, false);
        TriggerQueueExit();
    }

    return true;
}

