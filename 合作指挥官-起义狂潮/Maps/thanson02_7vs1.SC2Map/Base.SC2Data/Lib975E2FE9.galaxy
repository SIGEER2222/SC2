    else if (auto6279551C_val == "PowerFieldHPRegenerationOn") {
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "PowerFieldEnergyRegeneration", 0);
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "PowerFieldHPRegeneration", 1);
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "PowerFieldMovementSpeed", 0);
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "MasteryStetmannStetzoneBonusesMovementSpeed", 0);
