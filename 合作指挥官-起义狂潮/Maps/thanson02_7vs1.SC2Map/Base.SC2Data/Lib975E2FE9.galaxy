    }
    else if (auto6279551C_val == "PowerFieldMovementSpeedOn") {
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "PowerFieldEnergyRegeneration", 0);
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "PowerFieldHPRegeneration", 0);
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "PowerFieldMovementSpeed", 1);
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "MasteryStetmannStetzoneBonusesMovementSpeed", lib975E2FE9_gv_powerField);
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "MasteryStetmannStetzoneBonusesHPRegeneration", 0);
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "MasteryStetmannStetzoneBonusesEnergyRegeneration", 0);
        lib67C0F0E7_gf_StetmannPanelControl(EventPlayer(), "Speed");
    }
    else {
    }
    return true;
}

