bool lib975E2FE9_gt_PowerField_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    string auto6279551C_val;

    // Actions
    if (!runActions) {
        return true;
    }

    auto6279551C_val = EventPlayerEffectUsed();
