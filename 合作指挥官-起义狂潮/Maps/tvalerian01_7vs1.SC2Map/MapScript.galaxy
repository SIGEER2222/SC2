        gf_SpawnCrashingDoodad(PointFromId(1218), "CharCrashingDebris");
    }

    Wait(1.0, c_timeGame);
    if ((gv_stopFallingDebrisAndStuctures == false)) {
        gf_SpawnCrashingDoodad(PointFromId(1218), "CharCrashingDebris");
    }

    Wait(1.0, c_timeGame);
    if ((gv_stopFallingDebrisAndStuctures == false)) {
        gf_SpawnCrashingDoodad(PointFromId(1218), "CharCrashingDebris");
    }

    Wait(1.0, c_timeGame);
    if ((gv_stopFallingDebrisAndStuctures == false)) {
        gf_SpawnCrashingDoodad(PointFromId(1218), "CharCrashingDebris");
    }

    return true;
}

