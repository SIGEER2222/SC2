        return false;
    }

    ai75F37259_wave1_run(p, target, true);
    ai75F37259_wave2_run(p, target, true);
    ai75F37259_wave3_run(p, target, true);
    ai75F37259_wave4_run(p, target, true);
    ai75F37259_wave5_run(p, target, true);
    ai75F37259_wave6_run(p, target, true);
    ai75F37259_wave7_run(p, target, true);
    ai75F37259_wave8_run(p, target, true);
    ai75F37259_wave9_run(p, target, true);
    ai75F37259_wave10_run(p, target, true);
    ai75F37259_wave11_run(p, target, true);

    while (true) {
        ai75F37259_wave9_run(p, target, true);
        ai75F37259_wave10_run(p, target, true);
        ai75F37259_wave11_run(p, target, true);
    }

    return true;
}

