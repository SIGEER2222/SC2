    }
    while ((gv_inCinematic == true) && (UnitIsAlive(lp_unit) == true) && (libNtve_gf_UnitIsHidden(lp_unit) == false) && (DistanceBetweenPoints(UnitGetPosition(lp_unit), lp_point) > 1.0)) {
