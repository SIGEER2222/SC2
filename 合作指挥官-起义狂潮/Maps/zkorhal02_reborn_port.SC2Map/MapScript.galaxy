//--------------------------------------------------------------------------------------------------
// Trigger: 10th Anniversary Achievement - Third Power Link destroyed before 18 minutes
//--------------------------------------------------------------------------------------------------
bool gt__10thAnniversaryAchievementThirdPowerLinkdestroyedbefore18minutes_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((libHots_gf_DifficultyValueInt2(0, 1, 1) == 1))) {
            return false;
        }

        if (!((GameGetMissionTime() <= 1080.0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gv_numberOfPowerLinksDestroyed += 1;
    if ((gv_numberOfPowerLinksDestroyed == 3)) {
        libSwaC_gf_CampaignAwardAchievement("Anniversary_ZKorhal02", gv_pLAYER_01_USER);
        TriggerEnable(TriggerGetCurrent(), false);
    }

    return true;
}

