//--------------------------------------------------------------------------------------------------
// Trigger: Yellow Dominion Waves
//--------------------------------------------------------------------------------------------------
bool gt_YellowDominionWaves_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_attackwave;

    // Automatic Variable Declarations
    int auto6757F55B_n;
    int auto6757F55B_i;
    int auto57CFB1AB_n;
    int auto57CFB1AB_i;
    int auto552E6823_n;
    int auto552E6823_i;
    int auto96E3FA69_n;
    int auto96E3FA69_i;
    int autoBA80E6EB_val;
    int auto4EE34263_n;
    int auto4EE34263_i;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    AIAttackWaveSetTargetPlayer(gv_pLAYER_03_DOMINION_YELLOW, gv_fren);
    while (true) {
        auto6757F55B_n = (10 + (lv_attackwave * 1));
        for (auto6757F55B_i = 1; auto6757F55B_i <= auto6757F55B_n; auto6757F55B_i += 1) {
            AIAttackWaveAddUnits4(1, 1, 1, 1, "Stormtrooper");
        }
        auto57CFB1AB_n = (2 + (lv_attackwave * 1));
        for (auto57CFB1AB_i = 1; auto57CFB1AB_i <= auto57CFB1AB_n; auto57CFB1AB_i += 1) {
            AIAttackWaveAddUnits4(1, 1, 1, 1, "Ranger");
        }
        auto552E6823_n = (4 + (lv_attackwave * 1));
        for (auto552E6823_i = 1; auto552E6823_i <= auto552E6823_n; auto552E6823_i += 1) {
            AIAttackWaveAddUnits4(1, 1, 1, 1, "PrimalHydralisk2");
        }
        auto96E3FA69_n = (4 + (lv_attackwave * 1));
        for (auto96E3FA69_i = 1; auto96E3FA69_i <= auto96E3FA69_n; auto96E3FA69_i += 1) {
            autoBA80E6EB_val = RandomInt(0, 2);
            if (autoBA80E6EB_val == 0) {
                AIAttackWaveAddUnits4(1, 1, 1, 1, "PrimalHost");
            }
            else if (autoBA80E6EB_val == 1) {
                AIAttackWaveAddUnits4(1, 1, 1, 1, "PrimalRavasaur");
            }
            else if (autoBA80E6EB_val == 2) {
                AIAttackWaveAddUnits4(1, 1, 1, 1, "PrimalRavager");
            }
            else {
            }
        }
        auto4EE34263_n = (1 + (lv_attackwave / 2));
        for (auto4EE34263_i = 1; auto4EE34263_i <= auto4EE34263_n; auto4EE34263_i += 1) {
            AIAttackWaveAddUnits4(1, 1, 1, 1, "PrimalTyrannozor");
        }
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Dehaka");
        if ((UnitIsAlive(UnitFromId(383395340)) == true)) {
            AIAttackWaveAddWaypoint(gv_dehaka, PointFromId(796), false);
        }

        if ((UnitIsAlive(UnitFromId(47)) == true)) {
            AIAttackWaveAddWaypoint(gv_dehaka, PointFromId(1629), false);
        }

        AIAttackWaveSend(gv_dehaka, 180, true);
        lv_attackwave += 1;
    }
    return true;
}

