    while (true) {
        auto857D2906_var = PlayerGroupNextPlayer(auto857D2906_g, auto857D2906_var);
        if (auto857D2906_var < 0) { break; }
        PlayerModifyPropertyInt(auto857D2906_var, c_playerPropMinerals, c_playerPropOperSetTo, 5000);
        PlayerModifyPropertyInt(auto857D2906_var, c_playerPropVespene, c_playerPropOperSetTo, 5000);
