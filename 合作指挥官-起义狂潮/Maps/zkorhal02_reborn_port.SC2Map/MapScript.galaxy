    for (;; autoD8458AD8_u -= 1) {
        autoD8458AD8_var = UnitGroupUnitFromEnd(autoD8458AD8_g, autoD8458AD8_u);
        if (autoD8458AD8_var == null) { break; }
        UnitKill(autoD8458AD8_var);
    }
    return true;
}

