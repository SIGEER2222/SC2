            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    lv_waitforcinematic = UnitIsAlive(UnitFromId(5));
    TriggerExecute(gt_DEBUGStage2, true, true);
    if ((lv_waitforcinematic == true)) {
        while (!((gv_inCinematic == true))) {
            Wait(0.3, c_timeGame);
        }
        while (!((gv_inCinematic == false))) {
