//--------------------------------------------------------------------------------------------------
// Trigger: Brakk Waves
//--------------------------------------------------------------------------------------------------
bool gt_BrakkWaves_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_attackwave;

    // Automatic Variable Declarations
    int auto2A4B1925_n;
    int auto2A4B1925_i;
    int autoD33AE86C_n;
    int autoD33AE86C_i;
