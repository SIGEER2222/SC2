//--------------------------------------------------------------------------------------------------
// Trigger: Start AI
//--------------------------------------------------------------------------------------------------
bool gt_StartAI_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    cai_startall();
    gf_ScriptedAttackGroup(RegionFromId(9), RegionFromId(11));
    gf_ScriptedAttackGroup(RegionFromId(5), RegionFromId(6));
    gf_ScriptedAttackGroup(RegionFromId(33), RegionFromId(10));
    gf_ScriptedAttackGroup(RegionFromId(48), RegionFromId(42));
    gf_ScriptedAttackGroup(RegionFromId(39), RegionFromId(40));
    gf_ScriptedAttackGroup(RegionFromId(39), RegionFromId(22));
    libNtve_gf_SetTacticalAIThink(gv_pLAYER_02_DOMINION, "Ghost", "AIGhost", false);
    libNtve_gf_SetTacticalAIThink(gv_pLAYER_02_DOMINION, "Diamondback", "AIDiamondback", false);
    libNtve_gf_SetTacticalAIThink(gv_pLAYER_05_DOMINION_PINK, "Diamondback", "AIDiamondback", false);
    AIToggleBulliesInRegion(gv_pLAYER_02_DOMINION, RegionEntireMap(), true);
    AIToggleBulliesInRegion(gv_pLAYER_03_DOMINION_YELLOW, RegionEntireMap(), true);
    AIToggleBulliesInRegion(gv_pLAYER_04_DOMINION_BLUE, RegionEntireMap(), true);
    AIToggleBulliesInRegion(gv_pLAYER_06_DOMINION_ORANGE, RegionEntireMap(), true);
    if ((libHots_gf_DifficultyValueInt2(0, 0, 1) == 1)) {
        TriggerExecute(gt_AIUpgradesHard, true, false);
    }
    else {
        TriggerExecute(gt_AIUpgradesNormal, true, false);
    }
    cai_waves_run(gv_pLAYER_03_DOMINION_YELLOW, gv_fren);
    cai_waves_run(gv_pLAYER_04_DOMINION_BLUE, gv_fren);
    cai_waves_run(gv_pLAYER_06_DOMINION_ORANGE, gv_fren);
    if ((lib48DF4533_gf_SetAllHatcheriesRallyPoints2() == true)) {
        cai_waves_run(gv_pLAYER_05_DOMINION_PINK, PlayerGroupSingle(1));
    }

    Wait(lib48DF4533_gf_DifficultyValueCrys(300, 240, 200, 120, 60), c_timeGame);
    cai_waves_run(gv_pLAYER_02_DOMINION, gv_fren);
    return true;
}

