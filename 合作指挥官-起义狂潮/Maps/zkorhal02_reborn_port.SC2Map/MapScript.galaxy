    libNtve_gf_SetAllianceBetweenTwoPlayerGroups(gv_dominionPlayerGroup, gv_fren, libNtve_ge_AllianceSetting_Enemy);
    PlayerModifyPropertyInt(gv_pLAYER_01_USER, c_playerPropMinerals, c_playerPropOperSetTo, 250);
    PlayerModifyPropertyInt(gv_pLAYER_01_USER, c_playerPropVespene, c_playerPropOperSetTo, 100);
    PlayerModifyPropertyInt(gv_brakk, c_playerPropMinerals, c_playerPropOperSetTo, 3000);
