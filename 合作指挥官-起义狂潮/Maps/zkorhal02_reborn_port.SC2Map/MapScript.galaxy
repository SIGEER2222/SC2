    PlayerSetState(gv_dehaka, c_playerStateMineralCostIgnored, true);
    PlayerSetState(gv_dehaka, c_playerStateVespeneCostIgnored, true);
    PlayerSetState(gv_brakk, c_playerStateFoodIgnored, true);
    PlayerSetState(gv_brakk, c_playerStateMineralCostIgnored, true);
    PlayerSetState(gv_brakk, c_playerStateVespeneCostIgnored, true);
    CatalogFieldValueSet(c_gameCatalogAbil, "PrimalTrain", "InfoArray[" + IntToString(25) + "].Time", gv_dehaka, "30");
    CatalogFieldValueSet(c_gameCatalogAbil, "PrimalTrain", "InfoArray[" + IntToString(26) + "].Time", gv_brakk, "30");
    return true;
}

