            return false;
        }

        if (!((gv_inCinematic == false))) {
            return false;
        }

        if (!((UnitGroupCount(gv_powerLinkGroup, c_unitCountAlive) != 0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_index = 5;
    for ( ; ( (autoB67E5124_ai >= 0 && lv_index <= autoB67E5124_ae) || (autoB67E5124_ai < 0 && lv_index >= autoB67E5124_ae) ) ; lv_index += autoB67E5124_ai ) {
        while (!((TimerGetRemaining(gv_psifieldpowerup) <= lv_index))) {
            Wait(0.1, c_timeGame);
        }
        SoundPlay(SoundLink("Event_PsiDestroyerCountdown", -1), PlayerGroupAll(), 100.0, 0.0);
    }
    return true;
}

