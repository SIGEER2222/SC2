        return true;
    }

    AIToggleBulliesInRegion(gv_brakk, RegionFromId(34), true);
    AIAttackWaveSetTargetPlayer(gv_brakk, gv_dominionPlayerGroup);
    AIAttackWaveSetGatherPoint(gv_brakk, PointFromId(1598136525));
    while (true) {
        auto2A4B1925_n = (15 + (lv_attackwave * 1));
        for (auto2A4B1925_i = 1; auto2A4B1925_i <= auto2A4B1925_n; auto2A4B1925_i += 1) {
            AIAttackWaveAddUnits4(1, 1, 1, 1, "PrimalZergling");
        }
        autoD33AE86C_n = (5 + (lv_attackwave * 1));
        for (autoD33AE86C_i = 1; autoD33AE86C_i <= autoD33AE86C_n; autoD33AE86C_i += 1) {
            AIAttackWaveAddUnits4(1, 1, 1, 1, "PrimalRoach");
        }
        auto764BDD87_n = (5 + (lv_attackwave * 1));
        for (auto764BDD87_i = 1; auto764BDD87_i <= auto764BDD87_n; auto764BDD87_i += 1) {
            AIAttackWaveAddUnits4(1, 1, 1, 1, "PrimalHydralisk");
        }
        auto466B6405_n = (3 + (lv_attackwave * 1));
        for (auto466B6405_i = 1; auto466B6405_i <= auto466B6405_n; auto466B6405_i += 1) {
            auto5FCAE8DC_val = RandomInt(0, 2);
            if (auto5FCAE8DC_val == 0) {
                AIAttackWaveAddUnits4(1, 1, 1, 1, "PrimalMutalisk");
            }
            else if (auto5FCAE8DC_val == 1) {
                AIAttackWaveAddUnits4(1, 1, 1, 1, "PrimalRavasaur");
            }
            else if (auto5FCAE8DC_val == 2) {
                AIAttackWaveAddUnits4(1, 1, 1, 1, "PrimalFlyer");
            }
            else {
            }
        }
        auto9D7E661F_n = (1 + lv_attackwave);
        for (auto9D7E661F_i = 1; auto9D7E661F_i <= auto9D7E661F_n; auto9D7E661F_i += 1) {
            AIAttackWaveAddUnits4(1, 1, 1, 1, "PrimalUltralisk");
        }
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Brakk");
        if ((UnitIsAlive(UnitFromId(32)) == true)) {
            AIAttackWaveAddWaypoint(gv_brakk, PointFromId(1630), false);
        }

        AIAttackWaveSend(gv_brakk, 180, true);
        lv_attackwave += 1;
    }
    return true;
}

