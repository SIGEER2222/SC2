    TriggerAddEventUnitDied(gt_PowerLinkDestroyedQ, UnitRefFromUnit(UnitFromId(5)));
    TriggerAddEventUnitDied(gt_PowerLinkDestroyedQ, UnitRefFromUnit(UnitFromId(47)));
