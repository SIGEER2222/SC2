//--------------------------------------------------------------------------------------------------
// Trigger: Start Game Q
//--------------------------------------------------------------------------------------------------
bool gt_StartGameQ_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_gameOver == false))) {
            return false;
        }

        if (!((gv_inCinematic == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerExecute(gt_ObjectiveDestroyPowerLinkCreate, true, true);
    Wait(3.0, c_timeReal);
    TriggerQueueEnter();
    TriggerExecute(gt_ObjectiveDestroyPowerLinkCreate, true, true);
    TriggerExecute(gt_CreatePingforFirstPowerLink, true, false);
    TriggerQueueExit();
    Wait(3.0, c_timeReal);
    TriggerExecute(gt_TipMissionHelpQ, true, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_StartGameQ_Init () {
    gt_StartGameQ = TriggerCreate("gt_StartGameQ_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Mid Game Start Q
//--------------------------------------------------------------------------------------------------
bool gt_MidGameStartQ_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_gameOver == false))) {
            return false;
        }

        if (!((gv_inCinematic == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    VisExploreArea(gv_pLAYER_01_USER, RegionFromId(34), true, true);
    VisExploreArea(gv_pLAYER_01_USER, RegionFromId(1), true, true);
    VisExploreArea(gv_pLAYER_01_USER, RegionFromId(18), true, true);
    VisExploreArea(gv_pLAYER_01_USER, RegionFromId(8), true, true);
    libNtve_gf_ShareVisionofUnit(UnitFromId(47), true, 1);
    libNtve_gf_ShareVisionofUnit(UnitFromId(32), true, 1);
    TimerStart(gv_dominionEngageTimer, 240.0, false, c_timeAI);
    TriggerExecute(gt_StartAI, true, false);
    TriggerExecute(gt_ObjectiveDestroyPowerLinkCreate, true, true);
    TriggerExecute(gt_DestroyerFieldSetup, true, false);
    TriggerEnable(gt_EngageDominionWarningCheck, true);
    TriggerEnable(gt_DehakaMainBaseExpansion, true);
    TriggerEnable(gt_BrakkExpansion1, true);
    TriggerEnable(gt_BrakkExpansion2, true);
    TriggerExecute(gt_DehakaWaves, true, false);
    TriggerExecute(gt_BrakkWaves, true, false);
    TriggerExecute(gt_Ruthless, true, false);
    UIAlertPoint("Trigger", gv_pLAYER_01_USER, StringExternal("Param/Value/03FBF032"), null, PointFromId(2));
    TriggerExecute(gt_StartHarvesting, true, false);
    TriggerEnable(gt_HandleKerriganDeath, true);
    gf_DisplayFieldPowerLeaderboard();
    Wait(3.0, c_timeReal);
    TriggerQueueEnter();
    TriggerExecute(gt_ObjectiveDestroyPsiDestroyerCreate, true, true);
    TriggerQueueExit();
    Wait(3.0, c_timeReal);
    TriggerExecute(gt_TransmissionPresstheAttackQ, true, false);
    Wait(8.0, c_timeReal);
    TriggerExecute(gt_Dialog, true, false);
    return true;
}

