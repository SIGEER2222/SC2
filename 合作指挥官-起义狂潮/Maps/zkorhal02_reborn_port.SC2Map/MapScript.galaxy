        TechTreeUpgradeAddLevel(auto1A600136_var, "TerranInfantryArmorsLevel1", 1);
        TechTreeUpgradeAddLevel(auto1A600136_var, "TerranVehicleArmorsLevel1", 1);
        TechTreeUpgradeAddLevel(auto1A600136_var, "TerranShipArmorsLevel1", 1);
    }
    Wait(300.0, c_timeAI);
    auto0EAD2A17_g = gv_dominionPlayerGroup;
    auto0EAD2A17_var = -1;
    while (true) {
        auto0EAD2A17_var = PlayerGroupNextPlayer(auto0EAD2A17_g, auto0EAD2A17_var);
