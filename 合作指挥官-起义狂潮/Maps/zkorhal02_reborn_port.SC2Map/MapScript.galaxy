    PlayerModifyPropertyInt(gv_dehaka, c_playerPropMinerals, c_playerPropOperSetTo, 3000);
    PlayerModifyPropertyInt(gv_dehaka, c_playerPropVespene, c_playerPropOperSetTo, 2000);
    auto857D2906_g = gv_dominionPlayerGroup;
