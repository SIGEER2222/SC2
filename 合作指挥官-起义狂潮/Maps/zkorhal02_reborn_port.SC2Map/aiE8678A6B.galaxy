//--------------------------------------------------------------------------------------------------
void aiE8678A6B_wave12_init () {
    int init_i;

    for (init_i = 0; init_i <= 16; init_i += 1) {
        aiE8678A6B_wave12_enabled[init_i] = true;
        aiE8678A6B_wave12_lastWave[init_i] = null;
    }

    aiE8678A6B_wave12_trigger = TriggerCreate("aiE8678A6B_wave12_runFunc");
}

//--------------------------------------------------------------------------------------------------
void aiE8678A6B_wave12_enable (int p, bool val) {
    if (p < 0 || p >= 16) {
        return;
    }
    aiE8678A6B_wave12_enabled[p] = val;
}

//--------------------------------------------------------------------------------------------------
