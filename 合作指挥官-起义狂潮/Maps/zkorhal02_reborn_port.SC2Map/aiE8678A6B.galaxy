//--------------------------------------------------------------------------------------------------
void aiE8678A6B_start (int p) {
    int init_i;

    if (p < 0 || p >= 16) {
        return;
    }
    if (!aiE8678A6B_initialized) {
        aiE8678A6B_wave1_init();
        aiE8678A6B_wave2_init();
        aiE8678A6B_wave3_init();
        aiE8678A6B_wave4_init();
        aiE8678A6B_wave5_init();
        aiE8678A6B_wave6_init();
        aiE8678A6B_wave7_init();
        aiE8678A6B_wave8_init();
        aiE8678A6B_wave9_init();
        aiE8678A6B_wave10_init();
        aiE8678A6B_wave11_init();
        aiE8678A6B_wave12_init();
        aiE8678A6B_waves_init();

        for (init_i = 0; init_i <= 16; init_i += 1) {
            aiE8678A6B_defGather[init_i] = PointFromId(793010408);
        }

        aiE8678A6B_initialized = true;
    }

    AICampaignStart(p);
}
