//--------------------------------------------------------------------------------------------------
trigger aiE8678A6B_waves_trigger = null;
int aiE8678A6B_waves_runPlayer;
playergroup aiE8678A6B_waves_runTarget;

//--------------------------------------------------------------------------------------------------
void aiE8678A6B_waves_init () {
    aiE8678A6B_waves_trigger = TriggerCreate("aiE8678A6B_waves_runFunc");
}

//--------------------------------------------------------------------------------------------------
bool aiE8678A6B_waves_runFunc (bool c, bool a) {
    int p = aiE8678A6B_waves_runPlayer;
    playergroup target = aiE8678A6B_waves_runTarget;

    if (p < 0 || p >= 16) {
        return false;
    }

    aiE8678A6B_wave1_run(p, target, true);
    aiE8678A6B_wave2_run(p, target, true);
    aiE8678A6B_wave3_run(p, target, true);
    aiE8678A6B_wave4_run(p, target, true);
    aiE8678A6B_wave5_run(p, target, true);
    aiE8678A6B_wave6_run(p, target, true);
    aiE8678A6B_wave7_run(p, target, true);
    aiE8678A6B_wave8_run(p, target, true);
    aiE8678A6B_wave9_run(p, target, true);
    aiE8678A6B_wave10_run(p, target, true);
    aiE8678A6B_wave11_run(p, target, true);
    aiE8678A6B_wave12_run(p, target, true);

    while (true) {
        aiE8678A6B_wave10_run(p, target, true);
        aiE8678A6B_wave11_run(p, target, true);
        aiE8678A6B_wave12_run(p, target, true);
    }

    return true;
}

