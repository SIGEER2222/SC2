}

//--------------------------------------------------------------------------------------------------
bool aiE8678A6B_wave12_runFunc (bool c, bool a) {
    int p = aiE8678A6B_wave12_runPlayer;
    playergroup target = aiE8678A6B_wave12_runTarget;
    int d;
    point gatherPoint = null;
    int ta = 0;
    int tg = 0;
    int ts = 0;
    int tf = 0;
    int td = 0;

    if (p < 0 || p >= 16) {
        return false;
    }
    d = PlayerDifficulty(p);
    if (!aiE8678A6B_wave12_enabled[p]) {
        td = 0;
        if (td > 0) {
            Wait(td, c_timeAI);
        }
        return true;
    }

    aiE8678A6B_customData[p] = "";

    ta = 0;
    if (d == 1) { ta = 90; }
    if (d == 2) { ta = 90; }
    if (d == 3) { ta = 90; }
    if (d == 4) { ta = 90; }
    tg = 0;
    ts = ta;
    if (tg > 0 && tg < ta) {
        Wait(ta - tg, c_timeAI);
        ts = tg;
    }
    AIAttackWaveSetTargetPlayer(p, target);

    gatherPoint = aiE8678A6B_defGather[p];
    AIAttackWaveSetGatherPoint(p, gatherPoint);

    AIAttackWaveClearWaypoints(p);

    AIAttackWaveAddUnits(2, 10, "Stormtrooper");
    AIAttackWaveAddUnits(3, 10, "Stormtrooper");
    AIAttackWaveAddUnits(4, 11, "Stormtrooper");
    AIAttackWaveAddUnits(5, 12, "Stormtrooper");

    AIAttackWaveAddUnits(2, 2, "Ranger");
    AIAttackWaveAddUnits(3, 2, "Ranger");
    AIAttackWaveAddUnits(4, 3, "Ranger");
    AIAttackWaveAddUnits(5, 4, "Ranger");

    AIAttackWaveAddUnits(2, 2, "MercMedic");
    AIAttackWaveAddUnits(3, 2, "MercMedic");
    AIAttackWaveAddUnits(4, 2, "MercMedic");
    AIAttackWaveAddUnits(5, 3, "MercMedic");

    AIAttackWaveAddUnits(2, 2, "SonofKorhal");
    AIAttackWaveAddUnits(3, 2, "SonofKorhal");
    AIAttackWaveAddUnits(4, 3, "SonofKorhal");
    AIAttackWaveAddUnits(5, 4, "SonofKorhal");

    AIAttackWaveAddUnits(2, 1, "AegisGuard");
    AIAttackWaveAddUnits(3, 1, "AegisGuard");
    AIAttackWaveAddUnits(4, 2, "AegisGuard");
    AIAttackWaveAddUnits(5, 2, "AegisGuard");

    AIAttackWaveSend(p, ts, false);
    aiE8678A6B_wave12_lastWave[p] = WaveLastCreated();
    aiE8678A6B_lastWave[p] = aiE8678A6B_wave12_lastWave[p];
    Wait(ts, c_timeAI);
    tf = 0;
    if (tf > 0) {
        Wait(tf, c_timeAI);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void aiE8678A6B_wave12_run (int p, playergroup target, bool wait) {
    aiE8678A6B_wave12_runPlayer = p;
    aiE8678A6B_wave12_runTarget = PlayerGroupCopy(target);

    TriggerExecute(aiE8678A6B_wave12_trigger, false, wait);
}

