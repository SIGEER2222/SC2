    gv_maxAnzahlWarpigs = 0;
    gv_anzahlWarpigs = 0;
    gv_maxAnzahlPredators = 0;
    gv_anzahlPredators = 0;
    init_i = 0;
    while (init_i <= 6) {
        gv_hauptmissionen[init_i] = c_invalidObjectiveId;
        init_i = init_i + 1;
    }
    init_i = 0;
    while (init_i <= 3) {
        gv_nebenmissionen[init_i] = c_invalidObjectiveId;
        init_i = init_i + 1;
    }
}

