//--------------------------------------------------------------------------------------------------
// Trigger: New Weapon
//--------------------------------------------------------------------------------------------------
bool gt_NewWeapon_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    if ((DistanceBetweenPoints(UnitGetPosition(UnitFromId(1684)), UnitGetPosition(UnitFromId(1687))) < 1.1)) {
