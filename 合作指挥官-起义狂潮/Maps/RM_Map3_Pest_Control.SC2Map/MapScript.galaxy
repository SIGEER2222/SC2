//--------------------------------------------------------------------------------------------------
bool gt_AlleBereicheC3BCbernommen_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((gv_gebieteC3BCbernommen == 8))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    ObjectiveSetState(gv_hauptmissionen[0], c_objectiveStateCompleted);
    TriggerExecute(gt_Video, true, false);
    TriggerEnable(TriggerGetCurrent(), false);
    return true;
}

