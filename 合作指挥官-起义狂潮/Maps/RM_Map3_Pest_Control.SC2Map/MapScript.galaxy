bool gt_GUI_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    DialogCreate(600, 400, c_anchorCenter, 0, 0, true);
    gv_diffdialog = DialogLastCreated();
    libNtve_gf_CreateDialogItemButton(gv_diffdialog, 300, 70, c_anchorCenter, 0, -75, StringExternal("Param/Value/A48EF7D5"), StringExternal("Param/Value/FACF1ECC"), "");
    gv_diffdialogbutton[0] = DialogControlLastCreated();
    libNtve_gf_CreateDialogItemButton(gv_diffdialog, 300, 70, c_anchorCenter, 0, 0, StringExternal("Param/Value/8408003C"), StringExternal("Param/Value/14BE599E"), "");
    gv_diffdialogbutton[1] = DialogControlLastCreated();
    libNtve_gf_CreateDialogItemButton(gv_diffdialog, 300, 70, c_anchorCenter, 0, 75, StringExternal("Param/Value/A95223CA"), StringExternal("Param/Value/892AA824"), "");
    gv_diffdialogbutton[2] = DialogControlLastCreated();
    DialogSetVisible(gv_diffdialog, PlayerGroupAll(), true);
    TriggerEnable(TriggerGetCurrent(), false);
    return true;
}

