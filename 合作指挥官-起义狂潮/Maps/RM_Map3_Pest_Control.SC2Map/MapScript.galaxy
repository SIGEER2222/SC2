//--------------------------------------------------------------------------------------------------
// Trigger: Neuer Held
//--------------------------------------------------------------------------------------------------
bool gt_NeuerHeld_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_SetAlliance(1, 2, 7);
    libNtve_gf_SetAlliance(1, 3, 7);
    libNtve_gf_SetAlliance(1, 4, 7);
    libNtve_gf_SetAlliance(1, 5, 7);
    libNtve_gf_SetAlliance(1, 6, 7);
    libNtve_gf_SetAlliance(1, 15, 7);
    libNtve_gf_CinematicMode(true, PlayerGroupAll(), c_transitionDurationDefault);
    CinematicFade(false, 1.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    UnitSetPosition(UnitFromId(1685), PointFromId(2485), false);
    UnitSetPosition(UnitFromId(1683), PointFromId(2483), false);
    UnitSetPosition(UnitFromId(1684), PointFromId(2488), false);
    CameraApplyInfo(1, CameraInfoFromId(2673), 0.0, -1, 10, true);
    CinematicFade(true, 0.5, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    UnitIssueOrder(UnitFromId(1683), OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(2566)), c_orderQueueReplace);
    UnitIssueOrder(UnitFromId(1684), OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(2490)), c_orderQueueReplace);
    UnitIssueOrder(UnitFromId(1685), OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(2565)), c_orderQueueReplace);
    CameraApplyInfo(1, CameraInfoFromId(2674), 1.5, -1, 0, true);
    Wait(1.49, c_timeGame);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/2BF2DBAC"));
    CameraApplyInfo(1, CameraInfoFromId(2675), 3.0, -1, 5, true);
    Wait(3.0, c_timeGame);
    UnitSetFacing(UnitFromId(1684), 71.0, 1.0);
    UnitSetFacing(UnitFromId(1685), 90.0, 1.0);
    UnitSetFacing(UnitFromId(1683), 106.0, 1.0);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/60DFC60E"));
    Wait(8.0, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/B37DEE3B"));
    Wait(3.0, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/3ACCDE0C"));
    Wait(6.0, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/C7692F74"));
    Wait(3.0, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/1BAF9AD8"));
    Wait(5.0, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/3E03A5A9"));
    Wait(1.0, c_timeGame);
    CameraApplyInfo(1, CameraInfoFromId(2676), 3.0, -1, 10, true);
    libNtve_gf_CinematicMode(false, PlayerGroupAll(), c_transitionDurationDefault);
    Wait(1.0, c_timeGame);
    libNtve_gf_SetAlliance(1, 2, 5);
    libNtve_gf_SetAlliance(1, 3, 5);
    libNtve_gf_SetAlliance(1, 4, 5);
    libNtve_gf_SetAlliance(1, 5, 5);
    libNtve_gf_SetAlliance(1, 6, 5);
    libNtve_gf_SetAlliance(1, 15, 5);
    TriggerEnable(TriggerGetCurrent(), false);
    return true;
}

