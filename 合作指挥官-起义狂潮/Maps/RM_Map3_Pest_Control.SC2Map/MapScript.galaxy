//--------------------------------------------------------------------------------------------------
// Trigger: Raynor Spawned Marine is born
//--------------------------------------------------------------------------------------------------
bool gt_RaynorSpawnedMarineisborn_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    gv_anzahlWarpigs=gv_anzahlWarpigs + 1;
    if ((gv_anzahlWarpigs == gv_maxAnzahlWarpigs)) {
        UnitAbilityEnable(UnitFromId(1683), "SpawnMarines", false);
    }
    else {
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_RaynorSpawnedMarineisborn_Init () {
    gt_RaynorSpawnedMarineisborn = TriggerCreate("gt_RaynorSpawnedMarineisborn_Func");
    TriggerAddEventUnitCreated(gt_RaynorSpawnedMarineisborn, UnitRefFromUnit(UnitFromId(1683)), "SpawnMarines", null);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Raynor Spawned Marine Dies
//--------------------------------------------------------------------------------------------------
bool gt_RaynorSpawnedMarineDies_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnit()) == "WarPigRM"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gv_anzahlWarpigs=gv_anzahlWarpigs - 1;
    if ((gv_anzahlWarpigs < gv_maxAnzahlWarpigs)) {
        UnitAbilityEnable(UnitFromId(1683), "SpawnMarines", true);
    }
    else {
    }
    return true;
}

