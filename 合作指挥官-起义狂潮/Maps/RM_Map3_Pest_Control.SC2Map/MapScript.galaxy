//--------------------------------------------------------------------------------------------------
// Trigger: Spieler 3 angriff
//--------------------------------------------------------------------------------------------------
bool gt_Spieler3angriff_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((UnitGroupCount(gv_teamSpieler3, c_unitCountAlive) >= 4))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitGroupLoopBegin(gv_teamSpieler3);
    while (!UnitGroupLoopDone()) {
        UnitIssueOrder(UnitGroupLoopCurrent(), OrderTargetingRelativePoint(AbilityCommand("attack", 0), PointFromId(2787)), c_orderQueueReplace);
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();
    return true;
}

