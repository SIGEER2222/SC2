//--------------------------------------------------------------------------------------------------
// Trigger: Trupp A
//--------------------------------------------------------------------------------------------------
bool gt_TruppA_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, StringExternal("Param/Value/CCFD3B13"));
    TriggerEnable(TriggerGetCurrent(), false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_TruppA_Init () {
    gt_TruppA = TriggerCreate("gt_TruppA_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Trupp B
//--------------------------------------------------------------------------------------------------
bool gt_TruppB_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_SetAlliance(1, 2, 7);
    libNtve_gf_SetAlliance(1, 3, 7);
    libNtve_gf_SetAlliance(1, 4, 7);
    libNtve_gf_SetAlliance(1, 5, 7);
    libNtve_gf_SetAlliance(1, 6, 7);
    libNtve_gf_SetAlliance(1, 15, 7);
    libNtve_gf_CinematicMode(true, PlayerGroupAll(), c_transitionDurationDefault);
    CinematicFade(false, 1.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    CameraApplyInfo(1, CameraInfoFromId(2567), 0.0, -1, 10, true);
    CinematicFade(true, 0.5, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/DDB54375"));
    Wait(2.0, c_timeGame);
    CameraApplyInfo(1, CameraInfoFromId(2672), 5.0, -1, 10, true);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/1E2AB2BB"));
    Wait(8.0, c_timeGame);
    CameraApplyInfo(1, CameraInfoFromId(2671), 3.0, -1, 10, true);
    libNtve_gf_CinematicMode(false, PlayerGroupAll(), c_transitionDurationDefault);
    libNtve_gf_SetAlliance(1, 2, 5);
    libNtve_gf_SetAlliance(1, 3, 5);
    libNtve_gf_SetAlliance(1, 4, 5);
    libNtve_gf_SetAlliance(1, 5, 5);
    libNtve_gf_SetAlliance(1, 6, 5);
    libNtve_gf_SetAlliance(1, 15, 5);
    TriggerEnable(TriggerGetCurrent(), false);
    return true;
}

