void gt_AlleBereicheC3BCbernommen_Init () {
    gt_AlleBereicheC3BCbernommen = TriggerCreate("gt_AlleBereicheC3BCbernommen_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Video
//--------------------------------------------------------------------------------------------------
bool gt_Video_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_CinematicMode(true, PlayerGroupAll(), c_transitionDurationDefault);
    UnitSetPosition(UnitFromId(1685), PointFromId(2485), false);
    UnitSetPosition(UnitFromId(1683), PointFromId(2483), false);
    UnitSetPosition(UnitFromId(1684), PointFromId(2488), false);
    UnitSetPosition(UnitFromId(1581), PointFromId(2485), false);
    UnitSetFacing(UnitFromId(1684), 55.0, 1.0);
    UnitSetFacing(UnitFromId(1685), 55.0, 1.0);
    UnitSetFacing(UnitFromId(1683), 55.0, 1.0);
    UnitSetFacing(UnitFromId(1581), 55.0, 1.0);
    CameraApplyInfo(1, CameraInfoFromId(2678), 10.0, -1, 0, true);
    VisRevealerCreate(1, RegionEntireMap());
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/CD27E6C0"));
    Wait(5.0, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/40CC18AF"));
    Wait(9.0, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaCinematic, StringExternal("Param/Value/4B1CE4BE"));
    Wait(7.0, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/50EB5AE2"));
    Wait(5.0, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/976F62D0"));
    Wait(7.0, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/011DC81F"));
    Wait(9.0, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/96DB1D27"));
    Wait(8.0, c_timeGame);
    libNtve_gf_CinematicMode(false, PlayerGroupAll(), c_transitionDurationDefault);
    TriggerExecute(gt_Fin, true, false);
    TriggerEnable(TriggerGetCurrent(), false);
    return true;
}

