//--------------------------------------------------------------------------------------------------
// Trigger: Spieler 3 Teamzusammenstellung
//--------------------------------------------------------------------------------------------------
bool gt_Spieler3Teamzusammenstellung_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((((UnitGetType(EventUnit()) != "Lair") && (UnitGetType(EventUnit()) != "Hatchery") && (UnitGetType(EventUnit()) != "Hive")) && (UnitGetOwner(EventUnit()) == 3)))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitGroupAdd(gv_teamSpieler3, EventUnitCreatedUnit());
    return true;
}

//--------------------------------------------------------------------------------------------------
