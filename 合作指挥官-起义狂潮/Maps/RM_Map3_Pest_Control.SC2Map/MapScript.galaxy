//--------------------------------------------------------------------------------------------------
// Trigger: Schwierigkeit gew??hlt
//--------------------------------------------------------------------------------------------------
bool gt_SchwierigkeitgewC3A4hlt_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    if ((EventDialogControl() == gv_diffdialogbutton[0])) {
        PlayerSetDifficulty(1, 2);
        DialogSetVisible(gv_diffdialog, PlayerGroupAll(), false);
        UnitSetPropertyFixed(UnitFromId(1683), c_unitPropLifeMax, 750.0);
        UnitSetPropertyFixed(UnitFromId(1684), c_unitPropLifeMax, 1000.0);
        UnitSetPropertyFixed(UnitFromId(1685), c_unitPropLifeMax, 500.0);
        gv_difficulty = 0;
        gv_maxAnzahlFlammer=gv_maxAnzahlFlammer + 2;
        gv_maxAnzahlPredators=gv_maxAnzahlPredators + 2;
        gv_maxAnzahlWarpigs=gv_maxAnzahlWarpigs + 4;
        TriggerExecute(gt_VideoalleMissionen, true, false);
    }
    else {
    }
    if ((EventDialogControl() == gv_diffdialogbutton[1])) {
        PlayerSetDifficulty(1, 3);
        DialogSetVisible(gv_diffdialog, PlayerGroupAll(), false);
        UnitSetPropertyFixed(UnitFromId(1683), c_unitPropLifeMax, 600.0);
        UnitSetPropertyFixed(UnitFromId(1684), c_unitPropLifeMax, 750.0);
        UnitSetPropertyFixed(UnitFromId(1685), c_unitPropLifeMax, 350.0);
        gv_difficulty = 1;
        gv_maxAnzahlFlammer=gv_maxAnzahlFlammer + 1;
        gv_maxAnzahlPredators=gv_maxAnzahlPredators + 1;
        gv_maxAnzahlWarpigs=gv_maxAnzahlWarpigs + 2;
        TriggerExecute(gt_VideoalleMissionen, true, false);
    }
    else {
    }
    if ((EventDialogControl() == gv_diffdialogbutton[2])) {
        PlayerSetDifficulty(1, 4);
        gv_difficulty = 2;
        DialogSetVisible(gv_diffdialog, PlayerGroupAll(), false);
        TriggerExecute(gt_VideoalleMissionen, true, false);
    }
    else {
    }
    TriggerExecute(gt_KartenbezogeneEinstellungen, true, false);
    TriggerEnable(TriggerGetCurrent(), false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_SchwierigkeitgewC3A4hlt_Init () {
    gt_SchwierigkeitgewC3A4hlt = TriggerCreate("gt_SchwierigkeitgewC3A4hlt_Func");
    TriggerAddEventDialogControl(gt_SchwierigkeitgewC3A4hlt, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Kartenbezogene Einstellungen
//--------------------------------------------------------------------------------------------------
bool gt_KartenbezogeneEinstellungen_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    if ((gv_difficulty == 0)) {
        PlayerModifyPropertyInt(1, c_playerPropMinerals, c_playerPropOperAdd, 1500);
        PlayerModifyPropertyInt(1, c_playerPropVespene, c_playerPropOperAdd, 250);
    }
    else {
    }
    if ((gv_difficulty == 1)) {
        PlayerModifyPropertyInt(1, c_playerPropMinerals, c_playerPropOperAdd, 750);
        PlayerModifyPropertyInt(1, c_playerPropVespene, c_playerPropOperAdd, 125);
        UnitRemove(UnitFromId(1851));
    }
    else {
    }
    if ((gv_difficulty == 2)) {
        UnitRemove(UnitFromId(1851));
        UnitRemove(UnitFromId(1850));
    }
    else {
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_KartenbezogeneEinstellungen_Init () {
    gt_KartenbezogeneEinstellungen = TriggerCreate("gt_KartenbezogeneEinstellungen_Func");
}

