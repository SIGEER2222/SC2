//--------------------------------------------------------------------------------------------------
// Trigger: Video + alle Missionen
//--------------------------------------------------------------------------------------------------
bool gt_VideoalleMissionen_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    CinematicFade(false, 0.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    CameraApplyInfo(1, CameraInfoFromId(1628), 0.0, -1, 10, true);
    libNtve_gf_CinematicMode(true, PlayerGroupAll(), c_transitionDurationDefault);
    CinematicFade(true, 2.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/618E2FD2"));
    Wait(7.5, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/76D3617B"));
    Wait(7.5, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/BC6F3ACF"));
    Wait(7.5, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/3B283D6B"));
    Wait(8.5, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/69E097F7"));
    Wait(4.5, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/B29F37AC"));
    Wait(3.0, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/0E1DB9FF"));
    Wait(7.5, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/93D8B1D8"));
    Wait(5.5, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/183E8C45"));
    Wait(4.5, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/A9946B95"));
    Wait(5.5, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    CameraApplyInfo(1, CameraInfoFromId(2453), 4.0, -1, 10, true);
    Wait(2.5, c_timeGame);
    libNtve_gf_CinematicMode(false, PlayerGroupAll(), c_transitionDurationDefault);
    ObjectiveCreate(StringExternal("Param/Value/3A371A25"), StringExternal("Param/Value/D8217EAC"), c_objectiveStateActive, true);
    gv_hauptmissionen[0] = ObjectiveLastCreated();
    ObjectiveCreate(StringExternal("Param/Value/D1F3A163"), StringExternal("Param/Value/9BC84A11"), c_objectiveStateActive, true);
    gv_hauptmissionen[1] = ObjectiveLastCreated();
    ObjectiveCreate(StringExternal("Param/Value/B9BB35B4"), StringExternal("Param/Value/173DA513"), c_objectiveStateActive, true);
    gv_hauptmissionen[2] = ObjectiveLastCreated();
    ObjectiveCreate(StringExternal("Param/Value/BAED6EEB"), StringExternal("Param/Value/B2B4D6A2"), c_objectiveStateActive, true);
    gv_hauptmissionen[3] = ObjectiveLastCreated();
    ObjectiveCreate(StringExternal("Param/Value/8CCF3C39"), StringExternal("Param/Value/7E89BF11"), c_objectiveStateActive, true);
    gv_hauptmissionen[4] = ObjectiveLastCreated();
    ObjectiveCreate(StringExternal("Param/Value/159D6053"), StringExternal("Param/Value/0D841E64"), c_objectiveStateActive, true);
    gv_hauptmissionen[5] = ObjectiveLastCreated();
    ObjectiveCreate(StringExternal("Param/Value/B67387BC"), StringExternal("Param/Value/DD1858AE"), c_objectiveStateActive, false);
    gv_nebenmissionen[0] = ObjectiveLastCreated();
    ObjectiveCreate(StringExternal("Param/Value/06E31439"), StringExternal("Param/Value/5C85EC77"), c_objectiveStateActive, false);
    gv_nebenmissionen[1] = ObjectiveLastCreated();
    ObjectiveCreate(StringExternal("Param/Value/ED2ACFA8"), StringExternal("Param/Value/CED5CD79"), c_objectiveStateActive, false);
    gv_nebenmissionen[2] = ObjectiveLastCreated();
    TriggerEnable(TriggerGetCurrent(), false);
    return true;
}

