//--------------------------------------------------------------------------------------------------
bool gt_PurifierReinforcements_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup autoE699E8BF_g;
    int autoE699E8BF_u;
    unit autoE699E8BF_var;
    unitgroup auto60088061_g;
    int auto60088061_u;
    unit auto60088061_var;

    // Conditions
    if (testConds) {
        if (!((UnitIsAlive(gv_purifier) == true))) {
            return false;
        }

        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gf_TerrorFleetWarpIn(libNtve_gf_DifficultyValueInt(4, 4, 5, 6), AbilityCommand("SuperWarpGateTrainVoid", 3), 4.0, 45.0, 0.0);
    gf_TerrorFleetWarpIn(libNtve_gf_DifficultyValueInt(1, 1, 2, 3), AbilityCommand("SuperWarpGateTrain", 5), 4.0, 45.0, 0.0);
    gf_TerrorFleetWarpIn(libNtve_gf_DifficultyValueInt(2, 2, 3, 4), AbilityCommand("SuperWarpGateTrain", 14), 4.0, 33.0, 0.0);
    gf_TerrorFleetWarpIn(libNtve_gf_DifficultyValueInt(0, 0, 0, 1), AbilityCommand("SuperWarpGateTrain", 6), 4.0, 33.0, 0.0);
    gf_TerrorFleetWarpIn(libNtve_gf_DifficultyValueInt(1, 1, 1, 2), AbilityCommand("SuperWarpGateTrainVoid", 15), 4.0, 33.0, 0.0);
    Wait(8.0, c_timeGame);
    autoE699E8BF_g = UnitGroup(null, gv_pLAYER04_PHASESMITHS, RegionCircle(UnitGetPosition(gv_purifier), 8.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    autoE699E8BF_u = UnitGroupCount(autoE699E8BF_g, c_unitCountAll);
    for (;; autoE699E8BF_u -= 1) {
        autoE699E8BF_var = UnitGroupUnitFromEnd(autoE699E8BF_g, autoE699E8BF_u);
        if (autoE699E8BF_var == null) { break; }
        UnitGroupRemove(gv_terrorFleetGroup, autoE699E8BF_var);
        AISetUnitSuicide(autoE699E8BF_var, true);
    }
    auto60088061_g = UnitGroup(null, gv_pLAYER06_FLEET, RegionCircle(UnitGetPosition(gv_purifier), 8.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    auto60088061_u = UnitGroupCount(auto60088061_g, c_unitCountAll);
    for (;; auto60088061_u -= 1) {
        auto60088061_var = UnitGroupUnitFromEnd(auto60088061_g, auto60088061_u);
        if (auto60088061_var == null) { break; }
        UnitGroupRemove(gv_terrorFleetGroup, auto60088061_var);
        AISetUnitSuicide(auto60088061_var, true);
    }
    return true;
}

