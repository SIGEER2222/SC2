//--------------------------------------------------------------------------------------------------
// Trigger: Bunker Refill
//--------------------------------------------------------------------------------------------------
bool gt_BunkerRefill_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((libNtve_gf_TriggeringProgressUnitType() == "Bunker"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitCargoCreate(EventUnitProgressUnit(), "Marine", 4);
    UnitCargoCreate(EventUnitProgressUnit(), "Marauder", 1);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_BunkerRefill_Init () {
    gt_BunkerRefill = TriggerCreate("gt_BunkerRefill_Func");
    TriggerAddEventUnitConstructProgress(gt_BunkerRefill, null, c_unitProgressStageComplete);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Transmission - Protoss Nexus Q
//--------------------------------------------------------------------------------------------------
bool gt_TransmissionProtossNexusQ_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_gameOn == true))) {
            return false;
        }

        if (!((gv_gameOver == false))) {
