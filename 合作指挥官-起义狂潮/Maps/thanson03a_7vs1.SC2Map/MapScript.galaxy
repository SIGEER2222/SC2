        gf_TryToPrepWaveFromSource(gv_prismGroupSouth, PointFromId(172));
        gf_TryToPrepWaveFromSource(gv_prismGroupEast, PointFromId(321));
        gf_TryToPrepWaveFromSource(gv_prismGroupNorth, PointFromId(365));
