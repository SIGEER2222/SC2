//--------------------------------------------------------------------------------------------------
// Trigger: Colonist Killed
//--------------------------------------------------------------------------------------------------
bool gt_ColonistKilled_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    int autoF5DA8A3B_val;

    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(libNtve_gf_KillingUnit()) != gv_pLAYER01_USER))) {
            return false;
        }

        if (!((UnitGetOwner(EventUnit()) == gv_pLAYER10_INFESTED))) {
            return false;
        }

        if (!(((UnitGetType(EventUnit()) == "InfestableColonistHut")))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    MinimapPing(PlayerGroupAll(), UnitGetPosition(EventUnit()), 5.0, Color(100.00, 0.00, 0.00));
    autoF5DA8A3B_val = RandomInt(0, 2);
    if (autoF5DA8A3B_val == 0) {
        TriggerExecute(gt_Colonistskeepdyingline1Q, true, false);
    }
    else if (autoF5DA8A3B_val == 1) {
        TriggerExecute(gt_Colonistskeepdyingline2Q, true, false);
    }
    else if (autoF5DA8A3B_val == 2) {
        TriggerExecute(gt_Colonistskeepdyingline4Q, true, false);
    }
    else {
    }
    Wait(30.0, c_timeGame);
    TriggerEnable(TriggerGetCurrent(), true);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_ColonistKilled_Init () {
    gt_ColonistKilled = TriggerCreate("gt_ColonistKilled_Func");
    TriggerAddEventUnitDied(gt_ColonistKilled, null);
}

