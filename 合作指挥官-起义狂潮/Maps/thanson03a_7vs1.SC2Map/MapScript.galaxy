//--------------------------------------------------------------------------------------------------
bool gt_P2Attack_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_type;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    lv_type = RandomInt(1, 8);
    libE0EAE146_gf_EnemyBriefSet("P", lv_type);
    Wait(180.0, c_timeAI);
    gf_AttackWaveRun2(lv_type, 1);
    Wait(180.0, c_timeAI);
    gf_AttackWaveRun2(lv_type, 2);
    Wait(180.0, c_timeAI);
    gf_AttackWaveRun2(lv_type, 3);
    Wait(180.0, c_timeAI);
    gf_AttackWaveRun2(lv_type, 4);
    Wait(180.0, c_timeAI);
    gf_AttackWaveRun2(lv_type, 5);
    while (true) {
        Wait(180.0, c_timeAI);
        gf_AttackWaveRun2(lv_type, 5);
    }
    return true;
}

