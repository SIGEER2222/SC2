//--------------------------------------------------------------------------------------------------
// Trigger: Reinforce Regions With Bullies
//--------------------------------------------------------------------------------------------------
bool gt_ReinforceRegionsWithBullies_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(300.0, c_timeGame);
    Wait(300.0, c_timeGame);
    Wait(300.0, c_timeGame);
    AIToggleBulliesInRegion(gv_pLAYER04_PHASESMITHS, RegionFromId(50), true);
    Wait(300.0, c_timeGame);
    AIToggleBulliesInRegion(gv_pLAYER04_PHASESMITHS, RegionFromId(51), true);
    AIToggleBulliesInRegion(gv_pLAYER06_FLEET, RegionFromId(54), true);
    return true;
}

