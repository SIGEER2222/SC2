    PlayerSetState(gv_pLAYER05_COLONISTMECHS, c_playerStateDisplayInLeaderPanel, false);
    PlayerSetState(gv_pLAYER06_FLEET, c_playerStateDisplayInLeaderPanel, false);
    PlayerSetState(gv_pLAYER07_RESOURCES, c_playerStateDisplayInLeaderPanel, false);
    return true;
}

