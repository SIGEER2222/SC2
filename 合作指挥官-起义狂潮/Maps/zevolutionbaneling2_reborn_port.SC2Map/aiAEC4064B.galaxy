    if (p < 0 || p >= 16) {
        return null;
    }
    return aiAEC4064B_wave1_lastWave[p];
}

//--------------------------------------------------------------------------------------------------
bool aiAEC4064B_wave1_runFunc (bool c, bool a) {
    int p = aiAEC4064B_wave1_runPlayer;
    playergroup target = aiAEC4064B_wave1_runTarget;
    int d;
    point gatherPoint = null;
    int ta = 0;
    int tg = 0;
    int ts = 0;
    int tf = 0;
    int td = 0;

    if (p < 0 || p >= 16) {
        return false;
    }
    d = PlayerDifficulty(p);
    if (!aiAEC4064B_wave1_enabled[p]) {
        td = 0;
        if (td > 0) {
            Wait(td, c_timeAI);
        }
        return true;
    }

    aiAEC4064B_customData[p] = "";

    ta = 0;
    if (d == 1) { ta = 300; }
    if (d == 2) { ta = 300; }
    if (d == 3) { ta = 300; }
    if (d == 4) { ta = 300; }
    tg = 0;
    ts = ta;
    if (tg > 0 && tg < ta) {
        Wait(ta - tg, c_timeAI);
        ts = tg;
    }
    AIAttackWaveSetTargetPlayer(p, target);

    gatherPoint = aiAEC4064B_defGather[p];
    AIAttackWaveSetGatherPoint(p, gatherPoint);

    AIAttackWaveClearWaypoints(p);

    AIAttackWaveAddUnits(2, 40, "InfestedCivilian");
    AIAttackWaveAddUnits(3, 40, "InfestedCivilian");
    AIAttackWaveAddUnits(4, 50, "InfestedCivilian");
    AIAttackWaveAddUnits(5, 60, "InfestedCivilian");

    AIAttackWaveAddUnits(2, 20, "InfestedCultist");
    AIAttackWaveAddUnits(3, 20, "InfestedCultist");
    AIAttackWaveAddUnits(4, 25, "InfestedCultist");
    AIAttackWaveAddUnits(5, 30, "InfestedCultist");

    AIAttackWaveSend(p, ts, false);
    aiAEC4064B_wave1_lastWave[p] = WaveLastCreated();
    aiAEC4064B_lastWave[p] = aiAEC4064B_wave1_lastWave[p];
    Wait(ts, c_timeAI);
    tf = 0;
    if (tf > 0) {
        Wait(tf, c_timeAI);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void aiAEC4064B_wave1_run (int p, playergroup target, bool wait) {
    aiAEC4064B_wave1_runPlayer = p;
    aiAEC4064B_wave1_runTarget = PlayerGroupCopy(target);

    TriggerExecute(aiAEC4064B_wave1_trigger, false, wait);
}

