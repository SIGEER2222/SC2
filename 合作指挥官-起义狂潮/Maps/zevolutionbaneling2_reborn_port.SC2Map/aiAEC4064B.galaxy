//--------------------------------------------------------------------------------------------------
// Start
//--------------------------------------------------------------------------------------------------
bool aiAEC4064B_initialized = false;

//--------------------------------------------------------------------------------------------------
void aiAEC4064B_start (int p) {
    int init_i;

    if (p < 0 || p >= 16) {
        return;
    }
    if (!aiAEC4064B_initialized) {
        aiAEC4064B_wave1_init();
        aiAEC4064B_wave2_init();
        aiAEC4064B_wave3_init();
        aiAEC4064B_wave4_init();
        aiAEC4064B_wave5_init();
        aiAEC4064B_wave6_init();
        aiAEC4064B_wave7_init();
        aiAEC4064B_wave8_init();
        aiAEC4064B_waves_init();

        for (init_i = 0; init_i <= 16; init_i += 1) {
            aiAEC4064B_defGather[init_i] = PointFromId(1252);
        }

        aiAEC4064B_initialized = true;
    }

    AICampaignStart(p);
}
