//--------------------------------------------------------------------------------------------------
void aiAEC4064B_wave1_init () {
    int init_i;

    for (init_i = 0; init_i <= 16; init_i += 1) {
        aiAEC4064B_wave1_enabled[init_i] = true;
        aiAEC4064B_wave1_lastWave[init_i] = null;
    }

    aiAEC4064B_wave1_trigger = TriggerCreate("aiAEC4064B_wave1_runFunc");
}

//--------------------------------------------------------------------------------------------------
void aiAEC4064B_wave1_enable (int p, bool val) {
    if (p < 0 || p >= 16) {
        return;
    }
    aiAEC4064B_wave1_enabled[p] = val;
}

//--------------------------------------------------------------------------------------------------
bool aiAEC4064B_wave1_isEnabled (int p) {
    if (p < 0 || p >= 16) {
        return false;
    }
    return aiAEC4064B_wave1_enabled[p];
