//--------------------------------------------------------------------------------------------------
// Attack Wave Sequence
//--------------------------------------------------------------------------------------------------
trigger aiAEC4064B_waves_trigger = null;
int aiAEC4064B_waves_runPlayer;
playergroup aiAEC4064B_waves_runTarget;

//--------------------------------------------------------------------------------------------------
void aiAEC4064B_waves_init () {
    aiAEC4064B_waves_trigger = TriggerCreate("aiAEC4064B_waves_runFunc");
}

//--------------------------------------------------------------------------------------------------
bool aiAEC4064B_waves_runFunc (bool c, bool a) {
    int p = aiAEC4064B_waves_runPlayer;
    playergroup target = aiAEC4064B_waves_runTarget;

    if (p < 0 || p >= 16) {
        return false;
    }

    aiAEC4064B_wave1_run(p, target, true);
    aiAEC4064B_wave2_run(p, target, true);
    aiAEC4064B_wave3_run(p, target, true);
    aiAEC4064B_wave4_run(p, target, true);
    aiAEC4064B_wave5_run(p, target, true);
    aiAEC4064B_wave6_run(p, target, true);
    aiAEC4064B_wave7_run(p, target, true);
    aiAEC4064B_wave8_run(p, target, true);

    while (true) {
        aiAEC4064B_wave6_run(p, target, true);
        aiAEC4064B_wave7_run(p, target, true);
        aiAEC4064B_wave8_run(p, target, true);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void aiAEC4064B_waves_run (int p, playergroup target) {
    aiAEC4064B_waves_runPlayer = p;
    aiAEC4064B_waves_runTarget = PlayerGroupCopy(target);

    TriggerExecute(aiAEC4064B_waves_trigger, false, false);
}

//--------------------------------------------------------------------------------------------------
void aiAEC4064B_waves_enable (int p, bool val) {
    if (p < 0 || p >= 16) {
        return;
    }

    aiAEC4064B_wave1_enable(p, val);
    aiAEC4064B_wave2_enable(p, val);
    aiAEC4064B_wave3_enable(p, val);
    aiAEC4064B_wave4_enable(p, val);
    aiAEC4064B_wave5_enable(p, val);
    aiAEC4064B_wave6_enable(p, val);
    aiAEC4064B_wave7_enable(p, val);
    aiAEC4064B_wave8_enable(p, val);
}

//--------------------------------------------------------------------------------------------------
void aiAEC4064B_waves_stop () {
    TriggerStop(aiAEC4064B_waves_trigger);

    TriggerStop(aiAEC4064B_wave1_trigger);
    TriggerStop(aiAEC4064B_wave2_trigger);
    TriggerStop(aiAEC4064B_wave3_trigger);
    TriggerStop(aiAEC4064B_wave4_trigger);
    TriggerStop(aiAEC4064B_wave5_trigger);
    TriggerStop(aiAEC4064B_wave6_trigger);
    TriggerStop(aiAEC4064B_wave7_trigger);
    TriggerStop(aiAEC4064B_wave8_trigger);
}

