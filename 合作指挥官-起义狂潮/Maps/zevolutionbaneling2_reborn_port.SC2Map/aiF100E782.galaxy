//--------------------------------------------------------------------------------------------------
bool aiF100E782_wave1_runFunc (bool c, bool a) {
    int p = aiF100E782_wave1_runPlayer;
    playergroup target = aiF100E782_wave1_runTarget;
    int d;
    point gatherPoint = null;
    int ta = 0;
    int tg = 0;
    int ts = 0;
    int tf = 0;
    int td = 0;

    if (p < 0 || p >= 16) {
        return false;
    }
    d = PlayerDifficulty(p);
    if (!aiF100E782_wave1_enabled[p]) {
        td = 0;
        if (td > 0) {
            Wait(td, c_timeAI);
        }
        return true;
    }

    aiF100E782_customData[p] = "";

    ta = 0;
    if (d == 1) { ta = 180; }
    if (d == 2) { ta = 180; }
    if (d == 3) { ta = 180; }
    if (d == 4) { ta = 180; }
    tg = 0;
    ts = ta;
    if (tg > 0 && tg < ta) {
        Wait(ta - tg, c_timeAI);
        ts = tg;
    }
    AIAttackWaveSetTargetPlayer(p, target);

    gatherPoint = aiF100E782_defGather[p];
    AIAttackWaveSetGatherPoint(p, gatherPoint);

    AIAttackWaveClearWaypoints(p);

    AIAttackWaveAddUnits(2, 12, "HotSRaptor");
    AIAttackWaveAddUnits(3, 12, "HotSRaptor");
    AIAttackWaveAddUnits(4, 16, "HotSRaptor");
    AIAttackWaveAddUnits(5, 20, "HotSRaptor");

    AIAttackWaveAddUnits(2, 2, "RoachCorpser");
    AIAttackWaveAddUnits(3, 2, "RoachCorpser");
    AIAttackWaveAddUnits(4, 3, "RoachCorpser");
    AIAttackWaveAddUnits(5, 4, "RoachCorpser");

    AIAttackWaveSend(p, ts, false);
    aiF100E782_wave1_lastWave[p] = WaveLastCreated();
    aiF100E782_lastWave[p] = aiF100E782_wave1_lastWave[p];
    Wait(ts, c_timeAI);
    tf = 0;
    if (tf > 0) {
        Wait(tf, c_timeAI);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void aiF100E782_wave1_run (int p, playergroup target, bool wait) {
    aiF100E782_wave1_runPlayer = p;
    aiF100E782_wave1_runTarget = PlayerGroupCopy(target);

    TriggerExecute(aiF100E782_wave1_trigger, false, wait);
}

