//--------------------------------------------------------------------------------------------------
void aiF100E782_start (int p) {
    int init_i;

    if (p < 0 || p >= 16) {
        return;
    }
    if (!aiF100E782_initialized) {
        aiF100E782_wave1_init();
        aiF100E782_wave2_init();
        aiF100E782_wave3_init();
        aiF100E782_wave4_init();
