//--------------------------------------------------------------------------------------------------
// Trigger: P10Attack
//--------------------------------------------------------------------------------------------------
bool gt_P10Attack_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(30.0, c_timeGame);
    lib67C0F0E7_gf_AttackWaveSetI2(10, 4, "ZealotAiur", 3, "Dragoon");
    lib67C0F0E7_gf_AttackWaveCreateP(10, 2, PointFromId(1645538377));
    lib67C0F0E7_gf_WarpinP(lib67C0F0E7_gf_AttackWaveUGGet());
    lib67C0F0E7_gf_PingUnitGroup(lib67C0F0E7_gf_AttackWaveUGGet(), "PingDiamond", Color(0.00, 50.20, 100.00));
    lib67C0F0E7_gf_AttackWaveSend1(lib67C0F0E7_gf_AttackWaveUGGet(), PointFromId(556166669));
    Wait(180.0, c_timeGame);
    lib67C0F0E7_gf_AttackWaveSet(10, 3, 3, "Scout");
    lib67C0F0E7_gf_AttackWaveCreateP(10, 3, PointFromId(1645538377));
    lib67C0F0E7_gf_WarpinP(lib67C0F0E7_gf_AttackWaveUGGet());
    lib67C0F0E7_gf_PingUnitGroup(lib67C0F0E7_gf_AttackWaveUGGet(), "PingDiamond", Color(0.00, 50.20, 100.00));
    lib67C0F0E7_gf_AttackWaveSend1(lib67C0F0E7_gf_AttackWaveUGGet(), PointFromId(556166669));
    Wait(180.0, c_timeGame);
    lib67C0F0E7_gf_AttackWaveAdd(10, 1, 2);
    lib67C0F0E7_gf_AttackWaveCreateP(10, 3, PointFromId(1645538377));
    lib67C0F0E7_gf_WarpinP(lib67C0F0E7_gf_AttackWaveUGGet());
    lib67C0F0E7_gf_PingUnitGroup(lib67C0F0E7_gf_AttackWaveUGGet(), "PingDiamond", Color(0.00, 50.20, 100.00));
    lib67C0F0E7_gf_AttackWaveSend1(lib67C0F0E7_gf_AttackWaveUGGet(), PointFromId(556166669));
    Wait(180.0, c_timeGame);
    lib67C0F0E7_gf_AttackWaveAdd(10, 2, 2);
    lib67C0F0E7_gf_AttackWaveSet(10, 4, 3, "SentryAiur");
    lib67C0F0E7_gf_AttackWaveCreateP(10, 4, PointFromId(1645538377));
    lib67C0F0E7_gf_WarpinP(lib67C0F0E7_gf_AttackWaveUGGet());
    lib67C0F0E7_gf_PingUnitGroup(lib67C0F0E7_gf_AttackWaveUGGet(), "PingDiamond", Color(0.00, 50.20, 100.00));
    lib67C0F0E7_gf_AttackWaveSend1(lib67C0F0E7_gf_AttackWaveUGGet(), PointFromId(556166669));
    Wait(180.0, c_timeGame);
    lib67C0F0E7_gf_AttackWaveAdd(10, 3, 2);
    lib67C0F0E7_gf_AttackWaveCreateP(10, 4, PointFromId(1645538377));
    lib67C0F0E7_gf_WarpinP(lib67C0F0E7_gf_AttackWaveUGGet());
    lib67C0F0E7_gf_PingUnitGroup(lib67C0F0E7_gf_AttackWaveUGGet(), "PingDiamond", Color(0.00, 50.20, 100.00));
    lib67C0F0E7_gf_AttackWaveSend1(lib67C0F0E7_gf_AttackWaveUGGet(), PointFromId(556166669));
    Wait(180.0, c_timeGame);
    while (true) {
        lib67C0F0E7_gf_AttackWaveCreateP(10, 4, PointFromId(1645538377));
        lib67C0F0E7_gf_WarpinP(lib67C0F0E7_gf_AttackWaveUGGet());
        lib67C0F0E7_gf_PingUnitGroup(lib67C0F0E7_gf_AttackWaveUGGet(), "PingDiamond", Color(0.00, 50.20, 100.00));
        lib67C0F0E7_gf_AttackWaveSend1(lib67C0F0E7_gf_AttackWaveUGGet(), PointFromId(556166669));
        Wait(180.0, c_timeGame);
    }
    return true;
}

