//--------------------------------------------------------------------------------------------------
// Trigger: P8 Grendel Attack Waves
//--------------------------------------------------------------------------------------------------
bool gt_P8GrendelAttackWaves_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_aI;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_aI = 8;

    // Actions
    if (!runActions) {
        return true;
    }

    AIAttackWaveSetTargetPlayer(lv_aI, gv_playerAndProtoss);
    AIAttackWaveSetGatherPoint(lv_aI, PointFromId(2044184273));
    Wait(120.0, c_timeGame);
    gf_SetWaypointList(lv_aI, ge_AttackWaveDirections_MidTopToss);
    AIAttackWaveAddUnits4(8, 8, 10, 12, "HotSRaptor");
    AIAttackWaveAddUnits4(4, 4, 5, 6, "Hydralisk");
    AIAttackWaveSend(lv_aI, 60, true);
    gf_SetWaypointList(lv_aI, ge_AttackWaveDirections_MidTopToss);
    AIAttackWaveAddUnits4(4, 4, 5, 6, "Hydralisk");
    AIAttackWaveAddUnits4(4, 4, 5, 6, "Mutalisk");
    AIAttackWaveAddUnits4(1, 1, 1, 2, "Hunterling");
    AIAttackWaveAddUnits4(0, 0, 1, 1, "DefilerMP");
    AIAttackWaveSend(lv_aI, 180, true);
    gf_SetWaypointList(lv_aI, ge_AttackWaveDirections_Top);
    AIAttackWaveAddUnits4(8, 8, 10, 12, "HotSRaptor");
    AIAttackWaveAddUnits4(4, 4, 5, 6, "Mutalisk");
    AIAttackWaveAddUnits4(2, 2, 2, 3, "LurkerMP");
    AIAttackWaveAddUnits4(1, 1, 1, 2, "Guardian");
    AIAttackWaveSend(lv_aI, 180, true);
    gf_SetWaypointList(lv_aI, ge_AttackWaveDirections_MidTopPlayer);
    AIAttackWaveAddUnits4(1, 1, 1, 2, "HotSTorrasque");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Choker");
    AIAttackWaveAddUnits4(3, 3, 4, 4, "Hydralisk");
    AIAttackWaveAddUnits4(1, 1, 2, 3, "Guardian");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Overseer");
    AIAttackWaveSend(lv_aI, 240, true);
    gf_SetWaypointList(lv_aI, ge_AttackWaveDirections_MidTopToss);
    AIAttackWaveAddUnits4(5, 5, 6, 7, "Hydralisk");
    AIAttackWaveAddUnits4(2, 2, 2, 3, "HunterKiller");
    AIAttackWaveAddUnits4(3, 3, 4, 5, "Guardian");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Overseer");
    AIAttackWaveSend(lv_aI, 240, true);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(1114720560), true);
    AIAttackWaveAddUnits4(1, 1, 1, 2, "HotSTorrasque");
    AIAttackWaveAddUnits4(2, 2, 2, 3, "Guardian");
