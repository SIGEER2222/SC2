//--------------------------------------------------------------------------------------------------
bool gt_ReinforceRegionsWithBullies_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(360.0, c_timeGame);
    AIToggleBulliesInRegion(gv_p02_ZERG_EAST, RegionFromId(48), true);
    Wait(420.0, c_timeGame);
    AIToggleBulliesInRegion(gv_p04_ZERG_NORTH, RegionFromId(75), true);
    Wait(360.0, c_timeGame);
    AIToggleBulliesInRegion(gv_p08_ZERG_SOUTH, RegionFromId(66), true);
    Wait(300.0, c_timeGame);
    AIToggleBulliesInRegion(gv_p02_ZERG_EAST, RegionFromId(80), true);
    Wait(180.0, c_timeGame);
    Wait(180.0, c_timeGame);
    gf_CreateNydusWorm("RoachVile", "Kaboomer", "Ultralisk", libNtve_gf_DifficultyValueInt(3, 3, 4, 6), libNtve_gf_DifficultyValueInt(0, 0, 0, 1), libNtve_gf_DifficultyValueInt(0, 0, 1, 2), RegionRandomPoint(RegionFromId(77)), 180.0, 20.0, 10.0, gv_p03_VIROPHAGE);
    if ((libNtve_gf_DifficultyValueInt(0, 0, 1, 1) == 1)) {
        gf_CreateNydusWorm("HotSRaptor", "RoachCorpser", "SwarmHostMP", libNtve_gf_DifficultyValueInt(5, 5, 6, 8), libNtve_gf_DifficultyValueInt(2, 2, 3, 4), libNtve_gf_DifficultyValueInt(0, 0, 1, 2), RegionRandomPoint(RegionFromId(78)), 180.0, 20.0, 10.0, gv_p03_VIROPHAGE);
    }

    if ((libNtve_gf_DifficultyValueInt(0, 0, 0, 1) == 1)) {
        gf_CreateNydusWorm("SwarmHostMP", "Kaboomer", "Guardian", libNtve_gf_DifficultyValueInt(5, 5, 6, 8), libNtve_gf_DifficultyValueInt(0, 0, 0, 1), libNtve_gf_DifficultyValueInt(2, 2, 3, 4), RegionRandomPoint(RegionFromId(79)), 180.0, 20.0, 10.0, gv_p03_VIROPHAGE);
    }

    return true;
}

