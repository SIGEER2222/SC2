//--------------------------------------------------------------------------------------------------
// Trigger: Colonists Betrayed!
//--------------------------------------------------------------------------------------------------
bool gt_ColonistsBetrayed_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnitTarget()) == 1))) {
            return false;
        }

        if (!(((EventPlayer() == gv_p05_COLONIST) || (EventPlayer() == gv_p06_COLONIST) || (EventPlayer() == gv_p09_AGRIAFLEET)))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    libNtve_gf_SetAlliance(gv_p01_USER, gv_p05_COLONIST, libNtve_ge_AllianceSetting_Enemy);
    libNtve_gf_SetAlliance(gv_p01_USER, gv_p06_COLONIST, libNtve_ge_AllianceSetting_Enemy);
    libNtve_gf_SetAlliance(gv_p01_USER, gv_p09_AGRIAFLEET, libNtve_ge_AllianceSetting_Enemy);
    TriggerQueueEnter();
    if ((gv_gameOver == false) && (gv_inCinematic == false)) {
        libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
