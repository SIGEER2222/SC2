//--------------------------------------------------------------------------------------------------
// Trigger: Bile Launcher Missiles
//--------------------------------------------------------------------------------------------------
bool gt_BileLauncherMissiles_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_missileUnit;

    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) == "KorhalSporeCannonMissile"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_missileUnit = EventUnit();
    libNtve_gf_CreatePingFacingAngle(PlayerGroupAll(), "KaiserWormScourgeMissile", UnitGetPosition(lv_missileUnit), ColorWithAlpha(0.00, 100.00, 50.20, 0.00), 0.0, UnitGetFacing(lv_missileUnit));
    libHots_gf_StorePingForUnit(lv_missileUnit, 1, PingLastCreated());
    PingSetUnit(PingLastCreated(), lv_missileUnit);
    PingSetScale(PingLastCreated(), 0.1);
    while (!((UnitIsAlive(EventUnit()) == false))) {
        Wait(0.0625, c_timeGame);
    }
    PingDestroy(libHots_gf_PingStoredForUnit(lv_missileUnit, 1));
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_BileLauncherMissiles_Init () {
    gt_BileLauncherMissiles = TriggerCreate("gt_BileLauncherMissiles_Func");
    TriggerAddEventUnitRegion(gt_BileLauncherMissiles, null, RegionPlayableMap(), true);
}

