// Trigger: Artifact Protection Remover
//--------------------------------------------------------------------------------------------------
bool gt_ArtifactProtectionRemover_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((libNtve_gf_UnitGroupIsDead(gv_artifactGuardianGroup) == true))) {
            return false;
        }

        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    lib67C0F0E7_gf_ObjectiveSet(true, 2, lib67C0F0E7_ge_ObjectiveSet_Finish);
    UnitBehaviorRemove(gv_artifactVault, "InvulnerabilityShield", 1);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_ArtifactProtectionRemover_Init () {
    gt_ArtifactProtectionRemover = TriggerCreate("gt_ArtifactProtectionRemover_Func");
    TriggerEnable(gt_ArtifactProtectionRemover, false);
    TriggerAddEventTimePeriodic(gt_ArtifactProtectionRemover, 2.0, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Start AI
//--------------------------------------------------------------------------------------------------
bool gt_StartAI_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    AICampaignStart(gv_pLAYER02_FLEET);
    AICampaignStart(gv_pLAYER03_FORWARDGUARD);
    AICampaignStart(gv_pLAYER04_PHASESMITHS);
    AICampaignStart(gv_pLAYER07_SCIONS);
    AICampaignStart(gv_pLAYER09_BULLIES);
    AICampaignStart(gv_pLAYER08_DEATHSUN);
    libNtve_gf_DeclareNextTown(gv_pLAYER02_FLEET, PointFromId(354));
    AINearestTownBullyRebuild(gv_pLAYER02_FLEET, true);
    AINearestTownLimitWaveGather(gv_pLAYER02_FLEET, true);
    AIToggleBulliesInRegion(gv_pLAYER03_FORWARDGUARD, RegionFromId(2), true);
    TriggerExecute(gt_P3ForwardGuardAttackWaves, true, false);
    TriggerExecute(gt_P2DeathFleetAttackWaves, true, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_StartAI_Init () {
    gt_StartAI = TriggerCreate("gt_StartAI_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Protoss P03 Gives Up
//--------------------------------------------------------------------------------------------------
bool gt_ProtossP03GivesUp_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_gameOver == false))) {
            return false;
        }

        if (!((gv_inCinematic == false))) {
            return false;
        }

        if (!(((TechTreeUnitCount(gv_pLAYER03_FORWARDGUARD, "Nexus", c_techCountQueuedOrBetter) == 0) || (TechTreeUnitCount(gv_pLAYER03_FORWARDGUARD, "Gateway", c_techCountQueuedOrBetter) == 0)))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    libCamp_gf_CreateMissionAutosavePoint(StringExternal("Param/Value/76749469"));
    TriggerStop(gt_P3ForwardGuardAttackWaves);
    TriggerExecute(gt_P4SmithAttackWaves, true, false);
    TriggerExecute(gt_P7ScionsAttackWaves, true, false);
    TriggerQueueEnter();
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
    libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
    // Transmission - SoundLink("TTychus04TalDarimExecutor00011", -1)
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TTychus04Horner00004", -1), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TTychus04TalDarimExecutor00005", -1), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TTychus04Tychus00012", -1), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    Wait(1.0, c_timeGame);
    TriggerQueueExit();
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_ProtossP03GivesUp_Init () {
    gt_ProtossP03GivesUp = TriggerCreate("gt_ProtossP03GivesUp_Func");
    TriggerAddEventTimePeriodic(gt_ProtossP03GivesUp, 1.0, c_timeGame);
}

