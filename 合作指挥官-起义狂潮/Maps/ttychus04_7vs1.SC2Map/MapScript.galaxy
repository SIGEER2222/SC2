        libNtve_gf_CreateUnitsWithDefaultFacing(1, "Zealot", 0, gv_pLAYER02_FLEET, RegionRandomPoint(RegionFromId(14)));
        UnitGroupAdd(lv_protossDefenseGroup, UnitLastCreated());
    }
    for (auto783CE086_i = 1; auto783CE086_i <= auto783CE086_n; auto783CE086_i += 1) {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "Archon", 0, gv_pLAYER02_FLEET, RegionRandomPoint(RegionFromId(14)));
