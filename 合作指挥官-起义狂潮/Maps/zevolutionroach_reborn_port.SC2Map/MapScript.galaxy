    CameraPan(1, PointFromId(1815642257), 7.0, -1, 10.0, false);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, StringExternal("Param/Value/C8AFC46C"));
    Wait(7.0, c_timeReal);
    CameraPan(1, PointFromId(1006), 6.0, -1, 10.0, false);
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("CrysWarfieldPortrait"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_BottomLeft), "", "Talk", null, StringExternal("Param/Value/C379F754"), StringExternal("Param/Value/71FD6B05"), 7.0, c_transmissionDurationSet, true, c_maxPlayers, false);
    UnitIssueOrder(UnitFromId(1029987073), OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(1006)), c_orderQueueReplace);
    CameraPan(1, PointFromId(1083), 12.0, -1, 10.0, false);
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("CrysRaynorPortrait"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_BottomLeft), "", "Talk", null, StringExternal("Param/Value/496D5955"), StringExternal("Param/Value/9F98D55A"), 7.0, c_transmissionDurationSet, true, c_maxPlayers, false);
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("Kerrigan"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_BottomLeft), "", "Talk", null, StringExternal("Param/Value/1DE3F9A6"), StringExternal("Param/Value/D5CA6ECF"), 7.0, c_transmissionDurationSet, true, c_maxPlayers, false);
    UnitIssueOrder(gv_raynorHero, OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(124148692)), c_orderQueueReplace);
    UnitIssueOrder(gv_tychusHero, OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(2140029022)), c_orderQueueReplace);
    CameraPan(1, PointFromId(2), 7.0, -1, 10.0, false);
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("Kerrigan"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_BottomLeft), "", "Talk", null, StringExternal("Param/Value/936FD916"), StringExternal("Param/Value/09AC6659"), 7.0, c_transmissionDurationSet, true, c_maxPlayers, false);
