            libCamp_gf_SendTransmissionCampaign(null, SoundLink("TValerian03Horner00065", -1), c_transmissionDurationAdd, 0.0, true);
        }
        else {
        }
    }
    libSwaC_gf_SetAllSoundChannelVolumesCampaign(libSwaC_ge_VolumeChannelModeCampaign_Game);
    TriggerQueueExit();
    return true;
}

