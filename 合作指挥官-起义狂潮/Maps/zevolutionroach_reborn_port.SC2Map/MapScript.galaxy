//--------------------------------------------------------------------------------------------------
// Trigger: Crys Event Order
//--------------------------------------------------------------------------------------------------
bool gt_CrysEventOrder_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TechTreeAbilityAllow(1, AbilityCommand("EnergyNova", 0), false);
    lib48DF4533_gf_AllySetup(gv_raynor, "Raynor");
    TriggerExecute(gt_AllyResourceIncome, false, false);
    TriggerExecute(gt_AllyResearch, false, false);
    TriggerExecute(gt_AllyBullies, false, false);
    TriggerExecute(gt_RaynorDefenders, false, false);
    Wait(3.0, c_timeGame);
    lib48DF4533_gf_AllySetup(gv_raynor, "Dominion Elite");
    lib48DF4533_gf_AllySetup(gv_bradley, "Dominion Elite");
    lib48DF4533_gf_AllySetup(gv_mengsk, "Dominion Elite");
    Wait(2.0, c_timeGame);
    TriggerQueueEnter();
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("CrysRaynorPortrait"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "", "Talk", SoundLink("CantinaFidgetsTrophyTZeratul042Raynor00001", -1), StringExternal("Param/Value/4F1B9E91"), StringExternal("Param/Value/36B21147"), 7.0, c_transmissionDurationSet, false, c_maxPlayers, false);
    TriggerQueueExit();
    Wait(90.0, c_timeGame);
    AISetGroupSuicide(UnitGroup(null, gv_pLAYER_ZERG_MAIN, RegionFromId(40), UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterBenign - 32)) | (1 << (c_targetFilterPassive - 32))), 0), true);
    Wait(60.0, c_timeGame);
    TriggerExecute(gt_Tychus1, false, false);
    Wait(90.0, c_timeGame);
    if ((lib48DF4533_gf_SetAllHatcheriesRallyPoints2() == true)) {
        TriggerExecute(gt_RuthlessWave1, false, false);
    }

    libSwaC_gf_CreateMissionAutosavePoint(StringToText(""));
    Wait(60.0, c_timeGame);
    TriggerExecute(gt_Warfield1, false, false);
    Wait(60.0, c_timeGame);
    if ((lib48DF4533_gf_SetAllHatcheriesRallyPoints2() == true)) {
        TriggerExecute(gt_RuthlessWave2, false, false);
    }

    Wait(30.0, c_timeGame);
    TriggerExecute(gt_Raynor1, false, false);
    Wait(90.0, c_timeGame);
    TriggerExecute(gt_RaynorNydusHunters, false, false);
    Wait(30.0, c_timeGame);
    TriggerExecute(gt_BradleyAirHunters, false, false);
    if ((lib48DF4533_gf_SetAllHatcheriesRallyPoints2() == true)) {
        TriggerExecute(gt_RuthlessWave3, false, false);
    }

    Wait(30.0, c_timeGame);
    TriggerExecute(gt_Kerrigan2, false, false);
    libSwaC_gf_CreateMissionAutosavePoint(StringToText(""));
    Wait(120.0, c_timeGame);
    if ((lib48DF4533_gf_SetAllHatcheriesRallyPoints2() == true)) {
        TriggerExecute(gt_RuthlessWave4, false, false);
    }

    TriggerExecute(gt_Tychus2, false, false);
    Wait(120.0, c_timeGame);
    if ((lib48DF4533_gf_SetAllHatcheriesRallyPoints2() == true)) {
        TriggerExecute(gt_RuthlessWave5, false, false);
    }

    TriggerExecute(gt_Kerrigan3, false, false);
    Wait(60.0, c_timeGame);
    if ((lib48DF4533_gf_SetAllHatcheriesRallyPoints2() == true)) {
        TriggerExecute(gt_RuthlessWave6, false, false);
    }

    Wait(60.0, c_timeGame);
    TriggerExecute(gt_Warfield2, false, false);
    Wait(60.0, c_timeGame);
    libSwaC_gf_CreateMissionAutosavePoint(StringToText(""));
    if ((lib48DF4533_gf_SetAllHatcheriesRallyPoints2() == true)) {
        TriggerExecute(gt_RuthlessWave7, false, false);
    }

    Wait(90.0, c_timeGame);
    if ((lib48DF4533_gf_SetAllHatcheriesRallyPoints2() == true)) {
        TriggerExecute(gt_RuthlessWave8, false, false);
    }

    Wait(120.0, c_timeGame);
    libSwaC_gf_CreateMissionAutosavePoint(StringToText(""));
    if ((lib48DF4533_gf_SetAllHatcheriesRallyPoints2() == true)) {
        TriggerExecute(gt_RuthlessWave9, false, false);
    }

    Wait(120.0, c_timeGame);
    libSwaC_gf_CreateMissionAutosavePoint(StringToText(""));
    if ((lib48DF4533_gf_SetAllHatcheriesRallyPoints2() == true)) {
        TriggerExecute(gt_RuthlessWave10, false, false);
    }

    return true;
}

