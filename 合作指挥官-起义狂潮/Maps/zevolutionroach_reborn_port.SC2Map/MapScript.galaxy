//--------------------------------------------------------------------------------------------------
// Trigger: Kerrigan Retreating from Low Life
//--------------------------------------------------------------------------------------------------
bool gt_KerriganRetreatingfromLowLife_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup auto1DD65D10_g;
    int auto1DD65D10_u;
    unit auto1DD65D10_var;

    // Actions
    if (!runActions) {
        return true;
    }

    while (true) {
        Wait(1.0, c_timeGame);
        if ((UnitIsAlive(gv_theQueenofBlades) == false)) {
            return true;
        }

        if ((UnitGetPropertyFixed(gv_theQueenofBlades, c_unitPropLife, c_unitPropCurrent) <= 150.0)) {
            PingSetVisible(gv_kerriganPing, false);
            AIRemoveUnitFromAnyWaves(gv_theQueenofBlades);
            AISetUnitScriptControlled(gv_theQueenofBlades, true);
            UnitBehaviorRemove(gv_theQueenofBlades, "Stunned", 1);
            UnitBehaviorRemove(gv_theQueenofBlades, "UltrasonicPulseStun", 1);
            UnitSetState(gv_theQueenofBlades, c_unitStateTargetable, false);
            UnitSetState(gv_theQueenofBlades, c_unitStateSelectable, false);
            UnitSetState(gv_theQueenofBlades, c_unitStateStatusBar, false);
            libNtve_gf_MakeUnitInvulnerable(gv_theQueenofBlades, true);
            UnitIssueOrder(gv_theQueenofBlades, Order(AbilityCommand("Val03QueenOfBladesBurrow", 0)), c_orderQueueReplace);
            TriggerExecute(gt_KerriganDeepTunnelQ, true, false);
            Wait(3.6, c_timeGame);
            auto1DD65D10_g = UnitGroup("HunterKiller", gv_pLAYER_ZERG_MAIN, RegionCircle(UnitGetPosition(gv_theQueenofBlades), 16.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
            auto1DD65D10_u = UnitGroupCount(auto1DD65D10_g, c_unitCountAll);
            for (;; auto1DD65D10_u -= 1) {
                auto1DD65D10_var = UnitGroupUnitFromEnd(auto1DD65D10_g, auto1DD65D10_u);
                if (auto1DD65D10_var == null) { break; }
                AIRemoveUnitFromAnyWaves(auto1DD65D10_var);
                UnitIssueOrder(auto1DD65D10_var, OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(gv_artifact)), c_orderQueueReplace);
            }
            libNtve_gf_ShowHideUnit(gv_theQueenofBlades, false);
            UnitSetPosition(gv_theQueenofBlades, PointFromId(132), false);
            UnitSetPropertyFixed(gv_theQueenofBlades, c_unitPropLifePercent, 100.0);
            UnitSetOwner(gv_theQueenofBlades, 0, false);
            UnitIssueOrder(gv_theQueenofBlades, Order(AbilityCommand("Val03QueenOfBladesUnburrow", 0)), c_orderQueueReplace);
            libNtve_gf_PlayAnimationOnDoodadsInRegion(RegionCircle(PointFromId(132), 16.0), "QueenChamber", c_animNameDefault, "Stand Work Start", c_animFlagPlayForever | c_animFlagNonLooping, c_animTimeDefault);
            Wait(1.0, c_timeGame);
            libNtve_gf_PlayAnimationOnDoodadsInRegion(RegionCircle(PointFromId(132), 16.0), "QueenChamber", c_animNameDefault, "Stand Work", c_animFlagPlayForever, c_animTimeDefault);
            Wait(1.0, c_timeGame);
            UnitSetFacing(gv_theQueenofBlades, 315.0, 0.0);
            Wait(0.5, c_timeGame);
            libNtve_gf_PauseUnit(gv_theQueenofBlades, true);
            gv_kerriganHasRetreated = true;
        }

    }
    return true;
}

