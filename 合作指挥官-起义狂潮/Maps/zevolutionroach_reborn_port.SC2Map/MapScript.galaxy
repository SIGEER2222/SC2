    if (!runActions) {
        return true;
    }

    while (true) {
        Wait(1.0, c_timeAI);
        gv_artifactChargeCurrent += gv_artifactChargeIncrement;
        if ((gv_artifactChargeCurrent >= gv_artifactChargeMax)) {
            gv_artifactChargeCurrent = gv_artifactChargeMax;
            TriggerExecute(gt_ArtifactCharged, true, false);
            return true;
        }

    }
    return true;
}

