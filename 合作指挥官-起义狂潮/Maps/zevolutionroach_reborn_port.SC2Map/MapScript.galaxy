// Trigger: Kerrigan Cleanup
//--------------------------------------------------------------------------------------------------
bool gt_KerriganCleanup_Func (bool testConds, bool runActions) {
    // Variable Declarations
    fixed lv_fadeDuration;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    lib48DF4533_gf_SaveCutsceneSkip("Challenge 2 Kerrigan");
    UnitPauseAll(false);
    UnitRemove(gv_cINEKerrigan);
    libNtve_gf_ShowHideUnit(gv_theQueenofBlades, true);
    GameTimeOfDayPause(false);
    PlayerSetState(gv_pLAYER_USER, c_playerStateXPGain, true);
    PlayerSetState(gv_pLAYER_ZERG_MAIN, c_playerStateFidgetingEnabled, true);
    libNtve_gf_PlayAnimationOnDoodadsInRegion(RegionCircle(PointFromId(132), 16.0), "QueenChamber", c_animNameDefault, "Stand", c_animFlagPlayForever, c_animTimeDefault);
    CameraApplyInfo(gv_pLAYER_USER, CameraInfoDefault(), 0.0, -1, 10, false);
    libNtve_gf_CinematicMode(false, PlayerGroupAll(), lv_fadeDuration);
    libNtve_gf_GlobalCinematicSetting(false);
    libNtve_gf_SwooshCamera(gv_pLAYER_USER, ((CameraInfoGetValue(CameraInfoDefault(), c_cameraValueDistance)) + 8.0), CameraInfoGetValue(CameraInfoDefault(), c_cameraValueDistance), PlayerStartLocation(gv_pLAYER_USER), 1.5);
    CinematicFade(true, lv_fadeDuration, c_fadeStyleNormal, ColorWithAlpha(0.00, 0.00, 0.00, 0.00), 0.0, true);
    gv_inCinematic = false;
    gv_kerriganHasRetreated = false;
    gv_kerriganMaxHP = lib48DF4533_gf_DifficultyValueCrys(4000, 4000, 5000, 6000, 7000);
    gv_kerriganRazorSwarmCooldown = lib48DF4533_gf_DifficultyValueCrys(6, 6, 5, 5, 4);
    gv_kerriganImplosionCooldown = lib48DF4533_gf_DifficultyValueCrys(6, 6, 5, 4, 4);
    gv_kerriganEscortNumber = lib48DF4533_gf_DifficultyValueCrys(6, 6, 8, 10, 12);
    TriggerStop(gt_KerriganRetreatingfromLowLife);
    UnitBehaviorRemove(gv_theQueenofBlades, "TValerian03QueenOfBladesDontDie", 1);
    TriggerExecute(gt_SpawnKerriganWave2, false, false);
    TriggerExecute(gt_ObjectiveKerriganCreate, false, false);
    if ((UnitIsAlive(gv_theQueenofBlades) == false)) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, StringExternal("Param/Value/933E9756"));
    }

    return true;
}

