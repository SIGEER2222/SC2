//--------------------------------------------------------------------------------------------------
// Trigger: Intro Cinematic
//--------------------------------------------------------------------------------------------------
bool gt_IntroCinematic_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((lib48DF4533_gf_SetAllHatcheriesRallyPoints3("Challenge 2 Intro") == true)) {
        TriggerSkippableBegin(PlayerGroupAll(), 0, null, true, false);
    }

    CameraApplyInfo(gv_pLAYER_USER, CameraInfoFromId(525), 0.0, -1, 10, true);
    CinematicFade(true, 1.0, c_fadeStyleNormal, ColorWithAlpha(0.00, 0.00, 0.00, 0.00), 0.0, false);
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("CrysNarudPortrait"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_BottomLeft), "", "Talk", SoundLink("zBriefing_Hybrid03_Narud_008", -1), StringExternal("Param/Value/C8FB411F"), StringExternal("Param/Value/AC85B391"), 7.0, c_transmissionDurationSet, true, c_maxPlayers, false);
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("zMission_Hybrid02_Kerrigan_161", -1), c_transmissionDurationAdd, 0.0, true);
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("CrysNarudPortrait"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_BottomLeft), "", "Talk", null, StringExternal("Param/Value/78E37D07"), StringExternal("Param/Value/1FB42A9F"), 7.0, c_transmissionDurationSet, true, c_maxPlayers, false);
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("KerriganPrimalPortraitAddition"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_BottomLeft), "", "Talk", null, StringExternal("Param/Value/6EB7C216"), StringExternal("Param/Value/DED4F004"), 7.0, c_transmissionDurationSet, true, c_maxPlayers, false);
    CameraApplyInfo(gv_pLAYER_USER, CameraInfoFromId(550), 0.0, -1, 10, true);
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("CrysNarudPortrait"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_BottomLeft), "", "Talk", null, StringExternal("Param/Value/494610B5"), StringExternal("Param/Value/E4CC30FA"), 7.0, c_transmissionDurationSet, true, c_maxPlayers, false);
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("CrysNarudPortrait"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_BottomLeft), "", "Talk", null, StringExternal("Param/Value/18A0A224"), StringExternal("Param/Value/C76CD4BC"), 7.0, c_transmissionDurationSet, true, c_maxPlayers, false);
    CameraApplyInfo(gv_pLAYER_USER, CameraInfoFromId(552), 0.0, -1, 10, true);
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("Kerrigan"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_BottomLeft), "", "Talk", null, StringExternal("Param/Value/01F2AC4F"), StringExternal("Param/Value/33598A13"), 7.0, c_transmissionDurationSet, true, c_maxPlayers, false);
    TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSourceFromModel("CrysNarudPortrait"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_BottomLeft), "", "Talk", null, StringExternal("Param/Value/35746C52"), StringExternal("Param/Value/F97B1D6A"), 7.0, c_transmissionDurationSet, true, c_maxPlayers, false);
    CameraApplyInfo(gv_pLAYER_USER, CameraInfoFromId(1878), 0.0, -1, 10, true);
    libNtve_gf_UnitCreateFacingPoint(1, "KerriganChar", 0, gv_pLAYER_ZERG_MAIN, PointFromId(132), PointFromId(2));
    gv_cINEKerrigan = UnitLastCreated();
    libNtve_gf_ShowHideUnit(gv_cINEKerrigan, false);
    UnitBehaviorAdd(gv_cINEKerrigan, "KerriganWalk", gv_cINEKerrigan, 1);
    libNtve_gf_PlayAnimationOnDoodadsInRegion(RegionEntireMap(), "QueenChamber", c_animNameDefault, "Stand Work", c_animFlagPlayForever, c_animTimeDefault);
    gv_introCinematicCompleted = false;
    CameraApplyInfo(gv_pLAYER_USER, CameraInfoFromId(1266), 9.0, -1, 10, true);
    CinematicFade(true, 2.0, c_fadeStyleNormal, ColorWithAlpha(0.00, 0.00, 0.00, 0.00), 0.0, true);
    TriggerExecute(gt_IntroKerriganAnimations, true, false);
    Wait(2.0, c_timeGame);
    // Transmission - SoundLink("TValerian03Kerrigan00046", -1)
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TValerian03Kerrigan00046", -1), c_transmissionDurationAdd, 0.0, true);
    SoundPlay(SoundLink("UI_TerranKlaxonAlert", -1), PlayerGroupAll(), 100.0, 0.0);
    Wait(2.0, c_timeReal);
    CameraApplyInfo(gv_pLAYER_USER, CameraInfoFromId(1858), 0.0, -1, 10, true);
    CameraApplyInfo(gv_pLAYER_USER, CameraInfoFromId(1879), (SoundLengthSync(SoundLink("TValerian03Adjutant00068", -1)) - 1.0), -1, 10, true);
    // Transmission - SoundLink("TValerian03Adjutant00068", -1)
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TValerian03Adjutant00068", -1), c_transmissionDurationAdd, 0.0, true);
