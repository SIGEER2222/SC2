<?xml version="1.0" encoding="utf-8"?>
<Catalog>
    <!-- 排除选中按钮：基地施法者，点击单位目标后该单位不再被"选中全部单位"(F2) 选中，方便分兵 -->
    <!-- 改为 CAbilEffectTarget 类型，支持点选目标单位 -->
    <CAbilEffectTarget id="AHExcludeFromSelectAll">
        <EditorCategories value="AbilityorEffectType:Units"/>
        <Levels value="1"/>
        <Flags index="BestUnit" value="1"/>
        <!-- 目标：可见的任何单位，排除自身/导弹/死单位/隐藏/无敌 -->
        <TargetFilters value="Visible;Self,Missile,Dead,Hidden,Invulnerable"/>
        <!-- 覆盖整张地图（任意距离可施法） -->
        <Range value="500"/>
        <CmdButtonArray index="Execute" DefaultButtonFace="AHExcludeFromSelectAllButton">
            <Flags index="UseDefaultButton" value="1"/>
            <Flags index="CreateDefaultButton" value="1"/>
        </CmdButtonArray>
    </CAbilEffectTarget>
</Catalog>
