// 按索引取单位 ID
string libAbathurHeartCatalog_gf_UnitAt (int lp_modIndex, int lp_unitIndex) {
    int lv_offset;
    int lv_count;
    if ((lp_modIndex < 0) || (lp_modIndex >= gv_c_AH_ModCount)) {
        return "";
    }
    lv_offset = gv_AH_UnitOffsets[lp_modIndex];
    lv_count = gv_AH_UnitCounts[lp_modIndex];
    if ((lp_unitIndex < 0) || (lp_unitIndex >= lv_count)) {
        return "";
    }
    return gv_AH_Units[lv_offset + lp_unitIndex];
}

// 按标签查找指挥官索引
int libAbathurHeartCatalog_gf_ModIndexOf (string lp_label) {
    int lv_i;
    for (lv_i = 0; lv_i < gv_c_AH_ModCount; lv_i += 1) {
        if (gv_AH_ModLabels[lv_i] == lp_label) {
            return lv_i;
        }
    }
    return -1;
}
