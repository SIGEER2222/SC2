//==================================================================================================
//
// Generated Map Script - 阿巴瑟之心 mod 单位测试
// 依赖: C:\Users\22448\Downloads\阿巴瑟之心\Mods 下全部 mod
// 用途: 把每个 mod 的所有自定义单位按 mod 来源分块生成到地图上，便于逐个查看
//
//==================================================================================================
include "TriggerLibs/NativeLib"
include "LibAbathurHeartCatalog"

//--------------------------------------------------------------------------------------------------
// 全局控制变量
//--------------------------------------------------------------------------------------------------
// gv_activeModIndex:
//   -1  = 生成全部 mod（默认，按 6 列 x N 行布局铺开）
//   0..N = 仅生成指定 mod（在中心位置生成）
int gv_activeModIndex = -1;

// gv_commanderFilter:
//   ""  = 不过滤（按 gv_activeModIndex 决定生成范围）
//   非空 = 在全部 mod 中筛选 identifier 包含该字符串的组（不区分大小写）
//   例: "Cmdr_Abathur" / "Violets_Kerrigan" / "Violets_"（前缀匹配所有 Violets 子组）
// 当前: "Cmdr_Taldarim" 只生成塔达林便于查看 Taldarim 单位
string gv_commanderFilter = "Cmdr_Taldarim";

//--------------------------------------------------------------------------------------------------
// 聊天指令相关全局变量
//--------------------------------------------------------------------------------------------------
// 内置预设皮肤 collection（来自官方 SkinData.xml）
const int gv_c_SkinPresetCount = 12;
string[12] gv_skinPresets;

// 内置 D.Va 播报员奖励 ID
const int gv_c_DVaRewardCount = 3;
string[3] gv_dvaRewards;

//--------------------------------------------------------------------------------------------------
// Library Initialization
//--------------------------------------------------------------------------------------------------
void InitLibs () {
    libNtve_InitLib();
    libAbathurHeartCatalog_InitLib();

    // 初始化预设数据
    gv_skinPresets[0] = "Taldarim";
    gv_skinPresets[1] = "Blizzcon17";
    gv_skinPresets[2] = "Mecha";
    gv_skinPresets[3] = "Nerazim";
    gv_skinPresets[4] = "Judicator";
    gv_skinPresets[5] = "CollectorEdition";
    gv_skinPresets[6] = "Eidolon";
    gv_skinPresets[7] = "Deluxe";
    gv_skinPresets[8] = "Bone";
    gv_skinPresets[9] = "Aquatic";
    gv_skinPresets[10] = "Adun";
    gv_skinPresets[11] = "AmonBrood";

    gv_dvaRewards[0] = "VoicePackTerranBlizzConDVa";
    gv_dvaRewards[1] = "VoicePackZergBlizzConDVa";
    gv_dvaRewards[2] = "VoicePackProtossBlizzConDVa";
}

//--------------------------------------------------------------------------------------------------
// 辅助函数: 生成一个 mod 的所有单位
//--------------------------------------------------------------------------------------------------
void gf_SpawnModUnits (int modIndex, fixed baseX, fixed baseY, int perRow, fixed spacing) {
    int lv_count;
    int lv_i;
    int lv_created;
    int lv_skipped;
    int lv_col;
    int lv_row;
    string lv_unitType;
    point lv_pos;

    lv_count = gv_AH_UnitCounts[modIndex];
    lv_created = 0;
    lv_skipped = 0;

    for (lv_i = 0; lv_i < lv_count; lv_i += 1) {
        lv_unitType = libAbathurHeartCatalog_gf_UnitAt(modIndex, lv_i);
        if (lv_unitType != "") {
            if (CatalogEntryIsValid(c_gameCatalogUnit, lv_unitType) == false) {
                lv_skipped += 1;
            }
            else {
                lv_col = lv_created - (lv_created / perRow) * perRow;
                lv_row = lv_created / perRow;
                lv_pos = Point(baseX + (lv_col * spacing), baseY - (lv_row * spacing));
                // 边界检查：避免生成在地图外（y < 1 时跳过，防止 ScriptError "无效的位置"）
                if (PointGetY(lv_pos) < 1.0) {
                    lv_skipped += 1;
                }
                else {
                    libNtve_gf_CreateUnitsWithDefaultFacing(1, lv_unitType, c_unitCreateIgnorePlacement, 1, lv_pos);
                    lv_created += 1;
                }
            }
        }
    }
}

//--------------------------------------------------------------------------------------------------
// 辅助函数: 判断指挥官 identifier 是否匹配过滤字符串
//   - filter 为空 → 总是匹配
//   - 非空 → 不区分大小写，identifier 包含 filter 即匹配
//--------------------------------------------------------------------------------------------------
bool gf_CommanderMatchesFilter (string identifier, string filter) {
    if (filter == "") {
        return true;
    }
    if (StringFind(identifier, filter, false) > 0) {
        return true;
    }
    return false;
}

//--------------------------------------------------------------------------------------------------
// 生成全部指挥官组：5 列 x N 行布局
//   - 若 gv_commanderFilter 非空，只生成匹配的组，并居中排列在地图中央
//   - 无过滤时从左上角 (4, 124) 铺开全部 25 个组
//--------------------------------------------------------------------------------------------------
void gf_SpawnAllMods () {
    int lv_cols = 5;
    fixed lv_blockW = 22.0;
    fixed lv_blockH = 26.0;
    int lv_perRow = 8;
    fixed lv_spacing = 2.5;

    int lv_modIndex;
    int lv_matchedCount;
    int lv_visibleIndex;
    int lv_col;
    int lv_row;
    fixed lv_startX;
    fixed lv_startY;
    fixed lv_x;
    fixed lv_y;
    fixed lv_mapCenterX;
    fixed lv_mapCenterY;
    fixed lv_totalWidth;
    fixed lv_totalHeight;
    string lv_identifier;
    region lv_mapRegion;
    point lv_minPoint;
    point lv_maxPoint;

    // 先统计匹配的组数
    lv_matchedCount = 0;
    for (lv_modIndex = 0; lv_modIndex < gv_c_AH_ModCount; lv_modIndex += 1) {
        lv_identifier = gv_AH_ModIdentifiers[lv_modIndex];
        if (gf_CommanderMatchesFilter(lv_identifier, gv_commanderFilter)) {
            lv_matchedCount += 1;
        }
    }

    if (lv_matchedCount == 0) {
        return;
    }

    // 不论是否过滤，都动态获取地图边界并让所有区块在地图内居中
    lv_mapRegion = RegionEntireMap();
    lv_minPoint = RegionGetBoundsMin(lv_mapRegion);
    lv_maxPoint = RegionGetBoundsMax(lv_mapRegion);
    lv_mapCenterX = (PointGetX(lv_minPoint) + PointGetX(lv_maxPoint)) / 2.0;
    lv_mapCenterY = (PointGetY(lv_minPoint) + PointGetY(lv_maxPoint)) / 2.0;

    // 计算匹配组占用的总宽高，让整体居中
    // 列数 = min(匹配数, 5)；行数 = ceil(匹配数 / 5)
    if (lv_matchedCount < lv_cols) {
        lv_totalWidth = (lv_matchedCount - 1) * lv_blockW;
    }
    else {
        lv_totalWidth = (lv_cols - 1) * lv_blockW;
    }
    lv_totalHeight = ((lv_matchedCount - 1) / lv_cols) * lv_blockH;

    // 起始点 = 中心 - 总宽高的一半
    // 单个 block 内部：8 个单位 perRow，spacing 2.8，宽 22.4，高 ~N*2.8
    // 把 block 的左上角对齐到 (中心 - 总宽/2, 中心 + 总高/2)
    lv_startX = lv_mapCenterX - (lv_totalWidth / 2.0);
    lv_startY = lv_mapCenterY + (lv_totalHeight / 2.0);

    lv_visibleIndex = 0;
    for (lv_modIndex = 0; lv_modIndex < gv_c_AH_ModCount; lv_modIndex += 1) {
        lv_identifier = gv_AH_ModIdentifiers[lv_modIndex];
        if (gf_CommanderMatchesFilter(lv_identifier, gv_commanderFilter)) {
            lv_col = lv_visibleIndex - (lv_visibleIndex / lv_cols) * lv_cols;
            lv_row = lv_visibleIndex / lv_cols;
            lv_x = lv_startX + (lv_col * lv_blockW);
            lv_y = lv_startY - (lv_row * lv_blockH);
            gf_SpawnModUnits(lv_modIndex, lv_x, lv_y, lv_perRow, lv_spacing);
            lv_visibleIndex += 1;
        }
    }
}

//--------------------------------------------------------------------------------------------------
// 仅生成一个 mod：放在地图中央偏上
//--------------------------------------------------------------------------------------------------
void gf_SpawnSingleMod (int modIndex) {
    fixed lv_centerX = 30.0;
    fixed lv_centerY = 110.0;
    int lv_perRow = 8;
    fixed lv_spacing = 3.0;
    gf_SpawnModUnits(modIndex, lv_centerX, lv_centerY, lv_perRow, lv_spacing);
}

//--------------------------------------------------------------------------------------------------
// Trigger Variables
//--------------------------------------------------------------------------------------------------
trigger gt_spawnUnits;

//--------------------------------------------------------------------------------------------------
// Trigger: 生成单位
//--------------------------------------------------------------------------------------------------
bool gt_spawnUnits_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }

    if (gv_commanderFilter != "") {
        gf_SpawnAllMods();
    }
    else if (gv_activeModIndex == -1) {
        gf_SpawnAllMods();
    }
    else {
        if ((gv_activeModIndex >= 0) && (gv_activeModIndex < gv_c_AH_ModCount)) {
            gf_SpawnSingleMod(gv_activeModIndex);
        }
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_spawnUnits_Init () {
    gt_spawnUnits = TriggerCreate("gt_spawnUnits_Func");
    TriggerAddEventMapInit(gt_spawnUnits);
}

//--------------------------------------------------------------------------------------------------
// 聊天指令触发器（参考 RevolutionOverdrive 缝合版 Lib6B3CCD85.galaxy 实现）
// 每个指令单独一个触发器，用 c_playerAny + exact=true 注册
// 这样引擎自带消息过滤，无需在脚本里解析字符串
//--------------------------------------------------------------------------------------------------

// 在地图中央显示漂浮文字（替代不可用的 TriggerDebugOutput）
int gv_debugTextCount = 0;

void gf_DebugPrint (string msg) {
    point lv_pos;
    playergroup lv_allPlayers;
    int lv_tag;
    fixed lv_x;
    fixed lv_y;

    lv_x = 30.0;
    lv_y = 110.0 - (IntToFixed(gv_debugTextCount) * 3.0);
    if (lv_y < 20.0) {
        gv_debugTextCount = 0;
        lv_y = 110.0;
    }
    lv_pos = Point(lv_x, lv_y);
    lv_allPlayers = PlayerGroupAll();
    lv_tag = TextTagCreate(StringToText(msg), 24, lv_pos, 0.0, true, false, lv_allPlayers);
    TextTagSetMaxSize(lv_tag, 30.0, 5.0);
    gv_debugTextCount = gv_debugTextCount + 1;
}

// 把玩家1的所有单位从 fromType 替换为 toType（参考 lib6B3CCD85 模式）
void gf_ReplaceAllUnits (string fromType, string toType) {
    unitgroup autoGroup;
    int autoCount;
    unit autoUnit;

    autoGroup = UnitGroup(null, 1, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
    autoCount = UnitGroupCount(autoGroup, c_unitCountAll);
    for (;; autoCount -= 1) {
        autoUnit = UnitGroupUnitFromEnd(autoGroup, autoCount);
        if (autoUnit == null) { break; }
        if ((UnitGetType(autoUnit) == fromType)) {
            libNtve_gf_ReplaceUnit(autoUnit, toType, libNtve_ge_ReplaceUnitOptions_OldUnitsRelative);
        }
    }
}

