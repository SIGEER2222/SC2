//--------------------------------------------------------------------------------------------------
// 自动测试触发器：游戏加载后间隔执行各指令，自动验证
// 时序（秒）：
//   5  : -test        验证聊天框架
//   10 : -help        显示指令列表
//   15 : -taldarim2vanilla  把 Taldarim 4Zealot2 替换为原版 Zealot（验证皮肤替换机制）
//   22 : -taldarimrestore   把原版 Zealot 换回 4Zealot2
//   29 : -dva         D.Va 提示（mod 环境下 PlayerAddReward 不可用）
//   36 : 测试完成
//--------------------------------------------------------------------------------------------------
trigger gt_autoTest;
int gv_autoTestStep = 0;
timer gv_autoTestTimer;

bool gt_autoTest_Func (bool testConds, bool runActions) {
    int lv_step;
    if (!runActions) { return true; }

    gv_autoTestStep = gv_autoTestStep + 1;
    lv_step = gv_autoTestStep;

    if (lv_step == 1) {
        gf_DebugPrint("[AUTO 5s] -test");
        gf_DebugPrint("[OK] chat trigger works");
    }
    else if (lv_step == 2) {
        gf_DebugPrint("[AUTO 10s] -help");
        gf_DebugPrint("cmds: -test -help -taldarim2vanilla -taldarimrestore -dva");
    }
    else if (lv_step == 3) {
        gf_DebugPrint("[AUTO 15s] -taldarim2vanilla 4Zealot2->Zealot");
        // 把 Taldarim 4Zealot2 替换为原版 Zealot（验证 ReplaceUnit 对 Taldarim 单位有效）
        gf_ReplaceAllUnits("4Zealot2", "Zealot");
    }
    else if (lv_step == 4) {
        gf_DebugPrint("[AUTO 22s] -taldarimrestore Zealot->4Zealot2");
        // 把原版 Zealot 换回 Taldarim 4Zealot2
        gf_ReplaceAllUnits("Zealot", "4Zealot2");
    }
    else if (lv_step == 5) {
        gf_DebugPrint("[AUTO 29s] -dva (mod 环境下 PlayerAddReward 不可用，仅提示)");
    }
    else if (lv_step == 6) {
        gf_DebugPrint("[AUTO 36s] test done, can input cmds manually");
        return true;
    }

    // 重新启动定时器，下一次触发间隔 7 秒（首次 5 秒已在 Init 中设置）
    TimerStart(gv_autoTestTimer, 7.0, false, c_timeGame);
    return true;
}

void gt_autoTest_Init () {
    gv_autoTestTimer = TimerCreate();
    gt_autoTest = TriggerCreate("gt_autoTest_Func");
    TriggerAddEventTimer(gt_autoTest, gv_autoTestTimer);
    // 首次 5 秒后触发（等游戏加载和单位生成完成）
    TimerStart(gv_autoTestTimer, 5.0, false, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger Initialization
//--------------------------------------------------------------------------------------------------
void InitTriggers () {
    gt_spawnUnits_Init();
    gt_cmd_test_Init();
    gt_cmd_help_Init();
    gt_cmd_dva_Init();
    gt_cmd_skinTaldarim_Init();
    gt_cmd_skinBlizzcon17_Init();
    gt_cmd_skinReset_Init();
    gt_cmd_replace_Init();
    gt_cmd_mengsk2vanilla_Init();
    gt_cmd_mengskrestore_Init();
    gt_cmd_taldarim2vanilla_Init();
    gt_cmd_taldarimrestore_Init();
    gt_cmd_skinlist_Init();
    gt_cmd_rewardlist_Init();
    gt_autoTest_Init();
}

//--------------------------------------------------------------------------------------------------
// Map Initialization
//--------------------------------------------------------------------------------------------------
void InitMap () {
    InitLibs();
    InitTriggers();
}
