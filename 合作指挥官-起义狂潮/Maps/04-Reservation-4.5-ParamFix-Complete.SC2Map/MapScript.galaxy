//--------------------------------------------------------------------------------------------------
bool gt_EndingCinematic_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_CinematicMode(true, PlayerGroupAll(), c_transitionDurationDefault);
    TriggerEnable(gt_MissionFailedTeaBoneDies, false);
    VisEnable(c_visTypeFog, false);
    RegionPlayableMapSet(RegionEntireMap());
    TriggerExecute(gt_EndingCinPt1, true, false);
    return true;
}

