// Trigger: Stranded 01a
//--------------------------------------------------------------------------------------------------
bool gt_Stranded01a_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == 1))) {
            return false;
        }

        if (!((TriggerGetExecCount(TriggerGetCurrent()) == 0))) {
            return false;
        }

        if (!((UnitFilterMatch(EventUnit(), 1, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)))) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UISetMode(PlayerGroupAll(), c_uiModeFullscreen, 2.0);
    libNtve_gf_CinematicMode(true, PlayerGroupAll(), 0.0);
    libNtve_gf_GlobalCinematicSetting(true);
    CinematicFade(false, 1.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, false);
    Wait(0.5, c_timeGame);
    CinematicFade(true, 1.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, false);
    CameraApplyInfo(1, CameraInfoFromId(4453), 0.0, -1, 10.0, true);
    TriggerSkippableBegin(PlayerGroupAll(), 0, gt_Stranded01b, true, false);
    SoundChannelSetVolume(PlayerGroupAll(), c_soundCategoryMusic, 60.0, 5.0);
    libNtve_gf_ShareVisionofUnit(UnitFromId(195), true, 1);
    libNtve_gf_ShareVisionofUnit(UnitFromId(4525), true, 1);
    libNtve_gf_ShareVisionofUnit(UnitFromId(38), true, 1);
    libNtve_gf_ShowHideUnit(gv_teaBone, false);
    libNtve_gf_ShowHideUnit(gv_kaiser, false);
    libNtve_gf_ShowHideUnit(UnitFromId(4214), false);
    libNtve_gf_ShowHideUnit(UnitFromId(3225), false);
    VisRevealArea(1, RegionFromId(39), 8.0, false);
    UnitSetTeamColorIndex(UnitFromId(57), 6);
    UnitSetTeamColorIndex(UnitFromId(39), 6);
    UnitSetTeamColorIndex(UnitFromId(38), 6);
    UnitSetTeamColorIndex(UnitFromId(37), 6);
    libNtve_gf_ShowHideUnit(UnitFromId(4525), true);
    libNtve_gf_ShowHideUnit(UnitFromId(4526), true);
    UnitSetTeamColorIndex(UnitFromId(4526), 1);
    UnitSetTeamColorIndex(UnitFromId(4525), 1);
    UnitIssueOrder(UnitFromId(4526), OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(4524)), c_orderQueueReplace);
    UnitIssueOrder(UnitFromId(4525), OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(4523)), c_orderQueueReplace);
    SoundChannelSetVolume(PlayerGroupAll(), c_soundCategoryVoice, 100.0, 5.0);
    SoundPlay(SoundLink("Dialogue_TransmissionStart", -1), PlayerGroupAll(), 165.0, 0.0);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(4525), true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/0B13C463"), StringExternal("Param/Value/8B8B6F6B"), 4.0, c_transmissionDurationAdd, true);
    libNtve_gf_MakeUnitFacePoint(UnitFromId(195), UnitGetPosition(UnitFromId(4526)), 0.7);
    libNtve_gf_MakeUnitFacePoint(UnitFromId(196), UnitGetPosition(UnitFromId(4526)), 0.7);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(196), true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/ADA9EFD3"), StringExternal("Param/Value/DE64F076"), 4.0, c_transmissionDurationAdd, true);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(gv_teaBone, true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/E1677920"), StringExternal("Param/Value/3D61B8DC"), 8.0, c_transmissionDurationAdd, true);
    CameraApplyInfo(1, CameraInfoFromId(4605), 6.0, -1, 10.0, true);
    SoundChannelSetVolume(PlayerGroupAll(), c_soundCategoryVoice, 100.0, 5.0);
    SoundPlay(SoundLink("Dialogue_TransmissionStart", -1), PlayerGroupAll(), 165.0, 0.0);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(196), true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/62BBF23C"), StringExternal("Param/Value/B4BB2C52"), 4.0, c_transmissionDurationAdd, true);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(4526), true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/D1E35DC6"), StringExternal("Param/Value/63858415"), 5.0, c_transmissionDurationAdd, true);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(195), true, true, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", SoundLink("zMission_Space02_DominionFirebat_110", -1), StringExternal("Param/Value/0EE298BA"), StringExternal("Param/Value/38281AC7"), 4.0, c_transmissionDurationAdd, true);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(4525), true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/D7808DE5"), StringExternal("Param/Value/F319CAB6"), 4.0, c_transmissionDurationAdd, true);
