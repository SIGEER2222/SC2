    gt_ButtonFlashKaiserchargeOn_Init();
    gt_ButtonPrimalRoarOff_Init();
    gt_ButtonPrimalRoarOn_Init();
    gt_KaiserPrimalRoar_Init();
    gt_MissionObjectivesNukes_Init();
    gt_NukeSilosObjectiveUpdate_Init();
    gt_TossSpectreEnterNukeSilosBlokA_Init();
    gt_HintsStart_Init();
    gt_HintsHealth_Init();
