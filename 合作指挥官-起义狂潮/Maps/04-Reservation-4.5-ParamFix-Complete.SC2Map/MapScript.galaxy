//--------------------------------------------------------------------------------------------------
// Trigger: OverrideSettings
//--------------------------------------------------------------------------------------------------
bool gt_OverrideSettings_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    PlayerGroupLoopBegin(PlayerGroupAll());
    while (!PlayerGroupLoopDone()) {
        PlayerOptionOverride(PlayerGroupLoopCurrent(), "selectuncontrolable", "1");
        PlayerOptionOverride(PlayerGroupLoopCurrent(), "simplecommandcard", "0");
        PlayerOptionOverride(PlayerGroupLoopCurrent(), "gametooltips", "1");
        PlayerGroupLoopStep();
    }
    PlayerGroupLoopEnd();
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_OverrideSettings_Init () {
    gt_OverrideSettings = TriggerCreate("gt_OverrideSettings_Func");
    TriggerAddEventMapInit(gt_OverrideSettings);
}

//--------------------------------------------------------------------------------------------------
// Trigger: DifficultySelector
//--------------------------------------------------------------------------------------------------
bool gt_DifficultySelector_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    CinematicFade(false, 0.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    libNtve_gf_HideGameUI(false, PlayerGroupAll());
    DialogCreate(600, 250, c_anchorCenter, 0, 0, true);
    gv_difficultySelectorV = DialogLastCreated();
    libNtve_gf_CreateDialogItemLabel(gv_difficultySelectorV, 200, 50, c_anchorTop, 0, 60, StringExternal("Param/Value/582FCF77"), Color(100,100,100), false, 2.0);
    gv_difficultyText = DialogControlLastCreated();
    libNtve_gf_CreateDialogItemButton(gv_difficultySelectorV, 120, 60, c_anchorBottom, 0, 50, StringExternal("Param/Value/9CD5246D"), StringExternal("Param/Value/CBBDA5A4"), "");
    gv_difficultNormal = DialogControlLastCreated();
    libNtve_gf_CreateDialogItemButton(gv_difficultySelectorV, 120, 60, c_anchorBottomRight, 50, 50, StringExternal("Param/Value/1D5F7DBF"), StringExternal("Param/Value/2988F03D"), "");
    gv_difficultHard = DialogControlLastCreated();
    DialogSetVisible(gv_difficultySelectorV, PlayerGroupAll(), true);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_DifficultySelector_Init () {
    gt_DifficultySelector = TriggerCreate("gt_DifficultySelector_Func");
    TriggerAddEventMapInit(gt_DifficultySelector);
}

//--------------------------------------------------------------------------------------------------
// Trigger: DifficultySelectedNormal
//--------------------------------------------------------------------------------------------------
bool gt_DifficultySelectedNormal_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((EventDialogControl() == gv_difficultNormal))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    DialogControlDestroy(gv_difficultEasy);
    DialogControlDestroy(gv_difficultNormal);
    DialogControlDestroy(gv_difficultHard);
    DialogControlDestroy(gv_difficultyText);
    Wait(1.0, c_timeGame);
    libNtve_gf_CreateDialogItemLabel(gv_difficultySelectorV, 400, 50, c_anchorCenter, 75, 0, StringExternal("Param/Value/1D72D9EA"), Color(100,100,100), true, 2.0);
    gv_difficultyText = DialogControlLastCreated();
    Wait(5.0, c_timeGame);
    DialogControlDestroy(gv_difficultyText);
    DialogDestroy(gv_difficultySelectorV);
    gv_diffNormal = true;
    libNtve_gf_HideGameUI(true, PlayerGroupAll());
    AchievementPanelSetVisible(PlayerGroupAll(), false);
    UISetFrameVisible(PlayerGroupAll(), c_syncFrameTypeAchievementMenuButton, false);
    HelpPanelShowTechTreeRace(PlayerGroupAll(), "Neut", false);
    HelpPanelShowTechTreeRace(PlayerGroupAll(), "Prot", false);
    HelpPanelShowTechTreeRace(PlayerGroupAll(), "Terr", false);
    HelpPanelShowTechTreeRace(PlayerGroupAll(), "Zerg", false);
    TechTreeUnitHelpDefault(1, false);
    PlayerOptionOverride(1, "simplecommandcard", "0");
    PlayerOptionOverride(1, "selectuncontrolable", "1");
    TriggerExecute(gt_CinematicInit, true, true);
    TriggerExecute(gt_StartHealthNormal, true, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
