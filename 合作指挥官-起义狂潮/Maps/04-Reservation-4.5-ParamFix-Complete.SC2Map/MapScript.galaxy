//--------------------------------------------------------------------------------------------------
// Trigger: Dream 02b
//--------------------------------------------------------------------------------------------------
bool gt_Dream02b_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((TriggerGetExecCount(TriggerGetCurrent()) == 0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_CinematicMode(false, PlayerGroupAll(), c_transitionDurationImmediate);
    libNtve_gf_GlobalCinematicSetting(false);
    CameraApplyInfo(1, CameraInfoFromId(4687), 0.0, -1, 10.0, true);
    VisEnable(c_visTypeFog, true);
    UnitSetPosition(gv_kaiser, PointFromId(15), false);
    UnitSetPosition(gv_teaBone, PointFromId(6), false);
    libNtve_gf_MakeUnitFacePoint(gv_kaiser, UnitGetPosition(gv_teaBone), 0.7);
    libNtve_gf_MakeUnitFacePoint(gv_teaBone, UnitGetPosition(gv_kaiser), 0.7);
    UnitSelect(gv_teaBone, 1, true);
    UnitSelect(gv_kaiser, 1, true);
    Wait(1.0, c_timeGame);
    SoundChannelSetVolume(PlayerGroupAll(), c_soundCategoryVoice, 100.0, 5.0);
    SoundPlay(SoundLink("Dialogue_TransmissionStart", -1), PlayerGroupAll(), 140.0, 0.0);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(gv_teaBone, true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/A5546B55"), StringExternal("Param/Value/F4CA0968"), 4.0, c_transmissionDurationAdd, true);
    return true;
}

