//--------------------------------------------------------------------------------------------------
void gt_MissionCompleteHiveDestroyed_Init () {
    gt_MissionCompleteHiveDestroyed = TriggerCreate("gt_MissionCompleteHiveDestroyed_Func");
    TriggerAddEventTimePeriodic(gt_MissionCompleteHiveDestroyed, 1.0, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Mission Complete - Hive Destroyed- skIPPED
//--------------------------------------------------------------------------------------------------
bool gt_MissionCompleteHiveDestroyedskIPPED_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    GameSetNextMap("Confrontation");
    UISetMode(PlayerGroupAll(), c_uiModeFullscreen, 1.0);
    Wait(1.0, c_timeGame);
    UIShowTextCrawl(PlayerGroupAll(), StringExternal("Param/Value/C9FF61E5"), StringExternal("Param/Value/2BC3A071"), 10.0, SoundLink("30SecondSilence", -1), SoundLink("30SecondSilence", 0));
    Wait(5.0, c_timeGame);
    GameOver(1, c_gameOverVictory, false, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_MissionCompleteHiveDestroyedskIPPED_Init () {
    gt_MissionCompleteHiveDestroyedskIPPED = TriggerCreate("gt_MissionCompleteHiveDestroyedskIPPED_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: BorderShip
//--------------------------------------------------------------------------------------------------
bool gt_BorderShip_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    UnitGroupLoopBegin(UnitGroupSearch("Marine", c_playerAny, PointFromId(188), 2.0, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    while (!UnitGroupLoopDone()) {
        UnitRemove(UnitGroupLoopCurrent());
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();
    UnitGroupLoopBegin(UnitGroupSearch("Firebat", c_playerAny, PointFromId(188), 2.0, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    while (!UnitGroupLoopDone()) {
        UnitRemove(UnitGroupLoopCurrent());
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();
    UnitGroupLoopBegin(UnitGroupSearch("Marine", c_playerAny, PointFromId(189), 2.0, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    while (!UnitGroupLoopDone()) {
        UnitRemove(UnitGroupLoopCurrent());
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();
    UnitGroupLoopBegin(UnitGroupSearch("Firebat", c_playerAny, PointFromId(189), 2.0, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    while (!UnitGroupLoopDone()) {
        UnitRemove(UnitGroupLoopCurrent());
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();
    UnitGroupLoopBegin(UnitGroupSearch("Nova", c_playerAny, PointFromId(190), 2.0, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    while (!UnitGroupLoopDone()) {
        UnitRemove(UnitGroupLoopCurrent());
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_BorderShip_Init () {
    gt_BorderShip = TriggerCreate("gt_BorderShip_Func");
    TriggerAddEventTimePeriodic(gt_BorderShip, 1.0, c_timeGame);
}

