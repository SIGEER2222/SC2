//--------------------------------------------------------------------------------------------------
// Trigger: StartGame
//--------------------------------------------------------------------------------------------------
bool gt_StartGame_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_CinematicMode(false, PlayerGroupAll(), 0.0);
    libNtve_gf_GlobalCinematicSetting(false);
    SoundtrackStop(PlayerGroupAll(), c_soundtrackCategoryMusic, false);
    CameraApplyInfo(1, CameraInfoDefault(), 0.0, -1, 10.0, true);
    RegionPlayableMapSet(RegionFromId(1));
    CameraPan(1, PointFromId(1133), 0.0, -1, 10.0, false);
    gv_dropship = UnitFromId(1137);
    VisEnable(c_visTypeFog, true);
    TriggerExecute(gt_Dropship, true, false);
    UISetFrameVisible(PlayerGroupAll(), c_syncFrameTypeSupply, false);
    UISetResourceVisible(PlayerGroupAll(), c_resourceTypeMinerals, false);
    UISetResourceVisible(PlayerGroupAll(), c_resourceTypeVespene, false);
    UISetFrameVisible(PlayerGroupAll(), c_syncFrameTypeAchievementMenuButton, false);
    HelpPanelShowTechTreeRace(PlayerGroupAll(), "Neut", false);
    HelpPanelShowTechTreeRace(PlayerGroupAll(), "Prot", false);
    HelpPanelShowTechTreeRace(PlayerGroupAll(), "Terr", false);
    HelpPanelShowTechTreeRace(PlayerGroupAll(), "Zerg", false);
    TechTreeUnitHelpDefault(1, false);
    UIHideTextCrawl(PlayerGroupAll());
    CinematicFade(true, 1.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    UnitSelect(gv_teaBone, 1, true);
    UnitSelect(gv_kaiser, 1, true);
    Wait(1.0, c_timeGame);
    SoundChannelMute(PlayerGroupAll(), c_soundCategoryAmbient, false);
    SoundChannelMute(PlayerGroupAll(), c_soundCategoryMusic, false);
    SoundtrackSetShuffle(PlayerGroupAll(), c_soundtrackCategoryMusic, true, true);
    SoundChannelSetVolume(PlayerGroupAll(), c_soundCategoryVoice, 100.0, 15.0);
    SoundPlay(SoundLink("Dialogue_TransmissionStart", -1), PlayerGroupAll(), 140.0, 0.0);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(4517), true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/EA035B7B"), StringExternal("Param/Value/424BF95D"), 7.0, c_transmissionDurationAdd, true);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(4517), true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/71D8911F"), StringExternal("Param/Value/1E975B1E"), 7.0, c_transmissionDurationAdd, true);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(1), true, true, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/A266371A"), StringExternal("Param/Value/E1F139D5"), 4.0, c_transmissionDurationAdd, true);
    ObjectiveCreate(StringExternal("Param/Value/3AA6AEBC"), StringExternal("Param/Value/B6F29B65"), c_objectiveStateActive, true);
    gv_objective1 = ObjectiveLastCreated();
    ObjectiveCreate(StringExternal("Param/Value/1BD288DE"), StringExternal("Param/Value/CD5A644A"), c_objectiveStateActive, true);
    gv_objective2 = ObjectiveLastCreated();
    Wait(2.0, c_timeGame);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(25), true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", SoundLink("Dehaka_Help", -1), StringExternal("Param/Value/E37E4C9A"), StringExternal("Param/Value/649E13BA"), 5.0, c_transmissionDurationAdd, true);
    TriggerExecute(gt_HintsStart, true, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_StartGame_Init () {
    gt_StartGame = TriggerCreate("gt_StartGame_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Dropship
//--------------------------------------------------------------------------------------------------
bool gt_Dropship_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    UnitSetHeight(gv_dropship, 2.75, 4.0);
    Wait(4.0, c_timeGame);
    UnitSetHeight(gv_dropship, 10.0, 3.0);
    UnitSetPropertyFixed(gv_dropship, c_unitPropMovementSpeed, (UnitGetPropertyFixed(gv_dropship, c_unitPropMovementSpeed, c_unitPropCurrent) + 1.0));
    UnitIssueOrder(gv_dropship, OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(1134)), c_orderQueueReplace);
    UnitIssueOrder(gv_dropship, OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(1135)), c_orderQueueAddToEnd);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_Dropship_Init () {
    gt_Dropship = TriggerCreate("gt_Dropship_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: DropshipRemove
//--------------------------------------------------------------------------------------------------
bool gt_DropshipRemove_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((gv_dropship == EventUnit()))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitGroupLoopBegin(UnitGroup(null, 2, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    while (!UnitGroupLoopDone()) {
        UnitRemove(UnitGroupLoopCurrent());
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_DropshipRemove_Init () {
    gt_DropshipRemove = TriggerCreate("gt_DropshipRemove_Func");
    TriggerAddEventUnitRangePoint(gt_DropshipRemove, null, PointFromId(1135), 2.0, true);
}

