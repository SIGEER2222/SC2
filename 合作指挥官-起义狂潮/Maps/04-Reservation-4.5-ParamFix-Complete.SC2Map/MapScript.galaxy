    gt_MissionFailedFriendlyFire = TriggerCreate("gt_MissionFailedFriendlyFire_Func");
    TriggerAddEventUnitDamaged(gt_MissionFailedFriendlyFire, null, c_unitDamageTypeAny, c_unitDamageFatal, null);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Teach - Kaiser Charge!
//--------------------------------------------------------------------------------------------------
bool gt_TeachKaiserCharge_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == 1))) {
            return false;
        }

        if (!((TriggerGetExecCount(TriggerGetCurrent()) == 0))) {
            return false;
        }

        if (!((UnitFilterMatch(EventUnit(), 1, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)))) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_ShareVisionofUnit(UnitFromId(4553), true, 1);
    libNtve_gf_ShareVisionofUnit(UnitFromId(4549), true, 1);
    libNtve_gf_ShowHideUnit(UnitFromId(4214), false);
    libNtve_gf_ShowHideUnit(UnitFromId(3225), false);
    libNtve_gf_MakeUnitFacePoint(UnitFromId(4553), UnitGetPosition(UnitFromId(4549)), 0.7);
    MinimapPing(PlayerGroupAll(), PointFromId(4458), 3.0, Color(100.00, 0.00, 0.00));
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(4553), true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/421B28C5"), StringExternal("Param/Value/371EA3F1"), 6.0, c_transmissionDurationAdd, true);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(4549), true, true, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", SoundLink("CharAmbientMarine300003", -1), StringExternal("Param/Value/3C6DB5B5"), StringExternal("Param/Value/1A3F0DFC"), 4.0, c_transmissionDurationAdd, false);
    Wait(4.0, c_timeGame);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(gv_kaiser, true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/9893FBAE"), StringExternal("Param/Value/73DA5307"), 3.0, c_transmissionDurationAdd, true);
    Wait(1.3, c_timeGame);
    UnitSelect(gv_teaBone, 1, true);
    UnitSelect(gv_kaiser, 1, true);
    TechTreeAbilityAllow(1, AbilityCommand("PsiStrikeWalk", 0), true);
    HelpPanelAddTip(PlayerGroupAll(), libNtve_gf_FormatTipTitle(StringExternal("Param/Value/6D188D55"), 3), StringExternal("Param/Value/9B4A3F64"), StringExternal("Param/Value/AF76E013"), "icon_pack_11\\Flinks-icons-5\\btn-flinks-zerg-ability-primalcharge2.dds");
    TriggerExecute(gt_ButtonFlashKaiserchargeOn, true, false);
    return true;
}

