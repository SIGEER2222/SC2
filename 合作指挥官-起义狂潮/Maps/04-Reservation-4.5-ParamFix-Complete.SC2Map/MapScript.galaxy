//--------------------------------------------------------------------------------------------------
// Trigger: Attack01 - Zergling
//--------------------------------------------------------------------------------------------------
bool gt_Attack01Zergling_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == 1))) {
            return false;
        }

        if (!((TriggerGetExecCount(TriggerGetCurrent()) == 0))) {
            return false;
        }

        if (!((UnitFilterMatch(EventUnit(), 1, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)))) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    Wait(1.0, c_timeGame);
    UnitIssueOrder(UnitFromId(4537), Order(AbilityCommand("BurrowZerglingUp", 0)), c_orderQueueReplace);
    UnitIssueOrder(UnitFromId(4538), Order(AbilityCommand("BurrowZerglingUp", 0)), c_orderQueueReplace);
    UnitIssueOrder(UnitFromId(4535), Order(AbilityCommand("BurrowZerglingUp", 0)), c_orderQueueReplace);
    UnitIssueOrder(UnitFromId(4536), Order(AbilityCommand("BurrowZerglingUp", 0)), c_orderQueueReplace);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(25), true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/5307896A"), StringExternal("Param/Value/3A67B699"), 3.0, c_transmissionDurationAdd, true);
    Wait(8.0, c_timeGame);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(1), true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/7443E9AA"), StringExternal("Param/Value/DD87AB86"), 3.0, c_transmissionDurationAdd, true);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(1), true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/7D2EDB0E"), StringExternal("Param/Value/8B3AA15C"), 6.0, c_transmissionDurationAdd, true);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(1), true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/341AC4AF"), StringExternal("Param/Value/72DBFEBF"), 5.0, c_transmissionDurationAdd, true);
    return true;
}

