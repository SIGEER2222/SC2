//--------------------------------------------------------------------------------------------------
// Trigger: MissionFailed - Friendly Fire
//--------------------------------------------------------------------------------------------------
bool gt_MissionFailedFriendlyFire_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == 6))) {
            return false;
        }

        if (!((UnitGetOwner(EventUnitDamageSourceUnit()) == 1))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    GameSetNextMap("Evacuation");
    UISetMode(PlayerGroupAll(), c_uiModeFullscreen, 1.0);
    Wait(1.0, c_timeGame);
    UIShowTextCrawl(PlayerGroupAll(), StringExternal("Param/Value/97E56793"), StringExternal("Param/Value/38DF2AA7"), 10.0, SoundLink("30SecondSilence", -1), SoundLink("30SecondSilence", 0));
    Wait(6.0, c_timeGame);
    GameOver(1, c_gameOverDefeat, false, false);
    return true;
}

