//--------------------------------------------------------------------------------------------------
// Trigger: Kaiser Primal Roar
//--------------------------------------------------------------------------------------------------
bool gt_KaiserPrimalRoar_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    if (true) {
        SoundChannelSetVolume(PlayerGroupAll(), c_soundCategoryVoice, 100.0, 4.0);
        SoundPlayOnUnit(SoundLink("PrimalUltralisk_Ready", -1), PlayerGroupActive(), EventUnit(), 0.0, 140.0, 0.0);
        libNtve_gf_AttachModelToUnit(gv_kaiser, "PlaguebringerCloud", "Origin");
        DataTableSetActor(true, "KaiserClaw1", libNtve_gf_ActorLastCreated());
        libNtve_gf_AttachModelToUnit(gv_kaiser, "K5KerriganFuryBuff", "Origin");
        DataTableSetActor(true, "KaiserClaw2", libNtve_gf_ActorLastCreated());
        Wait(0.1, c_timeGame);
        UnitBehaviorAdd(gv_kaiser, "DamageTakenNone", gv_kaiser, 1);
        Wait(5.0, c_timeGame);
        SoundPlayOnUnit(SoundLink("PrimalZergling_Yes", -1), PlayerGroupActive(), EventUnit(), 0.0, 140.0, 0.0);
        libNtve_gf_KillModel(DataTableGetActor(true, "KaiserClaw1"));
        libNtve_gf_KillModel(DataTableGetActor(true, "KaiserClaw2"));
        Wait(0.1, c_timeGame);
        UnitBehaviorRemove(gv_kaiser, "DamageTakenNone", 1);
    }
    else {
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_KaiserPrimalRoar_Init () {
    gt_KaiserPrimalRoar = TriggerCreate("gt_KaiserPrimalRoar_Func");
    TriggerAddEventUnitAbility(gt_KaiserPrimalRoar, UnitRefFromVariable("gv_kaiser"), AbilityCommand("PrimalRoarX", 255), c_abilEffectStageCast, false);
}

