    TechTreeUpgradeAddLevel(1, "TerranInfantryArmorsVanadiumPlatingLevel1", 1);
    TechTreeUpgradeAddLevel(1, "TerranInfantryArmorsVanadiumPlatingLevel2", 1);
    TechTreeUpgradeAddLevel(1, "TerranInfantryArmorsVanadiumPlatingLevel3", 1);
    TechTreeUpgradeAddLevel(1, "TerranInfantryArmorsLevel3", 1);
    TechTreeUpgradeAddLevel(1, "TerranInfantryWeaponsUltraCapacitorsLevel1", 1);
    TechTreeUpgradeAddLevel(1, "TerranInfantryWeaponsUltraCapacitorsLevel2", 1);
    TechTreeUpgradeAddLevel(1, "TerranInfantryWeaponsUltraCapacitorsLevel3", 1);
    TechTreeUpgradeAddLevel(1, "TerranInfantryWeaponsLevel3", 1);
    TechTreeUpgradeAddLevel(1, "ShieldWall", 1);
    TechTreeUpgradeAddLevel(1, "MarineStimpack", 1);
    TechTreeUpgradeAddLevel(1, "CombatShield", 1);
    TechTreeAbilityAllow(1, AbilityCommand("PsiStrikeWalk", 0), false);
    TechTreeAbilityAllow(1, AbilityCommand("PrimalRoarX", 0), false);
    return true;
}

