//--------------------------------------------------------------------------------------------------
// Trigger: Weaponchange Tea Bone Rapid-Default
//--------------------------------------------------------------------------------------------------
bool gt_WeaponchangeTeaBoneRapidDefault_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitWeaponGet(UnitFromId(789), 1) == "GrenadeLauncher")) {
        SoundPlayOnUnit(SoundLink("Core_BeamLaunch", 2), PlayerGroupActive(), UnitFromId(789), 0.0, 110.0, 0.0);
        UnitWeaponRemove(UnitFromId(789), "GrenadeLauncher");
        Wait(0.1, c_timeGame);
        UnitWeaponAdd(UnitFromId(789), "TaurenSpaceMarineGaussRifle", null);
        UnitSetTeamColorIndex(gv_teaBone, 1);
    }
    else {
        if ((UnitWeaponGet(UnitFromId(789), 1) == "FlameThrowe")) {
            SoundPlayOnUnit(SoundLink("Core_BeamLaunch", 2), PlayerGroupActive(), UnitFromId(789), 0.0, 110.0, 0.0);
            UnitWeaponRemove(UnitFromId(789), "FlameThrowe");
            Wait(0.1, c_timeGame);
            UnitWeaponAdd(UnitFromId(789), "TaurenSpaceMarineGaussRifle", null);
            UnitSetTeamColorIndex(gv_teaBone, 1);
        }
        else {
        }
    }
    return true;
}

