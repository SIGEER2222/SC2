//--------------------------------------------------------------------------------------------------
// Trigger: Final Intro B
//--------------------------------------------------------------------------------------------------
bool gt_FinalIntroB_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((TriggerGetExecCount(TriggerGetCurrent()) == 0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_CinematicMode(false, PlayerGroupAll(), c_transitionDurationImmediate);
    libNtve_gf_GlobalCinematicSetting(false);
    CameraApplyInfo(1, CameraInfoFromId(4718), 0.0, -1, 10.0, true);
    VisEnable(c_visTypeFog, true);
    UnitSetPropertyFixed(UnitFromId(4590), c_unitPropLifeMax, 90.0);
    UnitSetPropertyFixed(UnitFromId(4590), c_unitPropLife, 90.0);
    UnitSetPropertyFixed(UnitFromId(4589), c_unitPropLifeMax, 90.0);
    UnitSetPropertyFixed(UnitFromId(4589), c_unitPropLife, 90.0);
    UnitSetPropertyFixed(UnitFromId(3700), c_unitPropLifeMax, 140.0);
    UnitSetPropertyFixed(UnitFromId(3700), c_unitPropLife, 140.0);
    UnitSetPropertyFixed(UnitFromId(4213), c_unitPropLifeMax, 140.0);
    UnitSetPropertyFixed(UnitFromId(4213), c_unitPropLife, 140.0);
    UnitSetPosition(gv_kaiser, PointFromId(4668), false);
    UnitSetPosition(gv_teaBone, PointFromId(4669), false);
    libNtve_gf_ShowHideUnit(gv_teaBone, true);
    libNtve_gf_ShowHideUnit(gv_kaiser, true);
    libNtve_gf_ShowHideUnit(UnitFromId(4667), false);
    libNtve_gf_ShowHideUnit(UnitFromId(4666), false);
    UnitSelect(gv_teaBone, 1, true);
    UnitSelect(gv_kaiser, 1, true);
    UnitSetOwner(UnitFromId(4590), 6, true);
    UnitSetOwner(UnitFromId(4589), 6, true);
    UnitSetOwner(UnitFromId(3700), 6, true);
    UnitSetOwner(UnitFromId(4213), 6, true);
    UnitSetOwner(UnitFromId(2353), 6, true);
    UnitIssueOrder(UnitFromId(3700), OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(4671)), c_orderQueueReplace);
    UnitIssueOrder(UnitFromId(4213), OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(4671)), c_orderQueueReplace);
    UnitIssueOrder(UnitFromId(4590), OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(4671)), c_orderQueueReplace);
    UnitIssueOrder(UnitFromId(4589), OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(4671)), c_orderQueueReplace);
    UnitIssueOrder(UnitFromId(2353), OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(4671)), c_orderQueueReplace);
    return true;
}

