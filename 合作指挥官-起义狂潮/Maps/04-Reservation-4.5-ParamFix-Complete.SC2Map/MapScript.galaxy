    gt_Taunt = TriggerCreate("gt_Taunt_Func");
    TriggerAddEventUnitAbility(gt_Taunt, null, AbilityCommand("DummyTaunt", 255), c_unitAbilStageAll, false);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Mission Complete - Hive Destroyed
//--------------------------------------------------------------------------------------------------
bool gt_MissionCompleteHiveDestroyed_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((UnitGroupCount(UnitGroup("SpawningPool", 4, RegionEntireMap(), UnitFilter((1 << c_targetFilterPreventDefeat), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) == 0))) {
            return false;
        }

        if (!((UnitGroupCount(UnitGroup("Hatchery", 4, RegionEntireMap(), UnitFilter((1 << c_targetFilterPreventDefeat), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) == 0))) {
            return false;
        }

        if (!((UnitGroupCount(UnitGroup("Extractor", 4, RegionEntireMap(), UnitFilter((1 << c_targetFilterPreventDefeat), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) == 0))) {
            return false;
        }

        if (!((UnitGroupCount(UnitGroup("EvolutionChamber", 4, RegionEntireMap(), UnitFilter((1 << c_targetFilterPreventDefeat), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) == 0))) {
            return false;
        }

        if (!((UnitGroupCount(UnitGroup("Drone", 4, RegionEntireMap(), UnitFilter((1 << c_targetFilterPreventDefeat), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) == 0))) {
            return false;
        }

        if (!((TriggerGetExecCount(TriggerGetCurrent()) == 0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    VisEnable(c_visTypeFog, false);
    ObjectiveSetState(gv_objective1, c_objectiveStateCompleted);
    ObjectiveSetState(gv_objective2, c_objectiveStateCompleted);
    UnitSetOwner(UnitFromId(4590), 0, false);
    UnitSetOwner(UnitFromId(4589), 0, false);
    UnitSetOwner(UnitFromId(3700), 0, false);
    UnitSetOwner(UnitFromId(4213), 0, false);
    UnitSetOwner(UnitFromId(2353), 0, false);
    UnitSetOwner(gv_teaBone, 0, false);
    UnitSetOwner(gv_kaiser, 0, false);
    Wait(3.0, c_timeGame);
    UISetMode(PlayerGroupAll(), c_uiModeFullscreen, 2.0);
    libNtve_gf_CinematicMode(true, PlayerGroupAll(), 0.0);
    libNtve_gf_GlobalCinematicSetting(true);
    CinematicFade(false, 2.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, false);
    Wait(0.6, c_timeGame);
    CinematicFade(true, 2.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, false);
    Wait(0.1, c_timeGame);
    TriggerSkippableBegin(PlayerGroupAll(), 0, gt_MissionCompleteHiveDestroyedskIPPED, true, false);
    CameraApplyInfo(1, CameraInfoFromId(4725), 0.0, -1, 10.0, true);
    SoundChannelSetVolume(PlayerGroupAll(), c_soundCategoryMusic, 90.0, 15.0);
    SoundPlay(SoundLink("THorner01MusicOutro", -1), PlayerGroupAll(), 120.0, 0.0);
    libNtve_gf_ShowHideUnit(UnitFromId(4722), true);
    libNtve_gf_ShowHideUnit(UnitFromId(4723), true);
    libNtve_gf_ShowHideUnit(UnitFromId(4724), true);
    libNtve_gf_ShowHideUnit(UnitFromId(4733), true);
    libNtve_gf_ShowHideUnit(UnitFromId(4719), true);
    libNtve_gf_ShowHideUnit(UnitFromId(4728), true);
    libNtve_gf_ShowHideUnit(UnitFromId(4720), true);
    libNtve_gf_ShowHideUnit(UnitFromId(4721), true);
    UnitSetTeamColorIndex(UnitFromId(4722), 6);
    UnitSetTeamColorIndex(UnitFromId(4723), 6);
    UnitSetTeamColorIndex(UnitFromId(4724), 6);
    UnitSetTeamColorIndex(UnitFromId(4733), 6);
    UnitSetTeamColorIndex(UnitFromId(4720), 1);
    UnitSetTeamColorIndex(UnitFromId(4721), 1);
    UnitSetTeamColorIndex(UnitFromId(4719), 1);
    SoundChannelSetVolume(PlayerGroupAll(), c_soundCategoryVoice, 100.0, 5.0);
    SoundPlay(SoundLink("zSMAmbient_PrimalZergAdvisor_PrimalZergAdvisor_021", -1), PlayerGroupAll(), 200.0, 0.0);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(4721), true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/2549818E"), StringExternal("Param/Value/697E4F45"), 5.0, c_transmissionDurationAdd, true);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(4722), true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/9CD56748"), StringExternal("Param/Value/569BF7F0"), 3.0, c_transmissionDurationAdd, true);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(4721), true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/08E74731"), StringExternal("Param/Value/D4BAF9AD"), 3.0, c_transmissionDurationAdd, true);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(UnitFromId(4723), true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/16899736"), StringExternal("Param/Value/0E4ABC85"), 3.0, c_transmissionDurationAdd, true);
