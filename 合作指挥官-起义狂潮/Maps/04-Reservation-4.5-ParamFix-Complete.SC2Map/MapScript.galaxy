    gt_EndingCinematic = TriggerCreate("gt_EndingCinematic_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: EndingCin Pt.1
//--------------------------------------------------------------------------------------------------
bool gt_EndingCinPt1_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    SoundChannelMute(PlayerGroupAll(), c_soundCategoryMusic, true);
    TriggerSkippableBegin(PlayerGroupAll(), 0, gt_EndingSkip, true, false);
    TriggerEnable(gt_BorderShip, false);
    libNtve_gf_UnitCreateFacingPoint(1, "Tosh", 0, 3, PointFromId(1147), PointFromId(1143));
    gv_endingTerry = UnitLastCreated();
    libNtve_gf_UnitCreateFacingPoint(1, "Nova", 0, 2, PointFromId(1142), PointFromId(1143));
    gv_endingJane = UnitLastCreated();
    libNtve_gf_UnitCreateFacingPoint(1, "Marine", 0, 2, PointFromId(1144), PointFromId(1143));
    libNtve_gf_UnitCreateFacingPoint(1, "Marine", 0, 2, PointFromId(1145), PointFromId(1143));
    libNtve_gf_UnitCreateFacingPoint(1, "Firebat", 0, 2, PointFromId(1146), PointFromId(1143));
    libNtve_gf_UnitCreateFacingPoint(1, "Ghost", 0, 3, PointFromId(1148), PointFromId(1143));
    UnitBehaviorAdd(UnitLastCreated(), "PermanentlyCloaked", UnitLastCreated(), 1);
    libNtve_gf_UnitCreateFacingPoint(1, "Ghost", 0, 3, PointFromId(1149), PointFromId(1143));
    UnitBehaviorAdd(UnitLastCreated(), "PermanentlyCloaked", UnitLastCreated(), 1);
    libNtve_gf_UnitCreateFacingPoint(1, "Ghost", 0, 3, PointFromId(1150), PointFromId(1143));
    UnitBehaviorAdd(UnitLastCreated(), "PermanentlyCloaked", UnitLastCreated(), 1);
    libNtve_gf_UnitCreateFacingPoint(1, "Ghost", 0, 3, PointFromId(1151), PointFromId(1143));
    UnitBehaviorAdd(UnitLastCreated(), "PermanentlyCloaked", UnitLastCreated(), 1);
    libNtve_gf_UnitCreateFacingPoint(1, "Ghost", 0, 3, PointFromId(1152), PointFromId(1143));
    UnitBehaviorAdd(UnitLastCreated(), "PermanentlyCloaked", UnitLastCreated(), 1);
    libNtve_gf_UnitCreateFacingPoint(1, "Ghost", 0, 3, PointFromId(1153), PointFromId(1143));
    UnitBehaviorAdd(UnitLastCreated(), "PermanentlyCloaked", UnitLastCreated(), 1);
    libNtve_gf_UnitCreateFacingPoint(1, "Ghost", 0, 3, PointFromId(1154), PointFromId(1143));
    UnitBehaviorAdd(UnitLastCreated(), "PermanentlyCloaked", UnitLastCreated(), 1);
    UnitBehaviorAdd(gv_endingTerry, "PermanentlyCloaked", gv_endingTerry, 1);
    Wait(3.0, c_timeGame);
    Wait(1.0, c_timeGame);
    CameraApplyInfo(1, CameraInfoFromId(1141), 0.0, -1, 10.0, true);
    CinematicFade(true, 2.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, false);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(gv_endingJane, true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/16F2EAE8"), StringExternal("Param/Value/2476F5E4"), 6.0, c_transmissionDurationAdd, false);
    Wait(3.7, c_timeGame);
    CameraApplyInfo(1, CameraInfoFromId(1139), 0.0, -1, 10.0, true);
    UnitIssueOrder(gv_endingJane, OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(1143)), c_orderQueueReplace);
    UnitIssueOrder(gv_endingJane, Order(AbilityCommand("move", 2)), c_orderQueueAddToEnd);
    Wait(5.0, c_timeGame);
    CameraApplyInfo(1, CameraInfoFromId(1140), 0.0, -1, 10.0, true);
    libNtve_gf_MakeUnitFacePoint(gv_endingJane, PointFromId(1146), 0.6);
    UnitIssueOrder(gv_endingJane, Order(AbilityCommand("move", 2)), c_orderQueueAddToEnd);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(gv_endingJane, true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/44AC0176"), StringExternal("Param/Value/FF1DB629"), 6.0, c_transmissionDurationAdd, true);
    CameraApplyInfo(1, CameraInfoFromId(1141), 0.0, -1, 10.0, true);
    UnitIssueOrder(gv_endingTerry, OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(1155)), c_orderQueueReplace);
    UnitBehaviorRemove(gv_endingTerry, "PermanentlyCloaked", 1);
    Wait(1.2, c_timeGame);
    libNtve_gf_MakeUnitFacePoint(gv_endingTerry, UnitGetPosition(gv_endingJane), 0.6);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(gv_endingTerry, true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/BE3FCDF0"), StringExternal("Param/Value/F023AA13"), 5.0, c_transmissionDurationAdd, true);
    Wait(2.0, c_timeGame);
    libNtve_gf_MakeUnitFacePoint(gv_endingJane, UnitGetPosition(gv_endingTerry), 1.4);
    CameraApplyInfo(1, CameraInfoFromId(1141), 0.0, -1, 10.0, true);
    CameraSetValue(1, c_cameraValueDistance, (CameraInfoGetValue(CameraInfoFromId(1141), c_cameraValueDistance) + 10.0), 15.0, -1, 10.0);
    UnitGroupLoopBegin(UnitGroup("Marine", 3, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    while (!UnitGroupLoopDone()) {
        libNtve_gf_MakeUnitFacePoint(UnitGroupLoopCurrent(), UnitGetPosition(gv_endingTerry), 0.6);
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(gv_endingJane, true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/A7E72991"), StringExternal("Param/Value/516E12EF"), 4.0, c_transmissionDurationAdd, true);
    libNtve_gf_MakeUnitFacePoint(gv_endingTerry, UnitGetPosition(gv_endingJane), 0.4);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(gv_endingTerry, true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/DEBC5923"), StringExternal("Param/Value/9F949F0E"), 8.0, c_transmissionDurationAdd, true);
    CameraApplyInfo(1, CameraInfoFromId(4210), 0.0, -1, 10.0, true);
    libNtve_gf_MakeUnitFacePoint(gv_endingJane, UnitGetPosition(gv_endingTerry), 0.4);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(gv_endingJane, true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/9ED04D10"), StringExternal("Param/Value/A5371E0A"), 11.0, c_transmissionDurationAdd, true);
    libNtve_gf_MakeUnitFacePoint(gv_endingTerry, UnitGetPosition(gv_endingJane), 0.4);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(gv_endingTerry, true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/D0272D4E"), StringExternal("Param/Value/26C67A83"), 7.0, c_transmissionDurationAdd, true);
    CameraApplyInfo(1, CameraInfoFromId(1156), 0.0, -1, 10.0, true);
    CameraApplyInfo(1, CameraInfoFromId(1156), 16.0, -1, 10.0, true);
    libNtve_gf_MakeUnitFacePoint(gv_endingJane, UnitGetPosition(gv_endingTerry), 0.4);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(gv_endingJane, true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/005FC032"), StringExternal("Param/Value/9DEE98F3"), 4.0, c_transmissionDurationAdd, true);
    libNtve_gf_MakeUnitFacePoint(gv_endingTerry, UnitGetPosition(gv_endingJane), 0.4);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(gv_endingTerry, true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/13F53481"), StringExternal("Param/Value/B3E58203"), 8.0, c_transmissionDurationAdd, true);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(gv_endingTerry, true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/A17A7C46"), StringExternal("Param/Value/B84422BD"), 6.0, c_transmissionDurationAdd, true);
    UnitGroupLoopBegin(UnitGroup("Ghost", 3, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    while (!UnitGroupLoopDone()) {
        UnitBehaviorRemove(UnitGroupLoopCurrent(), "PermanentlyCloaked", 1);
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();
    libNtve_gf_MakeUnitFacePoint(gv_endingTerry, UnitGetPosition(gv_endingJane), 0.4);
    libNtve_gf_MakeUnitFacePoint(gv_endingJane, UnitGetPosition(gv_endingTerry), 0.4);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnit(gv_endingTerry, true, false, "Talk"), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/3590F2F0"), StringExternal("Param/Value/8701435C"), 6.0, c_transmissionDurationAdd, true);
    CinematicFade(false, 2.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    UnitGroupLoopBegin(UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    while (!UnitGroupLoopDone()) {
        UnitRemove(UnitGroupLoopCurrent());
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();
    CameraApplyInfo(1, CameraInfoFromId(1158), 0.0, -1, 10.0, true);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "MedivacLow", 0, 3, PointFromId(4211));
    UnitSetScale(UnitLastCreated(), 275.0, 275.0, 275.0);
    UnitSetPropertyFixed(UnitLastCreated(), c_unitPropMovementSpeed, 1.3);
    UnitSetHeight(UnitLastCreated(), 5.5, 0.0);
    UnitIssueOrder(UnitLastCreated(), OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(4212)), c_orderQueueReplace);
    UnitSetHeight(UnitLastCreated(), 22.0, 25.0);
    Wait(1.0, c_timeGame);
    CinematicFade(true, 2.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, false);
    CameraApplyInfo(1, CameraInfoFromId(1159), 13.0, -1, 10.0, true);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnitType("CommandCenter", false), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/014EC59B"), StringExternal("Param/Value/F20527FD"), 4.0, c_transmissionDurationAdd, true);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnitType("CommandCenter", false), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/B07DCDA0"), StringExternal("Param/Value/201534F1"), 4.0, c_transmissionDurationAdd, true);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromUnitType("CommandCenter", false), libNtve_gf_CinematicPortrait(4), "Talk", null, StringExternal("Param/Value/51CDDB57"), StringExternal("Param/Value/CB104FED"), 4.0, c_transmissionDurationAdd, true);
    CinematicFade(false, 2.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    GameOver(1, c_gameOverVictory, false, false);
    return true;
}

