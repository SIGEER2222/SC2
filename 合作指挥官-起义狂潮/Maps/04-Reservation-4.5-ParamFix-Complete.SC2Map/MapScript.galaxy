//--------------------------------------------------------------------------------------------------
// Trigger: Patrol 02 b
//--------------------------------------------------------------------------------------------------
bool gt_Patrol02b_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((UnitIsAlive(UnitFromId(4568)) == true))) {
            return false;
        }

        if (!((UnitGetPropertyFixed(UnitFromId(4568), c_unitPropLife, c_unitPropCurrent) < 251.0))) {
            return false;
        }

        if (!((TriggerGetExecCount(TriggerGetCurrent()) == 0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitIssueOrder(UnitFromId(4515), Order(AbilityCommand("BurrowZerglingUp", 0)), c_orderQueueReplace);
    UnitIssueOrder(UnitFromId(4516), Order(AbilityCommand("BurrowZerglingUp", 0)), c_orderQueueReplace);
    UnitIssueOrder(UnitFromId(4596), Order(AbilityCommand("BurrowZerglingUp", 0)), c_orderQueueReplace);
    UnitIssueOrder(UnitFromId(4595), Order(AbilityCommand("BurrowZerglingUp", 0)), c_orderQueueReplace);
    return true;
}

