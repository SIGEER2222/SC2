//--------------------------------------------------------------------------------------------------
bool gt_EndingCinematic2_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    TriggerExecute(gt_MissionCompleteHiveDestroyed, false, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_EndingCinematic2_Init () {
    gt_EndingCinematic2 = TriggerCreate("gt_EndingCinematic2_Func");
    TriggerAddEventChatMessage(gt_EndingCinematic2, c_playerAny, "EndFinale", true);
}

//--------------------------------------------------------------------------------------------------
// Trigger: MissionAccomplished
//--------------------------------------------------------------------------------------------------
bool gt_MissionAccomplished_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == 1))) {
            return false;
        }

        if (!((TriggerGetExecCount(TriggerGetCurrent()) == 0))) {
            return false;
        }

        if (!((UnitFilterMatch(EventUnit(), 1, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)))) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    UnitSetPropertyFixed(UnitFromId(24), c_unitPropLifeMax, 10000.0);
    UnitSetPropertyFixed(UnitFromId(24), c_unitPropLife, 10000.0);
    GameSetNextMap("BioTech2X");
    UISetMode(PlayerGroupAll(), c_uiModeFullscreen, 1.0);
    Wait(1.0, c_timeGame);
    ObjectiveSetState(gv_objective1, c_objectiveStateCompleted);
    ObjectiveSetState(gv_objective2, c_objectiveStateCompleted);
    UIShowTextCrawl(PlayerGroupAll(), StringExternal("Param/Value/4E4E690F"), StringExternal("Param/Value/D2AB30D8"), 10.0, SoundLink("30SecondSilence", -1), SoundLink("30SecondSilence", 0));
    Wait(3.0, c_timeGame);
    CinematicFade(false, 2.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    TriggerExecute(gt_EndingCinematic, false, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_MissionAccomplished_Init () {
    gt_MissionAccomplished = TriggerCreate("gt_MissionAccomplished_Func");
    TriggerAddEventUnitRegion(gt_MissionAccomplished, null, RegionFromId(22), true);
}

