//--------------------------------------------------------------------------------------------------
// Trigger: TIP - Debris
//--------------------------------------------------------------------------------------------------
bool gt_TIPDebris_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == 1))) {
            return false;
        }

        if (!((TriggerGetExecCount(TriggerGetCurrent()) == 0))) {
            return false;
        }

        if (!((UnitFilterMatch(EventUnit(), 1, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)))) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_ShareVisionofUnit(UnitFromId(1204), true, 1);
    VisRevealArea(1, RegionFromId(37), 14.0, false);
    MinimapPing(PlayerGroupAll(), PointFromId(4514), 3.0, Color(100.00, 0.00, 0.00));
    libNtve_gf_CreateModelAtPoint("BriefingUnitSelectLargeRed", PointFromId(4514));
    CameraPan(1, RegionGetCenter(RegionFromId(37)), 2.0, -1, 10.0, false);
    gv_actorDebris = libNtve_gf_ActorLastCreated();
    TextTagCreate(StringExternal("Param/Value/AC461F40"), 22, UnitGetPosition(UnitFromId(1204)), 2.0, true, false, PlayerGroupAll());
    gv_actorDebris2 = TextTagLastCreated();
    TextTagSetPosition(TextTagLastCreated(), PointWithOffset(PointFromId(4514), 0.0, 0.0), 1.0);
    TextTagSetColor(TextTagLastCreated(), c_textTagColorText, Color(0.00, 100.00, 0.00));
    SoundPlayAtPoint(SoundLink("UI_TipSelect", -1), PlayerGroupAll(), PointFromId(4514), 0.0, 100.0, 0.0);
    HelpPanelAddTip(PlayerGroupAll(), libNtve_gf_FormatTipTitle(StringExternal("Param/Value/250B9410"), 0), StringExternal("Param/Value/645A7EF5"), StringExternal("Param/Value/F84E23E3"), "Assets\\Textures\\wireframe-destructible-debris.dds");
    SoundPlay(SoundLink("ZZerus03MusicPreBoss", -1), PlayerGroupAll(), 100.0, 0.0);
    Wait(10.0, c_timeAI);
    libNtve_gf_KillModel(gv_actorDebris);
    TextTagDestroy(gv_actorDebris2);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_TIPDebris_Init () {
    gt_TIPDebris = TriggerCreate("gt_TIPDebris_Func");
    TriggerAddEventUnitRegion(gt_TIPDebris, null, RegionFromId(10), true);
}

