//--------------------------------------------------------------------------------------------------
// Trigger: MissionFailed - Tea Bone Dies
//--------------------------------------------------------------------------------------------------
bool gt_MissionFailedTeaBoneDies_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    GameSetNextMap("Evacuation");
    UISetMode(PlayerGroupAll(), c_uiModeFullscreen, 1.0);
    Wait(1.0, c_timeGame);
    ObjectiveSetState(gv_objective2, c_objectiveStateFailed);
    UIShowTextCrawl(PlayerGroupAll(), StringExternal("Param/Value/A604C237"), StringExternal("Param/Value/7FBA9F90"), 10.0, SoundLink("30SecondSilence", -1), SoundLink("30SecondSilence", 0));
    Wait(6.0, c_timeGame);
    GameOver(1, c_gameOverDefeat, false, false);
    return true;
}

