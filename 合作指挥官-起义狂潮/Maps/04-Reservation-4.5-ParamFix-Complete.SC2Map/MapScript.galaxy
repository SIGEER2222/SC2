    gt_DifficultySelectedNormal = TriggerCreate("gt_DifficultySelectedNormal_Func");
    TriggerAddEventDialogControl(gt_DifficultySelectedNormal, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

