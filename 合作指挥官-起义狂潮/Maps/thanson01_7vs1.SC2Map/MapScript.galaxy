//--------------------------------------------------------------------------------------------------
// Trigger: Dropperlord Q
//--------------------------------------------------------------------------------------------------
bool gt_DropperlordQ_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_gameOver == false))) {
            return false;
        }

        if (!((gv_inCinematic == false))) {
            return false;
        }

        if (!((TriggerGetExecCount(TriggerGetCurrent()) == 0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerQueueEnter();
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
    libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TValerian01BriefingMarine00012", -1), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TTychus02Raynor00032", -1), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    Wait(1.0, c_timeGame);
    TriggerQueueExit();
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_DropperlordQ_Init () {
    gt_DropperlordQ = TriggerCreate("gt_DropperlordQ_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Dropperlord Q Multi
//--------------------------------------------------------------------------------------------------
bool gt_DropperlordQMulti_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    int auto7ABBD849_val;

    // Conditions
    if (testConds) {
        if (!((gv_gameOver == false))) {
            return false;
        }

        if (!((gv_inCinematic == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerQueueEnter();
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
    libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
    auto7ABBD849_val = gv_dropperlordCycle;
    if (auto7ABBD849_val == 0) {
        libCamp_gf_SendTransmissionCampaign(null, SoundLink("TTychus02Adjutant00029", -1), c_transmissionDurationAdd, 0.0, true);
        libCamp_gf_SendTransmissionCampaign(null, SoundLink("TTychus02Raynor00034", -1), c_transmissionDurationAdd, 0.0, true);
    }
    else if (auto7ABBD849_val == 1) {
        libCamp_gf_SendTransmissionCampaign(null, SoundLink("TValerian03Horner00040", -1), c_transmissionDurationAdd, 0.0, true);
    }
    else if (auto7ABBD849_val == 2) {
        libCamp_gf_SendTransmissionCampaign(null, SoundLink("TTychus02Horner00033", -1), c_transmissionDurationAdd, 0.0, true);
    }
    else {
    }
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    Wait(1.0, c_timeGame);
    if (gv_dropperlordCycle >= 2) {
        gv_dropperlordCycle = 0;
    }
    else {
        gv_dropperlordCycle = gv_dropperlordCycle + 1;
    }
    TriggerQueueExit();
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_DropperlordQMulti_Init () {
    gt_DropperlordQMulti = TriggerCreate("gt_DropperlordQMulti_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: P7 Patrols
//--------------------------------------------------------------------------------------------------
bool gt_P7Patrols_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_aI;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_aI = 7;

    // Actions
    if (!runActions) {
        return true;
    }

    AIAttackWaveSetTargetPatrol(lv_aI, 2);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(521960667), false);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(1856453201), false);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(2077579525), false);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(1717538143), false);
    AIAttackWaveAddUnits4(4, 4, 5, 6, "Marine");
    AIAttackWaveAddUnits4(2, 2, 3, 3, "Medic");
    AIAttackWaveSend(lv_aI, 90, true);
    AIToggleBulliesInRegion(gv_p7_LEFT_MILITIA, RegionFromId(61), true);
    AIAttackWaveSetTargetPatrol(lv_aI, 2);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(521960667), false);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(1856453201), false);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(2077579525), false);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(1717538143), false);
    AIAttackWaveAddUnits4(6, 6, 7, 8, "Marine");
    AIAttackWaveAddUnits4(2, 2, 3, 3, "Firebat");
    AIAttackWaveSend(lv_aI, 240, true);
    AIToggleBulliesInRegion(gv_p7_LEFT_MILITIA, RegionFromId(60), true);
    Wait(360.0, c_timeGame);
    AIAttackWaveSetTargetPatrol(lv_aI, 2);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(1689331063), false);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(1391272769), false);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(421510331), false);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(1521433286), false);
    AIAttackWaveAddUnits4(2, 2, 3, 3, "Goliath");
    AIAttackWaveAddUnits4(4, 4, 5, 5, "Vulture");
    AIAttackWaveSend(lv_aI, 180, true);
    AIAttackWaveSetTargetPatrol(lv_aI, 2);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(1689331063), false);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(1391272769), false);
