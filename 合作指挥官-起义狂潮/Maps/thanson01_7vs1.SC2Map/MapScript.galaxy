// Trigger: P9 Attack Waves
//--------------------------------------------------------------------------------------------------
bool gt_P9AttackWaves_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_aI;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_aI = 9;

    // Actions
    if (!runActions) {
        return true;
    }

    AIAttackWaveSetTargetPlayer(lv_aI, PlayerGroupAlliance(c_playerGroupEnemy, lv_aI));
    AIAttackWaveSetGatherPoint(lv_aI, PointFromId(1869161581));
    Wait(360.0, c_timeGame);
    AIAttackWaveAddUnits4(10, 10, 12, 16, "Zergling");
    AIAttackWaveAddUnits4(2, 2, 3, 4, "Roach");
    AIAttackWaveAddUnits4(2, 2, 3, 3, "Baneling");
    AIAttackWaveSend(lv_aI, 180, true);
    AIAttackWaveAddUnits4(8, 8, 10, 12, "Zergling");
    AIAttackWaveAddUnits4(4, 4, 5, 6, "Roach");
    AIAttackWaveAddUnits4(2, 2, 3, 3, "Baneling");
    AIAttackWaveSend(lv_aI, 180, true);
    AIAttackWaveAddUnits4(6, 6, 7, 8, "Roach");
    AIAttackWaveAddUnits4(2, 2, 3, 4, "Ravager");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Overseer");
    AIAttackWaveSend(lv_aI, 180, true);
    AIAttackWaveAddUnits4(2, 2, 3, 4, "Baneling");
    AIAttackWaveAddUnits4(2, 2, 3, 4, "Ravager");
    AIAttackWaveAddUnits4(10, 10, 12, 16, "Zergling");
    AIAttackWaveSend(lv_aI, 180, true);
    AIAttackWaveAddUnits4(2, 2, 3, 4, "Ravager");
    AIAttackWaveAddUnits4(12, 12, 15, 20, "Zergling");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Overseer");
    AIAttackWaveSend(lv_aI, 180, true);
    while (true) {
        Wait(1.0, c_timeGame);
        AIAttackWaveAddUnits4(6, 6, 7, 8, "Roach");
        AIAttackWaveAddUnits4(2, 2, 3, 4, "Ravager");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Overseer");
        AIAttackWaveSend(lv_aI, 180, true);
        AIAttackWaveAddUnits4(2, 2, 3, 4, "Baneling");
        AIAttackWaveAddUnits4(2, 2, 3, 4, "Ravager");
        AIAttackWaveAddUnits4(10, 10, 12, 16, "Zergling");
        AIAttackWaveSend(lv_aI, 180, true);
        AIAttackWaveAddUnits4(2, 2, 3, 4, "Ravager");
        AIAttackWaveAddUnits4(12, 12, 15, 20, "Zergling");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Overseer");
        AIAttackWaveSend(lv_aI, 180, true);
    }
    return true;
}

