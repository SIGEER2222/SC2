//==================================================================================================
// 
// Generated Map Script - Abathur 单位测试
// 
//==================================================================================================
include "TriggerLibs/NativeLib"
include "LibAbathurCatalog"

//--------------------------------------------------------------------------------------------------
// Library Initialization
//--------------------------------------------------------------------------------------------------
void InitLibs () {
    libNtve_InitLib();
    libAbathurCatalog_InitLib();
}

//--------------------------------------------------------------------------------------------------
// Trigger Variables
//--------------------------------------------------------------------------------------------------
trigger gt_spawnAbathurUnits;

//--------------------------------------------------------------------------------------------------
// Trigger: 生成阿巴瑟单位
//--------------------------------------------------------------------------------------------------
bool gt_spawnAbathurUnits_Func (bool testConds, bool runActions) {
    int lv_u;
    int lv_total;
    int lv_row;
    int lv_col;
    int lv_perRow;
    fixed lv_spacing;
    fixed lv_x;
    fixed lv_y;
    point lv_pos;
    string lv_unitType;
    int lv_skipped;
    int lv_created;

    if (!runActions) {
        return true;
    }

    lv_perRow = 10;
    lv_spacing = 3.0;
    lv_total = 0;
    lv_skipped = 0;
    lv_created = 0;

    for (lv_u = 0; lv_u < gv_c_AbathurUnitCount; lv_u += 1) {
        lv_unitType = gv_AbathurUnits[lv_u];
        if (lv_unitType != "") {
            if (CatalogEntryIsValid(c_gameCatalogUnit, lv_unitType) == false) {
                lv_skipped += 1;
            }
            else {
                lv_col = lv_total - (lv_total / lv_perRow) * lv_perRow;
                lv_row = lv_total / lv_perRow;
                lv_x = 50.0 + (lv_col * lv_spacing);
                lv_y = 75.0 - (lv_row * lv_spacing);
                lv_pos = Point(lv_x, lv_y);
                libNtve_gf_CreateUnitsWithDefaultFacing(1, lv_unitType, c_unitCreateIgnorePlacement, 1, lv_pos);
                lv_total += 1;
                lv_created += 1;
            }
        }
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_spawnAbathurUnits_Init () {
    gt_spawnAbathurUnits = TriggerCreate("gt_spawnAbathurUnits_Func");
    TriggerAddEventMapInit(gt_spawnAbathurUnits);
}

//--------------------------------------------------------------------------------------------------
// Trigger Initialization
//--------------------------------------------------------------------------------------------------
void InitTriggers () {
    gt_spawnAbathurUnits_Init();
}

//--------------------------------------------------------------------------------------------------
// Map Initialization
//--------------------------------------------------------------------------------------------------
void InitMap () {
    InitLibs();
    InitTriggers();
}
