        aiAADAE1CE_wave1_lastUnits[init_i] = null;
        aiAADAE1CE_wave1_lastWave[init_i] = null;
    }

    aiAADAE1CE_wave1_trigger = TriggerCreate("aiAADAE1CE_wave1_runFunc");
}

//--------------------------------------------------------------------------------------------------
void aiAADAE1CE_wave1_enable (int p, bool val) {
