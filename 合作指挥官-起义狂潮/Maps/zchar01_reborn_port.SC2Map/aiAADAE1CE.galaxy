//--------------------------------------------------------------------------------------------------
bool aiAADAE1CE_wave1_runFunc (bool c, bool a) {
    int p = aiAADAE1CE_wave1_runPlayer;
    playergroup target = aiAADAE1CE_wave1_runTarget;
    int d;
    point gatherPoint = null;
    int createCount = 0;
    point createPoint = null;
    int ta = 0;
    int tg = 0;
    int ts = 0;
    int tf = 0;
    int td = 0;

    if (p < 0 || p >= 16) {
        return false;
    }
    d = PlayerDifficulty(p);
    if (!aiAADAE1CE_wave1_enabled[p]) {
        td = 0;
        if (td > 0) {
            Wait(td, c_timeAI);
        }
        return true;
    }

    aiAADAE1CE_customData[p] = "";

    ta = 0;
    if (d == 1) { ta = 190; }
    if (d == 2) { ta = 190; }
    if (d == 3) { ta = 190; }
    if (d == 4) { ta = 190; }
    tg = 0;
    ts = ta;
    if (tg > 0 && tg < ta) {
        Wait(ta - tg, c_timeAI);
        ts = tg;
    }
    AIAttackWaveSetTargetPlayer(p, target);

    gatherPoint = aiAADAE1CE_defGather[p];
    AIAttackWaveSetGatherPoint(p, gatherPoint);

    AIAttackWaveClearWaypoints(p);

    createPoint = gatherPoint;
    createPoint = PointFromId(77948718);

    aiAADAE1CE_wave1_lastUnits[p] = UnitGroupEmpty();
    createCount = 0;
    if (d == 1) { createCount = 12; }
    if (d == 2) { createCount = 12; }
    if (d == 3) { createCount = 12; }
    if (d == 4) { createCount = 12; }
    if (createCount > 0) {
        UnitCreate(createCount, "HotSSwarmling", 0, p, createPoint, PointGetFacing(createPoint));
        AIAttackWaveUseGroup(p, UnitLastCreatedGroup());
        UnitGroupAddUnitGroup(aiAADAE1CE_wave1_lastUnits[p], UnitLastCreatedGroup());
    }

    AIAttackWaveSend(p, ts, false);
    aiAADAE1CE_wave1_lastWave[p] = WaveLastCreated();
    aiAADAE1CE_lastWave[p] = aiAADAE1CE_wave1_lastWave[p];
    Wait(ts, c_timeAI);
    tf = 0;
    if (tf > 0) {
        Wait(tf, c_timeAI);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void aiAADAE1CE_wave1_run (int p, playergroup target, bool wait) {
    aiAADAE1CE_wave1_runPlayer = p;
    aiAADAE1CE_wave1_runTarget = PlayerGroupCopy(target);

    TriggerExecute(aiAADAE1CE_wave1_trigger, false, wait);
}

