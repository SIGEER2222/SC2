// Start
//--------------------------------------------------------------------------------------------------
bool aiAADAE1CE_initialized = false;

//--------------------------------------------------------------------------------------------------
void aiAADAE1CE_start (int p) {
    int init_i;

    if (p < 0 || p >= 16) {
        return;
    }
    if (!aiAADAE1CE_initialized) {
        aiAADAE1CE_wave1_init();
        aiAADAE1CE_wave2_init();
        aiAADAE1CE_wave3_init();
        aiAADAE1CE_wave4_init();
        aiAADAE1CE_wave5_init();
        aiAADAE1CE_wave6_init();
        aiAADAE1CE_waves_init();

        for (init_i = 0; init_i <= 16; init_i += 1) {
            aiAADAE1CE_defGather[init_i] = PointFromId(77948718);
        }

        aiAADAE1CE_initialized = true;
    }

    AICampaignStart(p);
}
