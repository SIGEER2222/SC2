//--------------------------------------------------------------------------------------------------
bool[17] aiAADAE1CE_wave6_enabled;
bool[17] aiAADAE1CE_wave6_hasRun;
unitgroup[17] aiAADAE1CE_wave6_lastUnits;
wave[17] aiAADAE1CE_wave6_lastWave;
trigger aiAADAE1CE_wave6_trigger = null;
int aiAADAE1CE_wave6_runPlayer;
playergroup aiAADAE1CE_wave6_runTarget;

//--------------------------------------------------------------------------------------------------
void aiAADAE1CE_wave6_init () {
    int init_i;

    for (init_i = 0; init_i <= 16; init_i += 1) {
        aiAADAE1CE_wave6_enabled[init_i] = true;
        aiAADAE1CE_wave6_hasRun[init_i] = false;
        aiAADAE1CE_wave6_lastUnits[init_i] = null;
        aiAADAE1CE_wave6_lastWave[init_i] = null;
    }

    aiAADAE1CE_wave6_trigger = TriggerCreate("aiAADAE1CE_wave6_runFunc");
}

