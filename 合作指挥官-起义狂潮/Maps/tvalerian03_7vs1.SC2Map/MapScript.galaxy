//--------------------------------------------------------------------------------------------------
// Trigger: Artifact Charging
//--------------------------------------------------------------------------------------------------
bool gt_ArtifactCharging_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == 1))) {
            return false;
        }

        if (!((UnitTypeTestFlag(UnitGetType(EventUnit()), c_unitFlagWorker) == true))) {
            return false;
        }

        if (!(lib67C0F0E7_gf_Once())) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    while (true) {
        Wait(1.0, c_timeAI);
        gv_artifactChargeCurrent += gv_artifactChargeSpeed;
        BoardItemSetProgressValue(gv_artifactProgerss, 1, 2, gf_ArtifactChargePercent());
        BoardItemSetText(gv_artifactProgerss, 1, 1, (StringExternal("Param/Value/5726D625") + FixedToText(gf_ArtifactChargePercent(), 1) + StringExternal("Param/Value/C0188602")));
        if ((gv_artifactChargeCurrent >= 1200.0)) {
            gv_artifactChargeCurrent = 1200.0;
            TriggerExecute(gt_VictoryArtifactCharged, true, false);
            return true;
        }

    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_ArtifactCharging_Init () {
    gt_ArtifactCharging = TriggerCreate("gt_ArtifactCharging_Func");
    TriggerAddEventUnitRegion(gt_ArtifactCharging, null, RegionFromId(13), true);
    TriggerAddEventUnitRegion(gt_ArtifactCharging, null, RegionFromId(31), true);
    TriggerAddEventUnitRegion(gt_ArtifactCharging, null, RegionFromId(37), true);
    TriggerAddEventUnitRegion(gt_ArtifactCharging, null, RegionFromId(40), true);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Bunker Q
//--------------------------------------------------------------------------------------------------
bool gt_BunkerQ_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    TriggerQueueEnter();
    if ((gv_gameOver == true)) {
        return true;
    }

    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
    libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
    // Transmission - SoundLink("TValerian03Horner00042", -1)
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TValerian03Horner00042", -1), c_transmissionDurationAdd, 0.0, true);
    // Transmission - SoundLink("TValerian03Horner00043", -1)
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TValerian03Horner00043", -1), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    Wait(2.0, c_timeReal);
    libCamp_gf_CreateTipFromConversationState("StoryTips|Valerian03_EnergyNova", libNtve_ge_TipType_NewAbility, PlayerGroupAll());
    TriggerQueueExit();
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_BunkerQ_Init () {
    gt_BunkerQ = TriggerCreate("gt_BunkerQ_Func");
}

