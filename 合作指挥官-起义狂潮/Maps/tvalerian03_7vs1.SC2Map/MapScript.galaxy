//--------------------------------------------------------------------------------------------------
// Trigger: Spawn Kerrigan Wave
//--------------------------------------------------------------------------------------------------
bool gt_SpawnKerriganWave_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_i;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitIsAlive(gv_kerrigan) == false)) {
        libNtve_gf_CreateUnitsAtPoint2(1, "MutatorAmonKerrigan", c_unitCreateIgnoreBirth, gv_p02_SWARMGUARD, PointFromId(132));
        gv_kerrigan = UnitLastCreated();
    }

    Wait(1.0, c_timeGame);
    libNtve_gf_PlayAnimation(libNtve_gf_MainActorofUnit(gv_kerrigan), c_animNameDefault, "Stand Unpowered Start A", 0, c_animTimeDefault);
    UnitIssueOrder(gv_kerrigan, OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(819)), c_orderQueueReplace);
    UnitIssueOrder(gv_kerrigan, Order(AbilityCommand("move", 2)), c_orderQueueAddToEnd);
    Wait(2.0, c_timeGame);
    lv_i = 1;
    for ( ; ( lv_i <= gv_kerriganAttackCount ) ; lv_i += 1 ) {
        libNtve_gf_CreateUnitsAtPoint2(1, "HunterKillerBurrowed", c_unitCreateIgnoreBirth, gv_p02_SWARMGUARD, PointWithOffsetPolar(UnitGetPosition(gv_kerrigan), 3.0, ((360.0 / IntToFixed(lv_i)) * IntToFixed(lv_i))));
        UnitIssueOrder(UnitLastCreated(), Order(AbilityCommand("BurrowHunterKillerUp", 0)), c_orderQueueReplace);
        AIAttackWaveUseUnit(gv_p02_SWARMGUARD, UnitLastCreated());
        AISetUnitScriptControlled(UnitLastCreated(), false);
    }
    AISetUnitScriptControlled(gv_kerrigan, false);
    AIAttackWaveSetTargetPoint(2, PlayerStartLocation(1));
    AIAttackWaveUseUnit(gv_p02_SWARMGUARD, gv_kerrigan);
    AIAttackWaveSend(gv_p02_SWARMGUARD, 0, false);
    gv_kerriganAttackCount += 1;
    TriggerExecute(gt_KerriganAttackTransmissionQ, true, false);
    TriggerExecute(gt_KerriganAttackTauntQ, true, false);
    return true;
}

