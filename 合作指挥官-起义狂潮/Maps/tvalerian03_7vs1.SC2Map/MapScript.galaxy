void gt_EnergyNovaWarningQ_Init () {
    gt_EnergyNovaWarningQ = TriggerCreate("gt_EnergyNovaWarningQ_Func");
    TriggerAddEventTimePeriodic(gt_EnergyNovaWarningQ, 1.0, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Start AI
//--------------------------------------------------------------------------------------------------
bool gt_StartAI_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup auto2A2A5C9D_g;
    int auto2A2A5C9D_u;
    unit auto2A2A5C9D_var;

    // Actions
    if (!runActions) {
        return true;
    }

    CampaignInitAI();
    TriggerExecute(gt_Upgrade, true, false);
    TriggerExecute(gt_NydusWave, true, false);
    TriggerExecute(gt_AirWave, true, false);
    TriggerExecute(gt_KerriganAttacks, true, false);
    TriggerExecute(gt_P10BaelrogAttackWaves, true, false);
    TriggerExecute(gt_P11RavagerAttackWaves, true, false);
    TriggerExecute(gt_P12DominionAttacks, true, false);
    TriggerExecute(gt_P4GrendelAttackWaves, true, false);
    TriggerExecute(gt_P5GarmAttackWaves, true, false);
    TriggerExecute(gt_P6LeviathanAttackWaves, true, false);
    TriggerExecute(gt_P7JormungandAttackWaves, true, false);
    TriggerExecute(gt_P8BlightspreaderAttackWaves, true, false);
    TriggerExecute(gt_P9SurturAttackWaves, true, false);
    TriggerExecute(gt_P13MoebiusAttacks, true, false);
    TriggerExecute(gt_P2SwarmguardDrops, true, false);
    TriggerExecute(gt_ReinforceRegionsWithBullies, true, false);
    AISetAPM(gv_p02_SWARMGUARD, 9001);
    AISetAPM(gv_p04_GRENDEL, 9001);
    AISetAPM(gv_p05_GARM, 9001);
    AISetAPM(gv_p03_KILYSA, 9001);
    AISetAPM(gv_p12_DOMINIONFORWARD, 12000);
    AISetAPM(gv_p13_MOEBIUS, 12000);
    auto2A2A5C9D_g = UnitGroup("Bunker", gv_p12_DOMINIONFORWARD, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    auto2A2A5C9D_u = UnitGroupCount(auto2A2A5C9D_g, c_unitCountAll);
    for (;; auto2A2A5C9D_u -= 1) {
        auto2A2A5C9D_var = UnitGroupUnitFromEnd(auto2A2A5C9D_g, auto2A2A5C9D_u);
        if (auto2A2A5C9D_var == null) { break; }
        UnitCargoCreate(auto2A2A5C9D_var, "MengskMarine", 4);
        UnitCargoCreate(auto2A2A5C9D_var, "MengskMarauder", 1);
    }
    return true;
}

