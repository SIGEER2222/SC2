        lv_j = RandomInt(0, 6);
        lv_i = lv_j;
        for ( ; ( lv_i <= (lv_j+2) ) ; lv_i += 1 ) {
            gf_NydusWave(PointFromName(("nydusfar" + IntToString(lib67C0F0E7_gf_RandomIntTag(lv_i, "far")))));
            Wait(1.0, c_timeGame);
        }
    }
    while (true) {
        Wait(180.0, c_timeGame);
        if ((gv_artifactChargeCurrent <= 1000.0)) {
            TriggerExecute(gt_NydusWarningQ, true, false);
            Wait(5.0, c_timeGame);
            SoundPlay(SoundLink("NydusWorm_Birth", -1), PlayerGroupAll(), 100.0, 0.0);
            lv_j = RandomInt(0, 10);
            lv_i = lv_j;
            for ( ; ( lv_i <= (lv_j+1) ) ; lv_i += 1 ) {
                gf_NydusWave(PointFromName(("nydusnearbase" + IntToString(lib67C0F0E7_gf_RandomIntTag(lv_i, "nearbase")))));
                Wait(1.0, c_timeGame);
            }
            lv_j = RandomInt(0, 6);
            lv_i = lv_j;
            for ( ; ( lv_i <= (lv_j+2) ) ; lv_i += 1 ) {
                gf_NydusWave(PointFromName(("nydusfar" + IntToString(lib67C0F0E7_gf_RandomIntTag(lv_i, "far")))));
                Wait(1.0, c_timeGame);
            }
        }
        else {
            TriggerExecute(gt_NydusQ, true, false);
            Wait(5.0, c_timeGame);
            SoundPlay(SoundLink("NydusWorm_Birth", -1), PlayerGroupAll(), 100.0, 0.0);
            lv_j = RandomInt(0, 8);
            lv_i = lv_j;
            for ( ; ( lv_i <= (lv_j+3) ) ; lv_i += 1 ) {
                gf_NydusWave(PointFromName(("nydusnearbase" + IntToString(lib67C0F0E7_gf_RandomIntTag(lv_i, "nearbase")))));
                Wait(1.0, c_timeGame);
            }
            lv_j = RandomInt(0, 5);
            lv_i = lv_j;
            for ( ; ( lv_i <= (lv_j+2) ) ; lv_i += 1 ) {
                gf_NydusWave(PointFromName(("nydusfar" + IntToString(lib67C0F0E7_gf_RandomIntTag(lv_i, "far")))));
                Wait(1.0, c_timeGame);
            }
            gf_NydusWave(PointFromName(("nydusbase" + IntToString(lib67C0F0E7_gf_RandomIntTag(RandomInt(0, 9), "base")))));
            Wait(1.0, c_timeGame);
            gf_NydusWave(PointFromName(("nydusbase" + IntToString(lib67C0F0E7_gf_RandomIntTag(RandomInt(0, 9), "base")))));
        }
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_NydusWave_Init () {
    gt_NydusWave = TriggerCreate("gt_NydusWave_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Top Natural Bullies
//--------------------------------------------------------------------------------------------------
bool gt_TopNaturalBullies_Func (bool testConds, bool runActions) {
    // Variable Declarations
    region lv_bullyRegion;
    int lv_player;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_bullyRegion = RegionFromId(103);
    lv_player = gv_p12_DOMINIONFORWARD;

    // Conditions
    if (testConds) {
        if (!((UnitGroupCount(UnitGroupAlliance(lv_player, c_unitAllianceEnemy, lv_bullyRegion, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) <= 0))) {
            return false;
        }

        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    AIToggleBulliesInRegion(lv_player, lv_bullyRegion, true);
    AIToggleBulliesInRegion(gv_p13_MOEBIUS, lv_bullyRegion, true);
    AIToggleBulliesInRegion(gv_p14_DOMINIONFLEET, lv_bullyRegion, true);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_TopNaturalBullies_Init () {
    gt_TopNaturalBullies = TriggerCreate("gt_TopNaturalBullies_Func");
    TriggerEnable(gt_TopNaturalBullies, false);
    TriggerAddEventTimePeriodic(gt_TopNaturalBullies, 5.0, c_timeGame);
}

