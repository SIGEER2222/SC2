//--------------------------------------------------------------------------------------------------
bool gt_P12DominionAttacks_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_aI;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_aI = 12;

    // Actions
    if (!runActions) {
        return true;
    }

    AIAttackWaveSetTargetPlayer(lv_aI, PlayerGroupAlliance(c_playerGroupEnemy, lv_aI));
    AIAttackWaveSetGatherPoint(lv_aI, PointFromId(715660258));
    Wait(60.0, c_timeGame);
    AIAttackWaveAddUnits4(2, 2, 2, 3, "MengskMedic");
    AIAttackWaveAddUnits4(2, 2, 2, 2, "MengskFirebat");
    AIAttackWaveAddUnits4(6, 6, 7, 7, "MengskMarine");
    AIAttackWaveAddUnits4(2, 2, 2, 2, "MengskHellion");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Raven");
    AIAttackWaveSend(lv_aI, 180, true);
    AIAttackWaveAddUnits4(2, 2, 2, 3, "MengskMedic");
