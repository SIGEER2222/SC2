//--------------------------------------------------------------------------------------------------
bool gt_RescuingBC_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    UnitSetOwner(UnitFromId(45), UnitGetOwner(UnitFromId(1)), true);
    TriggerEnable(gt_RescueableBC, false);
    Wait(3.0, c_timeGame);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, (TextWithColor(StringExternal("Param/Value/F15BFCC4"), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(UnitGetOwner(UnitFromId(1)), false))) + StringExternal("Param/Value/48156A92")));
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("Param/Value/330E112B"));
    Wait(60.0, c_timeGame);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, (TextWithColor(StringExternal("Param/Value/FF75F615"), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(UnitGetOwner(UnitFromId(1)), false))) + StringExternal("Param/Value/DA5A873D")));
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("Param/Value/09E47D98"));
    Wait(60.0, c_timeGame);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, (TextWithColor(StringExternal("Param/Value/E653C7C0"), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(UnitGetOwner(UnitFromId(1)), false))) + StringExternal("Param/Value/C87588A1")));
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("Param/Value/1388CC16"));
    Wait(3.0, c_timeGame);
    UnitKill(UnitFromId(45));
    return true;
}

