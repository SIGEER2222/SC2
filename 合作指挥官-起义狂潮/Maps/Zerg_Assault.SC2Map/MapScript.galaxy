    }
    else {
    }
    if ((UnitGetOwner(EventUnit()) == 3) && (AbsI(gv_p3Selection) == 4) && (AbsI(gv_deltaSelected) == 0)) {
        UnitSetOwner(UnitFromId(6), UnitGetOwner(EventUnit()), true);
        UnitSetPosition(UnitFromId(6), RegionGetCenter(RegionFromId(2)), false);
