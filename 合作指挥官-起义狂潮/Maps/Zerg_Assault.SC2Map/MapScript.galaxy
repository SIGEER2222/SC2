//--------------------------------------------------------------------------------------------------
// Trigger: Attack
//--------------------------------------------------------------------------------------------------
bool gt_Attack_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    UnitGroupIssueOrder(gv_alphaSpawn, OrderTargetingPoint(AbilityCommand("attack", 0), RegionGetCenter(RegionFromId(5))), c_orderQueueReplace);
    UnitGroupIssueOrder(gv_bravoSpawn, OrderTargetingPoint(AbilityCommand("attack", 0), RegionGetCenter(RegionFromId(6))), c_orderQueueReplace);
    UnitGroupIssueOrder(gv_charlieSpawn, OrderTargetingPoint(AbilityCommand("attack", 0), RegionGetCenter(RegionFromId(7))), c_orderQueueReplace);
    UnitGroupIssueOrder(gv_deltaSpawn, OrderTargetingPoint(AbilityCommand("attack", 0), RegionGetCenter(RegionFromId(8))), c_orderQueueReplace);
    return true;
}

