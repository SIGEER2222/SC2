bool gt_AlphaMedium_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, (TextWithColor(PlayerName(UnitGetOwner(UnitFromId(1))), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(UnitGetOwner(UnitFromId(1)), false))) + StringExternal("Param/Value/EF6E9233")));
    gv_alphaDifficulty = 2;
    Wait(0.1, c_timeGame);
    TriggerEnable(TriggerGetCurrent(), false);
    return true;
}

