    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitGetOwner(EventUnit()) == 1) && (AbsI(gv_p1Selection) == 1) && (AbsI(gv_alphaSelected) == 0)) {
        UnitSetOwner(UnitFromId(1), UnitGetOwner(EventUnit()), true);
        UnitSetPosition(UnitFromId(1), RegionGetCenter(RegionFromId(2)), false);
        gv_alphaSelected = 1;
        CameraLockInput(UnitGetOwner(EventUnit()), false);
        libNtve_gf_SwooshCamera(UnitGetOwner(EventUnit()), ((CameraInfoGetValue(CameraInfoDefault(), c_cameraValueDistance)) + 8.0), CameraInfoGetValue(CameraInfoDefault(), c_cameraValueDistance), RegionGetCenter(RegionFromId(2)), 0.0);
        UnitPauseAll(false);
        UnitKill(EventUnit());
        gv_alphaDifficulty = 1;
