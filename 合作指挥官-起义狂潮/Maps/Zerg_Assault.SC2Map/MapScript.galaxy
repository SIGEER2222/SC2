//--------------------------------------------------------------------------------------------------
void gt_Select_Init () {
    gt_Select = TriggerCreate("gt_Select_Func");
    TriggerAddEventUnitAbility(gt_Select, null, AbilityCommand("Select", 0), c_unitAbilStageComplete, false);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Map Initialization
//--------------------------------------------------------------------------------------------------
bool gt_MapInitialization_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    RegionAttachToUnit(RegionFromId(5), UnitFromId(1), Point(0.0, 0.0));
    RegionAttachToUnit(RegionFromId(6), UnitFromId(2), Point(0.0, 0.0));
    RegionAttachToUnit(RegionFromId(7), UnitFromId(5), Point(0.0, 0.0));
    RegionAttachToUnit(RegionFromId(8), UnitFromId(6), Point(0.0, 0.0));
    PlayerGroupAdd(gv_allPlayers, 1);
    PlayerGroupAdd(gv_allPlayers, 2);
    PlayerGroupAdd(gv_allPlayers, 3);
    PlayerGroupAdd(gv_allPlayers, 4);
    UnitSelect(UnitFromId(7), 1, true);
    UnitSelect(UnitFromId(8), 2, true);
    UnitSelect(UnitFromId(9), 3, true);
    UnitSelect(UnitFromId(11), 4, true);
    UnitControlGroupAddUnit(1, 1, UnitFromId(7));
    UnitControlGroupAddUnit(2, 1, UnitFromId(8));
    UnitControlGroupAddUnit(3, 1, UnitFromId(9));
    UnitControlGroupAddUnit(4, 1, UnitFromId(11));
    libNtve_gf_PauseUnit(UnitFromId(1), true);
    libNtve_gf_PauseUnit(UnitFromId(2), true);
    libNtve_gf_PauseUnit(UnitFromId(5), true);
    libNtve_gf_PauseUnit(UnitFromId(6), true);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_MapInitialization_Init () {
    gt_MapInitialization = TriggerCreate("gt_MapInitialization_Func");
    TriggerAddEventMapInit(gt_MapInitialization);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Alliances
//--------------------------------------------------------------------------------------------------
bool gt_Alliances_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_SetAlliance(1, 6, 5);
    libNtve_gf_SetAlliance(2, 6, 5);
    libNtve_gf_SetAlliance(3, 6, 5);
    libNtve_gf_SetAlliance(4, 6, 5);
    libNtve_gf_SetAlliance(5, 6, 5);
    libNtve_gf_SetAlliance(1, 2, 0);
    libNtve_gf_SetAlliance(1, 3, 0);
    libNtve_gf_SetAlliance(1, 4, 0);
    libNtve_gf_SetAlliance(2, 3, 0);
    libNtve_gf_SetAlliance(2, 4, 0);
    libNtve_gf_SetAlliance(3, 4, 0);
    libNtve_gf_SetAlliance(1, 5, 1);
    libNtve_gf_SetAlliance(2, 5, 1);
    libNtve_gf_SetAlliance(3, 5, 1);
    libNtve_gf_SetAlliance(4, 5, 1);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_Alliances_Init () {
    gt_Alliances = TriggerCreate("gt_Alliances_Func");
    TriggerAddEventMapInit(gt_Alliances);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Team Locations
//--------------------------------------------------------------------------------------------------
bool gt_TeamLocations_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, (TextWithColor(PlayerName(EventPlayer()), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(EventPlayer(), false))) + StringExternal("Param/Value/6D16694E")));
    MinimapPing(PlayerGroupAll(), UnitGetPosition(UnitFromId(1)), 5.0, Color(100.00, 0.00, 0.00));
    MinimapPing(PlayerGroupAll(), UnitGetPosition(UnitFromId(2)), 5.0, Color(0.00, 0.00, 100.00));
    MinimapPing(PlayerGroupAll(), UnitGetPosition(UnitFromId(5)), 5.0, Color(0.00, 100.00, 100.00));
    MinimapPing(PlayerGroupAll(), UnitGetPosition(UnitFromId(6)), 5.0, Color(50.20, 0.00, 50.20));
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_TeamLocations_Init () {
    gt_TeamLocations = TriggerCreate("gt_TeamLocations_Func");
    TriggerAddEventChatMessage(gt_TeamLocations, UnitGetOwner(UnitFromId(1)), "-tl", false);
    TriggerAddEventChatMessage(gt_TeamLocations, UnitGetOwner(UnitFromId(2)), "-tl", false);
    TriggerAddEventChatMessage(gt_TeamLocations, UnitGetOwner(UnitFromId(5)), "-tl", false);
    TriggerAddEventChatMessage(gt_TeamLocations, UnitGetOwner(UnitFromId(6)), "-tl", false);
}

