//--------------------------------------------------------------------------------------------------
// Trigger: Unit Dies
//--------------------------------------------------------------------------------------------------
bool gt_UnitDies_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    if ((EventUnit() == UnitFromId(1))) {
        gv_alphaDifficulty = 0;
        UnitGroupLoopBegin(gv_alphaSpawn);
        while (!UnitGroupLoopDone()) {
            UnitKill(UnitGroupLoopCurrent());
            UnitGroupLoopStep();
        }
        UnitGroupLoopEnd();
        TriggerEnable(gt_AlphaMedium, false);
        TriggerEnable(gt_AlphaHard, false);
    }
    else {
    }
    if ((EventUnit() == UnitFromId(2))) {
        gv_bravoDifficulty = 0;
        UnitGroupLoopBegin(gv_bravoSpawn);
        while (!UnitGroupLoopDone()) {
            UnitKill(UnitGroupLoopCurrent());
            UnitGroupLoopStep();
        }
        UnitGroupLoopEnd();
        TriggerEnable(gt_BravoMedium, false);
        TriggerEnable(gt_BravoHard, false);
    }
    else {
    }
    if ((EventUnit() == UnitFromId(5))) {
        gv_charlieDifficulty = 0;
        UnitGroupLoopBegin(gv_charlieSpawn);
        while (!UnitGroupLoopDone()) {
            UnitKill(UnitGroupLoopCurrent());
            UnitGroupLoopStep();
        }
        UnitGroupLoopEnd();
        TriggerEnable(gt_CharlieMedium, false);
        TriggerEnable(gt_CharlieHard, false);
    }
    else {
    }
    if ((EventUnit() == UnitFromId(6))) {
        gv_deltaDifficulty = 0;
        UnitGroupLoopBegin(gv_deltaSpawn);
        while (!UnitGroupLoopDone()) {
            UnitKill(UnitGroupLoopCurrent());
            UnitGroupLoopStep();
        }
        UnitGroupLoopEnd();
        TriggerEnable(gt_DeltaMedium, false);
        TriggerEnable(gt_DeltaHard, false);
    }
    else {
    }
    return true;
}

