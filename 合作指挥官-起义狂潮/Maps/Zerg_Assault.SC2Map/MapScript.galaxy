//--------------------------------------------------------------------------------------------------
bool gt_Dialogs_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, TextWithColor(StringExternal("Param/Value/ECA11E74"), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(5, false))));
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("Param/Value/A2F660D8"));
    Wait(13.0, c_timeGame);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, (TextWithColor(PlayerName(1), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(1, false))) + StringExternal("Param/Value/A1B92C64")));
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("Param/Value/362B3B3E"));
    Wait(8.0, c_timeGame);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, (TextWithColor(PlayerName(4), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(4, false))) + StringExternal("Param/Value/1F4A7C80")));
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("Param/Value/65CBE275"));
    Wait(9.0, c_timeGame);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, (TextWithColor(PlayerName(2), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(2, false))) + StringExternal("Param/Value/A138ED27")));
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("Param/Value/167293DA"));
    Wait(12.0, c_timeGame);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, (TextWithColor(PlayerName(1), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(1, false))) + StringExternal("Param/Value/04F67841")));
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("Param/Value/0A8C4B51"));
    Wait(60.0, c_timeGame);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, TextWithColor(StringExternal("Param/Value/15A23E95"), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(1, true))));
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("Param/Value/8C253C18"));
    MinimapPing(PlayerGroupAll(), RegionGetCenter(RegionFromId(2)), 5.0, Color(100.00, 0.00, 0.00));
    Wait(60.0, c_timeGame);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, TextWithColor(StringExternal("Param/Value/2048CE94"), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(5, true))));
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("Param/Value/69E3322A"));
    UnitKill(UnitFromId(17));
    UnitKill(UnitFromId(20));
    UnitKill(UnitFromId(14));
    UnitKill(UnitFromId(3));
    TriggerEnable(gt_NorthRandomize, false);
    TriggerEnable(gt_NorthAttack, false);
    libNtve_gf_SetAlliance(1, 5, 3);
    libNtve_gf_SetAlliance(2, 5, 3);
    libNtve_gf_SetAlliance(3, 5, 3);
    libNtve_gf_SetAlliance(4, 5, 3);
    Wait(0.5, c_timeReal);
    gv_lingsToAttackNorth = 0;
    UnitGroupLoopBegin(gv_lingsToAttackNorthGroup);
    while (!UnitGroupLoopDone()) {
        UnitKill(UnitGroupLoopCurrent());
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();
    Wait(60.0, c_timeGame);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, TextWithColor(StringExternal("Param/Value/BBA382EB"), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(5, true))));
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("Param/Value/D7013195"));
    Wait(60.0, c_timeGame);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, TextWithColor(StringExternal("Param/Value/32716376"), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(5, true))));
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("Param/Value/D4B816CA"));
    Wait(60.0, c_timeGame);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, TextWithColor(StringExternal("Param/Value/F6C92080"), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(5, true))));
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("Param/Value/2396E963"));
    Wait(60.0, c_timeGame);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, TextWithColor(StringExternal("Param/Value/6AD2BC1C"), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(5, true))));
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("Param/Value/11473D00"));
    Wait(60.0, c_timeGame);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, TextWithColor(StringExternal("Param/Value/24264A28"), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(5, true))));
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("Param/Value/EDF57C1D"));
    Wait(60.0, c_timeGame);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, TextWithColor(StringExternal("Param/Value/83D9E7D9"), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(5, true))));
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("Param/Value/61E80494"));
    Wait(60.0, c_timeGame);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, TextWithColor(StringExternal("Param/Value/F7CB22F9"), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(5, true))));
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("Param/Value/47BEA576"));
