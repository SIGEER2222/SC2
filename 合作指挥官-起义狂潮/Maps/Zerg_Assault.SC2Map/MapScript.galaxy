//--------------------------------------------------------------------------------------------------
// Trigger: Cameras Start
//--------------------------------------------------------------------------------------------------
bool gt_CamerasStart_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_SwooshCamera(1, ((CameraInfoGetValue(CameraInfoDefault(), c_cameraValueDistance)) + 8.0), 6.0, RegionGetCenter(RegionFromId(5)), 0.0);
    libNtve_gf_SwooshCamera(2, ((CameraInfoGetValue(CameraInfoDefault(), c_cameraValueDistance)) + 8.0), 6.0, RegionGetCenter(RegionFromId(5)), 0.0);
    libNtve_gf_SwooshCamera(3, ((CameraInfoGetValue(CameraInfoDefault(), c_cameraValueDistance)) + 8.0), 6.0, RegionGetCenter(RegionFromId(5)), 0.0);
    libNtve_gf_SwooshCamera(4, ((CameraInfoGetValue(CameraInfoDefault(), c_cameraValueDistance)) + 8.0), 6.0, RegionGetCenter(RegionFromId(5)), 0.0);
    CameraLockInput(1, true);
    CameraLockInput(2, true);
    CameraLockInput(3, true);
    CameraLockInput(4, true);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_CamerasStart_Init () {
    gt_CamerasStart = TriggerCreate("gt_CamerasStart_Func");
    TriggerAddEventTimeElapsed(gt_CamerasStart, 0.1, c_timeGame);
}

