bool auto_gf_SpawnWarpPrism_TriggerFunc (bool testConds, bool runActions) {
    abilcmd lp_unitWarpIn = auto_gf_SpawnWarpPrism_lp_unitWarpIn;
    fixed lp_rampUpTime = auto_gf_SpawnWarpPrism_lp_rampUpTime;
    int lp_player = auto_gf_SpawnWarpPrism_lp_player;
    fixed lp_initialTime = auto_gf_SpawnWarpPrism_lp_initialTime;
    fixed lp_enragedTime = auto_gf_SpawnWarpPrism_lp_enragedTime;
    point lp_target = auto_gf_SpawnWarpPrism_lp_target;

    // Variable Declarations
    timer lv_rampUpTimer;
    unit lv_warpPrism;
    int lv_warpPrismPing;
    int lv_cooldown;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_rampUpTimer = TimerCreate();
    lv_warpPrismPing = c_invalidPingId;

    // Implementation
    libNtve_gf_UnitCreateFacingPoint(1, "WarpPrism", 0, lp_player, gf_FindWarpPrismSpawn(lp_target), lp_target);
    lv_warpPrism = UnitLastCreated();
    libNtve_gf_CreatePingFacingAngle(PlayerGroupAll(), "PingSimple", UnitGetPosition(lv_warpPrism), ColorWithAlpha(100.00, 0.00, 0.00, 0.00), 0.0, 270.0);
    lv_warpPrismPing = PingLastCreated();
    PingSetScale(lv_warpPrismPing, 0.7);
    PingSetTooltip(lv_warpPrismPing, StringExternal("Param/Value/80B3E094"));
    PingSetUnit(lv_warpPrismPing, lv_warpPrism);
    libHots_gf_StorePingForUnit(lv_warpPrism, 1, lv_warpPrismPing);
    while (true) {
        if ((libNtve_gf_UnitInRegion(lv_warpPrism, RegionCircle(lp_target, 1.0)) == false)) {
            UnitIssueOrder(lv_warpPrism, OrderTargetingPoint(AbilityCommand("move", 0), lp_target), c_orderQueueReplace);
        }
        else {
            UnitIssueOrder(lv_warpPrism, Order(AbilityCommand("PhasingMode", 0)), c_orderQueueReplace);
            break;
        }
        Wait(1.0, c_timeAI);
        if (((UnitIsAlive(lv_warpPrism) == false))) {
            PingDestroy(lv_warpPrismPing);
            return true;
        }

    }
    TimerStart(lv_rampUpTimer, lp_rampUpTime, false, c_timeGame);
    while ((TimerGetRemaining(lv_rampUpTimer) > 0.0)) {
        Wait(1.0, c_timeAI);
        if (((UnitIsAlive(lv_warpPrism) == false))) {
            PingDestroy(lv_warpPrismPing);
            return true;
        }

        UnitIssueOrder(gv_prismSuperWarpGate, OrderTargetingPoint(lp_unitWarpIn, lp_target), c_orderQueueReplace);
        AISetUnitSuicide(UnitLastCreated(), true);
        Wait(lp_initialTime, c_timeGame);
    }
    while (true) {
        Wait(1.0, c_timeAI);
        if (((UnitIsAlive(lv_warpPrism) == false))) {
            PingDestroy(lv_warpPrismPing);
            return true;
        }

        UnitIssueOrder(gv_prismSuperWarpGate, OrderTargetingPoint(lp_unitWarpIn, lp_target), c_orderQueueReplace);
        AISetUnitSuicide(UnitLastCreated(), true);
        Wait(lp_enragedTime, c_timeGame);
    }
    return true;
}

point gf_FindWarpPrismSpawn (point lp_target) {
    // Variable Declarations
    int lv_i;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    if (((RegionContainsPoint(RegionFromId(77), lp_target) == true) || (RegionContainsPoint(RegionFromId(81), lp_target) == true))) {
        return PointFromId(1319970555);
    }

    if (((RegionContainsPoint(RegionFromId(80), lp_target) == true) || (RegionContainsPoint(RegionFromId(82), lp_target) == true))) {
        return PointFromId(375693997);
    }

    if (((RegionContainsPoint(RegionFromId(83), lp_target) == true) || (RegionContainsPoint(RegionFromId(84), lp_target) == true))) {
        return PointFromId(353827727);
    }

    if (((RegionContainsPoint(RegionFromId(79), lp_target) == true))) {
        return PointFromId(1495532658);
    }

    if (((RegionContainsPoint(RegionFromId(78), lp_target) == true))) {
        return PointFromId(2104871420);
    }

    return PointFromId(1319970555);
}

void gf_DominionDistraction (int lp_player) {
    // Automatic Variable Declarations
    // Implementation
    if ((UnitCount(null, gv_pLAYER13_DOMINION, RegionFromId(45), UnitFilter((1 << c_targetFilterStructure) | (1 << c_targetFilterVisible), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0) > 0) && (gv_distractionOver == false)) {
        AIAttackWaveAddWaypoint(lp_player, PointFromId(823312255), false);
    }

}

void gf_FlankAttack (int lp_player, bool lp_north) {
    // Automatic Variable Declarations
    // Implementation
    if (((lp_north == false))) {
        AIAttackWaveAddWaypoint(lp_player, PointFromId(240), true);
        AIAttackWaveAddWaypoint(lp_player, PointFromId(252), true);
        AIAttackWaveAddWaypoint(lp_player, PointFromId(232), true);
    }
    else {
        AIAttackWaveAddWaypoint(lp_player, PointFromId(240), true);
        AIAttackWaveAddWaypoint(lp_player, PointFromId(336), true);
        AIAttackWaveAddWaypoint(lp_player, PointFromId(350), true);
    }
}

