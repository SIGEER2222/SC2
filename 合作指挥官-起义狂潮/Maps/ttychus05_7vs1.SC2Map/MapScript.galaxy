    if ((TriggerGetExecCount(TriggerGetCurrent()) == 3)) {
        libE0EAE146_gf_Bon2();
        lib67C0F0E7_gf_ObjectiveSet(false, 2, lib67C0F0E7_ge_ObjectiveSet_FinishM);
        TriggerEnable(TriggerGetCurrent(), false);
    }
    else {
        lib67C0F0E7_gf_ObjectiveSet(false, 2, lib67C0F0E7_ge_ObjectiveSet_Add);
    }
    TriggerExecute(gt_PrisonDialogueQ, true, false);
    return true;
}

