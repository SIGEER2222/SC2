//--------------------------------------------------------------------------------------------------
// Trigger: Reinforce Regions With Bullies
//--------------------------------------------------------------------------------------------------
bool gt_ReinforceRegionsWithBullies_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(300.0, c_timeGame);
    Wait(300.0, c_timeGame);
    AIToggleBulliesInRegion(gv_pLAYER11_FORWARDGUARD, RegionFromId(60), true);
    Wait(300.0, c_timeGame);
    gv_globalForgeIntensity += 1;
    AIToggleBulliesInRegion(gv_pLAYER_04_SCIONS, RegionFromId(64), true);
    AIToggleBulliesInRegion(gv_pLAYER_03_PHASESMITHS, RegionFromId(62), true);
    AIToggleBulliesInRegion(gv_pLAYER9_WORLDSHIPFORWARD, RegionFromId(61), true);
    Wait(300.0, c_timeGame);
    gv_prismIntensity += 1;
    AIToggleBulliesInRegion(gv_pLAYER_03_PHASESMITHS, RegionFromId(63), true);
    AIToggleBulliesInRegion(gv_pLAYER10_HARBINGERS, RegionFromId(66), true);
