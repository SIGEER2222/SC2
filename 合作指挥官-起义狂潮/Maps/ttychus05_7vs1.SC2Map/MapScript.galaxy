bool gt_MothershipMidCleanup_Func (bool testConds, bool runActions) {
    // Variable Declarations
    fixed lv_fadeDuration;

    // Automatic Variable Declarations
    unitgroup auto6D45936A_g;
    int auto6D45936A_u;
