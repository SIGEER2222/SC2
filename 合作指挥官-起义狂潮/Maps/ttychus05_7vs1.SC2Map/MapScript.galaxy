    }

    autoBB598030_val = libNtve_gf_KillingPlayer();
    if (autoBB598030_val == gv_pLAYER13_DOMINION) {
        gv_dominionKills += 1;
    }
    else if (autoBB598030_val == gv_pLAYER14_NERAZIM) {
        gv_nerazimKills += 1;
    }
    else {
    }
    return true;
}

