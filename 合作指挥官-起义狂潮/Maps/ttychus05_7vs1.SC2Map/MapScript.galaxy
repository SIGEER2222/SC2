    TriggerEnable(gt_NyonReinforcementsSuicide, false);
    TriggerAddEventTimePeriodic(gt_NyonReinforcementsSuicide, 5.0, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Nyon Prism Drop Repeat Transmission
//--------------------------------------------------------------------------------------------------
bool gt_NyonPrismDropRepeatTransmission_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    int auto15A4F0BF_val;

    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if (gv_prismCycle >= 3) {
        gv_prismCycle = 0;
    }
    else {
        gv_prismCycle = gv_prismCycle + 1;
    }
    TriggerQueueEnter();
    auto15A4F0BF_val = gv_prismCycle;
    if (auto15A4F0BF_val == 0) {
        libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
        libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
        libCamp_gf_SendTransmissionCampaign(null, SoundLink("TTychus05TaldarimExecutor00043", 0), c_transmissionDurationAdd, 0.0, true);
        libCamp_gf_SendTransmissionCampaign(null, SoundLink("TTychus02Raynor00032", 0), c_transmissionDurationAdd, 0.0, true);
        libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    }
    else if (auto15A4F0BF_val == 1) {
        libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
        libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
        libCamp_gf_SendTransmissionCampaign(null, SoundLink("TTychus05TaldarimExecutor00040", 0), c_transmissionDurationAdd, 0.0, true);
        libCamp_gf_SendTransmissionCampaign(null, SoundLink("TTychus02Raynor00034", 0), c_transmissionDurationAdd, 0.0, true);
        libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    }
    else if (auto15A4F0BF_val == 2) {
        libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
        libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
        libCamp_gf_SendTransmissionCampaign(null, SoundLink("TTychus05TaldarimExecutor00041", 0), c_transmissionDurationAdd, 0.0, true);
        libCamp_gf_SendTransmissionCampaign(null, SoundLink("TValerian02ARaynor00087", 0), c_transmissionDurationAdd, 0.0, true);
        libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    }
    else if (auto15A4F0BF_val == 3) {
        libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
        libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
        libCamp_gf_SendTransmissionCampaign(null, SoundLink("TTychus02TalDarimExecutor00027", 0), c_transmissionDurationAdd, 0.0, true);
        libCamp_gf_SendTransmissionCampaign(null, SoundLink("THorner05SRaynor00051", 0), c_transmissionDurationAdd, 0.0, true);
        libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    }
    else {
    }
    TriggerQueueExit();
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_NyonPrismDropRepeatTransmission_Init () {
    gt_NyonPrismDropRepeatTransmission = TriggerCreate("gt_NyonPrismDropRepeatTransmission_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Start AI
//--------------------------------------------------------------------------------------------------
bool gt_StartAI_Func (bool testConds, bool runActions) {
    // Variable Declarations
    playergroup lv_pG;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_pG = PlayerGroupEmpty();

    // Conditions
    if (testConds) {
        if (!((TriggerGetExecCount(TriggerGetCurrent()) == 0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    CampaignInitAI();
    PlayerGroupAdd(lv_pG,2);
    PlayerGroupAdd(lv_pG,13);
    lib67C0F0E7_gf_AIUpgradeDefault(lv_pG);
    return true;
}

