bool gt_DestroyNydusandPrismPings_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!(((UnitGetType(EventUnit()) == "WarpPrism") || (UnitGetType(EventUnit()) == "WarpPrismPhasing") || (UnitGetType(EventUnit()) == "NydusCanal") || (UnitGetType(EventUnit()) == "VoidRift")))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    PingDestroy(libHots_gf_PingStoredForUnit(EventUnit(), 1));
    return true;
}

