        AIAttackWaveAddUnits4(2, 2, 2, 3, "Sentry");
        AIAttackWaveAddUnits4(2, 2, 2, 3, "CorsairMP");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "DarkArchon");
        AIAttackWaveAddUnits4(3, 3, 3, 3, "VoidRayShakuras");
