//--------------------------------------------------------------------------------------------------
bool gt_StartAIWaves_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TimerStart(gv_distractionTimer, 1200.0, false, c_timeGame);
    TimerStart(gv_nyonArrivalTimer, 960.0, false, c_timeGame);
    TriggerExecute(gt_P13DominionAttacks, true, false);
    TriggerExecute(gt_P11ForwardGuardAttackWaves, true, false);
    TriggerExecute(gt_P4ScionsAttackWaves, true, false);
    TriggerExecute(gt_P3SmithAttackWaves, true, false);
    TriggerExecute(gt_P6DeathFleetAttackWaves, true, false);
    TriggerExecute(gt_P9WorldshipForwardGuardAttackWaves, true, false);
    TriggerExecute(gt_P10HarbingersAttackWaves, true, false);
    TriggerExecute(gt_P12HonorGuardAttackWaves, true, false);
    TriggerExecute(gt_P8EliteGuardAttackWaves, true, false);
    TriggerExecute(gt_ReinforceRegionsWithBullies, true, false);
