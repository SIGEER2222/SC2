//--------------------------------------------------------------------------------------------------
// Trigger: Void Rift Spawns
//--------------------------------------------------------------------------------------------------
bool gt_VoidRiftSpawns_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }

        if (!((UnitGetPropertyFixed(gv_uNITDaMothership, c_unitPropLifePercent, c_unitPropCurrent) <= 95.0))) {
            return false;
        }

        if (!((UnitIsAlive(gv_uNITDaMothership) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    RegionAddRegion(gv_voidRiftSpawns, RegionFromId(86));
    RegionAddRegion(gv_voidRiftSpawns, RegionFromId(87));
    RegionAddRegion(gv_voidRiftSpawns, RegionFromId(88));
    while (true) {
        if ((UnitCountAlliance(gv_pLAYER_02_NYON, c_unitAllianceEnemy, RegionCircle(UnitGetPosition(gv_uNITDaMothership), 15.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0) >= 5)) {
            gf_CreateVoidRift();
            gf_CreateVoidRift();
            if ((libNtve_gf_DifficultyValueInt(0, 0, 1, 1) == 1)) {
                gf_CreateVoidRift();
            }

            if ((libNtve_gf_DifficultyValueInt(0, 0, 0, 1) == 1) && (UnitGetPropertyFixed(gv_uNITDaMothership, c_unitPropLifePercent, c_unitPropCurrent) <= 60.0)) {
                gf_CreateVoidRift();
            }

            Wait(libNtve_gf_DifficultyValueFixed(60.0, 60.0, 55.0, 45.0), c_timeGame);
        }
        else {
            Wait(2.0, c_timeGame);
        }
    }
    return true;
}

