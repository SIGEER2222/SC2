//--------------------------------------------------------------------------------------------------
// Trigger: Nyon Reinforcements Suicide
//--------------------------------------------------------------------------------------------------
bool gt_NyonReinforcementsSuicide_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup autoF4EAEF8F_g;
    int autoF4EAEF8F_u;
    unit autoF4EAEF8F_var;

    // Actions
    if (!runActions) {
        return true;
    }

    autoF4EAEF8F_g = UnitGroup(null, gv_pLAYER_02_NYON, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterHeroic) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    autoF4EAEF8F_u = UnitGroupCount(autoF4EAEF8F_g, c_unitCountAll);
    for (;; autoF4EAEF8F_u -= 1) {
        autoF4EAEF8F_var = UnitGroupUnitFromEnd(autoF4EAEF8F_g, autoF4EAEF8F_u);
        if (autoF4EAEF8F_var == null) { break; }
        if (((UnitGetType(autoF4EAEF8F_var) != "WarpPrism") || (UnitGetType(autoF4EAEF8F_var) != "WarpPrismPhasing"))) {
            AISetUnitSuicide(autoF4EAEF8F_var, true);
        }

    }
    return true;
}

