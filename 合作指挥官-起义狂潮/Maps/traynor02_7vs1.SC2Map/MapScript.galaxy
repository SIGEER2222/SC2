bool gt_HellionAttack_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unitgroup lv_uG;
    unit lv_u;

    // Automatic Variable Declarations
    unitgroup autoCD89A1AD_g;
    int autoCD89A1AD_u;

    // Variable Initialization
    lv_uG = UnitGroupEmpty();

    // Actions
    if (!runActions) {
        return true;
    }

    UnitGroupAdd(lv_uG, UnitFromId(430));
    UnitGroupAdd(lv_uG, UnitFromId(87));
    UnitGroupAdd(lv_uG, UnitFromId(367));
    UnitGroupAdd(lv_uG, UnitFromId(431));
    autoCD89A1AD_g = UnitLastCreatedGroup();
    autoCD89A1AD_u = UnitGroupCount(autoCD89A1AD_g, c_unitCountAll);
    for (;; autoCD89A1AD_u -= 1) {
        lv_u = UnitGroupUnitFromEnd(autoCD89A1AD_g, autoCD89A1AD_u);
        if (lv_u == null) { break; }
        UnitSetOwner(lv_u, gv_pLAYER_02_DOMINION, true);
        AISetUnitSuicide(lv_u, true);
        AISetUnitScriptControlled(lv_u, false);
    }
    return true;
}

