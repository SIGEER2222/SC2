<?xml version="1.0" encoding="utf-8"?>
<Catalog>
    <!-- 小队弹仓系统：CAbilArmMagazine External 机制
         Distance=5 让弹药单位距英雄5格，配合4个ExternalAngle(90度间隔)
         4个单位彼此间距约5*1.414≈7格，避免地面单位互相碰撞挤压
         Leash=12 召回距离，CountStart=4 初始即4个，AutoBuild 自动补充 -->
    <CAbilArmMagazine id="SquadMagazine">
        <AbilSetId value="SquadMagazine"/>
        <EditorCategories value="Race:Terran,AbilityorEffectType:Units"/>
        <Flags index="AutoCreate" value="1"/>
        <Flags index="Retarget" value="1"/>
        <Leash value="12"/>
        <EffectArray index="Death" value="InterceptorFate"/>
        <InfoArray index="Ammo1" Time="8" CountStart="4" Distance="5" Manage="Recall" Unit="Marauder">
            <Charge Location="Unit"/>
            <Button DefaultButtonFace="SquadMagazine">
                <Flags index="ToSelection" value="1"/>
            </Button>
            <Flags index="External" value="1"/>
            <Flags index="AutoBuild" value="1"/>
        </InfoArray>
        <ExternalAngle value="0"/>
        <ExternalAngle value="90"/>
        <ExternalAngle value="180"/>
        <ExternalAngle value="270"/>
        <Alert value="TrainComplete"/>
        <MaxCount value="4"/>
    </CAbilArmMagazine>
</Catalog>
