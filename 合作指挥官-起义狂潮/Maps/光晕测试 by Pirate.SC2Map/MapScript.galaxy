void gf_InitDebugUI () {
    // Automatic Variable Declarations
    // Implementation
    DialogControlHookupStandard(c_triggerControlTypePanel, "UIContainer/DebugFrame");
    gv_debugHaloFrame = DialogControlLastCreated();
    DialogControlHookupStandard(c_triggerControlTypeSlider, "UIContainer/DebugFrame/Emission");
    gv_debugSliderHaloEmission = DialogControlLastCreated();
    TriggerAddEventDialogControl(gt_DebugFrameSetHaloEmission, c_playerAny, gv_debugSliderHaloEmission, c_triggerControlEventTypeValueChanged);
    DialogControlHookupStandard(c_triggerControlTypeSlider, "UIContainer/DebugFrame/Width");
    gv_debugSliderHaloWidth = DialogControlLastCreated();
    TriggerAddEventDialogControl(gt_DebugFrameSetHaloWidth, c_playerAny, gv_debugSliderHaloWidth, c_triggerControlEventTypeValueChanged);
    DialogControlHookupStandard(c_triggerControlTypeSlider, "UIContainer/DebugFrame/Type");
    gv_debugSliderHaloType = DialogControlLastCreated();
    TriggerAddEventDialogControl(gt_DebugFrameSetHaloType, c_playerAny, gv_debugSliderHaloType, c_triggerControlEventTypeValueChanged);
    DialogControlHookupStandard(c_triggerControlTypeSlider, "UIContainer/DebugFrame/RasterMode");
    gv_debugSliderHaloRasterMode = DialogControlLastCreated();
    TriggerAddEventDialogControl(gt_DebugFrameSetHaloRasterMode, c_playerAny, gv_debugSliderHaloRasterMode, c_triggerControlEventTypeValueChanged);
    DialogControlHookupStandard(c_triggerControlTypeSlider, "UIContainer/DebugFrame/Color");
    gv_debugSliderHaloColor = DialogControlLastCreated();
    TriggerAddEventDialogControl(gt_DebugFrameSetHaloColor, c_playerAny, gv_debugSliderHaloColor, c_triggerControlEventTypeValueChanged);
    DialogControlHookupStandard(c_triggerControlTypeButton, "UIContainer/DebugFrame/Reset");
    gv_debugButtonHaloReset = DialogControlLastCreated();
    TriggerAddEventDialogControl(gt_DebugFrameButtonHaloReset, c_playerAny, gv_debugButtonHaloReset, c_triggerControlEventTypeClick);
    DialogControlHookupStandard(c_triggerControlTypeButton, "UIContainer/DebugFrame/HaloOn");
    gv_debugButtonHaloOn = DialogControlLastCreated();
    TriggerAddEventDialogControl(gt_DebugFrameButtonHaloOn, c_playerAny, gv_debugButtonHaloOn, c_triggerControlEventTypeClick);
    DialogControlHookupStandard(c_triggerControlTypeButton, "UIContainer/DebugFrame/HaloOff");
    gv_debugButtonHaloOff = DialogControlLastCreated();
    TriggerAddEventDialogControl(gt_DebugFrameButtonHaloOff, c_playerAny, gv_debugButtonHaloOff, c_triggerControlEventTypeClick);
}

void gf_GlobalHaloOn () {
    // Automatic Variable Declarations
    unitgroup auto1E1C9F4E_g;
    int auto1E1C9F4E_u;
    unit auto1E1C9F4E_var;

    // Implementation
    auto1E1C9F4E_g = UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    auto1E1C9F4E_u = UnitGroupCount(auto1E1C9F4E_g, c_unitCountAll);
    for (;; auto1E1C9F4E_u -= 1) {
        auto1E1C9F4E_var = UnitGroupUnitFromEnd(auto1E1C9F4E_g, auto1E1C9F4E_u);
        if (auto1E1C9F4E_var == null) { break; }
        libNtve_gf_SendActorMessageToUnit(auto1E1C9F4E_var, "HaloStart");
    }
}

void gf_GlobalHaloOff () {
    // Automatic Variable Declarations
    unitgroup auto6A4EA411_g;
    int auto6A4EA411_u;
    unit auto6A4EA411_var;

    // Implementation
    auto6A4EA411_g = UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    auto6A4EA411_u = UnitGroupCount(auto6A4EA411_g, c_unitCountAll);
    for (;; auto6A4EA411_u -= 1) {
        auto6A4EA411_var = UnitGroupUnitFromEnd(auto6A4EA411_g, auto6A4EA411_u);
        if (auto6A4EA411_var == null) { break; }
        libNtve_gf_SendActorMessageToUnit(auto6A4EA411_var, "HaloStop");
    }
}

void gf_GlobalHaloReset () {
    // Automatic Variable Declarations
    // Implementation
    libNtve_gf_SetDialogItemCurrentValue(gv_debugSliderHaloWidth, 1.0, PlayerGroupAll());
    libNtve_gf_SetDialogItemCurrentValue(gv_debugSliderHaloType, 0.0, PlayerGroupAll());
    libNtve_gf_SetDialogItemCurrentValue(gv_debugSliderHaloRasterMode, 0.0, PlayerGroupAll());
    libNtve_gf_SetDialogItemCurrentValue(gv_debugSliderHaloEmission, 4.0, PlayerGroupAll());
    libNtve_gf_SetDialogItemCurrentValue(gv_debugSliderHaloColor, 2.0, PlayerGroupAll());
}

//--------------------------------------------------------------------------------------------------
// Trigger: Init
//--------------------------------------------------------------------------------------------------
bool gt_Init_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    ConsoleCommand("ShowMap", true, true);
    CameraPan(1, RegionGetCenter(RegionPlayableMap()), 0.0, -1, 10.0, false);
    TriggerEnable(gt_DebugFrameButtonHaloOff, true);
    TriggerEnable(gt_DebugFrameButtonHaloOn, true);
    TriggerEnable(gt_DebugFrameButtonHaloReset, true);
    TriggerEnable(gt_DebugFrameSetHaloColor, true);
    TriggerEnable(gt_DebugFrameSetHaloEmission, true);
    TriggerEnable(gt_DebugFrameSetHaloRasterMode, true);
    TriggerEnable(gt_DebugFrameSetHaloType, true);
    TriggerEnable(gt_DebugFrameSetHaloWidth, true);
    gf_InitVariables();
    gf_InitDebugUI();
    gf_GlobalHaloOn();
    DialogControlSetAnimationState(gv_debugHaloFrame, PlayerGroupAll(), "Display", "True");
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_Init_Init () {
    gt_Init = TriggerCreate("gt_Init_Func");
    TriggerAddEventMapInit(gt_Init);
}

