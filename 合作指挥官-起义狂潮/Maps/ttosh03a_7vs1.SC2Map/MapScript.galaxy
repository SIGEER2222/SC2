//--------------------------------------------------------------------------------------------------
bool gt_PAttack1_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_type;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    lv_type = RandomInt(1, 6);
    libE0EAE146_gf_EnemyBriefSet("T", lv_type);
    Wait(180.0, c_timeAI);
    gf_AttackWaveRun1(lv_type, 1);
    Wait(180.0, c_timeAI);
    gf_AttackWaveRun1(lv_type, 2);
    Wait(180.0, c_timeAI);
    gf_AttackWaveRun1(lv_type, 3);
    Wait(180.0, c_timeAI);
    gf_AttackWaveRun1(lv_type, 4);
    Wait(gv_p3Attack, c_timeAI);
    gf_AttackWaveRun1(lv_type, 5);
    Wait(gv_p3Attack, c_timeAI);
    gf_AttackWaveRun1(lv_type, 5);
    Wait(gv_p3Attack, c_timeAI);
    gf_AttackWaveRun1(lv_type, gv_attack1);
    while (true) {
        Wait(gv_p3Attack, c_timeAI);
        gf_AttackWaveRun1(lv_type, gv_attack1);
    }
    return true;
}

