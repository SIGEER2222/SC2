    AIAttackWaveAddUnits4(4, 4, 5, 6, "Goliath");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "ScienceVessel");
    AIAttackWaveSend(lv_aI, 180, true);
    while (true) {
        Wait(1.0, c_timeGame);
        AIAttackWaveAddWaypoint(lv_aI, PointFromId(1869335792), false);
        AIAttackWaveAddUnits4(4, 4, 5, 6, "WarHound");
        AIAttackWaveAddUnits4(5, 5, 6, 8, "MengskMarine");
        AIAttackWaveAddUnits4(4, 4, 5, 6, "MengskHellion");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "ScienceVessel");
        AIAttackWaveSend(lv_aI, 180, true);
        AIAttackWaveAddWaypoint(lv_aI, PointFromId(1869335792), false);
        AIAttackWaveAddUnits4(3, 3, 4, 5, "Goliath");
        AIAttackWaveAddUnits4(3, 3, 4, 5, "SiegeTankSieged");
        AIAttackWaveAddUnits4(2, 2, 3, 4, "Banshee");
        AIAttackWaveSend(lv_aI, 180, true);
