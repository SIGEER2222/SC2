    int autoBB1BE08F_u;
    unit autoBB1BE08F_var;
    unitgroup auto013F4A90_g;
    int auto013F4A90_u;
    unit auto013F4A90_var;

    // Actions
    if (!runActions) {
        return true;
    }

    gv_inCinematic = true;
    CinematicFade(false, 1.0, c_fadeStyleNormal, ColorWithAlpha(0.00, 0.00, 0.00, 0.00), 0.0, false);
    UISetMode(PlayerGroupAll(), c_uiModeFullscreen, 1.0);
    Wait(1.0, c_timeReal);
    libNtve_gf_CinematicMode(true, PlayerGroupAll(), 0.0);
    libNtve_gf_GlobalCinematicSetting(true);
    UnitClearSelection(gv_p1_USER);
    PlayerSetState(gv_p1_USER, c_playerStateXPGain, false);
    GameTimeOfDaySetLength(0.0);
    UnitPauseAll(true);
    AITimePause(true);
    auto78B76CF7_g = UnitGroup("Bunker", gv_p3_DOMINION_RED, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    auto78B76CF7_u = UnitGroupCount(auto78B76CF7_g, c_unitCountAll);
    for (;; auto78B76CF7_u -= 1) {
        auto78B76CF7_var = UnitGroupUnitFromEnd(auto78B76CF7_g, auto78B76CF7_u);
        if (auto78B76CF7_var == null) { break; }
        UnitRemove(auto78B76CF7_var);
    }
    autoEE49C787_g = UnitGroup(null, gv_p3_DOMINION_RED, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    autoEE49C787_u = UnitGroupCount(autoEE49C787_g, c_unitCountAll);
    for (;; autoEE49C787_u -= 1) {
        autoEE49C787_var = UnitGroupUnitFromEnd(autoEE49C787_g, autoEE49C787_u);
        if (autoEE49C787_var == null) { break; }
        UnitRemove(autoEE49C787_var);
    }
    autoBB1BE08F_g = UnitGroup("DestructibleSandbags", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    autoBB1BE08F_u = UnitGroupCount(autoBB1BE08F_g, c_unitCountAll);
    for (;; autoBB1BE08F_u -= 1) {
        autoBB1BE08F_var = UnitGroupUnitFromEnd(autoBB1BE08F_g, autoBB1BE08F_u);
        if (autoBB1BE08F_var == null) { break; }
        UnitRemove(autoBB1BE08F_var);
    }
    gv_victoryHiddenUnitGroup = UnitGroup(null, gv_p1_USER, null, UnitFilter(0, 0, 0, 0), 0);
    auto013F4A90_g = gv_victoryHiddenUnitGroup;
    auto013F4A90_u = UnitGroupCount(auto013F4A90_g, c_unitCountAll);
    for (;; auto013F4A90_u -= 1) {
        auto013F4A90_var = UnitGroupUnitFromEnd(auto013F4A90_g, auto013F4A90_u);
        if (auto013F4A90_var == null) { break; }
        libNtve_gf_ShowHideUnit(auto013F4A90_var, false);
    }
    return true;
}

