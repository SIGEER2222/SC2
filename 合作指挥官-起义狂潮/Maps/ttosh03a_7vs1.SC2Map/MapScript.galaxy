//--------------------------------------------------------------------------------------------------
// Trigger: Start Game
//--------------------------------------------------------------------------------------------------
bool gt_StartGame_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    libE0EAE146_gf_StartGame();
    lib67C0F0E7_gf_ObjectiveNew(true, StringExternal("Param/Value/B9A1EBD1"), 1, false, 0, 0);
    lib67C0F0E7_gf_ObjectiveNew(false, StringExternal("Param/Value/4EE4AFF4"), 1, true, 0, 3);
    lib67C0F0E7_gf_ObjectiveNew(false, StringExternal("Param/Value/05483C25"), 2, false, 0, 0);
    if ((libNtve_gf_DifficultyValueInt(0, 0, 1, 1) == 1)) {
        TimerStart(gv_achievementHardTimer, 1500.0, false, c_timeAI);
    }

    UnitIssueOrder(UnitFromId(227), Order(AbilityCommand("ArmSiloWithNuke", 0)), c_orderQueueReplace);
    Wait(1.0, c_timeReal);
    lib67C0F0E7_gf_ObjectiveSet(true, 1, lib67C0F0E7_ge_ObjectiveSet_Show);
    Wait(1.0, c_timeReal);
    lib67C0F0E7_gf_ObjectiveSet(false, 1, lib67C0F0E7_ge_ObjectiveSet_Show);
    Wait(1.0, c_timeReal);
    lib67C0F0E7_gf_ObjectiveSet(false, 2, lib67C0F0E7_ge_ObjectiveSet_Show);
    Wait(4.0, c_timeReal);
    TriggerExecute(gt_OpeningDialogueQ, true, false);
    Wait(2.0, c_timeGame);
    TriggerExecute(gt_StartAI, true, false);
    libE0EAE146_gf_MutatorRuntimeStartFromAttribute(gv_p3_DOMINION_RED);
    Wait(2.0, c_timeGame);
    TriggerExecute(gt_DialogueRaynorsForcesQ, true, false);
    Wait(60.0, c_timeGame);
    TriggerEnable(gt_MidLaneBase1, true);
    TriggerEnable(gt_MidLaneBase2, true);
    TriggerEnable(gt_BotLaneBase1, true);
    TriggerEnable(gt_BotLaneBase2, true);
    TriggerEnable(gt_TopLaneBase1, true);
    TriggerEnable(gt_TopLaneBase2, true);
    TriggerEnable(gt_TopLaneBaseCheckpoint, true);
    SoundPlay(SoundLink("UI_TerranPing", 0), PlayerGroupAll(), 100.0, 0.0);
    TriggerQueueEnter();
    Wait(2.0, c_timeReal);
    lib67C0F0E7_gf_PingPointI(UnitGetPosition(UnitFromId(1867375641)), "PingTriangle", Color(100.00, 100.00, 0.00), 1);
    lib67C0F0E7_gf_PingPointI(UnitGetPosition(UnitFromId(1953989665)), "PingTriangle", Color(100.00, 100.00, 0.00), 2);
    lib67C0F0E7_gf_PingPointI(UnitGetPosition(UnitFromId(1430884971)), "PingTriangle", Color(100.00, 100.00, 0.00), 3);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
    libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
    // Transmission - SoundLink("TTosh03AHorner00013", -1)
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TTosh03AHorner00013", 0), c_transmissionDurationAdd, 0.0, true);
    // Transmission - SoundLink("TTosh03ARaynor00002", -1)
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TTosh03ARaynor00002", 0), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    TriggerQueueExit();
    return true;
}

