//--------------------------------------------------------------------------------------------------
// Trigger: P3Attack
//--------------------------------------------------------------------------------------------------
bool gt_P3Attack_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    int auto2C5C6664_val;

    // Actions
    if (!runActions) {
        return true;
    }

    auto2C5C6664_val = UnitGetOwner(EventUnit());
    if (auto2C5C6664_val == 5) {
        gv_attack1 -= 1;
        gv_p3Attack += 5;
    }
    else if (auto2C5C6664_val == 4) {
        gv_attack2 -= 1;
        gv_p3Attack += 5;
    }
    else if (auto2C5C6664_val == 6) {
        gv_attack3 -= 1;
        gv_p3Attack += 5;
    }
    else {
    }
    if ((TriggerGetExecCount(TriggerGetCurrent()) == 5)) {
        TriggerEnable(TriggerGetCurrent(), false);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_P3Attack_Init () {
    gt_P3Attack = TriggerCreate("gt_P3Attack_Func");
    TriggerAddEventUnitDied(gt_P3Attack, UnitRefFromUnit(UnitFromId(1493937984)));
    TriggerAddEventUnitDied(gt_P3Attack, UnitRefFromUnit(UnitFromId(1121091931)));
    TriggerAddEventUnitDied(gt_P3Attack, UnitRefFromUnit(UnitFromId(2015960075)));
    TriggerAddEventUnitDied(gt_P3Attack, UnitRefFromUnit(UnitFromId(2135286659)));
    TriggerAddEventUnitDied(gt_P3Attack, UnitRefFromUnit(UnitFromId(1653075147)));
    TriggerAddEventUnitDied(gt_P3Attack, UnitRefFromUnit(UnitFromId(1222550265)));
}

