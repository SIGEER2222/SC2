//--------------------------------------------------------------------------------------------------
// Trigger: P2 Attack Waves
//--------------------------------------------------------------------------------------------------
bool gt_P2AttackWaves_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_aI;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_aI = 2;

    // Actions
    if (!runActions) {
        return true;
    }

    AIAttackWaveSetTargetPlayer(lv_aI, PlayerGroupSingle(1));
    AIAttackWaveSetGatherPoint(lv_aI, PointFromId(1515787681));
    AIAttackWaveAddUnits4(8, 8, 10, 12, "Zergling");
    AIAttackWaveSend(lv_aI, 180, true);
    AIAttackWaveAddUnits4(6, 6, 8, 10, "Zergling");
    AIAttackWaveAddUnits4(2, 2, 3, 3, "Queen");
    AIAttackWaveSend(lv_aI, 180, true);
    AIAttackWaveAddUnits4(6, 6, 7, 8, "Roach");
    AIAttackWaveAddUnits4(2, 2, 3, 3, "Ravager");
    AIAttackWaveAddUnits4(0, 0, 1, 1, "Infestor");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Overseer");
    AIAttackWaveSend(lv_aI, 180, true);
    AIAttackWaveAddUnits4(2, 2, 2, 3, "Baneling");
    AIAttackWaveAddUnits4(8, 8, 10, 12, "Zergling");
    AIAttackWaveSend(lv_aI, 180, true);
    AIAttackWaveAddUnits4(6, 6, 7, 8, "Roach");
    AIAttackWaveAddUnits4(8, 8, 10, 12, "Zergling");
    AIAttackWaveAddUnits4(1, 1, 1, 2, "Infestor");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Overseer");
    AIAttackWaveSend(lv_aI, 180, true);
    AIAttackWaveAddUnits4(3, 3, 4, 5, "Baneling");
    AIAttackWaveAddUnits4(1, 1, 1, 2, "Ravager");
    AIAttackWaveAddUnits4(1, 1, 1, 2, "Queen");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Overseer");
    AIAttackWaveSend(lv_aI, 180, true);
    while (true) {
        Wait(1.0, c_timeGame);
        AIAttackWaveAddUnits4(4, 4, 5, 7, "Roach");
        AIAttackWaveAddUnits4(2, 2, 3, 4, "Ravager");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Overseer");
        AIAttackWaveSend(lv_aI, 180, true);
        AIAttackWaveAddUnits4(2, 2, 3, 4, "Baneling");
        AIAttackWaveAddUnits4(2, 2, 3, 4, "Queen");
        AIAttackWaveAddUnits4(1, 1, 1, 2, "Infestor");
        AIAttackWaveAddUnits4(10, 10, 12, 16, "Zergling");
        AIAttackWaveSend(lv_aI, 180, true);
        AIAttackWaveAddUnits4(2, 2, 3, 4, "Ravager");
        AIAttackWaveAddUnits4(12, 12, 15, 20, "Zergling");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Overseer");
        AIAttackWaveSend(lv_aI, 180, true);
    }
    return true;
}

