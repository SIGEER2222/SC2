    gf_ZerglingStampede(3, PointFromId(315));
    Wait(1.0, c_timeGame);
    gf_ZerglingStampede(3, PointFromId(315));
    Wait(1.0, c_timeGame);
    gf_ZerglingStampede(3, PointFromId(313));
    Wait(1.0, c_timeGame);
    gf_ZerglingStampede(2, PointFromId(313));
    Wait(1.0, c_timeGame);
    gf_ZerglingStampede(1, PointFromId(313));
    gf_ZerglingStampede(2, PointFromId(315));
    return true;
}

