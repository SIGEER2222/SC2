    lib67C0F0E7_gf_ObjectiveNew(false, StringExternal("Param/Value/9C6FEAEA"), 3, false, 0, 0);
    TriggerExecute(gt_ObjectiveTiming, true, false);
    gv_lowGroundIsSafe = true;
    WaterSetState("Template 1|[Default]", 4.0, c_wtcLinear);
    TriggerExecute(gt_FirstSurge, true, false);
