void gf_IO (unit lp_u, unit lp_t, region lp_f) {
    // Automatic Variable Declarations
    // Implementation
    if ((UnitHasBehavior2(lp_u, "CarryHighYieldMineralFieldMinerals") == false) && (UnitHasBehavior2(lp_u, "CarryHarvestableVespeneGeyserGasZerg") == false) && (UnitHasBehavior2(lp_u, "CarryHarvestableRichVespeneGeyserGasZerg") == false)) {
        UnitIssueOrder(lp_u, OrderTargetingUnit(null, lp_t), c_orderQueueReplace);
        UnitIssueOrder(lp_u, OrderTargetingUnit(null, UnitGroupRandomUnit(UnitGroup(null, c_playerAny, lp_f, UnitFilter((1 << c_targetFilterHarvestableResource), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive)), c_orderQueueAddToEnd);
        AISetUnitScriptControlled(lp_u, false);
    }
    else {
        UnitIssueOrder(lp_u, OrderTargetingUnit(null, lp_t), c_orderQueueAddToEnd);
        UnitIssueOrder(lp_u, OrderTargetingUnit(null, UnitGroupRandomUnit(UnitGroup(null, c_playerAny, lp_f, UnitFilter((1 << c_targetFilterHarvestableResource), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive)), c_orderQueueAddToEnd);
        AISetUnitScriptControlled(lp_u, false);
    }
}

