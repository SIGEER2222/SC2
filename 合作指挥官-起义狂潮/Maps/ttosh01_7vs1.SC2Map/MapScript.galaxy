//--------------------------------------------------------------------------------------------------
// Trigger: Briefing Zerglings
//--------------------------------------------------------------------------------------------------
bool gt_BriefingZerglings_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    gf_ZerglingStampede(2, PointFromId(313));
