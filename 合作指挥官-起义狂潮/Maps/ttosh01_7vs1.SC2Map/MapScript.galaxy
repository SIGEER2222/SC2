    gt_TransmissionWatchSpendingWarningQ = TriggerCreate("gt_TransmissionWatchSpendingWarningQ_Func");
    TriggerAddEventUnitTrainProgress(gt_TransmissionWatchSpendingWarningQ, null, c_unitProgressStageComplete);
}

