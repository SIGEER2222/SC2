//--------------------------------------------------------------------------------------------------
// Trigger: bon1
//--------------------------------------------------------------------------------------------------
bool gt_bon1_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup autoCBE260B7_g;
    int autoCBE260B7_u;
    unit autoCBE260B7_var;

    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == 1))) {
            return false;
        }

        if (!((TriggerGetExecCount(TriggerGetCurrent()) == 0))) {
            return false;
        }

        if (!((UnitFilterMatch(EventUnit(), 1, UnitFilter(0, 0, (1 << c_targetFilterUser1) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32)))) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libE0EAE146_gf_Bon2();
    lib67C0F0E7_gf_ObjectiveSet(false, 1, lib67C0F0E7_ge_ObjectiveSet_Finish);
    TriggerEnable(TriggerGetCurrent(), false);
    autoCBE260B7_g = UnitGroup(null, gv_p05_TOSH, RegionFromId(24), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    autoCBE260B7_u = UnitGroupCount(autoCBE260B7_g, c_unitCountAll);
    for (;; autoCBE260B7_u -= 1) {
        autoCBE260B7_var = UnitGroupUnitFromEnd(autoCBE260B7_g, autoCBE260B7_u);
        if (autoCBE260B7_var == null) { break; }
        libNtve_gf_RescueUnit(autoCBE260B7_var, 1, true);
    }
    return true;
}

