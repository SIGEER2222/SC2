    gt_LavaTurnsOFF = TriggerCreate("gt_LavaTurnsOFF_Func");
    TriggerEnable(gt_LavaTurnsOFF, false);
    TriggerAddEventTimer(gt_LavaTurnsOFF, gv_lavaTimer);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Res
//--------------------------------------------------------------------------------------------------
bool gt_Res_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unitgroup lv_uG;

    // Automatic Variable Declarations
    int auto28B8DBFA_val;

    // Variable Initialization
    lv_uG = UnitGroupEmpty();

    // Actions
    if (!runActions) {
        return true;
    }

    auto28B8DBFA_val = TriggerGetExecCount(TriggerGetCurrent());
    if (auto28B8DBFA_val == 0) {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "FuelCellNeut", 0, 0, RegionRandomPoint(RegionFromId(25)));
        UnitGroupAdd(lv_uG, UnitLastCreated());
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "FuelCellNeut", 0, 0, RegionRandomPoint(RegionFromId(15)));
        UnitGroupAdd(lv_uG, UnitLastCreated());
        gf_ResPick(7, lv_uG);
    }
    else if (auto28B8DBFA_val == 1) {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "FuelCellNeut", 0, 0, RegionRandomPoint(RegionFromId(28)));
        UnitGroupAdd(lv_uG, UnitLastCreated());
        libNtve_gf_CreateUnitsWithDefaultFacing(2, "FuelCellNeut", 0, 0, RegionRandomPoint(RegionFromId(15)));
        UnitGroupAdd(lv_uG, UnitLastCreated());
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "FuelCellNeut", 0, 0, RegionRandomPoint(RegionFromId(23)));
        UnitGroupAdd(lv_uG, UnitLastCreated());
        gf_ResPick(7, lv_uG);
        gf_ResPick(4, lv_uG);
    }
    else if (auto28B8DBFA_val == 2) {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "FuelCellNeut", 0, 0, RegionRandomPoint(RegionFromId(21)));
        UnitGroupAdd(lv_uG, UnitLastCreated());
        libNtve_gf_CreateUnitsWithDefaultFacing(2, "FuelCellNeut", 0, 0, RegionRandomPoint(RegionFromId(15)));
        UnitGroupAdd(lv_uG, UnitLastCreated());
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "FuelCellNeut", 0, 0, RegionRandomPoint(RegionFromId(23)));
        UnitGroupAdd(lv_uG, UnitLastCreated());
        libNtve_gf_CreateUnitsWithDefaultFacing(2, "FuelCellNeut", 0, 0, RegionRandomPoint(RegionFromId(26)));
        UnitGroupAdd(lv_uG, UnitLastCreated());
        gf_ResPick(7, lv_uG);
        gf_ResPick(2, lv_uG);
        gf_ResPick(4, lv_uG);
    }
    else {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "FuelCellNeut", 0, 0, RegionRandomPoint(RegionFromName(("res" + IntToString(RandomInt(2, 7))))));
        UnitGroupAdd(lv_uG, UnitLastCreated());
        libNtve_gf_CreateUnitsWithDefaultFacing(2, "FuelCellNeut", 0, 0, RegionRandomPoint(RegionFromName(("res" + IntToString(RandomInt(2, 7))))));
        UnitGroupAdd(lv_uG, UnitLastCreated());
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "FuelCellNeut", 0, 0, RegionRandomPoint(RegionFromName(("res" + IntToString(RandomInt(2, 7))))));
        UnitGroupAdd(lv_uG, UnitLastCreated());
        libNtve_gf_CreateUnitsWithDefaultFacing(2, "FuelCellNeut", 0, 0, RegionRandomPoint(RegionFromName(("res" + IntToString(RandomInt(2, 7))))));
        UnitGroupAdd(lv_uG, UnitLastCreated());
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "FuelCellNeut", 0, 0, RegionRandomPoint(RegionFromName(("res" + IntToString(RandomInt(2, 7))))));
        UnitGroupAdd(lv_uG, UnitLastCreated());
        gf_ResPick(7, lv_uG);
        gf_ResPick(2, lv_uG);
        gf_ResPick(4, lv_uG);
    }
    return true;
}

