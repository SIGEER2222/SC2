    int init_i;

    for (init_i = 0; init_i <= 16; init_i += 1) {
        aiBB71817C_wave1_enabled[init_i] = true;
        aiBB71817C_wave1_lastWave[init_i] = null;
    }

    aiBB71817C_wave1_trigger = TriggerCreate("aiBB71817C_wave1_runFunc");
}

//--------------------------------------------------------------------------------------------------
