//--------------------------------------------------------------------------------------------------
trigger aiBB71817C_waves_trigger = null;
int aiBB71817C_waves_runPlayer;
playergroup aiBB71817C_waves_runTarget;

//--------------------------------------------------------------------------------------------------
void aiBB71817C_waves_init () {
    aiBB71817C_waves_trigger = TriggerCreate("aiBB71817C_waves_runFunc");
}

//--------------------------------------------------------------------------------------------------
bool aiBB71817C_waves_runFunc (bool c, bool a) {
    int p = aiBB71817C_waves_runPlayer;
    playergroup target = aiBB71817C_waves_runTarget;

    if (p < 0 || p >= 16) {
        return false;
    }

    aiBB71817C_wave1_run(p, target, true);
    aiBB71817C_wave2_run(p, target, true);
    aiBB71817C_wave3_run(p, target, true);
    aiBB71817C_wave4_run(p, target, true);
    aiBB71817C_wave5_run(p, target, true);
    aiBB71817C_wave6_run(p, target, true);
    aiBB71817C_wave7_run(p, target, true);
    aiBB71817C_wave8_run(p, target, true);
    aiBB71817C_wave9_run(p, target, true);
    aiBB71817C_wave10_run(p, target, true);

    while (true) {
        aiBB71817C_wave8_run(p, target, true);
        aiBB71817C_wave9_run(p, target, true);
        aiBB71817C_wave10_run(p, target, true);
    }

    return true;
}

