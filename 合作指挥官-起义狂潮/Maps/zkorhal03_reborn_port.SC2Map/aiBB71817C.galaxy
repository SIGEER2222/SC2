//--------------------------------------------------------------------------------------------------
bool aiBB71817C_wave1_runFunc (bool c, bool a) {
    int p = aiBB71817C_wave1_runPlayer;
    playergroup target = aiBB71817C_wave1_runTarget;
    int d;
    point gatherPoint = null;
    int ta = 0;
    int tg = 0;
    int ts = 0;
    int tf = 0;
    int td = 0;

    if (p < 0 || p >= 16) {
        return false;
    }
    d = PlayerDifficulty(p);
    if (!aiBB71817C_wave1_enabled[p]) {
        td = 0;
        if (td > 0) {
            Wait(td, c_timeAI);
        }
        return true;
    }

    aiBB71817C_customData[p] = "";

    ta = 0;
    if (d == 1) { ta = 300; }
    if (d == 2) { ta = 300; }
    if (d == 3) { ta = 300; }
    if (d == 4) { ta = 300; }
    tg = 0;
    ts = ta;
    if (tg > 0 && tg < ta) {
        Wait(ta - tg, c_timeAI);
        ts = tg;
    }
    AIAttackWaveSetTargetPlayer(p, target);

    gatherPoint = aiBB71817C_defGather[p];
    AIAttackWaveSetGatherPoint(p, gatherPoint);

    AIAttackWaveClearWaypoints(p);

    AIAttackWaveAddUnits(2, 4, "CauldronBorn");
    AIAttackWaveAddUnits(3, 4, "CauldronBorn");
    AIAttackWaveAddUnits(4, 4, "CauldronBorn");
    AIAttackWaveAddUnits(5, 4, "CauldronBorn");

    AIAttackWaveAddUnits(2, 4, "Brute");
    AIAttackWaveAddUnits(3, 4, "Brute");
    AIAttackWaveAddUnits(4, 4, "Brute");
    AIAttackWaveAddUnits(5, 4, "Brute");

    AIAttackWaveSend(p, ts, false);
    aiBB71817C_wave1_lastWave[p] = WaveLastCreated();
    aiBB71817C_lastWave[p] = aiBB71817C_wave1_lastWave[p];
    Wait(ts, c_timeAI);
    tf = 0;
    if (tf > 0) {
        Wait(tf, c_timeAI);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
