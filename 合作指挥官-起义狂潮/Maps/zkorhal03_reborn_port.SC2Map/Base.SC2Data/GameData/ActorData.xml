<?xml version="1.0" encoding="utf-8"?>
<Catalog>
    <CActorUnit id="Hyperion">
        <On Terms="Behavior.HyperjumpTeleportOut.On" Send="SetOpacity"/>
        <On Terms="Behavior.HyperjumpTeleportIn.Off" Send="SetOpacity 1.000000"/>
        <On Terms="Behavior.HyperjumpTeleport.On" Send="Create BattleCruiserTacticalJump_Placement"/>
        <On Terms="Behavior.HyperjumpTeleportIn.Off" Target="BattleCruiserTacticalJump_Placement" Send="AnimBracketStop BSD"/>
        <On Terms="Behavior.HyperjumpTeleportOut.On" Send="Create HyperjumpLaunch"/>
        <On Terms="Behavior.HyperjumpTeleportIn.On" Send="Create HyperjumpImpact"/>
        <On Terms="Behavior.BattleCruiserFastJump.On" Send="Create HyperjumpImpact"/>
        <On Terms="Behavior.BattleCruiserFastJump.On" Send="SetVisibility"/>
        <On Terms="Behavior.BattleCruiserFastJump.Off" Send="SetVisibility 1"/>
        <CustomUnitStatusFrame value="HotS_UnitStatus/HeroUnitStatusFrameTemplateWide"/>
    </CActorUnit>
    <CActorUnit id="SavageQueen" parent="GenericUnitBase" unitName="SavageQueen">
        <Aliases value="_UnitLarge"/>
        <Macros value="ZergBurrowStandardAnimMacro"/>
        <Macros value="ZergLargeBurrowEffects"/>
        <Macros value="UnloadDropAnim"/>
        <Macros value="TerrainSquibAnimations"/>
        <Macros value="PhysicsDeathsSwarmGround"/>
        <Macros value="PhysicsDeathsVoidGround"/>
        <On Terms="UnitBirth.QueenBurrowed" Send="Create"/>
        <On Terms="UnitBirth.QueenBurrowed" Send="AnimBracketStart Burrow Burrow IGNORE Unburrow ClosingFull,OpeningPlayForever,Instant"/>
        <On Terms="UnitBirth.SavageQueen.Normal" Send="AnimPlay Unburrow Unburrow 0 0.000000"/>
        <On Terms="Abil.QueenBuild.WorkerStart" Send="AnimPlay WorkStart Stand,Work,Start"/>
        <On Terms="AnimDone; AnimName WorkStart" Send="AnimPlay WorkEnd Stand,Work,End"/>
        <On Terms="Abil.FungalGrowth.SourceCastStart" Send="$Spell"/>
        <On Terms="Abil.SpawnLarva.SourceCastStart" Send="AnimPlay SpellA Spell,A"/>
        <On Terms="Abil.Transfusion.SourceFinishStart" Send="AnimPlay SpellB Spell,B"/>
        <On Terms="AbilMorph.*.Start; AbilKey BurrowDown" Send="Create BurrowDownLarge"/>
        <On Terms="AbilMorph.*.Cancel; MorphFrom Queen; MorphTo QueenBurrowed" Send="AnimClear Burrow"/>
        <On Terms="AbilMorph.*.Finish; MorphTo Queen; MorphFrom QueenBurrowed" Send="AnimBracketStop Burrow"/>
        <On Terms="AbilMorph.*.Finish; MorphTo Queen; MorphFrom QueenBurrowed" Send="AnimClear Burrow"/>
        <On Terms="Abil.attack.ReadyStart" Send="AnimGroupApply Ready"/>
        <On Terms="WeaponStart.AcidSpines.AttackStart" Send="AnimBracketStart Attack Spell,C"/>
        <On Terms="WeaponStart.Talons.AttackStart; WeaponTargetDistance LE 1.000000" Send="AnimBracketStart Attack Attack,Cover"/>
        <On Terms="WeaponStart.Talons.AttackStart" Send="AnimBracketStart Attack Attack"/>
        <On Terms="WeaponStop.*.AttackStop" Send="AnimBracketStop Attack"/>
        <On Terms="Abil.attack.ReadyStop" Send="AnimGroupRemove Ready"/>
        <On Terms="Abil.EggPop.SourceCastStart" Send="$Spell,B 0 -1.000000 -1.000000 1.500000 AsDuration"/>
        <On Terms="Abil.QueenShockwave.SourceCastStart" Send="$Spell"/>
        <On Terms="UnitBirth.QueenFlying" Send="Create"/>
        <On Terms="UnitBirth.QueenFlying" Send="AnimGroupApply Pose"/>
        <On Terms="AbilMorph.*.Start; MorphTo QueenFlying; MorphFrom Queen" Send="AnimGroupApply Pose"/>
        <On Terms="AbilMorph.*.Finish; MorphTo Queen; MorphFrom QueenFlying" Send="AnimGroupRemove Pose"/>
        <On Terms="UnitBirth.SavageQueen" Send="TerrainSquibActivateGroup RippleStandard"/>
        <On Terms="UnitBirth.SavageQueen" Send="Create QueenCreepBirth"/>
        <On Terms="UnitBirth.SavageQueen" Send="Create Queen_Birth"/>
        <On Terms="UnitBirth.SavageQueen" Send="Create Queen_Birth2"/>
        <On Terms="AbilMorph.*.Finish; MorphTo Queen; MorphFrom QueenBurrowed" Send="TerrainSquibActivateGroup RippleStandard"/>
        <On Terms="AbilMorph.*.Finish; MorphTo QueenBurrowed; MorphFrom Queen" Send="TerrainSquibDeactivate"/>
        <On Terms="WeaponStart.TalonsMissile.AttackStart" Send="AnimBracketStart Attack Spell,C"/>
        <On Terms="UnitHeightUpdate.*.Land" Send="Create Queen_Land"/>
        <On Terms="Abil.DeepTunnel.SourceCastStart" Send="AnimBracketStart Burrow Burrow IGNORE Unburrow ClosingFull,OpeningPlayForever"/>
        <On Terms="Abil.DeepTunnel.SourceCastStop; ValidateUnit IsNotBuried" Send="AnimBracketStop Burrow"/>
        <On Terms="Behavior.KerriganEnhanceBeam.On" Send="AnimPlay Channel Fidget PlayForever"/>
        <On Terms="Behavior.KerriganEnhanceBeam.Off" Send="AnimClear Channel"/>
        <On Terms="ActorCreation; ValidateUnit HaveSwarmQueenVisual" Send="ModelSwap VoidSwarmQueen"/>
        <On Terms="Upgrade.SwarmQueenVisual.Add" Send="ModelSwap VoidSwarmQueen"/>
        <On Terms="Upgrade.SwarmQueenVisual.Add; ValidateUnit IsBuried" Send="AnimBracketStart Burrow Burrow IGNORE Unburrow ClosingFull,OpeningPlayForever,Instant"/>
        <On Terms="UnitDeathCustomize; ValidateUnit HaveSwarmQueenVisual" Send="DeathCustomize Upgrade"/>
        <Model value="Queen"/>
        <Scale value="1.500000"/>
        <ModelFlags index="OutlineEmitter" value="1"/>
        <BuildModel value="Queen"/>
        <DeathArray index="Normal" ModelLink="QueenDeath" SoundLink="Queen_Explode"/>
        <DeathArray index="Disintegrate" ModelLink="QueenDeathAcid" SoundLink="Uni_DeathFXAcid"/>
        <DeathArray index="Fire" ModelLink="QueenDeathFire" SoundLink="Uni_DeathFXFire"/>
        <DeathCustoms ModelLink="ZergLargeUnitDeathLow" Name="AntiGravZerg"/>
        <DeathCustoms ActorModel="QueenDeathRagdoll" ModelLink="QueenDeathRagdoll" Name="RagdollBasic"/>
        <DeathCustoms Name="RagdollSiegeTank" InheritsFrom="RagdollBasic"/>
        <DeathCustoms Name="RagdollNuke" InheritsFrom="RagdollBasic">
            <BodySquibs Name="Fire"/>
        </DeathCustoms>
        <DeathCustoms Name="RagdollFire" InheritsFrom="RagdollBasic">
            <BodySquibs Name="Fire"/>
        </DeathCustoms>
        <DeathCustoms Name="RagdollAcid" InheritsFrom="RagdollBasic">
            <BodySquibs Name="Acid"/>
        </DeathCustoms>
        <DeathCustoms Name="RagdollBaneling" InheritsFrom="RagdollBasic">
            <BodySquibs Name="Acid"/>
        </DeathCustoms>
        <DeathCustoms Name="RagdollUltraUnburrow" InheritsFrom="RagdollBasic"/>
        <DeathCustoms Name="RagdollOverkillDPRH" InheritsFrom="RagdollBasic"/>
        <DeathCustoms Name="RagdollOverkillDOI" InheritsFrom="RagdollBasic"/>
        <DeathCustoms Name="RagdollMidair" InheritsFrom="RagdollBasic"/>
        <DeathCustoms ModelLink="SwarmQueenDeath" Name="Upgrade"/>
        <PlacementModel value="Queen"/>
        <PortraitModel value="QueenPortrait"/>
        <TerrainSquibs>
            <GroupName value="RippleStandard"/>
            <MovementDistance value="0.150000,0.150000"/>
            <IdlePeriod value="0.100000,0.250000"/>
            <RangeUp value="2.000000"/>
            <RangeDown value="2.000000"/>
            <AttachQuery Methods="AMFilterCenter"/>
            <Visuals TerrainPhysicsMaterial="Water" ActorModel="TerrainSquibHarnessContinuous" ModelLink="WaterRippleQueen"/>
        </TerrainSquibs>
        <WalkAnimMoveSpeed value="1.7031"/>
        <BarOffset value="75"/>
        <ErrorArray Error="CantSeeBuildLocation" Sound="Alert_ZergBuildError" GroupSound="Alert_ZergBuildError"/>
        <ErrorArray Error="CantSeeLandLocation" Sound="Alert_ZergBuildError" GroupSound="Alert_ZergBuildError"/>
        <ErrorArray Error="CantBuildLocationInvalid" Sound="Alert_ZergBuildError" GroupSound="Alert_ZergBuildError"/>
        <ErrorArray Error="CantLandLocationInvalid" Sound="Alert_ZergBuildError" GroupSound="Alert_ZergBuildError"/>
        <GroupIcon>
            <Image value="Assets\Textures\Wireframe-Zerg-ExpeditionQueenLevel1.dds"/>
        </GroupIcon>
        <HeroIcon value="Assets\Textures\btn-unit-zerg-queen.dds"/>
        <LifeArmorIcon value="Assets\Textures\btn-upgrade-zerg-groundcarapace-level0.dds"/>
        <MovementHerdNode value="HerdNode_ZergQueens"/>
        <ShieldArmorIcon value="Assets\Textures\btn-upgrade-zerg-swarmfrenzy.dds"/>
        <SoundArray index="Birth" value="Queen_Birth"/>
        <SoundArray index="Ready" value="QueenReady"/>
        <SoundArray index="Help" value="QueenHelp"/>
        <SoundArray index="What" value="QueenWhat"/>
        <SoundArray index="Yes" value="QueenYes"/>
        <SoundArray index="Attack" value="Queen_Attack"/>
        <SoundArray index="Pissed" value="Queen_Pissed"/>
        <SoundArray index="Movement" value="zQueen_moveLoop"/>
        <StatusColors index="Shields">
            <ColorArray index="0" value="255,0,128,0"/>
        </StatusColors>
        <UnitFlags index="StandAnimBirthVariation" value="0"/>
        <UnitIcon value="Assets\Textures\btn-unit-zerg-queen.dds"/>
        <VitalColors index="Shields">
            <ColorArray value="255,0,128,0"/>
        </VitalColors>
        <VitalNames index="Shields" value="Vital/ZergShields"/>
        <Wireframe>
            <Image value="Assets\Textures\Wireframe-Zerg-ExpeditionQueenLevel1.dds"/>
        </Wireframe>
        <WireframeShieldColor value="255,0,128,0"/>
    </CActorUnit>
</Catalog>
