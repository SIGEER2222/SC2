//--------------------------------------------------------------------------------------------------
// Start
//--------------------------------------------------------------------------------------------------
bool aiB36D1843_initialized = false;

//--------------------------------------------------------------------------------------------------
void aiB36D1843_start (int p) {
    int init_i;

    if (p < 0 || p >= 16) {
        return;
    }
    if (!aiB36D1843_initialized) {
        aiB36D1843_wave2_init();
        aiB36D1843_wave1_init();
        aiB36D1843_wave3_init();
        aiB36D1843_wave4_init();
        aiB36D1843_wave5_init();
        aiB36D1843_wave6_init();
        aiB36D1843_wave7_init();
        aiB36D1843_wave8_init();
        aiB36D1843_waves_init();

        for (init_i = 0; init_i <= 16; init_i += 1) {
            aiB36D1843_defGather[init_i] = PointFromId(786578862);
        }

        aiB36D1843_initialized = true;
    }

    AICampaignStart(p);
}
