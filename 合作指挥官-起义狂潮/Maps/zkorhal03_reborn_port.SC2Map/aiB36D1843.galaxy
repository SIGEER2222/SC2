//--------------------------------------------------------------------------------------------------
// Attack Wave Sequence
//--------------------------------------------------------------------------------------------------
trigger aiB36D1843_waves_trigger = null;
int aiB36D1843_waves_runPlayer;
playergroup aiB36D1843_waves_runTarget;

//--------------------------------------------------------------------------------------------------
void aiB36D1843_waves_init () {
    aiB36D1843_waves_trigger = TriggerCreate("aiB36D1843_waves_runFunc");
}

//--------------------------------------------------------------------------------------------------
bool aiB36D1843_waves_runFunc (bool c, bool a) {
    int p = aiB36D1843_waves_runPlayer;
    playergroup target = aiB36D1843_waves_runTarget;

    if (p < 0 || p >= 16) {
        return false;
    }

    aiB36D1843_wave2_run(p, target, true);
    aiB36D1843_wave1_run(p, target, true);
    aiB36D1843_wave3_run(p, target, true);
    aiB36D1843_wave4_run(p, target, true);
    aiB36D1843_wave5_run(p, target, true);
    aiB36D1843_wave6_run(p, target, true);
    aiB36D1843_wave7_run(p, target, true);
    aiB36D1843_wave8_run(p, target, true);

    while (true) {
        aiB36D1843_wave6_run(p, target, true);
        aiB36D1843_wave7_run(p, target, true);
        aiB36D1843_wave8_run(p, target, true);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void aiB36D1843_waves_run (int p, playergroup target) {
    aiB36D1843_waves_runPlayer = p;
    aiB36D1843_waves_runTarget = PlayerGroupCopy(target);

    TriggerExecute(aiB36D1843_waves_trigger, false, false);
}

//--------------------------------------------------------------------------------------------------
