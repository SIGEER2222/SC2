    if (p < 0 || p >= 16) {
        return;
    }

    aiB36D1843_wave2_enable(p, val);
    aiB36D1843_wave1_enable(p, val);
    aiB36D1843_wave3_enable(p, val);
    aiB36D1843_wave4_enable(p, val);
    aiB36D1843_wave5_enable(p, val);
    aiB36D1843_wave6_enable(p, val);
    aiB36D1843_wave7_enable(p, val);
    aiB36D1843_wave8_enable(p, val);
}

//--------------------------------------------------------------------------------------------------
void aiB36D1843_waves_stop () {
    TriggerStop(aiB36D1843_waves_trigger);

    TriggerStop(aiB36D1843_wave2_trigger);
    TriggerStop(aiB36D1843_wave1_trigger);
    TriggerStop(aiB36D1843_wave3_trigger);
    TriggerStop(aiB36D1843_wave4_trigger);
    TriggerStop(aiB36D1843_wave5_trigger);
    TriggerStop(aiB36D1843_wave6_trigger);
    TriggerStop(aiB36D1843_wave7_trigger);
    TriggerStop(aiB36D1843_wave8_trigger);
}

