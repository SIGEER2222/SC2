    if (!runActions) {
        return true;
    }

    AICampaignStart(15);
    while (true) {
        lv_attackwave = null;
        if ((UnitIsAlive(UnitFromId(1020067587)) == false)) {
            break;
        }

        for (auto1EA97F0F_i = 1; auto1EA97F0F_i <= auto1EA97F0F_n; auto1EA97F0F_i += 1) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "Zergling", c_unitCreateIgnorePlacement, 15, RegionRandomPoint(RegionFromId(84)));
            UnitIssueOrder(UnitLastCreated(), OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(920813996)), c_orderQueueReplace);
        }
        for (autoD77B103E_i = 1; autoD77B103E_i <= autoD77B103E_n; autoD77B103E_i += 1) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "Roach", c_unitCreateIgnorePlacement, 15, RegionRandomPoint(RegionFromId(84)));
            UnitIssueOrder(UnitLastCreated(), OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(920813996)), c_orderQueueReplace);
        }
        for (auto41FE5A7E_i = 1; auto41FE5A7E_i <= auto41FE5A7E_n; auto41FE5A7E_i += 1) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "Hydralisk", c_unitCreateIgnorePlacement, 15, RegionRandomPoint(RegionFromId(84)));
            UnitIssueOrder(UnitLastCreated(), OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(920813996)), c_orderQueueReplace);
        }
        Wait(30.0, c_timeGame);
    }
    return true;
}

