bool gt_MengskNukes_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_unit;
    point lv_posArmy;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    Wait(VisGetFoWAlpha(1), c_timeGame);
    while (true) {
        if ((UnitGroupCount(UnitGroupAlliance(gv_PLAYER_02_DOMINION_RED, c_unitAllianceEnemy, RegionFromId(79), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) >= 1)) {
            lv_posArmy = gf_NextNukeLocationArmy();
            if ((lv_posArmy != null)) {
                gf_DropNuke(lv_posArmy);
            }

        }

        Wait(lib48DF4533_gf_DifficultyValueCrys(120, 120, 100, 80, 60), c_timeGame);
    }
    return true;
}

