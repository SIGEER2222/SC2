        return true;
    }

    UIAlertPoint("Trigger", gv_PLAYER_01_USER, StringExternal("Param/Value/10019ECC"), null, UnitGetPosition(gv_kerrigan));
    AIToggleBulliesInRegion(gv_pLAYER_08_IZSHA3, RegionFromId(70), true);
