//--------------------------------------------------------------------------------------------------
// Trigger: Hyperion Retreat
//--------------------------------------------------------------------------------------------------
bool gt_HyperionRetreat_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnit()) == "Hyperion"))) {
            return false;
        }

        if (!((UnitGetPropertyFixed(gv_hYPERION, c_unitPropLifePercent, c_unitPropCurrent) < 25.0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitIssueOrder(EventUnit(), OrderTargetingPoint(AbilityCommand("Hyperjump", 0), PointFromId(627)), c_orderQueueReplace);
    Wait(6.0, c_timeGame);
    libNtve_gf_MakeUnitFacePoint(UnitLastCreated(), PointFromId(2), 0.0);
    UnitIssueOrder(EventUnit(), Order(AbilityCommand("HyperionLand", 0)), c_orderQueueReplace);
    UnitIssueOrder(EventUnit(), Order(AbilityCommand("HyperionKorhalRegen", 0)), c_orderQueueAddToEnd);
    return true;
}

