    AIToggleBulliesInRegion(gv_pLAYER_08_IZSHA3, RegionFromId(70), true);
    AIToggleBulliesInRegion(gv_PLAYER_07_DOMINION_GREEN22, RegionFromId(24), true);
    TriggerEnable(gt_YellowBullies1, true);
    TriggerEnable(gt_YellowBullies2, true);
    TriggerEnable(gt_RedBullies1, true);
    TriggerEnable(gt_RedBullies2, true);
    TriggerEnable(gt_RedBullies3, true);
    TriggerEnable(gt_RedBullies4, true);
    TriggerEnable(gt_OrangeBullies1, true);
    TriggerEnable(gt_OrangeBullies2, true);
    TriggerEnable(gt_OrangeBullies3, true);
    TriggerEnable(gt_DogsBullies1, true);
    TriggerEnable(gt_SkygeirrRemnants, true);
    TriggerEnable(gt_DominionAirWarning, true);
    TriggerExecute(lib48DF4533_gt_AllyDepots, true, false);
    TimerStart(gv_achievementTimedRunTimer, 1500.0, false, c_timeAI);
    TriggerQueueEnter();
    libSwaC_gf_SendTransmissionCampaign(gv_kerrigan, "zMission_Korhal03|Line00115", c_transmissionDurationAdd, 0.0, true, libSwaC_ge_CampaignTransmissionPortraitOptioins_HidePortraitAfter, libSwaC_ge_CampaignTransmissionCueSoundOptions_DefaultCueSoundBehavior);
    libSwaC_gf_SendTransmissionCampaign(gv_hYPERION, "zMission_Korhal03|Line00116", c_transmissionDurationAdd, 0.0, true, libSwaC_ge_CampaignTransmissionPortraitOptioins_HidePortraitAfter, libSwaC_ge_CampaignTransmissionCueSoundOptions_DefaultCueSoundBehavior);
    libSwaC_gf_SendTransmissionCampaign(gv_kerrigan, "zMission_Korhal03|Line00146", c_transmissionDurationAdd, 0.0, true, libSwaC_ge_CampaignTransmissionPortraitOptioins_HidePortraitAfter, libSwaC_ge_CampaignTransmissionCueSoundOptions_DefaultCueSoundBehavior);
    TriggerQueueExit();
    TriggerExecute(gt_ObjectiveHyperionMustSurviveCreate, true, true);
    Wait(3.0, c_timeReal);
    TriggerQueueEnter();
    TriggerExecute(gt_ObjectiveDestroyPalaceGateCreate, true, true);
    TriggerQueueExit();
    if ((lib48DF4533_gf_SetAllHatcheriesRallyPoints2() == true)) {
        TriggerExecute(gt_RuthlessWarpIn, true, false);
    }

    TechTreeUnitAllow(gv_pLAYER_08_IZSHA3, "PrimalZergling", true);
    TechTreeUnitAllow(gv_pLAYER_08_IZSHA3, "PrimalHydralisk", true);
    TechTreeUnitAllow(gv_pLAYER_08_IZSHA3, "PrimalRoach", true);
    TechTreeUnitAllow(gv_pLAYER_08_IZSHA3, "PrimalMutalisk", true);
    TechTreeUnitAllow(gv_pLAYER_08_IZSHA3, "Ravasaur", true);
    TechTreeUnitAllow(gv_pLAYER_08_IZSHA3, "PrimalUltralisk", true);
    TechTreeUnitAllow(gv_pLAYER_08_IZSHA3, "Terrorzor", true);
    TechTreeUnitAllow(gv_pLAYER_08_IZSHA3, "PrimalFlyer", true);
    Wait(3.0, c_timeReal);
    TriggerExecute(gt_TipMissionHelpQ, true, false);
    Wait(5.0, c_timeReal);
    TriggerExecute(gt_EliteForceIntroQ, true, true);
    TriggerExecute(gt_TipEliteForcesQ, true, false);
    Wait(20.0, c_timeReal);
    TriggerExecute(gt_Dialog, true, true);
    Wait(120.0, c_timeAI);
    AIToggleBulliesInRegion(gv_pLAYER_08_IZSHA, RegionFromId(24), true);
    AIToggleBulliesInRegion(gv_pLAYER_08_IZSHA6, RegionFromId(76), true);
    return true;
}

