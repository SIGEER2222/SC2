// RebornMapAdapter - Galaxy adapter for Reborn HotS maps

include "TriggerLibs/NativeLib"
include "RebornMapAdapter_h"
include "LibE0EAE146_h"
include "LibRebornAdapter_AlengerBootstrap_h"

string libRebornAdapter_DEFAULT_COMMANDER = "TerranRaynor";

void libRebornAdapter_SetMapScenarioId (string mapScenarioId) {
    libRebornAdapter_mapScenarioId = mapScenarioId;
}

// 非 Kerrigan 指挥官时跳过战役原生英雄与开场动画。
bool libRebornAdapter_ShouldSkipNativeCampaignHero () {
    string lv_commander;
    lv_commander = libRebornAdapter_ReadCommanderFromBank(1);
    return (lv_commander != "Kerrigan");
}

string libRebornAdapter_ReadCommanderFromBank (int player) {
    bank lv_bank;
    string lv_commander;

    lv_bank = BankLoad("CampaignXCore", player);
    if (lv_bank == null) {
        return libRebornAdapter_DEFAULT_COMMANDER;
    }

    lv_commander = BankValueGetAsString(lv_bank, "XMRuntimeControl", "CommanderP" + IntToString(player));
    if (lv_commander != "") {
        return lv_commander;
    }

    lv_commander = BankValueGetAsString(lv_bank, "XMRuntimeControl", "PrimaryCommander");
    if (lv_commander != "") {
        return lv_commander;
    }

    lv_commander = BankValueGetAsString(lv_bank, "Ach", "Commander");
    if (lv_commander != "") {
        return lv_commander;
    }

    return libRebornAdapter_DEFAULT_COMMANDER;
}

void libRebornAdapter_RegisterCommanderSlot (int player, string commanderId) {
    if (player < 0 || player >= 16) { return; }
    libRebornAdapter_commanderSlot[player] = commanderId;
}

string libRebornAdapter_GetCommanderForPlayer (int player) {
    if (player < 0 || player >= 16) { return ""; }
    return libRebornAdapter_commanderSlot[player];
}

playergroup libRebornAdapter_CommanderPlayers () {
    return libRebornAdapter_commanderPlayers;
}

void libRebornAdapter_InitLib () {
    libRebornAdapter_initialized = true;
    libRebornAdapter_gameOver = false;
    libRebornAdapter_commanderPlayers = PlayerGroupEmpty();
    libRebornAdapter_mapScenarioId = "";
}

void libRebornAdapter_OnAfterTechnologyInit () {
    int lv_player;
    lv_player = -1;
    while (true) {
        lv_player = PlayerGroupNextPlayer(PlayerGroupAll(), lv_player);
        if (lv_player < 0) { break; }
        if (lv_player == 1) {
            TechTreeUpgradeAllow(lv_player, "HotSRapidRegeneration", true);
        }
    }
}

void libRebornAdapter_OnAfterPlayersInit () {
    string lv_commander;
    bank lv_bank;

    lv_commander = libRebornAdapter_ReadCommanderFromBank(1);
    libRebornAdapter_RegisterCommanderSlot(1, lv_commander);
    PlayerGroupAdd(libRebornAdapter_commanderPlayers, 1);

    lv_bank = BankLoad("CampaignXCore", 1);
    if (lv_bank != null) {
        BankValueSetFromString(lv_bank, "XMRuntimeControl", "PrimaryCommander", lv_commander);
        BankValueSetFromString(lv_bank, "Ach", "Commander", lv_commander);
        BankSave(lv_bank);
    }
}

void libRebornAdapter_OnAfterUnitsInit () {
    libRebornAdapter_AlengerBootstrap_InitLib();
    libE0EAE146_gf_Initialize(true);
    if (libRebornAdapter_mapScenarioId != "") {
        libE0EAE146_gf_InitializeMapBaseScenario(libRebornAdapter_mapScenarioId);
    }
}

void libRebornAdapter_TriggerVictory () {
    if (libRebornAdapter_gameOver) { return; }
    libRebornAdapter_gameOver = true;
    GameOver(1, c_gameOverVictory, true, false);
}

void libRebornAdapter_TriggerDefeat () {
    if (libRebornAdapter_gameOver) { return; }
    libRebornAdapter_gameOver = true;
    GameOver(1, c_gameOverDefeat, true, false);
}

void libRebornAdapter_DisplayMissionMessage (playergroup pg, string message) {
}

void libRebornAdapter_RegisterPlayer1 () {
}
