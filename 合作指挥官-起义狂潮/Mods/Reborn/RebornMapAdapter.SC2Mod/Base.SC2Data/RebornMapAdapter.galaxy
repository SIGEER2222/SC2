// RebornMapAdapter - Galaxy adapter for Reborn HotS maps

include "TriggerLibs/NativeLib"
include "RebornMapAdapter_h"
include "LibE0EAE146_h"
include "LibRebornAdapter_AlengerBootstrap_h"

string libRebornAdapter_DEFAULT_COMMANDER = "TerranRaynor";

void libRebornAdapter_SetMapScenarioId (string mapScenarioId) {
    libRebornAdapter_mapScenarioId = mapScenarioId;
}

// 非 Kerrigan 指挥官时跳过战役原生英雄与开场动画。
bool libRebornAdapter_ShouldSkipNativeCampaignHero () {
    string lv_commander;
    lv_commander = libRebornAdapter_ReadCommanderFromBank(1);
    return (lv_commander != "Kerrigan");
}

string libRebornAdapter_ReadCommanderFromBank (int player) {
    bank lv_bank;
    string lv_commander;

    lv_bank = BankLoad("CampaignXCore", player);
    if (lv_bank == null) {
        return libRebornAdapter_DEFAULT_COMMANDER;
    }

    lv_commander = BankValueGetAsString(lv_bank, "XMRuntimeControl", "CommanderP" + IntToString(player));
    if (lv_commander != "") {
        return lv_commander;
    }

    lv_commander = BankValueGetAsString(lv_bank, "XMRuntimeControl", "PrimaryCommander");
    if (lv_commander != "") {
        return lv_commander;
    }

    lv_commander = BankValueGetAsString(lv_bank, "Ach", "Commander");
    if (lv_commander != "") {
        return lv_commander;
    }

    return libRebornAdapter_DEFAULT_COMMANDER;
}

void libRebornAdapter_RegisterCommanderSlot (int player, string commanderId) {
    if (player < 0 || player >= 16) { return; }
    libRebornAdapter_commanderSlot[player] = commanderId;
}

string libRebornAdapter_GetCommanderForPlayer (int player) {
    if (player < 0 || player >= 16) { return ""; }
    return libRebornAdapter_commanderSlot[player];
}

playergroup libRebornAdapter_CommanderPlayers () {
    return libRebornAdapter_commanderPlayers;
}

void libRebornAdapter_InitLib () {
    libRebornAdapter_initialized = true;
    libRebornAdapter_gameOver = false;
    libRebornAdapter_commanderPlayers = PlayerGroupEmpty();
    libRebornAdapter_mapScenarioId = "";
}

void libRebornAdapter_OnAfterTechnologyInit () {
    int lv_player;
    lv_player = -1;
    while (true) {
        lv_player = PlayerGroupNextPlayer(PlayerGroupAll(), lv_player);
        if (lv_player < 0) { break; }
        if (lv_player == 1) {
            TechTreeUpgradeAllow(lv_player, "HotSRapidRegeneration", true);
        }
    }
}

void libRebornAdapter_OnAfterPlayersInit () {
    string lv_commander;
    bank lv_bank;

    lv_commander = libRebornAdapter_ReadCommanderFromBank(1);
    libRebornAdapter_RegisterCommanderSlot(1, lv_commander);
    PlayerGroupAdd(libRebornAdapter_commanderPlayers, 1);

    lv_bank = BankLoad("CampaignXCore", 1);
    if (lv_bank != null) {
        BankValueSetFromString(lv_bank, "XMRuntimeControl", "PrimaryCommander", lv_commander);
        BankValueSetFromString(lv_bank, "Ach", "Commander", lv_commander);
        BankSave(lv_bank);
    }
}

// 判定是否为虫族指挥官（虫族指挥官不需要清理地图预放置的虫族单位）
bool libRebornAdapter_IsZergCommander (string commander) {
    if (commander == "Kerrigan") { return true; }
    if (commander == "ZergKerrigan") { return true; }
    if (commander == "Abathur") { return true; }
    if (commander == "ZergAbathur") { return true; }
    if (commander == "Zagara") { return true; }
    if (commander == "ZergZagara") { return true; }
    if (commander == "Stukov") { return true; }
    if (commander == "ZergStukov") { return true; }
    if (commander == "Dehaka") { return true; }
    if (commander == "ZergDehaka") { return true; }
    if (commander == "Stetmann") { return true; }
    if (commander == "ZergStetmann") { return true; }
    return false;
}

// 替换地图预放置的虫族单位（Reborn 战役图改造为 7vs1 时使用）
// 非虫族指挥官时：
//   - Lair/Hatchery/Hive → 记录原位置，移除 InitializeBase 创建的偏移 CC，在 Lair 原位置重建 CC
//   - 其他虫族建筑 → 移除
//   - 非建筑虫族单位 → 移除
// 注意：UnitRemove 在 gt_Initialization_Func 执行期间不生效，必须延迟到初始化触发器返回后执行
void libRebornAdapter_ReplacePreplacedZergUnits () {
    unitgroup lv_all;
    int lv_total;
    int lv_i;
    unit lv_u;
    string lv_type;
    string lv_race;
    point lv_lairPos;
    string lv_commander;
    string lv_townHallType;
    int lv_replacedBuildings;
    int lv_removedUnits;
    int lv_zergAfter;
    bank lv_bank;
    unitgroup lv_ccGroup;
    int lv_ccCount;

    lv_commander = libRebornAdapter_ReadCommanderFromBank(1);
    lv_townHallType = libE0EAE146_gf_CommanderAchUnit("CommandCenter");

    // 第一步：找到 Lair 位置
    lv_lairPos = null;
    lv_all = UnitGroup(null, 1, RegionEntireMap(), UnitFilter(0, 0, (1 << 0), (1 << 1)), 0);
    lv_total = UnitGroupCount(lv_all, c_unitCountAll);
    lv_i = 1;
    while (lv_i <= lv_total) {
        lv_u = UnitGroupUnit(lv_all, lv_i);
        lv_type = UnitGetType(lv_u);
        if ((lv_type == "Lair") || (lv_type == "Hatchery") || (lv_type == "Hive") ||
            (lv_type == "HatcheryZerg")) {
            lv_lairPos = UnitGetPosition(lv_u);
            break;
        }
        lv_i = lv_i + 1;
    }

    // 第二步：如果找到 Lair，移除偏移的 CC（由 InitializeBase 创建）并在 Lair 原位置重建
    lv_replacedBuildings = 0;
    if (lv_lairPos != null) {
        // 移除所有已创建的 CC（InitializeBase 创建的，位置可能偏移）
        if ((lv_townHallType != "") && CatalogEntryIsValid(c_gameCatalogUnit, lv_townHallType)) {
            lv_ccGroup = UnitGroup(lv_townHallType, 1, RegionEntireMap(), UnitFilter(0, 0, (1 << 0), (1 << 1)), 0);
            lv_ccCount = UnitGroupCount(lv_ccGroup, c_unitCountAll);
            while (lv_ccCount > 0) {
                lv_u = UnitGroupUnit(lv_ccGroup, lv_ccCount);
                UnitRemove(lv_u);
                lv_ccCount = lv_ccCount - 1;
            }
            // 在 Lair 原位置创建新 CC（IgnorePlacement 确保位置准确）
            libNtve_gf_CreateUnitsWithDefaultFacing(1, lv_townHallType, c_unitCreateIgnorePlacement, 1, lv_lairPos);
            lv_replacedBuildings = 1;
        }
    }

    // 第三步：移除所有虫族单位（包括 Lair）
    lv_all = UnitGroup(null, 1, RegionEntireMap(), UnitFilter(0, 0, (1 << 0), (1 << 1)), 0);
    lv_total = UnitGroupCount(lv_all, c_unitCountAll);
    lv_removedUnits = 0;
    lv_i = lv_total;
    while (lv_i >= 1) {
        lv_u = UnitGroupUnit(lv_all, lv_i);
        lv_type = UnitGetType(lv_u);
        lv_race = CatalogFieldValueGet(c_gameCatalogUnit, lv_type, "Race", 1);
        if (lv_race == "Zerg") {
            UnitRemove(lv_u);
            lv_removedUnits = lv_removedUnits + 1;
        }
        lv_i = lv_i - 1;
    }

    // 统计替换后的虫族单位数量
    lv_all = UnitGroup(null, 1, RegionEntireMap(), UnitFilter(0, 0, (1 << 0), (1 << 1)), 0);
    lv_total = UnitGroupCount(lv_all, c_unitCountAll);
    lv_zergAfter = 0;
    lv_i = 1;
    while (lv_i <= lv_total) {
        lv_u = UnitGroupUnit(lv_all, lv_i);
        lv_type = UnitGetType(lv_u);
        lv_race = CatalogFieldValueGet(c_gameCatalogUnit, lv_type, "Race", 1);
        if (lv_race == "Zerg") {
            lv_zergAfter = lv_zergAfter + 1;
        }
        lv_i = lv_i + 1;
    }

    // 写入诊断 Bank
    lv_bank = BankLoad("CampaignXCore", 1);
    if (lv_bank != null) {
        BankValueSetFromString(lv_bank, "XMRuntimeDebug", "ReplaceMode", "replace_cc");
        BankValueSetFromString(lv_bank, "XMRuntimeDebug", "ReplaceTownHallType", lv_townHallType);
        BankValueSetFromInt(lv_bank, "XMRuntimeDebug", "ReplaceBuildingsCount", lv_replacedBuildings);
        BankValueSetFromInt(lv_bank, "XMRuntimeDebug", "RemoveUnitsCount", lv_removedUnits);
        BankValueSetFromInt(lv_bank, "XMRuntimeDebug", "ZergAfterReplace", lv_zergAfter);
        BankSave(lv_bank);
    }
}

// 延迟替换触发器函数：等待初始化完成后执行替换
// UnitRemove 在 gt_Initialization_Func 期间不生效，必须通过 Wait 延迟到触发器返回后
bool libRebornAdapter_gt_DeferredCleanup_Func (bool testConds, bool runActions) {
    if (testConds) {
        return true;
    }
    if (!runActions) {
        return true;
    }

    // 等待初始化触发器返回，确保 UnitRemove 能生效
    Wait(2.0, c_timeReal);

    libRebornAdapter_ReplacePreplacedZergUnits();
    return true;
}

// 查找地图预放置的基地位置（Lair/Hatchery/Hive/CommandCenter），用作 effectiveBaseAnchor 回退
// 战役图没有设置 PlayerStartLocation，InitializeBase 会因 null 失败
point libRebornAdapter_FindPreplacedBasePoint () {
    unitgroup lv_all;
    int lv_total;
    int lv_i;
    unit lv_u;
    string lv_type;

    lv_all = UnitGroup(null, 1, RegionEntireMap(), UnitFilter(0, 0, (1 << 0), (1 << 1)), 0);
    lv_total = UnitGroupCount(lv_all, c_unitCountAll);
    lv_i = 1;
    while (lv_i <= lv_total) {
        lv_u = UnitGroupUnit(lv_all, lv_i);
        lv_type = UnitGetType(lv_u);
        if ((lv_type == "Lair") || (lv_type == "Hatchery") || (lv_type == "Hive") ||
            (lv_type == "CommandCenter") || (lv_type == "OrbitalCommand") ||
            (lv_type == "PlanetaryFortress") || (lv_type == "Nexus") || (lv_type == "HatcheryZerg")) {
            return UnitGetPosition(lv_u);
        }
        lv_i = lv_i + 1;
    }
    return null;
}

void libRebornAdapter_OnAfterUnitsInit () {
    string lv_commander;

    libRebornAdapter_AlengerBootstrap_InitLib();

    // 战役图没有 PlayerStartLocation，设置 effectiveBaseAnchor 作为 InitializeBase 的回退
    // 使用预放置的 Lair 位置作为基地锚点
    if (PlayerStartLocation(1) == null) {
        libE0EAE146_gv_effectiveBaseAnchor = libRebornAdapter_FindPreplacedBasePoint();
    }

    // 非虫族指挥官时，延迟替换地图预放置的虫族单位
    // UnitRemove 在 gt_Initialization_Func 期间不生效，必须通过异步触发器延迟执行
    lv_commander = libRebornAdapter_ReadCommanderFromBank(1);
    if (!libRebornAdapter_IsZergCommander(lv_commander)) {
        libRebornAdapter_gt_DeferredCleanup = TriggerCreate("libRebornAdapter_gt_DeferredCleanup_Func");
        TriggerExecute(libRebornAdapter_gt_DeferredCleanup, false, false);
    }

    libE0EAE146_gf_Initialize(true);
    if (libRebornAdapter_mapScenarioId != "") {
        libE0EAE146_gf_InitializeMapBaseScenario(libRebornAdapter_mapScenarioId);
    }
}

void libRebornAdapter_TriggerVictory () {
    if (libRebornAdapter_gameOver) { return; }
    libRebornAdapter_gameOver = true;
    GameOver(1, c_gameOverVictory, true, false);
}

void libRebornAdapter_TriggerDefeat () {
    if (libRebornAdapter_gameOver) { return; }
    libRebornAdapter_gameOver = true;
    GameOver(1, c_gameOverDefeat, true, false);
}

