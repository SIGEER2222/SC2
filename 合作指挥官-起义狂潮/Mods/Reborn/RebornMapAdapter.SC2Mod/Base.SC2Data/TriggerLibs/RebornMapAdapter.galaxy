// RebornMapAdapter - Galaxy adapter for Reborn HotS maps
// Provides minimal initialization to replace campaign system

// ============================================================
// Initialization
// ============================================================

// Called once at map initialization. Replaces libSwaC_InitLib.
void libRebornAdapter_InitLib () {
    // Initialize player 1 as the human player
    libRebornAdapter_RegisterPlayer1();
}

// ============================================================
// Player Registration
// ============================================================

// Register player 1 as the active human player.
// Sets up basic player properties without campaign dependencies.
void libRebornAdapter_RegisterPlayer1 () {
    // Player 1 is always the human player in Reborn maps
    PlayerSetController(1, c_playerControllerUser);
    PlayerSetAlliance(1, c_playerGroupAlly, c_playerGroupAllyExclusive);
    PlayerSetAlliance(1, c_playerGroupEnemy, c_playerGroupEnemyExclusive);
}

// ============================================================
// Victory / Defeat
// ============================================================

// Trigger victory for player 1
void libRebornAdapter_TriggerVictory () {
    PlayerSetState(1, c_playerStateVictory);
}

// Trigger defeat for player 1
void libRebornAdapter_TriggerDefeat () {
    PlayerSetState(1, c_playerStateDefeat);
}

// ============================================================
// UI Helpers
// ============================================================

// Display a simple mission message (replaces CampaignMessage)
void libRebornAdapter_DisplayMissionMessage (string inText, int inType) {
    if (inType == 0) {
        // Failure
        UIDisplayMessage(PlayerGroupSingle(1), c_messageAreaSubtitle, inText);
    } else {
        // Standard
        UIDisplayMessage(PlayerGroupSingle(1), c_messageAreaSubtitle, inText);
    }
}

// ============================================================
// Init
// ============================================================

void InitLibs () {
    libRebornAdapter_InitLib();
}