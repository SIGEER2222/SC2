include "TriggerLibs/natives"
include "LibAIROAdapter_Stetmann_h"

string libAIROAdapterInterface_CommanderName() {
    return "ZergStetmann";
}

string libAIROAdapterInterface_GetReplacementUnit(string originalUnit) {
    // === 建筑类 ===
    if (originalUnit == "CommandCenter") { return "HatcheryStetmann"; }
    if (originalUnit == "Barracks") { return "HatcheryStetmann"; }
    if (originalUnit == "SupplyDepot") { return "OverlordStetmann"; }
    if (originalUnit == "Refinery") { return "ExtractorStetmann"; }

    // === 战斗单位类 ===
    if (originalUnit == "SCV") { return "DroneStetmann"; }
    if (originalUnit == "Marine" || originalUnit == "MurlocMarine") { return "ZerglingStetmann"; }
    if (originalUnit == "Marauder" || originalUnit == "IronWarrior" || originalUnit == "DevilDog") { return "RoachStetmann"; }
    if (originalUnit == "Firebat") { return "BanelingStetmann"; }
    if (originalUnit == "Medic") { return "QueenStetmann"; }
    if (originalUnit == "Goliath") { return "HydraliskStetmann"; }
    if (originalUnit == "Reaper") { return "ZerglingStetmann"; }
    if (originalUnit == "SiegeTank") { return "LurkerStetmann"; }
    if (originalUnit == "VikingAssault") { return "CorruptorStetmann"; }
    if (originalUnit == "Battlecruiser") { return "BroodLordStetmann"; }

    // 无映射 → 保留原版
    return originalUnit;
}

void libAIROAdapterInterface_OnUnitCreated(unit createdUnit) {
}

void libAIROAdapterInterface_OnGameStart() {
}
