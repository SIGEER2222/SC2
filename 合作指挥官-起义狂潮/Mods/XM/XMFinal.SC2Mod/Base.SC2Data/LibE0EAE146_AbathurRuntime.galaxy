bool libE0EAE146_gf_CreateAbathurBiomassPickup (point lp_point, int lp_stack) {
    if ((lp_point == null) || (lp_stack <= 0)) {
        return false;
    }

    libNtve_gf_CreateUnitsWithDefaultFacing(1, "BiomassPickup", c_unitCreateIgnorePlacement, libE0EAE146_gv_abathurBiomassPlayer, lp_point);
    if ((UnitLastCreated() == null)) {
        return false;
    }

    UnitSetCustomValue(UnitLastCreated(), 63, IntToFixed(lp_stack));
    libNtve_gf_SendActorMessageToUnit(UnitLastCreated(), ("SetScale " + FixedToString((1.0 + (0.0025 * IntToFixed(MinI(MaxI(lp_stack, 0), 100)))), c_fixedPrecisionAny)));
    return true;
}

fixed libE0EAE146_gf_AbathurBiomassAmount (unit lp_unit) {
    fixed lv_amount;
    fixed lv_food;
    int lv_resourceCost;

    if ((lp_unit == null)) {
        return 0.0;
    }
    if ((UnitTypeTestAttribute(UnitGetType(lp_unit), c_unitAttributeHeroic) == true)) {
        return 12.0;
    }
    if ((UnitHasBehavior2(lp_unit, "HybridUnitDummy") == true)) {
        return 12.0;
    }
    if ((UnitHasBehavior2(lp_unit, "CritterExplode") == true)) {
        return 1.0;
    }

    lv_food = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, UnitGetType(lp_unit), "Food", libE0EAE146_gv_abathurBiomassPlayer));
    if ((lv_food < 0.0)) {
        lv_amount = (-2.0 * lv_food);
    }
    else {
        lv_amount = UnitGetPropertyInt(lp_unit, c_unitPropSuppliesUsed, c_unitPropNormal);
        if ((lv_amount > 0.0)) {
            lv_amount *= 2.0;
        }
    }

    if ((lv_amount <= 0.0)) {
        lv_resourceCost = UnitTypeGetCost(UnitGetType(lp_unit), c_unitCostSumMineralsVespene);
        if ((lv_resourceCost > 0)) {
            lv_amount = 1.0;
        }
    }
    if ((lv_amount < 0.0)) {
        lv_amount = 0.0;
    }
    if ((lv_amount > 12.0)) {
        lv_amount = 12.0;
    }
    if ((lv_amount > 0.0) && (lv_amount < 1.0)) {
        lv_amount = 1.0;
    }
    return lv_amount;
}

bool libE0EAE146_gf_AbathurCanDropBiomass (unit lp_unit) {
    if ((libE0EAE146_gv_abathurBiomassEnabled == false) || (lp_unit == null)) {
        return false;
    }
    if ((EventUnitDamageDeathCheck(c_deathTypeRemove) == true)) {
        return false;
    }
    if ((libNtve_gf_PlayerIsEnemy(UnitGetOwner(lp_unit), libE0EAE146_gv_abathurBiomassPlayer, libNtve_ge_PlayerRelation_Enemy) == false)) {
        return false;
    }
    if ((UnitTypeTestAttribute(UnitGetType(lp_unit), c_unitAttributeStructure) == true)) {
        return false;
    }
    if ((UnitTypeTestAttribute(UnitGetType(lp_unit), c_unitAttributeSummoned) == true)) {
        return false;
    }
    if ((UnitHasBehavior2(lp_unit, "NoBiomassDrop") == true)) {
        return false;
    }
    return (libE0EAE146_gf_AbathurBiomassAmount(lp_unit) > 0.0);
}

int libE0EAE146_gf_AbathurBiomassMaxStacks () {
    int lv_max;

    lv_max = CatalogFieldValueGetAsInt(c_gameCatalogEffect, "AbathurBiomassMaxStacksDummy", "Amount", libE0EAE146_gv_abathurBiomassPlayer);
