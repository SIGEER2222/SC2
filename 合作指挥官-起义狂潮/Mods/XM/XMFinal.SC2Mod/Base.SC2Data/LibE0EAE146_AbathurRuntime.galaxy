    lv_refundChance = IntToFixed(CatalogFieldValueGetAsInt(c_gameCatalogEffect, "AbathurBiomassRefundDummy", "Amount", UnitGetOwner(lv_dyingUnit)));
    if ((lv_refundChance <= 0.0) || (lv_refundChance < RandomFixed(0.0, 100.0))) {
        return true;
    }

    lv_stack = libE0EAE146_gf_AbathurUnitBiomassStacks(lv_dyingUnit);
    if ((lv_stack > 0)) {
        libE0EAE146_gf_CreateAbathurBiomassPickup(UnitGetPosition(lv_dyingUnit), lv_stack);
        libE0EAE146_gf_XMDbgLog("INFO", "ABATHUR_BIOMASS_REFUND", "unit=" + UnitGetType(lv_dyingUnit) + " stack=" + IntToString(lv_stack) + " chance=" + FixedToString(lv_refundChance, c_fixedPrecisionAny));
