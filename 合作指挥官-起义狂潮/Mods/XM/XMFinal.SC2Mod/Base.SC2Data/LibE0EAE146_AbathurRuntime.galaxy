    libNtve_gf_SendActorMessageToUnit(lp_biomassUnit, ("SetScale " + FixedToString(libE0EAE146_gf_AbathurBiomassVisualScale(FixedToInt(UnitGetCustomValue(lp_biomassUnit, 63))), c_fixedPrecisionAny)));
}

bool libE0EAE146_gt_AbathurBiomassDrop_Func (bool testConds, bool runActions) {
    int lv_stack;

    if (testConds) {
        if ((libE0EAE146_gf_AbathurCanDropBiomass(EventUnit()) == false)) {
            return false;
        }
