void libE0EAE146_gf_AbathurSetUpgradeAtLeast (int lp_player, string lp_upgrade, int lp_level) {
    int lv_currentLevel;

    if ((lp_upgrade == "") || (!CatalogEntryIsValid(c_gameCatalogUpgrade, lp_upgrade))) {
        return;
    }

    lv_currentLevel = TechTreeUpgradeCount(lp_player, lp_upgrade, c_techCountCompleteOnly);
    if (lv_currentLevel < lp_level) {
        TechTreeUpgradeAddLevel(lp_player, lp_upgrade, (lp_level - lv_currentLevel));
    }
}

