// XMFinal split module: official commander unit roster profiles.
// Source authority: commanders/<Commander>/heroes.json + units.json + wiki-supported catalog supplements.
// Generated by scripts/sc2/generate-xmfinal-commander-profiles.mjs.

bool libE0EAE146_gf_XMTestBench_UnitRosterKindSupported (string lp_rosterKind) {
    return ((lp_rosterKind == "full_units") || (lp_rosterKind == "level15_units") || (lp_rosterKind == "fusion_final_units"));
}

void libE0EAE146_gf_XMTestBench_PrepareUnitRoster (int lp_player) {
    PlayerModifyPropertyInt(lp_player, c_playerPropSuppliesLimit, c_playerPropOperSetTo, 300);
    PlayerModifyPropertyInt(lp_player, c_playerPropSuppliesMade, c_playerPropOperSetTo, 300);
}

void libE0EAE146_gf_XMTestBench_CreateRosterUnit (int lp_player, string lp_unitType, int lp_index, string lp_rosterKind) {
    libE0EAE146_gf_XMDbgLog("INFO", "TEST_ROSTER_UNIT", "commander=" + libE0EAE146_gv_xmTestBenchCommander[lp_player] + " scenario=" + lp_rosterKind + " unitId=" + lp_unitType + " unit=" + lp_unitType + " index=" + IntToString(lp_index));
    libE0EAE146_gf_XMTestBench_CreateProfileUnit(lp_player, lp_unitType, libE0EAE146_gf_XMTestBench_SpawnPoint(lp_player, lp_index, 14.0, 4.0), lp_rosterKind);
}

void libE0EAE146_gf_XMTestBench_CreateRosterUnitAlias (int lp_player, string lp_sourceUnitType, string lp_resolvedUnitType, int lp_index, string lp_rosterKind) {
    libE0EAE146_gf_XMDbgLog("INFO", "TEST_ROSTER_ALIAS", "commander=" + libE0EAE146_gv_xmTestBenchCommander[lp_player] + " scenario=" + lp_rosterKind + " sourceUnitId=" + lp_sourceUnitType + " resolvedUnitId=" + lp_resolvedUnitType + " sourceUnit=" + lp_sourceUnitType + " resolvedUnit=" + lp_resolvedUnitType);
    libE0EAE146_gf_XMTestBench_CreateRosterUnit(lp_player, lp_resolvedUnitType, lp_index, lp_rosterKind);
}

bool libE0EAE146_gf_XMTestBench_AbathurBiomassRosterEligible (string lp_unitType) {
    if ((lp_unitType == "Drone") || (lp_unitType == "DroneBurrowed") || (lp_unitType == "Larva")) {
        return false;
    }
    if ((lp_unitType == "Overlord") || (lp_unitType == "Overseer") || (lp_unitType == "OverseerSiegeMode")) {
        return false;
    }
    return true;
}

void libE0EAE146_gf_XMTestBench_CreateAbathurRosterUnit (int lp_player, string lp_unitType, int lp_index, string lp_rosterKind) {
    int lv_before;
    int lv_after;
    int lv_applied;

    lv_before = libE0EAE146_gf_XMTestBench_CountPlayerUnits(lp_player);
    libE0EAE146_gf_XMTestBench_CreateRosterUnit(lp_player, lp_unitType, lp_index, lp_rosterKind);
    lv_after = libE0EAE146_gf_XMTestBench_CountPlayerUnits(lp_player);
    if ((lv_after > lv_before) && libE0EAE146_gf_XMTestBench_AbathurBiomassRosterEligible(lp_unitType)) {
        libE0EAE146_gf_AbathurSetUnitGroupFullBiomass(UnitLastCreatedGroup());
        lv_applied = libE0EAE146_gf_AbathurBiomassMaxStacks();
        libE0EAE146_gf_XMDbgLog("INFO", "TEST_ABATHUR_BIOMASS_SEEDED", "commander=Abathur scenario=" + lp_rosterKind + " unitId=" + lp_unitType + " stacks=" + IntToString(lv_applied) + " visualScale=" + FixedToString(libE0EAE146_gf_AbathurBiomassVisualScale(lv_applied), c_fixedPrecisionAny));
    }
}

void libE0EAE146_gf_XMTestBench_CreateAbathurRosterUnitAlias (int lp_player, string lp_sourceUnitType, string lp_resolvedUnitType, int lp_index, string lp_rosterKind) {
    libE0EAE146_gf_XMDbgLog("INFO", "TEST_ROSTER_ALIAS", "commander=" + libE0EAE146_gv_xmTestBenchCommander[lp_player] + " scenario=" + lp_rosterKind + " sourceUnitId=" + lp_sourceUnitType + " resolvedUnitId=" + lp_resolvedUnitType + " sourceUnit=" + lp_sourceUnitType + " resolvedUnit=" + lp_resolvedUnitType);
    libE0EAE146_gf_XMTestBench_CreateAbathurRosterUnit(lp_player, lp_resolvedUnitType, lp_index, lp_rosterKind);
}

void libE0EAE146_gf_XMTestBench_LogRosterDone (int lp_player, string lp_commander, string lp_rosterKind, int lp_expected) {
    libE0EAE146_gf_XMTestBench_SetLastEvent(lp_player, "TEST_ROSTER_" + lp_commander);
    libE0EAE146_gf_XMDbgLog("INFO", "TEST_COMMANDER_ROSTER_DONE", "commander=" + lp_commander + " scenario=" + lp_rosterKind + " expected=" + IntToString(lp_expected) + " created=" + IntToString(libE0EAE146_gv_xmTestBenchCreated[lp_player]) + " missing=" + IntToString(libE0EAE146_gv_xmTestBenchMissing[lp_player]));
}

