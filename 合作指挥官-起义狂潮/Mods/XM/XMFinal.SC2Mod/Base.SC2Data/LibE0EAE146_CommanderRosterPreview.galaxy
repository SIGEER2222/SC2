// XMFinal split module: official commander roster preview text.
// Source authority: commanders/<Commander>/commander.json + heroes.json + units.json + buildings.json.
// Generated by scripts/sc2/generate-xmfinal-commander-profiles.mjs.

string libE0EAE146_gf_XMTestBench_GetCommanderRosterPreviewTextForCommander (string lp_commander) {
    if (lp_commander == "Abathur") {
        return "官方 roster 预览｜阿巴瑟 / Abathur" + "\n" + "英雄(0)：无" + "\n" + "兵种/建筑(12)：守护者、吞噬者、异龙、脊针爬虫、孢子爬虫、虫群宿主、虫后、秽形蟑螂、破坏者、飞蛇、莽兽、利维坦" + "\n" + "备注：官方口径按 commander 目录；Abathur 只保留秽形蟑螂分支，不再列出普通蟑螂/尸毒蟑螂。runtime 侧虫后固定用 QueenCoop/QueenCoopBurrowed，不直接用 Queen/SwarmQueen，避免尼亚德拉混入。";
    }
    if (lp_commander == "AbathurReborn") {
        return "重生 roster 预览｜阿巴瑟 / AbathurReborn" + "\n" + "英雄(0)：无" + "\n" + "兵种(12)：跳虫、爆虫、蟑螂、刺蛇、异龙、宿主、雷兽、巢虫领主、感染者、腐化者、飞蛇、利维坦" + "\n" + "建筑(6)：主巢、孵化场、虫穴、进化腔、虫道网络、脊针爬虫" + "\n" + "备注：这是重生线，不沿用官方阿巴瑟口径；这里优先把会进化/会变体的条目单独列出来，避免和官方阿巴瑟混淆。";
    }
    if (lp_commander == "Alarak") {
        return "官方 roster 预览｜阿拉纳克 / Alarak" + "\n" + "简介：塔达林的高阶领主" + "\n" + "英雄(0)：无" + "\n" + "兵种(7)：天罚行者、晋升者、无情先锋、浩劫、死徒、战争棱镜、追猎者" + "\n" + "建筑(3)：传送门、光子炮台、光影议会" + "\n" + "口径：仅官方 commander/*.json，不含 wiki 补表。";
    }
    if (lp_commander == "Artanis") {
        return "官方 roster 预览｜阿塔尼斯 / Artanis" + "\n" + "简介：麾下的部队可以立刻投入战场。" + "\n" + "英雄(0)：无" + "\n" + "兵种(7)：执政官、不朽者、侦测器、凤凰、龙骑士、狂热者、高阶圣堂武士" + "\n" + "建筑(5)：传送门、光子炮台、机械研究所、折跃机械台、光影议会" + "\n" + "口径：仅官方 commander/*.json，不含 wiki 补表。";
    }
    if (lp_commander == "Dehaka") {
        return "官方 roster 预览｜德哈卡 / Dehaka" + "\n" + "英雄(4)：德哈卡、格里维格、穆尔瓦、达克伦" + "\n" + "兵种(14)：原始工蜂、掘地虫、爆裂掘地虫、原始刺蛇、原始异龙、掘地虫宿主、掠食龙、原始蟑螂、原始点火虫、原始宿主、原始雷兽、暴龙兽、原始跳虫、穿刺者" + "\n" + "建筑(7)：原始主巢、原始战争之巢、格里维格的巢穴、穆尔瓦的巢穴、达克伦的巢穴、原始蠕虫" + "\n" + "口径：仅官方 commander/*.json，不含 wiki 补表。";
    }
    if (lp_commander == "Fenix") {
        return "官方 roster 预览｜菲尼克斯 / Fenix" + "\n" + "简介：净化者执行官" + "\n" + "英雄(0)：无" + "\n" + "兵种(8)：使徒、巨像、侦测器、折跃侦察机、保护者、哨兵、不朽者、航母" + "\n" + "建筑(4)：传送门、光子炮台、机械研究所、光影议会" + "\n" + "口径：仅官方 commander/*.json，不含 wiki 补表。";
    }
    if ((lp_commander == "Mira") || (lp_commander == "Horner")) {
        return "官方 roster 预览｜霍纳与汉 / Horner" + "\n" + "英雄(0)：无" + "\n" + "兵种(10)：至尊战列巡航舰、恶火、恶蝠、忒伊亚铁鸦、收割者、德摩斯维京战机、寡妇雷、阿斯忒瑞亚怨灵战机、掠食者、解放者" + "\n" + "建筑(0)：无" + "\n" + "口径：仅官方 commander/*.json，不含 wiki 补表。";
    }
    if (lp_commander == "Karax") {
        return "官方 roster 预览｜凯拉克斯 / Karax" + "\n" + "简介：NYI" + "\n" + "英雄(0)：无" + "\n" + "兵种(8)：不朽者、侦测器、侦察机、折跃侦察机、激励者、哨兵、巨像、航母" + "\n" + "建筑(5)：传送门、光子炮台、护盾充能器、太阳锻炉、光影议会" + "\n" + "口径：仅官方 commander/*.json，不含 wiki 补表。";
    }
    if (lp_commander == "Kerrigan") {
        return "官方 roster 预览｜凯瑞甘 / Kerrigan" + "\n" + "简介：指挥海量军队，拥有强大的灵能。" + "\n" + "英雄(1)：凯瑞甘" + "\n" + "兵种(6)：巢虫领主、刺蛇（可进化潜伏者）、异龙、虫后、雷兽（复活形态）、跳虫（走腾跃虫分支，不进化爆虫）" + "\n" + "建筑(3)：虫道网络、脊针爬虫、孢子爬虫" + "\n" + "备注：这里按实机口径把演化关系写进预览，避免把基础单位和进化形态混成一条。";
    }
    if (lp_commander == "Mengsk") {
        return "官方 roster 预览｜蒙斯克 / Mengsk" + "\n" + "简介：帝国元首" + "\n" + "英雄(0)：无" + "\n" + "兵种(16)：帝国劳工、帝国冲锋队、帝国 火箭筒 冲锋队、帝国 火焰器 冲锋队、帝国 突击手 冲锋队、壁垒卫士、元首鬼影、帝国仲裁机、冲击分队、攻城坦克、黑色战锤、天空之怒、奥古斯特格勒的骄傲、帝国见证者" + "\n" + "建筑(11)：征兵中心、补给地堡、导弹塔、兵营、重工厂、星港、工程站、军械库、聚变芯体、皇家军校、大地碎裂炮" + "\n" + "口径：仅官方 commander/*.json，不含 wiki 补表。";
    }
    if (lp_commander == "Nova") {
        return "官方 roster 预览｜诺娃 / Nova" + "\n" + "英雄(0)：无" + "\n" + "兵种(11)：部署隐秘女妖、幽灵、部署强击歌利亚、部署恶蝠游骑兵、部署掠袭解放者、部署劫掠者突击手、部署精英陆战队员、部署铁鸦II型、死神之首、部署重型攻城坦克、SCV" + "\n" + "建筑(5)：兵营、幽灵军校、自动机炮、导弹塔、指挥中心" + "\n" + "口径：仅官方 commander/*.json，不含 wiki 补表。";
    }
    if (lp_commander == "Raynor") {
        return "官方 roster 预览｜雷诺 / Raynor" + "\n" + "简介：杰出的步战指挥官" + "\n" + "英雄(0)：无" + "\n" + "兵种(10)：陆战队员、医疗兵、秃鹫、火蝠、SCV、维京战机、女妖、劫掠者、战列巡航舰、攻城坦克" + "\n" + "建筑(6)：兵营、补给站、地堡、导弹塔、指挥中心、轨道控制基地" + "\n" + "口径：仅官方 commander/*.json，不含 wiki 补表。";
    }
    if (lp_commander == "Stetmann") {
        return "官方 roster 预览｜斯台特曼 / Stetmann" + "\n" + "英雄(0)：无" + "\n" + "兵种(16)：机械工蜂、盖瑞、超级盖瑞、机械跳虫、机械爆虫、机械蟑螂、机械破坏者、机械刺蛇、机械潜伏者、机械感染者、机械雷兽、机械腐化者、机械巢式战列空母、机械眼虫" + "\n" + "建筑(18)：机械孵化场、机械虫穴、机械主巢、机械萃取房、机械分裂池、机械进化腔、机械爆虫巢穴、机械刺蛇巢、机械潜伏者巢穴、机械感染深渊、机械尖塔、机械巨型尖塔、机械雷兽窟、机械脊针爬虫、机械孢子爬虫、艾星" + "\n" + "口径：仅官方 commander/*.json，不含 wiki 补表。";
    }
    if (lp_commander == "Stukov") {
        return "官方 roster 预览｜斯托科夫 / Stukov" + "\n" + "英雄(0)：无" + "\n" + "兵种(6)：被感染的平民、被感染的陆战队员、被感染的攻城坦克、王虫、被感染的女妖、被感染的解放者" + "\n" + "建筑(9)：被感染的工程站、被感染的军械库、被感染的兵营、被感染的移民营、被感染的指挥中心、被感染的重工厂、被感染的精炼厂、被感染的星港、被感染的补给站" + "\n" + "口径：仅官方 commander/*.json，不含 wiki 补表。";
    }
    if (lp_commander == "Swann") {
        return "官方 roster 预览｜斯旺 / Swann" + "\n" + "简介：擅长载具和防御建筑。" + "\n" + "英雄(0)：无" + "\n" + "兵种(9)：飓风、恶蝠、大力神、科学船、恶火、怨灵战机、SCV、歌利亚武装机器人、攻城坦克" + "\n" + "建筑(6)：补给站、德拉肯激光钻机、毁灭炮塔、导弹塔、末日炮塔、指挥中心" + "\n" + "口径：仅官方 commander/*.json，不含 wiki 补表。";
    }
    if (lp_commander == "Tychus") {
        return "官方 roster 预览｜泰凯斯 / Tychus" + "\n" + "简介：和各种魔鬼打过交道。" + "\n" + "英雄(9)：泰凯斯·芬利、维嘉、莱纳·尼卡拉中尉、迈尔斯“布雷泽”刘易斯、罗布“弹头哥”博斯韦尔、纳克斯、詹姆斯“天狼星”赛克斯、“老油条”萨姆、凯文“响尾蛇”韦斯特" + "\n" + "兵种(2)：劫掠者、SCV" + "\n" + "建筑(3)：枪王藏身处、鬼手安全屋、猛男军械库" + "\n" + "口径：仅官方 commander/*.json，不含 wiki 补表。";
    }
    if (lp_commander == "Vorazun") {
        return "官方 roster 预览｜沃拉尊 / Vorazun" + "\n" + "简介：操控时间和空间。" + "\n" + "英雄(0)：无" + "\n" + "兵种(7)：黑暗圣堂武士、先知、海盗船、狂热者、百夫长、追猎者、虚空辉光舰" + "\n" + "建筑(3)：传送门、光子炮台、光影议会" + "\n" + "口径：仅官方 commander/*.json，不含 wiki 补表。";
    }
    if (lp_commander == "Zagara") {
        return "官方 roster 预览｜扎加拉 / Zagara" + "\n" + "简介：使用无穷无尽的虫群进行战斗" + "\n" + "英雄(1)：扎加拉" + "\n" + "兵种(6)：畸变体、爆虫、腐化者、爆蚊、虫后、跳虫" + "\n" + "建筑(2)：脊针爬虫、孢子爬虫" + "\n" + "口径：仅官方 commander/*.json，不含 wiki 补表。";
    }
    if (lp_commander == "Zeratul") {
        return "官方 roster 预览｜泽拉图 / Zeratul" + "\n" + "简介：印第安纳·凯恩" + "\n" + "英雄(0)：无" + "\n" + "兵种(8)：萨尔纳加禁绝者、萨尔纳加执行者、侦测器、萨尔纳加观察者、萨尔纳加光盾卫士、萨尔纳加伏击者、萨尔纳加虚空阵列船、狂热者" + "\n" + "建筑(4)：黑暗圣坛、传送门、光子炮台、折跃机械台" + "\n" + "口径：仅官方 commander/*.json，不含 wiki 补表。";
    }
    return "官方 roster 预览暂无数据。";
}
