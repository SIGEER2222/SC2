void libC0F50AA6_gf_AddMengskVeterancyUnit (unitgroup lp_ug) {
    // Variable Declarations
    unitgroup lv_ug;
    unit lv_u;
    int lv_i;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_ug = UnitGroupEmpty();

    // Implementation
    lv_ug = lp_ug;
    lv_i = UnitGroupCount(lv_ug, c_unitCountAll);
    for (;; lv_i -= 1) {
        lv_u = UnitGroupUnitFromEnd(lv_ug, lv_i);
        if (lv_u == null) { break; }
        UnitSetCustomValue(lv_u, 63, (UnitGetPropertyInt(lv_u, c_unitPropSuppliesUsed, c_unitPropCurrent)*0.5));
    }
    UnitGroupAddUnitGroup(libC0F50AA6_gv_mengskVeterancyUnit, lv_ug);
}

