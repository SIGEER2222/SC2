            lv_u = UnitGroupUnitFromEnd(lv_ug, lv_i);
            if (lv_u == null) { break; }
            libC0F50AA6_gv_royalGuard += FixedToInt(UnitGetCustomValue(lv_u, 63));
        }
        lv_ug = libC0F50AA6_gv_mengskVeterancyUnitF;
        lv_i = UnitGroupCount(lv_ug, c_unitCountAll);
        for (;; lv_i -= 1) {
