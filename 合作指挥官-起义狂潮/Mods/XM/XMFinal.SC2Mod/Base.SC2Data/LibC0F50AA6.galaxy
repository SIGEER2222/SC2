    // Automatic Variable Declarations
    // Variable Initialization
    lv_ug = UnitGroupEmpty();

    // Actions
    if (!runActions) {
        return true;
    }

    while (true) {
        Wait(1.0, c_timeGame);
        libC0F50AA6_gv_trooper = libC0F50AA6_gv_blimpMengskTopbarRegen;
        lv_ug = libC0F50AA6_gv_mengskVeterancyUnit;
        libC0F50AA6_gv_royalGuard = 0;
        lv_i = UnitGroupCount(lv_ug, c_unitCountAll);
