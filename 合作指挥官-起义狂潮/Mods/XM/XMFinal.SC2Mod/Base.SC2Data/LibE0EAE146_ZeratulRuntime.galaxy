bool libE0EAE146_gt_ZeratulArtifactPickedUp_Func (bool testConds, bool runActions) {
    unit lv_artifact;
    int lv_player;
    string lv_artifactType;
    int lv_artifactNumber;

    lv_artifact = EventUnit();
    lv_player = UnitGetOwner(lv_artifact);
    lv_artifactType = UnitGetType(lv_artifact);

    if (testConds) {
        if (lv_player != libE0EAE146_gv_zeratulRuntimePlayer) {
            return false;
        }
        if (!((lv_artifactType == "ZeratulArtifactPickup1") || (lv_artifactType == "ZeratulArtifactPickup2") || (lv_artifactType == "ZeratulArtifactPickup3") || (lv_artifactType == "ZeratulArtifactPickupUnlimited"))) {
            return false;
        }
    }

    if (!runActions) {
        return true;
    }

    if (lv_artifactType == "ZeratulArtifactPickup1") {
        lv_artifactNumber = 1;
    }
    else if (lv_artifactType == "ZeratulArtifactPickup2") {
        lv_artifactNumber = 2;
    }
    else if (lv_artifactType == "ZeratulArtifactPickup3") {
        lv_artifactNumber = 3;
    }
    else {
        lv_artifactNumber = 4;
    }

    if (lv_artifactNumber == 1) {
        TechTreeUpgradeAddLevel(lv_player, "ZeratulArtifactTier1", 1);
    }
    else if (lv_artifactNumber == 2) {
        TechTreeUpgradeAddLevel(lv_player, "ZeratulArtifactTier2", 1);
    }
    else if (lv_artifactNumber == 3) {
        TechTreeUpgradeAddLevel(lv_player, "ZeratulArtifactTier3", 1);
    }
    else {
        TechTreeUpgradeAddLevel(lv_player, "ProphecyArtifactsDiscovered", 1);
    }

    lib67C0F0E7_gf_ZeratulPanelControl(lv_player, lv_artifactNumber, "Collected");
    libE0EAE146_gv_zeratulArtifactNumber = lv_artifactNumber + 1;
    libE0EAE146_gf_ZeratulPlaceArtifact(lv_player);
    return true;
}

