void libE0EAE146_gf_FenixRuntimeInit (int lp_player, point lp_heroPoint, bool lp_createHero) {
    unit lv_caster;

    if (libE0EAE146_gv_fenixRuntimeInitialized == true) {
        return;
    }

    libE0EAE146_gv_fenixRuntimeInitialized = true;
    libE0EAE146_gf_FenixApplyFullLevelUpgrades(lp_player);
    libE0EAE146_gf_FenixApplyFullMasteries(lp_player);
    libE0EAE146_gf_FenixApplyPositivePrestigeEffects(lp_player);
    libE0EAE146_gf_FenixApplyTechFilter(lp_player);

    libNtve_gf_CreateUnitsWithDefaultFacing(1, "SoACasterFenix", c_unitCreateIgnorePlacement, lp_player, RegionGetBoundsMin(RegionEntireMap()));
    lv_caster = UnitLastCreated();
    lib67C0F0E7_gf_CU_GPInit(lp_player, "Fenix", lv_caster, null);
    lib67C0F0E7_gf_CU_GPShowHide(true, lp_player, c_transitionDurationDefault);
    lib67C0F0E7_gf_ShowChooseButton();
    libE0EAE146_gf_CreateCommanderHeroStructure(lp_player, "Fenix");

    if (lp_createHero == true) {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "FenixCoop", 0, lp_player, lp_heroPoint);
    }
}
