    }
    lv_i = UnitGroupCount(lp_units, c_unitCountAlive);
    for (;; lv_i -= 1) {
        lv_unit = UnitGroupUnitFromEnd(lp_units, lv_i);
        if (lv_unit == null) { break; }
        libE0EAE146_gf_AbathurSetUnitFullBiomass(lv_unit);
    }
}

