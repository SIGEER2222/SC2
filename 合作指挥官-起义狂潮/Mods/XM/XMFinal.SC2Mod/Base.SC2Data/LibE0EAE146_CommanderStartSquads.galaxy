bool libE0EAE146_gt_AbathurBiomassTrain_Func (bool testConds, bool runActions) {
    unit lv_trainUnit;
    int lv_biomassBuff100Count;
    int lv_biomassBuff10Count;
    int lv_biomassBuff1Count;

    lv_trainUnit = EventUnitProgressUnit();
    if (testConds) {
        if (!((PlayerCommander(UnitGetOwner(EventUnit())) == "Abathur"))) {
            return false;
        }
        if (!((UnitHasBehavior2(EventUnit(), "BiomassBuff1") == true) || (UnitHasBehavior2(EventUnit(), "BiomassBuff10") == true) || (UnitHasBehavior2(EventUnit(), "BiomassBuff100") == true))) {
            return false;
        }
        if (!((libNtve_gf_TriggeringProgressUnitType() == "RavagerAbathur") || (libNtve_gf_TriggeringProgressUnitType() == "GuardianMP") || (libNtve_gf_TriggeringProgressUnitType() == "Devourer") || (libNtve_gf_TriggeringProgressUnitType() == "DevourerMP"))) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    lv_biomassBuff100Count = UnitBehaviorCount(EventUnit(), "BiomassBuff100");
    lv_biomassBuff10Count = UnitBehaviorCount(EventUnit(), "BiomassBuff10");
    lv_biomassBuff1Count = UnitBehaviorCount(EventUnit(), "BiomassBuff1");
    libE0EAE146_gf_AbathurAddBiomassStacks(lv_trainUnit, ((lv_biomassBuff100Count * 100) + (lv_biomassBuff10Count * 10) + lv_biomassBuff1Count));
    libE0EAE146_gf_XMDbgLog("INFO", "ABATHUR_BIOMASS_TRANSFER", "source=" + UnitGetType(EventUnit()) + " target=" + UnitGetType(lv_trainUnit) + " b100=" + IntToString(lv_biomassBuff100Count) + " b10=" + IntToString(lv_biomassBuff10Count) + " b1=" + IntToString(lv_biomassBuff1Count));
    return true;
}

