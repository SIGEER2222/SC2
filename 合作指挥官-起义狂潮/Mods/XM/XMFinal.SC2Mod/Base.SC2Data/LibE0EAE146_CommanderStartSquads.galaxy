bool libE0EAE146_gt_AbathurBiomassPickup_Func (bool testConds, bool runActions) {
    unit lv_pickup;
    unit lv_target;
    int lv_stored;
    int lv_applied;
    lv_pickup = EventPlayerEffectUsedUnit(c_effectUnitCaster);
    lv_target = EventPlayerEffectUsedUnit(c_effectUnitTarget);
    if (testConds) {
        if ((lv_pickup == null) || (lv_target == null)) { return false; }
        if ((UnitGetType(lv_pickup) != "BiomassPickup")) { return false; }
        if ((UnitGetOwner(lv_target) != libE0EAE146_gv_abathurBiomassPlayer)) { return false; }
    }
    if (!runActions) {
        return true;
    }
    lv_stored = FixedToInt(UnitGetCustomValue(lv_pickup, 63));
    lv_applied = libE0EAE146_gf_AbathurAddBiomassStacks(lv_target, lv_stored);
    if ((lv_applied <= 0)) { return true; }
    if ((lv_applied >= lv_stored)) {
        UnitBehaviorAdd(lv_pickup, "BiomassTravelling", lv_pickup, 1);
        UnitCreateEffectUnit(lv_pickup, "BiomassPickupFullLM", lv_target);
    }
    else {
        UnitSetCustomValue(lv_pickup, 63, IntToFixed(lv_stored - lv_applied));
        UnitCreateEffectUnit(lv_pickup, "BiomassPickupLM", lv_target);
    }
    libE0EAE146_gf_XMDbgLog("INFO", "ABATHUR_BIOMASS_PICKUP", "target=" + UnitGetType(lv_target) + " applied=" + IntToString(lv_applied) + " stored=" + IntToString(lv_stored));
    return true;
}
