bool libE0EAE146_gt_AbathurBiomassDrop_Func (bool testConds, bool runActions) {
    int lv_stack;
    if (testConds) {
        if ((libE0EAE146_gf_AbathurCanDropBiomass(EventUnit()) == false)) { return false; }
    }
    if (!runActions) {
        return true;
    }
    lv_stack = CeilingI(libE0EAE146_gf_AbathurBiomassAmount(EventUnit()));
    if ((lv_stack <= 0)) { return true; }
    libE0EAE146_gf_CreateAbathurBiomassPickup(UnitGetPosition(EventUnit()), lv_stack);
    libE0EAE146_gf_XMDbgLog("INFO", "ABATHUR_BIOMASS_DROP", "unit=" + UnitGetType(EventUnit()) + " owner=" + IntToString(UnitGetOwner(EventUnit())) + " stack=" + IntToString(lv_stack));
    return true;
}
