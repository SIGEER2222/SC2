void libE0EAE146_gf_XMTestBench_RunPowerFusion (int lp_player) {
    libE0EAE146_gf_XMTestBench_SeedCommanderBank(lp_player, libE0EAE146_gv_xmTestBenchCommander[lp_player]);
    libE0EAE146_gf_CommanderUpgrade();
    libE0EAE146_gf_XMTestBench_SetLastEvent(lp_player, "TEST_POWER_FUSION");
    libE0EAE146_gf_XMDbgLog("INFO", "TEST_POWER_FUSION", "commander=" + libE0EAE146_gv_xmTestBenchCommander[lp_player] + " result=override_seeded reason=smoke_seed_only");
}

void libE0EAE146_gf_XMTestBench_RunHeroSmoke (int lp_player) {
    string lv_commander;

    lv_commander = libE0EAE146_gf_NormalizeCommanderId(libE0EAE146_gv_xmTestBenchCommander[lp_player]);
    if (libE0EAE146_gv_xmTestBenchScenario[lp_player] == "hero_ability_smoke") {
        if (!libE0EAE146_gf_XMTestBench_RunCommanderHeroAbilities(lp_player, lv_commander, "hero_ability_smoke")) {
            libE0EAE146_gf_XMTestBench_LogScenarioStub(lp_player, "hero_ability_smoke", "hero_ability_profile_not_wired");
        }
        return;
    }
    libE0EAE146_gf_XMTestBench_LogScenarioStub(lp_player, "hero_modes", "hero_mode_profile_not_wired");
}

void libE0EAE146_gf_XMTestBench_RunUnitAbilitySmoke (int lp_player) {
    string lv_commander;
    string lv_scenario;

    lv_commander = libE0EAE146_gf_NormalizeCommanderId(libE0EAE146_gv_xmTestBenchCommander[lp_player]);
    lv_scenario = libE0EAE146_gv_xmTestBenchScenario[lp_player];
    if ((lv_commander == "AbathurCustom") && (libE0EAE146_gv_xmTestBenchScenario[lp_player] == "unit_evolution_smoke")) {
        libE0EAE146_gf_XMTestBench_AbathurCustomZerglingToPygalisk(lp_player);
        return;
    }
    if (lv_commander == "AbathurCustom") {
        libE0EAE146_gf_XMTestBench_AbathurCustomPurchaseSmoke(lp_player);
        return;
    }
    if (!libE0EAE146_gf_XMTestBench_RunCommanderUnitAbilities(lp_player, lv_commander, lv_scenario)) {
        libE0EAE146_gf_XMTestBench_LogScenarioStub(lp_player, lv_scenario, "unit_ability_profile_not_wired");
    }
}

void libE0EAE146_gf_XMTestBench_RunPanelCostSmoke (int lp_player) {
    if (XM_InvokeCommanderPanelAbility(lp_player, libE0EAE146_gv_xmTestBenchCommander[lp_player], "default", PointWithOffsetPolar(libE0EAE146_gf_XMTestBench_GetSafeOriginPoint(lp_player), 18.0, 0.0)) == false) {
        libE0EAE146_gf_XMDbgLog("INFO", "PANEL_COST_SKIPPED", "commander=" + libE0EAE146_gv_xmTestBenchCommander[lp_player] + " reason=panel_profile_not_fully_castable");
    }
}

void libE0EAE146_gf_XMTestBench_RunPanelEffectSmoke (int lp_player) {
    string lv_commander;
    point lv_targetPoint;
    bool lv_ok;
    string lv_result;

    lv_commander = libE0EAE146_gf_NormalizeCommanderId(libE0EAE146_gv_xmTestBenchCommander[lp_player]);
    lv_targetPoint = PointWithOffsetPolar(libE0EAE146_gf_XMTestBench_GetSafeOriginPoint(lp_player), 18.0, 0.0);

    if (lv_commander == "Kerrigan") {
        lv_ok = XM_InvokeCommanderPanelAbility(lp_player, lv_commander, "assimilation_aura", lv_targetPoint);
        lv_result = "panel_profile_failed";
        if (lv_ok) {
            lv_result = "profile_backed_smoke";
        }
        libE0EAE146_gf_XMDbgLog("INFO", "PANEL_EFFECT_CAST", "commander=" + lv_commander + " ability=KerriganVoidCoopEconDrop targetMode=instant note=assimilation_aura result=" + lv_result);
        Wait(0.25, c_timeGame);
        lv_ok = XM_InvokeCommanderPanelAbility(lp_player, lv_commander, "immobilization_wave", lv_targetPoint);
        lv_result = "panel_profile_failed";
        if (lv_ok) {
            lv_result = "profile_backed_smoke";
        }
        libE0EAE146_gf_XMDbgLog("INFO", "PANEL_EFFECT_CAST", "commander=" + lv_commander + " ability=KerriganVoidCoopCrushingGripWave targetMode=instant note=immobilization_wave result=" + lv_result);
        Wait(0.25, c_timeGame);
        lv_ok = XM_InvokeCommanderPanelAbility(lp_player, lv_commander, "maelstrom", lv_targetPoint);
        lv_result = "panel_profile_failed";
        if (lv_ok) {
            lv_result = "profile_backed_smoke";
        }
        libE0EAE146_gf_XMDbgLog("INFO", "PANEL_EFFECT_CAST", "commander=" + lv_commander + " ability=KerriganMaelstrom targetMode=instant note=maelstrom result=" + lv_result);
        return;
    }

    XM_InvokeCommanderPanelAbility(lp_player, libE0EAE146_gv_xmTestBenchCommander[lp_player], "default", lv_targetPoint);
    libE0EAE146_gf_XMDbgLog("INFO", "PANEL_EFFECT_SKIPPED", "commander=" + libE0EAE146_gv_xmTestBenchCommander[lp_player] + " reason=panel_profile_not_wired");
}

void libE0EAE146_gf_XMTestBench_RunTechSmoke (int lp_player) {
    string lv_commander;

    lv_commander = libE0EAE146_gf_NormalizeCommanderId(libE0EAE146_gv_xmTestBenchCommander[lp_player]);
    if (lv_commander == "AbathurCustom") {
        libE0EAE146_gf_XMTestBench_AbathurCustomCrawlerSmoke(lp_player);
        return;
    }
    if (!libE0EAE146_gf_XMTestBench_RunCommanderTech(lp_player, lv_commander, "tech_smoke")) {
        libE0EAE146_gf_XMTestBench_LogScenarioStub(lp_player, "tech_smoke", "tech_profile_not_wired");
    }
}

void libE0EAE146_gf_XMTestBench_RunTransportSmoke (int lp_player, string lp_cargoKind) {
    string lv_commander;
    string lv_containerType;
    unit lv_container;
    point lv_point;

    lv_commander = libE0EAE146_gf_NormalizeCommanderId(libE0EAE146_gv_xmTestBenchCommander[lp_player]);
    lv_containerType = libE0EAE146_gf_XMTestBench_ResolveTransportContainerType(lv_commander, lp_cargoKind);
    lv_point = PointWithOffsetPolar(libE0EAE146_gf_XMTestBench_GetSafeOriginPoint(lp_player), 18.0, 0.0);

    libE0EAE146_gf_XMTestBench_SetLastEvent(lp_player, "TEST_TRANSPORT_START");
    libE0EAE146_gf_XMTestBench_AppendTrace(lp_player, "TRANSPORT:" + lv_commander + ":" + lp_cargoKind);
    libE0EAE146_gf_XMDbgLog("INFO", "TEST_TRANSPORT_START", "commander=" + lv_commander + " cargoKind=" + lp_cargoKind + " containerType=" + lv_containerType + " result=start");

    lv_container = libE0EAE146_gf_XMTestBench_CreateTransportUnit(lp_player, lv_containerType, lv_point, lp_cargoKind);
    libE0EAE146_gf_XMTestBench_CreateTransportCargoProfile(lp_player, lv_container, lv_commander, lp_cargoKind);

    libE0EAE146_gf_XMTestBench_SetLastEvent(lp_player, "TEST_TRANSPORT_DONE");
    libE0EAE146_gf_XMDbgLog("INFO", "TEST_TRANSPORT_DONE", "commander=" + lv_commander + " cargoKind=" + lp_cargoKind + " containerType=" + lv_containerType + " result=ok");
}

