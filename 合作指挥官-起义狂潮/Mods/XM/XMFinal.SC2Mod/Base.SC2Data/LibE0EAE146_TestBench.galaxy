    libE0EAE146_gf_XMTestBench_WriteSummary(lp_player);
}

void libE0EAE146_gf_XMTestBench_RunAllVisual (int lp_player) {
    string lv_commander;

    if (!libE0EAE146_gf_XMTestBench_PlayerValid(lp_player)) {
        libE0EAE146_gf_XMDbgLog("ERROR", "TEST_PLAYER_INVALID", "player=" + IntToString(lp_player));
        return;
    }

    lv_commander = libE0EAE146_gf_NormalizeCommanderId(libE0EAE146_gv_xmTestBenchCommander[lp_player]);
    libE0EAE146_gf_XMTestBench_SeedCommanderBank(lp_player, lv_commander);
    libE0EAE146_gf_XMTestBench_SetLastEvent(lp_player, "TEST_ALL_VISUAL_START");
    libE0EAE146_gf_XMTestBench_AppendTrace(lp_player, "ALL_VISUAL:" + lv_commander);
    libE0EAE146_gf_XMDbgLog("INFO", "TEST_ALL_VISUAL_START", "commander=" + lv_commander + " result=start");

    libE0EAE146_gf_XMTestBench_RunPowerFusion(lp_player);
    libE0EAE146_gf_XMTestBench_RunRoster(lp_player, "full_buildings");
    libE0EAE146_gf_XMTestBench_RunRoster(lp_player, "full_units");
    libE0EAE146_gf_XMTestBench_RunPanelCostSmoke(lp_player);
    libE0EAE146_gf_XMTestBench_RunPanelEffectSmoke(lp_player);

    libE0EAE146_gf_XMTestBench_SetLastEvent(lp_player, "TEST_ALL_VISUAL_DONE");
    libE0EAE146_gf_XMDbgLog("INFO", "TEST_ALL_VISUAL_DONE", "commander=" + lv_commander + " created=" + IntToString(libE0EAE146_gv_xmTestBenchCreated[lp_player]) + " missing=" + IntToString(libE0EAE146_gv_xmTestBenchMissing[lp_player]) + " warnings=" + IntToString(libE0EAE146_gv_xmTestBenchWarnings[lp_player]) + " errors=" + IntToString(libE0EAE146_gv_xmTestBenchErrors[lp_player]));
}

void libE0EAE146_gf_XMTestBench_RunScenario (int lp_player, string lp_scenarioKind) {
    if (!libE0EAE146_gf_XMTestBench_PlayerValid(lp_player)) {
        libE0EAE146_gf_XMDbgLog("ERROR", "TEST_PLAYER_INVALID", "player=" + IntToString(lp_player));
        return;
    }

    libE0EAE146_gf_XMTestBench_ResetCounters(lp_player);
    libE0EAE146_gv_xmTestBenchScenario[lp_player] = lp_scenarioKind;
    libE0EAE146_gv_xmTestBenchLastEvent[lp_player] = "TEST_SCENARIO_START";
    libE0EAE146_gf_XMTestBench_AppendTrace(lp_player, "SCEN:" + lp_scenarioKind);
    libE0EAE146_gf_XMDbgLog("INFO", "TEST_SCENARIO_START", "commander=" + libE0EAE146_gv_xmTestBenchCommander[lp_player] + " normalized=" + libE0EAE146_gf_NormalizeCommanderId(libE0EAE146_gv_xmTestBenchCommander[lp_player]) + " scenario=" + lp_scenarioKind);

    if (lp_scenarioKind == "all_visual") {
        libE0EAE146_gf_XMTestBench_RunAllVisual(lp_player);
    }
    else if (lp_scenarioKind == "standard_base") {
        libE0EAE146_gf_XMTestBench_RunStandardBase(lp_player);
    }
    else if (lp_scenarioKind == "power_fusion") {
        libE0EAE146_gf_XMTestBench_RunPowerFusion(lp_player);
    }
    else if (lp_scenarioKind == "panel_cost_smoke") {
        libE0EAE146_gf_XMTestBench_RunPanelCostSmoke(lp_player);
    }
    else if (lp_scenarioKind == "panel_effect_smoke") {
        libE0EAE146_gf_XMTestBench_RunPanelEffectSmoke(lp_player);
    }
    else if ((lp_scenarioKind == "full_buildings") || (lp_scenarioKind == "full_units") || (lp_scenarioKind == "initial_units") || (lp_scenarioKind == "level15_units") || (lp_scenarioKind == "fusion_final_units")) {
        libE0EAE146_gf_XMTestBench_RunRoster(lp_player, lp_scenarioKind);
    }
    else if ((lp_scenarioKind == "hero_modes") || (lp_scenarioKind == "hero_ability_smoke")) {
        libE0EAE146_gf_XMTestBench_RunHeroSmoke(lp_player);
    }
    else if ((lp_scenarioKind == "unit_ability_smoke") || (lp_scenarioKind == "unit_evolution_smoke")) {
        libE0EAE146_gf_XMTestBench_RunUnitAbilitySmoke(lp_player);
    }
    else if (lp_scenarioKind == "tech_smoke") {
        libE0EAE146_gf_XMTestBench_RunTechSmoke(lp_player);
    }
    else if ((lp_scenarioKind == "cargo_light") || (lp_scenarioKind == "cargo_heavy") || (lp_scenarioKind == "cargo_air")) {
        libE0EAE146_gf_XMTestBench_RunTransportSmoke(lp_player, lp_scenarioKind);
    }
    else if (lp_scenarioKind == "special_smoke") {
        libE0EAE146_gf_XMTestBench_RunSpecialSmoke(lp_player);
    }
    else if (lp_scenarioKind == "personal_smoke") {
        libE0EAE146_gf_XMTestBench_RunPersonalSmoke(lp_player);
    }
    else if (lp_scenarioKind == "extra_abathur_init") {
        libE0EAE146_gf_XMTestBench_AbathurCustomInit(lp_player);
    }
    else if (lp_scenarioKind == "extra_abathur_zergling_to_pygalisk") {
        libE0EAE146_gf_XMTestBench_AbathurCustomZerglingToPygalisk(lp_player);
    }
    else if (lp_scenarioKind == "extra_abathur_purchase") {
        libE0EAE146_gf_XMTestBench_AbathurCustomPurchaseSmoke(lp_player);
    }
    else if (lp_scenarioKind == "extra_abathur_crawler") {
        libE0EAE146_gf_XMTestBench_AbathurCustomCrawlerSmoke(lp_player);
    }
    else {
        libE0EAE146_gf_XMTestBench_AddError(lp_player);
        libE0EAE146_gf_XMDbgLog("ERROR", "TEST_SCENARIO_UNKNOWN", "scenario=" + lp_scenarioKind);
    }

    libE0EAE146_gf_XMTestBench_WriteSummary(lp_player);
    libE0EAE146_gf_XMDbgLog("INFO", "TEST_SCENARIO_DONE", "commander=" + libE0EAE146_gv_xmTestBenchCommander[lp_player] + " scenario=" + lp_scenarioKind + " created=" + IntToString(libE0EAE146_gv_xmTestBenchCreated[lp_player]) + " missing=" + IntToString(libE0EAE146_gv_xmTestBenchMissing[lp_player]) + " warnings=" + IntToString(libE0EAE146_gv_xmTestBenchWarnings[lp_player]) + " errors=" + IntToString(libE0EAE146_gv_xmTestBenchErrors[lp_player]));
}

