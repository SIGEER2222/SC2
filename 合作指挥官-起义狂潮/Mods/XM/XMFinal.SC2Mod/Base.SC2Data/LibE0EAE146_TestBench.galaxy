void libE0EAE146_gf_XMTestBench_WriteSummary (int lp_player) {
    string lv_summary;

    if (!libE0EAE146_gf_XMTestBench_PlayerValid(lp_player)) {
        return;
    }

    lv_summary = "Commander: " + libE0EAE146_gv_xmTestBenchCommander[lp_player];
    lv_summary = lv_summary + " | Normalized: " + libE0EAE146_gf_NormalizeCommanderId(libE0EAE146_gv_xmTestBenchCommander[lp_player]);
    lv_summary = lv_summary + " | Scenario: " + libE0EAE146_gv_xmTestBenchScenario[lp_player];
    lv_summary = lv_summary + " | Blessing: " + XMBlessing_Selected(lp_player);
    lv_summary = lv_summary + " | Challenge: " + XMChallenge_Active(lp_player);
    lv_summary = lv_summary + " | Created: " + IntToString(libE0EAE146_gv_xmTestBenchCreated[lp_player]);
    lv_summary = lv_summary + " | Missing: " + IntToString(libE0EAE146_gv_xmTestBenchMissing[lp_player]);
    if (libE0EAE146_gv_xmTestBenchRequestedIds[lp_player] != "") {
        lv_summary = lv_summary + " | RequestedIds: " + libE0EAE146_gv_xmTestBenchRequestedIds[lp_player];
    }
    if (libE0EAE146_gv_xmTestBenchActualIds[lp_player] != "") {
        lv_summary = lv_summary + " | ActualIds: " + libE0EAE146_gv_xmTestBenchActualIds[lp_player];
    }
    if (libE0EAE146_gv_xmTestBenchMissingIds[lp_player] != "") {
        lv_summary = lv_summary + " | MissingIds: " + libE0EAE146_gv_xmTestBenchMissingIds[lp_player];
    }
    lv_summary = lv_summary + " | Warnings: " + IntToString(libE0EAE146_gv_xmTestBenchWarnings[lp_player]);
    lv_summary = lv_summary + " | Errors: " + IntToString(libE0EAE146_gv_xmTestBenchErrors[lp_player]);
    lv_summary = lv_summary + " | Last: " + libE0EAE146_gv_xmTestBenchLastEvent[lp_player];
    libE0EAE146_gv_xmTestBenchSummary[lp_player] = lv_summary;
    libE0EAE146_gf_XMTestBench_WriteReportBank(lp_player);
    libE0EAE146_gf_XMDbgLog("INFO", "TEST_SUMMARY", "commander=" + libE0EAE146_gv_xmTestBenchCommander[lp_player] + " scenario=" + libE0EAE146_gv_xmTestBenchScenario[lp_player] + " created=" + IntToString(libE0EAE146_gv_xmTestBenchCreated[lp_player]) + " missing=" + IntToString(libE0EAE146_gv_xmTestBenchMissing[lp_player]) + " warnings=" + IntToString(libE0EAE146_gv_xmTestBenchWarnings[lp_player]) + " errors=" + IntToString(libE0EAE146_gv_xmTestBenchErrors[lp_player]));
    libE0EAE146_gf_XMDbgLog("INFO", "TEST_SUMMARY_IDS", "commander=" + libE0EAE146_gv_xmTestBenchCommander[lp_player] + " scenario=" + libE0EAE146_gv_xmTestBenchScenario[lp_player] + " requestedIds=" + libE0EAE146_gv_xmTestBenchRequestedIds[lp_player] + " actualIds=" + libE0EAE146_gv_xmTestBenchActualIds[lp_player] + " missingIds=" + libE0EAE146_gv_xmTestBenchMissingIds[lp_player]);
}

