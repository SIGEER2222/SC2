string libE0EAE146_gf_XMTestBench_NormalizeTransportCargoKind (string lp_cargoKind) {
    if ((lp_cargoKind == "cargo_heavy") || (lp_cargoKind == "heavy")) {
        return "heavy";
    }
    if ((lp_cargoKind == "cargo_air") || (lp_cargoKind == "air")) {
        return "air";
    }
    return "light";
}

