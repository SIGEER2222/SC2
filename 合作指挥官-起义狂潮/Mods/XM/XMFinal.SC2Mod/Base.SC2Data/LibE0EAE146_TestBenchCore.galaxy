int libE0EAE146_gf_XMTestBench_CountPlayerUnits (int lp_player) {
    unitgroup lv_units;

    if (!libE0EAE146_gf_XMTestBench_PlayerValid(lp_player)) {
        return 0;
    }
    lv_units = UnitGroup(null, lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    return UnitGroupCount(lv_units, c_unitCountAlive);
}

void libE0EAE146_gf_XMTestBench_RemovePlayerUnits (int lp_player) {
    unit lv_unit;
    unitgroup lv_units;
    int lv_count;

    if (!libE0EAE146_gf_XMTestBench_PlayerValid(lp_player)) {
        return;
    }

    lv_units = UnitGroup(null, lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_count = UnitGroupCount(lv_units, c_unitCountAll);
    for (;; lv_count -= 1) {
        lv_unit = UnitGroupUnitFromEnd(lv_units, lv_count);
        if (lv_unit == null) { break; }
        UnitRemove(lv_unit);
    }
}

