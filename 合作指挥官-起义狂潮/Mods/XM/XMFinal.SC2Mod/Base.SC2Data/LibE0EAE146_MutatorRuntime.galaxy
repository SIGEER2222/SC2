int libE0EAE146_gf_MutatorRuntimePresetContains (int lp_preset, string lp_mutator) {
    if ((lp_preset >= 1) && (lp_mutator == "UnitSpeed")) {
        return 1;
    }
    if ((lp_preset >= 2) && ((lp_mutator == "Avenger") || (lp_mutator == "Barrier"))) {
        return 1;
    }
    if ((lp_preset >= 3) && ((lp_mutator == "HybridNuke") || (lp_mutator == "VoidRifts"))) {
        return 1;
    }
    return 0;
}

void libE0EAE146_gf_MutatorRuntimeClearAllMutators () {
}

int libE0EAE146_gf_MutatorRuntimeEnableSelectedFromBank (int lp_preset) {
    int lv_i;
    int lv_hasSelectedKey;
    int lv_enabledCount;
    string lv_mutator;
    string lv_key;

    BankLoad("CampaignXCore", 1);
    lv_hasSelectedKey = 0;
    lv_enabledCount = 0;
    lv_i = 1;
    for ( ; ( lv_i <= libE0EAE146_gv_mutatorRuntimeCount ) ; lv_i += 1 ) {
        lv_mutator = libE0EAE146_gf_MutatorRuntimeId(lv_i);
        lv_key = libE0EAE146_gf_MutatorRuntimeSelectedKey(lv_mutator);
        if (BankKeyExists(BankLastCreated(), "Mutators", lv_key)) {
            lv_hasSelectedKey = 1;
            if (BankValueGetAsInt(BankLastCreated(), "Mutators", lv_key) > 0) {
                lv_enabledCount += 1;
            }
        }
    }

    if (lv_hasSelectedKey == 0) {
        lv_i = 1;
        for ( ; ( lv_i <= libE0EAE146_gv_mutatorRuntimeCount ) ; lv_i += 1 ) {
            lv_mutator = libE0EAE146_gf_MutatorRuntimeId(lv_i);
            if (libE0EAE146_gf_MutatorRuntimePresetContains(lp_preset, lv_mutator) > 0) {
                lv_enabledCount += 1;
            }
        }
    }
    return lv_enabledCount;
}

void libE0EAE146_gf_MutatorRuntimeStartFromBank (int lp_enemyPlayer) {
    int lv_enabled;
    int lv_preset;
    int lv_enabledCount;

    if (libE0EAE146_gv_mutatorRuntimeStarted) {
        return;
    }

    lv_enabled = libE0EAE146_gf_MutatorRuntimeBankIntOrDefault("Enabled", 0);
    lv_preset = libE0EAE146_gf_MutatorRuntimeBankIntOrDefault("Preset", 0);
    if (lv_enabled <= 0) {
        return;
    }

    if (lv_preset < 0) {
        lv_preset = 0;
    }
    if (lv_preset > 3) {
        lv_preset = 3;
    }

    lv_enabledCount = libE0EAE146_gf_MutatorRuntimeEnableSelectedFromBank(lv_preset);
    if (lv_enabledCount <= 0) {
        return;
    }

    libE0EAE146_gv_mutatorRuntimeStarted = true;
    libE0EAE146_gv_mutatorRuntimePreset = lv_preset;
}
