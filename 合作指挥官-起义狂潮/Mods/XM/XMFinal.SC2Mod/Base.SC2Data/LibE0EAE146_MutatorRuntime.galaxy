//--------------------------------------------------------------------------------------------------
// 7v1 optional mutator runtime bridge.
//
// The external mutator mods currently collide with campaign catalog data on real maps. Keep the Bank
// contract here, but do not hard-load or start the mutator library until its catalog closure is fixed.
//--------------------------------------------------------------------------------------------------

const int libE0EAE146_gv_mutatorRuntimeCount = 69;

int libE0EAE146_gf_MutatorRuntimeBankIntOrDefault (string lp_key, int lp_defaultValue) {
    BankLoad("CampaignXCore", 1);
    if (!BankKeyExists(BankLastCreated(), "Mutators", lp_key)) {
        return lp_defaultValue;
    }
    return BankValueGetAsInt(BankLastCreated(), "Mutators", lp_key);
}

string libE0EAE146_gf_MutatorRuntimeSelectedKey (string lp_mutator) {
    return "Selected." + lp_mutator;
}

