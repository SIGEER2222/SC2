// XMFinal split module: commander ability smoke shared helpers.

bool libE0EAE146_gf_XMTestBench_AbilityScenarioSupported (string lp_scenarioKind) {
    return ((lp_scenarioKind == "hero_ability_smoke") || (lp_scenarioKind == "unit_ability_smoke") || (lp_scenarioKind == "unit_evolution_smoke"));
}

bool libE0EAE146_gf_XMTestBench_CheckAbilityProfileEntry (int lp_player, string lp_commander, string lp_scenarioKind, string lp_objectId, string lp_buttonId, string lp_abilityId, string lp_requirementId, string lp_entryKind) {
    bool lv_ok;

    lv_ok = true;
    if ((lp_objectId != "") && !CatalogEntryIsValid(c_gameCatalogUnit, lp_objectId)) {
        lv_ok = false;
    }
    if ((lp_buttonId != "") && !CatalogEntryIsValid(c_gameCatalogButton, lp_buttonId)) {
        lv_ok = false;
    }
    if ((lp_abilityId != "") && !CatalogEntryIsValid(c_gameCatalogAbil, lp_abilityId)) {
        lv_ok = false;
    }
    if ((lp_requirementId != "") && !CatalogEntryIsValid(c_gameCatalogRequirement, lp_requirementId)) {
        lv_ok = false;
    }

    if (lv_ok) {
        libE0EAE146_gv_xmTestBenchCreated[lp_player] += 1;
        libE0EAE146_gf_XMDbgLog("INFO", "TEST_ABILITY_PROFILE_PRESENT", "commander=" + lp_commander + " scenario=" + lp_scenarioKind + " object=" + lp_objectId + " button=" + lp_buttonId + " ability=" + lp_abilityId + " requirement=" + lp_requirementId + " kind=" + lp_entryKind);
        return true;
    }

    libE0EAE146_gv_xmTestBenchMissing[lp_player] += 1;
    libE0EAE146_gf_XMTestBench_AddWarning(lp_player);
    libE0EAE146_gf_XMDbgLog("WARN", "TEST_ABILITY_PROFILE_MISSING", "commander=" + lp_commander + " scenario=" + lp_scenarioKind + " object=" + lp_objectId + " button=" + lp_buttonId + " ability=" + lp_abilityId + " requirement=" + lp_requirementId + " kind=" + lp_entryKind + " reason=object_button_ability_or_requirement_catalog_missing");
    return false;
}

void libE0EAE146_gf_XMTestBench_LogAbilityProfileDone (int lp_player, string lp_commander, string lp_scenarioKind, int lp_expected) {
    libE0EAE146_gf_XMTestBench_SetLastEvent(lp_player, "TEST_ABILITIES_" + lp_commander);
    libE0EAE146_gf_XMDbgLog("INFO", "TEST_COMMANDER_ABILITIES_DONE", "commander=" + lp_commander + " scenario=" + lp_scenarioKind + " expected=" + IntToString(lp_expected) + " present=" + IntToString(libE0EAE146_gv_xmTestBenchCreated[lp_player]) + " missing=" + IntToString(libE0EAE146_gv_xmTestBenchMissing[lp_player]) + " mode=catalog_presence_only");
}
