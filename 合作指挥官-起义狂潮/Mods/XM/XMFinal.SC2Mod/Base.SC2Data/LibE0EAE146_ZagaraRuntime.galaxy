void libE0EAE146_gf_ZagaraSetUpgradeAtLeast (int lp_player, string lp_upgrade, int lp_level) {
    int lv_currentLevel;

    if ((lp_upgrade == "") || (!CatalogEntryIsValid(c_gameCatalogUpgrade, lp_upgrade))) {
        return;
    }

    lv_currentLevel = TechTreeUpgradeCount(lp_player, lp_upgrade, c_techCountCompleteOnly);
    if (lv_currentLevel < lp_level) {
        TechTreeUpgradeAddLevel(lp_player, lp_upgrade, (lp_level - lv_currentLevel));
    }
}

void libE0EAE146_gf_ZagaraAllowUnitIfPresent (int lp_player, string lp_unit) {
    if ((lp_unit == "") || (!CatalogEntryIsValid(c_gameCatalogUnit, lp_unit))) {
        return;
    }
    TechTreeUnitAllow(lp_player, lp_unit, true);
}

void libE0EAE146_gf_ZagaraBlockUnitIfPresent (int lp_player, string lp_unit) {
    if ((lp_unit == "") || (!CatalogEntryIsValid(c_gameCatalogUnit, lp_unit))) {
        return;
    }
    TechTreeUnitAllow(lp_player, lp_unit, false);
}

void libE0EAE146_gf_ZagaraAllowAbilityIfPresent (int lp_player, string lp_abil, int lp_cmdIndex) {
    if ((lp_abil == "") || (!CatalogEntryIsValid(c_gameCatalogAbil, lp_abil))) {
        return;
    }
    TechTreeAbilityAllow(lp_player, AbilityCommand(lp_abil, lp_cmdIndex), true);
}

