void libE0EAE146_gf_ZagaraRuntimeInit (int lp_player, point lp_heroPoint, bool lp_createHero) {
    unit lv_caster;
    unit lv_hero;

    if (libE0EAE146_gv_zagaraRuntimeInitialized == true) {
        return;
    }

    libE0EAE146_gv_zagaraRuntimeInitialized = true;
    libE0EAE146_gf_ZagaraApplyFullLevelUpgrades(lp_player);
    libE0EAE146_gf_ZagaraApplyFullMasteries(lp_player);
    libE0EAE146_gf_ZagaraApplyPositivePrestigeEffects(lp_player);
    libE0EAE146_gf_ZagaraApplyTechFilter(lp_player);

    libNtve_gf_CreateUnitsWithDefaultFacing(1, "CoopCasterZagara", c_unitCreateIgnorePlacement, lp_player, RegionGetBoundsMin(RegionEntireMap()));
    lv_caster = UnitLastCreated();

    if (lp_createHero == true) {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "ZagaraVoidCoop", 0, lp_player, lp_heroPoint);
        lv_hero = UnitLastCreated();
        libE0EAE146_gt_CommanderHeroDied_Init();
        lib67C0F0E7_gf_CU_GPInit(lp_player, "Zagara", lv_hero, lv_caster);
    }
    else {
        lib67C0F0E7_gf_CU_GPInit(lp_player, "Zagara", lv_caster, null);
    }

    lib67C0F0E7_gf_CU_GPShowHide(true, lp_player, c_transitionDurationDefault);
    lib67C0F0E7_gf_ShowChooseButton();
}
