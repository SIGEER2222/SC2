// XMFinal split module: official commander tech and upgrade smoke profiles.
// Source authority: commanders/<Commander>/upgrades.json.
// Generated by scripts/sc2/generate-xmfinal-commander-profiles.mjs.

bool libE0EAE146_gf_XMTestBench_TechScenarioSupported (string lp_scenarioKind) {
    return (lp_scenarioKind == "tech_smoke");
}

bool libE0EAE146_gf_XMTestBench_CheckTechUpgrade (int lp_player, string lp_commander, string lp_upgradeId, string lp_scenarioKind) {
    if (lp_upgradeId == "") {
        libE0EAE146_gv_xmTestBenchMissing[lp_player] += 1;
        libE0EAE146_gf_XMTestBench_AddWarning(lp_player);
        libE0EAE146_gf_XMDbgLog("WARN", "TEST_TECH_UPGRADE_MISSING", "commander=" + lp_commander + " scenario=" + lp_scenarioKind + " upgrade=blank");
        return false;
    }
    if (CatalogEntryIsValid(c_gameCatalogUpgrade, lp_upgradeId)) {
        libE0EAE146_gv_xmTestBenchCreated[lp_player] += 1;
        libE0EAE146_gf_XMDbgLog("INFO", "TEST_TECH_UPGRADE_PRESENT", "commander=" + lp_commander + " scenario=" + lp_scenarioKind + " upgrade=" + lp_upgradeId);
        return true;
    }
    libE0EAE146_gv_xmTestBenchMissing[lp_player] += 1;
    libE0EAE146_gf_XMTestBench_AddWarning(lp_player);
    libE0EAE146_gf_XMDbgLog("WARN", "TEST_TECH_UPGRADE_MISSING", "commander=" + lp_commander + " scenario=" + lp_scenarioKind + " upgrade=" + lp_upgradeId + " reason=catalog_entry_not_valid");
    return false;
}

void libE0EAE146_gf_XMTestBench_LogTechDone (int lp_player, string lp_commander, string lp_scenarioKind, int lp_expected) {
    libE0EAE146_gf_XMTestBench_SetLastEvent(lp_player, "TEST_TECH_" + lp_commander);
    libE0EAE146_gf_XMDbgLog("INFO", "TEST_COMMANDER_TECH_DONE", "commander=" + lp_commander + " scenario=" + lp_scenarioKind + " expected=" + IntToString(lp_expected) + " present=" + IntToString(libE0EAE146_gv_xmTestBenchCreated[lp_player]) + " missing=" + IntToString(libE0EAE146_gv_xmTestBenchMissing[lp_player]) + " mode=catalog_presence_only");
}

