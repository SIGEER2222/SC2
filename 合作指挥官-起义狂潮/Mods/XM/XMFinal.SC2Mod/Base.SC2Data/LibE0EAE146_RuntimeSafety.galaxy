// XMFinal split module: runtime initialization safety helpers.

void libE0EAE146_gf_SeedDefaultCommanderBankIfEmpty (string lp_defaultCommander) {
    if (lp_defaultCommander == "") {
        return;
    }

    BankLoad("CampaignXCore", 1);
    if (BankValueGetAsString(BankLastCreated(), "Ach", "Commander") == "") {
        BankValueSetFromString(BankLastCreated(), "Ach", "Commander", lp_defaultCommander);
        BankSave(BankLastCreated());
    }
}

void libE0EAE146_gf_RuntimeCheckpoint (string lp_phase) {
    BankLoad("CampaignXCore", 1);
    BankValueSetFromString(BankLastCreated(), "XMRuntimeDebug", "LastPhase", lp_phase);
    BankValueSetFromString(BankLastCreated(), "XMRuntimeDebug", "Commander", libE0EAE146_gv_commander);
    BankSave(BankLastCreated());
}

string libE0EAE146_gf_CatalogUnitOrEmpty (string lp_unitType) {
    if ((lp_unitType != "") && CatalogEntryIsValid(c_gameCatalogUnit, lp_unitType)) {
        return lp_unitType;
    }

    return "";
}

bool libE0EAE146_gf_IsAllowedConsoleSkin (string lp_consoleSkin) {
    if (lp_consoleSkin == "ConsoleTerran_Default") {
        return true;
    }
    if (lp_consoleSkin == "ConsoleZerg_Default") {
        return true;
    }
    if (lp_consoleSkin == "ConsoleZerg_Abathur") {
        return true;
    }
    if (lp_consoleSkin == "ConsoleZerg_Zagara") {
        return true;
    }
    if (lp_consoleSkin == "ConsoleProtoss_Forged") {
        return true;
    }
    if (lp_consoleSkin == "ConsoleProtoss_Default") {
        return true;
    }
    if (lp_consoleSkin == "ConsoleProtoss_Fenix") {
        return true;
    }
    if (lp_consoleSkin == "ConsoleProtoss_Ihanrii") {
        return true;
    }
    if (lp_consoleSkin == "ConsoleZerg_Classic") {
        return true;
    }
    if (lp_consoleSkin == "ConsoleZerg_Dehaka") {
        return true;
    }
    if (lp_consoleSkin == "ConsoleTerran_Classic") {
        return true;
    }
    if (lp_consoleSkin == "ConsoleTerran_Horner") {
        return true;
    }
    if (lp_consoleSkin == "ConsoleTerran_CovertOps") {
        return true;
    }
    if (lp_consoleSkin == "ConsoleTerran_Imperial") {
        return true;
    }
    if (lp_consoleSkin == "ConsoleTerran_Swann") {
        return true;
    }
    if (lp_consoleSkin == "ConsoleZerg_Mecha") {
        return true;
    }

    return false;
}

string libE0EAE146_gf_BankConsoleSkinOverride () {
    string lv_consoleSkin;

    if (!BankSectionExists(BankLastCreated(), "Cosmetics")) {
        return "";
    }
    if (!BankKeyExists(BankLastCreated(), "Cosmetics", "ConsoleSkin")) {
        return "";
    }

    lv_consoleSkin = BankValueGetAsString(BankLastCreated(), "Cosmetics", "ConsoleSkin");
    if ((lv_consoleSkin == "") || (lv_consoleSkin == "Auto")) {
        return "";
    }
    if (!libE0EAE146_gf_IsAllowedConsoleSkin(lv_consoleSkin)) {
        return "";
    }
    if (!CatalogEntryIsValid(c_gameCatalogConsoleSkin, lv_consoleSkin)) {
        return "";
    }

    return lv_consoleSkin;
}

void libE0EAE146_gf_ApplyConsoleSkinOverride (int lp_player) {
    string lv_consoleSkin;

    lv_consoleSkin = libE0EAE146_gf_BankConsoleSkinOverride();
    if (lv_consoleSkin != "") {
        lib67C0F0E7_gf_PlayerSetCommanderConsoleSkin(lp_player, lv_consoleSkin);
    }
}

string libE0EAE146_gf_CommanderOfficialPlayerCommanderInstance (string lp_commander) {
    if (lp_commander == "Raynor") {
        return "TerranRaynor";
    }
    if (lp_commander == "Swann") {
        return "TerranSwann";
    }
    if (lp_commander == "Nova") {
        return "TerranNova";
    }
    if ((lp_commander == "Mira") || (lp_commander == "Horner") || (lp_commander == "HanHorner") || (lp_commander == "HanAndHorner")) {
        return "TerranHorner";
    }
    if (lp_commander == "Tychus") {
        return "TerranTychus";
    }
    if (lp_commander == "Mengsk") {
        return "TerranMengsk";
    }
    if (lp_commander == "Kerrigan") {
        return "ZergKerrigan";
    }
    if (lp_commander == "Zagara") {
        return "ZergZagara";
    }
    if ((lp_commander == "Abathur") || (lp_commander == "AbathurCustom") || (lp_commander == "AbathurReborn")) {
        return "ZergAbathur";
    }
    if (lp_commander == "Stukov") {
        return "ZergStukov";
    }
    if (lp_commander == "Dehaka") {
        return "ZergDehaka";
    }
    if (lp_commander == "Stetmann") {
        return "ZergStetmann";
    }
    if (lp_commander == "Artanis") {
        return "ProtossArtanis";
    }
    if (lp_commander == "Karax") {
        return "ProtossKarax";
    }
    if (lp_commander == "Vorazun") {
        return "ProtossVorazun";
    }
    if (lp_commander == "Alarak") {
        return "ProtossAlarak";
    }
    if (lp_commander == "Fenix") {
        return "ProtossFenix";
    }
    if (lp_commander == "Zeratul") {
        return "ProtossZeratul";
    }

    return "";
}

string libE0EAE146_gf_CommanderDefaultSkin (string lp_commander) {
    string lv_instance;

    lv_instance = libE0EAE146_gf_CommanderOfficialPlayerCommanderInstance(lp_commander);
    if (lv_instance == "") {
        return "";
    }

    return UserDataGetGameLink("PlayerCommanders", lib67C0F0E7_gf_StrToUserinstance(lv_instance), "CommanderSkin", 1);
}

void libE0EAE146_gf_ApplyDefaultCommanderSkin (int lp_player, string lp_commander) {
    string lv_skin;

    lv_skin = libE0EAE146_gf_CommanderDefaultSkin(lp_commander);
    if ((lv_skin != "") && CatalogEntryIsValid(c_gameCatalogSkin, lv_skin)) {
        PlayerApplySkin(lp_player, lv_skin, true);
    }
}

string libE0EAE146_gf_CommanderAchUnit (string lp_field) {
    string lv_commander;
    string lv_unit;

    lv_commander = libE0EAE146_gv_commander;
    if (lv_commander == "") {
        lv_commander = BankValueGetAsString(BankLastCreated(), "Ach", "Commander");
    }

    // Generic XMCore opener slots can win in some runtime paths, so private openers must win before UserData lookup.
    if ((lv_commander == "Abathur") || (libE0EAE146_gv_commander == "Abathur")) {
        if (lp_field == "CommandCenter") {
            lv_unit = libE0EAE146_gf_CatalogUnitOrEmpty("HatcheryAbathur");
            if (lv_unit != "") {
                return lv_unit;
            }
        }
        if (lp_field == "Worker") {
            lv_unit = libE0EAE146_gf_CatalogUnitOrEmpty("DroneAbathur");
            if (lv_unit != "") {
                return lv_unit;
            }
        }
        if (lp_field == "SecondUnit") {
            lv_unit = libE0EAE146_gf_CatalogUnitOrEmpty("OverlordAbathur");
            if (lv_unit != "") {
                return lv_unit;
            }
        }
    }

    if (lv_commander == "Zagara") {
        if (lp_field == "CommandCenter") {
            lv_unit = libE0EAE146_gf_CatalogUnitOrEmpty("HatcheryZagara");
            if (lv_unit != "") {
                return lv_unit;
            }
        }
        if (lp_field == "Worker") {
            lv_unit = libE0EAE146_gf_CatalogUnitOrEmpty("DroneZagara");
            if (lv_unit != "") {
                return lv_unit;
            }
        }
        if (lp_field == "SecondUnit") {
            lv_unit = libE0EAE146_gf_CatalogUnitOrEmpty("OverlordZagara");
            if (lv_unit != "") {
                return lv_unit;
            }
        }
    }

    if (lv_commander == "Kerrigan") {
        if (lp_field == "CommandCenter") {
            lv_unit = libE0EAE146_gf_CatalogUnitOrEmpty("HatcheryKerrigan");
            if (lv_unit != "") {
                return lv_unit;
            }
        }
        if (lp_field == "Worker") {
            lv_unit = libE0EAE146_gf_CatalogUnitOrEmpty("DroneKerrigan");
            if (lv_unit != "") {
                return lv_unit;
            }
        }
        if (lp_field == "SecondUnit") {
            lv_unit = libE0EAE146_gf_CatalogUnitOrEmpty("OverlordKerrigan");
            if (lv_unit != "") {
                return lv_unit;
            }
        }
    }

    if (lv_commander == "AbathurReborn") {
        if (lp_field == "CommandCenter") {
            return "HatcheryAbathurReborn";
        }
        if (lp_field == "Worker") {
            return "DroneAbathurReborn";
        }
        if (lp_field == "SecondUnit") {
            return "OverlordAbathurReborn";
        }
    }

    lv_unit = UserDataGetUnit("CommanderAch", lib67C0F0E7_gf_StrToUserinstance(lv_commander), lp_field, 1);
    if (lv_unit != "") {
        return lv_unit;
    }

    return lv_unit;
}
