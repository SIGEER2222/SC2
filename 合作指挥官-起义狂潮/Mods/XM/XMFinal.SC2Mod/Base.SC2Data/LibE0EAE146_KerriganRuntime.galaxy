unit libE0EAE146_gf_KerriganHeroForPlayer (int lp_player) {
    unit lv_hero;

    if ((lp_player < 0) || (lp_player > 16)) {
        return null;
    }

    lv_hero = libE0EAE146_gv_kerriganHero[lp_player];
    if (UnitIsValid(lv_hero) == true) {
        return lv_hero;
    }

    lv_hero = libE0EAE146_gf_FindFirstPlayerUnitOfType(lp_player, "K5Kerrigan");
    if (UnitIsValid(lv_hero) == true) {
        libE0EAE146_gv_kerriganHero[lp_player] = lv_hero;
        return lv_hero;
    }

    lv_hero = libE0EAE146_gf_FindFirstPlayerUnitOfType(lp_player, "K5KerriganBurrowed");
    if (UnitIsValid(lv_hero) == true) {
        libE0EAE146_gv_kerriganHero[lp_player] = lv_hero;
        return lv_hero;
    }

    return null;
}

string libE0EAE146_gf_KerriganEconDropResourceUnit (unit lp_deadUnit) {
    int lv_food;

    if (lp_deadUnit == null) {
        return "";
    }
    if (UnitHasBehavior2(lp_deadUnit, "SupplyLT1") == true) {
        return "KerriganVoidCoopEconDropLT1";
    }
    if (UnitHasBehavior2(lp_deadUnit, "HybridUnitDummy") == true) {
        return "KerriganVoidCoopEconDrop4";
    }

    lv_food = CatalogFieldValueGetAsInt(c_gameCatalogUnit, UnitGetType(lp_deadUnit), "Food", 0);
    if (lv_food == -1) {
        return "KerriganVoidCoopEconDrop1";
    }
    if (lv_food == -2) {
        return "KerriganVoidCoopEconDrop2";
    }
    if (lv_food == -3) {
        return "KerriganVoidCoopEconDrop3";
    }
    if (lv_food == -4) {
        return "KerriganVoidCoopEconDrop4";
    }
    if (lv_food < -4) {
        return "KerriganVoidCoopEconDrop5";
    }

    return "";
}

bool libE0EAE146_gt_KerriganEconDrop_Func (bool testConds, bool runActions) {
    point lv_position;
    string lv_resource;
    int lv_killer;
    unit lv_deadUnit;

    lv_deadUnit = EventUnit();
    lv_killer = libNtve_gf_KillingPlayer();

    if (testConds) {
        if (libE0EAE146_gv_kerriganEconDropEnabled == false) {
            return false;
        }
        if (lv_deadUnit == null) {
            return false;
        }
        if (UnitHasBehavior2(lv_deadUnit, "KerriganVoidCoopEconDrop") == false) {
            return false;
        }
        if (!((lv_killer >= 0) && (lv_killer <= 15))) {
            return false;
        }
        if (lv_killer != libE0EAE146_gv_kerriganEconDropPlayer) {
            return false;
        }
    }

    if (!runActions) {
        return true;
    }

    lv_resource = libE0EAE146_gf_KerriganEconDropResourceUnit(lv_deadUnit);
    if ((lv_resource == "") || (!CatalogEntryIsValid(c_gameCatalogUnit, lv_resource))) {
        return true;
    }

    lv_position = UnitGetPosition(lv_deadUnit);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, lv_resource, 0, libE0EAE146_gv_kerriganEconDropPlayer, lv_position);
    return true;
}

void libE0EAE146_gt_KerriganEconDrop_Init () {
    if (libE0EAE146_gv_kerriganEconDropTriggersReady == true) {
