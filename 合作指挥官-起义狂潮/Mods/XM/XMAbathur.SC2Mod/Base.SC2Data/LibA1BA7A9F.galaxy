include "TriggerLibs/NativeLib"
include "Lib67C0F0E7"

include "LibA1BA7A9F_h"

void libA1BA7A9F_InitLibraries () {
    libNtve_InitVariables();
    lib67C0F0E7_InitVariables();
}

bool libA1BA7A9F_InitVariables_completed = false;
int libA1BA7A9F_gv_abathurPlayer;

void libA1BA7A9F_InitVariables () {
    if (libA1BA7A9F_InitVariables_completed) {
        return;
    }
    libA1BA7A9F_InitVariables_completed = true;
    libA1BA7A9F_gv_abathurPlayer = 1;
}

void libA1BA7A9F_gf_InitializeAbathurEvent (int lp_player) {
    libA1BA7A9F_gv_abathurPlayer = lp_player;
}

bool libA1BA7A9F_gf_AbathurCanDropBiomass (unit lp_unit) {
    if ((lp_unit == null)) {
        return false;
    }
    if ((EventUnitDamageDeathCheck(c_deathTypeRemove) == true)) {
        return false;
    }
    if ((libNtve_gf_PlayerIsEnemy(EventPlayer(), libA1BA7A9F_gv_abathurPlayer, libNtve_ge_PlayerRelation_Enemy) == false)) {
        return false;
    }
    if ((UnitTypeGetCost(UnitGetType(lp_unit), c_unitCostMinerals) <= 0)) {
        return false;
    }
    if ((UnitTypeTestAttribute(UnitGetType(lp_unit), c_unitAttributeStructure) == true)) {
        return false;
    }
    if ((UnitTypeTestAttribute(UnitGetType(lp_unit), c_unitAttributeSummoned) == true)) {
        return false;
    }
    if ((UnitHasBehavior2(lp_unit, "NoBiomassDrop") == true)) {
        return false;
    }
    return true;
}

fixed libA1BA7A9F_gf_AbathurBiomassAmount (unit lp_unit) {
    fixed lv_amount;
    lv_amount = UnitGetPropertyInt(lp_unit, c_unitPropSuppliesUsed, c_unitPropNormal);
    if ((UnitTypeTestAttribute(UnitGetType(lp_unit), c_unitAttributeHeroic) == true)) {
        lv_amount = 12.0;
    }
    else {
        lv_amount *= 2.0;
        if ((lv_amount < 1.0)) {
            lv_amount = 1.0;
        }
        if ((lv_amount > 12.0)) {
            lv_amount = 12.0;
        }
    }
    return lv_amount;
}

bool libA1BA7A9F_gt_AbathurBiomassDrop_Func (bool testConds, bool runActions) {
    fixed lv_amount;
    unit lv_dead;
    lv_dead = EventUnit();
    if (testConds) {
        if ((libA1BA7A9F_gf_AbathurCanDropBiomass(lv_dead) == false)) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    lv_amount = libA1BA7A9F_gf_AbathurBiomassAmount(lv_dead);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "BiomassPickup", 0, libA1BA7A9F_gv_abathurPlayer, UnitGetPosition(lv_dead));
    UnitSetCustomValue(UnitLastCreated(), 63, lv_amount);
    return true;
}

void libA1BA7A9F_gt_AbathurBiomassDrop_Init () {
    libA1BA7A9F_gt_AbathurBiomassDrop = TriggerCreate("libA1BA7A9F_gt_AbathurBiomassDrop_Func");
    TriggerEnable(libA1BA7A9F_gt_AbathurBiomassDrop, false);
    TriggerAddEventUnitDied(libA1BA7A9F_gt_AbathurBiomassDrop, null);
}

bool libA1BA7A9F_gt_AbathurBiomassPickup_Func (bool testConds, bool runActions) {
    unitgroup lv_pickups;
    unitgroup lv_units;
    unit lv_unit;
    unit lv_pickup;
    int lv_i;
    int lv_j;
    fixed lv_amount;
    if (!runActions) {
        return true;
    }
    lv_pickups = UnitGroup("BiomassPickup", libA1BA7A9F_gv_abathurPlayer, RegionPlayableMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_i = UnitGroupCount(lv_pickups, c_unitCountAlive);
    for (;; lv_i -= 1) {
        lv_pickup = UnitGroupUnitFromEnd(lv_pickups, lv_i);
        if (lv_pickup == null) { break; }
        lv_amount = UnitGetCustomValue(lv_pickup, 63);
        lv_units = UnitGroup(null, libA1BA7A9F_gv_abathurPlayer, RegionCircle(UnitGetPosition(lv_pickup), 2.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_j = UnitGroupCount(lv_units, c_unitCountAlive);
        for (;; lv_j -= 1) {
            lv_unit = UnitGroupUnitFromEnd(lv_units, lv_j);
            if (lv_unit == null) { break; }
            if ((UnitTypeTestAttribute(UnitGetType(lv_unit), c_unitAttributeStructure) == false)) {
                UnitCreateEffectUnit(lv_pickup, "AbathurCollectBiomass", lv_unit);
                lib67C0F0E7_gf_UnitAddCustomValue(lv_unit, 62, lv_amount);
                UnitKill(lv_pickup);
                break;
            }
        }
    }
    return true;
}

void libA1BA7A9F_gt_AbathurBiomassPickup_Init () {
    libA1BA7A9F_gt_AbathurBiomassPickup = TriggerCreate("libA1BA7A9F_gt_AbathurBiomassPickup_Func");
    TriggerEnable(libA1BA7A9F_gt_AbathurBiomassPickup, false);
    TriggerAddEventTimePeriodic(libA1BA7A9F_gt_AbathurBiomassPickup, 0.5, c_timeGame);
}

void libA1BA7A9F_InitTriggers () {
    libA1BA7A9F_gt_AbathurBiomassDrop_Init();
    libA1BA7A9F_gt_AbathurBiomassPickup_Init();
}

//--------------------------------------------------------------------------------------------------
// Library Initialization
//--------------------------------------------------------------------------------------------------
bool libA1BA7A9F_InitLib_completed = false;

void libA1BA7A9F_InitLib () {
    if (libA1BA7A9F_InitLib_completed) {
        return;
    }

    libA1BA7A9F_InitLib_completed = true;

    libA1BA7A9F_InitLibraries();
    libA1BA7A9F_InitVariables();
    libA1BA7A9F_InitTriggers();
}
