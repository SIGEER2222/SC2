void libAB231903_gf_DefilerInfAI (int lp_owner, unit lp_hunter, unitgroup lp_nearbyUnits) {
    // Variable Declarations
    aifilter lv_targetFilter2;
    aifilter lv_targetFilter3;
    unitgroup lv_uG;
    point lv_p;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_targetFilter2 = AIFilter(lp_owner);
    lv_targetFilter3 = AIFilter(lp_owner);
    lv_uG = UnitGroupEmpty();

    // Implementation
    if (((UnitGroupCount(lp_nearbyUnits, c_unitCountAlive) == 0))) {
        return ;
    }

    if ((UnitGetPropertyInt(lp_hunter, c_unitPropEnergy, c_unitPropCurrent) < 100) && (UnitAbilityGetCooldown(lp_hunter, "ConsumptionInf", "Abil/ConsumptionInf") == 0.0)) {
        lv_uG = UnitGroup(null, lp_owner, RegionCircle(UnitGetPosition(lp_hunter), 4.0), UnitFilter((1 << c_targetFilterBiological) | (1 << c_targetFilterVisible), 0, (1 << c_targetFilterSelf) | (1 << c_targetFilterMissile), (1 << (c_targetFilterStasis - 32)) | (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))), 0);
        AISetFilterLife(lv_targetFilter3, 40.0, 524287.0);
        lv_uG = AIGetFilterGroup(lv_targetFilter3, lv_uG);
        if ((UnitGroupCount(lv_uG, c_unitCountAlive) > 0)) {
            libNtve_gf_AICast(lp_hunter, OrderTargetingUnit(AbilityCommand("ConsumptionInf", 0), UnitGroupRandomUnit(lv_uG, c_unitCountAlive)));
            return ;
        }

    }

    AISetFilterRange(lv_targetFilter2, lp_hunter, 8.0);
    lv_uG = AIGetFilterGroup(lv_targetFilter2, lp_nearbyUnits);
    if ((UnitGetPropertyInt(lp_hunter, c_unitPropEnergy, c_unitPropCurrent) >= 150)) {
        if ((UnitGroupCount(lv_uG, c_unitCountAlive) > 4)) {
            lv_p = AIBestTargetPoint(UnitGroupFilterAlliance(lv_uG, lp_owner, c_unitAllianceEnemy, 0), 1, 50, 1.0, 1.5, UnitGetPosition(lp_hunter), 8.0, c_unitAttributeNone);
            if ((lv_p != null)) {
                libNtve_gf_AICast(lp_hunter, OrderTargetingPoint(AbilityCommand("PlagueInf", 0), lv_p));
                return ;
            }

        }

    }

    if ((UnitGetPropertyInt(lp_hunter, c_unitPropEnergy, c_unitPropCurrent) >= 100) && (UnitHasBehavior2(lp_hunter, "DarkSwarmInf") == false)) {
        if ((UnitGroupCount(lv_uG, c_unitCountAlive) > 3)) {
            libNtve_gf_AICast(lp_hunter, OrderTargetingPoint(AbilityCommand("DarkSwarmInf", 0), UnitGetPosition(lp_hunter)));
            return ;
        }

    }

}

