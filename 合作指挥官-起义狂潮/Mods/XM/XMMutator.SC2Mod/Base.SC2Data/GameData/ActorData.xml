<?xml version="1.0" encoding="utf-8"?>
<Catalog>
    <CActorModel id="ConsumptionImpactInf" parent="ModelAnimationStyleOneShot">
        <Inherits index="BaseModelScale" value="1"/>
        <Inherits index="CloakEffect" value="1"/>
        <Inherits index="Scale" value="1"/>
        <Inherits index="Visibility" value="1"/>
        <On Terms="Effect.ConsumptionInf.Start; At Target" Send="Create"/>
        <Host Subject="_Selectable"/>
        <HostSiteOps Ops="SOpAttachCenter"/>
        <Model value="ViperConsume"/>
    </CActorModel>
    <CActorModel id="ConsumptionHealImpactInf" parent="ModelAnimationStyleOneShot">
        <On Terms="Effect.ConsumptionInf.Start; At Caster" Send="Create"/>
        <Host Subject="_Selectable"/>
        <HostSiteOps Ops="SOpAttachCenter"/>
        <Model value="ConsumptionImpact"/>
    </CActorModel>
    <CActorRange id="ConsumptionRangeInf" parent="RangeAbil" abil="ConsumptionInf"/>
    <CActorSound id="MutatorTornadoActorSound" parent="SoundContinuous">
        <Sound value="Mutator_Tornado_Base_Loop"/>
        <Layers Sound="Mutator_Tornado_Spirit_OneShots_Lp"/>
        <Layers Sound="Mutator_Tornado_Wind_OneShots_Lp"/>
    </CActorSound>
    <CActorUnit id="MutatorTornado" parent="GenericUnitStandard" unitName="MutatorTornado">
        <Aliases value="_NoGlaze"/>
        <EditorCategories value=""/>
        <On Terms="ActorCreation" Send="Create MutatorTornadoActorSound"/>
        <On Terms="ActorCreation" Send="Create MutatorTornadoWarningSplat"/>
        <UnitFlags index="SuppressDefaultStatusBar" value="1"/>
        <MinimapIcon value="Assets\Textures\ui_minimap_icon_cashobjective.dds"/>
        <MinimapIconScale value="0.800000"/>
    </CActorUnit>
    <CActorModel id="MutatorTornadoWarningSplat">
        <On Terms="ActorCreation" Send="$Stand PlayForever,NonLooping"/>
        <On Terms="ActorCreation" Send="SetTintColor {255,255,255 5.000000}"/>
        <On Terms="ActorOrphan" Send="Destroy"/>
        <!--HoldTime value="-1.000000"/>
        <FadeOut value="0.000000"/-->
        <HostSiteOps Ops="SOpShadow"/>
        <Inherits index="Visibility" value="1"/>
        <Host Subject="_Unit"/>
    </CActorModel>
    <CActorUnit id="MutatorVoidReanimator" parent="GenericUnitStandard" unitName="MutatorVoidReanimator">
        <ModelFlags index="OutlineEmitter" value="1"/>
        <DeathArray index="Normal" ModelLink="ProtossSpiritDeath" SoundLink="HighTemplar_Death"/>
        <DeathActorModel value="UnitDeathModelWithDeathMotionGround"/>
        <On Terms="Abil.MutatorReanimateSlow.SourceCastStart" Send="AnimBracketStart Work Stand,Work,Start Stand,Work"/>
        <On Terms="Abil.MutatorReanimateSlow.SourceCastStop" Send="AnimBracketStop Work"/>
        <On Terms="Abil.MutatorReanimateStandard.SourceCastStart" Send="AnimBracketStart Work Stand,Work,Start Stand,Work"/>
        <On Terms="Abil.MutatorReanimateStandard.SourceCastStop" Send="AnimBracketStop Work"/>
        <On Terms="Abil.MutatorReanimateFast.SourceCastStart" Send="AnimBracketStart Work Stand,Work,Start Stand,Work"/>
        <On Terms="Abil.MutatorReanimateFast.SourceCastStop" Send="AnimBracketStop Work"/>
        <HeroIcon value="Assets\Textures\btn-unit-protoss-mutator-reanimator.dds"/>
        <UnitIcon value="Assets\Textures\btn-unit-protoss-mutator-reanimator.dds"/>
        <Wireframe>
            <Image value="Assets\Textures\wireframe-protoss-reanimator-mutator.dds"/>
        </Wireframe>
        <WireframeShield>
            <Image value="Assets\Textures\wireframe-protoss-reanimator-mutator-shield00.dds"/>
            <Image value="Assets\Textures\wireframe-protoss-reanimator-mutator-shield01.dds"/>
            <Image value="Assets\Textures\wireframe-protoss-reanimator-mutator-shield02.dds"/>
        </WireframeShield>
        <Model value="Mutator_Void_Reanimator"/>
        <BuildModel value="Mutator_Void_Reanimator"/>
        <PlacementModel value="Mutator_Void_Reanimator"/>
        <LifeArmorIcon value="Assets\Textures\btn-upgrade-protoss-groundarmorlevel0.dds"/>
    </CActorUnit>
    <CActorUnit id="MutatorPurifierBeam" parent="GenericUnitStandard" unitName="MutatorPurifierBeam">
        <EditorCategories value=""/>
        <Baselines index="Walk" AnimProps="Stand"/>
        <UnitFlags index="SuppressDefaultStatusBar" value="1"/>
        <MinimapIconScale value="0.000000"/>
        <UnitIcon value="Assets\Textures\wireframe-protoss-purifierbeam.dds"/>
    </CActorUnit>
    <CActorSound id="MutatorPurifierBeamFiringLoopSound" parent="SoundContinuous">
        <On Terms="Behavior.MutatorPurifierBeamAOE.On" Send="Create"/>
        <On Terms="Behavior.MutatorPurifierBeamAOE" Send="ModelMaterialMaximizePriority"/>
        <On Terms="Behavior.MutatorPurifierBeamAOE.Off" Send="Destroy"/>
        <Sound value="SOAPurifierBeamFiring_Loop"/>
        <Layers Sound="SOAPurifierBeam_Quake_Layer"/>
    </CActorSound>
    <CActorAction id="VoidRiftTrainMalash" parent="GenericAttack" effectImpact="VoidRiftTrainPrecursorRBMalash" effectLaunch="VoidRiftTrainLMMalash">
        <LaunchSiteOps Ops="SOpAttachOrigin SOpMoveDownBy1"/>
        <LaunchAssets Model="" Sound="Hybrid_PlasmaBlastLaunch"/>
        <Missile value="VoidRiftTrainMissile"/>
        <ImpactSiteOps Ops="SOpAttachCenter"/>
        <ShieldFlashType value="None"/>
    </CActorAction>
    <CActorModel id="VoidRiftTrainBirthMalash" parent="ModelAnimationStyleOneShot">
        <On Terms="ActorCreation" Send="SetTintColor {255,255,255 2.000000}"/>
        <On Terms="ActorCreation" Send="Create VoidRiftTrainBirthSound"/>
        <On Terms="ActorCreation" Target="_Selectable" Send="SetOpacity"/>
        <On Terms="ActorCreation" Target="_Selectable" Send="SetOpacity 1.000000 0.500000"/>
        <On Terms="Effect.VoidRiftTrainPrecursorRBMalash.Start; At Target" Send="Create"/>
        <Host Subject="_Selectable"/>
        <HostSiteOps Ops="SOpAttachCenter"/>
        <Model value="VoidRiftTrainBirth"/>
        <AutoScaleFactor value="1.000000"/>
    </CActorModel>
    <CActorUnit id="VoidRiftUnselectableMalash" parent="ProtossBuilding" unitName="VoidRiftUnselectableMalash">
        <On Terms="UnitConstruction.VoidRiftUnselectableMalash.Start" Send="SetOpacity"/>
        <On Terms="UnitConstruction.VoidRiftUnselectableMalash.Start" Send="Create VoidRiftUnselectableConstructionModel"/>
        <On Terms="UnitBirth" Target="VoidRiftUnselectableConstructionModel" Send="SetOpacity 0.000000 1.000000"/>
        <On Terms="UnitBirth" Send="SetOpacity 1.000000 1.000000"/>
        <On Terms="UnitBirth" Send="Create VoidRiftSoundLoop"/>
        <On Terms="UnitBirth" Send="Create VoidRiftConstructionSoundLoop"/>
        <On Terms="AbilTrain.VoidRiftTrain.Cancel" Send="StatusDecrement Building"/>
        <On Terms="AbilTrain.VoidRiftTrain.Finish" Send="StatusDecrement Building"/>
        <On Terms="AbilTrain.VoidRiftTrain.Start" Send="StatusIncrement Building"/>
        <On Terms="Signal.*.TrainOn" Send="StatusIncrement Building"/>
        <On Terms="Signal.*.TrainOff" Send="StatusDecrement Building"/>
        <On Terms="Effect.VoidRiftTrainLM.Start; At Caster" Send="AnimPlay Build Build"/>
        <On Terms="Effect.VoidRiftTrainLM.Start; At Caster" Send="AnimSetTime Build 2.500000"/>
        <Model value="VoidRiftUnselectable"/>
        <CreepHeightClass value="Small"/>
        <BuildModel value="VoidRiftUnselectable"/>
        <DeathArray index="Normal" ModelLink="VoidRiftUnselectableDeath"/>
        <PlacementModel value="PylonPlacement"/>
        <PlacementSound value="Protoss_BuildingPlacementSmall"/>
        <PortraitModel value="ExecutorPortrait"/>
        <BarOffset value="140"/>
        <BarWidth value="160"/>
        <HighlightTooltip value=""/>
        <LifeArmorIcon value="Assets\Textures\btn-armor-protoss-buildingplating.dds"/>
        <NameOffset value="130"/>
        <SnapshotActor value="SnapshotAnimating"/>
        <StatusBarFlags index="Life" value="0"/>
        <UnitFlags index="ShowBlobShadow" value="0"/>
        <Wireframe>
            <Image value="Assets\Textures\wireframe-protoss-voidrift.dds"/>
        </Wireframe>
    </CActorUnit>
</Catalog>
