<?xml version="1.0" encoding="utf-8"?>
<Catalog>
    <CActorModel default="1" id="PlacementModelMultiple">
        <Aliases value="_Main"/>
        <Aliases value="_Unit"/>
        <Aliases value="_Selectable"/>
        <Filter index="Neutral" value="1"/>
        <Filter index="Enemy" value="1"/>
        <FogVisibility value="Visible"/>
        <On Terms="ActorCreation" Send="SetOpacity 0.750000"/>
        <On Terms="ActorCreation" Send="AnimGroupApply Placement"/>
        <On Terms="ActorCreation" Send="$Stand PlayForever"/>
        <On Terms="ActorOrphan" Send="Destroy"/>
        <On Terms="Signal.*.HidePlacement" Send="SetVisibility"/>
        <On Terms="Signal.*.ShowPlacement" Send="SetVisibility 1"/>
        <HostSiteOps Ops="SOpTipabilityFloorScope"/>
        <Model value="PlacementModelMultiple"/>
    </CActorModel>
    <CActorEventMacro id="AutoHarvestVespene">
        <EditorCategories value=""/>
        <On Terms="Effect.AutoHarvestVespene4.Start" Send="Create AutomatedAssimilatorTextKicker4"/>
        <On Terms="Effect.AutoHarvestVespene6.Start" Send="Create AutomatedAssimilatorTextKicker6"/>
    </CActorEventMacro>
    <CActorModel id="SensorTowerPlacement">
        <Aliases value="_Main"/>
        <Aliases value="_Unit"/>
        <Aliases value="_Selectable"/>
        <Filter index="Neutral" value="1"/>
        <Filter index="Enemy" value="1"/>
        <FogVisibility value="Visible"/>
        <On Terms="ActorCreation; ModelIsLowQuality" Send="SetOpacity 0.300000"/>
        <On Terms="ActorCreation" Send="AnimGroupApply Placement"/>
        <On Terms="ActorCreation" Send="$Stand PlayForever"/>
        <On Terms="ActorOrphan" Send="Destroy"/>
        <On Terms="Signal.*.HidePlacement" Send="SetVisibility"/>
        <On Terms="Signal.*.ShowPlacement" Send="SetVisibility 1"/>
        <On Terms="ActorCreation; ModelName Bunker; ValidatePlayer HasShrikeTurret" Send="Create ShrikePlacement"/>
        <HostSiteOps Ops="SOpTipabilityFloorScope"/>
        <Model value="SensorTower"/>
    </CActorModel>
    <CActorModelMaterial id="GlazeShadowG" parent="GlazeParent">
        <On Terms="Effect.GlazeShadowStart.Start; At Target" Send="Create"/>
        <On Terms="ActorCreation" Send="ModelMaterialApplyTo _Unit"/>
        <On Terms="Effect.GlazeShadowStop.Start" Send="AnimBracketStop BSD"/>
        <Model value="GlazeShadow"/>
        <ModelFlags index="AutomateGlobalLoops" value="1"/>
    </CActorModelMaterial>
    <CActorBeamSimple id="SOAStickyUnitBeam" parent="BeamSimpleAnimationStyleContinuous">
        <Aliases value="_Doodad"/>
        <EditorCategories value=""/>
        <Model value="WarpConBeam"/>
        <Scale value="3.000000"/>
        <HostLaunch Subject="_Unit" Scope="Caster" Actor="Find"/>
        <HostLaunchSiteOps Ops="SOpAttachCenter"/>
        <HostImpact Subject="_Unit" Scope="Target" Actor="Find"/>
        <HostImpactSiteOps Ops="SOpAttachCenter"/>
        <Terms value="Cap 1"/>
        <On Terms="SupporterDestruction" Send="AnimBracketStop BSD"/>
        <On Terms="Effect.SOAStickyUnitSet.Start; At Target" Send="Create"/>
        <On Terms="Behavior.SOAStickyUnit.Off" Send="AnimBracketStop BSD"/>
    </CActorBeamSimple>
    <CActorModel id="PWarpInG" parent="ModelAnimationStyleOneShot">
        <On Terms="Behavior.PWarpInG.On" Send="Create"/>
        <Host Subject="_Selectable"/>
        <HostSiteOps Ops="SOpShadow"/>
        <Model value="ArbiterMPRecalledImpact"/>
        <AutoScaleFactor value="0.450000"/>
    </CActorModel>
    <CActorModel id="TDropPodModelG" parent="ModelAnimationStyleOneShotNoOrphan">
        <On Terms="AnimBracketState.*.AfterOpening; AnimName BSD" Send="Create DropPodUnload"/>
        <On Terms="ActorCreation" Send="Create TDropPodSoundG"/>
        <On Terms="ActorCreation" Send="TimerSet 4.000000 Drop"/>
        <On Terms="TimerExpired; TimerName Drop" Send="AnimBracketStop BSD"/>
        <On Terms="Effect.TDropPodModelG.Start" Send="Create"/>
        <HostSiteOps Ops="MercDropSOpShadow"/>
        <Model value="DropPodFalling"/>
    </CActorModel>
    <CActorText id="VespeneDronePickupText" parent="PickupTextDefault">
        <EditorCategories value=""/>
    </CActorText>
    <CActorModel id="ZDropPodModelG" parent="ModelAnimationStyleOneShotNoOrphan">
        <On Terms="ActorCreation" Send="Create ZergDropPod_Drop"/>
        <On Terms="ActorCreation" Send="TimerSet 2.600000 DelayDropPod"/>
        <On Terms="TimerExpired; TimerName DelayDropPod" Send="Create ZergDropPodImpact"/>
        <On Terms="AnimDone; AnimName Birth" Send="AnimSetCompletion Stand"/>
        <On Terms="Effect.ZDropPodModelG.Start" Send="Create"/>
        <HostSiteOps Ops="MercDropSOpShadow"/>
        <Model value="ZergDropPod"/>
    </CActorModel>
    <CActorSound id="TDropPodSoundG" parent="SoundOneShot">
        <On Terms="ActorCreation" Send="TimerSet 2.100000 DelayDropPod"/>
        <On Terms="TimerExpired; TimerName DelayDropPod" Send="Create BarracksDropPodUnload"/>
        <On Terms="TimerExpired; TimerName DelayDropPod" Send="Destroy"/>
        <Sound value="Barracks_DropPodFall"/>
    </CActorSound>
    <CActorSplat id="SOAPointCursorSplat" parent="ProtossCursorSplat" abil="SOAPointPre">
        <On Terms="Abil.SOAPointFin.Cursor" Send="Create"/>
    </CActorSplat>
    <CActorSimple id="SOAPointOpacity">
        <On Terms="Behavior.SOAPointPre.On" Send="Create"/>
        <On Terms="ActorCreation" Target="_Unit" Send="SetOpacity 0.000000 0.500000 MassRecallOpacity"/>
        <On Terms="ActorCreation" Target="_Unit" Send="SetTintColor 100,100,255 0.500000 OneShot MassRecallTint"/>
        <On Terms="Behavior.SOAPointFin.Off" Send="TimerSet 0.200000 ClearRecallOpacity"/>
        <On Terms="TimerExpired; TimerName ClearRecallOpacity" Target="_Unit" Send="ClearOpacity 0.500000 MassRecallOpacity"/>
        <On Terms="TimerExpired; TimerName ClearRecallOpacity" Target="_Unit" Send="ClearTintColor 0.500000 MassRecallTint"/>
        <On Terms="TimerExpired; TimerName ClearRecallOpacity" Send="Destroy"/>
    </CActorSimple>
    <CActorModel id="SOAPointFinImpact" parent="ModelAnimationStyleOneShot">
        <Terms value="Cap 1"/>
        <On Terms="Behavior.SOAPointFin.On" Send="Create"/>
        <Host Subject="_Selectable"/>
        <HostSiteOps Ops="SOpShadow"/>
        <Model value="ArbiterMPRecalledImpact"/>
        <AutoScaleFactor value="0.450000"/>
    </CActorModel>
    <CActorSound id="SOAPointFinImpactSound" parent="SoundOneShot">
        <Terms value="Cap 1"/>
        <On Terms="Behavior.SOAPointFin.On" Send="Create"/>
        <Host Subject="_Selectable"/>
        <Sound value="ArbiterMP_RecallEnd"/>
    </CActorSound>
    <CActorModel id="SOAPointPreImpact" parent="ModelAnimationStyleOneShot">
        <Terms value="Cap 1"/>
        <On Terms="Behavior.SOAPointPre.On" Send="Create"/>
        <Host Subject="_Selectable"/>
        <HostSiteOps Ops="SOpShadow"/>
        <Model value="ArbiterMPRecallingImpact"/>
        <AutoScaleFactor value="0.450000"/>
    </CActorModel>
    <CActorSound id="SOAPointPreImpactSound" parent="SoundOneShot">
        <Terms value="Cap 1"/>
        <On Terms="Behavior.SOAPointPre.On" Send="Create"/>
        <Host Subject="_Selectable"/>
        <Sound value="ArbiterMP_RecallStart"/>
    </CActorSound>
    <CActorUnit id="SOAPointCaster" parent="GenericUnitBase" unitName="SOAPointCaster">
        <On Terms="Signal.*.GuideOn" Send="Create SOAThermalLanceTargetingGuide"/>
        <On Terms="Effect.SOAThermalLanceCP.Start" Target="SOAThermalLanceTargetingGuide" Send="Destroy"/>
        <Model value="Invisible"/>
    </CActorUnit>
    <CActorSiteOpLocalOffset id="SOpMoveBackBy5">
        <LocalOffset value="0.000000,5.000000,0.000000"/>
    </CActorSiteOpLocalOffset>
    <CActorMissile id="ArchangelAAAttackMissile" parent="GenericAttackMissile" unitName="ArchangelAA">
        <Model value="ArchangelAAWeapon"/>
    </CActorMissile>
    <CActorMissile id="ArchAngelAttackMissile">
        <Aliases value="_Unit"/>
        <Aliases value="_Missile"/>
        <On Terms="UnitBirth.ArchAngelWeapon" Send="Create"/>
        <On Terms="UnitBirth" Send="$Birth PlayForever,NonLooping"/>
        <On Terms="MotionPhaseStart; MotionPhase 2" Send="AnimClear Birth"/>
        <On Terms="MotionPhaseStart; MotionPhase 2" Send="AnimPlay Turbo Turbo PlayForever"/>
        <On Terms="MotionPhaseStart; MotionPhase 3" Send="AnimClear Turbo"/>
        <On Terms="MotionPhaseStart; MotionPhase 3" Send="$Stand PlayForever"/>
        <On Terms="UnitDeath" Send="Destroy"/>
        <On Terms="ActorOrphan" Send="Destroy"/>
        <Model value="VikingFighterWeapon"/>
        <Scale value="1.500000"/>
        <PreHost value="_ActorAction"/>
    </CActorMissile>
    <CActorText id="AutomatedAssimilatorTextKicker6">
        <On Terms="ActorCreation" Send="TimerSet 0.100000 StartMover"/>
        <On Terms="ActorCreation" Send="TimerSet 2.000000 Die"/>
        <On Terms="ActorCreation" Send="SetOpacity 0.000000 2.000000"/>
        <On Terms="TimerExpired; TimerName StartMover" Send="Create AutomatedAssimilatorTextMover"/>
        <On Terms="TimerExpired; TimerName Die" Send="Destroy"/>
        <Host Subject="_Unit"/>
        <FixedSize value="28"/>
        <AlignV value="Bottom"/>
        <HeightOffset value="3.500000"/>
        <Text value="Button/Tooltip/AutomatedAssimilatorTextKicker6"/>
    </CActorText>
</Catalog>
