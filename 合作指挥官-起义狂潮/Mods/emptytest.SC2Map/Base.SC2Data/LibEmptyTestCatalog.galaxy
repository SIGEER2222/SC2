    gv_EmptyTestUnits[3355] = "WarpGate";
    gv_EmptyTestUnits[3356] = "WarpPrism";
    gv_EmptyTestUnits[3357] = "WarpPrismPhasing";
    gv_EmptyTestUnits[3358] = "Zealot";
    gv_EmptyTestUnits[3359] = "ZealotPurifier";
    gv_EmptyTestUnits[3360] = "ZergTowerArtillery";
    gv_EmptyTestUnits[3361] = "DamagedSolarForge";
    gv_EmptyTestUnits[3362] = "SolarForge";
    gv_EmptyTestUnits[3363] = "Supplicant";
    gv_EmptyTestUnits[3364] = "WarpPrismTaldarim";
    gv_EmptyTestUnits[3365] = "Zeratul";
}

//--------------------------------------------------------------------------------------------------
// 查表 API: 指挥官名 -> 序号 (-1 表示未找到)
//--------------------------------------------------------------------------------------------------
int libEmptyTestCatalog_gf_CommanderIndex (string lp_commander) {
    int li;
    for (li = 0; li <= 18; li += 1) {
        if (gv_EmptyTestCommanders[li] == lp_commander) {
            return li;
        }
    }
    return -1;
}

//--------------------------------------------------------------------------------------------------
// 查表 API: 指挥官名 -> 该指挥官的单位数
//--------------------------------------------------------------------------------------------------
int libEmptyTestCatalog_gf_UnitCountOf (string lp_commander) {
    int li = libEmptyTestCatalog_gf_CommanderIndex(lp_commander);
    if (li < 0) { return 0; }
    return gv_EmptyTestUnitCounts[li];
}

//--------------------------------------------------------------------------------------------------
// 查表 API: 指挥官名 + 序号 -> 单位 ID (越界返回空字符串)
//--------------------------------------------------------------------------------------------------
string libEmptyTestCatalog_gf_UnitAt (string lp_commander, int lp_index) {
    int li = libEmptyTestCatalog_gf_CommanderIndex(lp_commander);
    if (li < 0) { return ""; }
    if (lp_index < 0 || lp_index >= gv_EmptyTestUnitCounts[li]) { return ""; }
    return gv_EmptyTestUnits[gv_EmptyTestUnitOffsets[li] + lp_index];
}
