int libEmptyTestCatalog_gf_UnitCountOf (string lp_commander) {
    int lv_i;
    for (lv_i = 0; lv_i < gv_c_EmptyTestCommanderCount; lv_i += 1) {
        if (gv_EmptyTestCommanders[lv_i] == lp_commander) {
            return gv_EmptyTestUnitCounts[lv_i];
        }
    }
    return 0;
}

string libEmptyTestCatalog_gf_UnitAt (string lp_commander, int lp_index) {
    int lv_i;
    for (lv_i = 0; lv_i < gv_c_EmptyTestCommanderCount; lv_i += 1) {
        if (gv_EmptyTestCommanders[lv_i] == lp_commander) {
            if ((lp_index >= 0) && (lp_index < gv_EmptyTestUnitCounts[lv_i])) {
                return gv_EmptyTestUnits[gv_EmptyTestUnitOffsets[lv_i] + lp_index];
            }
            return "";
        }
    }
    return "";
}
