include "TriggerLibs/natives"
include "LibNeuroBridge7vs1_h"

//--------------------------------------------------------------------------------------------------
// ��ʼ����ע�� MapInit ���������� NeuroIntegration InitLib ֮����ã�
//--------------------------------------------------------------------------------------------------
void libNeuroBridge7vs1_InitLib() {
    if (libNeuroBridge7vs1_initialized) {
        return;
    }

    // 保留 MapInit 兼容路径。
    libNeuroBridge7vs1_gt_MapInit = TriggerCreate("libNeuroBridge7vs1_gt_MapInit_Func");
    TriggerAddEventMapInit(libNeuroBridge7vs1_gt_MapInit);

    // Phase D: 任务结束钩子
    libNeuroBridge7vs1_gt_MissionVictory = TriggerCreate("libNeuroBridge7vs1_gt_MissionVictory_Func");
    TriggerAddEventPlayerLeft(libNeuroBridge7vs1_gt_MissionVictory, 1, c_gameResultVictory);
    libNeuroBridge7vs1_gt_MissionDefeat = TriggerCreate("libNeuroBridge7vs1_gt_MissionDefeat_Func");
    TriggerAddEventPlayerLeft(libNeuroBridge7vs1_gt_MissionDefeat, 1, c_gameResultDefeat);

    // Debug: monitor execute_actions_global event to confirm global loop execution
    libNeuroBridge7vs1_gt_DebugGlobalEvent = TriggerCreate("libNeuroBridge7vs1_gt_DebugGlobalEvent_Func");
    TriggerAddEventGeneric(libNeuroBridge7vs1_gt_DebugGlobalEvent, "execute_actions_global");

    // 主路径：注册 map 执行触发器，并挂到 EFA 共享 hook。
    // 7vs1 实测 TriggerSendEvent("execute_actions_map") 可能无法触发注入库监听，
    // 因此 global 循环通过 libEFA54406_gt_MapActionHook 直接 TriggerExecute。
    libNeuroBridge7vs1_gt_ExecuteActionsMap = TriggerCreate("libNeuroBridge7vs1_gt_ExecuteActionsMap_Func");
    TriggerAddEventGeneric(libNeuroBridge7vs1_gt_ExecuteActionsMap, "execute_actions_map");
    libEFA54406_gt_MapActionHook = libNeuroBridge7vs1_gt_ExecuteActionsMap;
    libNeuroBridge7vs1_gf_InitActivityTracking();

    libNeuroBridge7vs1_loopBootstrapped = false;
    libNeuroBridge7vs1_gt_BootstrapLoop = TriggerCreate("libNeuroBridge7vs1_gt_BootstrapLoop_Func");
    TriggerAddEventGeneric(libNeuroBridge7vs1_gt_BootstrapLoop, "neuro_bank_ready");

    libNeuroBridge7vs1_initialized = true;
}

//--------------------------------------------------------------------------------------------------
// Debug trigger: monitor execute_actions_global event, record count to bank
//--------------------------------------------------------------------------------------------------
bool libNeuroBridge7vs1_gt_DebugGlobalEvent_Func(bool testConds, bool runActions) {
    int lv_currentCount = 0;
    if (testConds) {
        return true;
    }
    if (runActions) {
        if (libEFA54406_gv_neuroIntegration != null) {
            lv_currentCount = BankValueGetAsInt(libEFA54406_gv_neuroIntegration, "game_state", "debug_global_count");
            BankValueSetFromInt(libEFA54406_gv_neuroIntegration, "game_state", "debug_global_count", lv_currentCount + 1);
            BankSave(libEFA54406_gv_neuroIntegration);
        }
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Phase D: ����ʤ������
//--------------------------------------------------------------------------------------------------
bool libNeuroBridge7vs1_gt_MissionVictory_Func(bool testConds, bool runActions) {
    if (testConds) {
        return true;
    }
    if (!runActions) {
        return true;
    }
    libNeuroBridge7vs1_gf_OnMissionVictory("current_map", 0);
    return true;
}

//--------------------------------------------------------------------------------------------------
// Phase D: ����ʧ�ܹ���
//--------------------------------------------------------------------------------------------------
bool libNeuroBridge7vs1_gt_MissionDefeat_Func(bool testConds, bool runActions) {
    if (testConds) {
        return true;
    }
    if (!runActions) {
        return true;
    }
    libNeuroBridge7vs1_gf_OnMissionDefeat("current_map");
    return true;
}

//--------------------------------------------------------------------------------------------------
// ע�� 7vs1 ר�� action����Ҫ�� NeuroIntegration bank ��������ã�
// ֻ����ѯ�� + д���� action ȫ��ע��� Neuro
//--------------------------------------------------------------------------------------------------
void libNeuroBridge7vs1_gf_RegisterActions() {
    // === ֻ����ѯ�� action ===
    libEFA54406_gf_create_action_0_arg("get_mutators", true,
        "Get the currently active mutators, resources and supply in this 7vs1 mission", -1);
    libEFA54406_gf_create_action_0_arg("get_commander_status", true,
        "Get the current commander status including unit count and army composition", -1);
    libEFA54406_gf_create_action_0_arg("get_production_queue", true,
        "Get the current production queue of all buildings", -1);
    libEFA54406_gf_create_action_0_arg("get_active_mutators", true,
        "Get the list of active mutators with semantic descriptions explaining their gameplay impact", -1);

    // === д���� action��Neuro ������ָ����Ϸ��Ϊ��===
    libEFA54406_gf_create_action_1_arg("train_unit", true,
        "Order production of a unit. arg_1 is the unit type id, e.g. Marine, Marauder, SiegeTank, Medivac, Viking",
        "string", -1);
    libEFA54406_gf_create_action_2_arg("use_ability", true,
        "Order a unit to use an ability. arg_1 is the ability id, arg_2 is the target unit type (optional, e.g. Marine for enemy marines)",
        "string", "string", -1);
    libEFA54406_gf_create_action_1_arg("research_upgrade", true,
        "Order research of an upgrade. arg_1 is the upgrade id, e.g. TerranInfantryWeaponsLevel1",
        "string", -1);

    // === 写入型 action：精确单位控制（基于目标单位类型定位）===
    libEFA54406_gf_create_action_1_arg("attack_unit", true,
        "Order currently selected player units to attack the nearest enemy unit of the given type. arg_1 is the target unit type id, e.g. Marine, Zergling, Hydralisk",
        "string", -1);
    libEFA54406_gf_create_action_1_arg("focus_fire", true,
        "Order ALL player army units to attack the nearest enemy unit of the given type. arg_1 is the target unit type id, e.g. Baneling, Ultralisk",
        "string", -1);
    libEFA54406_gf_create_action_2_arg("set_rally", true,
        "Set rally point of all buildings matching arg_1 to the nearest unit of type arg_2 (any owner). arg_1 = building type, e.g. Barracks; arg_2 = target unit type, e.g. CommandCenter",
        "string", "string", -1);
    libEFA54406_gf_create_action_2_arg("move_to_unit", true,
        "Order all player units of type arg_1 to move to the nearest unit of type arg_2 (any owner). arg_1 = source unit type, e.g. Marine; arg_2 = target unit type, e.g. SCV",
        "string", "string", -1);
    libEFA54406_gf_create_action_1_arg("move_selected_to_unit", true,
        "Order the currently selected player units to move to the nearest unit of the given type. arg_1 = target unit type, e.g. CommandCenter, SCV, Marine",
        "string", -1);
}

//--------------------------------------------------------------------------------------------------
// MapInit ��������ע������ѭ������������ʹ�� Wait������ MapInit �й���
// action ע��� context �����ӳٵ� execute_actions_map �״ε���ʱִ��
//--------------------------------------------------------------------------------------------------
bool libNeuroBridge7vs1_gt_MapInit_Func(bool testConds, bool runActions) {
    if (testConds) {
        return true;
    }
    if (runActions) {
        // 兼容路径：若 InitLib 主路径未启动，则在此补启动。
        if (libEFA54406_gv_neuroIntegration != null) {
            BankValueSetFromInt(libEFA54406_gv_neuroIntegration, "game_state", "debug_mapinit", 1);
            BankSave(libEFA54406_gv_neuroIntegration);
        }

        if (libNeuroBridge7vs1_gt_ExecuteActionsMap == null) {
            libNeuroBridge7vs1_gt_ExecuteActionsMap = TriggerCreate("libNeuroBridge7vs1_gt_ExecuteActionsMap_Func");
            TriggerAddEventGeneric(libNeuroBridge7vs1_gt_ExecuteActionsMap, "execute_actions_map");
            libNeuroBridge7vs1_gf_InitActivityTracking();
        }

        if (!libNeuroBridge7vs1_loopBootstrapped) {
            libNeuroBridge7vs1_loopBootstrapped = true;
            libNeuroBridge7vs1_gt_BootstrapLoop = TriggerCreate("libNeuroBridge7vs1_gt_BootstrapLoop_Func");
            TriggerExecute(libNeuroBridge7vs1_gt_BootstrapLoop, false, false);
        }
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Bootstrap: 等 bank 就绪后异步启动 execute_actions_global
// 解决：
//   - MapInit 中 Wait 不恢复导致后续 MapInit 被堵
//   - global 循环启动早于 map 监听注册
//   - bankwriteallowed=false 时 RegisterActions 死锁
//--------------------------------------------------------------------------------------------------
bool libNeuroBridge7vs1_gt_BootstrapLoop_Func(bool testConds, bool runActions) {
    if (testConds) {
        return true;
    }
    if (!runActions) {
        return true;
    }

    // 只执行一次
    if (libNeuroBridge7vs1_loopBootstrapped) {
        return true;
    }
    libNeuroBridge7vs1_loopBootstrapped = true;

    // neuro_bank_ready 由 EFA CreateBank 发出，此时 bank 应已就绪
    if (libEFA54406_gv_neuroIntegration != null) {
        BankValueSetFromInt(libEFA54406_gv_neuroIntegration, "game_state", "debug_bootstrap", 1);
        BankValueSetFromInt(libEFA54406_gv_neuroIntegration, "game_state", "debug_mapinit", 1);
        BankSave(libEFA54406_gv_neuroIntegration);
    }

    // 确保 create_action 不会卡在 bankwriteallowed 等待
    libEFA54406_gv_bankwriteallowed = true;

    // 注册 7vs1 action（不依赖首轮 map 事件）
    if ((libEFA54406_gv_neuroIntegration != null) && (!libNeuroBridge7vs1_actionsRegistered)) {
        libNeuroBridge7vs1_gf_RegisterActions();
        libNeuroBridge7vs1_actionsRegistered = true;
        libNeuroBridge7vs1_gf_PushMutatorContext();
        libNeuroBridge7vs1_gf_PushLastMissionSummary();
        BankValueSetFromInt(libEFA54406_gv_neuroIntegration, "game_state", "debug_actions_registered", 1);
        BankSave(libEFA54406_gv_neuroIntegration);
    }

    // 异步启动 global 循环
    if (libEFA54406_gt_Executeactionsglobal != null) {
        TriggerExecute(libEFA54406_gt_Executeactionsglobal, false, false);
    } else {
        TriggerSendEvent("execute_actions_global");
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
// ������������ȫ��ȡ bank flag
//--------------------------------------------------------------------------------------------------
void libNeuroBridge7vs1_gf_InitActivityTracking() {
    if (libNeuroBridge7vs1_activityTrackingInitialized) {
        return;
    }

    libNeuroBridge7vs1_gt_PlayerChatMessage = TriggerCreate("libNeuroBridge7vs1_gt_PlayerChatMessage_Func");
    TriggerAddEventChatMessage(libNeuroBridge7vs1_gt_PlayerChatMessage, c_playerAny, "", false);

    libNeuroBridge7vs1_gt_UnitAbility = TriggerCreate("libNeuroBridge7vs1_gt_UnitAbility_Func");
    TriggerAddEventUnitAbility(libNeuroBridge7vs1_gt_UnitAbility, null, null, c_unitAbilStageAll, false);

    libNeuroBridge7vs1_gt_UnitOrder = TriggerCreate("libNeuroBridge7vs1_gt_UnitOrder_Func");
    TriggerAddEventUnitOrder(libNeuroBridge7vs1_gt_UnitOrder, null, null);

    libNeuroBridge7vs1_gt_UnitDies = TriggerCreate("libNeuroBridge7vs1_gt_UnitDies_Func");
    TriggerAddEventUnitDied(libNeuroBridge7vs1_gt_UnitDies, null);

    libNeuroBridge7vs1_pendingChatContext = "";
    libNeuroBridge7vs1_pendingCommandContext = "";
    libNeuroBridge7vs1_pendingDirectiveContext = "";
    libNeuroBridge7vs1_lastSelectionContext = "";
    libNeuroBridge7vs1_selectionCooldownTicks = 0;
    libNeuroBridge7vs1_directiveCounter = 0;
    libNeuroBridge7vs1_economyTickCounter = 0;
    libNeuroBridge7vs1_combatTickCounter = 0;
    libNeuroBridge7vs1_economySnapshotInitialized = false;
    libNeuroBridge7vs1_lastMinerals = 0;
    libNeuroBridge7vs1_lastGas = 0;
    libNeuroBridge7vs1_lastSupplyUsed = 0;
    libNeuroBridge7vs1_ownUnitsLostToEnemy = 0;
    libNeuroBridge7vs1_ownUnitsLostToSelf = 0;
    libNeuroBridge7vs1_enemyUnitsKilled = 0;
    libNeuroBridge7vs1_neutralUnitsKilled = 0;
    libNeuroBridge7vs1_activityTrackingInitialized = true;
}

bool libNeuroBridge7vs1_gt_PlayerChatMessage_Func(bool testConds, bool runActions) {
    string lv_message = "";

    if (testConds) {
        return true;
    }
    if (!runActions) {
        return true;
    }

    lv_message = EventChatMessage(false);
    libNeuroBridge7vs1_pendingChatContext =
        "In-game chat message from player " + IntToString(EventPlayer()) + ": " + lv_message;
    if ((EventPlayer() == 1) && (lv_message != "")) {
        libNeuroBridge7vs1_pendingDirectiveContext = lv_message;
    }
    return true;
}

bool libNeuroBridge7vs1_gt_UnitAbility_Func(bool testConds, bool runActions) {
    string lv_context = "";

    if (testConds) {
        return true;
    }
    if (!runActions) {
        return true;
    }
    if (EventPlayer() != 1) {
        return true;
    }
    if (UnitGetOwner(EventUnit()) != 1) {
        return true;
    }
    if (EventUnitAbilityStage() != c_unitAbilStageExecute) {
        return true;
    }

    lv_context = libNeuroBridge7vs1_gf_BuildPlayerOperationContext("ability");
    libNeuroBridge7vs1_gf_AppendPlayerOperationContext(lv_context);
    return true;
}

bool libNeuroBridge7vs1_gt_UnitOrder_Func(bool testConds, bool runActions) {
    string lv_context = "";

    if (testConds) {
        return true;
    }
    if (!runActions) {
        return true;
    }
    if (EventPlayer() != 1) {
        return true;
    }
    if (UnitGetOwner(EventUnit()) != 1) {
        return true;
    }

    lv_context = libNeuroBridge7vs1_gf_BuildPlayerOperationContext("order");
    libNeuroBridge7vs1_gf_AppendPlayerOperationContext(lv_context);
    return true;
}

bool libNeuroBridge7vs1_gt_UnitDies_Func(bool testConds, bool runActions) {
    unit lv_killingUnit;
    int lv_killingOwner = 0;
    int lv_deadOwner = 0;

    if (testConds) {
        return true;
    }
    if (!runActions) {
        return true;
    }

    lv_deadOwner = EventPlayer();
    lv_killingUnit = libNtve_gf_KillingUnit();
    if (lv_killingUnit != null) {
        lv_killingOwner = UnitGetOwner(lv_killingUnit);
    }

    if (lv_deadOwner == 1) {
        if (lv_killingOwner == 1) {
            libNeuroBridge7vs1_ownUnitsLostToSelf = libNeuroBridge7vs1_ownUnitsLostToSelf + 1;
        } else {
            libNeuroBridge7vs1_ownUnitsLostToEnemy = libNeuroBridge7vs1_ownUnitsLostToEnemy + 1;
        }
    } else if (lv_killingOwner == 1) {
        if (libNtve_gf_PlayerIsEnemy(1, lv_deadOwner, libNtve_ge_PlayerRelation_Enemy) == true) {
            libNeuroBridge7vs1_enemyUnitsKilled = libNeuroBridge7vs1_enemyUnitsKilled + 1;
        } else if (libNtve_gf_PlayerIsEnemy(1, lv_deadOwner, libNtve_ge_PlayerRelation_Neutral) == true) {
            libNeuroBridge7vs1_neutralUnitsKilled = libNeuroBridge7vs1_neutralUnitsKilled + 1;
        }
    }
    return true;
}

string libNeuroBridge7vs1_gf_BuildSelectedUnitsContext() {
    unitgroup lv_selectedUnits = UnitGroupSelected(1);
    int lv_total = UnitGroupCount(lv_selectedUnits, c_unitCountAll);
    int lv_loopIndex = lv_total;
    int lv_shown = 0;
    unit lv_unit;
    int lv_owner = 1;
    int lv_hp = 0;
    int lv_hpMax = 0;
    string lv_name = "";
    string lv_context = "";

    if (lv_total <= 0) {
        return "";
    }

    lv_context = "Player selected " + IntToString(lv_total) + " unit(s): ";
    for (;; lv_loopIndex -= 1) {
        lv_unit = UnitGroupUnitFromEnd(lv_selectedUnits, lv_loopIndex);
        if (lv_unit == null) { break; }
        lv_name = TextToString(UnitGetName(lv_unit));
        if (lv_name == "") {
            continue;
        }
        if (lv_shown > 0) {
            lv_context = lv_context + "; ";
        }

        lv_owner = UnitGetOwner(lv_unit);
        if (lv_owner != 1) {
            if (libNtve_gf_PlayerIsEnemy(1, lv_owner, libNtve_ge_PlayerRelation_Enemy) == true) {
                lv_context = lv_context + "ENEMY ";
            } else if (libNtve_gf_PlayerIsEnemy(1, lv_owner, libNtve_ge_PlayerRelation_Neutral) == true) {
                lv_context = lv_context + "NEUTRAL ";
            } else {
                lv_context = lv_context + "ALLY ";
            }
        }

        lv_hp = UnitGetPropertyInt(lv_unit, c_unitPropLife, c_unitPropCurrent);
        lv_hpMax = UnitGetPropertyInt(lv_unit, c_unitPropLifeMax, c_unitPropCurrent);
        lv_context = lv_context + lv_name + " HP " + IntToString(lv_hp) + "/" + IntToString(lv_hpMax);
        lv_shown = lv_shown + 1;
        if (lv_shown >= 6) {
            break;
        }
    }

    if (lv_total > lv_shown) {
        lv_context = lv_context + "; ...";
    }
    return lv_context;
}

string libNeuroBridge7vs1_gf_BuildPlayerOperationContext(string eventKind) {
    unit lv_unit = EventUnit();
    unit lv_targetUnit = EventUnitTargetUnit();
    point lv_targetPoint = EventUnitTargetPoint();
    abilcmd lv_command = EventUnitAbility();
    string lv_ability = AbilityCommandGetAbility(lv_command);
    int lv_commandIndex = AbilityCommandGetCommand(lv_command);
    int lv_actionIndex = AbilityCommandGetAction(lv_command);
    string lv_context = "";
    string lv_unitType = "";
    string lv_targetType = "";
    int lv_targetOwner = 0;

    if (lv_unit == null) {
        return "";
    }

    lv_unitType = UnitGetType(lv_unit);
    lv_context = "Player " + eventKind + ": " + lv_unitType;
    lv_context = lv_context + " ability=" + lv_ability + "[" + IntToString(lv_commandIndex) + "]";
    lv_context = lv_context + " action=" + IntToString(lv_actionIndex);

    if (UnitGroupHasUnit(UnitGroupSelected(1), lv_unit) == true) {
        lv_context = lv_context + " selected=true";
    } else {
        lv_context = lv_context + " selected=false";
    }

    if (lv_targetUnit != null) {
        lv_targetOwner = UnitGetOwner(lv_targetUnit);
        lv_targetType = UnitGetType(lv_targetUnit);
        lv_context = lv_context + " target_unit=" + lv_targetType;
        lv_context = lv_context + " target_owner=" + IntToString(lv_targetOwner);
        if (lv_targetOwner == 1) {
            lv_context = lv_context + " relation=friendly";
        } else if (libNtve_gf_PlayerIsEnemy(1, lv_targetOwner, libNtve_ge_PlayerRelation_Enemy) == true) {
            lv_context = lv_context + " relation=enemy";
        } else if (libNtve_gf_PlayerIsEnemy(1, lv_targetOwner, libNtve_ge_PlayerRelation_Neutral) == true) {
            lv_context = lv_context + " relation=neutral";
        } else {
            lv_context = lv_context + " relation=ally";
        }
    } else if (lv_targetPoint != null) {
        lv_context = lv_context + " target_point=(" +
            FixedToString(PointGetX(lv_targetPoint), 1) + "," +
            FixedToString(PointGetY(lv_targetPoint), 1) + ")";
    }

    return lv_context + ".";
}

void libNeuroBridge7vs1_gf_AppendPlayerOperationContext(string context) {
    if (context == "") {
        return;
    }
    if (libNeuroBridge7vs1_pendingCommandContext == "") {
        libNeuroBridge7vs1_pendingCommandContext = context;
    } else {
        libNeuroBridge7vs1_pendingCommandContext = libNeuroBridge7vs1_pendingCommandContext + "\n" + context;
    }
    if (StringLength(libNeuroBridge7vs1_pendingCommandContext) > 1800) {
        libNeuroBridge7vs1_pendingCommandContext = StringSub(libNeuroBridge7vs1_pendingCommandContext, 1, 1800);
    }
}

void libNeuroBridge7vs1_gf_UpdateSelectionContext() {
    string lv_currentContext = "";

    if (libNeuroBridge7vs1_selectionCooldownTicks > 0) {
        libNeuroBridge7vs1_selectionCooldownTicks = libNeuroBridge7vs1_selectionCooldownTicks - 1;
    }

    lv_currentContext = libNeuroBridge7vs1_gf_BuildSelectedUnitsContext();
    if (lv_currentContext == "") {
        if ((libNeuroBridge7vs1_lastSelectionContext != "") && (libNeuroBridge7vs1_selectionCooldownTicks <= 0)) {
            libEFA54406_gf_create_context("player_selected_units", "Player has no unit(s) selected.", true);
            libNeuroBridge7vs1_lastSelectionContext = "";
            libNeuroBridge7vs1_selectionCooldownTicks = 5;
        }
        return;
    }

    if ((lv_currentContext != libNeuroBridge7vs1_lastSelectionContext) && (libNeuroBridge7vs1_selectionCooldownTicks <= 0)) {
        libEFA54406_gf_create_context("player_selected_units", lv_currentContext, true);
        libNeuroBridge7vs1_lastSelectionContext = lv_currentContext;
        libNeuroBridge7vs1_selectionCooldownTicks = 5;
    }
}

void libNeuroBridge7vs1_gf_UpdateEconomyContext() {
    int lv_currentMinerals = PlayerGetPropertyInt(1, c_playerPropMinerals);
    int lv_currentGas = PlayerGetPropertyInt(1, c_playerPropVespene);
    int lv_currentSupply = PlayerGetPropertyInt(1, c_playerPropSuppliesUsed);
    int lv_supplyCap = PlayerGetPropertyInt(1, c_playerPropSuppliesMade);
    string lv_context = "";

    if (!libNeuroBridge7vs1_economySnapshotInitialized) {
        libNeuroBridge7vs1_lastMinerals = lv_currentMinerals;
        libNeuroBridge7vs1_lastGas = lv_currentGas;
        libNeuroBridge7vs1_lastSupplyUsed = lv_currentSupply;
        libNeuroBridge7vs1_economySnapshotInitialized = true;
        return;
    }

    libNeuroBridge7vs1_economyTickCounter = libNeuroBridge7vs1_economyTickCounter + 1;
    if (libNeuroBridge7vs1_economyTickCounter < 45) {
        return;
    }
    libNeuroBridge7vs1_economyTickCounter = 0;

    lv_context = "Economy snapshot: " +
        IntToString(lv_currentMinerals) + " minerals, " +
        IntToString(lv_currentGas) + " gas, supply " +
        IntToString(lv_currentSupply) + "/" + IntToString(lv_supplyCap) +
        ". Delta since last snapshot: minerals " +
        IntToString(lv_currentMinerals - libNeuroBridge7vs1_lastMinerals) +
        ", gas " + IntToString(lv_currentGas - libNeuroBridge7vs1_lastGas) +
        ", used supply " + IntToString(lv_currentSupply - libNeuroBridge7vs1_lastSupplyUsed) + ".";
    libEFA54406_gf_create_context("economy", lv_context, true);

    libNeuroBridge7vs1_lastMinerals = lv_currentMinerals;
    libNeuroBridge7vs1_lastGas = lv_currentGas;
    libNeuroBridge7vs1_lastSupplyUsed = lv_currentSupply;
}

void libNeuroBridge7vs1_gf_UpdateCombatContext() {
    string lv_context = "";

    libNeuroBridge7vs1_combatTickCounter = libNeuroBridge7vs1_combatTickCounter + 1;
    if (libNeuroBridge7vs1_combatTickCounter < 8) {
        return;
    }
    libNeuroBridge7vs1_combatTickCounter = 0;

    if ((libNeuroBridge7vs1_ownUnitsLostToEnemy <= 0) &&
        (libNeuroBridge7vs1_ownUnitsLostToSelf <= 0) &&
        (libNeuroBridge7vs1_enemyUnitsKilled <= 0) &&
        (libNeuroBridge7vs1_neutralUnitsKilled <= 0)) {
        return;
    }

    lv_context = "Recent combat recap: ";
    if (libNeuroBridge7vs1_ownUnitsLostToEnemy > 0) {
        lv_context = lv_context + "lost " + IntToString(libNeuroBridge7vs1_ownUnitsLostToEnemy) + " unit(s) to enemy fire; ";
    }
    if (libNeuroBridge7vs1_ownUnitsLostToSelf > 0) {
        lv_context = lv_context + "lost " + IntToString(libNeuroBridge7vs1_ownUnitsLostToSelf) + " unit(s) to friendly fire; ";
    }
    if (libNeuroBridge7vs1_enemyUnitsKilled > 0) {
        lv_context = lv_context + "killed " + IntToString(libNeuroBridge7vs1_enemyUnitsKilled) + " enemy unit(s); ";
    }
    if (libNeuroBridge7vs1_neutralUnitsKilled > 0) {
        lv_context = lv_context + "killed " + IntToString(libNeuroBridge7vs1_neutralUnitsKilled) + " neutral unit(s); ";
    }
    libEFA54406_gf_create_context("unit_dies", lv_context, true);

    libNeuroBridge7vs1_ownUnitsLostToEnemy = 0;
    libNeuroBridge7vs1_ownUnitsLostToSelf = 0;
    libNeuroBridge7vs1_enemyUnitsKilled = 0;
    libNeuroBridge7vs1_neutralUnitsKilled = 0;
}

void libNeuroBridge7vs1_gf_FlushPendingContexts() {
    string lv_state = "";
    string lv_actions = "";

    if (libEFA54406_gv_neuroIntegration == null) {
        return;
    }

    if (libNeuroBridge7vs1_pendingChatContext != "") {
        libEFA54406_gf_create_context("player_chat_message", libNeuroBridge7vs1_pendingChatContext, false);
        libNeuroBridge7vs1_pendingChatContext = "";
    }
    if (libNeuroBridge7vs1_pendingCommandContext != "") {
        libEFA54406_gf_create_context("player_action", libNeuroBridge7vs1_pendingCommandContext, true);
        libNeuroBridge7vs1_pendingCommandContext = "";
    }
    if (libNeuroBridge7vs1_pendingDirectiveContext != "") {
        lv_state = libNeuroBridge7vs1_gf_BuildSelectedUnitsContext();
        if (lv_state != "") {
            lv_state = lv_state + "\n";
        }
        lv_state = lv_state + libNeuroBridge7vs1_gf_GetCommanderStatus();
        lv_actions = "chat_message,get_commander_status,get_production_queue,get_active_mutators,train_unit,use_ability,research_upgrade,attack_unit,focus_fire,set_rally,move_to_unit,move_selected_to_unit";
        libNeuroBridge7vs1_directiveCounter = libNeuroBridge7vs1_directiveCounter + 1;
        libEFA54406_gf_create_context("player_directive", "Player directive: " + libNeuroBridge7vs1_pendingDirectiveContext, false);
        libEFA54406_gf_create_force_action(
            "player_directive_" + IntToString(libNeuroBridge7vs1_directiveCounter),
            lv_actions,
            lv_state,
            "The player typed: " + libNeuroBridge7vs1_pendingDirectiveContext + ". If this is a command, choose the registered action that best executes it. If it is only conversation, answer with chat_message.",
            false,
            "high");
        libNeuroBridge7vs1_pendingDirectiveContext = "";
    }

    libNeuroBridge7vs1_gf_UpdateSelectionContext();
    libNeuroBridge7vs1_gf_UpdateEconomyContext();
    libNeuroBridge7vs1_gf_UpdateCombatContext();
}

bool libNeuroBridge7vs1_gf_ReadActionFlag(string actionName) {
    if (libEFA54406_gv_neuroIntegration == null) {
        return false;
    }
    return BankValueGetAsFlag(libEFA54406_gv_neuroIntegration, "do_action", actionName);
}

void libNeuroBridge7vs1_gf_ClearActionFlag(string actionName) {
    if (libEFA54406_gv_neuroIntegration == null) {
        return;
    }
    BankValueSetFromFlag(libEFA54406_gv_neuroIntegration, "do_action", actionName, false);
}

string libNeuroBridge7vs1_gf_ReadActionStringArg(string actionName, string argName) {
    if (libEFA54406_gv_neuroIntegration == null) {
        return "";
    }
    return BankValueGetAsString(libEFA54406_gv_neuroIntegration, "do_action", argName);
}

//--------------------------------------------------------------------------------------------------
// ֻ����ѯ�� action��get_mutators����������������ѯͻ�����ӣ�����ֻ������Դ��
//--------------------------------------------------------------------------------------------------
string libNeuroBridge7vs1_gf_GetMutators() {
    int lv_player = 1;
    int lv_minerals = PlayerGetPropertyInt(lv_player, c_playerPropMinerals);
    int lv_gas = PlayerGetPropertyInt(lv_player, c_playerPropVespene);
    int lv_supplyUsed = PlayerGetPropertyInt(lv_player, c_playerPropSuppliesUsed);
    int lv_supplyMade = PlayerGetPropertyInt(lv_player, c_playerPropSuppliesMade);
    string lv_mutatorList = "";
    int lv_mutatorCount = 0;
    int lv_i = 1;
    string lv_id = "";
    string lv_result = "";

    while (lv_i <= 69) {
        lv_id = libE0EAE146_gf_MutatorIdByIndex(lv_i);
        if (lv_id != "" && lv_id != "Random") {
            if (libA070801C_gf_MutatorIsEnabled(lv_id)) {
                if (lv_mutatorCount > 0) {
                    lv_mutatorList = lv_mutatorList + ", ";
                }
                lv_mutatorList = lv_mutatorList + lv_id;
                lv_mutatorCount = lv_mutatorCount + 1;
            }
        }
        lv_i = lv_i + 1;
    }

    lv_result = "Resources: " + IntToString(lv_minerals) + " min, " +
        IntToString(lv_gas) + " gas. Supply: " +
        IntToString(lv_supplyUsed) + "/" + IntToString(lv_supplyMade) +
        ". Active mutators (" + IntToString(lv_mutatorCount) + "): " + lv_mutatorList + ".";

    return lv_result;
}

//--------------------------------------------------------------------------------------------------
// ֻ����ѯ�� action��get_commander_status
//--------------------------------------------------------------------------------------------------
string libNeuroBridge7vs1_gf_GetCommanderStatus() {
    int lv_player = 1;
    unitgroup lv_allUnits = UnitGroup(null, lv_player, RegionEntireMap(), UnitFilter(0, 0, (1 << 0), (1 << 1)), 0);
    int lv_totalUnits = UnitGroupCount(lv_allUnits, c_unitCountAll);

    unitgroup lv_structures = UnitGroup(null, lv_player, RegionEntireMap(),
        UnitFilter((1 << c_targetFilterStructure), 0, (1 << 0), (1 << 1)), 0);
    int lv_structureCount = UnitGroupCount(lv_structures, c_unitCountAll);

    unitgroup lv_army = UnitGroup(null, lv_player, RegionEntireMap(),
        UnitFilter(0, (1 << c_targetFilterStructure) | (1 << c_targetFilterWorker), (1 << 0), (1 << 1)), 0);
    int lv_armyCount = UnitGroupCount(lv_army, c_unitCountAll);

    string lv_result = "Commander status: " + IntToString(lv_totalUnits) + " total units, " +
        IntToString(lv_structureCount) + " structures, " +
        IntToString(lv_armyCount) + " army units.";

    return lv_result;
}

//--------------------------------------------------------------------------------------------------
// ֻ����ѯ�� action��get_production_queue
//--------------------------------------------------------------------------------------------------
string libNeuroBridge7vs1_gf_GetProductionQueue() {
    int lv_player = 1;
    unitgroup lv_structures = UnitGroup(null, lv_player, RegionEntireMap(),
        UnitFilter((1 << c_targetFilterStructure), 0, (1 << 0), (1 << 1)), 0);
    string lv_result = "Production queue: ";
    int lv_count = 0;
    unit lv_u = null;
    int lv_queueCount = 0;
    string lv_queueItem = "";

    UnitGroupLoopBegin(lv_structures);
    while (!UnitGroupLoopDone() && lv_count < 10) {
        lv_u = UnitGroupLoopCurrent();
        lv_queueCount = UnitQueueItemCount(lv_u, 0);
        if (lv_queueCount > 0) {
            lv_queueItem = UnitQueueItemGet(lv_u, 0, 0);
            if (lv_queueItem != "" && lv_queueItem != null) {
                lv_result = lv_result + TextToString(UnitGetName(lv_u)) + " -> " + lv_queueItem + "; ";
                lv_count = lv_count + 1;
            }
        }
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();

    if (lv_count == 0) {
        lv_result = lv_result + "No active production.";
    }

    return lv_result;
}

//--------------------------------------------------------------------------------------------------
// ֻ����ѯ�� action��get_active_mutators
// ���ؼ����ͻ�������б� + ÿ��ͻ�����ӵ����廯�������� Neuro ������ƣ�
//--------------------------------------------------------------------------------------------------
string libNeuroBridge7vs1_gf_GetActiveMutators() {
    string lv_result = "Active mutators with semantic descriptions: ";
    int lv_count = 0;
    int lv_i = 1;
    string lv_id = "";
    string lv_desc = "";

    while (lv_i <= 69) {
        lv_id = libE0EAE146_gf_MutatorIdByIndex(lv_i);
        if (lv_id != "" && lv_id != "Random") {
            if (libA070801C_gf_MutatorIsEnabled(lv_id)) {
                lv_desc = libNeuroBridge7vs1_gf_GetMutatorSemanticDescription(lv_id);
                if (lv_count > 0) {
                    lv_result = lv_result + " | ";
                }
                lv_result = lv_result + "[" + lv_id + "] " + lv_desc;
                lv_count = lv_count + 1;
            }
        }
        lv_i = lv_i + 1;
    }

    if (lv_count == 0) {
        lv_result = lv_result + "No active mutators (preset 0 or not started).";
    } else {
        lv_result = lv_result + " Total: " + IntToString(lv_count) + " mutator(s).";
    }

    return lv_result;
}

//--------------------------------------------------------------------------------------------------
// д���� action��train_unit
// �� Neuro ָ��������λ
// arg_1: ��λ���� ID���� "Marine", "SiegeTank", "Medivac"��
// ʵ�֣������������õ�λ�Ľ������¶���
//--------------------------------------------------------------------------------------------------
string libNeuroBridge7vs1_gf_TrainUnit(string unitType) {
    int lv_player = 1;
    unitgroup lv_structures;
    unit lv_building = null;
    int lv_queueCount = 0;
    string lv_abilCmd = "";
    order lv_order = null;
    int lv_cmdIndex = 0;

    // 兼容简写：Marine -> MarineRaynor（7vs1 雷神单位 ID）
    if (unitType == "Marine") {
        unitType = "MarineRaynor";
    } else if (unitType == "SCV") {
        unitType = "SCVRaynor";
    } else if (unitType == "Marauder") {
        unitType = "MarauderRaynor";
    }

    if (!CatalogEntryIsValid(c_gameCatalogUnit, unitType)) {
        return "ERROR: Invalid unit type '" + unitType + "'.";
    }

    lv_structures = UnitGroup(null, lv_player, RegionEntireMap(),
        UnitFilter((1 << c_targetFilterStructure), 0, (1 << 0), (1 << 1)), 0);

    if (UnitGroupCount(lv_structures, c_unitCountAll) == 0) {
        return "ERROR: No production structures available.";
    }

    // 7vs1 Raynor：优先用合作生产技能，按命令索引扫描
    UnitGroupLoopBegin(lv_structures);
    while (!UnitGroupLoopDone()) {
        lv_building = UnitGroupLoopCurrent();
        lv_queueCount = UnitQueueItemCount(lv_building, 0);
        if (lv_queueCount < 5) {
            // Barracks
            lv_abilCmd = "BarracksTrainRaynor";
            if (CatalogEntryIsValid(c_gameCatalogAbil, lv_abilCmd)) {
                lv_cmdIndex = 0;
                while (lv_cmdIndex <= 8) {
                    lv_order = Order(AbilityCommand(lv_abilCmd, lv_cmdIndex));
                    if (UnitOrderIsValid(lv_building, lv_order)) {
                        UnitIssueOrder(lv_building, lv_order, c_orderQueueReplace);
                        UnitGroupLoopEnd();
                        return "OK: Ordered " + unitType + " via " + lv_abilCmd + "[" + IntToString(lv_cmdIndex) + "] on " + TextToString(UnitGetName(lv_building)) + ".";
                    }
                    lv_cmdIndex = lv_cmdIndex + 1;
                }
            }
            // Command center / SCV
            lv_abilCmd = "CommandCenterTrainRaynor";
            if (CatalogEntryIsValid(c_gameCatalogAbil, lv_abilCmd)) {
                lv_cmdIndex = 0;
                while (lv_cmdIndex <= 4) {
                    lv_order = Order(AbilityCommand(lv_abilCmd, lv_cmdIndex));
                    if (UnitOrderIsValid(lv_building, lv_order)) {
                        UnitIssueOrder(lv_building, lv_order, c_orderQueueReplace);
                        UnitGroupLoopEnd();
                        return "OK: Ordered " + unitType + " via " + lv_abilCmd + "[" + IntToString(lv_cmdIndex) + "] on " + TextToString(UnitGetName(lv_building)) + ".";
                    }
                    lv_cmdIndex = lv_cmdIndex + 1;
                }
            }
        }
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();

    return "ERROR: Could not find a building that can train " + unitType + ". Check tech tree and requirements.";
}

//--------------------------------------------------------------------------------------------------
// д���� action��use_ability
// �� Neuro ָ��ʹ�õ�λ����
// arg_1: ���� ID���� "Stimpack", "YamatoCannon", "SiegeMode"��
// arg_2: Ŀ�굥λ���ͣ���ѡ������ɸѡĿ�꣩
//--------------------------------------------------------------------------------------------------
string libNeuroBridge7vs1_gf_UseAbility(string abilityId, string targetUnitType) {
    int lv_player = 1;
    unitgroup lv_allUnits;
    unit lv_caster = null;
    bool lv_enabled = false;
    fixed lv_cooldown = 0.0;
    order lv_order = null;
    unitgroup lv_enemies;
    unit lv_target = null;

    // У�鼼���Ƿ���Ч
    if (!CatalogEntryIsValid(c_gameCatalogAbil, abilityId)) {
        return "ERROR: Invalid ability '" + abilityId + "'.";
    }

    // ������������иü��ܵĵ�λ
    lv_allUnits = UnitGroup(null, lv_player, RegionEntireMap(),
        UnitFilter(0, 0, (1 << 0), (1 << 1)), 0);

    if (UnitGroupCount(lv_allUnits, c_unitCountAll) == 0) {
        return "ERROR: No units available.";
    }

    // ������λ���ҵ���һ���иü�������ʹ�õ�
    UnitGroupLoopBegin(lv_allUnits);
    while (!UnitGroupLoopDone()) {
        lv_caster = UnitGroupLoopCurrent();

        // ��鵥λ�Ƿ��иü���
        if (UnitAbilityExists(lv_caster, abilityId)) {
            // ��鼼���Ƿ������δ������ + ��ȴ���
            lv_enabled = UnitAbilityCheck(lv_caster, abilityId, false);
            lv_cooldown = UnitAbilityGetCooldown(lv_caster, abilityId, "");
            if (lv_enabled && lv_cooldown <= 0.0) {
                lv_order = Order(AbilityCommand(abilityId, 0));

                // �����Ŀ�굥λ���ͣ��ҵ�����ĵз���λ
                if (targetUnitType != "" && targetUnitType != null) {
                    lv_enemies = UnitGroup(targetUnitType, c_playerAny, RegionEntireMap(),
                        UnitFilter(0, 0, (1 << 0), (1 << 1)), 0);

                    if (UnitGroupCount(lv_enemies, c_unitCountAll) > 0) {
                        lv_target = UnitGroupClosestToPoint(lv_enemies, UnitGetPosition(lv_caster));
                        if (lv_target != null) {
                            lv_order = OrderTargetingUnit(AbilityCommand(abilityId, 0), lv_target);
                        }
                    }
                }

                // �����¶�����UnitOrderIsValid ǩ��Ϊ (unit, order)��
                if (UnitOrderIsValid(lv_caster, lv_order)) {
                    UnitIssueOrder(lv_caster, lv_order, c_orderQueueReplace);
                    UnitGroupLoopEnd();
                    return "OK: " + TextToString(UnitGetName(lv_caster)) + " is using " + abilityId + ".";
                }
            }
        }
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();

    return "ERROR: No unit can use " + abilityId + " right now. Check cooldown, energy, or tech requirements.";
}

//--------------------------------------------------------------------------------------------------
// д���� action��research_upgrade
// �� Neuro ָ���о�����
// arg_1: ���� ID���� "TerranInfantryWeaponsLevel1"��
//--------------------------------------------------------------------------------------------------
string libNeuroBridge7vs1_gf_ResearchUpgrade(string upgradeId) {
    int lv_player = 1;
    unitgroup lv_structures;
    unit lv_building = null;
    int lv_queueCount = 0;
    string lv_abilCmd1 = "";
    string lv_abilCmd2 = "";
    order lv_order1 = null;
    order lv_order2 = null;

    // У�������Ƿ���Ч
    if (!CatalogEntryIsValid(c_gameCatalogUpgrade, upgradeId)) {
        return "ERROR: Invalid upgrade '" + upgradeId + "'.";
    }

    // ����Ƿ����о�
    if (TechTreeUpgradeCount(lv_player, upgradeId, c_techCountCompleteOnly) > 0) {
        return "ERROR: Upgrade " + upgradeId + " is already researched.";
    }

    // �������н���
    lv_structures = UnitGroup(null, lv_player, RegionEntireMap(),
        UnitFilter((1 << c_targetFilterStructure), 0, (1 << 0), (1 << 1)), 0);

    if (UnitGroupCount(lv_structures, c_unitCountAll) == 0) {
        return "ERROR: No structures available for research.";
    }

    // �����������ҵ���һ�����о���������
    UnitGroupLoopBegin(lv_structures);
    while (!UnitGroupLoopDone()) {
        lv_building = UnitGroupLoopCurrent();
        lv_queueCount = UnitQueueItemCount(lv_building, 0);

        if (lv_queueCount < 5) {
            // ������ <UpgradeId>Research �� Research<UpgradeId> ����
            lv_abilCmd1 = "Research_" + upgradeId;
            lv_abilCmd2 = upgradeId;

            if (CatalogEntryIsValid(c_gameCatalogAbil, lv_abilCmd1)) {
                lv_order1 = Order(AbilityCommand(lv_abilCmd1, 0));
                if (UnitOrderIsValid(lv_building, lv_order1)) {
                    UnitIssueOrder(lv_building, lv_order1, c_orderQueueReplace);
                    UnitGroupLoopEnd();
                    return "OK: Researching " + upgradeId + " at " + TextToString(UnitGetName(lv_building)) + ".";
                }
            }

            if (CatalogEntryIsValid(c_gameCatalogAbil, lv_abilCmd2)) {
                lv_order2 = Order(AbilityCommand(lv_abilCmd2, 0));
                if (UnitOrderIsValid(lv_building, lv_order2)) {
                    UnitIssueOrder(lv_building, lv_order2, c_orderQueueReplace);
                    UnitGroupLoopEnd();
                    return "OK: Researching " + upgradeId + " at " + TextToString(UnitGetName(lv_building)) + ".";
                }
            }
        }
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();

    return "ERROR: Could not find a building that can research " + upgradeId + ".";
}

//--------------------------------------------------------------------------------------------------
// 写入型 action：attack_unit
// 让当前选中的玩家单位攻击最近敌方该类型单位
// arg_1: 目标单位类型，如 "Marine", "Zergling", "Hydralisk"
//--------------------------------------------------------------------------------------------------
string libNeuroBridge7vs1_gf_AttackUnit(string targetUnitType) {
    int lv_player = 1;
    unitgroup lv_selected;
    unitgroup lv_targets;
    unit lv_target = null;
    unit lv_firstUnit = null;
    int lv_issuedCount = 0;
    order lv_order = null;
    point lv_firstUnitPos = null;
    unit lv_u = null;
    int lv_uOwner = 0;
    fixed lv_minDist = 0.0;
    fixed lv_d = 0.0;
    bool lv_first = true;

    if (targetUnitType == "" || targetUnitType == null) {
        return "ERROR: target_unit_type is empty.";
    }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, targetUnitType)) {
        return "ERROR: Invalid target unit type '" + targetUnitType + "'.";
    }

    // 查找全图所有该类型单位（任意归属），在循环里筛选敌方
    lv_targets = UnitGroup(targetUnitType, c_playerAny, RegionEntireMap(),
        UnitFilter(0, 0, (1 << 0), (1 << 1)), 0);

    // 取玩家选中的单位
    lv_selected = UnitGroupSelected(lv_player);
    if (UnitGroupCount(lv_selected, c_unitCountAll) == 0) {
        return "INFO: Player has no units selected. Use focus_fire to use all army instead.";
    }

    // 以选中单位中第一个的位置为基准
    lv_firstUnit = UnitGroupUnit(lv_selected, 1);
    if (lv_firstUnit == null) {
        return "ERROR: Could not resolve selected unit anchor.";
    }
    lv_firstUnitPos = UnitGetPosition(lv_firstUnit);

    // 循环找最近的敌方目标
    UnitGroupLoopBegin(lv_targets);
    while (!UnitGroupLoopDone()) {
        lv_u = UnitGroupLoopCurrent();
        lv_uOwner = UnitGetOwner(lv_u);
        if (lv_uOwner != lv_player &&
            libNtve_gf_PlayerIsEnemy(lv_player, lv_uOwner, libNtve_ge_PlayerRelation_Enemy) == true) {
            lv_d = DistanceBetweenPoints(UnitGetPosition(lv_u), lv_firstUnitPos);
            if (lv_first || lv_d < lv_minDist) {
                lv_minDist = lv_d;
                lv_target = lv_u;
                lv_first = false;
            }
        }
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();

    if (lv_target == null) {
        return "INFO: No enemy '" + targetUnitType + "' found on the map.";
    }

    // 给所有选中单位下达攻击该单位的命令
    lv_order = OrderTargetingUnit(AbilityCommand("attack", 0), lv_target);
    UnitGroupLoopBegin(lv_selected);
    while (!UnitGroupLoopDone()) {
        if (UnitOrderIsValid(UnitGroupLoopCurrent(), lv_order)) {
            UnitIssueOrder(UnitGroupLoopCurrent(), lv_order, c_orderQueueReplace);
            lv_issuedCount = lv_issuedCount + 1;
        }
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();

    if (lv_issuedCount == 0) {
        return "INFO: No selected unit could attack '" + targetUnitType + "' (check weapon range or restrictions).";
    }
    return "OK: Ordered " + IntToString(lv_issuedCount) + " selected unit(s) to attack enemy " + targetUnitType + ".";
}

//--------------------------------------------------------------------------------------------------
// 写入型 action：focus_fire
// 让所有玩家战斗单位集火最近的该类型敌方单位
// arg_1: 目标单位类型，如 "Baneling", "Ultralisk"
//--------------------------------------------------------------------------------------------------
string libNeuroBridge7vs1_gf_FocusFire(string targetUnitType) {
    int lv_player = 1;
    unitgroup lv_army;
    unitgroup lv_targets;
    unit lv_target = null;
    unit lv_anchor = null;
    int lv_issuedCount = 0;
    order lv_order = null;
    point lv_anchorPos = null;
    unit lv_u = null;
    int lv_uOwner = 0;
    fixed lv_minDist = 0.0;
    fixed lv_d = 0.0;
    bool lv_first = true;

    if (targetUnitType == "" || targetUnitType == null) {
        return "ERROR: target_unit_type is empty.";
    }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, targetUnitType)) {
        return "ERROR: Invalid target unit type '" + targetUnitType + "'.";
    }

    // 查找全图所有该类型单位，循环里筛选敌方
    lv_targets = UnitGroup(targetUnitType, c_playerAny, RegionEntireMap(),
        UnitFilter(0, 0, (1 << 0), (1 << 1)), 0);

    // 获取玩家所有战斗单位（排除建筑和工人）
    lv_army = UnitGroup(null, lv_player, RegionEntireMap(),
        UnitFilter(0, (1 << c_targetFilterStructure) | (1 << c_targetFilterWorker), (1 << 0), (1 << 1)), 0);

    if (UnitGroupCount(lv_army, c_unitCountAll) == 0) {
        return "INFO: No army units available.";
    }

    // 以玩家第一个战斗单位为锚点
    lv_anchor = UnitGroupUnit(lv_army, 1);
    if (lv_anchor == null) {
        return "ERROR: Could not resolve army anchor.";
    }
    lv_anchorPos = UnitGetPosition(lv_anchor);

    // 循环找最近的敌方目标
    UnitGroupLoopBegin(lv_targets);
    while (!UnitGroupLoopDone()) {
        lv_u = UnitGroupLoopCurrent();
        lv_uOwner = UnitGetOwner(lv_u);
        if (lv_uOwner != lv_player &&
            libNtve_gf_PlayerIsEnemy(lv_player, lv_uOwner, libNtve_ge_PlayerRelation_Enemy) == true) {
            lv_d = DistanceBetweenPoints(UnitGetPosition(lv_u), lv_anchorPos);
            if (lv_first || lv_d < lv_minDist) {
                lv_minDist = lv_d;
                lv_target = lv_u;
                lv_first = false;
            }
        }
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();

    if (lv_target == null) {
        return "INFO: No enemy '" + targetUnitType + "' found on the map.";
    }

    // 让所有战斗单位集火该目标
    lv_order = OrderTargetingUnit(AbilityCommand("attack", 0), lv_target);
    UnitGroupLoopBegin(lv_army);
    while (!UnitGroupLoopDone()) {
        if (UnitOrderIsValid(UnitGroupLoopCurrent(), lv_order)) {
            UnitIssueOrder(UnitGroupLoopCurrent(), lv_order, c_orderQueueReplace);
            lv_issuedCount = lv_issuedCount + 1;
        }
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();

    if (lv_issuedCount == 0) {
        return "INFO: No army unit could attack '" + targetUnitType + "' right now.";
    }
    return "OK: Ordered " + IntToString(lv_issuedCount) + " army unit(s) to focus fire enemy " + targetUnitType + ".";
}

//--------------------------------------------------------------------------------------------------
// 写入型 action：set_rally
// 把指定类型建筑的集结点设到最近的 target_unit_type 单位附近
// arg_1: 建筑类型，如 "Barracks", "Gateway"
// arg_2: 目标单位类型，如 "CommandCenter", "Probe"
//--------------------------------------------------------------------------------------------------
string libNeuroBridge7vs1_gf_SetRally(string buildingType, string targetUnitType) {
    int lv_player = 1;
    unitgroup lv_buildings;
    unitgroup lv_targets;
    unit lv_target = null;
    unit lv_firstBuilding = null;
    int lv_issuedCount = 0;
    order lv_order = null;
    point lv_rallyPoint = null;
    point lv_firstBuildingPos = null;

    if (buildingType == "" || buildingType == null || targetUnitType == "" || targetUnitType == null) {
        return "ERROR: building_type or target_unit_type is empty.";
    }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, buildingType)) {
        return "ERROR: Invalid building type '" + buildingType + "'.";
    }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, targetUnitType)) {
        return "ERROR: Invalid target unit type '" + targetUnitType + "'.";
    }

    // 找玩家该类型建筑
    lv_buildings = UnitGroup(buildingType, lv_player, RegionEntireMap(),
        UnitFilter((1 << c_targetFilterStructure), 0, (1 << 0), (1 << 1)), 0);
    if (UnitGroupCount(lv_buildings, c_unitCountAll) == 0) {
        return "INFO: No '" + buildingType + "' owned by player.";
    }

    // 找全图该类型目标单位（任意归属）
    lv_targets = UnitGroup(targetUnitType, c_playerAny, RegionEntireMap(),
        UnitFilter(0, 0, (1 << 0), (1 << 1)), 0);
    if (UnitGroupCount(lv_targets, c_unitCountAll) == 0) {
        return "INFO: No '" + targetUnitType + "' found on the map for rally anchor.";
    }

    // 以第一个建筑为锚点找最近目标
    lv_firstBuilding = UnitGroupUnit(lv_buildings, 1);
    if (lv_firstBuilding == null) {
        return "ERROR: Could not resolve building anchor.";
    }
    lv_firstBuildingPos = UnitGetPosition(lv_firstBuilding);
    lv_target = UnitGroupClosestToPoint(lv_targets, lv_firstBuildingPos);
    if (lv_target == null) {
        return "ERROR: Could not find nearest rally anchor.";
    }
    lv_rallyPoint = UnitGetPosition(lv_target);

    // 给所有该类型建筑设集结点（用 Rally ability）
    lv_order = OrderTargetingPoint(AbilityCommand("Rally", 0), lv_rallyPoint);
    UnitGroupLoopBegin(lv_buildings);
    while (!UnitGroupLoopDone()) {
        if (UnitAbilityExists(UnitGroupLoopCurrent(), "Rally") && UnitOrderIsValid(UnitGroupLoopCurrent(), lv_order)) {
            UnitIssueOrder(UnitGroupLoopCurrent(), lv_order, c_orderQueueReplace);
            lv_issuedCount = lv_issuedCount + 1;
        }
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();

    if (lv_issuedCount == 0) {
        return "INFO: No '" + buildingType + "' accepted Rally order (check ability name).";
    }
    return "OK: Set rally point for " + IntToString(lv_issuedCount) + " " + buildingType + " near " + targetUnitType + ".";
}

//--------------------------------------------------------------------------------------------------
// 写入型 action：move_to_unit
// 让指定类型的玩家单位移动到最近的 target_unit_type 单位旁边
// arg_1: 源单位类型，如 "Marine", "SCV"
// arg_2: 目标单位类型，如 "SCV", "CommandCenter"
//--------------------------------------------------------------------------------------------------
string libNeuroBridge7vs1_gf_MoveToUnit(string sourceUnitType, string targetUnitType) {
    int lv_player = 1;
    unitgroup lv_sources;
    unitgroup lv_targets;
    unit lv_target = null;
    unit lv_firstSource = null;
    int lv_issuedCount = 0;
    order lv_order = null;
    point lv_targetPoint = null;
    point lv_firstSourcePos = null;

    if (sourceUnitType == "" || sourceUnitType == null || targetUnitType == "" || targetUnitType == null) {
        return "ERROR: source_unit_type or target_unit_type is empty.";
    }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, sourceUnitType)) {
        return "ERROR: Invalid source unit type '" + sourceUnitType + "'.";
    }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, targetUnitType)) {
        return "ERROR: Invalid target unit type '" + targetUnitType + "'.";
    }

    // 找玩家该类型单位
    lv_sources = UnitGroup(sourceUnitType, lv_player, RegionEntireMap(),
        UnitFilter(0, 0, (1 << 0), (1 << 1)), 0);
    if (UnitGroupCount(lv_sources, c_unitCountAll) == 0) {
        return "INFO: No '" + sourceUnitType + "' owned by player.";
    }

    // 找全图该类型目标单位
    lv_targets = UnitGroup(targetUnitType, c_playerAny, RegionEntireMap(),
        UnitFilter(0, 0, (1 << 0), (1 << 1)), 0);
    if (UnitGroupCount(lv_targets, c_unitCountAll) == 0) {
        return "INFO: No '" + targetUnitType + "' found on the map.";
    }

    // 以第一个源单位为锚点找最近目标
    lv_firstSource = UnitGroupUnit(lv_sources, 1);
    if (lv_firstSource == null) {
        return "ERROR: Could not resolve source anchor.";
    }
    lv_firstSourcePos = UnitGetPosition(lv_firstSource);
    lv_target = UnitGroupClosestToPoint(lv_targets, lv_firstSourcePos);
    if (lv_target == null) {
        return "ERROR: Could not find nearest target.";
    }
    lv_targetPoint = UnitGetPosition(lv_target);

    // 让所有源单位移动到目标位置
    lv_order = OrderTargetingPoint(AbilityCommand("move", 0), lv_targetPoint);
    UnitGroupLoopBegin(lv_sources);
    while (!UnitGroupLoopDone()) {
        if (UnitOrderIsValid(UnitGroupLoopCurrent(), lv_order)) {
            UnitIssueOrder(UnitGroupLoopCurrent(), lv_order, c_orderQueueReplace);
            lv_issuedCount = lv_issuedCount + 1;
        }
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();

    if (lv_issuedCount == 0) {
        return "INFO: No '" + sourceUnitType + "' could move (check pathing or restrictions).";
    }
    return "OK: Ordered " + IntToString(lv_issuedCount) + " " + sourceUnitType + " to move near " + targetUnitType + ".";
}

//--------------------------------------------------------------------------------------------------
// 写入型 action：move_selected_to_unit
// 让当前选中的玩家单位移动到最近的 target_unit_type 单位旁边
// arg_1: 目标单位类型，如 "SCV", "CommandCenter", "Marine"
//--------------------------------------------------------------------------------------------------
string libNeuroBridge7vs1_gf_MoveSelectedToUnit(string targetUnitType) {
    int lv_player = 1;
    unitgroup lv_selected;
    unitgroup lv_targets;
    unit lv_target = null;
    unit lv_firstSelected = null;
    int lv_issuedCount = 0;
    order lv_order = null;
    point lv_targetPoint = null;
    point lv_firstSelectedPos = null;

    if (targetUnitType == "" || targetUnitType == null) {
        return "ERROR: target_unit_type is empty.";
    }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, targetUnitType)) {
        return "ERROR: Invalid target unit type '" + targetUnitType + "'.";
    }

    lv_selected = UnitGroupSelected(lv_player);
    if (UnitGroupCount(lv_selected, c_unitCountAll) == 0) {
        return "INFO: Player has no units selected.";
    }

    lv_targets = UnitGroup(targetUnitType, c_playerAny, RegionEntireMap(),
        UnitFilter(0, 0, (1 << 0), (1 << 1)), 0);
    if (UnitGroupCount(lv_targets, c_unitCountAll) == 0) {
        return "INFO: No '" + targetUnitType + "' found on the map.";
    }

    lv_firstSelected = UnitGroupUnit(lv_selected, 1);
    if (lv_firstSelected == null) {
        return "ERROR: Could not resolve selected unit anchor.";
    }
    lv_firstSelectedPos = UnitGetPosition(lv_firstSelected);
    lv_target = UnitGroupClosestToPoint(lv_targets, lv_firstSelectedPos);
    if (lv_target == null) {
        return "ERROR: Could not find nearest target.";
    }
    lv_targetPoint = UnitGetPosition(lv_target);

    lv_order = OrderTargetingPoint(AbilityCommand("move", 0), lv_targetPoint);
    UnitGroupLoopBegin(lv_selected);
    while (!UnitGroupLoopDone()) {
        if (UnitOrderIsValid(UnitGroupLoopCurrent(), lv_order)) {
            UnitIssueOrder(UnitGroupLoopCurrent(), lv_order, c_orderQueueReplace);
            lv_issuedCount = lv_issuedCount + 1;
        }
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();

    if (lv_issuedCount == 0) {
        return "INFO: No selected unit could move (check pathing or restrictions).";
    }
    return "OK: Ordered " + IntToString(lv_issuedCount) + " selected unit(s) to move near " + targetUnitType + ".";
}

