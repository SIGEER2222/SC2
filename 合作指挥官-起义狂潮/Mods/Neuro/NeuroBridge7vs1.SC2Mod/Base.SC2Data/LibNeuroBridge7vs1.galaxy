include "TriggerLibs/natives"
include "LibNeuroBridge7vs1_h"

//--------------------------------------------------------------------------------------------------
// 初始化：注册 MapInit 触发器（在 NeuroIntegration InitLib 之后调用）
//--------------------------------------------------------------------------------------------------
void libNeuroBridge7vs1_InitLib() {
    if (libNeuroBridge7vs1_initialized) {
        return;
    }
    libNeuroBridge7vs1_gt_MapInit = TriggerCreate("libNeuroBridge7vs1_gt_MapInit_Func");
    TriggerAddEventMapInit(libNeuroBridge7vs1_gt_MapInit);
    libNeuroBridge7vs1_initialized = true;
}

//--------------------------------------------------------------------------------------------------
// 注册 7vs1 专属 action（需要在 NeuroIntegration bank 创建后调用）
// 只读查询型 + 写入型 action 全部注册给 Neuro
//--------------------------------------------------------------------------------------------------
void libNeuroBridge7vs1_gf_RegisterActions() {
    // === 只读查询型 action ===
    libEFA54406_gf_create_action_0_arg("get_mutators", true,
        "Get the currently active mutators, resources and supply in this 7vs1 mission", -1);
    libEFA54406_gf_create_action_0_arg("get_commander_status", true,
        "Get the current commander status including unit count and army composition", -1);
    libEFA54406_gf_create_action_0_arg("get_production_queue", true,
        "Get the current production queue of all buildings", -1);
    libEFA54406_gf_create_action_0_arg("get_active_mutators", true,
        "Get the list of active mutators with semantic descriptions explaining their gameplay impact", -1);

    // === 写入型 action（Neuro 可主动指挥游戏行为）===
    libEFA54406_gf_create_action_1_arg("train_unit", true,
        "Order production of a unit. arg_1 is the unit type id, e.g. Marine, Marauder, SiegeTank, Medivac, Viking",
        "string", -1);
    libEFA54406_gf_create_action_2_arg("use_ability", true,
        "Order a unit to use an ability. arg_1 is the ability id, arg_2 is the target unit type (optional, e.g. Marine for enemy marines)",
        "string", "string", -1);
    libEFA54406_gf_create_action_1_arg("research_upgrade", true,
        "Order research of an upgrade. arg_1 is the upgrade id, e.g. TerranInfantryWeaponsLevel1",
        "string", -1);
}

//--------------------------------------------------------------------------------------------------
// MapInit 触发器：注册心跳循环触发器（不使用 Wait，避免 MapInit 中挂起）
// action 注册和 context 推送延迟到 execute_actions_map 首次调用时执行
//--------------------------------------------------------------------------------------------------
bool libNeuroBridge7vs1_gt_MapInit_Func(bool testConds, bool runActions) {
    if (testConds) {
        return true;
    }
    if (runActions) {
        // 直接注册心跳循环触发器（监听 execute_actions_map 事件）
        // 不在 MapInit 中 Wait，避免触发器挂起
        libNeuroBridge7vs1_gt_ExecuteActionsMap = TriggerCreate("libNeuroBridge7vs1_gt_ExecuteActionsMap_Func");
        TriggerAddEventGeneric(libNeuroBridge7vs1_gt_ExecuteActionsMap, "execute_actions_map");
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// 辅助函数：安全读取 bank flag
//--------------------------------------------------------------------------------------------------
bool libNeuroBridge7vs1_gf_ReadActionFlag(string actionName) {
    if (libEFA54406_gv_neuroIntegration == null) {
        return false;
    }
    return BankValueGetAsFlag(libEFA54406_gv_neuroIntegration, "do_action", actionName);
}

void libNeuroBridge7vs1_gf_ClearActionFlag(string actionName) {
    if (libEFA54406_gv_neuroIntegration == null) {
        return;
    }
    BankValueSetFromFlag(libEFA54406_gv_neuroIntegration, "do_action", actionName, false);
}

string libNeuroBridge7vs1_gf_ReadActionStringArg(string actionName, string argName) {
    if (libEFA54406_gv_neuroIntegration == null) {
        return "";
    }
    return BankValueGetAsString(libEFA54406_gv_neuroIntegration, "do_action", argName);
}

//--------------------------------------------------------------------------------------------------
// 只读查询型 action：get_mutators（已修正：真正查询突变因子，而非只返回资源）
//--------------------------------------------------------------------------------------------------
string libNeuroBridge7vs1_gf_GetMutators() {
    int lv_player = 1;
    int lv_minerals = PlayerGetPropertyInt(lv_player, c_playerPropMinerals);
    int lv_gas = PlayerGetPropertyInt(lv_player, c_playerPropVespene);
    int lv_supplyUsed = PlayerGetPropertyInt(lv_player, c_playerPropSuppliesUsed);
    int lv_supplyMade = PlayerGetPropertyInt(lv_player, c_playerPropSuppliesMade);
    string lv_mutatorList = "";
    int lv_mutatorCount = 0;
    int lv_i = 1;
    string lv_id = "";
    string lv_result = "";

    while (lv_i <= 69) {
        lv_id = libE0EAE146_gf_MutatorIdByIndex(lv_i);
        if (lv_id != "" && lv_id != "Random") {
            if (libA070801C_gf_MutatorIsEnabled(lv_id)) {
                if (lv_mutatorCount > 0) {
                    lv_mutatorList = lv_mutatorList + ", ";
                }
                lv_mutatorList = lv_mutatorList + lv_id;
                lv_mutatorCount = lv_mutatorCount + 1;
            }
        }
        lv_i = lv_i + 1;
    }

    lv_result = "Resources: " + IntToString(lv_minerals) + " min, " +
        IntToString(lv_gas) + " gas. Supply: " +
        IntToString(lv_supplyUsed) + "/" + IntToString(lv_supplyMade) +
        ". Active mutators (" + IntToString(lv_mutatorCount) + "): " + lv_mutatorList + ".";

    return lv_result;
}

//--------------------------------------------------------------------------------------------------
// 只读查询型 action：get_commander_status
//--------------------------------------------------------------------------------------------------
string libNeuroBridge7vs1_gf_GetCommanderStatus() {
    int lv_player = 1;
    unitgroup lv_allUnits = UnitGroup(null, lv_player, RegionEntireMap(), UnitFilter(0, 0, (1 << 0), (1 << 1)), 0);
    int lv_totalUnits = UnitGroupCount(lv_allUnits, c_unitCountAll);

    unitgroup lv_structures = UnitGroup(null, lv_player, RegionEntireMap(),
        UnitFilter((1 << c_targetFilterStructure), 0, (1 << 0), (1 << 1)), 0);
    int lv_structureCount = UnitGroupCount(lv_structures, c_unitCountAll);

    unitgroup lv_army = UnitGroup(null, lv_player, RegionEntireMap(),
        UnitFilter(0, (1 << c_targetFilterStructure) | (1 << c_targetFilterWorker), (1 << 0), (1 << 1)), 0);
    int lv_armyCount = UnitGroupCount(lv_army, c_unitCountAll);

    string lv_result = "Commander status: " + IntToString(lv_totalUnits) + " total units, " +
        IntToString(lv_structureCount) + " structures, " +
        IntToString(lv_armyCount) + " army units.";

    return lv_result;
}

//--------------------------------------------------------------------------------------------------
// 只读查询型 action：get_production_queue
//--------------------------------------------------------------------------------------------------
string libNeuroBridge7vs1_gf_GetProductionQueue() {
    int lv_player = 1;
    unitgroup lv_structures = UnitGroup(null, lv_player, RegionEntireMap(),
        UnitFilter((1 << c_targetFilterStructure), 0, (1 << 0), (1 << 1)), 0);
    string lv_result = "Production queue: ";
    int lv_count = 0;
    unit lv_u = null;
    int lv_queueCount = 0;
    string lv_queueItem = "";

    UnitGroupLoopBegin(lv_structures);
    while (!UnitGroupLoopDone() && lv_count < 10) {
        lv_u = UnitGroupLoopCurrent();
        lv_queueCount = UnitQueueItemCount(lv_u, 0);
        if (lv_queueCount > 0) {
            lv_queueItem = UnitQueueItemGet(lv_u, 0, 0);
            if (lv_queueItem != "" && lv_queueItem != null) {
                lv_result = lv_result + TextToString(UnitGetName(lv_u)) + " -> " + lv_queueItem + "; ";
                lv_count = lv_count + 1;
            }
        }
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();

    if (lv_count == 0) {
        lv_result = lv_result + "No active production.";
    }

    return lv_result;
}

//--------------------------------------------------------------------------------------------------
// 只读查询型 action：get_active_mutators
// 返回激活的突变因子列表 + 每个突变因子的语义化描述（让 Neuro 理解机制）
//--------------------------------------------------------------------------------------------------
string libNeuroBridge7vs1_gf_GetActiveMutators() {
    string lv_result = "Active mutators with semantic descriptions: ";
    int lv_count = 0;
    int lv_i = 1;
    string lv_id = "";
    string lv_desc = "";

    while (lv_i <= 69) {
        lv_id = libE0EAE146_gf_MutatorIdByIndex(lv_i);
        if (lv_id != "" && lv_id != "Random") {
            if (libA070801C_gf_MutatorIsEnabled(lv_id)) {
                lv_desc = libNeuroBridge7vs1_gf_GetMutatorSemanticDescription(lv_id);
                if (lv_count > 0) {
                    lv_result = lv_result + " | ";
                }
                lv_result = lv_result + "[" + lv_id + "] " + lv_desc;
                lv_count = lv_count + 1;
            }
        }
        lv_i = lv_i + 1;
    }

    if (lv_count == 0) {
        lv_result = lv_result + "No active mutators (preset 0 or not started).";
    } else {
        lv_result = lv_result + " Total: " + IntToString(lv_count) + " mutator(s).";
    }

    return lv_result;
}

//--------------------------------------------------------------------------------------------------
// 写入型 action：train_unit
// 让 Neuro 指挥生产单位
// arg_1: 单位类型 ID（如 "Marine", "SiegeTank", "Medivac"）
// 实现：查找能生产该单位的建筑，下订单
//--------------------------------------------------------------------------------------------------
string libNeuroBridge7vs1_gf_TrainUnit(string unitType) {
    int lv_player = 1;
    unitgroup lv_structures;
    unit lv_building = null;
    int lv_queueCount = 0;
    string lv_abilCmd = "";
    order lv_order = null;
    string lv_buildAbil = "";
    order lv_order2 = null;

    if (!CatalogEntryIsValid(c_gameCatalogUnit, unitType)) {
        return "ERROR: Invalid unit type '" + unitType + "'.";
    }

    lv_structures = UnitGroup(null, lv_player, RegionEntireMap(),
        UnitFilter((1 << c_targetFilterStructure), 0, (1 << 0), (1 << 1)), 0);

    if (UnitGroupCount(lv_structures, c_unitCountAll) == 0) {
        return "ERROR: No production structures available.";
    }

    UnitGroupLoopBegin(lv_structures);
    while (!UnitGroupLoopDone()) {
        lv_building = UnitGroupLoopCurrent();
        lv_queueCount = UnitQueueItemCount(lv_building, 0);

        if (lv_queueCount < 5) {
            lv_abilCmd = "Train" + unitType;
            if (CatalogEntryIsValid(c_gameCatalogAbil, lv_abilCmd)) {
                lv_order = Order(AbilityCommand(lv_abilCmd, 0));
                if (UnitOrderIsValid(lv_building, lv_order)) {
                    UnitIssueOrder(lv_building, lv_order, c_orderQueueReplace);
                    UnitGroupLoopEnd();
                    return "OK: Ordered " + unitType + " from " + TextToString(UnitGetName(lv_building)) + ".";
                }
            }

            lv_buildAbil = CatalogReferenceGet("Units," + unitType + ",BuiltFrom", lv_player);
            if (lv_buildAbil != "" && lv_buildAbil != null) {
                lv_order2 = Order(AbilityCommand(unitType + "Train", 0));
                if (UnitOrderIsValid(lv_building, lv_order2)) {
                    UnitIssueOrder(lv_building, lv_order2, c_orderQueueReplace);
                    UnitGroupLoopEnd();
                    return "OK: Ordered " + unitType + " from " + TextToString(UnitGetName(lv_building)) + ".";
                }
            }
        }
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();

    return "ERROR: Could not find a building that can train " + unitType + ". Check tech tree and requirements.";
}

//--------------------------------------------------------------------------------------------------
// 写入型 action：use_ability
// 让 Neuro 指挥使用单位技能
// arg_1: 技能 ID（如 "Stimpack", "YamatoCannon", "SiegeMode"）
// arg_2: 目标单位类型（可选，用于筛选目标）
//--------------------------------------------------------------------------------------------------
string libNeuroBridge7vs1_gf_UseAbility(string abilityId, string targetUnitType) {
    int lv_player = 1;
    unitgroup lv_allUnits;
    unit lv_caster = null;
    bool lv_enabled = false;
    fixed lv_cooldown = 0.0;
    order lv_order = null;
    unitgroup lv_enemies;
    unit lv_target = null;

    // 校验技能是否有效
    if (!CatalogEntryIsValid(c_gameCatalogAbil, abilityId)) {
        return "ERROR: Invalid ability '" + abilityId + "'.";
    }

    // 查找玩家所有有该技能的单位
    lv_allUnits = UnitGroup(null, lv_player, RegionEntireMap(),
        UnitFilter(0, 0, (1 << 0), (1 << 1)), 0);

    if (UnitGroupCount(lv_allUnits, c_unitCountAll) == 0) {
        return "ERROR: No units available.";
    }

    // 遍历单位，找到第一个有该技能且能使用的
    UnitGroupLoopBegin(lv_allUnits);
    while (!UnitGroupLoopDone()) {
        lv_caster = UnitGroupLoopCurrent();

        // 检查单位是否有该技能
        if (UnitAbilityExists(lv_caster, abilityId)) {
            // 检查技能是否就绪：未被禁用 + 冷却完毕
            lv_enabled = UnitAbilityCheck(lv_caster, abilityId, false);
            lv_cooldown = UnitAbilityGetCooldown(lv_caster, abilityId, "");
            if (lv_enabled && lv_cooldown <= 0.0) {
                lv_order = Order(AbilityCommand(abilityId, 0));

                // 如果有目标单位类型，找到最近的敌方单位
                if (targetUnitType != "" && targetUnitType != null) {
                    lv_enemies = UnitGroup(targetUnitType, c_playerAny, RegionEntireMap(),
                        UnitFilter(0, 0, (1 << 0), (1 << 1)), 0);

                    if (UnitGroupCount(lv_enemies, c_unitCountAll) > 0) {
                        lv_target = UnitGroupClosestToPoint(lv_enemies, UnitGetPosition(lv_caster));
                        if (lv_target != null) {
                            lv_order = OrderTargetingUnit(AbilityCommand(abilityId, 0), lv_target);
                        }
                    }
                }

                // 尝试下订单（UnitOrderIsValid 签名为 (unit, order)）
                if (UnitOrderIsValid(lv_caster, lv_order)) {
                    UnitIssueOrder(lv_caster, lv_order, c_orderQueueReplace);
                    UnitGroupLoopEnd();
                    return "OK: " + TextToString(UnitGetName(lv_caster)) + " is using " + abilityId + ".";
                }
            }
        }
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();

    return "ERROR: No unit can use " + abilityId + " right now. Check cooldown, energy, or tech requirements.";
}

//--------------------------------------------------------------------------------------------------
// 写入型 action：research_upgrade
// 让 Neuro 指挥研究升级
// arg_1: 升级 ID（如 "TerranInfantryWeaponsLevel1"）
//--------------------------------------------------------------------------------------------------
string libNeuroBridge7vs1_gf_ResearchUpgrade(string upgradeId) {
    int lv_player = 1;
    unitgroup lv_structures;
    unit lv_building = null;
    int lv_queueCount = 0;
    string lv_abilCmd1 = "";
    string lv_abilCmd2 = "";
    order lv_order1 = null;
    order lv_order2 = null;

    // 校验升级是否有效
    if (!CatalogEntryIsValid(c_gameCatalogUpgrade, upgradeId)) {
        return "ERROR: Invalid upgrade '" + upgradeId + "'.";
    }

    // 检查是否已研究
    if (TechTreeUpgradeCount(lv_player, upgradeId, c_techCountCompleteOnly) > 0) {
        return "ERROR: Upgrade " + upgradeId + " is already researched.";
    }

    // 查找所有建筑
    lv_structures = UnitGroup(null, lv_player, RegionEntireMap(),
        UnitFilter((1 << c_targetFilterStructure), 0, (1 << 0), (1 << 1)), 0);

    if (UnitGroupCount(lv_structures, c_unitCountAll) == 0) {
        return "ERROR: No structures available for research.";
    }

    // 遍历建筑，找到第一个能研究该升级的
    UnitGroupLoopBegin(lv_structures);
    while (!UnitGroupLoopDone()) {
        lv_building = UnitGroupLoopCurrent();
        lv_queueCount = UnitQueueItemCount(lv_building, 0);

        if (lv_queueCount < 5) {
            // 尝试用 <UpgradeId>Research 或 Research<UpgradeId> 命令
            lv_abilCmd1 = "Research_" + upgradeId;
            lv_abilCmd2 = upgradeId;

            lv_order1 = Order(AbilityCommand(lv_abilCmd1, 0));
            if (UnitOrderIsValid(lv_building, lv_order1)) {
                UnitIssueOrder(lv_building, lv_order1, c_orderQueueReplace);
                UnitGroupLoopEnd();
                return "OK: Researching " + upgradeId + " at " + TextToString(UnitGetName(lv_building)) + ".";
            }

            lv_order2 = Order(AbilityCommand(lv_abilCmd2, 0));
            if (UnitOrderIsValid(lv_building, lv_order2)) {
                UnitIssueOrder(lv_building, lv_order2, c_orderQueueReplace);
                UnitGroupLoopEnd();
                return "OK: Researching " + upgradeId + " at " + TextToString(UnitGetName(lv_building)) + ".";
            }
        }
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();

    return "ERROR: Could not find a building that can research " + upgradeId + ".";
}

//--------------------------------------------------------------------------------------------------
// 突变因子语义对齐：推送突变因子 context 给 Neuro
// 在地图初始化后调用，让 Neuro 理解当前游戏的突变机制
//--------------------------------------------------------------------------------------------------
void libNeuroBridge7vs1_gf_PushMutatorContext() {
    string lv_context = "";

    if (libNeuroBridge7vs1_mutatorContextPushed) {
        return;
    }

    // 检查突变因子系统是否已启动（用已启用数量 > 0 替代全局变量检查）
    if (libA070801C_gf_CT_MutatorEnabledCount() <= 0) {
        return;
    }

    lv_context = libNeuroBridge7vs1_gf_GetActiveMutators();
    libEFA54406_gf_create_context("mutator_semantic_info", lv_context, false);

    libNeuroBridge7vs1_mutatorContextPushed = true;
}

//--------------------------------------------------------------------------------------------------
// 突变因子语义描述生成器
// 为每个突变因子生成 Neuro 可理解的语义化描述
// 让 Neuro 理解突变机制如何影响游戏玩法
//--------------------------------------------------------------------------------------------------
string libNeuroBridge7vs1_gf_GetMutatorSemanticDescription(string mutatorId) {
    // 先尝试从 UserData 读取本地化名称和描述
    text lv_name = libA070801C_gf_CT_MutatorName(mutatorId);
    text lv_desc = libA070801C_gf_CT_MutatorDescription(mutatorId);
    string lv_nameStr = TextToString(lv_name);
    string lv_descStr = TextToString(lv_desc);

    // 为常见突变因子添加语义化说明（让 Neuro 理解机制影响）
    string lv_semantic = "";

    if (mutatorId == "Barrier") {
        lv_semantic = "Enemy units gain shields when not taking damage for 4 seconds. Focus fire to break shields.";
    } else if (mutatorId == "Avenger") {
        lv_semantic = "Enemy units gain 25% attack speed and damage when nearby units die. Kill isolated enemies first.";
    } else if (mutatorId == "VoidRifts") {
        lv_semantic = "Void rifts spawn periodically and summon shadows. Destroy rifts quickly to prevent being overwhelmed.";
    } else if (mutatorId == "UnitSpeed") {
        lv_semantic = "All enemy units move 50% faster. Position defenses earlier and use slowing abilities.";
    } else if (mutatorId == "HybridNuke") {
        lv_semantic = "Hybrid units cast nuclear strikes. Spread units and watch for targeting reticle.";
    } else if (mutatorId == "LazyWorkers") {
        lv_semantic = "Workers periodically stop and daydream. Build extra workers to compensate.";
    } else if (mutatorId == "BlackDeath") {
        lv_semantic = "Enemy units spread a deadly plague on death. Avoid clustering near dying enemies.";
    } else if (mutatorId == "JustDie") {
        lv_semantic = "Units explode on death dealing area damage. Don't cluster your units.";
    } else if (mutatorId == "Twister") {
        lv_semantic = "Tornados spawn randomly and damage units. Keep units mobile and avoid standing in tornado paths.";
    } else if (mutatorId == "PolarityShift") {
        lv_semantic = "Units alternate between damage types. Some units only take damage from specific damage types.";
    } else if (mutatorId == "MineralIncome") {
        lv_semantic = "Mineral income is modified. Adjust build orders accordingly.";
    } else if (mutatorId == "Outbreak") {
        lv_semantic = "Infested terrans spawn periodically. Clear them before they overwhelm your base.";
    } else if (mutatorId == "DarkVision") {
        lv_semantic = "Enemy units have reduced vision but your detection is also limited. Use detector units.";
    } else if (mutatorId == "SpeedFreaks") {
        lv_semantic = "All units move faster. Combat is more fast-paced, micro more important.";
    } else if (mutatorId == "StoneZealots") {
        lv_semantic = "Special enemy zealot units spawn. They are tough, focus fire to take them down.";
    } else {
        // 默认：使用 UserData 的名称和描述
        if (lv_nameStr != "" && lv_descStr != "") {
            return lv_nameStr + ": " + lv_descStr;
        } else if (lv_nameStr != "") {
            return lv_nameStr + " (no description available)";
        } else {
            return mutatorId + " (unknown mutator, check game data)";
        }
    }

    // 如果有语义化说明，组合返回
    if (lv_nameStr != "") {
        return lv_nameStr + " - " + lv_semantic;
    } else {
        return mutatorId + " - " + lv_semantic;
    }
}

//--------------------------------------------------------------------------------------------------
// 心跳循环触发器：处理 7vs1 专属 action + 维护心跳 + 回调全局循环
// 这是 NeuroIntegration Bank IPC 协议的地图侧实现
//--------------------------------------------------------------------------------------------------
bool libNeuroBridge7vs1_gt_ExecuteActionsMap_Func(bool testConds, bool runActions) {
    string lv_result = "";
    string lv_unitType = "";
    string lv_abilId = "";
    string lv_target = "";
    string lv_upgradeId = "";

    if (testConds) {
        return true;
    }
    if (runActions) {
        // === 0. 首次调用：注册 action + 推送突变因子 context ===
        if (!libNeuroBridge7vs1_actionsRegistered) {
            // 检查 NeuroIntegration bank 是否已创建
            if (libEFA54406_gv_neuroIntegration != null) {
                libNeuroBridge7vs1_gf_RegisterActions();
                libNeuroBridge7vs1_actionsRegistered = true;
                // 推送突变因子语义上下文
                libNeuroBridge7vs1_gf_PushMutatorContext();
                // 推送上一次任务摘要（跨任务记忆）
                libNeuroBridge7vs1_gf_PushLastMissionSummary();
            }
        }

        // === 1. 处理只读查询型 action ===
        if (libNeuroBridge7vs1_gf_ReadActionFlag("get_mutators")) {
            libNeuroBridge7vs1_gf_ClearActionFlag("get_mutators");
            lv_result = libNeuroBridge7vs1_gf_GetMutators();
            libEFA54406_gf_create_context("mutators_info", lv_result, true);
        }

        if (libNeuroBridge7vs1_gf_ReadActionFlag("get_commander_status")) {
            libNeuroBridge7vs1_gf_ClearActionFlag("get_commander_status");
            lv_result = libNeuroBridge7vs1_gf_GetCommanderStatus();
            libEFA54406_gf_create_context("commander_status", lv_result, true);
        }

        if (libNeuroBridge7vs1_gf_ReadActionFlag("get_production_queue")) {
            libNeuroBridge7vs1_gf_ClearActionFlag("get_production_queue");
            lv_result = libNeuroBridge7vs1_gf_GetProductionQueue();
            libEFA54406_gf_create_context("production_queue", lv_result, true);
        }

        if (libNeuroBridge7vs1_gf_ReadActionFlag("get_active_mutators")) {
            libNeuroBridge7vs1_gf_ClearActionFlag("get_active_mutators");
            lv_result = libNeuroBridge7vs1_gf_GetActiveMutators();
            libEFA54406_gf_create_context("active_mutators", lv_result, true);
        }

        // === 2. 处理写入型 action ===
        if (libNeuroBridge7vs1_gf_ReadActionFlag("train_unit")) {
            libNeuroBridge7vs1_gf_ClearActionFlag("train_unit");
            lv_unitType = libNeuroBridge7vs1_gf_ReadActionStringArg("train_unit", "train_unit_arg_1");
            lv_result = libNeuroBridge7vs1_gf_TrainUnit(lv_unitType);
            libEFA54406_gf_create_context("train_unit_result", lv_result, false);
        }

        if (libNeuroBridge7vs1_gf_ReadActionFlag("use_ability")) {
            libNeuroBridge7vs1_gf_ClearActionFlag("use_ability");
            lv_abilId = libNeuroBridge7vs1_gf_ReadActionStringArg("use_ability", "use_ability_arg_1");
            lv_target = libNeuroBridge7vs1_gf_ReadActionStringArg("use_ability", "use_ability_arg_2");
            lv_result = libNeuroBridge7vs1_gf_UseAbility(lv_abilId, lv_target);
            libEFA54406_gf_create_context("use_ability_result", lv_result, false);
        }

        if (libNeuroBridge7vs1_gf_ReadActionFlag("research_upgrade")) {
            libNeuroBridge7vs1_gf_ClearActionFlag("research_upgrade");
            lv_upgradeId = libNeuroBridge7vs1_gf_ReadActionStringArg("research_upgrade", "research_upgrade_arg_1");
            lv_result = libNeuroBridge7vs1_gf_ResearchUpgrade(lv_upgradeId);
            libEFA54406_gf_create_context("research_upgrade_result", lv_result, false);
        }

        // === 3. 心跳信号递增（Python 运行时据此检测游戏是否活跃）===
        if (libEFA54406_gv_neuroIntegration != null) {
            BankValueSetFromInt(libEFA54406_gv_neuroIntegration, "game_state", "active",
                BankValueGetAsInt(libEFA54406_gv_neuroIntegration, "game_state", "active") + 1);
            BankSave(libEFA54406_gv_neuroIntegration);
        }

        // === 4. 等待 Python 运行时处理 bank ===
        Wait(0.4, c_timeGame);

        // === 5. 重新加载 bank + 保存 ===
        if (libEFA54406_gv_neuroIntegration != null) {
            BankReload(libEFA54406_gv_neuroIntegration);
            BankWait(libEFA54406_gv_neuroIntegration);
            BankSave(libEFA54406_gv_neuroIntegration);
        }

        // === 6. 短暂解锁 bankwriteallowed 让 Python 写入 ===
        libEFA54406_gv_bankwriteallowed = true;
        Wait(0.2, c_timeGame);
        libEFA54406_gv_bankwriteallowed = false;

        // === 7. 回调全局循环 ===
        TriggerSendEvent("execute_actions_global");
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Phase B: 角色对话推送
// 推送 Transmission context 给 Neuro，让 Neuro 知道游戏中的角色在说什么
//--------------------------------------------------------------------------------------------------
void libNeuroBridge7vs1_gf_PushTransmissionContext(string soundLink, string speakerName, string subtitleText, bool silent) {
    string lv_context = "";

    if (speakerName == "") {
        speakerName = "Unknown";
    }

    if (subtitleText != "") {
        lv_context = speakerName + ": " + subtitleText;
    } else {
        lv_context = speakerName + " is speaking.";
    }

    libEFA54406_gf_create_context("transmission", lv_context, silent);
}

//--------------------------------------------------------------------------------------------------
// Phase C: 永久能力系统
// 使用 NeuroPermanent.SC2Bank 跨任务持久化已解锁的 action 和任务摘要
//--------------------------------------------------------------------------------------------------
bool libNeuroBridge7vs1_gf_LoadPermanentBank() {
    if (libNeuroBridge7vs1_gv_permanentBank != null) {
        return true;
    }
    libNeuroBridge7vs1_gv_permanentBank = BankLoad("NeuroPermanent", 1);
    if (libNeuroBridge7vs1_gv_permanentBank == null) {
        return false;
    }
    BankWait(libNeuroBridge7vs1_gv_permanentBank);
    return true;
}

void libNeuroBridge7vs1_gf_UnlockAction(string actionName) {
    if (!libNeuroBridge7vs1_gf_LoadPermanentBank()) {
        return;
    }
    BankValueSetFromInt(libNeuroBridge7vs1_gv_permanentBank, "unlocked_actions", actionName, 1);
    BankSave(libNeuroBridge7vs1_gv_permanentBank);
}

bool libNeuroBridge7vs1_gf_IsActionUnlocked(string actionName) {
    if (!libNeuroBridge7vs1_gf_LoadPermanentBank()) {
        return false;
    }
    return (BankValueGetAsInt(libNeuroBridge7vs1_gv_permanentBank, "unlocked_actions", actionName) > 0);
}

void libNeuroBridge7vs1_gf_SaveMissionSummary(string mapId, string summary) {
    if (!libNeuroBridge7vs1_gf_LoadPermanentBank()) {
        return;
    }
    BankValueSetFromString(libNeuroBridge7vs1_gv_permanentBank, "mission_summaries", mapId, summary);
    BankSave(libNeuroBridge7vs1_gv_permanentBank);
}

string libNeuroBridge7vs1_gf_GetLastMissionSummary() {
    if (!libNeuroBridge7vs1_gf_LoadPermanentBank()) {
        return "";
    }
    string lv_lastMap = BankValueGetAsString(libNeuroBridge7vs1_gv_permanentBank, "mission_summaries", "last_mission");
    if (lv_lastMap == "") {
        return "";
    }
    return BankValueGetAsString(libNeuroBridge7vs1_gv_permanentBank, "mission_summaries", lv_lastMap);
}

//--------------------------------------------------------------------------------------------------
// Phase D: 任务间隙逻辑
// 任务胜利/失败钩子 + 跨任务记忆推送
//--------------------------------------------------------------------------------------------------
void libNeuroBridge7vs1_gf_OnMissionVictory(string mapId, int bonusObjectives) {
    string lv_summary = "";

    lv_summary = "Mission " + mapId + " completed with " + IntToString(bonusObjectives) + " bonus objectives.";
    libNeuroBridge7vs1_gf_SaveMissionSummary(mapId, lv_summary);

    if (libNeuroBridge7vs1_gf_LoadPermanentBank()) {
        BankValueSetFromString(libNeuroBridge7vs1_gv_permanentBank, "mission_summaries", "last_mission", mapId);
        BankSave(libNeuroBridge7vs1_gv_permanentBank);
    }

    libEFA54406_gf_create_context("mission_victory", lv_summary, false);
}

void libNeuroBridge7vs1_gf_OnMissionDefeat(string mapId) {
    string lv_summary = "";

    lv_summary = "Mission " + mapId + " failed.";
    libNeuroBridge7vs1_gf_SaveMissionSummary(mapId, lv_summary);

    if (libNeuroBridge7vs1_gf_LoadPermanentBank()) {
        BankValueSetFromString(libNeuroBridge7vs1_gv_permanentBank, "mission_summaries", "last_mission", mapId);
        BankSave(libNeuroBridge7vs1_gv_permanentBank);
    }

    libEFA54406_gf_create_context("mission_defeat", lv_summary, false);
}

void libNeuroBridge7vs1_gf_PushLastMissionSummary() {
    string lv_summary = "";

    lv_summary = libNeuroBridge7vs1_gf_GetLastMissionSummary();
    if (lv_summary != "") {
        libEFA54406_gf_create_context("last_mission_summary", lv_summary, true);
    }
}
