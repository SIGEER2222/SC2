        <Element Type="FunctionDef" Id="5108EECF">
            <Identifier>ForEachPlayerInGroup</Identifier>
            <Label Type="Label" Library="Ntve" Id="00000011"/>
            <FlagAction/>
            <FlagSubFunctions/>
            <FlagAllowBreak/>
            <Parameter Type="ParamDef" Library="KCOR" Id="68CF8B95"/>
            <SubFunctionType Type="SubFuncType" Library="KCOR" Id="8B5407FF"/>
            <ScriptCode>
                #AUTOVAR(playerPool, playergroup) = PlayerGroupAll();
                #AUTOVAR(itPlayer) = 0;
                #AUTOVAR(itTestPool, playergroup)=null;
                while (PlayerGroupCount(#AUTOVAR(playerPool))) {
                    #AUTOVAR(itPlayer) = PlayerGroupPlayer(#AUTOVAR(playerPool), 1);
                    #AUTOVAR(itTestPool) = libKCOR_gf_MutualAlliedCommandersofPlayerCoutInactiveAndSelf(#AUTOVAR(itPlayer));
                    PlayerGroupRemove(#AUTOVAR(playerPool), #AUTOVAR(itPlayer));
                    libNtve_gf_RemovePlayerGroupFromPlayerGroup(libNtve_gf_AlliesEnemiesOfPlayerCountInactiveAndSelf(libNtve_ge_PlayerRelation_AllyMutual,#AUTOVAR(itPlayer)), #AUTOVAR(playerPool));
                    if(PlayerGroupCount(#AUTOVAR(itTestPool))){
                        #PARAM(var) = #AUTOVAR(itTestPool);
                        #SUBFUNCS(actions)
                    }
                }
            </ScriptCode>
        </Element>
