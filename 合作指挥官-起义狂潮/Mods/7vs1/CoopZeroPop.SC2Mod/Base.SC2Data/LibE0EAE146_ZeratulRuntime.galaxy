void libE0EAE146_gt_CM_Zeratul_PurificationNova_Finale_Init () {
    libE0EAE146_gt_CM_Zeratul_PurificationNova_Finale = TriggerCreate("libE0EAE146_gt_CM_Zeratul_PurificationNova_Finale_Func");
    TriggerEnable(libE0EAE146_gt_CM_Zeratul_PurificationNova_Finale, false);
    TriggerAddEventUnitBehaviorChange(libE0EAE146_gt_CM_Zeratul_PurificationNova_Finale, null, "ZeratulPurificationNovaTargettedTarget", c_unitBehaviorChangeDeactivate);
