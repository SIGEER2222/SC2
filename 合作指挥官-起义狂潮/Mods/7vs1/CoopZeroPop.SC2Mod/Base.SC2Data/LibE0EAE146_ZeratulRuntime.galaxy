string libE0EAE146_gf_ZeratulArtifactUnitType (int lp_artifactNumber) {
    if (lp_artifactNumber == 1) {
        return "ZeratulArtifactPickup1";
    }
    else if (lp_artifactNumber == 2) {
        return "ZeratulArtifactPickup2";
    }
    else if (lp_artifactNumber == 3) {
        return "ZeratulArtifactPickup3";
    }
    else {
        return "ZeratulArtifactPickupUnlimited";
    }
}

point libE0EAE146_gf_ZeratulArtifactPlacementPoint (int lp_player, int lp_artifactNumber) {
    // Keep the smoke-test artifact reachable without depending on official per-map placement UserData.
    point lv_candidate;
    point lv_placement;
    fixed lv_distance;
    fixed lv_angle;

    lv_distance = 24.0 + (IntToFixed(lp_artifactNumber) * 8.0);
    lv_angle = 45.0 + (IntToFixed(lp_artifactNumber) * 95.0);
    lv_candidate = PointWithOffsetPolar(PlayerStartLocation(lp_player), lv_distance, lv_angle);
    lv_placement = UnitTypePlacementFromPoint(libE0EAE146_gf_ZeratulArtifactUnitType(lp_artifactNumber), lp_player, lv_candidate, 12.0);
    if (lv_placement != null) {
        return lv_placement;
    }

    lv_candidate = MidPoint(RegionGetBoundsMin(RegionPlayableMap()), RegionGetBoundsMax(RegionPlayableMap()));
    lv_placement = UnitTypePlacementFromPoint(libE0EAE146_gf_ZeratulArtifactUnitType(lp_artifactNumber), lp_player, lv_candidate, 64.0);
    if (lv_placement != null) {
        return lv_placement;
    }

    return PlayerStartLocation(lp_player);
}

void libE0EAE146_gf_ZeratulPlaceArtifact (int lp_player) {
    point lv_point;
    string lv_unitType;

    if ((lp_player <= 0) || (libE0EAE146_gv_zeratulArtifactNumber <= 0)) {
        return;
    }

    lv_unitType = libE0EAE146_gf_ZeratulArtifactUnitType(libE0EAE146_gv_zeratulArtifactNumber);
    if (!CatalogEntryIsValid(c_gameCatalogUnit, lv_unitType)) {
        return;
    }

    if (UnitIsValid(libE0EAE146_gv_zeratulArtifact) == true) {
        UnitRemove(libE0EAE146_gv_zeratulArtifact);
    }

    lv_point = libE0EAE146_gf_ZeratulArtifactPlacementPoint(lp_player, libE0EAE146_gv_zeratulArtifactNumber);
    UnitCreate(1, lv_unitType, 0, lp_player, lv_point, 225.0);
    libE0EAE146_gv_zeratulArtifact = UnitLastCreated();
}

