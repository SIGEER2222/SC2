    libE0EAE146_gt_CM_Zeratul_AutomatedAssimilatorAutoBuild = TriggerCreate("libE0EAE146_gt_CM_Zeratul_AutomatedAssimilatorAutoBuild_Func");
    TriggerEnable(libE0EAE146_gt_CM_Zeratul_AutomatedAssimilatorAutoBuild, false);
    TriggerAddEventPlayerEffectUsed(libE0EAE146_gt_CM_Zeratul_AutomatedAssimilatorAutoBuild, c_playerAny, "NexusCreateSet");
    TriggerAddEventPlayerEffectUsed(libE0EAE146_gt_CM_Zeratul_AutomatedAssimilatorAutoBuild, c_playerAny, "NexusBirthSet");
}

