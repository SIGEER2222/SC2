void libE0EAE146_gf_GenericBonusApplyResources (bool lp_doubleMinerals, bool lp_doubleVespene, bool lp_richResources) {
    unitgroup lv_resourceNodes;
    unit lv_resourceUnit;
    string lv_resourceType;
    string lv_behavior;
    fixed lv_resourceAmount;
    int lv_mineralNodeCount;
    int lv_gasNodeCount;
    string lv_mineralSampleBehavior;
    string lv_gasSampleBehavior;
    int lv_mineralSampleAmount;
    int lv_gasSampleAmount;

    lv_resourceNodes = UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter((1 << c_targetFilterRawResource), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
    UnitGroupAddUnitGroup(lv_resourceNodes, UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter((1 << c_targetFilterHarvestableResource), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    lv_mineralNodeCount = 0;
    lv_gasNodeCount = 0;
    lv_mineralSampleBehavior = "";
    lv_gasSampleBehavior = "";
    lv_mineralSampleAmount = 0;
    lv_gasSampleAmount = 0;
    lv_resourceUnit = UnitGroupUnit(lv_resourceNodes, 1);
    while (lv_resourceUnit != null) {
        lv_resourceType = CatalogFieldValueGet(c_gameCatalogUnit, UnitGetType(lv_resourceUnit), "ResourceType", c_playerAny);
        if (lv_resourceType == "Minerals") {
            lv_resourceAmount = libNtve_gf_UnitGetPropertyResources(lv_resourceUnit, c_unitPropCurrent);
            lv_behavior = "";
            if (UnitHasBehavior2(lv_resourceUnit, "MineralFieldMinerals")) {
                lv_behavior = "MineralFieldMinerals";
            }
            else if (UnitHasBehavior2(lv_resourceUnit, "MineralFieldMinerals750")) {
                lv_behavior = "MineralFieldMinerals750";
            }
            else if (UnitHasBehavior2(lv_resourceUnit, "HighYieldMineralFieldMinerals")) {
                lv_behavior = "HighYieldMineralFieldMinerals";
            }
            else if (UnitHasBehavior2(lv_resourceUnit, "HighYieldMineralFieldMinerals750")) {
                lv_behavior = "HighYieldMineralFieldMinerals750";
            }
            else if (UnitHasBehavior2(lv_resourceUnit, "MineralFieldMineralsNoRemove")) {
                lv_behavior = "MineralFieldMineralsNoRemove";
            }

            if (lv_behavior != "") {
                UnitBehaviorRemove(lv_resourceUnit, "MineralFieldMinerals", 1);
                UnitBehaviorRemove(lv_resourceUnit, "MineralFieldMinerals750", 1);
                UnitBehaviorRemove(lv_resourceUnit, "HighYieldMineralFieldMinerals", 1);
                UnitBehaviorRemove(lv_resourceUnit, "HighYieldMineralFieldMinerals750", 1);
                UnitBehaviorRemove(lv_resourceUnit, "MineralFieldMineralsNoRemove", 1);

                if (lp_richResources) {
                    if ((lv_behavior == "MineralFieldMinerals750") || (lv_behavior == "HighYieldMineralFieldMinerals750")) {
                        lv_behavior = "HighYieldMineralFieldMinerals750";
                    }
                    else {
                        lv_behavior = "HighYieldMineralFieldMinerals";
                    }
                }
                else {
                    if ((lv_behavior == "HighYieldMineralFieldMinerals750") || (lv_behavior == "MineralFieldMinerals750")) {
                        lv_behavior = "MineralFieldMinerals750";
                    }
                    else if (lv_behavior == "MineralFieldMineralsNoRemove") {
                        lv_behavior = "MineralFieldMineralsNoRemove";
                    }
                    else {
                        lv_behavior = "MineralFieldMinerals";
                    }
                }

                UnitBehaviorAdd(lv_resourceUnit, lv_behavior, lv_resourceUnit, 1);
                if (lp_doubleMinerals) {
                    lv_resourceAmount = (lv_resourceAmount * 2.0);
                }
                UnitSetPropertyFixed(lv_resourceUnit, c_unitPropResources, lv_resourceAmount);
                lv_mineralNodeCount += 1;
                if (lv_mineralSampleBehavior == "") {
                    lv_mineralSampleBehavior = lv_behavior;
                    lv_mineralSampleAmount = FixedToInt(lv_resourceAmount);
                }
            }
        }
        else if ((lv_resourceType == "Vespene") && UnitFilterMatch(lv_resourceUnit, 1, UnitFilter((1 << c_targetFilterRawResource), 0, 0, 0))) {
            lv_resourceAmount = libNtve_gf_UnitGetPropertyResources(lv_resourceUnit, c_unitPropCurrent);
            lv_behavior = "";
            if (UnitHasBehavior2(lv_resourceUnit, "RawRichVespeneGeyserGas")) {
                lv_behavior = "RawRichVespeneGeyserGas";
            }
            else if (UnitHasBehavior2(lv_resourceUnit, "RawVespeneGeyserGas")) {
                lv_behavior = "RawVespeneGeyserGas";
            }

            if (lv_behavior != "") {
                UnitBehaviorRemove(lv_resourceUnit, "RawVespeneGeyserGas", 1);
                UnitBehaviorRemove(lv_resourceUnit, "RawRichVespeneGeyserGas", 1);
                if (lp_richResources) {
                    lv_behavior = "RawRichVespeneGeyserGas";
                }
                else {
                    lv_behavior = "RawVespeneGeyserGas";
                }
                UnitBehaviorAdd(lv_resourceUnit, lv_behavior, lv_resourceUnit, 1);
                if (lp_doubleVespene) {
                    lv_resourceAmount = (lv_resourceAmount * 2.0);
                }
                UnitSetPropertyFixed(lv_resourceUnit, c_unitPropResources, lv_resourceAmount);
                lv_gasNodeCount += 1;
                if (lv_gasSampleBehavior == "") {
                    lv_gasSampleBehavior = lv_behavior;
                    lv_gasSampleAmount = FixedToInt(lv_resourceAmount);
                }
            }
        }

        UnitGroupRemove(lv_resourceNodes, lv_resourceUnit);
        lv_resourceUnit = UnitGroupUnit(lv_resourceNodes, 1);
    }

    BankLoad("CampaignXCore", 1);
    BankValueSetFromInt(BankLastCreated(), "XMRuntimeDebug", "GenericBonusMineralNodesProcessed", lv_mineralNodeCount);
    BankValueSetFromInt(BankLastCreated(), "XMRuntimeDebug", "GenericBonusGasNodesProcessed", lv_gasNodeCount);
    if (lv_mineralSampleBehavior != "") {
        BankValueSetFromString(BankLastCreated(), "XMRuntimeDebug", "GenericBonusMineralSampleBehavior", lv_mineralSampleBehavior);
        BankValueSetFromInt(BankLastCreated(), "XMRuntimeDebug", "GenericBonusMineralSampleAmount", lv_mineralSampleAmount);
    }
    if (lv_gasSampleBehavior != "") {
        BankValueSetFromString(BankLastCreated(), "XMRuntimeDebug", "GenericBonusGasSampleBehavior", lv_gasSampleBehavior);
        BankValueSetFromInt(BankLastCreated(), "XMRuntimeDebug", "GenericBonusGasSampleAmount", lv_gasSampleAmount);
    }
    BankSave(BankLastCreated());
}

