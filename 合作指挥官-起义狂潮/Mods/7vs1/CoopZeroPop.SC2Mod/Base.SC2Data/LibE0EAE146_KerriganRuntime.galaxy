void libE0EAE146_gf_KerriganSetUpgradeAtLeast (int lp_player, string lp_upgrade, int lp_level) {
    int lv_currentLevel;

    if ((lp_upgrade == "") || (!CatalogEntryIsValid(c_gameCatalogUpgrade, lp_upgrade))) {
        return;
    }

    lv_currentLevel = TechTreeUpgradeCount(lp_player, lp_upgrade, c_techCountCompleteOnly);
    if (lv_currentLevel < lp_level) {
        TechTreeUpgradeAddLevel(lp_player, lp_upgrade, (lp_level - lv_currentLevel));
    }
}

void libE0EAE146_gf_KerriganAllowUnitIfPresent (int lp_player, string lp_unit) {
    if ((lp_unit == "") || (!CatalogEntryIsValid(c_gameCatalogUnit, lp_unit))) {
        return;
    }
    TechTreeUnitAllow(lp_player, lp_unit, true);
}

void libE0EAE146_gf_KerriganAllowAbilityIfPresent (int lp_player, string lp_abil, int lp_cmdIndex) {
    if ((lp_abil == "") || (!CatalogEntryIsValid(c_gameCatalogAbil, lp_abil))) {
        return;
    }
    TechTreeAbilityAllow(lp_player, AbilityCommand(lp_abil, lp_cmdIndex), true);
}

void libE0EAE146_gf_KerriganSetUnitTechAliasIfPresent (int lp_player, string lp_unit, string lp_alias) {
    if ((lp_unit == "") || (lp_alias == "")) {
        return;
    }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, lp_unit)) {
        return;
    }
    CatalogFieldValueSet(c_gameCatalogUnit, lp_unit, "TechAliasArray[0]", lp_player, lp_alias);
    CatalogFieldValueSet(c_gameCatalogUnit, lp_unit, "TechAliasArray[1]", lp_player, lp_alias);
}

void libE0EAE146_gf_KerriganSetAbilFieldIfUnitPresent (int lp_player, string lp_abil, string lp_field, string lp_unit) {
    if ((lp_abil == "") || (lp_field == "") || (lp_unit == "")) {
        return;
    }
    if (!CatalogEntryIsValid(c_gameCatalogAbil, lp_abil)) {
        return;
    }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, lp_unit)) {
        return;
    }
    CatalogFieldValueSet(c_gameCatalogAbil, lp_abil, lp_field, lp_player, lp_unit);
}

