    TechTreeUnitAllow(lp_player, "NydusNetwork", false);
    TechTreeUnitAllow(lp_player, "GreaterNydusWorm", false);

    // Kerrigan private tech uses generic larva requirements such as HaveSpire and
    // HaveUltraliskCavern. Rebind the private structures to the shared aliases so
    // larva buttons stay visible when the correct Kerrigan tech is built.
    libE0EAE146_gf_KerriganSetUnitTechAliasIfPresent(lp_player, "HatcheryKerrigan", "Alias_Hatchery");
