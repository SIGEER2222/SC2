}

void libE0EAE146_gf_KerriganStartInReviveFlow (int lp_player, unit lp_hero) {
    string lv_reviveUnitType;

    if (UnitIsValid(lp_hero) == false) {
        return;
    }

    lv_reviveUnitType = libE0EAE146_gf_CommanderHeroReviveUnitType("Kerrigan");
    if ((lv_reviveUnitType == "") || (!CatalogEntryIsValid(c_gameCatalogUnit, lv_reviveUnitType))) {
        return;
    }

    libNtve_gf_ShowHideUnit(lp_hero, false);
    UnitSetPosition(lp_hero, RegionGetBoundsMin(RegionEntireMap()), false);
    UnitKill(lp_hero);
}

void libE0EAE146_gf_KerriganRuntimeInit (int lp_player, point lp_heroPoint, bool lp_createHero) {
    unit lv_caster;

    if (libE0EAE146_gv_kerriganRuntimeInitialized == true) {
        return;
    }

    libE0EAE146_gv_kerriganRuntimeInitialized = true;
    libE0EAE146_gv_kerriganRuntimePlayer = lp_player;
    libE0EAE146_gf_CommanderPowerApplyProfile(lp_player, "Kerrigan");
    libE0EAE146_gf_KerriganApplyDefaultCosmetic(lp_player);
    if (libE0EAE146_gf_CommanderUsePrivateTechFilter("Kerrigan")) {
        libE0EAE146_gf_KerriganApplyTechFilter(lp_player);
    }
    libE0EAE146_gf_KerriganEconDropInit(lp_player);

    libNtve_gf_CreateUnitsWithDefaultFacing(1, "CoopCasterKerrigan", c_unitCreateIgnorePlacement, lp_player, RegionGetBoundsMin(RegionEntireMap()));
    lv_caster = UnitLastCreated();

    if (lp_createHero == true) {
        libE0EAE146_gt_CommanderHeroDied_Init();
    }

    lib67C0F0E7_gf_CU_GPInit(lp_player, "Kerrigan", lv_caster, null);
    lib67C0F0E7_gf_CU_GPShowHide(true, lp_player, c_transitionDurationDefault);
    lib67C0F0E7_gf_ShowChooseButton();
}
