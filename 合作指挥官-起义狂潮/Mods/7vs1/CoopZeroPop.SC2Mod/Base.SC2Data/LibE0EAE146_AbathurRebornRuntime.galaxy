// AbathurReborn runtime: 迁移自 crys_the_swarm_reborn 的实验体/变异系统。
// 与现有官方合作版 Abathur（生物质系统）并存，id 全部加 Reborn 后缀。
// 阶段 2-B：独立 TechFilter（不禁用基础单位）+ Purchase 能力注入到原单位。

//--------------------------------------------------------------------------------------------------
// AbathurRebornApplyTechFilter：独立 TechFilter
// 与 AbathurApplyTechFilter 的关键区别：不禁用 Devourer/Viper/SwarmHost 等基础单位，
// 让 AbathurReborn 玩家可以生产原单位，然后通过触发器注入 Reborn Purchase 变异能力。
//--------------------------------------------------------------------------------------------------
void libE0EAE146_gf_AbathurRebornApplyTechFilter (int lp_player) {
    // 解锁 Abathur 特色战斗单位（目标 mod 中存在的）
    TechTreeUnitAllow(lp_player, "Brutalisk", true);
    TechTreeUnitAllow(lp_player, "BrutaliskBurrowed", true);
    TechTreeUnitAllow(lp_player, "HotSLeviathan", true);
    TechTreeUnitAllow(lp_player, "Mutalisk", true);
    TechTreeUnitAllow(lp_player, "RoachVile", true);
    TechTreeUnitAllow(lp_player, "RavagerAbathur", true);
    TechTreeUnitAllow(lp_player, "RavagerAbathurBurrowed", true);
    libE0EAE146_gf_AbathurAllowUnitIfValid(lp_player, "BrutaliskAbathur", true);
    libE0EAE146_gf_AbathurAllowUnitIfValid(lp_player, "BrutaliskAbathurBurrowed", true);

    // 解锁 9 个 Reborn 变异单位（用于 TechTree 检查，实际通过触发器注入能力到原单位）
    if (CatalogEntryIsValid(c_gameCatalogUnit, "BrutaliskReborn")) { TechTreeUnitAllow(lp_player, "BrutaliskReborn", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "DevourerReborn")) { TechTreeUnitAllow(lp_player, "DevourerReborn", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "MutaliskReborn")) { TechTreeUnitAllow(lp_player, "MutaliskReborn", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "HydraliskImpalerReborn")) { TechTreeUnitAllow(lp_player, "HydraliskImpalerReborn", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "HydraliskLurkerReborn")) { TechTreeUnitAllow(lp_player, "HydraliskLurkerReborn", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "SwarmHostReborn")) { TechTreeUnitAllow(lp_player, "SwarmHostReborn", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "InfestorReborn")) { TechTreeUnitAllow(lp_player, "InfestorReborn", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "DefilerMPReborn")) { TechTreeUnitAllow(lp_player, "DefilerMPReborn", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "ViperReborn")) { TechTreeUnitAllow(lp_player, "ViperReborn", true); }

    // 启用 Abathur 特色能力
    TechTreeAbilityAllow(lp_player, AbilityCommand("MorphRoachVileToRavager", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("RavagerAbathurCorrosiveBile", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("BurrowRavagerAbathurDown", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("BurrowRavagerAbathurUp", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("MutaliskMorphToDevourer", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("MutaliskMorphToGuardian", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("EvolveToBrutaliskRoach", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("EvolveToBrutaliskRoach", 1), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("EvolveToBrutaliskRoachVile", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("EvolveToBrutaliskRoachVile", 1), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("EvolveToBrutaliskRavager", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("EvolveToBrutaliskRavager", 1), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("EvolveToBrutaliskSwarmHost", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("EvolveToBrutaliskSwarmHost", 1), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("AbathurDeepTunnel", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("AbathurDeepTunnelImproved", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("BrutaliskDeepTunnel", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("SymbioteCarapace", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("BurrowBrutaliskDown", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("BurrowBrutaliskUp", 0), true);
    libE0EAE146_gf_AbathurAllowAbilityIfValid(lp_player, "BurrowBrutaliskAbathurDown", 0, true);
    libE0EAE146_gf_AbathurAllowAbilityIfValid(lp_player, "BurrowBrutaliskAbathurUp", 0, true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("CorrosiveAcid", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("LocustLaunch", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("ViperConsumeStructure", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("Yoink", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("ParasiticBomb", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("SpawnToxicNest", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("AbathurMend", 0), true);

    // ===== 阶段 3-E：启用新生产体系 =====
    // CommanderUnits：基地生产大型单位（index 0=Blightbringer 禁用，与 LarvaTrainSwarm2 重复；index 1=Omegalisk；index 2=Brutalisk）
    TechTreeAbilityAllow(lp_player, AbilityCommand("CommanderUnits", 0), false);
    TechTreeAbilityAllow(lp_player, AbilityCommand("CommanderUnits", 1), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("CommanderUnits", 2), true);

    // ZergBuild：5 个新建筑（Build23=AshWorm2, Build24=PrimalTownHall, Build25=MercCompound, Build26=InfestedBarracks2, Build27=PrimalSunkenColony）
    TechTreeAbilityAllow(lp_player, AbilityCommand("ZergBuild", 22), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("ZergBuild", 23), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("ZergBuild", 24), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("ZergBuild", 25), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("ZergBuild", 26), true);

    // 工蜂升级能力（6 个）
    TechTreeAbilityAllow(lp_player, AbilityCommand("NaturalCamouflage", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("Cliffjumper", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("CombatDrone", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("MineralEfficiency", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("VespeneEfficiency", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("FastMorphing", 0), true);

    // 解锁 LarvaTrainSwarm2 生产的 22 个变异单位
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Pygalisk")) { TechTreeUnitAllow(lp_player, "Pygalisk", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "ZerglingToxic")) { TechTreeUnitAllow(lp_player, "ZerglingToxic", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "FrostFiend")) { TechTreeUnitAllow(lp_player, "FrostFiend", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "BileTitan")) { TechTreeUnitAllow(lp_player, "BileTitan", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Igniter")) { TechTreeUnitAllow(lp_player, "Igniter", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "HunterKiller")) { TechTreeUnitAllow(lp_player, "HunterKiller", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Hydralisk2")) { TechTreeUnitAllow(lp_player, "Hydralisk2", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "MutaliskChar")) { TechTreeUnitAllow(lp_player, "MutaliskChar", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Mamba")) { TechTreeUnitAllow(lp_player, "Mamba", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "MutaliskAnkylos")) { TechTreeUnitAllow(lp_player, "MutaliskAnkylos", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Mesmer")) { TechTreeUnitAllow(lp_player, "Mesmer", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "BaneHost")) { TechTreeUnitAllow(lp_player, "BaneHost", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "VespidHost")) { TechTreeUnitAllow(lp_player, "VespidHost", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "UltraliskSavage")) { TechTreeUnitAllow(lp_player, "UltraliskSavage", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "UltraliskKaldir")) { TechTreeUnitAllow(lp_player, "UltraliskKaldir", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "IzshaGuardian")) { TechTreeUnitAllow(lp_player, "IzshaGuardian", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Kraken")) { TechTreeUnitAllow(lp_player, "Kraken", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Blightbringer")) { TechTreeUnitAllow(lp_player, "Blightbringer", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Omegalisk")) { TechTreeUnitAllow(lp_player, "Omegalisk", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Leviathan")) { TechTreeUnitAllow(lp_player, "Leviathan", true); }

    // 解锁 CommanderUnits 生产的单位（部分与 LarvaTrainSwarm2 重复，此处确保全部可用）
    // Brutalisk 和 HotSLeviathan 已在上方解锁

    // 解锁 5 个新建筑
    if (CatalogEntryIsValid(c_gameCatalogUnit, "AshWorm2")) { TechTreeUnitAllow(lp_player, "AshWorm2", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "PrimalTownHall")) { TechTreeUnitAllow(lp_player, "PrimalTownHall", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "MercCompound")) { TechTreeUnitAllow(lp_player, "MercCompound", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "InfestedBarracks2")) { TechTreeUnitAllow(lp_player, "InfestedBarracks2", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "PrimalSunkenColony")) { TechTreeUnitAllow(lp_player, "PrimalSunkenColony", true); }

    // 解锁 3 个女王单位（TrainQueen 扩展）
    if (CatalogEntryIsValid(c_gameCatalogUnit, "SIQueen")) { TechTreeUnitAllow(lp_player, "SIQueen", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "BroodMother")) { TechTreeUnitAllow(lp_player, "BroodMother", true); }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "ZaGara")) { TechTreeUnitAllow(lp_player, "ZaGara", true); }
}

//--------------------------------------------------------------------------------------------------
// AbathurRebornAddPurchaseAbilities：给原单位注入 Reborn Purchase 变异能力
// 当 AbathurReborn 玩家生产出原单位时，调用此函数添加对应的 Purchase 变异能力。
// 这样原单位就能使用 Reborn 版本的变异升级，无需替换单位。
//--------------------------------------------------------------------------------------------------
void libE0EAE146_gf_AbathurRebornAddPurchaseAbilities (unit lp_unit) {
    string lv_type;

    if ((lp_unit == null)) {
        return;
    }
    lv_type = UnitGetType(lp_unit);

    if (lv_type == "Brutalisk") {
        UnitAbilityAdd(lp_unit, "BrutaliskTramplingCarapacePurchaseReborn");
        UnitAbilityAdd(lp_unit, "BrutaliskSavageRendPurchaseReborn");
        UnitAbilityAdd(lp_unit, "BrutaliskFleshRecompositionPurchaseReborn");
    }
    else if (lv_type == "Devourer") {
        UnitAbilityAdd(lp_unit, "AbathurDevourerAcidCloudSacsPurchaseReborn");
        UnitAbilityAdd(lp_unit, "AbathurDevourerCorrosiveGlandsPurchaseReborn");
        UnitAbilityAdd(lp_unit, "AbathurDevourerStomachOverloadPurchaseReborn");
    }
    else if (lv_type == "Mutalisk") {
        UnitAbilityAdd(lp_unit, "AbathurMutaliskExplosiveGlaivePurchaseReborn");
        UnitAbilityAdd(lp_unit, "AbathurMutaliskViciousGlaivePurchaseReborn");
        UnitAbilityAdd(lp_unit, "AbathurMutaliskRapidRegenerationPurchaseReborn");
    }
    else if (lv_type == "HydraliskImpaler") {
        UnitAbilityAdd(lp_unit, "AbathurImpalerArmorPiercingSpinesPurchaseReborn");
        UnitAbilityAdd(lp_unit, "AbathurImpalerEarthveinGlidePurchaseReborn");
        UnitAbilityAdd(lp_unit, "AbathurImpalerAftershockImpalePurchaseReborn");
    }
    else if (lv_type == "HydraliskLurker") {
        UnitAbilityAdd(lp_unit, "AbathurLurkerRiftSpinesPurchaseReborn");
        UnitAbilityAdd(lp_unit, "AbathurLurkerStalkerGlidePurchaseReborn");
        UnitAbilityAdd(lp_unit, "AbathurLurkerVenomAmbushPurchaseReborn");
    }
    else if (lv_type == "SwarmHost") {
        UnitAbilityAdd(lp_unit, "AbathurHostRapidIncubationPurchaseReborn");
        UnitAbilityAdd(lp_unit, "AbathurHostLocustSpeedPurchaseReborn");
        UnitAbilityAdd(lp_unit, "AbathurHostPressurizedGlandsPurchaseReborn");
    }
    else if ((lv_type == "Infestor") || (lv_type == "DefilerMP") || (lv_type == "Viper")) {
        UnitAbilityAdd(lp_unit, "AbathurCasterBrainPoolPurchaseReborn");
        UnitAbilityAdd(lp_unit, "AbathurCasterNeuralTethersPurchaseReborn");
        UnitAbilityAdd(lp_unit, "AbathurCasterFleshReactorPurchaseReborn");
        UnitAbilityAdd(lp_unit, "AbathurCasterMimeticMembranePurchaseReborn");
    }
}

//--------------------------------------------------------------------------------------------------
// Trigger: AbathurReborn Abilities（新单位进入监听，挂载变异能力 + Purchase 能力）
//--------------------------------------------------------------------------------------------------
bool libE0EAE146_gt_AbathurRebornAbilities_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((TechTreeUpgradeCount(EventPlayer(), "AbathurReborn", c_techCountCompleteOnly) == 1))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    // 阶段 1：变异开关能力（复用目标 mod 现有虫族单位 id）
    if (((UnitGetType(EventUnit()) == "Zergling") || (UnitGetType(EventUnit()) == "Pygalisk") || (UnitGetType(EventUnit()) == "HotSRaptor") || (UnitGetType(EventUnit()) == "HotSSwarmling") || (UnitGetType(EventUnit()) == "ZerglingToxic"))) {
        UnitAbilityAdd(EventUnit(), "ArmoredCarapace");
        UnitAbilityAdd(EventUnit(), "KetamineInfusion");
        UnitAbilityAdd(EventUnit(), "Kleptomania");
        UnitAbilityAdd(EventUnit(), "Moonrage");
        UnitAbilityAdd(EventUnit(), "Stealthling");
    }
    else {
        if (((UnitGetType(EventUnit()) == "Overlord") || (UnitGetType(EventUnit()) == "Overseer"))) {
            UnitAbilityAdd(EventUnit(), "OverlordRadar");
            UnitAbilityAdd(EventUnit(), "OverlordZerglings");
            UnitAbilityAdd(EventUnit(), "OverlordGun");
            UnitAbilityAdd(EventUnit(), "OverlordGirth");
            UnitAbilityAdd(EventUnit(), "OverlordZoomies");
        }
        else {
            if (((UnitGetType(EventUnit()) == "Baneling") || (UnitGetType(EventUnit()) == "BileTitan") || (UnitGetType(EventUnit()) == "FrostFiend") || (UnitGetType(EventUnit()) == "HotSHunter") || (UnitGetType(EventUnit()) == "HotSSplitterlingBig"))) {
                UnitAbilityAdd(EventUnit(), "BanelingCreep");
                UnitAbilityAdd(EventUnit(), "BanelingNuke");
                UnitAbilityAdd(EventUnit(), "BanelingShields");
                UnitAbilityAdd(EventUnit(), "BanelingSpeed");
                UnitAbilityAdd(EventUnit(), "BanelingZerglings");
            }
            else {
                if (((UnitGetType(EventUnit()) == "Hydralisk") || (UnitGetType(EventUnit()) == "HydraliskImpaler") || (UnitGetType(EventUnit()) == "HydraliskLurker") || (UnitGetType(EventUnit()) == "HunterKiller") || (UnitGetType(EventUnit()) == "Hydralisk2") || (UnitGetType(EventUnit()) == "HydraliskImpalerReborn") || (UnitGetType(EventUnit()) == "HydraliskLurkerReborn"))) {
                    UnitAbilityAdd(EventUnit(), "HydraliskBroodlings");
                    UnitAbilityAdd(EventUnit(), "HydraliskCripple");
                    UnitAbilityAdd(EventUnit(), "HydraliskMechanical");
                    UnitAbilityAdd(EventUnit(), "HydraliskMelee");
                    UnitAbilityAdd(EventUnit(), "HydraliskRange");
                }
                else {
                    if (((UnitGetType(EventUnit()) == "Roach") || (UnitGetType(EventUnit()) == "RoachCorpser") || (UnitGetType(EventUnit()) == "Igniter") || (UnitGetType(EventUnit()) == "Ravager") || (UnitGetType(EventUnit()) == "RoachVile"))) {
                        UnitAbilityAdd(EventUnit(), "AdrenalineOverdose");
                        UnitAbilityAdd(EventUnit(), "BanelingGestation");
                        UnitAbilityAdd(EventUnit(), "BileShield");
                        UnitAbilityAdd(EventUnit(), "MeleeStrain");
                        UnitAbilityAdd(EventUnit(), "RoachlingInfestation");
                    }

                }
            }
        }
    }

    // 阶段 2-B：给原单位注入 Reborn Purchase 变异能力
    libE0EAE146_gf_AbathurRebornAddPurchaseAbilities(EventUnit());
    return true;
}

//--------------------------------------------------------------------------------------------------
void libE0EAE146_gt_AbathurRebornAbilities_Init () {
    libE0EAE146_gt_AbathurRebornAbilities = TriggerCreate("libE0EAE146_gt_AbathurRebornAbilities_Func");
    TriggerEnable(libE0EAE146_gt_AbathurRebornAbilities, false);
    TriggerAddEventUnitRegion(libE0EAE146_gt_AbathurRebornAbilities, null, RegionEntireMap(), true);
}

//--------------------------------------------------------------------------------------------------
// RuntimeInit：AbathurReborn 指挥官初始化入口
//--------------------------------------------------------------------------------------------------
void libE0EAE146_gf_AbathurRebornRuntimeInit (int lp_player, point lp_heroPoint, bool lp_createHero) {
    unit lv_caster;

    if (libE0EAE146_gv_abathurRebornRuntimeInitialized) {
        return;
    }
    libE0EAE146_gv_abathurRebornRuntimeInitialized = true;

    // 启用 AbathurReborn 主升级和播报员
    if (CatalogEntryIsValid(c_gameCatalogUpgrade, "AbathurReborn")) {
        libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "AbathurReborn", 1);
    }
    if (CatalogEntryIsValid(c_gameCatalogUpgrade, "AbathurAnnouncerReborn")) {
        libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "AbathurAnnouncerReborn", 1);
    }

    // 应用指挥官天赋（AbathurReborn 已在 Shared/Talents/AbathurReborn.json 注册，配置为空）
    libE0EAE146_gf_ApplyTalents(lp_player, "ZergAbathurReborn");

    // 应用独立 TechFilter（不禁用基础单位，让 Devourer/Viper 等可生产）
    libE0EAE146_gf_AbathurRebornApplyTechFilter(lp_player);

    // 创建 CoopCaster（复用 Abathur 的 CoopCaster，因为 AbathurReborn 没有自己的）
    if (CatalogEntryIsValid(c_gameCatalogUnit, "CoopCasterAbathur")) {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "CoopCasterAbathur", c_unitCreateIgnorePlacement, lp_player, RegionGetBoundsMin(RegionEntireMap()));
        lv_caster = UnitLastCreated();
        lib67C0F0E7_gf_CU_GPInit(lp_player, "Abathur", lv_caster, null);
        lib67C0F0E7_gf_CU_GPShowHide(true, lp_player, c_transitionDurationDefault);
        lib67C0F0E7_gf_ShowChooseButton();
    }

    // 启用变异系统监听触发器（监听新单位进入，挂载变异开关能力 + Purchase 能力）
    TriggerEnable(libE0EAE146_gt_AbathurRebornAbilities, true);
}
