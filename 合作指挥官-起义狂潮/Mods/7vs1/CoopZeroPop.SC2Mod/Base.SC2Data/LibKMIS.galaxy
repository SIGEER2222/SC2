//--------------------------------------------------------------------------------------------------
bool libKMIS_gt_CM_Fenix_HeroSpawnCleanup_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_player;

    // Automatic Variable Declarations
    unitgroup auto61952558_g;
    int auto61952558_u;
    unit auto61952558_var;

    // Variable Initialization
    lv_player = EventPlayer();

    // Actions
    if (!runActions) {
        return true;
    }

    if ((EventPlayerEffectUsed() == "SOASummonFenixHeroSummonSelfCleanupDummy")) {
        libKMIS_gf_CM_Fenix_VitalMatch(EventPlayerEffectUsedUnit(c_effectUnitTarget));
        DialogControlSetVisible(libKCUI_gv_cU_GPCmdButtonActiveImage[1][lv_player], PlayerGroupSingle(lv_player), false);
        DialogControlSetVisible(libKCUI_gv_cU_GPCmdButtonActiveImage[2][lv_player], PlayerGroupSingle(lv_player), false);
        DialogControlSetVisible(libKCUI_gv_cU_GPCmdButtonActiveImage[3][lv_player], PlayerGroupSingle(lv_player), false);
