bool libKMIS_gt_CM_Dehaka_PrestigeClone_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_dehakaclone;
    int lv_dehakaplayer;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_dehakaclone = EventPlayerEffectUsedUnit(c_effectUnitTarget);
    lv_dehakaplayer = UnitGetOwner(lv_dehakaclone);

    // Actions
    if (!runActions) {
        return true;
    }

    UnitBehaviorAdd(lv_dehakaclone, libKMIS_gv_cM_DehakaVeterencyBehavior[lv_dehakaplayer], lv_dehakaclone, 1);
    if ((TechTreeUpgradeCount(lv_dehakaplayer, "MasteryDehakaAttackSpeed", c_techCountCompleteOnly) >= 1)) {
        UnitBehaviorAdd(lv_dehakaclone, "DehakaAttEssenceMastery", lv_dehakaclone, 1);
        UnitBehaviorRemove(lv_dehakaclone, "DehakaAttEssence", 1);
    }

    libKMIS_gf_CM_Dehaka_LevelUp(lv_dehakaplayer, lv_dehakaclone);
    libKCUI_gf_SetHeroPanelUnitOverride(2, lv_dehakaclone, lv_dehakaplayer);
    return true;
}

