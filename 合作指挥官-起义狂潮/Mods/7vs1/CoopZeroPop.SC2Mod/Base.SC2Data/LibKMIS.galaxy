void libKMIS_gt_CM_Zeratul_PurificationNova_Finale_Init () {
    libKMIS_gt_CM_Zeratul_PurificationNova_Finale = TriggerCreate("libKMIS_gt_CM_Zeratul_PurificationNova_Finale_Func");
    TriggerEnable(libKMIS_gt_CM_Zeratul_PurificationNova_Finale, false);
    TriggerAddEventUnitBehaviorChange(libKMIS_gt_CM_Zeratul_PurificationNova_Finale, null, "ZeratulPurificationNovaTargettedTarget", c_unitBehaviorChangeDeactivate);
}

