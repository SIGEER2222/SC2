    ActorSend(libKMIS_gv_cM_SoATargetingActors[libKMIS_gv_cM_SoATargetingChargesSpent[lv_casterPlayer]][lv_casterPlayer], "Signal Destroy");
    if ((UnitIsValid(libKMIS_gv_cM_SoATargetingUnit[libKMIS_gv_cM_SoATargetingChargesSpent[lv_casterPlayer]][lv_casterPlayer]) == false)) {
        return true;
    }

    libNtve_gf_MakeUnitFacePoint(libKMIS_gv_cM_SoATargetingUnit[libKMIS_gv_cM_SoATargetingChargesSpent[lv_casterPlayer]][lv_casterPlayer], lv_targetPoint, 0.0);
    libKCUI_gf_CU_TargetingSetCharges((libKMIS_gv_cM_SoATargetingChargesTotal[lv_casterPlayer]-libKMIS_gv_cM_SoATargetingChargesSpent[lv_casterPlayer]), libKMIS_gv_cM_SoATargetingChargesTotal[lv_casterPlayer], lv_casterPlayer);
    if ((libKMIS_gv_cM_SoATargetingChargesSpent[lv_casterPlayer] == libKMIS_gv_cM_SoATargetingChargesTotal[lv_casterPlayer])) {
        UnitBehaviorRemove(libKMIS_gv_cM_SoACasterUnit[lv_casterPlayer], libKMIS_gv_cM_SoATargetingBehavior[lv_casterPlayer], 1);
        Wait(0.1, c_timeGame);
    }
    else {
        libKCUI_gf_CU_TargetingSetInstructionText(libKMIS_gv_cM_SoATargetingInstructionsPrimary[lv_casterPlayer], lv_casterPlayer);
        Wait(0.1, c_timeGame);
        if ((libKMIS_gv_cM_SoATargetingAlreadyCanceled[lv_casterPlayer] == false)) {
            UISetTargetingOrder(PlayerGroupSingle(lv_casterPlayer), libKMIS_gv_cM_SoACasterGroup[lv_casterPlayer], libKMIS_gv_cM_SoATargetingOrder[lv_casterPlayer], false);
        }

        libKMIS_gv_cM_SoATargetingPhase[lv_casterPlayer] = libKMIS_ge_CM_SoATargetingPhaseType_Location;
    }
    libKMIS_gv_cM_SoATargetingCycling[lv_casterPlayer] = false;
    return true;
}

