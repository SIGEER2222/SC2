    TriggerEnable(libKMIS_gt_CM_Horner_StarportCreateTechLabOrder, false);
    TriggerAddEventPlayerEffectUsed(libKMIS_gt_CM_Horner_StarportCreateTechLabOrder, c_playerAny, "HHStarportBirthDummy");
