void libKMIS_gt_CM_Zeratul_Entropic_Spawner_Init () {
    libKMIS_gt_CM_Zeratul_Entropic_Spawner = TriggerCreate("libKMIS_gt_CM_Zeratul_Entropic_Spawner_Func");
    TriggerEnable(libKMIS_gt_CM_Zeratul_Entropic_Spawner, false);
    TriggerAddEventUnitCreated(libKMIS_gt_CM_Zeratul_Entropic_Spawner, null, "ZeratulEntropicBlastCyan", null);
