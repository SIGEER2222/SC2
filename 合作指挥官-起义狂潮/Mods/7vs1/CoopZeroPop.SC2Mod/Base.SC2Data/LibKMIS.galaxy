    TriggerEnable(libKMIS_gt_CM_Dehaka_EssencePickup, false);
    TriggerAddEventPlayerEffectUsed(libKMIS_gt_CM_Dehaka_EssencePickup, c_playerAny, "EssencePickupDummy");
