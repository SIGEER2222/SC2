    else if (auto698BF1AA_val == "BanelingStetmannExplodeWeaponBonusDamageTrigger") {
        UnitCreateEffectUnit(lv_baneling, "BanelingExplodeLargeSetStetmann", lv_target);
    }
    else {
    }
    return true;
}

