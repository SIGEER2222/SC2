    TriggerEnable(libKMIS_gt_CM_Abathur_ToxicNest, true);
    TriggerEnable(libKMIS_gt_CM_Abathur_SwarmHostLocustLaunchCast, true);
    TriggerEnable(libKMIS_gt_CM_Abathur_RavagerSpellCooldown, true);
    TriggerEnable(libKMIS_gt_CM_Abathur_ToxicNestDeathFailsafe, true);
    auto55ADB699_g = libKCOR_gf_CC_PlayersOfCommander("ZergAbathur");
    lv_itPlayer = -1;
    while (true) {
        lv_itPlayer = PlayerGroupNextPlayer(auto55ADB699_g, lv_itPlayer);
