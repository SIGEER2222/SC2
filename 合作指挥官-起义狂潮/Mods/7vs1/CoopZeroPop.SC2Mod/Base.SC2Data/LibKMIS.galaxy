        libKMIS_gf_CM_Fenix_UpdateFenixChampionShellCountValues(4, lv_player);
        lv_avengingprotocolindex = 4;
        lv_avengingprotocolstacks = 4;
    }
    else if (auto0E65C66C_val == libKMIS_gv_cM_Fenix_ChampionUnitReplaceType[5]) {
        UnitGroupRemove(libKMIS_gv_cM_Fenix_ChampionVolunteerUnitGroup[5][lv_player], EventUnit());
        libKMIS_gf_CM_Fenix_UpdateNetworkValues(5, lv_player);
        libKMIS_gf_CM_Fenix_UpdateFenixChampionShellCountValues(5, lv_player);
        lv_avengingprotocolindex = 5;
        lv_avengingprotocolstacks = 6;
    }
    else if (auto0E65C66C_val == libKMIS_gv_cM_Fenix_ChampionUnitReplaceType[6]) {
