    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    auto6C9E4F0A_g = libKCOR_gf_CC_PlayersOfCommander("ProtossFenix");
    lv_itPlayer = -1;
    while (true) {
