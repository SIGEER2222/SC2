    libKMIS_gt_CM_Zeratul_TransportDropOff = TriggerCreate("libKMIS_gt_CM_Zeratul_TransportDropOff_Func");
    TriggerEnable(libKMIS_gt_CM_Zeratul_TransportDropOff, false);
    TriggerAddEventPlayerEffectUsed(libKMIS_gt_CM_Zeratul_TransportDropOff, c_playerAny, "ZeratulVoidSeekerTrigger");
