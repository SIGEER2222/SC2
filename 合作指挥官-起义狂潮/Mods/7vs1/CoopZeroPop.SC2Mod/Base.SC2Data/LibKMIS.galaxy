    if ((UnitGetType(EventUnit()) == "FenixCoop")) {
        libKMIS_gf_DisplayCampaignMessage(PlayerGroupSingle(lv_player), libKMIS_ge_CampaignMessageType_SimpleHint, StringExternal("Param/Value/lib_KMIS_FEB870A6"), libKMIS_ge_CampaignMessageFormatNotFormat_FormatMessage);
