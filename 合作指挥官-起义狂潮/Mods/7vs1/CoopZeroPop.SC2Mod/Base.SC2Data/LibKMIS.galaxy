//--------------------------------------------------------------------------------------------------
bool libKMIS_gt_CM_Horner_BomberPlatform_PlatformCreated_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    UnitGroupAdd(libKMIS_gv_cM_Horner_BomberPlatforms[UnitGetOwner(EventPlayerEffectUsedUnit(c_effectUnitCaster))], EventPlayerEffectUsedUnit(c_effectUnitCaster));
    libKMIS_gv_cM_Horner_BomberPlatforms_TotalCount[UnitGetOwner(EventPlayerEffectUsedUnit(c_effectUnitCaster))] = UnitGroupCount(libKMIS_gv_cM_Horner_BomberPlatforms[UnitGetOwner(EventPlayerEffectUsedUnit(c_effectUnitCaster))], c_unitCountAlive);
    Wait(0.01, c_timeGame);
    libKMIS_gf_CM_Horner_BomberStatusCheck(UnitGetOwner(EventPlayerEffectUsedUnit(c_effectUnitCaster)));
    PlayerAddChargeUsed(UnitGetOwner(EventPlayerEffectUsedUnit(c_effectUnitCaster)), "Abil/HHBomberPlatformAreaBombTopBarOrder", -1.0);
    return true;
}

