void libKMIS_gf_CM_Resources_FindWork (unit lp_worker, unit lp_townHall, fixed lp_workRadius) {
    // Variable Declarations
    region lv_workregion;
    unitgroup lv_nearbyminerals;
    unitgroup lv_nearbygeysers;
    unit lv_resourcenode;

    // Automatic Variable Declarations
    unitgroup auto9D4D2DDD_g;
    int auto9D4D2DDD_u;

    // Variable Initialization
    lv_workregion = RegionCircle(UnitGetPosition(lp_townHall), lp_workRadius);
    lv_nearbyminerals = UnitGroup(null, 0, lv_workregion, UnitFilter((1 << c_targetFilterHarvestableResource), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_nearbygeysers = UnitGroup(null, UnitGetOwner(lp_worker), lv_workregion, UnitFilter((1 << c_targetFilterHarvestableResource), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);

    // Implementation
    auto9D4D2DDD_g = lv_nearbygeysers;
    auto9D4D2DDD_u = UnitGroupCount(auto9D4D2DDD_g, c_unitCountAll);
    for (;; auto9D4D2DDD_u -= 1) {
        lv_resourcenode = UnitGroupUnitFromEnd(auto9D4D2DDD_g, auto9D4D2DDD_u);
        if (lv_resourcenode == null) { break; }
        if ((libKMIS_gf_CM_Resources_IsSaturated(lv_resourcenode) == false)) {
            UnitIssueOrder(lp_worker, OrderTargetingUnit(AbilityCommand("SCVHarvest", 0), lv_resourcenode), c_orderQueueReplace);
            return ;
        }

    }
    if ((UnitGroupCount(lv_nearbyminerals, c_unitCountAlive) > 0) && (libKMIS_gf_CM_Resources_IsSaturated(lp_townHall) == false)) {
        UnitIssueOrder(lp_worker, OrderTargetingUnit(AbilityCommand("SCVHarvest", 0), UnitGroupUnit(lv_nearbyminerals, RandomInt(1, UnitGroupCount(lv_nearbyminerals, c_unitCountAlive)))), c_orderQueueReplace);
    }

}

void libKMIS_gf_CM_DataUtilInit () {
    // Variable Declarations
    int lv_indexPlayer;

    // Automatic Variable Declarations
    playergroup autoBBEF2DEB_g;
    string autoCF24B7F2_val;

    // Variable Initialization

    // Implementation
    autoBBEF2DEB_g = libKCOR_gf_CommanderPlayers();
    lv_indexPlayer = -1;
    while (true) {
        lv_indexPlayer = PlayerGroupNextPlayer(autoBBEF2DEB_g, lv_indexPlayer);
        if (lv_indexPlayer < 0) { break; }
        autoCF24B7F2_val = libKCOR_gf_ActiveCommanderForPlayer(lv_indexPlayer);
        if (autoCF24B7F2_val == "ProtossKarax") {
            TriggerEnable(libKMIS_gt_CM_KaraxUnitReviveBarrier, true);
            TriggerEnable(libKMIS_gt_CM_KaraxSolarForgeSOAEnergy, true);
            TriggerEnable(libKMIS_gt_CM_KaraxRepairBeamLimit, true);
            TriggerExecute(libKMIS_gt_CM_KaraxRepairBeamLimit, false, true);
        }
        else if (autoCF24B7F2_val == "TerranRaynor") {
            TriggerEnable(libKMIS_gt_CM_HyperionMinimapIconDynamicFacingDisplay, true);
        }
        else if (autoCF24B7F2_val == "ZergKerrigan") {
            TriggerEnable(libKMIS_gt_CM_MasteryKerriganInstantReviveCooldown, true);
            TriggerEnable(libKMIS_gt_KerriganPsiStrike, true);
            TriggerEnable(libKMIS_gt_KerriganEconDrop, true);
        }
