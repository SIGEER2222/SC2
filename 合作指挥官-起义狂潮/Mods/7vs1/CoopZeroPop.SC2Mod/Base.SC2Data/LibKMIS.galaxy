    TriggerEnable(libKMIS_gt_CM_DehakaReviveEatButtonClicked, false);
    TriggerAddEventUnitAbility(libKMIS_gt_CM_DehakaReviveEatButtonClicked, null, AbilityCommand("DehakaConcoonEatSearch", 0), c_unitAbilStageExecute, false);
    TriggerAddEventPlayerEffectUsed(libKMIS_gt_CM_DehakaReviveEatButtonClicked, c_playerAny, "DehakaCoopReviveEatKillSet");
    TriggerAddEventUnitBehaviorChange(libKMIS_gt_CM_DehakaReviveEatButtonClicked, null, "DehakaNormalReviveTimer", c_unitBehaviorChangeActivate);
}

//--------------------------------------------------------------------------------------------------
// Trigger: CM_DehakaRevive Timer Adjustments
//--------------------------------------------------------------------------------------------------
bool libKMIS_gt_CM_DehakaReviveTimerAdjustments_Func (bool testConds, bool runActions) {
    // Variable Declarations
    fixed lv_reviveTimer;
    fixed lv_reviveTimerAdjustment;
    fixed lv_healthAdjustment;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_reviveTimerAdjustment = libKMIS_gv_cM_DehakaEatReviveTimerAdjustment;
    lv_healthAdjustment = ((AbsF(libKMIS_gv_cM_DehakaEatReviveTimerAdjustment) / libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogBehavior, "DehakaNormalReviveTimer", "Duration", EventPlayer())) * UnitGetPropertyFixed(libKMIS_gv_cM_HeroReviver[EventPlayer()], c_unitPropLifeMax, c_unitPropCurrent));

    // Actions
    if (!runActions) {
        return true;
    }

    lv_reviveTimer = UnitBehaviorDuration(libKMIS_gv_cM_HeroReviver[EventPlayer()], "DehakaNormalReviveTimer");
    lv_reviveTimer += lv_reviveTimerAdjustment;
    UnitBehaviorSetDurationRemaining(libKMIS_gv_cM_HeroReviver[EventPlayer()], "DehakaNormalReviveTimer", lv_reviveTimer);
    UnitSetPropertyFixed(libKMIS_gv_cM_HeroReviver[EventPlayer()], c_unitPropLife, (UnitGetPropertyFixed(libKMIS_gv_cM_HeroReviver[EventPlayer()], c_unitPropLife, c_unitPropCurrent) + lv_healthAdjustment));
    PlayerAddCooldown(EventPlayer(), libKCOR_gf_CC_CommanderHeroReviveLink(libKCOR_gf_ActiveCommanderForPlayer(EventPlayer())), lv_reviveTimerAdjustment);
    return true;
}

