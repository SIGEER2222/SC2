        UnitBehaviorRemove(libKMIS_gv_cM_HeroReviver[lp_player], libKCOR_gf_CC_CommanderHeroNormalReviveBehavior(lv_commander), c_unitBehaviorCountAll);
        UnitBehaviorRemove(libKMIS_gv_cM_HeroReviver[lp_player], libKCOR_gf_CC_CommanderHeroReviverExtraBehavior(lv_commander), c_unitBehaviorCountAll);
    }
