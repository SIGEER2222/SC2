    libKMIS_gt_CM_Fenix_ProbiusSwap = TriggerCreate("libKMIS_gt_CM_Fenix_ProbiusSwap_Func");
    TriggerEnable(libKMIS_gt_CM_Fenix_ProbiusSwap, false);
    TriggerAddEventUnitCreated(libKMIS_gt_CM_Fenix_ProbiusSwap, null, "NexusTrain", null);
