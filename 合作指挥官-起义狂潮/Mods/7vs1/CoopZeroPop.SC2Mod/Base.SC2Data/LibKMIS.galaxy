        lv_avengingprotocolindex = 2;
        lv_avengingprotocolstacks = 2;
    }
    else if (auto0E65C66C_val == libKMIS_gv_cM_Fenix_ChampionUnitReplaceType[3]) {
        UnitGroupRemove(libKMIS_gv_cM_Fenix_ChampionVolunteerUnitGroup[3][lv_player], EventUnit());
        libKMIS_gf_CM_Fenix_UpdateNetworkValues(3, lv_player);
        libKMIS_gf_CM_Fenix_UpdateFenixChampionShellCountValues(3, lv_player);
        lv_avengingprotocolindex = 3;
        lv_avengingprotocolstacks = 3;
    }
    else if (auto0E65C66C_val == libKMIS_gv_cM_Fenix_ChampionUnitReplaceType[4]) {
        UnitGroupRemove(libKMIS_gv_cM_Fenix_ChampionVolunteerUnitGroup[4][lv_player], EventUnit());
