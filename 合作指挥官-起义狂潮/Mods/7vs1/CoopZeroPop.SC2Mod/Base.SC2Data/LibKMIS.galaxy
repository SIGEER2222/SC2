        libNtve_gf_PlayerRemoveCooldown(libKMIS_gv_cM_ZeratulPlayer[lp_player], "Abil/ProphecyVision");
        return ;
    }
    else if ((libKMIS_gv_cM_ZeratulProphecyArtifactNumber[lp_player] > 3)) {
        lv_targetMissionTime = (-60.0 + libKMIS_gv_cM_ZeratulProphecyArtifactNumber[lp_player] * 300.0 - lv_masteryTimeReduction);
