//--------------------------------------------------------------------------------------------------
bool libKMIS_gt_CM_HeroSpawn_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_indexPlayer;
    point lv_spawnPoint;
    point lv_mineralPoint;

    // Automatic Variable Declarations
    playergroup autoC7F97A67_g;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    autoC7F97A67_g = libKCOR_gf_CommanderPlayers();
    lv_indexPlayer = -1;
    while (true) {
        lv_indexPlayer = PlayerGroupNextPlayer(autoC7F97A67_g, lv_indexPlayer);
        if (lv_indexPlayer < 0) { break; }
        if ((libKCOR_gf_CC_CommanderHeroUnitType(libKCOR_gf_ActiveCommanderForPlayer(lv_indexPlayer)) != null) && (libKCOR_gf_CC_PrestigeSuppressed(lv_indexPlayer, "SuppressHero") == false)) {
            lv_spawnPoint = UnitGetPosition(libKMIS_gf_CM_PrimaryTownHall(lv_indexPlayer));
            libKMIS_gf_CM_HeroCreateForPlayer(lv_spawnPoint, lv_indexPlayer, 270.0, 0);
            libKCUI_gf_SetHeroPanelUnit(1, UnitLastCreated(), lv_indexPlayer);
            if ((TechTreeUpgradeCount(lv_indexPlayer, "DehakaCommander", c_techCountCompleteOnly) == 1)) {
                UnitBehaviorAdd(libKMIS_gv_cM_HeroUnit[lv_indexPlayer], libKMIS_gv_cM_DehakaVeterencyBehavior[lv_indexPlayer], libKMIS_gv_cM_HeroUnit[lv_indexPlayer], 1);
            }

            if ((TechTreeUpgradeCount(lv_indexPlayer, "MasteryDehakaAttackSpeed", c_techCountCompleteOnly) >= 1)) {
                libKMIS_gv_cM_Dehaka_EssenceAttribute = "DehakaAttEssenceMastery";
                UnitBehaviorAdd(libKMIS_gv_cM_HeroUnit[lv_indexPlayer], "DehakaAttEssenceMastery", libKMIS_gv_cM_HeroUnit[lv_indexPlayer], 1);
                UnitBehaviorRemove(libKMIS_gv_cM_HeroUnit[lv_indexPlayer], "DehakaAttEssence", 1);
            }

            UnitBehaviorAdd(libKMIS_gv_cM_HeroUnit[lv_indexPlayer], "ZergGenericDeath", libKMIS_gv_cM_HeroUnit[lv_indexPlayer], 1);
            UnitSetPosition(libKMIS_gv_cM_HeroUnit[lv_indexPlayer], Point(0.0, 0.0), false);
            UnitKill(libKMIS_gv_cM_HeroUnit[lv_indexPlayer]);
        }

        if ((libKCOR_gf_CC_CommanderHeroStructureType(libKCOR_gf_ActiveCommanderForPlayer(lv_indexPlayer)) != null) && (libKCOR_gf_CC_PrestigeSuppressed(lv_indexPlayer, "SuppressHeroStructure") == false)) {
            lv_mineralPoint = UnitGroupCenterOfGroup(UnitGroup(null, c_playerAny, RegionCircle(UnitGetPosition(libKMIS_gf_CM_PrimaryTownHall(lv_indexPlayer)), 10.0), UnitFilter((1 << c_targetFilterHarvestableResource), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
            if ((UnitGroupCount(UnitGroup("ACHeroSpawnPlacement", lv_indexPlayer, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 1), c_unitCountAlive) > 0)) {
                lv_spawnPoint = UnitGetPosition(UnitGroupUnit(UnitGroup("ACHeroSpawnPlacement", lv_indexPlayer, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 1), 1));
            }
            else {
                TriggerDebugOutput(1, StringExternal("Param/Value/lib_KMIS_D32F9D56"), false);
                lv_spawnPoint = libNtve_gf_PointOffsetTowardsPoint(lv_mineralPoint, 13.0, UnitGetPosition(libKMIS_gf_CM_PrimaryTownHall(lv_indexPlayer)));
            }
            libKMIS_gf_CM_HeroStructureCreateForPlayer(lv_spawnPoint, lv_indexPlayer, 225.0, 0);
