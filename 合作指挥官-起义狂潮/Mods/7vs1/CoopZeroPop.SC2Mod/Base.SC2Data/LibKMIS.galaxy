        if (!((OrderGetFlag(EventUnitOrder(), c_cmdUser) == true))) {
            return false;
        }

        if (!((OrderGetFlag(EventUnitOrder(), c_cmdQueued) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitCreateEffectUnit(EventUnit(), "CancelDehakaLearn", EventUnit());
    return true;
}

