void libKMIS_gt_CM_Horner_MTO_Upgrade_Init () {
    libKMIS_gt_CM_Horner_MTO_Upgrade = TriggerCreate("libKMIS_gt_CM_Horner_MTO_Upgrade_Func");
    TriggerEnable(libKMIS_gt_CM_Horner_MTO_Upgrade, false);
    TriggerAddEventUpgradeLevelChanged(libKMIS_gt_CM_Horner_MTO_Upgrade, c_playerAny);
}

