    libKMIS_gt_CM_DehakaGlevigTimerAdjustments = TriggerCreate("libKMIS_gt_CM_DehakaGlevigTimerAdjustments_Func");
    TriggerEnable(libKMIS_gt_CM_DehakaGlevigTimerAdjustments, false);
    TriggerAddEventUnitCargo(libKMIS_gt_CM_DehakaGlevigTimerAdjustments, null, true);
}

