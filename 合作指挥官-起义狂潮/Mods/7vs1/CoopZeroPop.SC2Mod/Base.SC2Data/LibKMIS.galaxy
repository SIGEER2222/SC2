    libKMIS_gt_CM_DehakaConsumeExecuted = TriggerCreate("libKMIS_gt_CM_DehakaConsumeExecuted_Func");
    TriggerEnable(libKMIS_gt_CM_DehakaConsumeExecuted, false);
    TriggerAddEventPlayerEffectUsed(libKMIS_gt_CM_DehakaConsumeExecuted, c_playerAny, libKMIS_gv_c_DehakaConsumeEffect);
}

