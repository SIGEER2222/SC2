point libKMIS_gf_CM_LaserDrillTargetPoint (point lp_casterPoint, point lp_targetPoint, region lp_region, int lp_player) {
    // Variable Declarations
    point lv_casterPoint;
    fixed lv_casterXToEdgeOfMap;
    fixed lv_casterYToEdgeOfMap;
