    if (!runActions) {
        return true;
    }

    auto59F15E5F_g = libKCOR_gf_CommanderPlayers();
    lv_indexPlayer = -1;
    while (true) {
        lv_indexPlayer = PlayerGroupNextPlayer(auto59F15E5F_g, lv_indexPlayer);
        if (lv_indexPlayer < 0) { break; }
        if ((UnitGetOwner(libKMIS_gv_cM_PrimaryTownHall[lv_indexPlayer]) != lv_indexPlayer)) {
            UnitBehaviorRemove(libKMIS_gv_cM_PrimaryTownHall[lv_indexPlayer], "ZerglingRespawnPrimary", 1);
