        libNtve_gf_CreateUnitsWithDefaultFacing(1, "FenixManaDummy2", c_unitCreateIgnorePlacement, lv_itPlayer, Point(0.0, 0.0));
        UnitGroupAdd(libKMIS_gv_cM_Fenix_DummyGroup[lv_itPlayer], UnitLastCreated());
        libKMIS_gv_cM_Fenix_Suits[2][lv_itPlayer] = UnitLastCreated();
        libKCUI_gf_LinkUnitEnergyToGlobalCasterButton(libKMIS_gv_cM_Fenix_Suits[2][lv_itPlayer], lv_itPlayer, 2);
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "FenixManaDummy3", c_unitCreateIgnorePlacement, lv_itPlayer, Point(0.0, 0.0));
        UnitGroupAdd(libKMIS_gv_cM_Fenix_DummyGroup[lv_itPlayer], UnitLastCreated());
        libKMIS_gv_cM_Fenix_Suits[3][lv_itPlayer] = UnitLastCreated();
        libKCUI_gf_LinkUnitEnergyToGlobalCasterButton(libKMIS_gv_cM_Fenix_Suits[3][lv_itPlayer], lv_itPlayer, 3);
        libKMIS_gv_cM_Fenix_AbilCmdArray[1] = "SOASummonFenix";
        libKMIS_gv_cM_Fenix_AbilCmdArray[2] = "SOASummonFenixDragoon";
        libKMIS_gv_cM_Fenix_AbilCmdArray[3] = "SOASummonFenixArbiter";
        if ((TechTreeUpgradeCount(lv_itPlayer, "FenixOfflineSuitRegen", c_techCountCompleteOnly) == 1)) {
            libKMIS_gv_cM_Fenix_OfflineHealthRegen[lv_itPlayer] *= libKMIS_gv_cM_Fenix_OfflineVitalRegenMultiplier;
            libKMIS_gv_cM_Fenix_OfflineShieldRegen[lv_itPlayer] *= libKMIS_gv_cM_Fenix_OfflineVitalRegenMultiplier;
        }

        libKMIS_gv_cM_Fenix_OfflineEnergyRegen[lv_itPlayer] *= ((TechTreeUpgradeCount(lv_itPlayer, "MasteryFenixSuitEnergyRegen", c_techCountCompleteOnly) / 100.0) + 1.0);
    }
    return true;
}

