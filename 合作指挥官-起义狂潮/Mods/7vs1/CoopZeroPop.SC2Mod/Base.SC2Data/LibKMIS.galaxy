    }
    else if (auto0E65C66C_val == libKMIS_gv_cM_Fenix_ChampionUnitReplaceType[2]) {
        UnitGroupRemove(libKMIS_gv_cM_Fenix_ChampionVolunteerUnitGroup[2][lv_player], EventUnit());
