//--------------------------------------------------------------------------------------------------
// Trigger: CM_DehakaConsumeLearnLevel3
//--------------------------------------------------------------------------------------------------
bool libKMIS_gt_CM_DehakaConsumeLearnLevel3_Func (bool testConds, bool runActions) {
    // Variable Declarations
    fixed lv_lifeCooldownFactorReductionPercent;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_lifeCooldownFactorReductionPercent = 0.2;

    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnit()) == "DehakaCoop"))) {
            return false;
        }

        if (!((libNtve_gf_TriggeringProgressAbility() == "DehakaConsume"))) {
            return false;
        }

        if (!((UnitAbilityGetLevel(EventUnit(), "DehakaConsume") == 2))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libKMIS_gv_c_DehakaConsumeLifeCooldownFactor *= (1.0 - lv_lifeCooldownFactorReductionPercent);
    TriggerEnable(TriggerGetCurrent(), false);
    return true;
}

