void libKMIS_gt_CM_Abathur_Enemy_Death_Create_Locusts_Init () {
    libKMIS_gt_CM_Abathur_Enemy_Death_Create_Locusts = TriggerCreate("libKMIS_gt_CM_Abathur_Enemy_Death_Create_Locusts_Func");
    TriggerEnable(libKMIS_gt_CM_Abathur_Enemy_Death_Create_Locusts, false);
    TriggerAddEventUnitDied(libKMIS_gt_CM_Abathur_Enemy_Death_Create_Locusts, null);
}

