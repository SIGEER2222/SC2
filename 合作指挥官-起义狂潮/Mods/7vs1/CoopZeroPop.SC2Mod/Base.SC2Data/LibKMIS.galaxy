    }
    else {
        ActorSend(lv_dehakaUnitActor, "HaloStop");
        UISetButtonFaceHighlighted(PlayerGroupSingle(lp_dehakaPlayer), "DehakaLearnAbilities", false);
    }
    if ((lv_dehakaCurrentLevel >= libKMIS_gv_cM_DehakaLevelsMax[lp_dehakaPlayer]) && (libKMIS_gv_cM_DehakaLevelMaxMusicPlayed == false)) {
        libKMIS_gv_cM_DehakaLevelMaxMusicPlayed = true;
