    autoA552F3DF_u = UnitGroupCount(autoA552F3DF_g, c_unitCountAll);
    for (;; autoA552F3DF_u -= 1) {
        lv_u = UnitGroupUnitFromEnd(autoA552F3DF_g, autoA552F3DF_u);
        if (lv_u == null) { break; }
        ActorScopeSend(ActorScopeFromUnit(lv_u), "Signal PickUpTarget");
    }
    return true;
}

