    // Implementation
    auto0FE65364_ae = CatalogEntryCount(c_gameCatalogAbil);
    auto0FE65364_ai = 1;
    while (auto0FE65364_ai <= auto0FE65364_ae) {
        lv_ability = CatalogEntryGet(c_gameCatalogAbil, auto0FE65364_ai);
