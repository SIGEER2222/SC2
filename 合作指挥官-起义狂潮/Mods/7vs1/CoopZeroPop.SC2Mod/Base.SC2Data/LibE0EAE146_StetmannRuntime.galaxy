void libKMIS_gf_CM_Stetmann_ThrowPowerTowerEvent (int lp_player) {
    // Variable Declarations
    int lv_laircount;
    int lv_hivecount;
    int lv_oldchargelevel;
    string lv_eventname;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_laircount = UnitGroupCount(UnitGroup("LairStetmann", lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive);
    lv_hivecount = UnitGroupCount(UnitGroup("HiveStetmann", lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive);
    lv_oldchargelevel = libKMIS_gv_cM_Stetmann_StetelliteChargesLevel[lp_player];
    lv_eventname = "";

    // Implementation
    if ((lv_hivecount > 0)) {
        libKMIS_gv_cM_Stetmann_StetelliteChargesLevel[lp_player] = 2;
    }
    else if ((lv_laircount > 0)) {
        libKMIS_gv_cM_Stetmann_StetelliteChargesLevel[lp_player] = 1;
    }
    else if (true) {
        libKMIS_gv_cM_Stetmann_StetelliteChargesLevel[lp_player] = 0;
    }
    if ((libKMIS_gv_cM_Stetmann_StetelliteChargesLevel[lp_player] != lv_oldchargelevel)) {
        lv_eventname = ("Event_PowerTowerLevelChanged");
        DataTableSetInt(false, TriggerEventParamName(lv_eventname, ("StetmannPowerTowerTechLevelOld")), lv_oldchargelevel);
        DataTableSetInt(false, TriggerEventParamName(lv_eventname, ("StetmannPowerTowerTechLevelNew")), libKMIS_gv_cM_Stetmann_StetelliteChargesLevel[lp_player]);
        DataTableSetInt(false, TriggerEventParamName(lv_eventname, ("StetmannPowerTowerPlayer")), lp_player);
        TriggerSendEvent(lv_eventname);
        if ((libKMIS_gv_cM_Stetmann_StetelliteChargesLevel[lp_player] > lv_oldchargelevel)) {
            lv_eventname = ("Event_PowerTowerLevelUp");
        }
        else {
            lv_eventname = ("Event_PowerTowerLevelDown");
        }
        DataTableSetInt(false, TriggerEventParamName(lv_eventname, ("StetmannPowerTowerTechLevelOld")), lv_oldchargelevel);
        DataTableSetInt(false, TriggerEventParamName(lv_eventname, ("StetmannPowerTowerTechLevelNew")), libKMIS_gv_cM_Stetmann_StetelliteChargesLevel[lp_player]);
        DataTableSetInt(false, TriggerEventParamName(lv_eventname, ("StetmannPowerTowerPlayer")), lp_player);
        TriggerSendEvent(lv_eventname);
    }

}

//--------------------------------------------------------------------------------------------------
// Trigger: CM_Stetmann_EventHook_LairHiveCreated
//--------------------------------------------------------------------------------------------------
bool libKMIS_gt_CM_Stetmann_EventHook_LairHiveCreated_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_stetmann;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_stetmann = EventPlayer();

    // Conditions
    if (testConds) {
        if (!((libKCOR_gf_PlayerIsCommander(lv_stetmann) == true))) {
            return false;
        }

        if (!((libKCOR_gf_CC_CommanderLevel(EventPlayer(), "ZergStetmann") >= 7))) {
            return false;
        }

        if (!(((UnitGetType(EventPlayerEffectUsedUnit(c_effectUnitCaster)) == "HiveStetmann") || (UnitGetType(EventPlayerEffectUsedUnit(c_effectUnitCaster)) == "LairStetmann")))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libKMIS_gf_CM_Stetmann_ThrowPowerTowerEvent(EventPlayer());
    return true;
}

//--------------------------------------------------------------------------------------------------
