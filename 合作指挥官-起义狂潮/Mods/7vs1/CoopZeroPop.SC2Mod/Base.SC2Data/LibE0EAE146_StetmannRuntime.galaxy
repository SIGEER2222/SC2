    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    Wait(0.0625, c_timeGame);
    autoABD0809F_g = libKCOR_gf_CommanderPlayers();
    autoABD0809F_var = -1;
    while (true) {
        autoABD0809F_var = PlayerGroupNextPlayer(autoABD0809F_g, autoABD0809F_var);
        if (autoABD0809F_var < 0) { break; }
        if ((libKCOR_gf_ActiveCommanderForPlayer(autoABD0809F_var) == "ZergStetmann")) {
