    libKMIS_gt_CM_Stetmann_EventHook_LairHiveCreated = TriggerCreate("libKMIS_gt_CM_Stetmann_EventHook_LairHiveCreated_Func");
    TriggerEnable(libKMIS_gt_CM_Stetmann_EventHook_LairHiveCreated, false);
    TriggerAddEventPlayerEffectUsed(libKMIS_gt_CM_Stetmann_EventHook_LairHiveCreated, c_playerAny, "LairHiveStetmannTrigger");
}

