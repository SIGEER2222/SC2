    TriggerEnable(libKMIS_gt_CM_Stetmann_PowerFieldToggle, true);
    TriggerEnable(libKMIS_gt_CM_Stetmann_BanelingEnergyDamageBoost, true);
    TriggerEnable(libKMIS_gt_CM_Stetmann_BroodLordArmBroodling, true);
    TriggerEnable(libKMIS_gt_CM_Stetmann_PowerTowerTechLevel, true);
    TriggerEnable(libKMIS_gt_CM_Stetmann_GaryUpgrade, true);
    TriggerEnable(libKMIS_gt_CM_Stetmann_StetelliteChainCast, true);
    auto8A6DE514_g = libKCOR_gf_CommanderPlayers();
    lv_p = -1;
    while (true) {
        lv_p = PlayerGroupNextPlayer(auto8A6DE514_g, lv_p);
        if (lv_p < 0) { break; }
        if ((libKCOR_gf_ActiveCommanderForPlayer(lv_p) == "ZergStetmann")) {
            auto66FFA6C3_g = libNtve_gf_AlliesEnemiesOfPlayerCountInactiveAndSelf(libNtve_ge_PlayerRelation_AllyMutual, lv_p);
            lv_stetmannplayer = -1;
            while (true) {
                lv_stetmannplayer = PlayerGroupNextPlayer(auto66FFA6C3_g, lv_stetmannplayer);
                if (lv_stetmannplayer < 0) { break; }
                if ((TechTreeUpgradeCount(lv_stetmannplayer, "MasteryStetmannStetzoneBonusesMovementSpeed", c_techCountQueuedOrBetter) < lv_upgradeCount[lv_p])) {
