bool libKMIS_gt_CM_Stetmann_Set_Func (bool testConds, bool runActions) {
    // Variable Declarations
    string lv_upgrade;
    fixed lv_costMutiplayer;
    string lv_itUnit;
    int lv_player;

    // Automatic Variable Declarations
    int autoF06ACDE6_catalog;
    string autoF06ACDE6_entry;
    string autoF06ACDE6_fieldPath;
    int autoF06ACDE6_player;
    int autoF06ACDE6_i;

    // Variable Initialization
    lv_upgrade = EventUpgradeName();
    lv_costMutiplayer = 1.4;
    lv_itUnit = "";
    lv_player = EventPlayer();

    // Conditions
    if (testConds) {
        if (!((lv_upgrade == "CommanderPrestigeStetmannCombatBuff"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    autoF06ACDE6_catalog = c_gameCatalogUpgrade;
    autoF06ACDE6_entry = lv_upgrade;
    autoF06ACDE6_fieldPath = "AffectedUnitArray";
    autoF06ACDE6_player = lv_player;
    autoF06ACDE6_i = 0;
    for ( ; autoF06ACDE6_i <= CatalogFieldValueCount(c_gameCatalogUpgrade,autoF06ACDE6_entry,autoF06ACDE6_fieldPath,autoF06ACDE6_player)-1 ; autoF06ACDE6_i += 1 ) {
        lv_itUnit = CatalogFieldValueGet(c_gameCatalogUpgrade,autoF06ACDE6_entry,autoF06ACDE6_fieldPath+"["+IntToString(autoF06ACDE6_i)+"]",autoF06ACDE6_player);
        CatalogFieldValueSet(c_gameCatalogUnit, lv_itUnit, "CostResource[" + IntToString(0) + "]", lv_player, IntToString(CeilingI((CatalogFieldValueGetAsInt(c_gameCatalogUnit, lv_itUnit, "CostResource[" + IntToString(0) + "]", c_playerAny)*lv_costMutiplayer))));
    }
    TriggerEnable(TriggerGetCurrent(), false);
    return true;
}

