    DialogControlHookup(libKCUI_gv_cU_GPPanel[lp_player], c_triggerControlTypeCommandPanel, "StetmannGlobalCommandPanel");
    libKCUI_gv_cU_GPCmdPanel[lp_player] = DialogControlLastCreated();
    lv_buttonIndex = 1;
    for ( ; ( (auto48FECC0D_ai >= 0 && lv_buttonIndex <= auto48FECC0D_ae) || (auto48FECC0D_ai < 0 && lv_buttonIndex >= auto48FECC0D_ae) ) ; lv_buttonIndex += auto48FECC0D_ai ) {
        DialogControlHookup(libKCUI_gv_cU_GPCmdPanel[lp_player], c_triggerControlTypeButton, "CommandButton0" + IntToString(lv_buttonIndex-1));
