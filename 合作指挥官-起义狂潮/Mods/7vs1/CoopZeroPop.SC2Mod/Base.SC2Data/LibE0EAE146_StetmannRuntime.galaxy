//--------------------------------------------------------------------------------------------------
// Trigger: CM_Stetmann_PowerTowerTechLevel
//--------------------------------------------------------------------------------------------------
bool libKMIS_gt_CM_Stetmann_PowerTowerTechLevel_Func (bool testConds, bool runActions) {
    // Variable Declarations
    string lv_powertowerabilstring;
    string lv_abillink;
    int lv_oldmaxcharges;
    int lv_newmaxcharges;
    int lv_deltamaxcharges;
    int lv_oldchargesused;
    int lv_newchargesused;
    fixed lv_oldrechargetime;
    fixed lv_newrechargetime;
    fixed lv_deltarechargetime;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_powertowerabilstring = "Abil/DeployPowerTowerStetmann";
    lv_abillink = "DeployPowerTowerStetmann";

    // Actions
    if (!runActions) {
        return true;
    }

    lv_oldmaxcharges = CatalogFieldValueGetAsInt(c_gameCatalogAbil, lv_abillink, "InfoArray[" + IntToString(0) + "].Charge.CountMax", libKMIS_gf_EventStetmannPowerTowerPlayer());
    lv_oldrechargetime = libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogAbil, lv_abillink, "InfoArray[" + IntToString(0) + "].Charge.TimeUse", libKMIS_gf_EventStetmannPowerTowerPlayer());
    lv_oldchargesused = RoundI(PlayerGetChargeUsed(libKMIS_gf_EventStetmannPowerTowerPlayer(), lv_powertowerabilstring));
    libNtve_gf_SetUpgradeLevelForPlayer(libKMIS_gf_EventStetmannPowerTowerPlayer(), "DeployPowerTowerTechLevel", libKMIS_gf_EventStetmannPowerTowerTechLevel("StetmannPowerTowerTechLevelNew"));
    lv_newmaxcharges = CatalogFieldValueGetAsInt(c_gameCatalogAbil, lv_abillink, "InfoArray[" + IntToString(0) + "].Charge.CountMax", libKMIS_gf_EventStetmannPowerTowerPlayer());
    lv_deltamaxcharges = (lv_newmaxcharges - lv_oldmaxcharges);
    lv_newchargesused = (lv_oldchargesused + lv_deltamaxcharges);
    lv_newrechargetime = libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogAbil, lv_abillink, "InfoArray[" + IntToString(0) + "].Charge.TimeUse", libKMIS_gf_EventStetmannPowerTowerPlayer());
    lv_deltarechargetime = (lv_newrechargetime - lv_oldrechargetime);
    return true;
}

