            libKMIS_gf_CM_MasteryStetmannUpgradeCost(autoABD0809F_var);
            lv_panelWaits = 0;
            while ((libKCUI_gv_cU_GPPanel[autoABD0809F_var] == c_invalidDialogControlId) && (lv_panelWaits < 32)) {
                Wait(0.0625, c_timeGame);
                lv_panelWaits += 1;
            }
            if ((libKCUI_gv_cU_GPPanel[autoABD0809F_var] != c_invalidDialogControlId)) {
                DialogControlSetAnimationState(libKCUI_gv_cU_GPPanel[autoABD0809F_var], PlayerGroupSingle(autoABD0809F_var), "ReminderStetzones", "NoReminder");
                DialogControlSetAnimationState(libKCUI_gv_cU_GPPanel[autoABD0809F_var], PlayerGroupSingle(autoABD0809F_var), "ReminderStetellites", "NoReminder");
                if ((libKCOR_gf_CC_CommanderLevel(autoABD0809F_var, "ZergStetmann") >= 2)) {
                    DialogControlSetAnimationState(libKCUI_gv_cU_GPPanel[autoABD0809F_var], PlayerGroupSingle(autoABD0809F_var), "EgonergyLockedState", "Unlocked");
                }
                else {
