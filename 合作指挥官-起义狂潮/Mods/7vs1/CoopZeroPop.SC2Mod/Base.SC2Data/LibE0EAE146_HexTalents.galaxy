//--------------------------------------------------------------------------------------------------
// 海克斯天赋系统（与 WebUI StartTalentMask 对接）
//--------------------------------------------------------------------------------------------------

const int libE0EAE146_kc_hexTalentBit_healthBonus = 3;
const int libE0EAE146_kc_hexTalentBit_damageBonus = 4;
const int libE0EAE146_kc_hexTalentBit_moveSpeedBonus = 5;
const int libE0EAE146_kc_hexTalentBit_armorBonus = 6;
const int libE0EAE146_kc_hexTalentBit_sightRangeBonus = 7;

const string libE0EAE146_kc_hexTalent_healthBonus_behavior = "HexTalent_HealthBonus";
const string libE0EAE146_kc_hexTalent_damageBonus_behavior = "HexTalent_DamageBonus";
const string libE0EAE146_kc_hexTalent_moveSpeedBonus_behavior = "HexTalent_MoveSpeedBonus";
const string libE0EAE146_kc_hexTalent_armorBonus_behavior = "HexTalent_ArmorBonus";
const string libE0EAE146_kc_hexTalent_sightRangeBonus_behavior = "HexTalent_SightRangeBonus";

int[16] libE0EAE146_gv_hexTalents_startMask;

//--------------------------------------------------------------------------------------------------
void libE0EAE146_hexTalents_InitVariables () {
    int lv_i;

    lv_i = 0;
    while (lv_i <= 15) {
        libE0EAE146_gv_hexTalents_startMask[lv_i] = 0;
        lv_i += 1;
    }
}

//--------------------------------------------------------------------------------------------------
bool libE0EAE146_gf_HexTalentsIsCasterUnit (string lp_unitType) {
    if ((lp_unitType == "CoopCasterAbathur") || (lp_unitType == "CoopCasterAlarak") ||
        (lp_unitType == "CoopCasterDehaka") || (lp_unitType == "CoopCasterFenix") ||
        (lp_unitType == "CoopCasterHorner") || (lp_unitType == "CoopCasterKarax") ||
        (lp_unitType == "CoopCasterKerrigan") || (lp_unitType == "CoopCasterMengsk") ||
        (lp_unitType == "CoopCasterNova") || (lp_unitType == "CoopCasterRaynor") ||
        (lp_unitType == "CoopCasterStetmann") || (lp_unitType == "CoopCasterStukov") ||
        (lp_unitType == "CoopCasterSwann") || (lp_unitType == "CoopCasterTychus") ||
        (lp_unitType == "CoopCasterVorazun") || (lp_unitType == "CoopCasterZagara") ||
        (lp_unitType == "CoopCasterZeratul") || (lp_unitType == "SoACasterArtanis") ||
        (lp_unitType == "SoACasterKarax") || (lp_unitType == "SoACasterFenix") ||
        (lp_unitType == "SoACasterVorazun") || (lp_unitType == "CoopCasterZeratulSpecialization")) {
        return true;
    }
    return false;
}

//--------------------------------------------------------------------------------------------------
void libE0EAE146_gf_HexTalentsApplyBehaviorToUnit (unit lp_unit, int lp_player) {
    string lv_unitType;
    int lv_mask;

    if (libE0EAE146_gv_hexTalents_startMask[lp_player] == 0) {
        return;
    }

    lv_unitType = UnitGetType(lp_unit);

    if (libE0EAE146_gf_HexTalentsIsCasterUnit(lv_unitType) == true) {
        return;
    }

    if ((lv_unitType == "InvisibleTargetDummy") || (lv_unitType == "DehakaCoopClone") ||
        (lv_unitType == "EssencePickup") || (lv_unitType == "DNAPickup") ||
        (lv_unitType == "BiomassPickup")) {
        return;
    }

    lv_mask = libE0EAE146_gv_hexTalents_startMask[lp_player];

    if (lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_mask, libE0EAE146_kc_hexTalentBit_healthBonus) == true) {
        if (UnitBehaviorCount(lp_unit, libE0EAE146_kc_hexTalent_healthBonus_behavior) == 0) {
            UnitBehaviorAddPlayer(lp_unit, libE0EAE146_kc_hexTalent_healthBonus_behavior, lp_player, 1);
        }
    }

    if (lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_mask, libE0EAE146_kc_hexTalentBit_damageBonus) == true) {
        if (UnitBehaviorCount(lp_unit, libE0EAE146_kc_hexTalent_damageBonus_behavior) == 0) {
            UnitBehaviorAddPlayer(lp_unit, libE0EAE146_kc_hexTalent_damageBonus_behavior, lp_player, 1);
        }
    }

    if (lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_mask, libE0EAE146_kc_hexTalentBit_moveSpeedBonus) == true) {
        if (UnitBehaviorCount(lp_unit, libE0EAE146_kc_hexTalent_moveSpeedBonus_behavior) == 0) {
            UnitBehaviorAddPlayer(lp_unit, libE0EAE146_kc_hexTalent_moveSpeedBonus_behavior, lp_player, 1);
        }
    }

    if (lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_mask, libE0EAE146_kc_hexTalentBit_armorBonus) == true) {
        if (UnitBehaviorCount(lp_unit, libE0EAE146_kc_hexTalent_armorBonus_behavior) == 0) {
            UnitBehaviorAddPlayer(lp_unit, libE0EAE146_kc_hexTalent_armorBonus_behavior, lp_player, 1);
        }
    }

    if (lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_mask, libE0EAE146_kc_hexTalentBit_sightRangeBonus) == true) {
        if (UnitBehaviorCount(lp_unit, libE0EAE146_kc_hexTalent_sightRangeBonus_behavior) == 0) {
            UnitBehaviorAddPlayer(lp_unit, libE0EAE146_kc_hexTalent_sightRangeBonus_behavior, lp_player, 1);
        }
    }
}

//--------------------------------------------------------------------------------------------------
void libE0EAE146_gf_HexTalentsPlayerInit (int lp_player) {
    string lv_commander;
    int lv_mask;

    libE0EAE146_gv_hexTalents_startMask[lp_player] = 0;

    lv_commander = libE0EAE146_gv_commander;
    if (lv_commander == "") {
        return;
    }

    lv_mask = libE0EAE146_gf_CommanderPowerBankIntOrDefault(lv_commander, "StartTalentMask", 0);
    libE0EAE146_gv_hexTalents_startMask[lp_player] = lv_mask;
}

//--------------------------------------------------------------------------------------------------
bool libE0EAE146_gt_HexTalentsUnitCreated_Func (bool testConds, bool runActions) {
    unit lv_unit;
    int lv_player;

    lv_unit = EventUnit();
    lv_player = UnitGetOwner(lv_unit);

    if (testConds) {
        if (!((PlayerStatus(lv_player) == c_playerStatusActive))) {
            return false;
        }
        if (!((UnitIsAlive(lv_unit) == true))) {
            return false;
        }
    }

    if (!runActions) {
        return true;
    }

    libE0EAE146_gf_HexTalentsApplyBehaviorToUnit(lv_unit, lv_player);

    return true;
}

//--------------------------------------------------------------------------------------------------
bool libE0EAE146_gt_HexTalentsGameStart_Func (bool testConds, bool runActions) {
    int lv_player;

    if (!runActions) {
        return true;
    }

    lv_player = 0;
    while (lv_player <= 15) {
        if (PlayerStatus(lv_player) == c_playerStatusActive) {
            libE0EAE146_gf_HexTalentsPlayerInit(lv_player);
        }
        lv_player += 1;
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void libE0EAE146_gt_HexTalentsUnitCreated_Init () {
    libE0EAE146_gt_HexTalentsUnitCreated = TriggerCreate("libE0EAE146_gt_HexTalentsUnitCreated_Func");
    TriggerAddEventUnitCreated(libE0EAE146_gt_HexTalentsUnitCreated, null, null, null);
}

//--------------------------------------------------------------------------------------------------
void libE0EAE146_gt_HexTalentsGameStart_Init () {
    libE0EAE146_gt_HexTalentsGameStart = TriggerCreate("libE0EAE146_gt_HexTalentsGameStart_Func");
    TriggerAddEventMapInit(libE0EAE146_gt_HexTalentsGameStart);
}

//--------------------------------------------------------------------------------------------------
void libE0EAE146_hexTalents_InitTriggers () {
    libE0EAE146_gt_HexTalentsUnitCreated_Init();
    libE0EAE146_gt_HexTalentsGameStart_Init();
}
