// Shared Abathur biomass logic stays in CommanderStartSquads.
// This runtime file only owns the standard commander init path.

void libE0EAE146_gf_AbathurSetUpgradeAtLeast (int lp_player, string lp_upgrade, int lp_level) {
    int lv_currentLevel;

    if ((lp_upgrade == "") || (!CatalogEntryIsValid(c_gameCatalogUpgrade, lp_upgrade))) {
        return;
    }

    lv_currentLevel = TechTreeUpgradeCount(lp_player, lp_upgrade, c_techCountCompleteOnly);
    if (lv_currentLevel < lp_level) {
        TechTreeUpgradeAddLevel(lp_player, lp_upgrade, (lp_level - lv_currentLevel));
    }
}

void libE0EAE146_gf_AbathurApplyFullLevelUpgrades (int lp_player) {
    libE0EAE146_gf_AbathurSetUpgradeAtLeast(lp_player, "CommanderLevel", 16);
    libE0EAE146_gf_AbathurSetUpgradeAtLeast(lp_player, "AbathurCommander", 1);
    libE0EAE146_gf_AbathurSetUpgradeAtLeast(lp_player, "SwarmQueenVisual", 1);
    libE0EAE146_gf_AbathurSetUpgradeAtLeast(lp_player, "AbathurToxicNestIcreasedBiomass", 1);
    libE0EAE146_gf_AbathurSetUpgradeAtLeast(lp_player, "AbathurHiddenToxicNest", 1);
    libE0EAE146_gf_AbathurSetUpgradeAtLeast(lp_player, "AbathurToxicNestRespawnTalent", 1);
    libE0EAE146_gf_AbathurSetUpgradeAtLeast(lp_player, "AbathurImprovedToxicNest", 1);
    libE0EAE146_gf_AbathurSetUpgradeAtLeast(lp_player, "AbathurImprovedMend", 1);
    libE0EAE146_gf_AbathurSetUpgradeAtLeast(lp_player, "AbathurBiomassRefund", 1);
    libE0EAE146_gf_AbathurSetUpgradeAtLeast(lp_player, "AbathurEnableSymbiote", 1);
    libE0EAE146_gf_AbathurSetUpgradeAtLeast(lp_player, "AbathurSymbiote", 1);
    libE0EAE146_gf_AbathurSetUpgradeAtLeast(lp_player, "AbathurMorphTimeCostReduced", 1);
    libE0EAE146_gf_AbathurSetUpgradeAtLeast(lp_player, "AbathurEnemyDeathCreateLocusts", 1);
    libE0EAE146_gf_AbathurSetUpgradeAtLeast(lp_player, "AbathurBiomassLifeLeech", 1);
}

void libE0EAE146_gf_AbathurApplyFullMasteries (int lp_player) {
    libE0EAE146_gf_AbathurSetUpgradeAtLeast(lp_player, "MasteryAbathurToxicNestDamageAndRespawn", 30);
    libE0EAE146_gf_AbathurSetUpgradeAtLeast(lp_player, "MasteryAbathurMendHeal", 30);
