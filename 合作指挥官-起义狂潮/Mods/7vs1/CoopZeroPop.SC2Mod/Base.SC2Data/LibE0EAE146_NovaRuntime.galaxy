//--------------------------------------------------------------------------------------------------
// Trigger: CM_NovaRespawnBuyBack
//--------------------------------------------------------------------------------------------------
bool libE0EAE146_gt_CM_NovaRespawnBuyBack_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    libKMIS_gv_cM_HeroReviveTargetLocation[EventPlayer()] = EventUnitTargetPoint();
    libNtve_gf_PlayerRemoveCooldown(EventPlayer(), libKCOR_gf_CC_CommanderHeroReviveLink(libKCOR_gf_ActiveCommanderForPlayer(EventPlayer())));
    TriggerEnable(libE0EAE146_gt_CM_NovaRespawnBuyBackCostAdjustment, false);
    CatalogFieldValueSet(c_gameCatalogAbil, "NovaReviveInstantBuyback", "Cost[" + IntToString(0) + "].Resource[" + IntToString(c_resourceTypeMinerals) + "]", EventPlayer(), "450");
    UnitBehaviorAdd(libKMIS_gv_cM_HeroUnit[EventPlayer()], "TargetedRevive", libKMIS_gv_cM_HeroUnit[EventPlayer()], 1);
    return true;
}

