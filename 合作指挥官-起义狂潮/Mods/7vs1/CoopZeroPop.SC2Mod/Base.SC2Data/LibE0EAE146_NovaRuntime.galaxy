    libE0EAE146_gt_CM_NovaGriffinBombingRunFinish_Init();
    libE0EAE146_gt_CM_Nova_TriggersInit_Init();
    libE0EAE146_gt_CM_NovaSiegeModeProgressiveRangeIncreaseApply_Init();
    libE0EAE146_gt_CM_NovaPsiStrike_Init();
    libE0EAE146_gt_CM_Nova_BuildingCompletedTrigger_Init();
