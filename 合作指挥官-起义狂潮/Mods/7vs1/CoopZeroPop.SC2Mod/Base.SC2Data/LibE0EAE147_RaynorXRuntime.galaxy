bool libE0EAE147_gf_RaynorXStructureNeedsRefresh (unit lp_unit) {
    string lv_unitType;

    if (UnitIsAlive(lp_unit) == false) {
        return false;
    }

    if (libKCOR_gf_ActiveCommanderForPlayer(UnitGetOwner(lp_unit)) != "TerranRaynorX") {
        return false;
    }

    lv_unitType = UnitGetType(lp_unit);
    if ((lv_unitType == "CommandCenterRaynorX") || (lv_unitType == "CommandCenterFlyingRaynorX") || (lv_unitType == "OrbitalCommandRaynorX") || (lv_unitType == "OrbitalCommandFlyingRaynorX")) {
        return true;
    }

    return false;
}

string libE0EAE147_gf_RaynorXMorphExpectedUnitType (abilcmd lp_abilCmd) {
    string lv_abil;

    lv_abil = AbilityCommandGetAbility(lp_abilCmd);
    if (lv_abil == "CommandCenterLiftOffRaynorX") {
