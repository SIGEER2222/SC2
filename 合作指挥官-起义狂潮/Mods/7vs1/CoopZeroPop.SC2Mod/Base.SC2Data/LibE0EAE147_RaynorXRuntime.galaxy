        UnitCreateEffectUnit(lv_newUnit, "CopyTargetSelectionAndControlGroups", EventUnit());
        if (lv_wasSelected == true) {
            UnitGroupRemove(lv_selectedUnits, EventUnit());
            UnitGroupAdd(lv_selectedUnits, lv_newUnit);
            UnitClearSelection(lv_player);
            Wait(0.0625, c_timeGame);
            UnitSelect(lv_newUnit, lv_player, true);
            UnitGroupSelect(lv_selectedUnits, lv_player, true);
        }
    }
    else if (lv_wasSelected == true) {
        lv_newUnit = libE0EAE147_gf_RaynorXFindNearestOwnedUnitOfType(lv_player, libE0EAE147_gf_RaynorXMorphExpectedUnitType(EventUnitAbility()), lv_oldPoint, 8.0);
        if ((lv_newUnit != null) && (UnitIsAlive(lv_newUnit) == true)) {
            UnitClearSelection(lv_player);
            UnitSelect(lv_newUnit, lv_player, true);
        }
    }
    if (((lv_newUnit != null) && (libE0EAE147_gf_RaynorXStructureNeedsRefresh(lv_newUnit) == true)) || (libE0EAE147_gf_RaynorXStructureNeedsRefresh(EventUnit()) == true)) {
        libE0EAE147_gf_RaynorXApplyTechFilter(lv_player);
    }
    return true;
}

