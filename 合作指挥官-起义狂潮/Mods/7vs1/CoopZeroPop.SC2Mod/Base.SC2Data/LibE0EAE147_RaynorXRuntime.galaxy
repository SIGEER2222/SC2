}

void libE0EAE147_gf_RaynorXAllowUnitIfPresent (int lp_player, string lp_unit) {
    if ((lp_unit == "") || (!CatalogEntryIsValid(c_gameCatalogUnit, lp_unit))) {
        return;
    }
    TechTreeUnitAllow(lp_player, lp_unit, true);
}

void libE0EAE147_gf_RaynorXBlockUnitIfPresent (int lp_player, string lp_unit) {
    if ((lp_unit == "") || (!CatalogEntryIsValid(c_gameCatalogUnit, lp_unit))) {
        return;
    }
    TechTreeUnitAllow(lp_player, lp_unit, false);
}

void libE0EAE147_gf_RaynorXAllowAbilityIfPresent (int lp_player, string lp_abil, int lp_cmdIndex) {
    if ((lp_abil == "") || (!CatalogEntryIsValid(c_gameCatalogAbil, lp_abil))) {
        return;
    }
    TechTreeAbilityAllow(lp_player, AbilityCommand(lp_abil, lp_cmdIndex), true);
}

void libE0EAE147_gf_RaynorXAllowAddOnAbilityIfPresent (int lp_player, string lp_abil) {
    libE0EAE147_gf_RaynorXAllowAbilityIfPresent(lp_player, lp_abil, 0);
    libE0EAE147_gf_RaynorXAllowAbilityIfPresent(lp_player, lp_abil, 1);
    libE0EAE147_gf_RaynorXAllowAbilityIfPresent(lp_player, lp_abil, 3);
}

