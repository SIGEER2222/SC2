int libE0EAE147_gf_RaynorXRuntimeUnitTypeCount (int lp_player, string lp_unitType) {
    if ((lp_unitType == "") || (!CatalogEntryIsValid(c_gameCatalogUnit, lp_unitType))) {
        return 0;
    }

    return UnitGroupCount(UnitGroup(lp_unitType, lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive);
}

void libE0EAE147_gf_RaynorXTrainProbeWriteInt (string lp_key, int lp_value) {
    BankLoad("CampaignXCore", 1);
    BankValueSetFromInt(BankLastCreated(), "XMRuntimeDebug", lp_key, lp_value);
    BankSave(BankLastCreated());
}

void libE0EAE147_gf_RaynorXTrainProbeWriteString (string lp_key, string lp_value) {
    BankLoad("CampaignXCore", 1);
    BankValueSetFromString(BankLastCreated(), "XMRuntimeDebug", lp_key, lp_value);
    BankSave(BankLastCreated());
}

int libE0EAE147_gf_RaynorXBoolToInt (bool lp_value) {
    if (lp_value) {
        return 1;
    }

    return 0;
}

void libE0EAE147_gf_RaynorXTrainProbeWriteOrderValidity (unit lp_unit, string lp_abil, int lp_maxCmdIndex, string lp_keyPrefix) {
    int lv_cmdIndex;
    order lv_order;

    lv_cmdIndex = 0;
    while ((lv_cmdIndex <= lp_maxCmdIndex)) {
        lv_order = Order(AbilityCommand(lp_abil, lv_cmdIndex));
        libE0EAE147_gf_RaynorXTrainProbeWriteInt(lp_keyPrefix + IntToString(lv_cmdIndex) + "Valid", libE0EAE147_gf_RaynorXBoolToInt(UnitOrderIsValid(lp_unit, lv_order)));
        lv_cmdIndex += 1;
    }
}

void libE0EAE147_gf_RaynorXSetUpgradeAtLeast (int lp_player, string lp_upgrade, int lp_level) {
