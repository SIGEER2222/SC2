    lv_newUnit = libNtve_gf_LastReplacedUnit();
    if ((lv_newUnit != null) && (UnitIsAlive(lv_newUnit) == true) && (UnitGetOwner(lv_newUnit) == lv_player)) {
        if ((lv_expectedType == "") || (UnitGetType(lv_newUnit) == lv_expectedType)) {
            return lv_newUnit;
        }
    }

    lv_oldPoint = UnitGetPosition(lp_oldUnit);
    return libE0EAE147_gf_RaynorXFindNearestOwnedUnitOfType(lv_player, lv_expectedType, lv_oldPoint, 6.0);
}

