}

void libE0EAE146_gf_StukovSpawnInfestedMarineIntoOneBanshee (unit lp_banshee) {
    unit lv_newUnit;
    fixed lv_energy;

    if ((lp_banshee == null)) {
        return;
    }

    if ((UnitCargoValue(lp_banshee, c_unitCargoSpaceFree) <= 0)) {
        return;
    }

    lv_energy = UnitGetPropertyFixed(lp_banshee, c_unitPropEnergy, c_unitPropCurrent);
    if ((lv_energy < 20.0)) {
        return;
    }

    UnitSetPropertyFixed(lp_banshee, c_unitPropEnergy, MaxF((lv_energy - 20.0), 0.0));
    UnitCargoCreate(lp_banshee, "SIInfestedMarine", 1);
    lv_newUnit = UnitCargoLastCreated();
    if ((lv_newUnit != null)) {
        UnitSetState(lv_newUnit, c_unitStateUsingSupply, false);
        UnitBehaviorAdd(lv_newUnit, "InfestedStukovInfestedTerranTimedLife", lv_newUnit, 1);
    }
}

void libE0EAE146_gf_StukovSpawnInfestedMarineIntoBanshees (int lp_player) {
    int lv_unitCount;
    unit lv_banshee;
    unitgroup lv_banshees;

    if ((!CatalogEntryIsValid(c_gameCatalogUnit, "StukovInfestedBanshee")) || (!CatalogEntryIsValid(c_gameCatalogUnit, "SIInfestedMarine"))) {
        return;
    }

    lv_banshees = UnitGroup("StukovInfestedBanshee", lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    if (CatalogEntryIsValid(c_gameCatalogUnit, "StukovInfestedBansheeBurrowed")) {
        UnitGroupAddUnitGroup(lv_banshees, UnitGroup("StukovInfestedBansheeBurrowed", lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    }

    lv_unitCount = UnitGroupCount(lv_banshees, c_unitCountAlive);
    for (;; lv_unitCount -= 1) {
        lv_banshee = UnitGroupUnitFromEnd(lv_banshees, lv_unitCount);
        if (lv_banshee == null) { break; }
        libE0EAE146_gf_StukovSpawnInfestedMarineIntoOneBanshee(lv_banshee);
    }
}

