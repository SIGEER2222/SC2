    libE0EAE146_gt_CM_PrestigeTychus_LoneWolfChanged = TriggerCreate("libE0EAE146_gt_CM_PrestigeTychus_LoneWolfChanged_Func");
    TriggerAddEventUnitBehaviorChange(libE0EAE146_gt_CM_PrestigeTychus_LoneWolfChanged, null, "CommanderPrestigeTychusLoneWolf", c_unitBehaviorChangeActivate);
    TriggerAddEventUnitBehaviorChange(libE0EAE146_gt_CM_PrestigeTychus_LoneWolfChanged, null, "CommanderPrestigeTychusLoneWolf", c_unitBehaviorChangeDeactivate);
}

