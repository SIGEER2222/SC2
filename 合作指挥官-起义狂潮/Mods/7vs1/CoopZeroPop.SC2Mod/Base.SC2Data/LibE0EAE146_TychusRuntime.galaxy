    lib81FF3B49_gf_InitializeTychusEvent();
    lib67C0F0E7_gf_CU_GPShowHide(true, lp_player, c_transitionDurationDefault);
    lv_mastery = (libE0EAE146_gf_CommanderPowerMasteryLevel("Tychus", 3) * 3);
    if (lp_createHero == true) {
        lib67C0F0E7_gf_TychusSquadStartCharge((10 - lv_mastery), (240 - lv_mastery));
    }
    else {
        lib67C0F0E7_gf_TychusSquadStartCharge((240 - lv_mastery), (240 - lv_mastery));
    }
}

