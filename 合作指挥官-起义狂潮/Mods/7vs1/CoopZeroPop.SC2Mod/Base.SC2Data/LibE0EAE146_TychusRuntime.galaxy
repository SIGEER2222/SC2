        TextExpressionSetToken("Param/Expression/lib_KMIS_53BFB085", "B", StringExternal("Param/Value/lib_KMIS_34A9A655"));
        TextTagCreate(TextExpressionAssemble("Param/Expression/lib_KMIS_53BFB085"), 24, UnitGetPosition(EventPlayerEffectUsedUnit(c_effectUnitCaster)), 3.0, true, false, PlayerGroupAll());
    }
    else if ((UnitBehaviorCount(EventPlayerEffectUsedUnit(c_effectUnitCaster), "TychusHercRageDamageBuff") > 0) && (UnitBehaviorCount(EventPlayerEffectUsedUnit(c_effectUnitCaster), "TychusHercRageDamageBuff") < CatalogFieldValueGetAsInt(c_gameCatalogBehavior, "TychusHercRageDamageBuff", "MaxStackCount", libKCOR_gf_CC_PlayerOfCommanderInGroupFirst("TerranTychus", libKCOR_gf_CC_PlayersOfCommander("TerranTychus"))))) {
