//--------------------------------------------------------------------------------------------------
// Trigger: CM_SoAOrbitalStrikeActivatedKarax
//--------------------------------------------------------------------------------------------------
bool libE0EAE146_gt_CM_SoAOrbitalStrikeActivatedKarax_Func (bool testConds, bool runActions) {
    int lv_casterPlayer;

    if (testConds) {
        if (!((TechTreeUpgradeCount(EventPlayer(), "KaraxCommander", c_techCountCompleteOnly) == 1))) {
            return false;
        }
    }

    if (!runActions) {
        return true;
    }

    lv_casterPlayer = UnitGetOwner(EventPlayerEffectUsedUnit(c_effectUnitCaster));
    libKMIS_gv_cM_SoATargetingOrder[lv_casterPlayer] = OrderTargetingPoint(AbilityCommand("SOAOrbitalStrikeKarax", 0), UnitGetPosition(libKMIS_gv_cM_SoACasterUnit[lv_casterPlayer]));
    UISetTargetingOrder(PlayerGroupSingle(lv_casterPlayer), libKMIS_gv_cM_SoACasterGroup[lv_casterPlayer], libKMIS_gv_cM_SoATargetingOrder[lv_casterPlayer], false);
    return true;
}

