//--------------------------------------------------------------------------------------------------
void libE0EAE146_gf_KaraxRuntimeInit (int lp_player, point lp_heroPoint, bool lp_createHero) {
    unit lv_caster;

    if (libE0EAE146_gv_karaxRuntimeInitialized == true) {
        return;
    }

    libE0EAE146_gv_karaxRuntimeInitialized = true;
    libE0EAE146_gf_CommanderPowerApplyProfile(lp_player, "Karax");
    if (libE0EAE146_gf_CommanderUsePrivateTechFilter("Karax")) {
        libE0EAE146_gf_KaraxApplyTechFilter(lp_player);
    }

    libE0EAE146_gt_CM_KaraxRepairBeamLimit_Init();
    libE0EAE146_gt_CM_KaraxUnitReviveBarrier_Init();
    libE0EAE146_gt_CM_KaraxSolarForgeSOAEnergy_Init();
    libE0EAE146_gt_CM_SoAOrbitalStrikeActivatedKarax_Init();
    TriggerEnable(libE0EAE146_gt_CM_KaraxRepairBeamLimit, true);
    TriggerEnable(libE0EAE146_gt_CM_KaraxUnitReviveBarrier, true);
    TriggerEnable(libE0EAE146_gt_CM_KaraxSolarForgeSOAEnergy, true);
    libE0EAE146_gf_KaraxSetRepairBeamLimit(lp_player);
    TriggerExecute(libE0EAE146_gt_CM_KaraxRepairBeamLimit, false, true);

    libNtve_gf_CreateUnitsWithDefaultFacing(1, "SoACasterKarax", c_unitCreateIgnorePlacement, lp_player, RegionGetBoundsMin(RegionEntireMap()));
    lv_caster = UnitLastCreated();
    lib67C0F0E7_gf_CU_GPInit(lp_player, "Karax", lv_caster, null);
    lib67C0F0E7_gf_CU_GPShowHide(true, lp_player, c_transitionDurationDefault);
    lib67C0F0E7_gf_ShowChooseButton();
    libE0EAE146_gf_CreateCommanderHeroStructure(lp_player, "Karax");

    if (lp_createHero == true) {
        libE0EAE146_gt_CommanderHeroDied_Init();
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "KaraxChampion", 0, lp_player, lp_heroPoint);
    }
}
