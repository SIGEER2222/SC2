    libE0EAE146_gt_CM_KaraxSolarForgeSOAEnergy = TriggerCreate("libE0EAE146_gt_CM_KaraxSolarForgeSOAEnergy_Func");
    TriggerEnable(libE0EAE146_gt_CM_KaraxSolarForgeSOAEnergy, false);
