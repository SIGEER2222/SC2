include "LibKPVP_h"

//--------------------------------------------------------------------------------------------------
// Commander attribute resolution: resolve from bank first, fallback to GameAttributePlayerValue
//--------------------------------------------------------------------------------------------------
string libKPVP_gf_codex_commander_attribute_from_bank_key (string lp_bankKey) {
    if (lp_bankKey == "Abathur") {
        return "0001";
    }
    else if (lp_bankKey == "Alarak") {
        return "0002";
    }
    else if (lp_bankKey == "Artanis") {
        return "0003";
    }
    else if (lp_bankKey == "Dehaka") {
        return "0004";
    }
    else if (lp_bankKey == "Fenix") {
        return "0005";
    }
    else if (lp_bankKey == "Horner") {
        return "0006";
    }
    else if (lp_bankKey == "Karax") {
        return "0007";
    }
    else if (lp_bankKey == "Kerrigan") {
        return "0008";
    }
    else if (lp_bankKey == "Nova") {
        return "0009";
    }
    else if (lp_bankKey == "Raynor") {
        return "0010";
    }
    else if (lp_bankKey == "Stukov") {
        return "0011";
    }
    else if (lp_bankKey == "Swann") {
        return "0012";
    }
    else if (lp_bankKey == "Vorazun") {
        return "0013";
    }
    else if (lp_bankKey == "Zagara") {
        return "0014";
    }
    else if (lp_bankKey == "Tychus") {
        return "0016";
    }
    else if (lp_bankKey == "Zeratul") {
        return "0017";
    }
    else if (lp_bankKey == "Stetmann") {
        return "0018";
    }
    else if (lp_bankKey == "Mengsk") {
        return "0019";
    }

    return "";
}

string libKPVP_gf_codex_commander_attribute_for_runtime_player (int lp_player) {
    string lv_bankKey;
    string lv_bankAttribute;
    string lv_slotKey;

    lv_bankKey = "";
    lv_slotKey = ("CommanderP" + IntToString(lp_player));
    BankLoad("CampaignXCore", 1);
    if (BankKeyExists(BankLastCreated(), "XMRuntimeControl", lv_slotKey)) {
        lv_bankKey = BankValueGetAsString(BankLastCreated(), "XMRuntimeControl", lv_slotKey);
    }
    if ((lv_bankKey == "") && BankKeyExists(BankLastCreated(), "XMRuntimeControl", "PrimaryCommander")) {
        lv_bankKey = BankValueGetAsString(BankLastCreated(), "XMRuntimeControl", "PrimaryCommander");
    }
    lv_bankAttribute = libKPVP_gf_codex_commander_attribute_from_bank_key(lv_bankKey);
    if (lv_bankAttribute != "") {
        return lv_bankAttribute;
    }

    return GameAttributePlayerValue("[bnet:local/0.0/223536]1", lp_player);
}

//--------------------------------------------------------------------------------------------------
// Swann Kel-Morian Worker tech initialization
//--------------------------------------------------------------------------------------------------
void libKPVP_gf_codex_apply_swann_worker_tech (int lp_player) {
    int lv_build;

    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "SwannCommander", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "CommanderLevel", 15);
    TechTreeAbilityAllow(lp_player, AbilityCommand("KelMorianWorkerBuild", 0), true);
    lv_build = 1;
    while (lv_build <= 24) {
        TechTreeAbilityAllow(lp_player, AbilityCommand("KelMorianWorkerBuild", lv_build), true);
        lv_build = lv_build + 1;
    }
    TechTreeAbilityAllow(lp_player, AbilityCommand("KelMorianWorkerRepair", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("AdvancedConstructionAuto", 0), true);
    UIDisplayMessage(PlayerGroupSingle(lp_player), c_messageAreaChat, StringToText(("Codex test init: TerranSwann KelMorianWorker tech enabled. Workers=" + IntToString(UnitGroupCount(UnitGroup("KelMorianWorker", lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive)))));
}

//--------------------------------------------------------------------------------------------------
// Post-lobby initialization for commander-specific runtime logic
//--------------------------------------------------------------------------------------------------
void libKPVP_gf_codex_post_lobby_init () {
    int lv_player;
    string lv_commander;
    playergroup autoCodexCommanders_g;

    autoCodexCommanders_g = libKCOR_gf_CommanderPlayers();
    lv_player = -1;
    while (true) {
        lv_player = PlayerGroupNextPlayer(autoCodexCommanders_g, lv_player);
        if (lv_player < 0) { break; }
        lv_commander = libKCOR_gf_ActiveCommanderForPlayer(lv_player);
        if (lv_commander == "TerranSwann") {
            libKPVP_gf_codex_apply_swann_worker_tech(lv_player);
        }
    }
}

//--------------------------------------------------------------------------------------------------
// Get primary commander name from runtime bank (for LibE0EAE146)
//--------------------------------------------------------------------------------------------------
string libKPVP_gf_CodexPrimaryCommanderName () {
    string lv_bankKey;
    string lv_slotKey;

    lv_bankKey = "";
    lv_slotKey = ("CommanderP" + IntToString(1));
    BankLoad("CampaignXCore", 1);
    if (BankKeyExists(BankLastCreated(), "XMRuntimeControl", lv_slotKey)) {
        lv_bankKey = BankValueGetAsString(BankLastCreated(), "XMRuntimeControl", lv_slotKey);
    }
    if ((lv_bankKey == "") && BankKeyExists(BankLastCreated(), "XMRuntimeControl", "PrimaryCommander")) {
        lv_bankKey = BankValueGetAsString(BankLastCreated(), "XMRuntimeControl", "PrimaryCommander");
    }

    return lv_bankKey;
}
