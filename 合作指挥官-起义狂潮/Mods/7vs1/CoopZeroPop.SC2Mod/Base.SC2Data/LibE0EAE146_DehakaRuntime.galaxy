void libE0EAE146_gf_DehakaRuntimeInit (int lp_player, point lp_heroPoint, bool lp_createHero) {
    unit lv_hero;
    string lv_panelCasterUnit;

    libDF8E6945_InitLib();

    if (libE0EAE146_gv_dehakaRuntimeInitialized == true) {
        return;
    }

    libE0EAE146_gv_dehakaRuntimeInitialized = true;
    lv_panelCasterUnit = "";
    if (CatalogEntryIsValid(c_gameCatalogUnit, "CoopCasterDehaka") == true) {
        lv_panelCasterUnit = "CoopCasterDehaka";
    }
    else if (CatalogEntryIsValid(c_gameCatalogUnit, "CasterDehaka") == true) {
        lv_panelCasterUnit = "CasterDehaka";
    }
    if (lv_panelCasterUnit != "") {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, lv_panelCasterUnit, c_unitCreateIgnorePlacement, lp_player, RegionGetBoundsMin(RegionEntireMap()));
        lib67C0F0E7_gf_CU_GPInit(lp_player, "Dehaka", UnitLastCreated(), null);
        lib67C0F0E7_gf_CU_GPShowHide(true, lp_player, c_transitionDurationDefault);
        lib67C0F0E7_gf_ShowChooseButton();
    }
    if (lp_createHero == true) {
        lv_hero = libE0EAE146_gf_FindFirstPlayerUnitOfType(lp_player, "DehakaCoop");
        if (lv_hero != null) {
            libDF8E6945_gf_InitializeDehakaEvent(lp_player, lv_hero);
        }
        if (((lv_hero != null) && lib67C0F0E7_gf_BitMaskTrueIndexIs(libE0EAE146_gf_CommanderPowerPrestigeMask("Dehaka"), 2) == true)) {
            libDF8E6945_gf_DehakaBroodbrother();
        }
    }
}
