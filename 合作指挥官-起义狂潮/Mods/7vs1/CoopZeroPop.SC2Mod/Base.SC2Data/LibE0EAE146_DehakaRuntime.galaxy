        lv_xPTotal += CatalogFieldValueGetAsInt(c_gameCatalogBehavior, libKMIS_gv_cM_DehakaVeterencyBehavior[lp_player], "VeterancyLevelArray[" + IntToString(lv_i) + "].MinVeterancyXP", lp_player);
