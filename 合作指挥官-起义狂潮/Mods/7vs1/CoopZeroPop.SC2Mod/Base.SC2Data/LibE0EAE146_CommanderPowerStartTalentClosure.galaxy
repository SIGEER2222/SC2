// XMFinal split module: commander start talents implementation.
// 开局天赋效果实现，每个天赋通过位掩码选择。

// ============================================================
// 读取函数
// ============================================================

bool libE0EAE146_gf_StartTalentEnabled (string lp_commander) {
    return (libE0EAE146_gf_CommanderPowerBankIntOrDefault(lp_commander, "EnableStartTalents", 1) > 0);
}

int libE0EAE146_gf_StartTalentMask (string lp_commander) {
    if (!libE0EAE146_gf_StartTalentEnabled(lp_commander)) {
        return 0;
    }
    return libE0EAE146_gf_CommanderPowerBankIntOrDefault(lp_commander, "StartTalentMask", 0);
}

bool libE0EAE146_gf_StartTalentBitEnabled (string lp_commander, int lp_bitIndex) {
    int lv_mask;

    if (!libE0EAE146_gf_StartTalentEnabled(lp_commander)) {
        return false;
    }
    lv_mask = libE0EAE146_gf_StartTalentMask(lp_commander);
    return lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_mask, lp_bitIndex);
}

// ============================================================
// 雷诺天赋
// ============================================================

void libE0EAE146_gf_StartTalentApplyRaynor (int lp_player) {
    int lv_mask;

    if (!libE0EAE146_gf_StartTalentEnabled("Raynor")) {
        return;
    }
    lv_mask = libE0EAE146_gf_StartTalentMask("Raynor");

    // Bit 0: 大和炮就绪
    if (lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_mask, 0)) {
        // 重置Hyperion技能冷却
        UnitAbilityReset(lp_player, "Hyperion", c_freeAbilityResetAllCooldowns);
    }

    // Bit 1: 超级兴奋剂
    if (lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_mask, 1)) {
        // 直接解锁超级兴奋剂升级
        libE0EAE146_gf_CommanderPowerSetUpgradeAtLeast(lp_player, "CommanderPrestigeRaynorBioSuperStim", 1);
        libE0EAE146_gf_CommanderPowerSetUpgradeAtLeast(lp_player, "Stimpack", 1);
    }

    // Bit 2: 开局骡子
    if (lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_mask, 2)) {
        // 开局召唤一个骡子
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "MULE", 0, lp_player, UnitGetPosition(UnitGroupUnitFromEnd(UnitGroup("CommandCenter", lp_player, RegionPlayableMap(), UnitFilter(0, 0, 0, 0), 0), 1)));
    }
}

// ============================================================
// 蒙斯克天赋
// ============================================================

void libE0EAE146_gf_StartTalentApplyMengsk (int lp_player) {
    int lv_mask;

    if (!libE0EAE146_gf_StartTalentEnabled("Mengsk")) {
        return;
    }
    lv_mask = libE0EAE146_gf_StartTalentMask("Mengsk");

    // Bit 0: 皇家火蝠
    if (lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_mask, 0)) {
        libE0EAE146_gf_CommanderPowerSetUpgradeAtLeast(lp_player, "MengskUnlockPyro", 1);
    }

    // Bit 1: 紧急补给站
    if (lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_mask, 1)) {
        libE0EAE146_gf_CommanderPowerSetUpgradeAtLeast(lp_player, "MengskEmergencySupplyDepot", 1);
    }
}

// ============================================================
// 泰凯斯天赋
// ============================================================

void libE0EAE146_gf_StartTalentApplyTychus (int lp_player) {
    int lv_mask;
    unit lv_spawnPoint;

    if (!libE0EAE146_gf_StartTalentEnabled("Tychus")) {
        return;
    }
    lv_mask = libE0EAE146_gf_StartTalentMask("Tychus");

    // Bit 0: 奥丁就绪
    if (lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_mask, 0)) {
        UnitAbilityReset(lp_player, "TychusOdinTargeted", c_freeAbilityResetAllCooldowns);
    }

    // Bit 1: 快速召募 - 需要特殊处理，在TychusRuntime中实现召募时间减半
    if (lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_mask, 1)) {
        libE0EAE146_gv_tychusQuickRebootEnabled = true;
    }

    // Bit 2: 医疗就绪 - 开局直接有医疗运输机
    if (lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_mask, 2)) {
        lv_spawnPoint = UnitGroupUnitFromEnd(UnitGroup("TychusBarracks", lp_player, RegionPlayableMap(), UnitFilter(0, 0, 0, 0), 0), 1);
        if ((lv_spawnPoint != null)) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "TychusMedicTransport", 0, lp_player, UnitGetPosition(lv_spawnPoint));
        }
    }
}

// ============================================================
// 霍纳天赋
// ============================================================

void libE0EAE146_gf_StartTalentApplyHorner (int lp_player) {
    int lv_mask;
    unit lv_spawnPoint;

    if (!libE0EAE146_gf_StartTalentEnabled("Horner")) {
        return;
    }
    lv_mask = libE0EAE146_gf_StartTalentMask("Horner");

    // Bit 0: 雇佣兵合同
    if (lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_mask, 0)) {
        libE0EAE146_gf_CommanderPowerSetUpgradeAtLeast(lp_player, "HornerMercenaryContract", 1);
    }

    // Bit 1: 打击舰队就绪
    if (lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_mask, 1)) {
        UnitAbilityReset(lp_player, "HornerStrikeFighter", c_freeAbilityResetAllCooldowns);
    }

    // Bit 2: 航母旗舰
    if (lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_mask, 2)) {
        lv_spawnPoint = UnitGroupUnitFromEnd(UnitGroup("HornerBarracks", lp_player, RegionPlayableMap(), UnitFilter(0, 0, 0, 0), 0), 1);
        if ((lv_spawnPoint != null)) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "Battlecruiser", 0, lp_player, UnitGetPosition(lv_spawnPoint));
        }
    }
}

// ============================================================
// 斯旺天赋
// ============================================================

void libE0EAE146_gf_StartTalentApplySwann (int lp_player) {
    int lv_mask;
    unit lv_wraith;

    if (!libE0EAE146_gf_StartTalentEnabled("Swann")) {
        return;
    }
    lv_mask = libE0EAE146_gf_StartTalentMask("Swann");

    // Bit 0: 极光钻机就绪 - 开局直接部署激光钻机
    if (lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_mask, 0)) {
        libE0EAE146_gv_swannDrillReadyEnabled = true;
    }

    // Bit 1: 科学船先行
    if (lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_mask, 1)) {
        lv_wraith = UnitGroupUnitFromEnd(UnitGroup("SwannStarport", lp_player, RegionPlayableMap(), UnitFilter(0, 0, 0, 0), 0), 1);
        if ((lv_wraith != null)) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "ScienceVessel", 0, lp_player, UnitGetPosition(lv_wraith));
        }
    }
}

// ============================================================
// 凯瑞甘天赋
// ============================================================

void libE0EAE146_gf_StartTalentApplyKerrigan (int lp_player) {
    int lv_mask;

    if (!libE0EAE146_gf_StartTalentEnabled("Kerrigan")) {
        return;
    }
    lv_mask = libE0EAE146_gf_StartTalentMask("Kerrigan");

    // Bit 0: 开局菌毯
    if (lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_mask, 0)) {
        libE0EAE146_gv_kerriganStartCreepEnabled = true;
    }

    // Bit 1: 坑道网络 - 开局直接解锁坑道虫能力
    if (lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_mask, 1)) {
        libE0EAE146_gv_kerriganWarpInReadyEnabled = true;
    }
}

// ============================================================
// 阿巴瑟天赋
// ============================================================

void libE0EAE146_gf_StartTalentApplyAbathur (int lp_player) {
    int lv_mask;

    if (!libE0EAE146_gf_StartTalentEnabled("Abathur")) {
        return;
    }
    lv_mask = libE0EAE146_gf_StartTalentMask("Abathur");

    // Bit 0: 初始生物质 - 所有出生的战斗单位开局自带50层生物质
    if (lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_mask, 0)) {
        libE0EAE146_gv_abathurStartBiomassEnabled = true;
        libE0EAE146_gv_abathurStartBiomassAmount = 50;
    }

    // Bit 1: 终极生物增益 - 莽兽和利维坦开局额外获得25层生物质
    if (lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_mask, 1)) {
        libE0EAE146_gv_abathurUltimateBiomassEnabled = true;
        libE0EAE146_gv_abathurUltimateBiomassAmount = 25;
    }
}

// ============================================================
// 统一应用入口
// ============================================================

void libE0EAE146_gf_StartTalentApplyCommander (int lp_player, string lp_commander) {
    if ((lp_commander == "TerranRaynor")) {
        libE0EAE146_gf_StartTalentApplyRaynor(lp_player);
    }
    else if ((lp_commander == "TerranMengsk")) {
        libE0EAE146_gf_StartTalentApplyMengsk(lp_player);
    }
    else if ((lp_commander == "TerranTychus")) {
        libE0EAE146_gf_StartTalentApplyTychus(lp_player);
    }
    else if ((lp_commander == "TerranHorner")) {
        libE0EAE146_gf_StartTalentApplyHorner(lp_player);
    }
    else if ((lp_commander == "TerranSwann")) {
        libE0EAE146_gf_StartTalentApplySwann(lp_player);
    }
    else if ((lp_commander == "ZergKerrigan")) {
        libE0EAE146_gf_StartTalentApplyKerrigan(lp_player);
    }
    else if ((lp_commander == "ZergAbathur")) {
        libE0EAE146_gf_StartTalentApplyAbathur(lp_player);
    }
}
