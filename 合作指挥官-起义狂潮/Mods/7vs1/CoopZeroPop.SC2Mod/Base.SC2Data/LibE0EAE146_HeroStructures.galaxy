// XMFinal split module: commander hero-structure startup anchors.

string libE0EAE146_gf_CommanderHeroStructureUnitType (string lp_commander) {
    if (lp_commander == "Fenix") {
        return "FenixAltarOfPsiStorms";
    }
    else if (lp_commander == "Karax") {
        return "SolarForgeKarax";
    }
    else if (lp_commander == "Swann") {
        return "UnfinishedDrakkenLaserDrillCoop";
    }
    else if (lp_commander == "Zeratul") {
        return "ZeratulACArtifact";
    }

    return "";
}

unit libE0EAE146_gf_FindCommanderHeroStructure (int lp_player, string lp_unitType) {
    unitgroup lv_units;

    if ((lp_unitType == "") || (!CatalogEntryIsValid(c_gameCatalogUnit, lp_unitType))) {
        return null;
    }

    lv_units = UnitGroup(lp_unitType, lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    if (UnitGroupCount(lv_units, c_unitCountAlive) > 0) {
        return UnitGroupUnit(lv_units, 1);
    }

    return null;
}

point libE0EAE146_gf_CommanderHeroStructurePoint (int lp_player, string lp_unitType) {
    point lv_candidate;
    point lv_placement;

    lv_candidate = PointWithOffsetPolar(PlayerStartLocation(lp_player), 7.0, 315.0);
    lv_placement = UnitTypePlacementFromPoint(lp_unitType, lp_player, lv_candidate, 12.0);
    if (lv_placement != null) {
        return lv_placement;
    }

    return lv_candidate;
}

unit libE0EAE146_gf_CreateCommanderHeroStructure (int lp_player, string lp_commander) {
    string lv_unitType;
    unit lv_structure;
    point lv_point;

    lv_unitType = libE0EAE146_gf_CommanderHeroStructureUnitType(lp_commander);
    if ((lv_unitType == "") || (!CatalogEntryIsValid(c_gameCatalogUnit, lv_unitType))) {
        return null;
    }

    lv_structure = libE0EAE146_gf_FindCommanderHeroStructure(lp_player, lv_unitType);
    if (UnitIsValid(lv_structure) == true) {
        return lv_structure;
    }

    lv_point = libE0EAE146_gf_CommanderHeroStructurePoint(lp_player, lv_unitType);
    UnitCreate(1, lv_unitType, 0, lp_player, lv_point, 225.0);
    lv_structure = UnitLastCreated();
    if (((UnitIsValid(lv_structure) == true) && (UnitGetOwner(lv_structure) == lp_player)) && (UnitGetType(lv_structure) == lv_unitType)) {
        return lv_structure;
    }

    UnitCreate(1, lv_unitType, c_unitCreateIgnorePlacement, lp_player, lv_point, 225.0);
    lv_structure = UnitLastCreated();
    if (((UnitIsValid(lv_structure) == true) && (UnitGetOwner(lv_structure) == lp_player)) && (UnitGetType(lv_structure) == lv_unitType)) {
        return lv_structure;
    }

    return null;
}
