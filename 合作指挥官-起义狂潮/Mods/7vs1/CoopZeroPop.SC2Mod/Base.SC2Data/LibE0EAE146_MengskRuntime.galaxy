    if (lib67C0F0E7_gf_BitMaskTrueIndexIs(lp_prestigeMask, 2) == true) {
        libE0EAE146_gf_MengskAllowAbilityIfPresent(lp_player, "FusionCoreMengskResearch", 0);
        libE0EAE146_gf_MengskAllowAbilityIfPresent(lp_player, "FusionCoreMengskResearch", 1);
        libE0EAE146_gf_MengskAllowAbilityIfPresent(lp_player, "ArmoryMengskResearch", 0);
        libE0EAE146_gf_MengskAllowAbilityIfPresent(lp_player, "ArmoryMengskResearch", 1);
        libE0EAE146_gf_MengskAllowAbilityIfPresent(lp_player, "ArmoryMengskResearch", 2);
