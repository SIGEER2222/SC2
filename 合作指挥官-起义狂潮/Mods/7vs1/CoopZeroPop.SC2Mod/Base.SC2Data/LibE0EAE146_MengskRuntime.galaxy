    TechTreeUnitAllow(lp_player, lp_unit, true);
}

void libE0EAE146_gf_MengskAllowAbilityIfPresent (int lp_player, string lp_abil, int lp_cmdIndex) {
    if ((lp_abil == "") || (!CatalogEntryIsValid(c_gameCatalogAbil, lp_abil))) {
        return;
    }
    TechTreeAbilityAllow(lp_player, AbilityCommand(lp_abil, lp_cmdIndex), true);
}

void libE0EAE146_gf_MengskApplyPrestigePenaltyBypass (int lp_player, int lp_prestigeMask) {
    if (lib67C0F0E7_gf_BitMaskTrueIndexIs(lp_prestigeMask, 0) == true) {
        libE0EAE146_gf_MengskAllowAbilityIfPresent(lp_player, "NuclearAnnihilationMengsk", 0);
