include "TriggerLibs/NativeLib"

include "LibA10ADAPTER_h"

//--------------------------------------------------------------------------------------------------
// Library: Alenger10Adapter
// 10埃蒙 adapter，对接 7v1 框架。无源 galaxy 运行时，MapInit 触发器仅返回 true。
//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
// Trigger: MapInit
//--------------------------------------------------------------------------------------------------
bool libA10ADAPTER_gt_MapInit_Func (bool testConds, bool runActions) {
    int lp_player = 1;
    int lv_player;
    playergroup auto10ADAPTER_g;

    if (testConds) { return true; }
    if (!runActions) { return true; }

    // 10埃蒙无源 galaxy 运行时升级逻辑
    // 为所有人类玩家解锁所有自定义单位（TechTreeUnitAllow）
    auto10ADAPTER_g = PlayerGroupAll();
    lv_player = -1;
    while (true) {
        lv_player = PlayerGroupNextPlayer(auto10ADAPTER_g, lv_player);
        if (lv_player < 0) { break; }
        if ((PlayerType(lv_player) == c_playerTypeUser)) {
            TechTreeUnitAllow(lv_player, "10hunhetiliulangzhe", true);
            TechTreeUnitAllow(lv_player, "10hunhetihuimiezhe", true);
            TechTreeUnitAllow(lv_player, "10hunhetichengfazhe", true);
            TechTreeUnitAllow(lv_player, "10hunhetizhongjiezhe", true);
            TechTreeUnitAllow(lv_player, "10hunhetidiaolingzhe", true);
            TechTreeUnitAllow(lv_player, "10hunhetifuchouzhe", true);
            TechTreeUnitAllow(lv_player, "10xukongliexi", true);
            TechTreeUnitAllow(lv_player, "10hunhetisiliezhe", true);
        }
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void libA10ADAPTER_InitTriggers () {
    libA10ADAPTER_gt_MapInit = TriggerCreate("libA10ADAPTER_gt_MapInit_Func");
    TriggerAddEventMapInit(libA10ADAPTER_gt_MapInit);
}

//--------------------------------------------------------------------------------------------------
// Library Initialization
//--------------------------------------------------------------------------------------------------
bool libA10ADAPTER_InitLib_completed = false;

void libA10ADAPTER_InitLib () {
    if (libA10ADAPTER_InitLib_completed) {
        return;
    }
    libA10ADAPTER_InitLib_completed = true;
    libA10ADAPTER_InitTriggers();
}