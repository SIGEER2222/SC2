include "TriggerLibs/NativeLib"

include "LibA12ADAPTER_h"

//--------------------------------------------------------------------------------------------------
// Library: Alenger12Adapter
// 12游骑兵 adapter，对接 7v1 框架。无源 galaxy 运行时，MapInit 触发器仅返回 true。
//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
// Trigger: MapInit
//--------------------------------------------------------------------------------------------------
bool libA12ADAPTER_gt_MapInit_Func (bool testConds, bool runActions) {
    int lp_player = 1;
    int lv_player;
    int lv_i;
    playergroup auto12ADAPTER_g;

    if (testConds) { return true; }
    if (!runActions) { return true; }

    // 12游骑兵无源 galaxy 运行时升级逻辑

    // 为所有人类玩家解锁能力
    auto12ADAPTER_g = PlayerGroupAll();
    lv_player = -1;
    while (true) {
        lv_player = PlayerGroupNextPlayer(auto12ADAPTER_g, lv_player);
        if (lv_player < 0) { break; }
        if ((PlayerType(lv_player) == c_playerTypeUser)) {
            for (lv_i = 0; lv_i <= 31; lv_i += 1) {
                TechTreeAbilityAllow(lv_player, AbilityCommand("12jianzao", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("12hujiao4", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("12hujiao5", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("12shengchan3", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("12xunlian1", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("12xunlian2", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("12shengkong1", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("12shengkong3", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("12shengkong4", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("12shengkong22", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("12gongchengmoshi", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("12quxiaogongchengmoshi", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("12chongjimoshi", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("12baoliemoshi", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("12jijiamoshi", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("12zhanjimoshi", lv_i), true);
            }
            // 解锁所有自定义单位（TechTreeUnitAllow）
            TechTreeUnitAllow(lv_player, "12guidaokongzhijidi", true);
            TechTreeUnitAllow(lv_player, "12guidaokongzhijidiFlying", true);
            TechTreeUnitAllow(lv_player, "12youqibingxunlianjidi", true);
            TechTreeUnitAllow(lv_player, "12youqibingxunlianjidiFlying", true);
            TechTreeUnitAllow(lv_player, "12xiuboliankongjunpingtai", true);
            TechTreeUnitAllow(lv_player, "12xiuboliankongjunpingtaiFlying", true);
            TechTreeUnitAllow(lv_player, "12qiyijunzhanchegongchang", true);
            TechTreeUnitAllow(lv_player, "12qiyijunzhanchegongchangFlying", true);
            TechTreeUnitAllow(lv_player, "12jinglianchang", true);
            TechTreeUnitAllow(lv_player, "12gaoshejipao", true);
            TechTreeUnitAllow(lv_player, "12dibao", true);
            TechTreeUnitAllow(lv_player, "12kuangluo", true);
            TechTreeUnitAllow(lv_player, "12leidaganyingta", true);
            TechTreeUnitAllow(lv_player, "12qiyijunbaolei", true);
            TechTreeUnitAllow(lv_player, "12qiyijunbaolei2", true);
            TechTreeUnitAllow(lv_player, "12qiyijunjunxieku", true);
            TechTreeUnitAllow(lv_player, "12xiubolianjubianxinti", true);
            TechTreeUnitAllow(lv_player, "12youhunxunlianying", true);
            TechTreeUnitAllow(lv_player, "12xiubolianhao", true);
            TechTreeUnitAllow(lv_player, "12tongxinzhan", true);
            TechTreeUnitAllow(lv_player, "12dingdianfangyubaji", true);
            TechTreeUnitAllow(lv_player, "12zhandihaozhu", true);
            TechTreeUnitAllow(lv_player, "12shikebidetianshi", true);
            TechTreeUnitAllow(lv_player, "12sishuigongchengche", true);
            TechTreeUnitAllow(lv_player, "12youqibinghushi", true);
            TechTreeUnitAllow(lv_player, "12youqibingluzhanduiyuan", true);
            TechTreeUnitAllow(lv_player, "12youqibingbaoposhou", true);
            TechTreeUnitAllow(lv_player, "12youqibingfenshaozhe", true);
            TechTreeUnitAllow(lv_player, "12youqibingyouhun", true);
            TechTreeUnitAllow(lv_player, "12tiechuianbao", true);
            TechTreeUnitAllow(lv_player, "12emoquan", true);
            TechTreeUnitAllow(lv_player, "12qiyijunbubingzhanche", true);
            TechTreeUnitAllow(lv_player, "12qiyijunzixinghuopao2", true);
            TechTreeUnitAllow(lv_player, "12qiyijunzixinghuopao", true);
            TechTreeUnitAllow(lv_player, "12xiubolianhongzhaji", true);
            TechTreeUnitAllow(lv_player, "12xiubolianjianjijijia", true);
            TechTreeUnitAllow(lv_player, "12xiubolianjianjizhanji", true);
            TechTreeUnitAllow(lv_player, "12xiubolianyujingji", true);
            TechTreeUnitAllow(lv_player, "12xiubolianyunshuji", true);
            TechTreeUnitAllow(lv_player, "12qiyijunwuzhuangjiqiren", true);
            TechTreeUnitAllow(lv_player, "12xiubolianhuweijian", true);
        }
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void libA12ADAPTER_InitTriggers () {
    libA12ADAPTER_gt_MapInit = TriggerCreate("libA12ADAPTER_gt_MapInit_Func");
    TriggerAddEventMapInit(libA12ADAPTER_gt_MapInit);
}

//--------------------------------------------------------------------------------------------------
// Library Initialization
//--------------------------------------------------------------------------------------------------
bool libA12ADAPTER_InitLib_completed = false;

void libA12ADAPTER_InitLib () {
    if (libA12ADAPTER_InitLib_completed) {
        return;
    }
    libA12ADAPTER_InitLib_completed = true;
    libA12ADAPTER_InitTriggers();
}