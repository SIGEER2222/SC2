include "TriggerLibs/NativeLib"

include "LibA13ADAPTER_h"

//--------------------------------------------------------------------------------------------------
// Library: Alenger13Adapter
// 13净化者 adapter，对接 7v1 框架。无源 galaxy 运行时，MapInit 触发器仅返回 true。
//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
// Trigger: MapInit
//--------------------------------------------------------------------------------------------------
bool libA13ADAPTER_gt_MapInit_Func (bool testConds, bool runActions) {
    int lp_player = 1;
    int lv_player;
    int lv_i;
    playergroup auto13ADAPTER_g;

    if (testConds) { return true; }
    if (!runActions) { return true; }

    // 13净化者无源 galaxy 运行时升级逻辑

    // 为所有人类玩家解锁能力
    auto13ADAPTER_g = PlayerGroupAll();
    lv_player = -1;
    while (true) {
        lv_player = PlayerGroupNextPlayer(auto13ADAPTER_g, lv_player);
        if (lv_player < 0) { break; }
        if ((PlayerType(lv_player) == c_playerTypeUser)) {
            for (lv_i = 0; lv_i <= 31; lv_i += 1) {
                TechTreeAbilityAllow(lv_player, AbilityCommand("13zheyuejianzao", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("13zheyuejianzao5", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("13bianxingjianzao", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("13bushufuwuqi", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("13zheyue1", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("13zheyue2", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("13zheyue5", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("13zheyuebianxing", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("13zheyuebianxing5", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("13bianxingweijinghuazhehexin", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("13bianxingweijinghuazhehexinPlacement", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("13yanfa2", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("13yanfa3", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("13yanfa4", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("13bianxingweijinghuazhehexin2", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("13bianxingweiyingxionghexin", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("13yunshumoshi", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("13xiangweimoshi", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("13jidongmoshi", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("13kuozhanmoshi", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("13shouweizhechonggou", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("13shouweizhesiwang", lv_i), true);
            }

            // 解锁所有自定义单位（TechTreeUnitAllow）
            TechTreeUnitAllow(lv_player, "13jinghuazhehexin", true);
            TechTreeUnitAllow(lv_player, "13jinghuazheshuniu", true);
            TechTreeUnitAllow(lv_player, "13jinghuaxinbiao", true);
            TechTreeUnitAllow(lv_player, "13guangzipaotai", true);
            TechTreeUnitAllow(lv_player, "13hudunchongnengqi", true);
            TechTreeUnitAllow(lv_player, "13zhinengxinacang", true);
            TechTreeUnitAllow(lv_player, "13jianduihangbiao", true);
            TechTreeUnitAllow(lv_player, "13chuansongmen", true);
            TechTreeUnitAllow(lv_player, "13kongzhixinhe", true);
            TechTreeUnitAllow(lv_player, "13yazhita", true);
            TechTreeUnitAllow(lv_player, "13xingmen", true);
            TechTreeUnitAllow(lv_player, "13jixietai", true);
            TechTreeUnitAllow(lv_player, "13jixieyanjiusuo", true);
            TechTreeUnitAllow(lv_player, "13tianwangjuzhen", true);
            TechTreeUnitAllow(lv_player, "13fuwuqi", true);
            TechTreeUnitAllow(lv_player, "13duanlu", true);
            TechTreeUnitAllow(lv_player, "13yingxionghexin", true);
            TechTreeUnitAllow(lv_player, "13buxiuzhe", true);
            TechTreeUnitAllow(lv_player, "13buxiuzhezhanjia", true);
            TechTreeUnitAllow(lv_player, "13zhongjiezhe", true);
            TechTreeUnitAllow(lv_player, "13zhongjiezhezhanjia", true);
            TechTreeUnitAllow(lv_player, "13chuanxinzhe", true);
            TechTreeUnitAllow(lv_player, "13chuanxinzhezhanjia", true);
            TechTreeUnitAllow(lv_player, "13puluobisizhanjia", true);
            TechTreeUnitAllow(lv_player, "13saodangzhe", true);
            TechTreeUnitAllow(lv_player, "13saodangzhezhanjia", true);
            TechTreeUnitAllow(lv_player, "13tansuozhe", true);
            TechTreeUnitAllow(lv_player, "13tansuozhezhanjia", true);
            TechTreeUnitAllow(lv_player, "13chengjiezhe", true);
            TechTreeUnitAllow(lv_player, "13chengjiezhezhanjia", true);
            TechTreeUnitAllow(lv_player, "13zhizhengzhezhanjia", true);
            TechTreeUnitAllow(lv_player, "13zhongjilengjing", true);
            TechTreeUnitAllow(lv_player, "13shouweizhe", true);
            TechTreeUnitAllow(lv_player, "13fensuizhe", true);
            TechTreeUnitAllow(lv_player, "13baohuzhe", true);
            TechTreeUnitAllow(lv_player, "13baohuzhe2", true);
            TechTreeUnitAllow(lv_player, "13ganraozhe", true);
            TechTreeUnitAllow(lv_player, "13chaoyuezhe", true);
            TechTreeUnitAllow(lv_player, "13suqingzhe", true);
            TechTreeUnitAllow(lv_player, "13zhuguangzhe", true);
            TechTreeUnitAllow(lv_player, "13lanjieji", true);
            TechTreeUnitAllow(lv_player, "13guwuzhe", true);
            TechTreeUnitAllow(lv_player, "13yinglingdian", true);
            TechTreeUnitAllow(lv_player, "13qiangjiji", true);
            TechTreeUnitAllow(lv_player, "13guangshuji", true);
            TechTreeUnitAllow(lv_player, "13jinghuaguangshu", true);
            TechTreeUnitAllow(lv_player, "13huweijian", true);
            TechTreeUnitAllow(lv_player, "13shouweizhecanhai", true);
        }
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void libA13ADAPTER_InitTriggers () {
    libA13ADAPTER_gt_MapInit = TriggerCreate("libA13ADAPTER_gt_MapInit_Func");
    TriggerAddEventMapInit(libA13ADAPTER_gt_MapInit);
}

//--------------------------------------------------------------------------------------------------
// Library Initialization
//--------------------------------------------------------------------------------------------------
bool libA13ADAPTER_InitLib_completed = false;

void libA13ADAPTER_InitLib () {
    if (libA13ADAPTER_InitLib_completed) {
        return;
    }
    libA13ADAPTER_InitLib_completed = true;
    libA13ADAPTER_InitTriggers();
}