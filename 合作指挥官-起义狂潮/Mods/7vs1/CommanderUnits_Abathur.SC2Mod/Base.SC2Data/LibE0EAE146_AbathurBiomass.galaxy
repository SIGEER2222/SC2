bool libE0EAE146_gf_CreateAbathurBiomassPickup (point lp_point, int lp_stack) {
    if ((lp_point == null)) {
        return false;
    }
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "BiomassPickup", c_unitCreateIgnorePlacement, libE0EAE146_gv_abathurBiomassPlayer, lp_point);
    if ((UnitLastCreated() == null)) {
        return false;
    }
    UnitSetCustomValue(UnitLastCreated(), libE0EAE146_gv_biomassMergeCustomValueIndex, IntToFixed(MaxI(1, lp_stack)));
    libNtve_gf_SendActorMessageToUnit(UnitLastCreated(), ("SetScale " + FixedToString(libE0EAE146_gf_AbathurBiomassVisualScale(MaxI(1, lp_stack)), c_fixedPrecisionAny)));
    libE0EAE146_gf_AbathurBiomassShowCount(UnitLastCreated(), MaxI(1, lp_stack));
    libE0EAE146_gf_AbathurBiomassMerge(UnitLastCreated(), MaxI(1, lp_stack));
    return true;
}

bool libE0EAE146_gf_CreateAbathurBiomassTestPickup (point lp_point, int lp_stack) {
