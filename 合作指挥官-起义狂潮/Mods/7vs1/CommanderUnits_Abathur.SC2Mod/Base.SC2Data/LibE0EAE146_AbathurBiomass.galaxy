// Abathur Biomass System - Official StarCoop implementation
// All Abathur biomass logic moved here from CommanderStartSquads for clarity.
// Follows official behavior: Brutalisk and Leviathan CANNOT collect biomass.

// Global variables
string libE0EAE146_gv_abathurBiomassEffect;
int libE0EAE146_gv_abathurBiomassPlayer;
bool libE0EAE146_gv_abathurBiomassEnabled;
