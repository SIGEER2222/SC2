bool libE0EAE146_gt_AbathurBiomassTrain_Func (bool testConds, bool runActions) {
    unit lv_trainUnit;
    int lv_biomassBuff100Count;
    int lv_biomassBuff10Count;
    int lv_biomassBuff1Count;
    int lv_i;
    string lv_trainUnitType;
    bool lv_match;

    lv_trainUnit = EventUnitProgressUnit();
    if (testConds) {
        if (!((PlayerCommander(UnitGetOwner(EventUnit())) == "Abathur"))) {
            return false;
        }
        if (!((UnitHasBehavior2(EventUnit(), libE0EAE146_gv_biomassBuff1) == true) || (UnitHasBehavior2(EventUnit(), libE0EAE146_gv_biomassBuff10) == true) || (UnitHasBehavior2(EventUnit(), libE0EAE146_gv_biomassBuff100) == true))) {
            return false;
        }
        // Data-driven train unit type check.
        lv_trainUnitType = libNtve_gf_TriggeringProgressUnitType();
        lv_match = false;
        lv_i = 1;
        for ( ; ( lv_i <= libE0EAE146_gv_biomassTrainUnitCount ) ; lv_i += 1 ) {
            if ((lv_trainUnitType == libE0EAE146_gf_BiomassTrainUnit(lv_i))) {
                lv_match = true;
            }
        }
        if (!((lv_match == true))) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    if ((libE0EAE146_gf_AbathurCanCollectBiomass(lv_trainUnit) == false)) {
        return true;
    }
    lv_biomassBuff100Count = UnitBehaviorCount(EventUnit(), libE0EAE146_gv_biomassBuff100);
    lv_biomassBuff10Count = UnitBehaviorCount(EventUnit(), libE0EAE146_gv_biomassBuff10);
    lv_biomassBuff1Count = UnitBehaviorCount(EventUnit(), libE0EAE146_gv_biomassBuff1);
    libE0EAE146_gf_AbathurAddBiomassStacks(lv_trainUnit, ((lv_biomassBuff100Count * 100) + (lv_biomassBuff10Count * 10) + lv_biomassBuff1Count));
    return true;
}

void libE0EAE146_gt_AbathurBiomassTrain_Init () {
    libE0EAE146_gt_AbathurBiomassTrain = TriggerCreate("libE0EAE146_gt_AbathurBiomassTrain_Func");
    TriggerAddEventUnitTrainProgress(libE0EAE146_gt_AbathurBiomassTrain, null, c_unitProgressStageComplete);
    TriggerEnable(libE0EAE146_gt_AbathurBiomassTrain, false);
