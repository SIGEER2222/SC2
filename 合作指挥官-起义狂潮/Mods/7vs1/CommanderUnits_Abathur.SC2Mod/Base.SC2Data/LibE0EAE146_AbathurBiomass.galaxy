bool libE0EAE146_gt_AbathurBiomassDrop_Func (bool testConds, bool runActions) {
    int lv_stack;
    if (testConds) {
        if ((libE0EAE146_gf_AbathurCanDropBiomass(EventUnit()) == false)) { return false; }
    }
    if (!runActions) {
        return true;
    }
    lv_stack = CeilingI(libE0EAE146_gf_AbathurBiomassAmount(EventUnit()));
    if ((lv_stack <= 0)) { return true; }
    libE0EAE146_gf_CreateAbathurBiomassPickup(UnitGetPosition(EventUnit()), lv_stack);
    return true;
}

void libE0EAE146_gt_AbathurBiomassDrop_Init () {
    libE0EAE146_gt_AbathurBiomassDrop = TriggerCreate("libE0EAE146_gt_AbathurBiomassDrop_Func");
    TriggerAddEventUnitDied(libE0EAE146_gt_AbathurBiomassDrop, null);
    TriggerEnable(libE0EAE146_gt_AbathurBiomassDrop, false);
}

bool libE0EAE146_gt_AbathurBiomassPickup_Func (bool testConds, bool runActions) {
    unit lv_pickup;
    unit lv_target;
    int lv_stored;
    int lv_applied;
    lv_pickup = EventPlayerEffectUsedUnit(c_effectUnitCaster);
    lv_target = EventPlayerEffectUsedUnit(c_effectUnitTarget);
    if (testConds) {
        if ((lv_pickup == null) || (lv_target == null)) { return false; }
        if ((UnitGetType(lv_pickup) != "BiomassPickup")) { return false; }
        if ((UnitGetOwner(lv_target) != libE0EAE146_gv_abathurBiomassPlayer)) { return false; }
        if ((libE0EAE146_gf_AbathurCanCollectBiomass(lv_target) == false)) { return false; }
    }
    if (!runActions) {
        return true;
    }
    lv_stored = FixedToInt(UnitGetCustomValue(lv_pickup, libE0EAE146_gv_biomassMergeCustomValueIndex));
    lv_applied = libE0EAE146_gf_AbathurAddBiomassStacks(lv_target, lv_stored);
    if ((lv_applied <= 0)) { return true; }
    if ((lv_applied >= lv_stored)) {
        UnitBehaviorAdd(lv_pickup, libE0EAE146_gv_biomassTravelling, lv_pickup, 1);
        UnitCreateEffectUnit(lv_pickup, libE0EAE146_gv_biomassPickupFullLM, lv_target);
    }
    else {
        UnitSetCustomValue(lv_pickup, libE0EAE146_gv_biomassMergeCustomValueIndex, IntToFixed(lv_stored - lv_applied));
        libE0EAE146_gf_AbathurBiomassScale(lv_pickup, false);
        libE0EAE146_gf_AbathurBiomassShowCount(lv_pickup, (lv_stored - lv_applied));
        UnitCreateEffectUnit(lv_pickup, libE0EAE146_gv_biomassPickupLM, lv_target);
    }
    return true;
}

void libE0EAE146_gt_AbathurBiomassPickup_Init () {
    libE0EAE146_gt_AbathurBiomassPickup = TriggerCreate("libE0EAE146_gt_AbathurBiomassPickup_Func");
    TriggerAddEventPlayerEffectUsed(libE0EAE146_gt_AbathurBiomassPickup, c_playerAny, libE0EAE146_gv_biomassPickupDummy);
    TriggerEnable(libE0EAE146_gt_AbathurBiomassPickup, false);
}

bool libE0EAE146_gt_AbathurBiomassRefund_Func (bool testConds, bool runActions) {
    int lv_stack;
    fixed lv_refundChance;
    unit lv_dyingUnit;

    lv_dyingUnit = EventUnit();
    lv_refundChance = libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogEffect, libE0EAE146_gv_biomassRefundDummy, libE0EAE146_gv_biomassRefundDummyField, UnitGetOwner(lv_dyingUnit));
    if (testConds) {
        if (!((PlayerCommander(UnitGetOwner(lv_dyingUnit)) == "Abathur"))) {
            return false;
        }
        if (!((UnitGetType(lv_dyingUnit) != "Locust"))) {
            return false;
        }
        if (!((EventUnitDamageDeathCheck(c_deathTypeRemove) == false))) {
            return false;
        }
        if (!((UnitFilterMatch(lv_dyingUnit, UnitGetOwner(lv_dyingUnit), UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), 0)) == true))) {
            return false;
        }
        if (!((UnitHasBehavior2(lv_dyingUnit, libE0EAE146_gv_biomassBuff1) == true) || (UnitHasBehavior2(lv_dyingUnit, libE0EAE146_gv_biomassBuff10) == true) || (UnitHasBehavior2(lv_dyingUnit, libE0EAE146_gv_biomassBuff100) == true))) {
            return false;
        }
        if (!((lv_refundChance > 0.0))) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    if ((lv_refundChance < RandomFixed(0.0, 100.0))) {
        return true;
    }
    lv_stack = libE0EAE146_gf_AbathurUnitBiomassStacks(lv_dyingUnit);
    if ((lv_stack <= 0)) {
        return true;
    }
    libE0EAE146_gf_CreateAbathurBiomassPickup(UnitGetPosition(lv_dyingUnit), lv_stack);
    libE0EAE146_gf_AbathurBiomassSetStack(UnitLastCreated(), lv_stack);
    libE0EAE146_gf_AbathurBiomassScale(UnitLastCreated(), true);
    return true;
}

