bool libE0EAE146_gt_AbathurBiomassScaler_Func (bool testConds, bool runActions) {
    int lv_biomassMaxStacks;
    int lv_biomassCountTotal;
    int lv_biomassVisualIndicatorInterval;

    lv_biomassMaxStacks = libE0EAE146_gf_AbathurBiomassMaxStacks();
    if (testConds) {
        if (!(((UnitIsAlive(EventUnit()) == true) && (PlayerCommander(UnitGetOwner(EventUnit())) == "Abathur") && ((UnitHasBehavior2(EventUnit(), libE0EAE146_gv_biomassBuff1) == true) || (UnitHasBehavior2(EventUnit(), libE0EAE146_gv_biomassBuff10) == true) || (UnitHasBehavior2(EventUnit(), libE0EAE146_gv_biomassBuff100) == true))))) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    lv_biomassCountTotal = libE0EAE146_gf_AbathurUnitBiomassStacks(EventUnit());
    if ((lv_biomassCountTotal > lv_biomassMaxStacks)) {
        lv_biomassCountTotal = lv_biomassMaxStacks;
    }
    libNtve_gf_SendActorMessageToUnit(EventUnit(), (("SetScale " + FixedToString(libE0EAE146_gf_AbathurBiomassVisualScale(lv_biomassCountTotal), c_fixedPrecisionAny))));
    if ((lv_biomassCountTotal >= 10)) {
        ActorScopeSend(ActorScopeFromUnit(EventUnit()), ("Create " + libE0EAE146_gv_biomassGlazeCreate));
    }
    lv_biomassVisualIndicatorInterval = ((lv_biomassMaxStacks - 10) / 3);
    if ((lv_biomassCountTotal > (lv_biomassVisualIndicatorInterval * 2 + 10))) {
        ActorScopeSend(ActorScopeFromUnit(EventUnit()), ("Signal " + libE0EAE146_gv_biomassAnimGroupC));
    }
    else if ((lv_biomassCountTotal > (lv_biomassVisualIndicatorInterval + 10))) {
        ActorScopeSend(ActorScopeFromUnit(EventUnit()), ("Signal " + libE0EAE146_gv_biomassAnimGroupB));
    }
    else if ((lv_biomassCountTotal > 10)) {
        ActorScopeSend(ActorScopeFromUnit(EventUnit()), ("Signal " + libE0EAE146_gv_biomassAnimGroupA));
    }
    return true;
}

void libE0EAE146_gt_AbathurBiomassScaler_Init () {
    libE0EAE146_gt_AbathurBiomassScaler = TriggerCreate("libE0EAE146_gt_AbathurBiomassScaler_Func");
    TriggerAddEventUnitBehaviorChange(libE0EAE146_gt_AbathurBiomassScaler, null, libE0EAE146_gv_biomassBuff1, c_unitBehaviorChangeIncrease);
    TriggerAddEventUnitBehaviorChange(libE0EAE146_gt_AbathurBiomassScaler, null, libE0EAE146_gv_biomassBuff10, c_unitBehaviorChangeIncrease);
    TriggerAddEventUnitBehaviorChange(libE0EAE146_gt_AbathurBiomassScaler, null, libE0EAE146_gv_biomassBuff100, c_unitBehaviorChangeIncrease);
    TriggerEnable(libE0EAE146_gt_AbathurBiomassScaler, false);
}

