}

void libE0EAE146_gf_AbathurBiomassShowCount (unit lp_unit, int lp_count) {
    if ((lp_unit == null)) {
        return;
    }
    if ((lp_count <= 0)) {
        return;
    }

    TextTagCreate(IntToText(lp_count), 18, UnitGetPosition(lp_unit), 0.0, true, false, PlayerGroupSingle(UnitGetOwner(lp_unit)));
    TextTagAttachToUnit(TextTagLastCreated(), lp_unit, 2.5);
    TextTagSetVelocity(TextTagLastCreated(), 0.0, 90.0);
    TextTagSetTime(TextTagLastCreated(), c_textTagTimeDuration, 2.5);
    TextTagSetTime(TextTagLastCreated(), c_textTagTimeFadeOut, 0.75);
    TextTagSetColor(TextTagLastCreated(), c_textTagColorText, Color(100.00, 255.00, 120.00));
}

bool libE0EAE146_gf_AbathurCanDropBiomass (unit lp_unit) {
    if ((libE0EAE146_gv_abathurBiomassEnabled == false)) {
        return false;
    }
    if ((lp_unit == null)) {
        return false;
    }
    if ((EventUnitDamageDeathCheck(c_deathTypeRemove) == true)) {
        return false;
    }
    if ((UnitGetOwner(lp_unit) == c_playerAny)) {
        return false;
    }
    if ((libNtve_gf_PlayerIsEnemy(UnitGetOwner(lp_unit), libE0EAE146_gv_abathurBiomassPlayer, libNtve_ge_PlayerRelation_Enemy) == false)) {
        return false;
    }
    if ((UnitTypeTestAttribute(UnitGetType(lp_unit), c_unitAttributeStructure) == true)) {
        return false;
    }
    if ((UnitTypeTestAttribute(UnitGetType(lp_unit), c_unitAttributeSummoned) == true)) {
        return false;
    }
    if ((UnitHasBehavior2(lp_unit, libE0EAE146_gv_biomassNoDrop) == true)) {
        return false;
    }
    if ((libE0EAE146_gf_AbathurBiomassAmount(lp_unit) <= 0.0)) {
        return false;
    }
    return true;
}

bool libE0EAE146_gf_AbathurCanCollectBiomass (unit lp_unit) {
    string lv_unitType;
    int lv_i;
    string lv_check;

    if ((lp_unit == null)) {
        return false;
    }
    lv_unitType = UnitGetType(lp_unit);
    // Data-driven non-collectible unit check (see LibE0EAE146_BiomassRules.galaxy).
    lv_i = 1;
    for ( ; ( lv_i <= libE0EAE146_gv_biomassNonCollectibleCount ) ; lv_i += 1 ) {
        lv_check = libE0EAE146_gf_BiomassNonCollectibleUnit(lv_i);
        if ((lv_unitType == lv_check)) {
            return false;
        }
    }
    if ((UnitTypeTestAttribute(lv_unitType, c_unitAttributeStructure) == true)) {
        return false;
    }
    if ((UnitTypeTestAttribute(lv_unitType, c_unitAttributeSummoned) == true)) {
        return false;
    }
    if ((UnitFilterMatch(lp_unit, UnitGetOwner(lp_unit), UnitFilter(0, (1 << (c_targetFilterSummoned - 32)), 0, 0)) == true)) {
        return false;
    }
    // Data-driven timed-life behavior check.
    lv_i = 1;
    for ( ; ( lv_i <= libE0EAE146_gv_biomassTimedLifeCount ) ; lv_i += 1 ) {
        lv_check = libE0EAE146_gf_BiomassTimedLifeBehavior(lv_i);
        if ((UnitHasBehavior2(lp_unit, lv_check) == true)) {
            return false;
        }
    }
    return true;
}

fixed libE0EAE146_gf_AbathurBiomassAmount (unit lp_unit) {
    fixed lv_amount;
    fixed lv_food;
    int lv_resourceCost;
    if ((lp_unit == null)) {
        return 0.0;
    }
    if ((UnitTypeTestAttribute(UnitGetType(lp_unit), c_unitAttributeHeroic) == true)) {
        lv_amount = libE0EAE146_gv_biomassHeroicAmount;
    }
    else if ((UnitHasBehavior2(lp_unit, "HybridUnitDummy") == true)) {
        lv_amount = libE0EAE146_gv_biomassHybridAmount;
    }
    else if ((UnitHasBehavior2(lp_unit, "CritterExplode") == true)) {
        lv_amount = libE0EAE146_gv_biomassCritterAmount;
    }
    else {
        lv_food = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, UnitGetType(lp_unit), "Food", libE0EAE146_gv_abathurBiomassPlayer));
        if ((lv_food < 0.0)) {
            lv_amount = (libE0EAE146_gv_biomassFoodMultiplier * lv_food);
        }
        else {
            lv_amount = UnitGetPropertyInt(lp_unit, c_unitPropSuppliesUsed, c_unitPropNormal);
            if ((lv_amount > 0.0)) {
                lv_amount *= libE0EAE146_gv_biomassSuppliesMultiplier;
            }
        }
        if ((lv_amount <= 0.0)) {
            lv_resourceCost = UnitTypeGetCost(UnitGetType(lp_unit), c_unitCostSumMineralsVespene);
            if ((lv_resourceCost > 0)) {
                lv_amount = 1.0;
            }
        }
        if ((lv_amount > 0.0)) {
            if ((lv_amount < libE0EAE146_gv_biomassMinAmount)) {
                lv_amount = libE0EAE146_gv_biomassMinAmount;
            }
            if ((lv_amount > libE0EAE146_gv_biomassMaxAmount)) {
                lv_amount = libE0EAE146_gv_biomassMaxAmount;
            }
        }
    }
    return lv_amount;
}

int libE0EAE146_gf_AbathurBiomassMaxStacks () {
    int lv_max;
    lv_max = CatalogFieldValueGetAsInt(c_gameCatalogEffect, libE0EAE146_gv_biomassMaxStacksCatalog, libE0EAE146_gv_biomassMaxStacksField, libE0EAE146_gv_abathurBiomassPlayer);
    if ((lv_max <= 0)) {
        lv_max = libE0EAE146_gv_biomassDefaultMaxStacks;
    }
    return lv_max;
}

fixed libE0EAE146_gf_AbathurBiomassVisualScale (int lp_totalStacks) {
    int lv_clamped;

    lv_clamped = MinI(MaxI(lp_totalStacks, 0), libE0EAE146_gv_biomassScaleClampMax);
    return (libE0EAE146_gv_biomassScaleBase + (libE0EAE146_gv_biomassScalePerStack * IntToFixed(lv_clamped)));
}

void libE0EAE146_gf_AbathurBiomassSetStack (unit lp_biomass, int lp_stack) {
    if ((lp_biomass == null)) {
        return;
    }
    UnitSetCustomValue(lp_biomass, libE0EAE146_gv_biomassMergeCustomValueIndex, IntToFixed(lp_stack));
}

void libE0EAE146_gf_AbathurBiomassScale (unit lp_biomassUnit, bool lp_instantScale) {
    fixed lv_customScale;

    if ((lp_biomassUnit == null)) {
        return;
    }
    lv_customScale = (UnitGetCustomValue(lp_biomassUnit, libE0EAE146_gv_biomassScalerCustomValueIndex) / libE0EAE146_gv_biomassScalerScaleDivisor);
    lv_customScale += libE0EAE146_gv_biomassScalerScaleOffset;
    if ((lv_customScale > libE0EAE146_gv_biomassScalerScaleMax)) {
        lv_customScale = libE0EAE146_gv_biomassScalerScaleMax;
    }
    libNtve_gf_SendActorMessageToUnit(lp_biomassUnit, ("SetScale " + FixedToString(lv_customScale, c_fixedPrecisionAny)));
}

void libE0EAE146_gf_AbathurBiomassMerge (unit lp_biomassUnit, int lp_biomassUnitCount) {
    fixed lv_biomassCongealRadius;
    int lv_nearbyBiomassMaxCount;
    unit lv_nearbyBiomassMaxCountUnit;
    unitgroup lv_group;
    int lv_count;
    unit lv_groupUnit;

    if ((lp_biomassUnit == null)) {
        return;
    }
    if ((lp_biomassUnitCount <= 0)) {
        return;
    }

    lv_biomassCongealRadius = libE0EAE146_gv_biomassMergeRadius;
    lv_group = UnitGroup("BiomassPickup", UnitGetOwner(lp_biomassUnit), RegionCircle(UnitGetPosition(lp_biomassUnit), lv_biomassCongealRadius), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_count = UnitGroupCount(lv_group, c_unitCountAll);
    for (;; lv_count -= 1) {
        lv_groupUnit = UnitGroupUnitFromEnd(lv_group, lv_count);
        if (lv_groupUnit == null) {
            break;
        }
        if ((lv_groupUnit != lp_biomassUnit) && (UnitHasBehavior2(lv_groupUnit, libE0EAE146_gv_biomassTravelling) == false) && (UnitGetCustomValue(lv_groupUnit, libE0EAE146_gv_biomassMergeCustomValueIndex) > lv_nearbyBiomassMaxCount)) {
            lv_nearbyBiomassMaxCount = FixedToInt(UnitGetCustomValue(lv_groupUnit, libE0EAE146_gv_biomassMergeCustomValueIndex));
            lv_nearbyBiomassMaxCountUnit = lv_groupUnit;
        }
    }

    if ((lv_nearbyBiomassMaxCountUnit != null)) {
        libE0EAE146_gf_AbathurBiomassSetStack(lv_nearbyBiomassMaxCountUnit, FixedToInt((UnitGetCustomValue(lv_nearbyBiomassMaxCountUnit, libE0EAE146_gv_biomassMergeCustomValueIndex) + lp_biomassUnitCount)));
        UnitBehaviorAdd(lp_biomassUnit, libE0EAE146_gv_biomassTravelling, lp_biomassUnit, 1);
        UnitCreateEffectUnit(lp_biomassUnit, libE0EAE146_gv_biomassPickupFullLM, lv_nearbyBiomassMaxCountUnit);
        libE0EAE146_gf_AbathurBiomassScale(lv_nearbyBiomassMaxCountUnit, false);
        libE0EAE146_gf_AbathurBiomassShowCount(lv_nearbyBiomassMaxCountUnit, FixedToInt(UnitGetCustomValue(lv_nearbyBiomassMaxCountUnit, libE0EAE146_gv_biomassMergeCustomValueIndex)));
    }
}

int libE0EAE146_gf_AbathurUnitBiomassStacks (unit lp_unit) {
    if ((lp_unit == null)) {
        return 0;
    }
    return ((UnitBehaviorCount(lp_unit, libE0EAE146_gv_biomassBuff100) * 100) + (UnitBehaviorCount(lp_unit, libE0EAE146_gv_biomassBuff10) * 10) + UnitBehaviorCount(lp_unit, libE0EAE146_gv_biomassBuff1));
}

bool libE0EAE146_gf_AbathurIsUltimateBiomassUnit (unit lp_unit) {
    string lv_unitType;
    int lv_i;
    string lv_check;

    if ((lp_unit == null)) {
        return false;
    }
    lv_unitType = UnitGetType(lp_unit);
    // Data-driven ultimate biomass unit check.
    lv_i = 1;
    for ( ; ( lv_i <= libE0EAE146_gv_biomassUltimateUnitCount ) ; lv_i += 1 ) {
        lv_check = libE0EAE146_gf_BiomassUltimateUnit(lv_i);
        if ((lv_unitType == lv_check)) {
            return true;
        }
    }
    return false;
}

int libE0EAE146_gf_AbathurBiomassMaxStacksForUnit (unit lp_unit) {
    int lv_max;

    lv_max = libE0EAE146_gf_AbathurBiomassMaxStacks();
    if (!((lp_unit != null) && (libE0EAE146_gf_AbathurIsUltimateBiomassUnit(lp_unit) == true))) {
        return lv_max;
    }
    return libE0EAE146_gv_biomassUltimateMaxStacks;
}

int libE0EAE146_gf_AbathurAddBiomassStacks (unit lp_unit, int lp_amount) {
    int lv_max;
    int lv_current;
    int lv_applied;
    int lv_remaining;
    int lv_100;
    int lv_10;
    int lv_1;

    if ((lp_unit == null)) {
        return 0;
    }
    if ((libE0EAE146_gf_AbathurCanCollectBiomass(lp_unit) == false)) {
        return 0;
    }
    if ((lp_amount <= 0)) {
        return 0;
    }

    lv_max = libE0EAE146_gf_AbathurBiomassMaxStacksForUnit(lp_unit);
    lv_current = libE0EAE146_gf_AbathurUnitBiomassStacks(lp_unit);
    lv_applied = lp_amount;
    if (((lv_current + lv_applied) > lv_max)) {
        lv_applied = (lv_max - lv_current);
    }
    if ((lv_applied <= 0)) {
        return 0;
    }

    lv_remaining = lv_applied;
    lv_100 = TruncI((lv_remaining / 100));
    lv_remaining -= (lv_100 * 100);
    lv_10 = TruncI((lv_remaining / 10));
    lv_remaining -= (lv_10 * 10);
    lv_1 = lv_remaining;

    if ((lv_100 > 0)) {
        UnitBehaviorAddPlayer(lp_unit, libE0EAE146_gv_biomassBuff100, UnitGetOwner(lp_unit), lv_100);
    }
    if ((lv_10 > 0)) {
        UnitBehaviorAddPlayer(lp_unit, libE0EAE146_gv_biomassBuff10, UnitGetOwner(lp_unit), lv_10);
    }
    if ((lv_1 > 0)) {
        UnitBehaviorAddPlayer(lp_unit, libE0EAE146_gv_biomassBuff1, UnitGetOwner(lp_unit), lv_1);
    }
    libNtve_gf_SendActorMessageToUnit(lp_unit, ("SetScale " + FixedToString(libE0EAE146_gf_AbathurBiomassVisualScale(lv_current + lv_applied), c_fixedPrecisionAny)));
    libE0EAE146_gf_AbathurBiomassShowCount(lp_unit, (lv_current + lv_applied));
    libE0EAE146_gf_AbathurBiomassSyncCounter(lp_unit);
    return lv_applied;
}

void libE0EAE146_gf_AbathurBiomassSyncCounter (unit lp_unit) {
    int lv_total;

    if ((lp_unit == null)) {
        return;
    }
    lv_total = libE0EAE146_gf_AbathurUnitBiomassStacks(lp_unit);
    UnitBehaviorRemove(lp_unit, libE0EAE146_gv_biomassCounter, c_unitBehaviorCountAll);
    if ((lv_total > 0)) {
        UnitBehaviorAddPlayer(lp_unit, libE0EAE146_gv_biomassCounter, UnitGetOwner(lp_unit), lv_total);
    }
}

void libE0EAE146_gf_AbathurSetUnitFullBiomass (unit lp_unit) {
    int lv_applied;
    fixed lv_lifeMax;

    if ((lp_unit == null)) {
        return;
    }
    if ((UnitTypeTestAttribute(UnitGetType(lp_unit), c_unitAttributeStructure) == true)) {
        return;
    }
    if ((libE0EAE146_gf_AbathurCanCollectBiomass(lp_unit) == false)) {
        return;
    }
    lv_applied = libE0EAE146_gf_AbathurAddBiomassStacks(lp_unit, libE0EAE146_gf_AbathurBiomassMaxStacksForUnit(lp_unit));
    if ((lv_applied > 0)) {
        lib67C0F0E7_gf_UnitAddCustomValue(lp_unit, libE0EAE146_gv_biomassFullBiomassCustomValueIndex, IntToFixed(lv_applied));
    }
    lv_lifeMax = UnitGetPropertyFixed(lp_unit, c_unitPropLifeMax, c_unitPropCurrent);
    if ((lv_lifeMax > 0.0)) {
        UnitSetPropertyFixed(lp_unit, c_unitPropLife, lv_lifeMax);
    }
}

void libE0EAE146_gf_AbathurSetUnitGroupFullBiomass (unitgroup lp_units) {
    unit lv_unit;
    int lv_i;

    if ((lp_units == null)) {
        return;
    }
    lv_i = UnitGroupCount(lp_units, c_unitCountAlive);
    for (;; lv_i -= 1) {
        lv_unit = UnitGroupUnitFromEnd(lp_units, lv_i);
        if (lv_unit == null) { break; }
        libE0EAE146_gf_AbathurSetUnitFullBiomass(lv_unit);
    }
}

void libE0EAE146_gf_AbathurCreateUnitsWithFullBiomass (int lp_count, string lp_unitType, int lp_player, point lp_point) {
    if ((lp_count <= 0)) {
        return;
    }
    if ((lp_point == null)) {
        return;
    }
    lp_unitType = libE0EAE146_gf_CatalogUnitOrEmpty(lp_unitType);
    if ((lp_unitType == "")) {
        return;
    }
    libNtve_gf_CreateUnitsWithDefaultFacing(lp_count, lp_unitType, 0, lp_player, lp_point);
    libE0EAE146_gf_AbathurSetUnitGroupFullBiomass(UnitLastCreatedGroup());
}

void libE0EAE146_gf_AbathurCargoCreateWithFullBiomass (unit lp_container, string lp_unitType, int lp_count) {
    if ((lp_container == null)) {
        return;
    }
    if ((lp_count <= 0)) {
        return;
    }
    lp_unitType = libE0EAE146_gf_CatalogUnitOrEmpty(lp_unitType);
    if ((lp_unitType == "")) {
        return;
    }
    UnitCargoCreate(lp_container, lp_unitType, lp_count);
    libE0EAE146_gf_AbathurSetUnitGroupFullBiomass(UnitCargoLastCreatedGroup());
}

bool libE0EAE146_gf_AbathurHasUltimateUnlock () {
    return (TechTreeUpgradeCount(libE0EAE146_gv_abathurBiomassPlayer, "AbathurUnlockUltimateEvolutions", c_techCountCompleteOnly) > 0);
}

