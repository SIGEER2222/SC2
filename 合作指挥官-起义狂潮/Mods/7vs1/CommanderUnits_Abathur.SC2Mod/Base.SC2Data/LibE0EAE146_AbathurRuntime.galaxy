void libE0EAE146_gf_AbathurCreateCargoSquad (unit lp_container, string lp_kind) {
    string lv_kind;
    string lv_ravager;
    string lv_swarmHost;
    string lv_swarmQueen;
    string lv_ultimateBrutalisk;
    string lv_leviathan;

    lv_kind = lp_kind;
    lv_ravager = "RavagerAbathur";
    lv_swarmHost = "SwarmHostAbathur";
    lv_swarmQueen = "QueenCoopAbathur";
    lv_ultimateBrutalisk = libE0EAE146_gf_CatalogUnitOrEmpty("BrutaliskAbathur");
    if ((lv_ultimateBrutalisk == "")) {
        lv_ultimateBrutalisk = libE0EAE146_gf_CatalogUnitOrEmpty("Brutalisk");
    }
    lv_leviathan = libE0EAE146_gf_CatalogUnitOrEmpty("LeviathanAbathur");
    if ((lv_leviathan == "")) {
        lv_leviathan = libE0EAE146_gf_CatalogUnitOrEmpty("HotSLeviathan");
    }
    if ((lv_kind == "light")) {
        libE0EAE146_gf_AbathurCargoCreateWithFullBiomass(lp_container, "RoachVile", 3);
    }
    else if ((lv_kind == "heavy")) {
        libE0EAE146_gf_AbathurCargoCreateWithFullBiomass(lp_container, "RoachVile", 1);
        libE0EAE146_gf_AbathurCargoCreateWithFullBiomass(lp_container, lv_ravager, 1);
        libE0EAE146_gf_AbathurCargoCreateWithFullBiomass(lp_container, lv_swarmHost, 1);
        libE0EAE146_gf_AbathurCargoCreateWithFullBiomass(lp_container, lv_swarmQueen, 1);
    }
    else if ((lv_kind == "air")) {
        libE0EAE146_gf_AbathurCargoCreateWithFullBiomass(lp_container, "Mutalisk", 2);
        libE0EAE146_gf_AbathurCargoCreateWithFullBiomass(lp_container, "AbathurGuardian", 1);
        libE0EAE146_gf_AbathurCargoCreateWithFullBiomass(lp_container, "DevourerAbathur", 1);
    }
    else if ((lv_kind == "hero")) {
        libE0EAE146_gf_AbathurCargoCreateWithFullBiomass(lp_container, "RoachVile", 3);
        libE0EAE146_gf_AbathurCargoCreateWithFullBiomass(lp_container, lv_ravager, 1);
        libE0EAE146_gf_AbathurCargoCreateWithFullBiomass(lp_container, lv_swarmHost, 1);
        libE0EAE146_gf_AbathurCargoCreateWithFullBiomass(lp_container, lv_swarmQueen, 1);
        libE0EAE146_gf_AbathurCargoCreateWithFullBiomass(lp_container, "ViperAbathur", 1);
        libE0EAE146_gf_AbathurCargoCreateWithFullBiomass(lp_container, lv_ultimateBrutalisk, 1);
    }
    else if ((lv_kind == "ultimate")) {
        if ((libE0EAE146_gf_AbathurHasUltimateUnlock() == true)) {
            libE0EAE146_gf_AbathurCargoCreateWithFullBiomass(lp_container, lv_ultimateBrutalisk, 1);
            libE0EAE146_gf_AbathurCargoCreateWithFullBiomass(lp_container, lv_leviathan, 1);
        }
        else {
            libE0EAE146_gf_AbathurCreateCargoSquad(lp_container, "heavy");
        }
    }
    else {
        libE0EAE146_gf_AbathurCreateCargoSquad(lp_container, "light");
    }
}
