void libE0EAE146_gf_AbathurFusionProbeWrite (string lp_key, string lp_value) {
    BankLoad("CampaignXCore", 1);
    BankValueSetFromString(BankLastCreated(), "XMRuntimeDebug", lp_key, lp_value);
    BankSave(BankLastCreated());
}

void libE0EAE146_gf_AbathurFusionProbeSnapshot (int lp_player, string lp_stage) {
    unitgroup lv_ravagers;
    unitgroup lv_mutalisks;
    unitgroup lv_brutalisks;
    unitgroup lv_leviathans;
    unitgroup lv_abathurBrutalisks;
    int lv_brutaliskCount;

    lv_ravagers = UnitGroup("RavagerAbathur", lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_mutalisks = UnitGroup("Mutalisk", lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_brutalisks = UnitGroup("Brutalisk", lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_leviathans = UnitGroup("HotSLeviathan", lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_abathurBrutalisks = UnitGroup("BrutaliskAbathur", lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_brutaliskCount = UnitGroupCount(lv_brutalisks, c_unitCountAlive) + UnitGroupCount(lv_abathurBrutalisks, c_unitCountAlive);

    libE0EAE146_gf_AbathurFusionProbeWrite(("AbathurFusion." + lp_stage + ".RavagerCount"), IntToString(UnitGroupCount(lv_ravagers, c_unitCountAlive)));
    libE0EAE146_gf_AbathurFusionProbeWrite(("AbathurFusion." + lp_stage + ".MutaliskCount"), IntToString(UnitGroupCount(lv_mutalisks, c_unitCountAlive)));
    libE0EAE146_gf_AbathurFusionProbeWrite(("AbathurFusion." + lp_stage + ".BrutaliskCount"), IntToString(lv_brutaliskCount));
    libE0EAE146_gf_AbathurFusionProbeWrite(("AbathurFusion." + lp_stage + ".LeviathanCount"), IntToString(UnitGroupCount(lv_leviathans, c_unitCountAlive)));
}

bool libE0EAE146_gt_AbathurFusionProbe_Func (bool testConds, bool runActions) {
    unitgroup lv_ravagers;
    unitgroup lv_mutalisks;
    unit lv_unit;

    if (!runActions) {
        return true;
    }

    libE0EAE146_gf_AbathurFusionProbeSnapshot(1, "BeforeOrder");
    lv_ravagers = UnitGroup("RavagerAbathur", 1, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    if ((UnitGroupCount(lv_ravagers, c_unitCountAlive) > 0)) {
        lv_unit = UnitGroupRandomUnit(lv_ravagers, c_unitCountAlive);
        libE0EAE146_gf_AbathurFusionProbeWrite("AbathurFusion.BeforeOrder.RavagerBiomass100", IntToString(UnitBehaviorCount(lv_unit, "BiomassBuff100")));
        UnitIssueOrder(lv_unit, Order(StringToAbilCmd("EvolveToBrutaliskRavager,Train1")), c_orderQueueReplace);
    }

    lv_mutalisks = UnitGroup("Mutalisk", 1, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);

    libE0EAE146_gf_AbathurFusionProbeWrite("AbathurFusion.OrderIssued", "1");
    libE0EAE146_gf_AbathurFusionProbeSnapshot(1, "AfterOrder");
    return true;
}

bool libE0EAE146_gt_AbathurFusionProbeLate_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libE0EAE146_gf_AbathurFusionProbeSnapshot(1, "LateSnapshot");
    return true;
}

void libE0EAE146_gf_AbathurRunTestSpawnPreset (int lp_player) {
    point lv_start;

    BankLoad("CampaignXCore", 1);
    if ((BankValueGetAsString(BankLastCreated(), "XMRuntimeControl", "TestSpawnPreset") != "AbathurFusion")) {
        return;
    }

    libE0EAE146_gf_InitializeAbathurBiomass(lp_player, "BiomassPickupDummy");
    lv_start = PlayerStartLocation(lp_player);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "RavagerAbathur", c_unitCreateIgnorePlacement, lp_player, Point(PointGetX(lv_start) - 45.0, PointGetY(lv_start) + 12.0));
    libE0EAE146_gf_AbathurSetUnitFullBiomass(UnitLastCreated());
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "Mutalisk", c_unitCreateIgnorePlacement, lp_player, Point(PointGetX(lv_start) - 49.0, PointGetY(lv_start) + 14.0));
    libE0EAE146_gf_AbathurSetUnitFullBiomass(UnitLastCreated());
    UIDisplayMessage(PlayerGroupSingle(lp_player), c_messageAreaChat, StringToText("Codex test init: Abathur fusion test units spawned from XMRuntimeControl/TestSpawnPreset."));
    TriggerAddEventTimeElapsed(TriggerCreate("libE0EAE146_gt_AbathurFusionProbe_Func"), 8.0, c_timeGame);
    TriggerAddEventTimeElapsed(TriggerCreate("libE0EAE146_gt_AbathurFusionProbeLate_Func"), 18.0, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// 阿巴瑟开局天赋（与 WebUI StartTalentMask 对接）
// Bit 0 (mask 1): AbathurStartBiomass - 所有出生的战斗单位开局自带 50 层生物质
// Bit 1 (mask 2): AbathurStartUltimateBiomass - 莽兽和利维坦额外获得 25 层生物质
//--------------------------------------------------------------------------------------------------

int libE0EAE146_gv_abathurStartTalentMask;
int libE0EAE146_gv_abathurStartTalentPlayer;
bool libE0EAE146_gv_abathurStartTalentsEnabled;

void libE0EAE146_gf_AbathurStartTalentApplyToUnit (unit lp_unit) {
    int lv_amount;

    if ((lp_unit == null)) {
        return;
    }
    if ((libE0EAE146_gv_abathurStartTalentsEnabled == false)) {
        return;
    }
    if ((UnitGetOwner(lp_unit) != libE0EAE146_gv_abathurStartTalentPlayer)) {
        return;
    }
    if ((libE0EAE146_gf_AbathurCanCollectBiomass(lp_unit) == false)) {
        return;
    }
    if ((libE0EAE146_gf_HexTalentsIsCasterUnit(UnitGetType(lp_unit)) == true)) {
        return;
    }

    lv_amount = 0;
    if ((lib67C0F0E7_gf_BitMaskTrueIndexIs(libE0EAE146_gv_abathurStartTalentMask, 0) == true)) {
        lv_amount = 50;
    }

    if ((libE0EAE146_gf_AbathurIsUltimateBiomassUnit(lp_unit) == true)) {
        if ((lib67C0F0E7_gf_BitMaskTrueIndexIs(libE0EAE146_gv_abathurStartTalentMask, 1) == true)) {
            lv_amount += 25;
        }
    }

    if ((lv_amount > 0)) {
        libE0EAE146_gf_AbathurAddBiomassStacks(lp_unit, lv_amount);
    }
}

bool libE0EAE146_gt_AbathurStartTalentUnitCreated_Func (bool testConds, bool runActions) {
    unit lv_unit;

    if (!runActions) {
        return true;
    }

    lv_unit = EventUnit();
    if ((lv_unit == null)) {
        return true;
    }

    libE0EAE146_gf_AbathurStartTalentApplyToUnit(lv_unit);
    return true;
}

void libE0EAE146_gf_AbathurStartTalentsInit (int lp_player) {
    int lv_mask;
    unitgroup lv_existingUnits;
    int lv_count;
    unit lv_unit;

    libE0EAE146_gv_abathurStartTalentPlayer = lp_player;
    libE0EAE146_gv_abathurStartTalentMask = 0;
    libE0EAE146_gv_abathurStartTalentsEnabled = false;

    lv_mask = libE0EAE146_gf_CommanderPowerBankIntOrDefault("Abathur", "StartTalentMask", 0);
    libE0EAE146_gv_abathurStartTalentMask = lv_mask;

    if ((lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_mask, 0) == false)) {
        if ((lib67C0F0E7_gf_BitMaskTrueIndexIs(lv_mask, 1) == false)) {
            return;
        }
    }

    libE0EAE146_gv_abathurStartTalentsEnabled = true;

    libE0EAE146_gf_InitializeAbathurBiomass(lp_player, "BiomassPickupDummy");

    libE0EAE146_gt_AbathurStartTalentUnitCreated = TriggerCreate("libE0EAE146_gt_AbathurStartTalentUnitCreated_Func");
    TriggerAddEventUnitCreated(libE0EAE146_gt_AbathurStartTalentUnitCreated, null, null, null);

    lv_existingUnits = UnitGroup(null, lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_count = UnitGroupCount(lv_existingUnits, c_unitCountAlive);
    for (;; lv_count -= 1) {
        lv_unit = UnitGroupUnitFromEnd(lv_existingUnits, lv_count);
        if (lv_unit == null) {
            break;
        }
        libE0EAE146_gf_AbathurStartTalentApplyToUnit(lv_unit);
    }
}

void libE0EAE146_gf_AbathurRuntimeInit (int lp_player, point lp_heroPoint, bool lp_createHero) {
    unit lv_caster;

    libE0EAE146_gf_RuntimeCheckpoint("AbathurRuntime.enter");
    if (libE0EAE146_gv_abathurRuntimeInitialized == true) {
        libE0EAE146_gf_RuntimeCheckpoint("AbathurRuntime.alreadyInitialized");
        return;
    }

    libE0EAE146_gv_abathurRuntimeInitialized = true;
    libE0EAE146_gf_ApplyTalents(lp_player, "ZergAbathur");
    if (libE0EAE146_gf_CommanderUsePrivateTechFilter("Abathur")) {
        libE0EAE146_gf_AbathurApplyTechFilter(lp_player);
    }
    libE0EAE146_gf_RuntimeCheckpoint("AbathurRuntime.afterTechFilter");

    libNtve_gf_CreateUnitsWithDefaultFacing(1, "CoopCasterAbathur", c_unitCreateIgnorePlacement, lp_player, RegionGetBoundsMin(RegionEntireMap()));
    lv_caster = UnitLastCreated();
    lib67C0F0E7_gf_CU_GPInit(lp_player, "Abathur", lv_caster, null);
    lib67C0F0E7_gf_CU_GPShowHide(true, lp_player, c_transitionDurationDefault);
    lib67C0F0E7_gf_ShowChooseButton();
    libE0EAE146_gf_AbathurRunTestSpawnPreset(lp_player);
    libE0EAE146_gf_AbathurStartTalentsInit(lp_player);
    libE0EAE146_gf_RuntimeCheckpoint("AbathurRuntime.exit");
}

//--------------------------------------------------------------------------------------------------
// Abathur start squads (migrated from LibE0EAE146_CommanderStartSquads, Task 7)
//--------------------------------------------------------------------------------------------------
void libE0EAE146_gf_AbathurCreateMapStartSquad (string lp_kind, int lp_player, point lp_point) {
    string lv_kind;
    string lv_ravager;
    string lv_swarmHost;
    string lv_swarmQueen;
    string lv_ultimateBrutalisk;
    string lv_leviathan;

    lv_kind = lp_kind;
    lv_ravager = "RavagerAbathur";
    lv_swarmHost = "SwarmHostAbathur";
    lv_swarmQueen = "QueenCoopAbathur";
    lv_ultimateBrutalisk = libE0EAE146_gf_CatalogUnitOrEmpty("BrutaliskAbathur");
    if ((lv_ultimateBrutalisk == "")) {
        lv_ultimateBrutalisk = libE0EAE146_gf_CatalogUnitOrEmpty("Brutalisk");
    }
    lv_leviathan = libE0EAE146_gf_CatalogUnitOrEmpty("LeviathanAbathur");
    if ((lv_leviathan == "")) {
        lv_leviathan = libE0EAE146_gf_CatalogUnitOrEmpty("HotSLeviathan");
    }
    if ((lv_kind == "light")) {
        libE0EAE146_gf_AbathurCreateUnitsWithFullBiomass(2, "RoachVile", lp_player, lp_point);
    }
    else if ((lv_kind == "heavy")) {
        libE0EAE146_gf_AbathurCreateUnitsWithFullBiomass(1, "RoachVile", lp_player, lp_point);
        libE0EAE146_gf_AbathurCreateUnitsWithFullBiomass(1, lv_ravager, lp_player, lp_point);
        libE0EAE146_gf_AbathurCreateUnitsWithFullBiomass(1, lv_swarmHost, lp_player, lp_point);
        libE0EAE146_gf_AbathurCreateUnitsWithFullBiomass(1, lv_swarmQueen, lp_player, lp_point);
    }
    else if ((lv_kind == "air")) {
        libE0EAE146_gf_AbathurCreateUnitsWithFullBiomass(2, "Mutalisk", lp_player, lp_point);
        libE0EAE146_gf_AbathurCreateUnitsWithFullBiomass(1, "AbathurGuardian", lp_player, lp_point);
        libE0EAE146_gf_AbathurCreateUnitsWithFullBiomass(1, "DevourerAbathur", lp_player, lp_point);
    }
    else if ((lv_kind == "hero")) {
        libE0EAE146_gf_AbathurCreateUnitsWithFullBiomass(3, "RoachVile", lp_player, lp_point);
        libE0EAE146_gf_AbathurCreateUnitsWithFullBiomass(1, lv_ravager, lp_player, lp_point);
        libE0EAE146_gf_AbathurCreateUnitsWithFullBiomass(1, lv_swarmHost, lp_player, lp_point);
        libE0EAE146_gf_AbathurCreateUnitsWithFullBiomass(1, lv_swarmQueen, lp_player, lp_point);
        libE0EAE146_gf_AbathurCreateUnitsWithFullBiomass(1, "ViperAbathur", lp_player, lp_point);
        libE0EAE146_gf_AbathurCreateUnitsWithFullBiomass(1, lv_ultimateBrutalisk, lp_player, lp_point);
        libE0EAE146_gf_AbathurCreateUnitsWithFullBiomass(1, lv_leviathan, lp_player, lp_point);
    }
    else if ((lv_kind == "ultimate")) {
        if ((libE0EAE146_gf_AbathurHasUltimateUnlock() == true)) {
            libE0EAE146_gf_AbathurCreateUnitsWithFullBiomass(1, lv_ultimateBrutalisk, lp_player, lp_point);
            libE0EAE146_gf_AbathurCreateUnitsWithFullBiomass(1, lv_leviathan, lp_player, lp_point);
        }
        else {
            libE0EAE146_gf_AbathurCreateMapStartSquad("heavy", lp_player, lp_point);
        }
    }
    else {
        libE0EAE146_gf_AbathurCreateMapStartSquad("light", lp_player, lp_point);
    }
}

