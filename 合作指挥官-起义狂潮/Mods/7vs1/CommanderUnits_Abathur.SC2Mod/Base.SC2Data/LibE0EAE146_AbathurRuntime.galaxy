// Shared Abathur biomass logic stays in CommanderStartSquads.
// This runtime file only owns the standard commander init path.

void libE0EAE146_gf_AbathurSetUpgradeAtLeast (int lp_player, string lp_upgrade, int lp_level) {
    int lv_currentLevel;

    if ((lp_upgrade == "") || (!CatalogEntryIsValid(c_gameCatalogUpgrade, lp_upgrade))) {
        return;
    }

    lv_currentLevel = TechTreeUpgradeCount(lp_player, lp_upgrade, c_techCountCompleteOnly);
    if (lv_currentLevel < lp_level) {
        TechTreeUpgradeAddLevel(lp_player, lp_upgrade, (lp_level - lv_currentLevel));
    }
}

void libE0EAE146_gf_AbathurAllowUnitIfValid (int lp_player, string lp_unit, bool lp_allow) {
    if ((lp_unit == "") || (!CatalogEntryIsValid(c_gameCatalogUnit, lp_unit))) {
        return;
    }
    TechTreeUnitAllow(lp_player, lp_unit, lp_allow);
}

void libE0EAE146_gf_AbathurAllowAbilityIfValid (int lp_player, string lp_ability, int lp_commandIndex, bool lp_allow) {
    if ((lp_ability == "") || (!CatalogEntryIsValid(c_gameCatalogAbil, lp_ability))) {
        return;
    }
    TechTreeAbilityAllow(lp_player, AbilityCommand(lp_ability, lp_commandIndex), lp_allow);
}

