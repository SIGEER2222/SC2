bool libE0EAE146_gf_RaynorStructureNeedsRefresh (unit lp_unit) {
    string lv_unitType;

    if (UnitIsAlive(lp_unit) == false) {
        return false;
    }

    if (libKCOR_gf_ActiveCommanderForPlayer(UnitGetOwner(lp_unit)) != "TerranRaynor") {
        return false;
    }

    lv_unitType = UnitGetType(lp_unit);
    if ((lv_unitType == "CommandCenterRaynor") || (lv_unitType == "CommandCenterFlyingRaynor") || (lv_unitType == "OrbitalCommandRaynor") || (lv_unitType == "OrbitalCommandFlyingRaynor")) {
        return true;
    }
    if ((lv_unitType == "Barracks") || (lv_unitType == "BarracksRaynor") || (lv_unitType == "BarracksFlyingRaynor") || (lv_unitType == "BarracksRaynorX") || (lv_unitType == "BarracksFlyingRaynorX")) {
        return true;
    }
    if ((lv_unitType == "Factory") || (lv_unitType == "FactoryRaynor") || (lv_unitType == "FactoryFlyingRaynor")) {
        return true;
    }
    if ((lv_unitType == "Starport") || (lv_unitType == "StarportRaynor") || (lv_unitType == "StarportFlyingRaynor")) {
        return true;
    }

    return false;
}

string libE0EAE146_gf_RaynorMorphExpectedUnitType (abilcmd lp_abilCmd) {
    string lv_abil;

    lv_abil = AbilityCommandGetAbility(lp_abilCmd);
    if (lv_abil == "CommandCenterLiftOffRaynor") {
