bool libE0EAE146_gt_RaynorStructureMorphRefresh_Func (bool testConds, bool runActions) {
    int lv_player;
    unit lv_newUnit;
    point lv_oldPoint;
    unitgroup lv_selectedUnits;
    bool lv_wasSelected;

    if (testConds) {
        if (libE0EAE146_gf_RaynorStructureNeedsRefresh(EventUnit()) == false) {
            return false;
        }
    }

    if (!runActions) {
        return true;
    }

    lv_player = UnitGetOwner(EventUnit());
    lv_oldPoint = UnitGetPosition(EventUnit());
    lv_selectedUnits = UnitGroupSelected(lv_player);
    lv_wasSelected = UnitIsSelected(EventUnit(), lv_player);
    Wait(0.125, c_timeGame);
    lv_newUnit = libE0EAE146_gf_RaynorResolveMorphedStructure(EventUnit(), EventUnitAbility());
    if ((lv_newUnit != null) && (UnitIsAlive(lv_newUnit) == true)) {
        libNtve_gf_CopyUnitControlGroups(EventUnit(), lv_newUnit);
        UnitCreateEffectUnit(lv_newUnit, "CopyTargetSelectionAndControlGroups", EventUnit());
        if (lv_wasSelected == true) {
            UnitGroupRemove(lv_selectedUnits, EventUnit());
            UnitGroupAdd(lv_selectedUnits, lv_newUnit);
            UnitClearSelection(lv_player);
            Wait(0.0625, c_timeGame);
            UnitSelect(lv_newUnit, lv_player, true);
            UnitGroupSelect(lv_selectedUnits, lv_player, true);
        }
    }
    else if (lv_wasSelected == true) {
        lv_newUnit = libE0EAE146_gf_RaynorFindNearestOwnedUnitOfType(lv_player, libE0EAE146_gf_RaynorMorphExpectedUnitType(EventUnitAbility()), lv_oldPoint, 8.0);
        if ((lv_newUnit != null) && (UnitIsAlive(lv_newUnit) == true)) {
            UnitClearSelection(lv_player);
            UnitSelect(lv_newUnit, lv_player, true);
        }
    }
    if (((lv_newUnit != null) && (libE0EAE146_gf_RaynorStructureNeedsRefresh(lv_newUnit) == true)) || (libE0EAE146_gf_RaynorStructureNeedsRefresh(EventUnit()) == true)) {
        libE0EAE146_gf_RaynorApplyTechFilter(lv_player);
    }
    return true;
}

