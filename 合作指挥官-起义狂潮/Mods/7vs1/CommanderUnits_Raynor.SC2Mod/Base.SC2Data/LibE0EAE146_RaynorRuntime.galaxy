    }
    if (lv_abil == "UpgradeToOrbitalRaynor") {
        return "OrbitalCommandRaynor";
    }
    if (lv_abil == "OrbitalLiftOffRaynor") {
        return "OrbitalCommandFlyingRaynor";
    }
    if (lv_abil == "OrbitalCommandLandRaynor") {
        return "OrbitalCommandRaynor";
    }
    if (lv_abil == "BarracksLiftOffRaynor") {
        return "BarracksFlyingRaynor";
    }
    if (lv_abil == "BarracksLandRaynor") {
        return "BarracksRaynor";
