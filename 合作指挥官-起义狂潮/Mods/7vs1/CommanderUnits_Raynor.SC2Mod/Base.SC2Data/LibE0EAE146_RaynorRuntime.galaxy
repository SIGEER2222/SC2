int libE0EAE146_gf_RaynorRuntimeUnitTypeCount (int lp_player, string lp_unitType) {
    if ((lp_unitType == "") || (!CatalogEntryIsValid(c_gameCatalogUnit, lp_unitType))) {
        return 0;
    }

    return UnitGroupCount(UnitGroup(lp_unitType, lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive);
}

void libE0EAE146_gf_RaynorTrainProbeWriteInt (string lp_key, int lp_value) {
    BankLoad("CampaignXCore", 1);
    BankValueSetFromInt(BankLastCreated(), "XMRuntimeDebug", lp_key, lp_value);
    BankSave(BankLastCreated());
}

void libE0EAE146_gf_RaynorTrainProbeWriteString (string lp_key, string lp_value) {
    BankLoad("CampaignXCore", 1);
    BankValueSetFromString(BankLastCreated(), "XMRuntimeDebug", lp_key, lp_value);
    BankSave(BankLastCreated());
}

int libE0EAE146_gf_RaynorBoolToInt (bool lp_value) {
    if (lp_value) {
        return 1;
    }

    return 0;
}

void libE0EAE146_gf_RaynorTrainProbeWriteOrderValidity (unit lp_unit, string lp_abil, int lp_maxCmdIndex, string lp_keyPrefix) {
    int lv_cmdIndex;
    order lv_order;

    lv_cmdIndex = 0;
    while ((lv_cmdIndex <= lp_maxCmdIndex)) {
        lv_order = Order(AbilityCommand(lp_abil, lv_cmdIndex));
        libE0EAE146_gf_RaynorTrainProbeWriteInt(lp_keyPrefix + IntToString(lv_cmdIndex) + "Valid", libE0EAE146_gf_RaynorBoolToInt(UnitOrderIsValid(lp_unit, lv_order)));
        lv_cmdIndex += 1;
    }
}

void libE0EAE146_gf_RaynorSetUpgradeAtLeast (int lp_player, string lp_upgrade, int lp_level) {
    libE0EAE146_gf_CommanderPowerSetUpgradeAtLeast(lp_player, lp_upgrade, lp_level);
}

void libE0EAE146_gf_RaynorAllowUnitIfPresent (int lp_player, string lp_unit) {
    if ((lp_unit == "") || (!CatalogEntryIsValid(c_gameCatalogUnit, lp_unit))) {
        return;
    }
    TechTreeUnitAllow(lp_player, lp_unit, true);
}

void libE0EAE146_gf_RaynorBlockUnitIfPresent (int lp_player, string lp_unit) {
    if ((lp_unit == "") || (!CatalogEntryIsValid(c_gameCatalogUnit, lp_unit))) {
        return;
    }
    TechTreeUnitAllow(lp_player, lp_unit, false);
}

void libE0EAE146_gf_RaynorAllowAbilityIfPresent (int lp_player, string lp_abil, int lp_cmdIndex) {
    if ((lp_abil == "") || (!CatalogEntryIsValid(c_gameCatalogAbil, lp_abil))) {
        return;
    }
    TechTreeAbilityAllow(lp_player, AbilityCommand(lp_abil, lp_cmdIndex), true);
}

void libE0EAE146_gf_RaynorAllowAddOnAbilityIfPresent (int lp_player, string lp_abil) {
    libE0EAE146_gf_RaynorAllowAbilityIfPresent(lp_player, lp_abil, 0);
    libE0EAE146_gf_RaynorAllowAbilityIfPresent(lp_player, lp_abil, 1);
    libE0EAE146_gf_RaynorAllowAbilityIfPresent(lp_player, lp_abil, 3);
}

