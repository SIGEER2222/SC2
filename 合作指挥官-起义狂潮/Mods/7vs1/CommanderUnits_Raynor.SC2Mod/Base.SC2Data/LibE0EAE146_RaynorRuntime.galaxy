    lib67C0F0E7_gf_CU_GPInit(lp_player, "Raynor", lv_caster, null);
    libE0EAE146_gf_RuntimeCheckpoint("RaynorRuntime.afterGPInit");
    lib67C0F0E7_gf_CU_GPShowHide(true, lp_player, c_transitionDurationDefault);
    lib67C0F0E7_gf_ShowChooseButton();

    libNtve_gf_CreateUnitsWithDefaultFacing(1, "BarracksRaynorX", 0, lp_player, PointWithOffsetPolar(lp_heroPoint, 8.0, 0.0));
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "Barracks", 0, lp_player, PointWithOffsetPolar(lp_heroPoint, 8.0, 120.0));
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "BarracksRaynor", 0, lp_player, PointWithOffsetPolar(lp_heroPoint, 8.0, 240.0));

