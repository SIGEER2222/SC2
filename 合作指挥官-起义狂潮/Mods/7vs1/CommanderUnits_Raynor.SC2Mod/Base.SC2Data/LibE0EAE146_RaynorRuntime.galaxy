}

unit libE0EAE146_gf_RaynorFindNearestOwnedUnitOfType (int lp_player, string lp_unitType, point lp_point, fixed lp_maxDistance) {
    unitgroup lv_units;
    int lv_count;
    unit lv_unit;
    unit lv_bestUnit;
    fixed lv_distance;
    fixed lv_bestDistance;

    if ((lp_unitType == "") || (!CatalogEntryIsValid(c_gameCatalogUnit, lp_unitType))) {
        return null;
    }

    lv_units = UnitGroup(lp_unitType, lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_count = UnitGroupCount(lv_units, c_unitCountAlive);
    lv_bestDistance = (lp_maxDistance + 0.5);
    for (;; lv_count -= 1) {
        lv_unit = UnitGroupUnitFromEnd(lv_units, lv_count);
        if (lv_unit == null) { break; }
        lv_distance = DistanceBetweenPoints(lp_point, UnitGetPosition(lv_unit));
        if (lv_distance <= lp_maxDistance) {
            if ((lv_bestUnit == null) || (lv_distance < lv_bestDistance)) {
                lv_bestUnit = lv_unit;
                lv_bestDistance = lv_distance;
            }
        }
    }

    return lv_bestUnit;
}

unit libE0EAE146_gf_RaynorResolveMorphedStructure (unit lp_oldUnit, abilcmd lp_abilCmd) {
    int lv_player;
    string lv_expectedType;
    point lv_oldPoint;
    unit lv_newUnit;

    lv_player = UnitGetOwner(lp_oldUnit);
    lv_expectedType = libE0EAE146_gf_RaynorMorphExpectedUnitType(lp_abilCmd);
    lv_newUnit = libNtve_gf_LastReplacedUnit();
    if ((lv_newUnit != null) && (UnitIsAlive(lv_newUnit) == true) && (UnitGetOwner(lv_newUnit) == lv_player)) {
        if ((lv_expectedType == "") || (UnitGetType(lv_newUnit) == lv_expectedType)) {
            return lv_newUnit;
        }
    }

    lv_oldPoint = UnitGetPosition(lp_oldUnit);
    return libE0EAE146_gf_RaynorFindNearestOwnedUnitOfType(lv_player, lv_expectedType, lv_oldPoint, 6.0);
}

