include "TriggerLibs/NativeLib"

include "LibA1ADAPTER_h"

//--------------------------------------------------------------------------------------------------
// Library: Alenger1Adapter
// 1钢铁 adapter，对接 7v1 框架。MapInit 触发器为玩家1应用升级（从原 mod Lib1A1D096B 提取）。
//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
// Trigger: MapInit - 为玩家1执行 1钢铁 升级逻辑
//--------------------------------------------------------------------------------------------------
bool libA1ADAPTER_gt_MapInit_Func (bool testConds, bool runActions) {
    int lp_player = 1;
    int lv_player;
    int lv_i;
    playergroup auto1ADAPTER_g;

    if (testConds) { return true; }
    if (!runActions) { return true; }

    // 为玩家1升级全部科技（从 Lib1A1D096B.galaxy 提取）
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "FireSuppressionSystems", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "AutoHarvester", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1chengqiangzhunagjia", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1hedonglifanyingdui", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1jiguangzuanjishengji1", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1jiguangzuanjishengji2", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1kuaisubushu", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1liushuixiandashengchan", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1shengwugang", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1shunshizhuizong", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1zuozhandanweifangyushengji", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1zuozhandanweigongjishengji", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1baozhafanyinzhuangjiashengji1", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1baozhafanyinzhuangjiashengji2", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1jiaguzhuangjiashengji1", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1jiaguzhuangjiashengji2", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1jianongpaoshengji1", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1jianongpaoshengji2", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1qingxingzhuangjiashengji1", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1qingxingzhuangjiashengji2", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1zhongxingzhuangjiashengji1", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1zhongxingzhuangjiashengji2", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1baoliewuqishengji1", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1baoliewuqishengji2", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1diyuhuoyuranqi2", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1huoyanwuqishengji2", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1jiatelinpaotai", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1popianfangkongpao", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1popianwuqishengji1", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1popianwuqishengji2", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1renleifangyujianzhugongjishengji", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1renleifangyujianzhuzhuangjiashengji", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1fangyujuzhenshengji1", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1fangyujuzhenshengji2", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "4guidaopaowuqishengji1", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "4guidaopaowuqishengji2", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1houqingyouhua", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "4jiatelinwuqishengji1", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "4jiatelinwuqishengji2", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1namiqianghua", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1shuangjiuqudong", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "1zhinengchongjian", 1);

    // 为所有人类玩家解锁能力（7vs1 框架 ApplyOriginal7v1OpenerTech 不覆盖 Alenger，需显式解锁）
    // 能力解锁：工兵建造/主基地训练/研究/变异能力，否则建造面板按钮缺失
    auto1ADAPTER_g = PlayerGroupAll();
    lv_player = -1;
    while (true) {
        lv_player = PlayerGroupNextPlayer(auto1ADAPTER_g, lv_player);
        if (lv_player < 0) { break; }
        if ((PlayerType(lv_player) == c_playerTypeUser)) {
            // 解锁能力（cmd 0-31）
            for (lv_i = 0; lv_i <= 31; lv_i += 1) {
                // 建造
                TechTreeAbilityAllow(lv_player, AbilityCommand("1jianzao", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("1jianzao2", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("1jianzao5", lv_i), true);
                // 训练
                TechTreeAbilityAllow(lv_player, AbilityCommand("1zhizaogangtiegongchengche", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("1zhizao2", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("1zhizao3", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("1zhizao4", lv_i), true);
                // 研究
                TechTreeAbilityAllow(lv_player, AbilityCommand("1shengjijiguangzuanji", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("1yanjiu", lv_i), true);
                // 变异
                TechTreeAbilityAllow(lv_player, AbilityCommand("1huoshenmoshi", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("1xunhangmoshi", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("1moripaotaijiangxia", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("1moripaotaishengqi", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("1shengkong3", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("1bianxingweigangtiepaojian", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("1bianxingweigangtiepaoting", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("1gongchengmoshi", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("1quxiaogongchengmoshi", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("1shaobingdileiqiandi", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("1shaobingdileichudi", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("1shengkong4", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("1zhanjimoshi", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("1jijiamoshi", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("1quxiaopaojimoshi", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("1qidongpaojimoshi", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("1chongjiangangtiebaolei", lv_i), true);
                TechTreeAbilityAllow(lv_player, AbilityCommand("1gangtiebaoleicanhai", lv_i), true);
            }
        }
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void libA1ADAPTER_InitTriggers () {
    libA1ADAPTER_gt_MapInit = TriggerCreate("libA1ADAPTER_gt_MapInit_Func");
    TriggerAddEventMapInit(libA1ADAPTER_gt_MapInit);
}

//--------------------------------------------------------------------------------------------------
// Library Initialization
//--------------------------------------------------------------------------------------------------
bool libA1ADAPTER_InitLib_completed = false;

void libA1ADAPTER_InitLib () {
    if (libA1ADAPTER_InitLib_completed) {
        return;
    }
    libA1ADAPTER_InitLib_completed = true;
    libA1ADAPTER_InitTriggers();
}
