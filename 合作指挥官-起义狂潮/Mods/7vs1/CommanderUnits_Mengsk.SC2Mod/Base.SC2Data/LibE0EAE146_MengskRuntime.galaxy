    TriggerEnable(libE0EAE146_gt_CM_Mengsk_DirtyBombSweetener, false);
    TriggerAddEventUnitAbility(libE0EAE146_gt_CM_Mengsk_DirtyBombSweetener, null, AbilityCommand("ArtilleryMengskGlobalExperimentalStrike",0), c_unitAbilStageAll, false);
}

