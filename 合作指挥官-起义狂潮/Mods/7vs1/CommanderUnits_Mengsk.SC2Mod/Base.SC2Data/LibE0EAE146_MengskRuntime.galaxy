bool libE0EAE146_gt_CM_Mengsk_ReturnToWork_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_worker;
    unit lv_nearbytownhall;

    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((UnitIsAlive(EventUnit()) == true))) {
            return false;
        }

        if (!((UnitOrderCount(EventUnit()) == 0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitGroupAdd(libE0EAE146_gv_cM_Mengsk_ReturningWorkers[UnitGetOwner(EventUnit())], EventUnit());
    if ((TriggerActiveCount(TriggerGetCurrent()) > 1)) {
        return true;
    }

    while ((UnitGroupCount(libE0EAE146_gv_cM_Mengsk_ReturningWorkers[UnitGetOwner(EventUnit())], c_unitCountAlive) > 0)) {
        lv_worker = UnitGroupUnit(libE0EAE146_gv_cM_Mengsk_ReturningWorkers[UnitGetOwner(EventUnit())], 1);
        Wait(0.0625, c_timeGame);
        if ((UnitIsAlive(lv_worker) == true)) {
            UnitGroupRemove(libE0EAE146_gv_cM_Mengsk_ReturningWorkers[UnitGetOwner(EventUnit())], lv_worker);
            lv_nearbytownhall = UnitGroupClosestToPoint(UnitGroup("CommandCenterMengsk", UnitGetOwner(lv_worker), RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), UnitGetPosition(lv_worker));
            if ((UnitIsAlive(lv_nearbytownhall) == true) && (DistanceBetweenPoints(UnitGetPosition(lv_worker), UnitGetPosition(lv_nearbytownhall)) < 8.0)) {
                libKMIS_gf_CM_Resources_FindWork(lv_worker, lv_nearbytownhall, 12.0);
            }

        }

    }
    return true;
}

