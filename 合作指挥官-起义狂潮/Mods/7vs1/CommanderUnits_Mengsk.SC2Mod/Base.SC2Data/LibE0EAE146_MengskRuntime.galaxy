bool libE0EAE146_gt_CM_Mengsk_WeaponPickup_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_pickup;
    unit lv_pickerupper;

    // Automatic Variable Declarations
    playergroup autoF22E961D_g;
    int autoF22E961D_var;
    unitgroup autoA2658E2A_g;
    int autoA2658E2A_u;
    string autoFCCB9364_val;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    if ((TriggerActiveCount(TriggerGetCurrent()) > 1)) {
        return true;
    }

    while (true) {
        Wait(0.5, c_timeGame);
        autoF22E961D_g = libKPVP_gv_mengsk_players;
        autoF22E961D_var = -1;
        while (true) {
            autoF22E961D_var = PlayerGroupNextPlayer(autoF22E961D_g, autoF22E961D_var);
            if (autoF22E961D_var < 0) { break; }
            if ((UnitGroupCount(libE0EAE146_gv_cM_Mengsk_WeaponPickups[autoF22E961D_var], c_unitCountAlive) > 0) && (UnitGroupCount(libE0EAE146_gv_cM_Mengsk_WeaponPickerUppers[autoF22E961D_var], c_unitCountAlive) > 0)) {
                autoA2658E2A_g = libE0EAE146_gv_cM_Mengsk_WeaponPickups[autoF22E961D_var];
                autoA2658E2A_u = UnitGroupCount(autoA2658E2A_g, c_unitCountAll);
                for (;; autoA2658E2A_u -= 1) {
                    lv_pickup = UnitGroupUnitFromEnd(autoA2658E2A_g, autoA2658E2A_u);
                    if (lv_pickup == null) { break; }
                    lv_pickerupper = UnitGroupClosestToPoint(libE0EAE146_gv_cM_Mengsk_WeaponPickerUppers[autoF22E961D_var], UnitGetPosition(lv_pickup));
                    if ((UnitIsAlive(lv_pickerupper) == true) && (DistanceBetweenPoints(UnitGetPosition(lv_pickup), UnitGetPosition(lv_pickerupper)) <= 2.0)) {
                        autoFCCB9364_val = UnitGetType(lv_pickup);
                        if (autoFCCB9364_val == "TrooperMengskWeaponAAPickup") {
                            UnitCreateEffectUnit(lv_pickerupper, "TrooperMengskMorphAA", lv_pickerupper);
                            UnitBehaviorAdd(lv_pickerupper, "TrooperMengskWeaponAA", lv_pickerupper, 1);
                            UnitKill(lv_pickup);
                            UnitGroupRemove(libE0EAE146_gv_cM_Mengsk_WeaponPickerUppers[autoF22E961D_var], lv_pickerupper);
                            libNtve_gf_SendActorMessageToUnit(lv_pickerupper, "Signal ClearWeapon");
                            libNtve_gf_SendActorMessageToUnit(lv_pickerupper, "Signal SetWeaponAA");
                        }
                        else if (autoFCCB9364_val == "TrooperMengskWeaponFlamethrowerPickup") {
                            UnitCreateEffectUnit(lv_pickerupper, "TrooperMengskMorphFlamethrower", lv_pickerupper);
                            UnitBehaviorAdd(lv_pickerupper, "TrooperMengskWeaponFlamethrower", lv_pickerupper, 1);
                            UnitKill(lv_pickup);
                            UnitGroupRemove(libE0EAE146_gv_cM_Mengsk_WeaponPickerUppers[autoF22E961D_var], lv_pickerupper);
                            libNtve_gf_SendActorMessageToUnit(lv_pickerupper, "Signal ClearWeapon");
                            libNtve_gf_SendActorMessageToUnit(lv_pickerupper, "Signal SetWeaponFlamethrower");
                        }
                        else if (autoFCCB9364_val == "TrooperMengskWeaponImprovedPickup") {
                            UnitCreateEffectUnit(lv_pickerupper, "TrooperMengskMorphImproved", lv_pickerupper);
                            UnitBehaviorAdd(lv_pickerupper, "TrooperMengskWeaponImproved", lv_pickerupper, 1);
                            UnitKill(lv_pickup);
                            UnitGroupRemove(libE0EAE146_gv_cM_Mengsk_WeaponPickerUppers[autoF22E961D_var], lv_pickerupper);
                            libNtve_gf_SendActorMessageToUnit(lv_pickerupper, "Signal ClearWeapon");
                            libNtve_gf_SendActorMessageToUnit(lv_pickerupper, "Signal SetWeaponImproved");
                        }
                        else {
                            UnitGroupRemove(libE0EAE146_gv_cM_Mengsk_WeaponPickups[autoF22E961D_var], lv_pickup);
                        }
                    }

                    lv_pickerupper = null;
                }
            }

        }
    }
    return true;
}

