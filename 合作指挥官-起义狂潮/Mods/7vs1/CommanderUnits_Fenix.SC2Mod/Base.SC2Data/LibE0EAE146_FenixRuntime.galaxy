bool libE0EAE146_gv_fenixEnergyRegenInitialized = false;
trigger libE0EAE146_gt_FenixEnergyRegen;

void libE0EAE146_gf_FenixApplyEnergyRegenToType (int lp_player, string lp_unitType) {
    unitgroup lv_units;
    int lv_index;
    unit lv_unit;
    fixed lv_energy;
    fixed lv_energyMax;
    fixed lv_energyNext;

    if ((lp_unitType == "") || (!CatalogEntryIsValid(c_gameCatalogUnit, lp_unitType))) {
        return;
    }

    lv_units = UnitGroup(lp_unitType, lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_index = UnitGroupCount(lv_units, c_unitCountAlive);
    for (;; lv_index -= 1) {
        lv_unit = UnitGroupUnitFromEnd(lv_units, lv_index);
        if (lv_unit == null) { break; }

        lv_energy = UnitGetPropertyFixed(lv_unit, c_unitPropEnergy, c_unitPropCurrent);
        lv_energyMax = UnitGetPropertyFixed(lv_unit, c_unitPropEnergyMax, c_unitPropCurrent);
        if ((lv_energy < 1.0) && (lv_energyMax >= 1.0)) {
            UnitSetPropertyFixed(lv_unit, c_unitPropEnergy, 1.0);
            lv_energy = 1.0;
        }

        if ((lv_energy < lv_energyMax) && (lv_energyMax > 0.0)) {
            lv_energyNext = lv_energy + (2.0833 * ((TechTreeUpgradeCount(lp_player, "MasteryFenixSuitEnergyRegen", c_techCountCompleteOnly) / 100.0) + 1.0));
            if (lv_energyNext > lv_energyMax) {
                lv_energyNext = lv_energyMax;
            }
            UnitSetPropertyFixed(lv_unit, c_unitPropEnergy, lv_energyNext);
        }
    }
}

bool libE0EAE146_gt_FenixEnergyRegen_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }

    libE0EAE146_gf_FenixApplyEnergyRegenToType(1, "FenixCoop");
    libE0EAE146_gf_FenixApplyEnergyRegenToType(1, "FenixDragoon");
    libE0EAE146_gf_FenixApplyEnergyRegenToType(1, "FenixArbiter");
    return true;
}

void libE0EAE146_gf_FenixEnsureEnergyRegen (int lp_player) {
    if (libE0EAE146_gv_fenixEnergyRegenInitialized == true) {
        return;
    }

    libE0EAE146_gv_fenixEnergyRegenInitialized = true;
    libE0EAE146_gt_FenixEnergyRegen = TriggerCreate("libE0EAE146_gt_FenixEnergyRegen_Func");
    TriggerAddEventTimePeriodic(libE0EAE146_gt_FenixEnergyRegen, 1.0, c_timeGame);
}

void libE0EAE146_gf_FenixRuntimeInit (int lp_player, point lp_heroPoint, bool lp_createHero) {
    unit lv_caster;

    if (libE0EAE146_gv_fenixRuntimeInitialized == true) {
        return;
    }

    libE0EAE146_gv_fenixRuntimeInitialized = true;
    libE0EAE146_gf_ApplyTalents(lp_player, "ProtossFenix");
    if (libE0EAE146_gf_CommanderUsePrivateTechFilter("Fenix")) {
        libE0EAE146_gf_FenixApplyTechFilter(lp_player);
    }
    libE0EAE146_gf_FenixEnsureEnergyRegen(lp_player);

    libNtve_gf_CreateUnitsWithDefaultFacing(1, "SoACasterFenix", c_unitCreateIgnorePlacement, lp_player, RegionGetBoundsMin(RegionEntireMap()));
    lv_caster = UnitLastCreated();
    lib67C0F0E7_gf_CU_GPInit(lp_player, "Fenix", lv_caster, null);
    lib67C0F0E7_gf_CU_GPShowHide(true, lp_player, c_transitionDurationDefault);
    lib67C0F0E7_gf_ShowChooseButton();
    libE0EAE146_gf_CreateCommanderHeroStructure(lp_player, "Fenix");

    if (lp_createHero == true) {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "FenixCoop", 0, lp_player, lp_heroPoint);
        libE0EAE146_gf_FenixApplyEnergyRegenToType(lp_player, "FenixCoop");
    }

    TriggerExecute(libE0EAE146_gt_CM_Fenix_TriggersInit, true, false);
}

