// XMFinal split module: commander panel init and map start squads.
void libE0EAE146_gf_CommanderPanelInit (string lp_casterUnit, string lp_gpCommander) {
    libNtve_gf_CreateUnitsWithDefaultFacing(1, lp_casterUnit, c_unitCreateIgnorePlacement, 1, RegionGetBoundsMin(RegionEntireMap()));
    lib67C0F0E7_gf_CU_GPInit(1, lp_gpCommander, UnitLastCreated(), null);
    lib67C0F0E7_gf_CU_GPShowHide(true, 1, c_transitionDurationDefault);
    lib67C0F0E7_gf_ShowChooseButton();
}

void libE0EAE146_gf_RaynorCreateMapStartSquad (string lp_kind, int lp_player, point lp_point) {
    string lv_kind;
    lv_kind = lp_kind;
    if ((lv_kind == "light")) {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "RaynorCommando", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(3, "MarineRaynor", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "MedicRaynor", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "FirebatRaynor", 0, lp_player, lp_point);
    }
    else if ((lv_kind == "heavy")) {
        libNtve_gf_CreateUnitsWithDefaultFacing(3, "MarineRaynor", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "MarauderRaynor", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "FirebatRaynor", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "SiegeTankRaynor", 0, lp_player, lp_point);
    }
    else if ((lv_kind == "air")) {
        libNtve_gf_CreateUnitsWithDefaultFacing(2, "VikingRaynor", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "BansheeRaynor", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "BattlecruiserRaynor", 0, lp_player, lp_point);
    }
    else if ((lv_kind == "hero")) {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "RaynorCommando", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(3, "MarineRaynor", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "MedicRaynor", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "FirebatRaynor", 0, lp_player, lp_point);
    }
    else if ((lv_kind == "ultimate")) {
        if ((TechTreeUpgradeCount(1, "RaynorUnlockBattlecruiser", c_techCountCompleteOnly) > 0)) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "BattlecruiserRaynor", 0, lp_player, lp_point);
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "HyperionVoidCoop", 0, lp_player, lp_point);
        }
        else {
            libE0EAE146_gf_RaynorCreateMapStartSquad("heavy", lp_player, lp_point);
        }
    }
    else {
        libE0EAE146_gf_RaynorCreateMapStartSquad("light", lp_player, lp_point);
    }
}

void libE0EAE146_gf_RaynorCreateMapStartSquadInRegion (string lp_kind, int lp_player, region lp_region) {
    libE0EAE146_gf_RaynorCreateMapStartSquad(lp_kind, lp_player, RegionGetCenter(lp_region));
}

