            libNtve_gf_CreateUnitsWithDefaultFacing(2, lv_hydralisk, 0, lp_player, lp_point);
        }
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "QueenCoop", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "HotSTorrasque", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "MutaliskBroodlord", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "BroodLord", 0, lp_player, lp_point);
    }
    else if ((lv_kind == "full")) {
        libNtve_gf_CreateUnitsWithDefaultFacing(4, "HotSRaptor", 0, lp_player, lp_point);
        if ((lv_hydralisk != "")) {
            libNtve_gf_CreateUnitsWithDefaultFacing(2, lv_hydralisk, 0, lp_player, lp_point);
        }
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "QueenCoop", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "HotSTorrasque", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "MutaliskBroodlord", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "BroodLord", 0, lp_player, lp_point);
    }
    else if ((lv_kind == "air")) {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "MutaliskBroodlord", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "BroodLord", 0, lp_player, lp_point);
    }
    else if ((lv_kind == "hero")) {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "K5Kerrigan", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(3, "HotSRaptor", 0, lp_player, lp_point);
        if ((lv_hydralisk != "")) {
            libNtve_gf_CreateUnitsWithDefaultFacing(2, lv_hydralisk, 0, lp_player, lp_point);
        }
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "QueenCoop", 0, lp_player, lp_point);
    }
    else if ((lv_kind == "ultimate")) {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "HotSTorrasque", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(2, "Mutalisk", 0, lp_player, lp_point);
