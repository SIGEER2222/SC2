    lv_hydralisk = "";
    if (CatalogEntryIsValid(c_gameCatalogUnit, "HydraliskKerrigan")) {
        lv_hydralisk = "HydraliskKerrigan";
    }
    else if (CatalogEntryIsValid(c_gameCatalogUnit, "Hydralisk")) {
        lv_hydralisk = "Hydralisk";
    }
    if ((lv_kind == "light")) {
        libNtve_gf_CreateUnitsWithDefaultFacing(4, "HotSRaptor", 0, lp_player, lp_point);
