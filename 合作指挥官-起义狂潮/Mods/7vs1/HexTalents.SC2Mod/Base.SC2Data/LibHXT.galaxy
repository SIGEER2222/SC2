    lv_cmd = "ProtossKarax";
    // 巨像能对空：启用净化者巨像对空武器（直接应用升级，替代源 mod 的研究入口）
    if (libHXT_gf_TalentEnabled(lv_cmd, "HexKaraxColossusAir")) {
        TechTreeUpgradeAddLevel(lp_player, "TNX_colossus_atk_air", 1);
    }
    // 随心所欲：时空涌动 CD -60、消耗 +250/250（最多 4 层）
    lv_level = libHXT_gf_TalentValue(lv_cmd, "HexKaraxFreeChrono");
    if (lv_level > 4) {
        lv_level = 4;
    }
    lv_i = 0;
    while (lv_i < lv_level) {
        CatalogReferenceModify("Abil,SOAMapWideChrono,Cost[0].Cooldown.TimeUse", lp_player, "60", c_upgradeOperationSubtract);
        CatalogReferenceModify("Abil,SOAMapWideChrono,Cost[0].Resource[Minerals]", lp_player, "250", c_upgradeOperationAdd);
        CatalogReferenceModify("Abil,SOAMapWideChrono,Cost[0].Resource[Vespene]", lp_player, "250", c_upgradeOperationAdd);
        lv_i += 1;
    }
}

void libHXT_gf_ApplyFenixTalents (int lp_player) {
    string lv_cmd;

    lv_cmd = "ProtossFenix";
    // 近战增强：菲尼克斯（地面模式）护盾护甲 +5
    if (libHXT_gf_TalentEnabled(lv_cmd, "HexFenixMelee")) {
        CatalogReferenceModify("Unit,FenixCoop,ShieldArmor", lp_player, "5", c_upgradeOperationAdd);
    }
    // 远程增强：龙骑模式武器超载不再消耗资源
    if (libHXT_gf_TalentEnabled(lv_cmd, "HexFenixDragoon")) {
        CatalogReferenceModify("Abil,FenixDragoonArsenalOvercharge,Cost[0].Resource[Minerals]", lp_player, "0", c_upgradeOperationSet);
        CatalogReferenceModify("Abil,FenixDragoonArsenalOvercharge,Cost[0].Resource[Vespene]", lp_player, "0", c_upgradeOperationSet);
    }
    // 法术增强：仲裁者武器基础 +25，对英雄/建筑/召唤额外 +25
    if (libHXT_gf_TalentEnabled(lv_cmd, "HexFenixArbiter")) {
        CatalogReferenceModify("Effect,FenixArbiterWeaponDamage,Amount", lp_player, "25", c_upgradeOperationAdd);
        CatalogReferenceModify("Effect,FenixArbiterWeaponDamage,AttributeBonus[Heroic]", lp_player, "25", c_upgradeOperationAdd);
        CatalogReferenceModify("Effect,FenixArbiterWeaponDamage,AttributeBonus[Structure]", lp_player, "25", c_upgradeOperationAdd);
        CatalogReferenceModify("Effect,FenixArbiterWeaponDamage,AttributeBonus[Summoned]", lp_player, "25", c_upgradeOperationAdd);
    }
}

