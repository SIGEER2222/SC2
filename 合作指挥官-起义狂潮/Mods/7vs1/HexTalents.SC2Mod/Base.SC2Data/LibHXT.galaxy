void libHXT_gf_ApplyStetmannTalents (int lp_player) {
    string lv_cmd;

    lv_cmd = "ZergStetmann";
    // 卫星点灯：艾星矿物消耗 -25
    if (libHXT_gf_TalentEnabled(lv_cmd, "HexStetmannCheapSatellite")) {
        CatalogReferenceModify("Abil,DeployPowerTowerStetmann,InfoArray[Build1].Resource[Minerals]", lp_player, "25", c_upgradeOperationSubtract);
        if ((CatalogFieldValueGetAsInt(c_gameCatalogAbil, "DeployPowerTowerStetmann", ("Cost[" + IntToString(0) + "].Resource[" + IntToString(0) + "]"), lp_player) <= 0)) {
            CatalogReferenceModify("Abil,DeployPowerTowerStetmann,InfoArray[Build1].Resource[Minerals]", lp_player, "0", c_upgradeOperationSet);
        }
    }
    // 爆虫领主：机械巢式战列空母改射机械爆虫
    if (libHXT_gf_TalentEnabled(lv_cmd, "HexStetmannBanelingLord")) {
        TechTreeAbilityAllow(lp_player, AbilityCommand("BroodLordStetmannBroodlingEscortArmAugment", 0), false);
        TechTreeAbilityAllow(lp_player, AbilityCommand("BroodLordStetmannBroodlingEscortArm", 0), false);
        TechTreeAbilityAllow(lp_player, AbilityCommand("ZerglingStetmannRespawn", 0), false);
        TechTreeAbilityAllow(lp_player, AbilityCommand("BroodLordHangarStetmann", 1), true);
        TechTreeUpgradeAddLevel(lp_player, "TalentStetmannBanelingLord", 1);
    }
    // "艾"无限：艾星费用/充能翻倍，任意威望可变形超级盖瑞，能量场无限
    if (libHXT_gf_TalentEnabled(lv_cmd, "HexStetmannInfiniteGary")) {
        TechTreeUpgradeAddLevel(lp_player, "TNX_AinoGary", 1);
        TechTreeAbilityAllow(lp_player, AbilityCommand("MorphToSuperGaryStetmann", 0), true);
    }
}

