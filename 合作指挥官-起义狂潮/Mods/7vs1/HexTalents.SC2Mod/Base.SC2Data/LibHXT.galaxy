void libHXT_gf_ApplyHornerTalents (int lp_player) {
    string lv_cmd;

    lv_cmd = "TerranHorner";
    // 佣兵头头：佣兵晶矿消耗下降
    if (libHXT_gf_TalentEnabled(lv_cmd, "HexHornerCheapMercs")) {
        CatalogReferenceModify("Unit,HHHellionTank,CostResource[Minerals]", lp_player, "60", c_upgradeOperationSet);
        CatalogReferenceModify("Unit,HHHellion,CostResource[Minerals]", lp_player, "60", c_upgradeOperationSet);
        CatalogReferenceModify("Unit,HHReaper,CostResource[Minerals]", lp_player, "30", c_upgradeOperationSet);
        CatalogReferenceModify("Unit,HHWidowMine,CostResource[Minerals]", lp_player, "40", c_upgradeOperationSet);
        CatalogReferenceModify("Unit,HHMercStarportUpgraded,CostResource[Minerals]", lp_player, "120", c_upgradeOperationSet);
    }
    // 高炮放平：导弹塔可攻击地面
    if (libHXT_gf_TalentEnabled(lv_cmd, "HexHornerTurretGround")) {
        TechTreeUpgradeAddLevel(lp_player, "TNX_HornerTurentattackground", 1);
    }
    // 泰伦快乐船：至尊大和 +300，维京/怨灵 +150
    if (libHXT_gf_TalentEnabled(lv_cmd, "HexHornerHappyShips")) {
        CatalogReferenceModify("Unit,HHBattlecruiser,LifeMax", lp_player, "300", c_upgradeOperationAdd);
        CatalogReferenceModify("Unit,HHBattlecruiser,LifeStart", lp_player, "300", c_upgradeOperationAdd);
        CatalogReferenceModify("Unit,HHVikingAssault,LifeMax", lp_player, "150", c_upgradeOperationAdd);
        CatalogReferenceModify("Unit,HHVikingAssault,LifeStart", lp_player, "150", c_upgradeOperationAdd);
        CatalogReferenceModify("Unit,HHVikingFighter,LifeMax", lp_player, "150", c_upgradeOperationAdd);
        CatalogReferenceModify("Unit,HHVikingFighter,LifeStart", lp_player, "150", c_upgradeOperationAdd);
        CatalogReferenceModify("Unit,HHWraith,LifeStart", lp_player, "150", c_upgradeOperationAdd);
        CatalogReferenceModify("Unit,HHWraith,LifeMax", lp_player, "150", c_upgradeOperationAdd);
    }
    // 收割者小宝贝：收割者落地可对空，武器 +15
    if (libHXT_gf_TalentEnabled(lv_cmd, "HexHornerReaperAntiAir")) {
        TechTreeUpgradeAddLevel(lp_player, "TalentReaperAntiAir", 1);
    }
    // 量产型帝国舰队：星港充能 5s、上限 1，单位 -20% 价格
    if (libHXT_gf_TalentEnabled(lv_cmd, "HexHornerMassFleet")) {
        TechTreeUpgradeAddLevel(lp_player, "TNX_Horner_MassProduct", 1);
    }
}

