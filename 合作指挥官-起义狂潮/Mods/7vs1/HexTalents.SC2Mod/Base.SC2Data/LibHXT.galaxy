void libHXT_gf_ApplyKerriganTalents (int lp_player) {
    string lv_cmd;
    int lv_level;
    int lv_i;

    lv_cmd = "ZergKerrigan";
    // 就是干：连锁攻击伤害不衰减（每段 30）
    if (libHXT_gf_TalentEnabled(lv_cmd, "HexKerriganChainDamage")) {
        CatalogReferenceModify("Effect,ChainReaction2Damage,Amount", lp_player, "30", c_upgradeOperationSet);
        CatalogReferenceModify("Effect,ChainReaction3Damage,Amount", lp_player, "30", c_upgradeOperationSet);
        CatalogReferenceModify("Effect,ChainReaction4Damage,Amount", lp_player, "30", c_upgradeOperationSet);
        CatalogReferenceModify("Effect,ChainReaction5Damage,Amount", lp_player, "30", c_upgradeOperationSet);
    }
    // 怂：虫洞资源消耗 -25/25（最多 4 层）
    lv_level = libHXT_gf_TalentValue(lv_cmd, "HexKerriganCheapNydus");
    if (lv_level > 4) {
        lv_level = 4;
    }
    lv_i = 0;
    while (lv_i < lv_level) {
        CatalogReferenceModify("Abil,BuildNydusCanal,InfoArray[Build1].Resource[Minerals]", lp_player, "25", c_upgradeOperationSubtract);
        CatalogReferenceModify("Abil,BuildNydusCanal,InfoArray[Build1].Resource[Vespene]", lp_player, "25", c_upgradeOperationSubtract);
        lv_i += 1;
    }
    // 坑道虫爆爆乐：坑道虫欧米茄死亡引发核爆
    if (libHXT_gf_TalentEnabled(lv_cmd, "HexKerriganNydusNuke")) {
        TechTreeUpgradeAddLevel(lp_player, "KerriganBomb", 1);
    }
}

