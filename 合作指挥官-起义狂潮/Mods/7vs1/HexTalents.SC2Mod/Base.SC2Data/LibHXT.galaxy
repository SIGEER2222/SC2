void libHXT_gf_ApplyStukovTalents (int lp_player) {
    string lv_cmd;
    int lv_level;
    int lv_i;

    lv_cmd = "ZergStukov";
    // 草船借箭：被感染的平民生命 +80
    if (libHXT_gf_TalentEnabled(lv_cmd, "HexStukovCivilians")) {
        CatalogReferenceModify("Unit,SIInfestedCivilian,LifeMax", lp_player, "80", c_upgradeOperationAdd);
        CatalogReferenceModify("Unit,SIInfestedCivilian,LifeStart", lp_player, "80", c_upgradeOperationAdd);
    }
    // 隐形女妖屠龙：感染女妖对轻甲 +6
    if (libHXT_gf_TalentEnabled(lv_cmd, "HexStukovBanshee")) {
        CatalogReferenceModify("Effect,StukovInfestedBacklashRocketsDamage,AttributeBonus[Light]", lp_player, "6", c_upgradeOperationAdd);
    }
    // 末日维护者：限时单位强化；前 3 层同时把存在时间减半（A），之后仅数值强化（B）
    lv_level = libHXT_gf_TalentValue(lv_cmd, "HexStukovTimedLife");
    lv_i = 0;
    while (lv_i < lv_level) {
        if (TechTreeUpgradeCount(lp_player, "TalentStukovTimedLifeA", c_techCountCompleteOnly) <= 2) {
            TechTreeUpgradeAddLevel(lp_player, "TalentStukovTimedLifeA", 1);
        }
        else {
            TechTreeUpgradeAddLevel(lp_player, "TalentStukovTimedLifeB", 1);
        }
        lv_i += 1;
    }
}

