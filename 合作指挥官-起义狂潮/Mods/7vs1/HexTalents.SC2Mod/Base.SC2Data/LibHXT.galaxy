void libHXT_gf_ApplyCommanderTalents (int lp_player, string lp_commander) {
    if (lp_commander == "TerranRaynor") {
        libHXT_gf_ApplyRaynorTalents(lp_player);
    }
    else if (lp_commander == "TerranSwann") {
        libHXT_gf_ApplySwannTalents(lp_player);
    }
    else if (lp_commander == "TerranNova") {
        libHXT_gf_ApplyNovaTalents(lp_player);
    }
    else if (lp_commander == "TerranHorner") {
        libHXT_gf_ApplyHornerTalents(lp_player);
    }
    else if (lp_commander == "TerranTychus") {
        libHXT_gf_ApplyTychusTalents(lp_player);
    }
    else if (lp_commander == "TerranMengsk") {
        libHXT_gf_ApplyMengskTalents(lp_player);
    }
    else if (lp_commander == "ZergKerrigan") {
        libHXT_gf_ApplyKerriganTalents(lp_player);
    }
    else if (lp_commander == "ZergZagara") {
        libHXT_gf_ApplyZagaraTalents(lp_player);
    }
    else if (lp_commander == "ZergAbathur") {
        libHXT_gf_ApplyAbathurTalents(lp_player);
    }
    else if (lp_commander == "ZergStukov") {
        libHXT_gf_ApplyStukovTalents(lp_player);
    }
    else if (lp_commander == "ZergDehaka") {
        libHXT_gf_ApplyDehakaTalents(lp_player);
    }
    else if (lp_commander == "ZergStetmann") {
        libHXT_gf_ApplyStetmannTalents(lp_player);
    }
    else if (lp_commander == "ProtossArtanis") {
        libHXT_gf_ApplyArtanisTalents(lp_player);
    }
    else if (lp_commander == "ProtossAlarak") {
        libHXT_gf_ApplyAlarakTalents(lp_player);
    }
    else if (lp_commander == "ProtossKarax") {
        libHXT_gf_ApplyKaraxTalents(lp_player);
    }
    else if (lp_commander == "ProtossFenix") {
        libHXT_gf_ApplyFenixTalents(lp_player);
    }
    else if (lp_commander == "ProtossVorazun") {
        libHXT_gf_ApplyVorazunTalents(lp_player);
    }
    else if (lp_commander == "ProtossZeratul") {
        libHXT_gf_ApplyZeratulTalents(lp_player);
    }
    // 其余指挥官（Izsha/RaynorX/AbathurReborn/TestZerg/Alenger3 等）暂无专属海克斯天赋
}

//--------------------------------------------------------------------------------------------------
// 初始化入口
//--------------------------------------------------------------------------------------------------
void libHXT_InitHexTalents () {
    int lv_player;
    string lv_commander;

    if (libHXT_gv_initialized == true) {
        return;
    }
    libHXT_gv_initialized = true;

    libHXT_gv_bank = BankLoad("CampaignXCore", 1);

    libHXT_gt_UnitCreated = TriggerCreate("libHXT_gt_UnitCreated_Func");
    TriggerAddEventUnitCreated(libHXT_gt_UnitCreated, null, null, null);

    lv_player = 1;
    while (lv_player <= libHXT_c_maxPlayers) {
        libHXT_gv_commander[lv_player] = "";
        libHXT_gv_hasBuffTalents[lv_player] = false;
        libHXT_gv_spellRangeBonus[lv_player] = 0;
        libHXT_gv_shrinkLevel[lv_player] = 0;
        if ((PlayerStatus(lv_player) == c_playerStatusActive) && (PlayerType(lv_player) == c_playerTypeUser)) {
            lv_commander = libHXT_gf_CommanderForPlayer(lv_player);
            libHXT_gv_commander[lv_player] = lv_commander;
            libHXT_gf_ApplyCommonTalents(lv_player);
            libHXT_gf_ApplyCommanderTalents(lv_player, lv_commander);
            libHXT_gf_ApplyToExistingUnits(lv_player);
        }
        lv_player += 1;
    }
}

void libHXT_InitLib () {
    libHXT_InitHexTalents();
}
