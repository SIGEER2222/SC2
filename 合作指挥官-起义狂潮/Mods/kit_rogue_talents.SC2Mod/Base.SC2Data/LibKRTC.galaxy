        libNtve_gf_CatalogReferenceSetAsReal("Behavior,RogueUniversalUnitBuff,Modification.TimeScale", 1, 1.0);
        libNtve_gf_CatalogReferenceSetAsReal("Behavior,RogueUniversalBuildingBuff,Modification.TimeScale", 1, 1.0);
        TriggerEnable(TriggerGetCurrent(), false);
    }
    else {
        libKRTC_gv_talentCelerityCount -= 1;
        libNtve_gf_CatalogReferenceSetAsReal("Behavior,RogueUniversalUnitBuff,Modification.TimeScale", 1, ((libKRTC_gv_talentCelerityCount * 0.005) + 1.0));
        libNtve_gf_CatalogReferenceSetAsReal("Behavior,RogueUniversalBuildingBuff,Modification.TimeScale", 1, ((libKRTC_gv_talentCelerityCount * 0.005) + 1.0));
    }
    return true;
}

