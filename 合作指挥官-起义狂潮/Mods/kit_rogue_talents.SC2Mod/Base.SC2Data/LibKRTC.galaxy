    if (!runActions) {
        return true;
    }

    if ((libWoLC_gf_CurrentMap() == "TStory01")) {
        return true;
    }

    lv_mAX = UserDataInstanceCount("RogueTalents");
    auto9C691FC2_ae = lv_mAX;
    auto9C691FC2_var = 1;
    for ( ; auto9C691FC2_var <= auto9C691FC2_ae; auto9C691FC2_var += 1 ) {
        if ((UserDataGetInt("RogueTalents", UserDataInstance("RogueTalents", auto9C691FC2_var), "Acquired", 1) == 0) && (UserDataGetString("RogueTalents", UserDataInstance("RogueTalents", auto9C691FC2_var), "Type", 1) == "Special")) {
            lv_failsave = 1;
            break;
        }

    }
    if ((lv_failsave == 0)) {
        return true;
    }

    while ((lv_failsave < 100000)) {
        lv_rand = RandomInt(1, lv_mAX);
        if ((UserDataGetInt("RogueTalents", UserDataInstance("RogueTalents", lv_rand), "Acquired", 1) == 0) && (UserDataGetString("RogueTalents", UserDataInstance("RogueTalents", lv_rand), "Type", 1) == "Special")) {
            UserDataSetInt("RogueTalents", UserDataInstance("RogueTalents", lv_rand), "Acquired", 1, (UserDataGetInt("RogueTalents", UserDataInstance("RogueTalents", lv_rand), "Acquired", 1) + 1));
            libKRTC_gf_TalentEventCoordinator(lv_rand);
            libKRTC_gf_TalentAppliedEvents();
            Wait(1.0, c_timeAI);
            libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, TextWithColor((StringExternal("Param/Value/lib_KRTC_D87C004B") + UserDataGetText("RogueTalents", UserDataInstance("RogueTalents", lv_rand), "NameStr", 1) + StringExternal("Param/Value/lib_KRTC_B1142563")), Color(100.00, 80.00, 0.00)));
            TriggerExecute(libKRTC_gt_AchievementPickEvents, true, false);
            return true;
        }
        else {
            lv_failsave += 1;
        }
    }
    return true;
}

