bool libKRTC_gt_DruidSummonUnits_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitHasBehavior2(EventPlayerEffectUsedUnit(c_effectUnitTarget), "HydraliskProduction") == true)) {
        libKRTC_gf_DruidBuyUnit(libKRTC_ge_DruidUnits_Hydralisk, EventPlayerEffectUsedUnit(c_effectUnitTarget));
    }

    if ((UnitHasBehavior2(EventPlayerEffectUsedUnit(c_effectUnitTarget), "MutaliskProduction") == true)) {
        libKRTC_gf_DruidBuyUnit(libKRTC_ge_DruidUnits_Mutalisk, EventPlayerEffectUsedUnit(c_effectUnitTarget));
    }

    if ((UnitHasBehavior2(EventPlayerEffectUsedUnit(c_effectUnitTarget), "RoachProduction") == true)) {
        libKRTC_gf_DruidBuyUnit(libKRTC_ge_DruidUnits_Roach, EventPlayerEffectUsedUnit(c_effectUnitTarget));
    }

    if ((UnitHasBehavior2(EventPlayerEffectUsedUnit(c_effectUnitTarget), "SwarmHostProduction") == true)) {
        libKRTC_gf_DruidBuyUnit(libKRTC_ge_DruidUnits_SwarmHost, EventPlayerEffectUsedUnit(c_effectUnitTarget));
    }

    if ((UnitHasBehavior2(EventPlayerEffectUsedUnit(c_effectUnitTarget), "UltraliskProduction") == true)) {
        libKRTC_gf_DruidBuyUnit(libKRTC_ge_DruidUnits_Ultralisk, EventPlayerEffectUsedUnit(c_effectUnitTarget));
    }

    if ((UnitHasBehavior2(EventPlayerEffectUsedUnit(c_effectUnitTarget), "ZerglingProduction") == true)) {
        libKRTC_gf_DruidBuyUnit(libKRTC_ge_DruidUnits_Zergling, EventPlayerEffectUsedUnit(c_effectUnitTarget));
    }

    return true;
}

