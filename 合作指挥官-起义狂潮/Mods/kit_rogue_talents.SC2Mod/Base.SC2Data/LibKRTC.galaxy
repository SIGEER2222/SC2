//--------------------------------------------------------------------------------------------------
bool libKRTC_gt_RogueInit_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    AchievementsDisable(1);
    libKRTC_gf_LoadRogueBank();
    if ((libWoLC_gf_CurrentMap() != "TStory01")) {
        libKRTC_gv_rogueRerolls += 1;
        libKRTC_gv_rogueBans += 1;
        if ((libKRTC_gf_TalentAcquired("DummyMulticlassSide") == true)) {
            libKRTC_gv_rogueRerolls += 1;
            libKRTC_gv_rogueBans += 1;
        }

        if ((libKRTC_gf_TalentAcquired("DummyAcolyteOracle") == true)) {
            if ((RandomInt(1, 2) == 1)) {
                libKRTC_gv_rogueRerolls += 1;
            }
            else {
                libKRTC_gv_rogueBans += 1;
            }
        }

    }

    return true;
}

