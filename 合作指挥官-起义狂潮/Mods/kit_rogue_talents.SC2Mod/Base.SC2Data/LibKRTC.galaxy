//--------------------------------------------------------------------------------------------------
// Trigger: Talent Monk Powerbuild
//--------------------------------------------------------------------------------------------------
bool libKRTC_gt_TalentMonkPowerbuild_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    while (!((UnitGroupCount(UnitGroup(null, 1, RegionPlayableMap(), UnitFilter((1 << c_targetFilterGround) | (1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) >= 1))) {
        Wait(1.0, c_timeAI);
    }
    Wait(0.25, c_timeAI);
    UnitIssueOrder(libKRTC_gv_rogueTopbar, Order(AbilityCommand("MonkMainBuff2", 0)), c_orderQueueReplace);
    if ((TechTreeUpgradeCount(1, "MonkBuffAttackspeed22", c_techCountCompleteOnly) > 0)) {
        GameSetSpeedValue(c_gameSpeedSlower);
    }
    else {
        if ((TechTreeUpgradeCount(1, "MonkBuffAttackspeed2", c_techCountCompleteOnly) > 0)) {
            GameSetSpeedValue(c_gameSpeedSlow);
        }
        else {
            if ((TechTreeUpgradeCount(1, "MonkBuffAttackspeed", c_techCountCompleteOnly) > 0)) {
                GameSetSpeedValue(c_gameSpeedNormal);
            }
            else {
                GameSetSpeedValue(c_gameSpeedFast);
            }
        }
    }
    while (!((UnitHasBehavior2(libKRTC_gv_rogueTopbar, "WindstepManeuver62") == false))) {
        Wait(0.13, c_timeGame);
    }
    if ((UnitHasBehavior2(libKRTC_gv_rogueTopbar, "WindstepManeuver6") == false)) {
        GameSetSpeedValue(c_gameSpeedFaster);
    }

    return true;
}

