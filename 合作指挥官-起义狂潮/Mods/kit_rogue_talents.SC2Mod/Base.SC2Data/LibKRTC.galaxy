//--------------------------------------------------------------------------------------------------
// Trigger: MG Chrono Blink
//--------------------------------------------------------------------------------------------------
bool libKRTC_gt_MGChronoBlink_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_unit;
    point lv_target;
    fixed lv_distance;
    int lv_unitOwner;
    unitgroup lv_recallGroup;
    unit lv_recallUnit;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_recallGroup = UnitGroupEmpty();

    // Actions
    if (!runActions) {
        return true;
    }

    lv_unit = EventUnit();
    lv_target = UnitTypePlacementFromPoint("Reaper", 1, EventUnitTargetPoint(), 10.0);
    lv_distance = DistanceBetweenPoints(UnitGetPosition(lv_unit), lv_target);
    UnitBehaviorAdd(lv_unit, "MGChronoRecallBlink", lv_unit, 1);
    Wait(0.0675, c_timeGame);
    Wait(RandomFixed(0.02, 0.01), c_timeGame);
    UnitSetPosition(lv_unit, lv_target, false);
    UnitBehaviorAdd(lv_unit, "MGChronoBlink", lv_unit, 1);
    Wait(0.0675, c_timeGame);
    UnitBehaviorSetDuration(lv_unit, "MGChronoBlink", (UnitBehaviorDuration(lv_unit, "MGChronoBlink") + 0.0675));
    UnitBehaviorSetDuration(lv_unit, "MGChronoBlink", (UnitBehaviorDuration(lv_unit, "MGChronoBlink") * lv_distance));
    UnitBehaviorRemove(lv_unit, "MGChronoRecallBlink", 1);
    return true;
}

//--------------------------------------------------------------------------------------------------
void libKRTC_gt_MGChronoBlink_Init () {
    libKRTC_gt_MGChronoBlink = TriggerCreate("libKRTC_gt_MGChronoBlink_Func");
    TriggerEnable(libKRTC_gt_MGChronoBlink, false);
    TriggerAddEventUnitAbility(libKRTC_gt_MGChronoBlink, null, AbilityCommand("MGChronoBlink", 0), c_unitAbilStageComplete, false);
    TriggerAddEventUnitAbility(libKRTC_gt_MGChronoBlink, null, AbilityCommand("MGChronoBlinkWarlock", 0), c_unitAbilStageComplete, false);
}

//--------------------------------------------------------------------------------------------------
// Trigger: MG Deja Vu
//--------------------------------------------------------------------------------------------------
bool libKRTC_gt_MGDejaVu_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_unit;
    string lv_unitType;
    int lv_unitOwner;
    fixed[4] lv_unitVitals;
    point lv_unitPosition;
    fixed lv_unitFacing;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    lv_unit = EventUnit();
    lv_unitType = UnitGetType(lv_unit);
    lv_unitOwner = UnitGetOwner(lv_unit);
    lv_unitVitals[1] = UnitGetPropertyFixed(lv_unit, c_unitPropLifePercent, c_unitPropCurrent);
    lv_unitVitals[2] = UnitGetPropertyFixed(lv_unit, c_unitPropShieldsPercent, c_unitPropCurrent);
    lv_unitVitals[3] = UnitGetPropertyFixed(lv_unit, c_unitPropEnergyPercent, c_unitPropCurrent);
    lv_unitPosition = UnitGetPosition(lv_unit);
    lv_unitFacing = UnitGetFacing(lv_unit);
    UnitBehaviorRemove(lv_unit, "MGDejaVuPrecursor", 1);
    UnitBehaviorAdd(lv_unit, "MGDejaVu", lv_unit, 1);
    Wait(30.0, c_timeAI);
    if ((UnitIsAlive(lv_unit) == true) && (UnitGetOwner(lv_unit) == lv_unitOwner) && (UnitGetType(lv_unit) == lv_unitType)) {
        UnitSetPosition(lv_unit, lv_unitPosition, false);
        UnitSetFacing(lv_unit, lv_unitFacing, 0.1);
        UnitBehaviorRemove(lv_unit, "MGDejaVu", 1);
    }
    else {
        UnitRemove(lv_unit);
        UnitCreate(1, lv_unitType, 0, lv_unitOwner, lv_unitPosition, lv_unitFacing);
        lv_unit = UnitLastCreated();
    }
    UnitSetPropertyFixed(lv_unit, c_unitPropLifePercent, lv_unitVitals[1]);
    UnitSetPropertyFixed(lv_unit, c_unitPropShieldsPercent, lv_unitVitals[2]);
    UnitSetPropertyFixed(lv_unit, c_unitPropEnergyPercent, lv_unitVitals[3]);
    AISetUnitScriptControlled(lv_unit, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void libKRTC_gt_MGDejaVu_Init () {
    libKRTC_gt_MGDejaVu = TriggerCreate("libKRTC_gt_MGDejaVu_Func");
    TriggerEnable(libKRTC_gt_MGDejaVu, false);
    TriggerAddEventUnitBehaviorChange(libKRTC_gt_MGDejaVu, null, "MGDejaVuPrecursor", c_unitBehaviorChangeCreate);
}

//--------------------------------------------------------------------------------------------------
// Trigger: MG Devolution
//--------------------------------------------------------------------------------------------------
bool libKRTC_gt_MGDevolution_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_unit;
    int lv_iD;
    int lv_tier;
    int lv_air;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    lv_unit = EventUnit();
    lv_iD = libKRTC_gf_RandomizerGetID(UnitGetType(lv_unit));
    lv_tier = UserDataGetInt("RandomizerTable", UserDataInstance("RandomizerTable", lv_iD), "Tier", 1);
    lv_air = UserDataGetInt("RandomizerTable", UserDataInstance("RandomizerTable", lv_iD), "Air", 1);
    if ((lv_tier < 1)) {
        return true;
    }

    lv_tier -= 1;
    lv_iD = libKRTC_gf_RandomizerGenerateForEnemy(lv_tier, lv_air);
    libNtve_gf_ReplaceUnit(lv_unit, UserDataGetUnit("RandomizerTable", UserDataInstance("RandomizerTable", lv_iD), "Unit", 1), libNtve_ge_ReplaceUnitOptions_OldUnitsRelative);
    if ((UnitGetOwner(libNtve_gf_LastReplacedUnit()) != 1)) {
        AISetUnitSuicide(libNtve_gf_LastReplacedUnit(), true);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void libKRTC_gt_MGDevolution_Init () {
    libKRTC_gt_MGDevolution = TriggerCreate("libKRTC_gt_MGDevolution_Func");
    TriggerEnable(libKRTC_gt_MGDevolution, false);
    TriggerAddEventUnitBehaviorChange(libKRTC_gt_MGDevolution, null, "MGDevolutionBeam", c_unitBehaviorChangeCreate);
}

//--------------------------------------------------------------------------------------------------
// Trigger: MG Magnetron
//--------------------------------------------------------------------------------------------------
bool libKRTC_gt_MGMagnetron_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_movedUnit;
    unit lv_dummyUnit;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    lv_movedUnit = EventUnitTargetUnit();
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "Observer", 0, 0, UnitGetPosition(lv_movedUnit));
    lv_dummyUnit = UnitLastCreated();
    UnitSetState(lv_dummyUnit, c_unitStateDetectable, false);
    libNtve_gf_ShowHideUnit(lv_dummyUnit, false);
    Wait(0.2, c_timeGame);
    while (true) {
        if ((UnitHasBehavior2(lv_movedUnit, "MagnetHeight") == false)) {
            UnitRemove(lv_dummyUnit);
            break;
        }
        else {
            UnitSetPosition(lv_dummyUnit, libNtve_gf_PointOffsetTowardsPoint(UnitGetPosition(lv_dummyUnit), 0.1, UnitGetPosition(EventUnit())), false);
            Wait(0.04, c_timeGame);
            UnitSetPosition(lv_movedUnit, UnitGetPosition(lv_dummyUnit), true);
        }
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void libKRTC_gt_MGMagnetron_Init () {
    libKRTC_gt_MGMagnetron = TriggerCreate("libKRTC_gt_MGMagnetron_Func");
    TriggerEnable(libKRTC_gt_MGMagnetron, false);
    TriggerAddEventUnitAbility(libKRTC_gt_MGMagnetron, null, AbilityCommand("MagneticBeam", 0), c_unitAbilStageExecute, false);
}

//--------------------------------------------------------------------------------------------------
// Trigger: MG Moebius Loop
//--------------------------------------------------------------------------------------------------
bool libKRTC_gt_MGMoebiusLoop_Func (bool testConds, bool runActions) {
