    TriggerEnable(libKRTC_gt_TalentSpecialNovaDeath, false);
    TriggerAddEventUnitDied(libKRTC_gt_TalentSpecialNovaDeath, null);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Talent Special Tosh
//--------------------------------------------------------------------------------------------------
bool libKRTC_gt_TalentSpecialTosh_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_tosh;
    int lv_teleportCD;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    while (!((UnitGroupCount(UnitGroup(null, 1, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) >= 1))) {
        Wait(1.0, c_timeAI);
    }
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "Tosh", 0, 1, UnitGetPosition(UnitGroupRandomUnit(UnitGroup(null, 1, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive)));
    lv_tosh = UnitLastCreated();
    UnitBehaviorAdd(lv_tosh, "ToshRogue", lv_tosh, 1);
    while (true) {
        if ((UnitIsAlive(lv_tosh) == false)) {
            return true;
        }

        if ((lv_teleportCD < 30)) {
            lv_teleportCD += 1;
        }
        else {
            if (((VisIsVisibleForPlayer(1, UnitGetPosition(lv_tosh)) == false) || ((DistanceBetweenPoints(UnitGetPosition(lv_tosh), CameraGetTarget(1)) > 30.0) && (UnitGroupCount(UnitGroup(null, 1, RegionCircle(CameraGetTarget(1), 12.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) > 2) && (UnitGroupCount(UnitGroupAlliance(1, c_unitAllianceEnemy, RegionCircle(CameraGetTarget(1), 12.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) > 2)))) {
                UnitSetPosition(lv_tosh, UnitTypePlacementFromPoint("Tosh", 1, CameraGetTarget(1), 12.0), false);
            }

        }
        UnitIssueOrder(lv_tosh, OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(UnitGroupClosestToPoint(UnitGroupAlliance(1, c_unitAllianceEnemy, RegionEntireMap(), UnitFilter((1 << c_targetFilterVisible), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32)) | (1 << (c_targetFilterMapBoss - 32))), 0), CameraGetTarget(1)))), c_orderQueueReplace);
        Wait(2.0, c_timeAI);
    }
    return true;
}

