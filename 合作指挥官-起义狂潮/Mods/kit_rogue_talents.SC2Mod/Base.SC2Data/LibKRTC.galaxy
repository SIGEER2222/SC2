//--------------------------------------------------------------------------------------------------
// Trigger: sahnghaisanshe
//--------------------------------------------------------------------------------------------------
bool libKRTC_gt_sahnghaisanshe_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_uNIT;
    unit lv_uNIT2;
    fixed lv_hurtamount;
    int lv_unitamount;
    unitgroup lv_unitgroup;

    // Automatic Variable Declarations
    unitgroup autoF6E7C1C7_g;
    int autoF6E7C1C7_u;
    unit autoF6E7C1C7_var;

    // Variable Initialization
    lv_uNIT = EventUnit();
    lv_uNIT2 = EventUnitDamageSourceUnit();
    lv_unitgroup = UnitGroupEmpty();

    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == 1))) {
            return false;
        }

        if (!((UnitHasBehavior2(EventUnit(), "RogueUniversalBuildingBuff") == false))) {
            return false;
        }

        if (!((UnitGetPropertyFixed(EventUnit(), c_unitPropLifePercent, c_unitPropCurrent) <= 40.0))) {
            return false;
        }

        if (!((EventUnitDamageAbsorbed() < UnitGetPropertyFixed(EventUnit(), c_unitPropLife, c_unitPropCurrent)))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_hurtamount = EventUnitDamageAbsorbed();
    lv_unitgroup = UnitGroup(null, 1, RegionCircle(UnitGetPosition(EventUnit()), 4.0), UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))), 0);
    lv_unitamount = UnitGroupCount(lv_unitgroup, c_unitCountAlive);
    if ((lv_unitamount > 1)) {
        if ((UnitGetPropertyFixed(lv_uNIT, c_unitPropShields, c_unitPropCurrent) > 0.0)) {
            UnitSetPropertyFixed(lv_uNIT, c_unitPropShields, (UnitGetPropertyFixed(lv_uNIT, c_unitPropShields, c_unitPropCurrent) + lv_hurtamount));
        }
        else {
            if ((UnitGetPropertyFixed(lv_uNIT, c_unitPropEnergy, c_unitPropCurrent) > 0.0) && (libKRTC_gf_TalentAcquired("WizardEnergyLeech") == true) && (UnitGetPropertyFixed(lv_uNIT, c_unitPropLifePercent, c_unitPropCurrent) <= 40.0)) {
                UnitSetPropertyFixed(lv_uNIT, c_unitPropEnergy, (UnitGetPropertyFixed(lv_uNIT, c_unitPropEnergy, c_unitPropCurrent) + lv_hurtamount));
            }
            else {
                UnitSetPropertyFixed(lv_uNIT, c_unitPropLife, (UnitGetPropertyFixed(lv_uNIT, c_unitPropLife, c_unitPropCurrent) + lv_hurtamount));
            }
        }
        autoF6E7C1C7_g = lv_unitgroup;
        autoF6E7C1C7_u = UnitGroupCount(autoF6E7C1C7_g, c_unitCountAll);
        for (;; autoF6E7C1C7_u -= 1) {
            autoF6E7C1C7_var = UnitGroupUnitFromEnd(autoF6E7C1C7_g, autoF6E7C1C7_u);
            if (autoF6E7C1C7_var == null) { break; }
            UnitDamage(lv_uNIT2, "AetherMawAetherStormDummyWeaponDamage2", autoF6E7C1C7_var, (lv_hurtamount / lv_unitamount));
        }
    }

    return true;
}

