//--------------------------------------------------------------------------------------------------
// Trigger: Talent Hunter pay
//--------------------------------------------------------------------------------------------------
bool libKRTC_gt_TalentHunterpay_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(libNtve_gf_KillingUnit()) == 1))) {
            return false;
        }

        if (!((UnitBehaviorCount(libNtve_gf_KillingUnit(), "RogueUniversalMercBuff") > 0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitTypeTestAttribute(UnitGetType(EventUnit()), c_unitAttributeStructure) == true)) {
        PlayerModifyPropertyInt(1, c_playerPropMinerals, c_playerPropOperSubtract, 100);
        PlayerModifyPropertyInt(1, c_playerPropVespene, c_playerPropOperSubtract, 50);
    }
    else {
        PlayerModifyPropertyInt(1, c_playerPropMinerals, c_playerPropOperSubtract, (10 * FixedToInt(UnitTypeGetProperty(UnitGetType(EventUnit()), c_unitPropSuppliesUsed))));
        PlayerModifyPropertyInt(1, c_playerPropVespene, c_playerPropOperSubtract, (3 * FixedToInt(UnitTypeGetProperty(UnitGetType(EventUnit()), c_unitPropSuppliesUsed))));
    }
    return true;
}

