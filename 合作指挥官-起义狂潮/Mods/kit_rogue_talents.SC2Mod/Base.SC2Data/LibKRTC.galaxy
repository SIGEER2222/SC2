//--------------------------------------------------------------------------------------------------
// Trigger: Talent Special Jormungand
//--------------------------------------------------------------------------------------------------
bool libKRTC_gt_TalentSpecialJormungand_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_jorm;
    int lv_jormPing;
    unitgroup lv_spawnUnits;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_jormPing = c_invalidPingId;
    lv_spawnUnits = UnitGroupEmpty();

    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == 1))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    lv_spawnUnits = UnitGroupAlliance(1, c_unitAllianceEnemy, RegionPlayableMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    if ((UnitGroupCount(lv_spawnUnits, c_unitCountAlive) == 0)) {
        return true;
    }

    UnitCreate(1, "Jormungand", 0, libKRTC_gv_enemyPlayer, UnitGetPosition(UnitGroupRandomUnit(lv_spawnUnits, c_unitCountAlive)), libNtve_gf_RandomAngle());
    lv_jorm = UnitLastCreated();
    libNtve_gf_CreatePingFacingAngle(PlayerGroupAll(), "PingBoss", UnitGetPosition(lv_jorm), ColorWithAlpha(0.00, 0.00, 0.00, 0.00), 0.0, 270.0);
    lv_jormPing = PingLastCreated();
    PingSetUnit(lv_jormPing, lv_jorm);
    libNtve_gf_ShareVisionofUnit(lv_jorm, true, 1);
    AISetUnitSuicide(lv_jorm, true);
    while (!((UnitGetPropertyFixed(lv_jorm, c_unitPropLifePercent, c_unitPropCurrent) < 25.0))) {
        Wait(0.5, c_timeAI);
    }
    SoundPlayForPlayer(SoundLink("Jorm_Ready", -1), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
    libNtve_gf_RescueUnit(lv_jorm, 1, true);
    UnitFlashSelection(lv_jorm, 1.5);
    UnitGroupAdd(libKRTC_gv_paladinGroup, lv_jorm);
    PingDestroy(lv_jormPing);
    return true;
}

