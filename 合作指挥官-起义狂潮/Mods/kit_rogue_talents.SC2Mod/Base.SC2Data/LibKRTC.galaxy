                    for (;; auto091AAE44_u -= 1) {
                        auto091AAE44_var = UnitGroupUnitFromEnd(auto091AAE44_g, auto091AAE44_u);
                        if (auto091AAE44_var == null) { break; }
                        if ((DistanceBetweenPoints(UnitGetPosition(auto091AAE44_var), UnitGetPosition(libKRTC_gv_bardSquads[lv_iD].lv_beacon)) > 4.0)) {
                            UnitIssueOrder(auto091AAE44_var, OrderTargetingPoint(AbilityCommand("attack", 0), RegionRandomPoint(RegionCircle(UnitGetPosition(libKRTC_gv_bardSquads[lv_iD].lv_beacon), 3.0))), c_orderQueueReplace);
                        }

                    }
                }
                if ((libKRTC_gv_bardSquads[lv_iD].lv_state == libKRTC_ge_BardSquadStates_Attack)) {
                    auto21F335D0_g = libKRTC_gv_bardSquads[lv_iD].lv_squadUnits;
                    auto21F335D0_u = UnitGroupCount(auto21F335D0_g, c_unitCountAll);
                    for (;; auto21F335D0_u -= 1) {
                        auto21F335D0_var = UnitGroupUnitFromEnd(auto21F335D0_g, auto21F335D0_u);
                        if (auto21F335D0_var == null) { break; }
                        if ((DistanceBetweenPoints(UnitGetPosition(auto21F335D0_var), UnitGroupCenterOfGroup(UnitGroupFilter(null, c_playerAny, libKRTC_gv_bardSquads[lv_iD].lv_squadUnits, UnitFilter((1 << c_targetFilterGround), 0, (1 << c_targetFilterAir) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0))) >= 8.0)) {
                            UnitGroupIssueOrder(libKRTC_gv_bardSquads[lv_iD].lv_squadUnits, OrderTargetingPoint(AbilityCommand("move", 0), UnitGroupCenterOfGroup(UnitGroupFilter(null, c_playerAny, libKRTC_gv_bardSquads[lv_iD].lv_squadUnits, UnitFilter((1 << c_targetFilterGround), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0))), c_orderQueueReplace);
                        }

                    }
                }

            }
            else {
                if ((libKRTC_gv_bardSquads[lv_iD].lv_state == libKRTC_ge_BardSquadStates_Attack)) {
                    libKRTC_gf_BardChangeState(lv_iD, libKRTC_ge_BardSquadStates_None, null, null);
                }

            }
        }

    }
    return true;
}

