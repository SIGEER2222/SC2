//--------------------------------------------------------------------------------------------------
// Trigger: Talent Necromancer Summon Infested
//--------------------------------------------------------------------------------------------------
bool libKRTC_gt_TalentNecromancerSummonInfested_Func (bool testConds, bool runActions) {
    // Variable Declarations
    point lv_point;
    int lv_rand;

    // Automatic Variable Declarations
    unitgroup auto8E334BD2_g;
    int auto8E334BD2_u;
    unit auto8E334BD2_var;

    // Variable Initialization
    lv_rand = ((FixedToInt(UnitGetPropertyFixed(EventUnit(), c_unitPropShieldsMax, c_unitPropCurrent)) + FixedToInt(UnitGetPropertyFixed(EventUnit(), c_unitPropLifeMax, c_unitPropCurrent))) / 100);

    // Conditions
    if (testConds) {
        if (!(((EventUnitDamageSourcePlayer() == 1) || (libNtve_gf_PlayerIsEnemy(EventUnitDamageSourcePlayer(), 1, libNtve_ge_PlayerRelation_Enemy) == false)))) {
            return false;
        }

        if (!((libNtve_gf_PlayerIsEnemy(EventPlayer(), 1, libNtve_ge_PlayerRelation_Enemy) == true))) {
            return false;
        }

        if (!((UnitFilterMatch(EventUnit(), 1, UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterSummoned - 32)))) == true))) {
            return false;
        }

        if (!((UnitHasBehavior2(EventUnit(), "Hallucination") == false))) {
            return false;
        }

        if (!((UnitGroupCount(libKRTC_gv_necroswarm, c_unitCountAlive) < 200))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_point = UnitGetPosition(EventUnit());
    if ((libKRTC_gf_TalentAcquired("DummyNecromancerCurseFail") == true) && (lv_rand > 1)) {
        UnitCreate(lv_rand, "InfestedCivilian2", 0, 1, lv_point, libNtve_gf_RandomAngle());
        UnitGroupAddUnitGroup(libKRTC_gv_necroswarm, UnitLastCreatedGroup());
        if ((libKRTC_gf_TalentAcquired("DruidHatchery") == true)) {
            auto8E334BD2_g = UnitLastCreatedGroup();
            auto8E334BD2_u = UnitGroupCount(auto8E334BD2_g, c_unitCountAll);
            for (;; auto8E334BD2_u -= 1) {
                auto8E334BD2_var = UnitGroupUnitFromEnd(auto8E334BD2_g, auto8E334BD2_u);
                if (auto8E334BD2_var == null) { break; }
                UnitBehaviorAdd(auto8E334BD2_var, "CerberusCommand", auto8E334BD2_var, 1);
            }
        }

    }
    else {
        UnitCreate(1, "InfestedCivilian2", 0, 1, lv_point, libNtve_gf_RandomAngle());
        UnitGroupAdd(libKRTC_gv_necroswarm, UnitLastCreated());
        if ((libKRTC_gf_TalentAcquired("DruidHatchery") == true)) {
            UnitBehaviorAdd(UnitLastCreated(), "CerberusCommand", UnitLastCreated(), 1);
        }

    }
    return true;
}

