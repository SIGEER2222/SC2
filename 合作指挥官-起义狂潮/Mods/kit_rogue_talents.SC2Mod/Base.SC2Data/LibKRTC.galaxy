        if ((UserDataGetInt("RogueTalents", "MIRAJIAOYI", "Acquired", 1) < 100)) {
            UserDataSetInt("RogueTalents", "MIRAJIAOYI", "Acquired", 1, (UserDataGetInt("RogueTalents", "MIRAJIAOYI", "Acquired", 1) + 1));
        }

        libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/lib_KRTC_27A10AA2"));
