//--------------------------------------------------------------------------------------------------
// Trigger: Talent Special Nova Death
//--------------------------------------------------------------------------------------------------
bool libKRTC_gt_TalentSpecialNovaDeath_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_cC;
    unit lv_respawnBeacon;

    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnit()) == "NovaHero"))) {
            return false;
        }

        if (!((UnitGetOwner(EventUnit()) == 1))) {
            return false;
        }

        if (!((EventUnitDamageDeathCheck(c_deathTypeRemove) == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    while (true) {
        if ((TechTreeUnitCount(1, "OrbitalCommand", c_techCountCompleteOnly) >= 1)) {
            lv_cC = UnitGroupRandomUnit(UnitGroup("OrbitalCommand", 1, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive);
        }
        else {
            if ((TechTreeUnitCount(1, "CommandCenter", c_techCountCompleteOnly) >= 1)) {
                lv_cC = UnitGroupRandomUnit(UnitGroup("CommandCenter", 1, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive);
            }
            else {
                if ((TechTreeUnitCount(1, "PlanetaryFortress", c_techCountCompleteOnly) >= 1)) {
                    lv_cC = UnitGroupRandomUnit(UnitGroup("PlanetaryFortress", 1, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive);
                }
                else {
                    lv_cC = null;
                }
            }
        }
        if ((lv_cC != null)) {
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/lib_KRTC_281B5CA5"));
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "NovaRespawnBeacon", 0, 1, PointWithOffset(UnitGetPosition(lv_cC), 3.0, -1.0));
            lv_respawnBeacon = UnitLastCreated();
            Wait(60.0, c_timeAI);
            UnitRemove(EventUnit());
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "NovaHero", 0, 1, UnitGetPosition(lv_respawnBeacon));
            UnitIssueOrder(UnitLastCreated(), libNtve_gf_ReviveOrderTargetingPoint(AbilityCommand("move", 0), UnitRallyPointTargetPoint(lv_respawnBeacon, 1, 1), EventUnit()), c_orderQueueReplace);
            SoundPlayOnUnitForPlayer(SoundLink("Nova_Ready", -1), c_maxPlayers, PlayerGroupAll(), EventUnit(), 0.0, 100.0, 0.0);
            UnitSetPropertyFixed(UnitLastCreated(), c_unitPropLifePercent, 100.0);
            UnitSetPropertyFixed(UnitLastCreated(), c_unitPropEnergyPercent, 100.0);
            UnitKill(lv_respawnBeacon);
            break;
        }
        else {
            Wait(2.0, c_timeAI);
        }
        if ((TechTreeUnitCount(1, "NovaRespawnBeacon", c_techCountQueuedOrBetter) >= 1)) {
            break;
        }

    }
    return true;
}

