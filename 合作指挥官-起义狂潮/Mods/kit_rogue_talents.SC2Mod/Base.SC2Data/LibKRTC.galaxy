void libKRTC_gf_RescueUnitWithUpgrades (unit lp_rescuable) {
    // Variable Declarations
    string lv_rescueType;
    point lv_rescuePosition;
    fixed lv_rescueFacing;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    lv_rescueType = UnitGetType(lp_rescuable);
    lv_rescuePosition = UnitGetPosition(lp_rescuable);
    lv_rescueFacing = UnitGetFacing(lp_rescuable);
    UnitRemove(lp_rescuable);
    UnitCreate(1, lv_rescueType, c_unitCreateIgnorePlacement, 1, lv_rescuePosition, lv_rescueFacing);
    UnitFlashSelection(UnitLastCreated(), 1.5);
    libKRTC_gv_lastRescuedUnit = UnitLastCreated();
}

void libKRTC_gf_SetUnitHPDynamically (unit lp_unit, fixed lp_targetHP, fixed lp_percent) {
    // Variable Declarations
    fixed lv_dynamicHP;
    fixed lv_ratio;
    fixed lv_originalHP;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    lv_originalHP = libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogUnit, UnitGetType(lp_unit), "LifeMax", 0);
    if ((lv_originalHP > 0.0) && (UnitHasBehavior2(lp_unit, "DynamicallyHPChanged") == false)) {
        lv_ratio = (lp_targetHP / lv_originalHP);
        lv_dynamicHP = (UnitGetPropertyFixed(lp_unit, c_unitPropLifeMax, c_unitPropCurrent) * lv_ratio);
        UnitSetPropertyFixed(lp_unit, c_unitPropLifeMax, lv_dynamicHP);
        UnitSetPropertyFixed(lp_unit, c_unitPropLifePercent, lp_percent);
        UnitBehaviorAdd(lp_unit, "DynamicallyHPChanged", lp_unit, 1);
    }

}

