        for (;; auto88CC29CF_u -= 1) {
            auto88CC29CF_var = UnitGroupUnitFromEnd(auto88CC29CF_g, auto88CC29CF_u);
            if (auto88CC29CF_var == null) { break; }
            if ((UnitHasBehavior2(auto88CC29CF_var, "MarkedWithBounty") == true)) {
                UnitGroupRemove(lv_enemyGroup, auto88CC29CF_var);
            }

        }
        if ((UnitGroupCount(lv_enemyGroup, c_unitCountAlive) >= 1)) {
            lv_target = UnitGroupRandomUnit(lv_enemyGroup, c_unitCountAlive);
            UnitBehaviorAdd(lv_target, "MarkedWithBounty", lv_target, 1);
            return true;
