//--------------------------------------------------------------------------------------------------
bool libKRTC_gt_talentdubo_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((RandomInt(1, 100) > 40)) {
        libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
        UserDataSetInt("RogueTalents", "duboanweijiang", "Acquired", 1, (UserDataGetInt("RogueTalents", "duboanweijiang", "Acquired", 1) + 1));
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/lib_KRTC_3899C019"));
        if ((RandomInt(1, 5) <= UserDataGetInt("RogueTalents", "duboanweijiang", "Acquired", 1))) {
            if ((RandomInt(1, 100) > 40)) {
                libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
                UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/lib_KRTC_A7FA9DDA"));
            }
            else {
                libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
                UserDataSetInt("CampaignConstants", "StartCredits", "Value", 1, (UserDataGetInt("CampaignConstants", "StartCredits", "Value", 1) + 100000));
                UserDataSetInt("RogueTalents", "duboanweijiang", "Acquired", 1, (UserDataGetInt("RogueTalents", "duboanweijiang", "Acquired", 1) - 1));
                UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/lib_KRTC_BA61EF06"));
            }
        }

    }
    else {
        libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
        UserDataSetInt("CampaignConstants", "StartCredits", "Value", 1, (UserDataGetInt("CampaignConstants", "StartCredits", "Value", 1) + 100000));
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/lib_KRTC_48992A9F"));
    }
    return true;
}

