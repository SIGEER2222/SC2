        UnitCreate(1, "Medivac", 0, 1, lv_position, libNtve_gf_RandomAngle());
        lv_medivac = UnitLastCreated();
        UnitCargoCreate(lv_medivac, "Vulture", 4);
        MinimapPing(PlayerGroupAll(), UnitGetPosition(lv_medivac), 2.0, Color(100.00, 60.00, 80.00));
        UnitSetHeight(lv_medivac, 10.0, 0.0);
        UnitSetHeight(lv_medivac, libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogUnit, "Medivac", "Height", c_playerAny), 3.0);
        if ((TriggerGetExecCount(TriggerGetCurrent()) >= 4)) {
