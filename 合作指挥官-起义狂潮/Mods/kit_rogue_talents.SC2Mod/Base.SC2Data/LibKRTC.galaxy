//--------------------------------------------------------------------------------------------------
bool libKRTC_gt_TalentSpecialBountyController_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TriggerExecute(libKRTC_gt_TalentSpecialBounty, true, false);
    Wait(1.0, c_timeAI);
    TriggerExecute(libKRTC_gt_TalentSpecialBounty, true, false);
    Wait(1.0, c_timeAI);
    TriggerExecute(libKRTC_gt_TalentSpecialBounty, true, false);
    Wait(1.0, c_timeAI);
    TriggerExecute(libKRTC_gt_TalentSpecialBounty, true, false);
    Wait(1.0, c_timeAI);
    TriggerExecute(libKRTC_gt_TalentSpecialBounty, true, false);
    while (true) {
        Wait(RandomFixed(10.0, 60.0), c_timeAI);
        TriggerExecute(libKRTC_gt_TalentSpecialBounty, true, false);
    }
    return true;
}

