//--------------------------------------------------------------------------------------------------
bool libKRTC_gt_AchievementPickEvents_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_i;
    int lv_totalEpics;
    int lv_totalClassTalents;
    int lv_totalChallenges;

    // Automatic Variable Declarations
    int auto972B9EB3_ae;
    const int auto972B9EB3_ai = 1;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    auto972B9EB3_ae = UserDataInstanceCount("RogueTalents");
    lv_i = 1;
    for ( ; ( (auto972B9EB3_ai >= 0 && lv_i <= auto972B9EB3_ae) || (auto972B9EB3_ai < 0 && lv_i >= auto972B9EB3_ae) ) ; lv_i += auto972B9EB3_ai ) {
        if ((UserDataGetInt("RogueTalents", UserDataInstance("RogueTalents", lv_i), "Rarity", 1) == 4) && (UserDataGetInt("RogueTalents", UserDataInstance("RogueTalents", lv_i), "Acquired", 1) >= 1)) {
            lv_totalEpics += 1;
        }

        if ((UserDataGetString("RogueTalents", UserDataInstance("RogueTalents", lv_i), "Type", 1) == "Class") && (UserDataGetInt("RogueTalents", UserDataInstance("RogueTalents", lv_i), "Rarity", 1) != 5) && (UserDataGetInt("RogueTalents", UserDataInstance("RogueTalents", lv_i), "Acquired", 1) >= 1)) {
            lv_totalClassTalents += 1;
        }

        if ((UserDataGetInt("RogueTalents", UserDataInstance("RogueTalents", lv_i), "Rarity", 1) == -3) && (UserDataGetInt("RogueTalents", UserDataInstance("RogueTalents", lv_i), "Acquired", 1) >= 1)) {
            lv_totalChallenges += 1;
        }

        if ((UserDataGetInt("RogueTalents", UserDataInstance("RogueTalents", lv_i), "Rarity", 1) < 0) && (UserDataGetInt("RogueTalents", UserDataInstance("RogueTalents", lv_i), "Acquired", 1) >= 5)) {
            libKRTC_gf_AchievementAward(3);
        }

        if ((UserDataGetInt("RogueTalents", UserDataInstance("RogueTalents", lv_i), "Rarity", 1) > 0) && (UserDataGetInt("RogueTalents", UserDataInstance("RogueTalents", lv_i), "Acquired", 1) >= 4)) {
            libKRTC_gf_AchievementAward(4);
        }

    }
    if ((lv_totalEpics >= 5)) {
        libKRTC_gf_AchievementAward(5);
    }

    if ((lv_totalClassTalents >= 10)) {
        libKRTC_gf_AchievementAward(6);
    }

    if ((lv_totalChallenges >= 20)) {
        libKRTC_gf_AchievementAward(7);
    }

    return true;
}

