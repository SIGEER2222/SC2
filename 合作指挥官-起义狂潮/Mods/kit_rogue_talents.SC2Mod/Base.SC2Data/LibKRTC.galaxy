    libKRTC_gt_TalentSpecialJormungand = TriggerCreate("libKRTC_gt_TalentSpecialJormungand_Func");
    TriggerEnable(libKRTC_gt_TalentSpecialJormungand, false);
    TriggerAddEventUnitAbility(libKRTC_gt_TalentSpecialJormungand, null, AbilityCommand("SpecialJormungand", 0), c_unitAbilStageAll, false);
}

