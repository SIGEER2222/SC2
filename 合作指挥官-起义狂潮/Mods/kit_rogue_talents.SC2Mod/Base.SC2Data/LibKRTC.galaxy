//--------------------------------------------------------------------------------------------------
// Trigger: dianjhongzha
//--------------------------------------------------------------------------------------------------
bool libKRTC_gt_dianjhongzha_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((EventKeyControl() == true))) {
            return false;
        }

        if (!((EventKeyShift() == true))) {
            return false;
        }

        if (!((libWoLC_gf_CurrentMap() != "TStory01"))) {
            return false;
        }

        if (!((libWoLC_gf_CurrentMap() != "TArcade"))) {
            return false;
        }

        if (!((VisIsVisibleForPlayer(1, Point(EventMouseClickedPosXWorld(), EventMouseClickedPosYWorld())) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((PlayerGetPropertyFixed(EventPlayer(), c_playerPropMinerals) >= 25.0)) {
        PlayerModifyPropertyInt(1, c_playerPropMinerals, c_playerPropOperSubtract, 25);
        UnitCreate(1, "Ravager", c_unitCreateIgnorePlacement, 1, Point(EventMouseClickedPosXWorld(), EventMouseClickedPosYWorld()), 270.0);
        UnitBehaviorAddPlayer(UnitLastCreated(), "Precursor23", 1, 1);
        UnitSetHeight(UnitLastCreated(), 30.0, 0.0);
        UnitCreateEffectPoint(UnitLastCreated(), "RavagerCorrosiveBileCP", Point(EventMouseClickedPosXWorld(), EventMouseClickedPosYWorld()));
    }
    else {
        SoundPlayForPlayer(SoundLink("e_cmdNotEnoughMinerals", -1), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
    }
    return true;
}

