//--------------------------------------------------------------------------------------------------
// Trigger: tonghuati
//--------------------------------------------------------------------------------------------------
bool libKRTC_gt_tonghuati_Func (bool testConds, bool runActions) {
    // Variable Declarations
    string lv_unitkind;

    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((UnitHasBehavior2(EventUnit(), "DarkArchonMindControl2") == false))) {
            return false;
        }

        if (!((UnitGetOwner(EventUnit()) == 1))) {
            return false;
        }

        if (!((UnitGetOwner(EventUnitDamageSourceUnit()) != 1))) {
            return false;
        }

        if (!((UnitGetPropertyFixed(EventUnitDamageSourceUnit(), c_unitPropSuppliesUsed, c_unitPropNormal) > 0))) {
            return false;
        }

        if (!((UnitTypeTestAttribute(UnitGetType(EventUnit()), c_unitAttributeSummoned) == false))) {
            return false;
        }

        if (!((UnitTypeTestAttribute(UnitGetType(EventUnitDamageSourceUnit()), c_unitAttributeSummoned) == false))) {
            return false;
        }

        if (!((UnitHasBehavior2(EventUnit(), "RogueUniversalUnitBuff") == true))) {
            return false;
        }

        if (!((UnitHasBehavior2(EventUnitDamageSourceUnit(), "RogueUniversalUnitBuff") == true))) {
            return false;
        }

        if (!((UnitGetType(EventUnitDamageSourceUnit()) != UnitGetType(EventUnit())))) {
            return false;
        }

        if (!((RandomFixed(0.0, (150.0 * UnitGetPropertyFixed(EventUnitDamageSourceUnit(), c_unitPropSuppliesUsed, c_unitPropNormal))) <= EventUnitDamageAbsorbed()))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_unitkind = UnitGetType(EventUnitDamageSourceUnit());
    UnitKill(EventUnit());
    UnitCreate(1, lv_unitkind, c_unitCreateIgnoreBirth, UnitGetOwner(EventUnitDamageSourceUnit()), UnitGetPosition(EventUnit()), (180.0 + UnitGetFacing(EventUnitDamageSourceUnit())));
    UnitBehaviorAddPlayer(UnitLastCreated(), "DarkArchonMindControl2", 1, 1);
    return true;
}

