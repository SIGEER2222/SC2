//--------------------------------------------------------------------------------------------------
// Trigger: Druid Target Marker
//--------------------------------------------------------------------------------------------------
bool libKRTC_gt_DruidTargetMarker_Func (bool testConds, bool runActions) {
    // Variable Declarations
    point lv_target;
    unitgroup lv_enemis;

    // Automatic Variable Declarations
    unitgroup auto4DFC5347_g;
    int auto4DFC5347_u;
    unit auto4DFC5347_var;

    // Variable Initialization
    lv_enemis = UnitGroupEmpty();

    // Conditions
    if (testConds) {
        if (!((UnitGroupCount(libKRTC_gv_druidSwarm, c_unitCountAlive) >= 1))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitIsAlive(libKRTC_gv_druidEmitterUnit) == true)) {
        if ((UnitHasBehavior2(libKRTC_gv_druidEmitterUnit, "DruidPsiDrone") == true)) {
            lv_target = UnitGetPosition(libKRTC_gv_druidEmitterUnit);
            UnitGroupIssueOrder(libKRTC_gv_druidSwarm, OrderTargetingPoint(AbilityCommand("attack", 0), lv_target), c_orderQueueReplace);
            return true;
        }

    }

    auto4DFC5347_g = libKRTC_gv_druidSwarm;
    auto4DFC5347_u = UnitGroupCount(auto4DFC5347_g, c_unitCountAll);
    for (;; auto4DFC5347_u -= 1) {
        auto4DFC5347_var = UnitGroupUnitFromEnd(auto4DFC5347_g, auto4DFC5347_u);
        if (auto4DFC5347_var == null) { break; }
        UnitIssueOrder(auto4DFC5347_var, OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(UnitGroupClosestToPoint(libKRTC_gv_druidbase, UnitGetPosition(auto4DFC5347_var)))), c_orderQueueReplace);
        Wait(0.0625, c_timeAI);
    }
    return true;
}

