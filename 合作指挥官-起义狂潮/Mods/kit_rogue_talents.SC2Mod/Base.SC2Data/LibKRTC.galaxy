            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((libWoLC_gf_CurrentMap() == "TValerian03") && (libKRTC_gf_TalentAcquired("UnknownUpgrade11") == true)) {
        TriggerEnable(TriggerGetCurrent(), false);
    }
    else {
