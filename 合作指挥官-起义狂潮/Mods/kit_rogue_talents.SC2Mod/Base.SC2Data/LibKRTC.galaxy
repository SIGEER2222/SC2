//--------------------------------------------------------------------------------------------------
// Trigger: NTR
//--------------------------------------------------------------------------------------------------
bool libKRTC_gt_NTR_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((libWoLC_gf_CurrentMap() != "TStory01"))) {
            return false;
        }

        if (!((libWoLC_gf_CurrentMap() != "TArcade"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((TechTreeUnitCount(1, "TaurenSpaceMarine", c_techCountCompleteOnly) == 0)) {
        if ((PlayerGetPropertyFixed(1, c_playerPropMinerals) >= 200.0)) {
            TriggerEnable(TriggerGetCurrent(), false);
            PlayerModifyPropertyInt(1, c_playerPropMinerals, c_playerPropOperSubtract, 200);
            PlayerCreateEffectPoint(1, "TaurenOutHouseCrash", CameraGetTarget(1));
            Wait(300.0, c_timeGame);
            TriggerEnable(TriggerGetCurrent(), true);
        }
        else {
            SoundPlayForPlayer(SoundLink("e_cmdNotEnoughMinerals", -1), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
        }
    }
    else {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/lib_KRTC_18CCA7D1"));
    }
    return true;
}

