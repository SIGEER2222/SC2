//--------------------------------------------------------------------------------------------------
// Trigger: Talent Topbar Create
//--------------------------------------------------------------------------------------------------
bool libKRTC_gt_TalentTopbarCreate_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }

        if (!((libWoLC_gf_CurrentMap() != "TStory01"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "RogueTopbar", c_unitCreateIgnorePlacement, 1, RegionGetBoundsMin(RegionEntireMap()));
    libKRTC_gv_rogueTopbar = UnitLastCreated();
    DialogCreate(600, 300, c_anchorTop, 50, 0, true);
    DialogSetImageVisible(DialogLastCreated(), false);
    DialogSetVisible(DialogLastCreated(), PlayerGroupAll(), true);
    libKRTC_gv_talentTopbarDialog = DialogLastCreated();
    DialogControlHookupStandard(c_triggerControlTypePanel, "UIContainer/FullscreenUpperContainer/RogueGlobalCastingPanel");
    DialogControlSetVisible(DialogControlLastCreated(), PlayerGroupAll(), true);
    DialogControlCreateInPanelFromTemplate(DialogControlLastCreated(), c_triggerControlTypePanel, "RaynorRogueTopbar/RoguePanelTemplate");
    libKRTC_gv_talentTopbarDialogItem = DialogControlLastCreated();
    DialogControlSetVisible(libKRTC_gv_talentTopbarDialogItem, PlayerGroupAll(), true);
    DialogControlCreateInPanel(DialogControlLastCreated(), c_triggerControlTypeTooltip);
    DialogControlHookupStandard(c_triggerControlTypePanel, "UIContainer/ConsolePanel");
    DialogControlHookup(libKRTC_gv_talentTopbarDialogItem, c_triggerControlTypePanel, "RogueButtonHolder");
    DialogControlCreateInPanelFromTemplate(DialogControlLastCreated(), c_triggerControlTypeCommandPanel, "RaynorRogueTopbar/RogueCommandPanelTemplate");
    libNtve_gf_SetDialogItemUnitGroup(DialogControlLastCreated(), libNtve_gf_ConvertUnitToUnitGroup(libKRTC_gv_rogueTopbar), PlayerGroupAll());
    return true;
}

//--------------------------------------------------------------------------------------------------
void libKRTC_gt_TalentTopbarCreate_Init () {
    libKRTC_gt_TalentTopbarCreate = TriggerCreate("libKRTC_gt_TalentTopbarCreate_Func");
}

