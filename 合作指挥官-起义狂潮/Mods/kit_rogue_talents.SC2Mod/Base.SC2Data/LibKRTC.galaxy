//--------------------------------------------------------------------------------------------------
// Trigger: Druid legend
//--------------------------------------------------------------------------------------------------
bool libKRTC_gt_Druidlegend_Func (bool testConds, bool runActions) {
    // Variable Declarations
    string lv_unitkind;
    fixed lv_face;
    point lv_point;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_unitkind = UnitGetType(EventPlayerEffectUsedUnitImpact());
    lv_face = UnitGetFacing(EventPlayerEffectUsedUnitImpact());
    lv_point = UnitGetPosition(EventPlayerEffectUsedUnitImpact());

    // Actions
    if (!runActions) {
        return true;
    }

    UnitKill(EventPlayerEffectUsedUnitImpact());
    if (((lv_unitkind == "Zergling") || (lv_unitkind == "ZerglingBurrowed"))) {
        UnitCreate(1, "HotSRaptor", c_unitCreateIgnorePlacement | c_unitCreateIgnoreBirth, 1, lv_point, lv_face);
    }

    if (((lv_unitkind == "Hydralisk"))) {
        UnitCreate(1, "HydraliskLurker", c_unitCreateIgnorePlacement | c_unitCreateIgnoreBirth, 1, lv_point, lv_face);
    }

    if (((lv_unitkind == "Roach") || (lv_unitkind == "RoachBurrowed"))) {
        UnitCreate(1, "RoachVile", c_unitCreateIgnorePlacement | c_unitCreateIgnoreBirth, 1, lv_point, lv_face);
    }

    if (((lv_unitkind == "SwarmHost") || (lv_unitkind == "SwarmHostRooted") || (lv_unitkind == "SwarmHostBurrowed"))) {
        UnitCreate(1, "SwarmHostSplitA", c_unitCreateIgnorePlacement | c_unitCreateIgnoreBirth, 1, lv_point, lv_face);
    }

    if (((lv_unitkind == "Mutalisk"))) {
        UnitCreate(1, "Viper", c_unitCreateIgnorePlacement | c_unitCreateIgnoreBirth, 1, lv_point, lv_face);
    }

    if (((lv_unitkind == "Ultralisk") || (lv_unitkind == "UltraliskBurrowed"))) {
        UnitCreate(1, "HotSTorrasque", c_unitCreateIgnorePlacement | c_unitCreateIgnoreBirth, 1, lv_point, lv_face);
    }

    UnitBehaviorAddPlayer(UnitLastCreated(), "Precursor22", 1, 1);
    UnitClearSelection(1);
    UnitSelect(UnitLastCreated(), 1, true);
    return true;
}

