    const int auto298765F7_ae = 2;
    const int auto298765F7_ai = -1;

    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == 1))) {
            return false;
        }

        if (!(((UnitGetType(EventUnit()) == "HERC") || (UnitGetType(EventUnit()) == "WarlockHybridBehemoth")))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_tHEHERC = EventUnit();
    lv_positions[1] = UnitGetPosition(lv_tHEHERC);
    lv_angles[1] = UnitGetFacing(lv_tHEHERC);
    lv_hPs[1] = UnitGetPropertyFixed(lv_tHEHERC, c_unitPropLifePercent, c_unitPropCurrent);
    autoFCEFAE07_var = 2;
    for ( ; autoFCEFAE07_var <= autoFCEFAE07_ae; autoFCEFAE07_var += 1 ) {
        lv_positions[autoFCEFAE07_var] = lv_positions[1];
        lv_angles[autoFCEFAE07_var] = lv_angles[1];
        lv_hPs[autoFCEFAE07_var] = lv_hPs[1];
    }
    while (true) {
        while ((lv_wait < 10)) {
            lv_wait += 1;
            if ((UnitHasBehavior2(lv_tHEHERC, "MGChronoRecallActive") == true)) {
                UnitBehaviorRemove(lv_tHEHERC, "MGChronoRecallActive", 1);
                UnitBehaviorAdd(lv_tHEHERC, "MGChronoRecallBlink", lv_tHEHERC, 1);
                Wait(0.0675, c_timeGame);
                UnitSetPosition(lv_tHEHERC, lv_positions[10], false);
                UnitSetFacing(lv_tHEHERC, lv_angles[10], 0.0675);
                UnitSetPropertyFixed(lv_tHEHERC, c_unitPropLifePercent, lv_hPs[10]);
                Wait(0.0675, c_timeGame);
                UnitBehaviorRemove(lv_tHEHERC, "MGChronoRecallBlink", 1);
                lv_wait = 10;
            }

            Wait(0.1, c_timeAI);
        }
        lv_wait = 10;
        for ( ; ( (auto298765F7_ai >= 0 && lv_wait <= auto298765F7_ae) || (auto298765F7_ai < 0 && lv_wait >= auto298765F7_ae) ) ; lv_wait += auto298765F7_ai ) {
            lv_positions[lv_wait] = lv_positions[(lv_wait - 1)];
            lv_angles[lv_wait] = lv_angles[(lv_wait - 1)];
            lv_hPs[lv_wait] = lv_hPs[(lv_wait - 1)];
        }
        lv_wait = 0;
        lv_positions[1] = UnitGetPosition(lv_tHEHERC);
        lv_angles[1] = UnitGetFacing(lv_tHEHERC);
        lv_hPs[1] = UnitGetPropertyFixed(lv_tHEHERC, c_unitPropLifePercent, c_unitPropCurrent);
        if ((UnitIsAlive(lv_tHEHERC) == false)) {
            return true;
        }

    }
    return true;
}

