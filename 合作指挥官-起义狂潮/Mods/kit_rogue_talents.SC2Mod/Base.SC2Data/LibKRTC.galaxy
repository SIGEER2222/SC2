//--------------------------------------------------------------------------------------------------
// Trigger: Talent Sorcerer Reinforcement
//--------------------------------------------------------------------------------------------------
bool libKRTC_gt_TalentSorcererReinforcement_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unitgroup lv_dropGroup;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_dropGroup = UnitGroupEmpty();

    // Actions
    if (!runActions) {
        return true;
    }

    if ((libKRTC_gf_TalentAcquired("MulticlassGeneric") == true) && (libKRTC_gf_TalentAcquired("HunterMainBuff") == true)) {
        UnitCreate(1, "MercMedic", 0, 1, EventUnitTargetPoint(), libNtve_gf_RandomAngle());
        UnitGroupAdd(lv_dropGroup, UnitLastCreated());
        UnitCreate(1, "HammerSecurity", 0, 1, EventUnitTargetPoint(), libNtve_gf_RandomAngle());
        UnitGroupAdd(lv_dropGroup, UnitLastCreated());
        UnitCreate(4, "WarPig", 0, 1, EventUnitTargetPoint(), libNtve_gf_RandomAngle());
        UnitGroupAddUnitGroup(lv_dropGroup, UnitLastCreatedGroup());
    }
    else {
        UnitCreate(1, "Medic", 0, 1, EventUnitTargetPoint(), libNtve_gf_RandomAngle());
        UnitGroupAdd(lv_dropGroup, UnitLastCreated());
        UnitCreate(1, "Marauder", 0, 1, EventUnitTargetPoint(), libNtve_gf_RandomAngle());
        UnitGroupAdd(lv_dropGroup, UnitLastCreated());
        UnitCreate(4, "Marine", 0, 1, EventUnitTargetPoint(), libNtve_gf_RandomAngle());
        UnitGroupAddUnitGroup(lv_dropGroup, UnitLastCreatedGroup());
    }
    libWCMI_gf_CreateDropPod(libWCMI_ge_DropPodRace_Terran, UnitGroupCenterOfGroup(lv_dropGroup), lv_dropGroup, true, 1);
    return true;
}

