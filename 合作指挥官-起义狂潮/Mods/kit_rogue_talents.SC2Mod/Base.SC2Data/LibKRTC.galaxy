//--------------------------------------------------------------------------------------------------
bool libKRTC_gt_MGTimelineErasure_Func (bool testConds, bool runActions) {
    // Variable Declarations
    fixed lv_amount;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    lv_amount = UnitGetPropertyFixed(EventUnit(), c_unitPropLife, c_unitPropCurrent);
    lv_amount += UnitGetPropertyFixed(EventUnit(), c_unitPropShields, c_unitPropCurrent);
    lv_amount /= 300.0;
    lv_amount *= UnitBehaviorDurationTotal(EventUnit(), "MGTimelineErasure");
    UnitBehaviorSetDuration(EventUnit(), "MGTimelineErasure", lv_amount);
    return true;
}

