//--------------------------------------------------------------------------------------------------
// Trigger: Talent Speicial Hanson 2
//--------------------------------------------------------------------------------------------------
bool libKRTC_gt_TalentSpeicialHanson2_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((EventUnitHealVital() == c_unitVitalLife))) {
            return false;
        }

        if (!((UnitTypeTestAttribute(UnitGetType(EventUnit()), c_unitAttributeBiological) == true))) {
            return false;
        }

        if (!((TechTreeUpgradeCount(UnitGetOwner(EventUnit()), "SpecialPlanetCracker", c_techCountCompleteOnly) > 0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitSetPropertyFixed(EventUnit(), c_unitPropLife, (UnitGetPropertyFixed(EventUnit(), c_unitPropLife, c_unitPropCurrent) + (EventUnitHealAmount() * 1.0)));
    return true;
}

