    libKRTC_gt_Druidlegend = TriggerCreate("libKRTC_gt_Druidlegend_Func");
    TriggerEnable(libKRTC_gt_Druidlegend, false);
    TriggerAddEventPlayerEffectUsed(libKRTC_gt_Druidlegend, 1, "DummyEffect2");
}

