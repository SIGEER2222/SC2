//--------------------------------------------------------------------------------------------------
// Trigger: soceroer curse
//--------------------------------------------------------------------------------------------------
bool libKRTC_gt_soceroercurse_Func (bool testConds, bool runActions) {
    // Variable Declarations
    fixed lv_time;
    fixed lv_mI;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_mI = (IntToFixed(UserDataGetInt("RogueTalents", "shushizuzhou", "Acquired", 1)) - 1.0);

    // Conditions
    if (testConds) {
        if (!((libNtve_gf_PlayerIsEnemy(1, UnitGetOwner(EventUnit()), libNtve_ge_PlayerRelation_Enemy) == true))) {
            return false;
        }

        if (!((libNtve_gf_UnitIsInvulnerable(EventUnit()) == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    lv_mI = Pow(0.9, lv_mI);
    lv_time = (600.0 * lv_mI);
    UnitIssueOrder(libKRTC_gv_rogueTopbar, Order(AbilityCommand("SorcererShieldOvercharge", 0)), c_orderQueueReplace);
    Wait(lv_time, c_timeAI);
    TriggerEnable(TriggerGetCurrent(), true);
    return true;
}

