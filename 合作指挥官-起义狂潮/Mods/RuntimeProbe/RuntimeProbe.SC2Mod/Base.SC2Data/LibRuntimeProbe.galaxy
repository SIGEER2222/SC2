include "TriggerLibs/natives"
include "LibRuntimeProbe_h"

//--------------------------------------------------------------------------------------------------
// RuntimeProbe Phase 1+2 Implementation
// Writes runtime diagnostics to RuntimeProbe.SC2Bank for external Python probe runner.
// All Bank keys/values use ASCII to avoid Galaxy encoding issues.
//
// 架构说明：
// - 使用 Wait 循环实现周期性扫描（不依赖 TriggerAddEventTimePeriodic）
//   7vs1 地图中 TriggerAddEventTimePeriodic 在所有位置和时间类型下均不触发，
//   改用 Wait(3.0, c_timeReal) 循环，与 7vs1 地图自身模式一致（gt_StartGame_Func 大量使用 Wait）
// - Loop_Func 由 StartProbe 通过 TriggerExecute(..., false, false) 异步启动，不阻塞调用方
// - c_timeReal 不受 cinematic/briefing 影响，确保循环在过场动画期间也能执行
// - StartProbe() 在 gt_Initialization_Func 中调用，执行首次全量扫描并启动循环
//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
// Try to load the Bank. Returns true on success.
// Called from the Tick trigger until the bank is successfully loaded.
//--------------------------------------------------------------------------------------------------
bool libRuntimeProbe_gf_TryLoadBank() {
    if (libRuntimeProbe_gv_bank != null) {
        return true;
    }
    libRuntimeProbe_gv_bank = BankLoad("RuntimeProbe", 1);
    if (libRuntimeProbe_gv_bank == null) {
        return false;
    }
    // Initial state markers
    BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_state", "run_id", "pending");
    BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_state", "phase", "loading");
    BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_state", "is_in_mission", false);
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "heartbeat", 1);
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "unit_scan_id", 0);
    BankSave(libRuntimeProbe_gv_bank);
    return true;
}

//--------------------------------------------------------------------------------------------------
// Write probe_state: heartbeat, game time, resources, supply
// 不再单独 BankSave，由调用方批量保存
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_WriteState() {
    int lv_player = 1;

    libRuntimeProbe_gv_heartbeat = libRuntimeProbe_gv_heartbeat + 1;
    if (libRuntimeProbe_gv_heartbeat > 999999) {
        libRuntimeProbe_gv_heartbeat = 1;
    }

    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "heartbeat", libRuntimeProbe_gv_heartbeat);
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "game_time", FixedToInt(GameGetMissionTime()));
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "game_loop", FixedToInt(GameGetMissionTime() * 16.0));
    BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_state", "phase", "in_mission");
    BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_state", "is_in_mission", true);
    BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_state", "is_paused", false);
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "player_id", lv_player);
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "minerals", PlayerGetPropertyInt(lv_player, c_playerPropMinerals));
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "gas", PlayerGetPropertyInt(lv_player, c_playerPropVespene));
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "supply_used", PlayerGetPropertyInt(lv_player, c_playerPropSuppliesUsed));
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "supply_cap", PlayerGetPropertyInt(lv_player, c_playerPropSuppliesMade));
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "script_error_count", 0);
}

//--------------------------------------------------------------------------------------------------
// Clear all keys in a Bank section before writing fresh scan data.
// Prevents stale entries (e.g. removed units) from polluting the Bank.
// Uses BankSectionRemove for atomic deletion (逐个 BankKeyRemove 会导致触发器错误).
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_ClearBankSection(string lp_section) {
    if (libRuntimeProbe_gv_bank == null) {
        return;
    }
    if (!BankSectionExists(libRuntimeProbe_gv_bank, lp_section)) {
        return;
    }
    BankSectionRemove(libRuntimeProbe_gv_bank, lp_section);
}

//--------------------------------------------------------------------------------------------------
// Scan all units for player 1, aggregate by type, write probe_units
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_ScanUnits() {
    unitgroup lv_all;
    int lv_total;
    int lv_unique;
    int lv_i;
    int lv_idx;
    bool lv_found;
    unit lv_u;
    string lv_type;
    fixed lv_life;
    fixed lv_energy;
    string lv_key;
    string lv_val;
    int lv_avgLife;
    int lv_avgEnergy;
    int lv_j;

    libRuntimeProbe_gv_scanId = libRuntimeProbe_gv_scanId + 1;

    // Clear stale entries so removed units do not linger in the Bank.
    libRuntimeProbe_gf_ClearBankSection("probe_units");

    lv_all = UnitGroup(null, 1, RegionEntireMap(),
        UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_total = UnitGroupCount(lv_all, c_unitCountAll);
    lv_unique = 0;

    // Reset arrays for this scan
    lv_i = 1;
    while (lv_i <= 255) {
        libRuntimeProbe_gv_unitTypes[lv_i] = "";
        libRuntimeProbe_gv_unitCounts[lv_i] = 0;
        lv_i = lv_i + 1;
    }

    lv_i = 1;
    while (lv_i <= lv_total) {
        lv_u = UnitGroupUnit(lv_all, lv_i);
        lv_type = UnitGetType(lv_u);
        lv_life = UnitGetPropertyFixed(lv_u, c_unitPropLife, c_unitPropCurrent);
        lv_energy = UnitGetPropertyFixed(lv_u, c_unitPropEnergy, c_unitPropCurrent);

        lv_idx = 1;
        lv_found = false;
        while (lv_idx <= lv_unique) {
            if (libRuntimeProbe_gv_unitTypes[lv_idx] == lv_type) {
                libRuntimeProbe_gv_unitCounts[lv_idx] = libRuntimeProbe_gv_unitCounts[lv_idx] + 1;
                libRuntimeProbe_gv_unitLifeSum[lv_idx] = libRuntimeProbe_gv_unitLifeSum[lv_idx] + FixedToInt(lv_life);
                libRuntimeProbe_gv_unitEnergySum[lv_idx] = libRuntimeProbe_gv_unitEnergySum[lv_idx] + FixedToInt(lv_energy);
                lv_found = true;
                break;
            }
            lv_idx = lv_idx + 1;
        }
        if (!lv_found) {
            if (lv_unique < 255) {
                lv_unique = lv_unique + 1;
                libRuntimeProbe_gv_unitTypes[lv_unique] = lv_type;
                libRuntimeProbe_gv_unitCounts[lv_unique] = 1;
                libRuntimeProbe_gv_unitLifeSum[lv_unique] = FixedToInt(lv_life);
                libRuntimeProbe_gv_unitEnergySum[lv_unique] = FixedToInt(lv_energy);
            }
        }
        lv_i = lv_i + 1;
    }

    lv_j = 1;
    while (lv_j <= lv_unique) {
        lv_key = "u_1_" + libRuntimeProbe_gv_unitTypes[lv_j];
        lv_avgLife = 0;
        lv_avgEnergy = 0;
        if (libRuntimeProbe_gv_unitCounts[lv_j] > 0) {
            lv_avgLife = libRuntimeProbe_gv_unitLifeSum[lv_j] / libRuntimeProbe_gv_unitCounts[lv_j];
            lv_avgEnergy = libRuntimeProbe_gv_unitEnergySum[lv_j] / libRuntimeProbe_gv_unitCounts[lv_j];
        }
        lv_val = "count:" + IntToString(libRuntimeProbe_gv_unitCounts[lv_j]) +
            ",completed:" + IntToString(libRuntimeProbe_gv_unitCounts[lv_j]) +
            ",in_progress:0" +
            ",life_avg:" + IntToString(lv_avgLife) + ".0" +
            ",energy_avg:" + IntToString(lv_avgEnergy) + ".0" +
            ",owner:1,is_structure:0,is_worker:0" +
            ",scan_id:" + IntToString(libRuntimeProbe_gv_scanId);
        BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_units", lv_key, lv_val);
        lv_j = lv_j + 1;
    }

    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "unit_scan_id", libRuntimeProbe_gv_scanId);
}

//--------------------------------------------------------------------------------------------------
// Scan upgrades: iterate upgrade catalog, write researched upgrades
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_ScanUpgrades() {
    int lv_count;
    int lv_i;
    string lv_upgradeId;
    int lv_resCount;
    string lv_key;
    string lv_val;

    // Clear stale entries so removed upgrades do not linger in the Bank.
    libRuntimeProbe_gf_ClearBankSection("probe_upgrades");

    lv_count = CatalogEntryCount(c_gameCatalogUpgrade);
    lv_i = 1;
    while (lv_i <= lv_count) {
        lv_upgradeId = CatalogEntryGet(c_gameCatalogUpgrade, lv_i);
        if (CatalogEntryIsValid(c_gameCatalogUpgrade, lv_upgradeId)) {
            lv_resCount = TechTreeUpgradeCount(1, lv_upgradeId, c_techCountCompleteOnly);
            if (lv_resCount > 0) {
                lv_key = "up_1_" + lv_upgradeId;
                lv_val = "upgrade_id:" + lv_upgradeId +
                    ",researched:1,in_progress:0,available:1,blocked_reason:None";
                BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_upgrades", lv_key, lv_val);
            }
        }
        lv_i = lv_i + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Scan replacement status: detect residual zerg units and expected race mismatch
// 这是判定指挥官替换是否真正成功的核心证据来源
// 写入 probe_replacement section:
//   expected_commander, expected_race, zerg_units_count, terran_units_count, protoss_units_count
//   status: SUCCESS | FAILED_ZERG_RESIDUAL | FAILED_NO_EXPECTED_RACE | UNKNOWN_RACE
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_ScanReplacement () {
    bank lv_coreBank;
    string lv_commander;
    string lv_expectedRace;
    unitgroup lv_all;
    int lv_total;
    int lv_i;
    unit lv_u;
    string lv_type;
    string lv_race;
    int lv_zergCount;
    int lv_terranCount;
    int lv_protossCount;

    // 读取期望指挥官
    lv_coreBank = BankLoad("CampaignXCore", 1);
    if (lv_coreBank == null) {
        BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_replacement", "status", "NO_CORE_BANK");
        return;
    }
    lv_commander = BankValueGetAsString(lv_coreBank, "XMRuntimeControl", "PrimaryCommander");

    // 判定期望种族
    lv_expectedRace = "";
    if ((lv_commander == "Raynor") || (lv_commander == "TerranRaynor") ||
        (lv_commander == "Swann") || (lv_commander == "TerranSwann") ||
        (lv_commander == "Nova") || (lv_commander == "TerranNova") ||
        (lv_commander == "Horner") || (lv_commander == "TerranHorner") ||
        (lv_commander == "Mengsk") || (lv_commander == "TerranMengsk") ||
        (lv_commander == "Tychus") || (lv_commander == "TerranTychus") ||
        (lv_commander == "TychusXM")) {
        lv_expectedRace = "Terran";
    } else if ((lv_commander == "Kerrigan") || (lv_commander == "ZergKerrigan") ||
        (lv_commander == "Abathur") || (lv_commander == "ZergAbathur") ||
        (lv_commander == "Zagara") || (lv_commander == "ZergZagara") ||
        (lv_commander == "Stukov") || (lv_commander == "ZergStukov") ||
        (lv_commander == "Dehaka") || (lv_commander == "ZergDehaka") ||
        (lv_commander == "Stetmann") || (lv_commander == "ZergStetmann")) {
        lv_expectedRace = "Zerg";
    } else if ((lv_commander == "Artanis") || (lv_commander == "ProtossArtanis") ||
        (lv_commander == "Vorazun") || (lv_commander == "ProtossVorazun") ||
        (lv_commander == "Karax") || (lv_commander == "ProtossKarax") ||
        (lv_commander == "Fenix") || (lv_commander == "ProtossFenix") ||
        (lv_commander == "Alarak") || (lv_commander == "ProtossAlarak") ||
        (lv_commander == "Zeratul") || (lv_commander == "ProtossZeratul")) {
        lv_expectedRace = "Protoss";
    }

    // 统计 Player 1 各种族单位
    // 注意：SC2 CatalogFieldValueGet 返回的 Race 值为 "Terr"/"Zerg"/"Prot"，不是 "Terran"/"Zerg"/"Protoss"
    lv_all = UnitGroup(null, 1, RegionEntireMap(),
        UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_total = UnitGroupCount(lv_all, c_unitCountAll);
    lv_zergCount = 0;
    lv_terranCount = 0;
    lv_protossCount = 0;

    lv_i = 1;
    while (lv_i <= lv_total) {
        lv_u = UnitGroupUnit(lv_all, lv_i);
        lv_type = UnitGetType(lv_u);
        lv_race = CatalogFieldValueGet(c_gameCatalogUnit, lv_type, "Race", 1);
        if (lv_race == "Zerg") {
            lv_zergCount = lv_zergCount + 1;
        } else if (lv_race == "Terr") {
            lv_terranCount = lv_terranCount + 1;
        } else if (lv_race == "Prot") {
            lv_protossCount = lv_protossCount + 1;
        }
        lv_i = lv_i + 1;
    }

    // 写入 Bank
    BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_replacement", "expected_commander", lv_commander);
    BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_replacement", "expected_race", lv_expectedRace);
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_replacement", "zerg_units_count", lv_zergCount);
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_replacement", "terran_units_count", lv_terranCount);
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_replacement", "protoss_units_count", lv_protossCount);

    // 判定替换状态
    if (lv_expectedRace == "Terran") {
        if (lv_zergCount > 0) {
            BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_replacement", "status", "FAILED_ZERG_RESIDUAL");
        } else if (lv_terranCount == 0) {
            BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_replacement", "status", "FAILED_NO_TERRAN");
        } else {
            BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_replacement", "status", "SUCCESS");
        }
    } else if (lv_expectedRace == "Protoss") {
        if (lv_zergCount > 0) {
            BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_replacement", "status", "FAILED_ZERG_RESIDUAL");
        } else if (lv_protossCount == 0) {
            BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_replacement", "status", "FAILED_NO_PROTOSS");
        } else {
            BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_replacement", "status", "SUCCESS");
        }
    } else if (lv_expectedRace == "Zerg") {
        // 虫族指挥官：不检查虫族残留，只检查是否有虫族单位
        if (lv_zergCount == 0) {
            BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_replacement", "status", "FAILED_NO_ZERG");
        } else {
            BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_replacement", "status", "SUCCESS");
        }
    } else {
        BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_replacement", "status", "UNKNOWN_RACE");
    }
}

//--------------------------------------------------------------------------------------------------
// Scan production structures: enumerate by type, write probe_producers
// 对每个建筑类型，检查关键生产能力的 UnitOrderIsValid 状态
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_ScanProducers() {
    unitgroup lv_structures;
    int lv_total;
    int lv_unique;
    int lv_i;
    int lv_idx;
    bool lv_found;
    unit lv_u;
    unit lv_sample;
    string lv_type;
    string lv_key;
    string lv_val;
    string lv_trainable;
    int lv_j;
    int lv_k;
    string lv_abil;
    int lv_cmdIdx;
    order lv_order;

    // Clear stale entries so removed producers do not linger in the Bank.
    libRuntimeProbe_gf_ClearBankSection("probe_producers");

    lv_structures = UnitGroup(null, 1, RegionEntireMap(),
        UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_total = UnitGroupCount(lv_structures, c_unitCountAll);
    lv_unique = 0;

    lv_i = 1;
    while (lv_i <= lv_total) {
        lv_u = UnitGroupUnit(lv_structures, lv_i);
        lv_type = UnitGetType(lv_u);

        lv_idx = 1;
        lv_found = false;
        while (lv_idx <= lv_unique) {
            if (libRuntimeProbe_gv_producerTypes[lv_idx] == lv_type) {
                libRuntimeProbe_gv_producerCounts[lv_idx] = libRuntimeProbe_gv_producerCounts[lv_idx] + 1;
                lv_found = true;
                break;
            }
            lv_idx = lv_idx + 1;
        }
        if (!lv_found) {
            if (lv_unique < 127) {
                lv_unique = lv_unique + 1;
                libRuntimeProbe_gv_producerTypes[lv_unique] = lv_type;
                libRuntimeProbe_gv_producerCounts[lv_unique] = 1;
            }
        }
        lv_i = lv_i + 1;
    }

    lv_j = 1;
    while (lv_j <= lv_unique) {
        lv_key = "p_1_" + libRuntimeProbe_gv_producerTypes[lv_j];
        lv_trainable = "";

        // 取该类型的第一个实例作为样本，检测生产能力
        lv_sample = null;
        lv_i = 1;
        while (lv_i <= lv_total) {
            lv_u = UnitGroupUnit(lv_structures, lv_i);
            if (UnitGetType(lv_u) == libRuntimeProbe_gv_producerTypes[lv_j]) {
                lv_sample = lv_u;
                break;
            }
            lv_i = lv_i + 1;
        }

        if (lv_sample != null) {
            // 根据建筑类型检测关键生产能力
            // 注意：AbilityCommand 的 index 对应 InfoArray 的 Train1=0, Train2=1, ...
            // BarracksRaynor: BarracksTrainRaynor (Train1=Marine, Train4=Marauder, Train5=Medic, Train6=Firebat)
            if (libRuntimeProbe_gv_producerTypes[lv_j] == "BarracksRaynor") {
                lv_abil = "BarracksTrainRaynor";
                lv_k = 0;
                while (lv_k <= 7) {
                    lv_order = Order(AbilityCommand(lv_abil, lv_k));
                    if (UnitOrderIsValid(lv_sample, lv_order)) {
                        if (lv_trainable != "") { lv_trainable = lv_trainable + "|"; }
                        lv_trainable = lv_trainable + lv_abil + ":" + IntToString(lv_k);
                    }
                    lv_k = lv_k + 1;
                }
            }
            // OrbitalCommandRaynor / CommandCenterRaynor: CommandCenterTrainRaynor (Train1=SCV)
            else if ((libRuntimeProbe_gv_producerTypes[lv_j] == "OrbitalCommandRaynor") ||
                     (libRuntimeProbe_gv_producerTypes[lv_j] == "CommandCenterRaynor")) {
                lv_abil = "CommandCenterTrainRaynor";
                lv_k = 0;
                while (lv_k <= 3) {
                    lv_order = Order(AbilityCommand(lv_abil, lv_k));
                    if (UnitOrderIsValid(lv_sample, lv_order)) {
                        if (lv_trainable != "") { lv_trainable = lv_trainable + "|"; }
                        lv_trainable = lv_trainable + lv_abil + ":" + IntToString(lv_k);
                    }
                    lv_k = lv_k + 1;
                }
                // 也检查原版 CommandCenterTrain
                lv_abil = "CommandCenterTrain";
                lv_k = 0;
                while (lv_k <= 3) {
                    lv_order = Order(AbilityCommand(lv_abil, lv_k));
                    if (UnitOrderIsValid(lv_sample, lv_order)) {
                        if (lv_trainable != "") { lv_trainable = lv_trainable + "|"; }
                        lv_trainable = lv_trainable + lv_abil + ":" + IntToString(lv_k);
                    }
                    lv_k = lv_k + 1;
                }
            }
            // BarracksRaynorX: 检测 BarracksTrainRaynorX (RaynorX 版本生产能力)
            else if (libRuntimeProbe_gv_producerTypes[lv_j] == "BarracksRaynorX") {
                lv_abil = "BarracksTrainRaynorX";
                lv_k = 0;
                while (lv_k <= 7) {
                    lv_order = Order(AbilityCommand(lv_abil, lv_k));
                    if (UnitOrderIsValid(lv_sample, lv_order)) {
                        if (lv_trainable != "") { lv_trainable = lv_trainable + "|"; }
                        lv_trainable = lv_trainable + lv_abil + ":" + IntToString(lv_k);
                    }
                    lv_k = lv_k + 1;
                }
            }
            // Barracks (原版，已被 TechFilter 屏蔽原版单位，trainable 预期为空)
            else if (libRuntimeProbe_gv_producerTypes[lv_j] == "Barracks") {
                lv_abil = "BarracksTrain";
                lv_k = 0;
                while (lv_k <= 7) {
                    lv_order = Order(AbilityCommand(lv_abil, lv_k));
                    if (UnitOrderIsValid(lv_sample, lv_order)) {
                        if (lv_trainable != "") { lv_trainable = lv_trainable + "|"; }
                        lv_trainable = lv_trainable + lv_abil + ":" + IntToString(lv_k);
                    }
                    lv_k = lv_k + 1;
                }
            }
        }

        lv_val = "producer_count:" + IntToString(libRuntimeProbe_gv_producerCounts[lv_j]) +
            ",trainable:" + lv_trainable +
            ",blocked:,queue:,last_order:None";
        BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_producers", lv_key, lv_val);
        lv_j = lv_j + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Scan tech availability: check if key Raynor abilities are allowed
// Uses TechTreeAbilityIsAllowed to check build/train/research abilities
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_ScanTechAvailability() {
    int lv_i;
    int lv_allowed;
    int lv_count;
    string lv_key;
    string lv_abil;
    int lv_cmdIdx;
    string[32] lv_abilNames;
    int[32] lv_abilMaxCmd;
    string[32] lv_upgrades;

    // Clear stale entries
    libRuntimeProbe_gf_ClearBankSection("probe_tech");

    // Check key build/train/research abilities via TechTreeAbilityIsAllowed
    // Each entry: ability name + max cmd index to check
    lv_abilNames[1] = "TerranBuildRaynor";          lv_abilMaxCmd[1] = 16;
    lv_abilNames[2] = "BarracksTrainRaynor";         lv_abilMaxCmd[2] = 5;
    lv_abilNames[3] = "BarracksTrainRaynorX";        lv_abilMaxCmd[3] = 6;
    lv_abilNames[4] = "FactoryTrainRaynor";          lv_abilMaxCmd[4] = 9;
    lv_abilNames[5] = "StarportTrainRaynor";         lv_abilMaxCmd[5] = 4;
    lv_abilNames[6] = "EngineeringBayResearchRaynor"; lv_abilMaxCmd[6] = 21;
    lv_abilNames[7] = "ArmoryResearchRaynor";        lv_abilMaxCmd[7] = 9;
    lv_abilNames[8] = "BarracksTechLabResearchRaynor"; lv_abilMaxCmd[8] = 15;
    lv_abilNames[9] = "FactoryTechLabResearchRaynor"; lv_abilMaxCmd[9] = 15;
    lv_abilNames[10] = "StarportTechLabResearchRaynor"; lv_abilMaxCmd[10] = 18;
    lv_abilNames[11] = "CommandCenterTrainRaynor";   lv_abilMaxCmd[11] = 0;
    lv_abilNames[12] = "UpgradeToOrbitalRaynor";     lv_abilMaxCmd[12] = 0;
    lv_abilNames[13] = "BarracksAddOnsRaynor";       lv_abilMaxCmd[13] = 3;
    lv_abilNames[14] = "FactoryAddOnsRaynor";        lv_abilMaxCmd[14] = 3;
    lv_abilNames[15] = "StarportAddOnsRaynor";       lv_abilMaxCmd[15] = 3;

    lv_i = 1;
    while (lv_i <= 15) {
        lv_abil = lv_abilNames[lv_i];
        if (lv_abil != "" && CatalogEntryIsValid(c_gameCatalogAbil, lv_abil)) {
            lv_cmdIdx = 0;
            while (lv_cmdIdx <= lv_abilMaxCmd[lv_i]) {
                if (TechTreeAbilityIsAllowed(1, AbilityCommand(lv_abil, lv_cmdIdx))) {
                    lv_key = "a_" + lv_abil + "_" + IntToString(lv_cmdIdx);
                    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_tech", lv_key, 1);
                }
                lv_cmdIdx = lv_cmdIdx + 1;
            }
        }
        lv_i = lv_i + 1;
    }

    // Check key upgrade availability (researched count)
    lv_upgrades[1] = "Stimpack";
    lv_upgrades[2] = "ShieldWall";
    lv_upgrades[3] = "TerranInfantryWeaponsLevel1";
    lv_upgrades[4] = "TerranInfantryArmorsLevel1";
    lv_upgrades[5] = "TerranVehicleAndShipWeaponsLevel1";
    lv_upgrades[6] = "TerranVehicleAndShipPlatingLevel1";
    lv_upgrades[7] = "HiSecAutoTracking";
    lv_upgrades[8] = "NeosteelFrame";
    lv_upgrades[9] = "BuildingArmor";
    lv_upgrades[10] = "RaynorCommanderStimUpgrade";
    lv_upgrades[11] = "RaynorFirebatMedicRange";
    lv_upgrades[12] = "RaynorUnlockBattlecruiser";

    lv_i = 1;
    while (lv_i <= 12) {
        if (lv_upgrades[lv_i] != "" && CatalogEntryIsValid(c_gameCatalogUpgrade, lv_upgrades[lv_i])) {
            lv_count = TechTreeUpgradeCount(1, lv_upgrades[lv_i], c_techCountCompleteOnly);
            BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_tech", "up_" + lv_upgrades[lv_i], lv_count);
        }
        lv_i = lv_i + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// ScanUI: 采集 GlobalCastingPanel 顶部技能面板的 UI 控件状态
// 注意: 只能使用 DialogControlHookupStandard（标准路径，只读），不能用 DialogControlHookup
//       DialogControlHookup 会修改控件关联状态，导致 "已经被关联...无法再次被关联" 错误
// 写入 probe_ui section:
//   gp_holder_id, gp_holder_exists, gp_holder_visible (GlobalCastingPanel holder)
//   army_btn_id, army_btn_exists, army_btn_visible (ArmySelectButton)
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_ScanUI() {
    int lv_holder;
    int lv_btn;

    if (libRuntimeProbe_gv_bank == null) {
        return;
    }

    libRuntimeProbe_gf_ClearBankSection("probe_ui");

    // 1. GlobalCastingPanel holder (Lib67C0F0E7 行 2150-2154 获取)
    DialogControlHookupStandard(c_triggerControlTypePanel, "UIContainer/FullscreenUpperContainer/GlobalCastingPanel");
    lv_holder = DialogControlLastCreated();
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_ui", "gp_holder_id", lv_holder);
    BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui", "gp_holder_exists", (lv_holder != c_invalidDialogControlId));
    // 可见性检查: GPShowHide(true) 后 holder 应可见
    if (lv_holder != c_invalidDialogControlId) {
        BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui", "gp_holder_visible", DialogControlIsVisible(lv_holder, 1));
    }

    // 2. ArmySelectButton (Lib67C0F0E7 行 1490 中 gf_ShowChooseButton hookup)
    //    如果此按钮存在，说明 gf_ShowChooseButton 已执行，即 GPInit 流程已完成
    DialogControlHookupStandard(c_triggerControlTypeButton, "UIContainer/ConsoleUIContainer/ArmySelectButton");
    lv_btn = DialogControlLastCreated();
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_ui", "army_btn_id", lv_btn);
    BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui", "army_btn_exists", (lv_btn != c_invalidDialogControlId));
    if (lv_btn != c_invalidDialogControlId) {
        BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui", "army_btn_visible", DialogControlIsVisible(lv_btn, 1));
    }
}

//--------------------------------------------------------------------------------------------------
// Periodic loop: Wait 循环实现周期性全量扫描 + 批量 BankSave
// 不使用 TriggerAddEventTimePeriodic（7vs1 地图中不触发），改用 Wait(3.0, c_timeReal) 循环
// 与 7vs1 地图自身模式一致（gt_StartGame_Func 大量使用 Wait + c_timeReal）
// 由 StartProbe 通过 TriggerExecute(libRuntimeProbe_gt_Loop, false, false) 异步启动
//--------------------------------------------------------------------------------------------------
bool libRuntimeProbe_gt_Loop_Func(bool testConds, bool runActions) {
    if (testConds) {
        return true;
    }
    if (!runActions) {
        return true;
    }

    // 等待游戏初始化完成（跳过 cinematic/briefing 阶段）
    Wait(5.0, c_timeReal);

    while (true) {
        if (libRuntimeProbe_gf_TryLoadBank()) {
            libRuntimeProbe_gf_WriteState();
            libRuntimeProbe_gf_ScanUnits();
            libRuntimeProbe_gf_ScanUpgrades();
            libRuntimeProbe_gf_ScanProducers();
            libRuntimeProbe_gf_ScanReplacement();
            libRuntimeProbe_gf_ScanTechAvailability();
            libRuntimeProbe_gf_ScanUI();
            BankSave(libRuntimeProbe_gv_bank);
        }
        Wait(3.0, c_timeReal);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// MapInit: try BankLoad immediately (Loop trigger is created in InitLib, started by StartProbe).
//--------------------------------------------------------------------------------------------------
bool libRuntimeProbe_gt_MapInit_Func(bool testConds, bool runActions) {
    if (testConds) {
        return true;
    }
    if (runActions) {
        // Try to load the bank during MapInit (in case InitLib's BankLoad failed).
        libRuntimeProbe_gf_TryLoadBank();
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// StartProbe: perform an immediate state write and start the periodic loop.
// Called from gt_Initialization_Func (injected by launch script) after
// InitializeConfiguredMapScenario completes.
//
// 首次全量扫描后，异步启动 Loop_Func（Wait 循环），不阻塞调用方。
// Loop_Func 内部先 Wait(5.0, c_timeReal) 等待游戏初始化，然后每 3 秒扫描一次。
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_StartProbe() {
    if (!libRuntimeProbe_initialized) {
        libRuntimeProbe_InitLib();
    }

    // Immediate state write so the Bank has fresh data right away.
    if (libRuntimeProbe_gf_TryLoadBank()) {
        BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_state", "run_id", "startprobe");
        BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_state", "phase", "probe_started");
        libRuntimeProbe_gf_WriteState();
        libRuntimeProbe_gf_ScanUnits();
        libRuntimeProbe_gf_ScanUpgrades();
        libRuntimeProbe_gf_ScanProducers();
        libRuntimeProbe_gf_ScanReplacement();
        libRuntimeProbe_gf_ScanTechAvailability();
        libRuntimeProbe_gf_ScanUI();
        BankSave(libRuntimeProbe_gv_bank);
    }

    // 异步启动 Wait 循环（不等待完成），由 Loop_Func 周期性扫描
    TriggerExecute(libRuntimeProbe_gt_Loop, false, false);
}

//--------------------------------------------------------------------------------------------------
// InitLib: create triggers and attempt BankLoad.
// 不再注册 TriggerAddEventTimePeriodic（7vs1 地图中不触发）。
// Loop_Func 由 StartProbe 通过 TriggerExecute 异步启动，使用 Wait 循环实现周期性扫描。
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_InitLib() {
    if (libRuntimeProbe_initialized) {
        return;
    }
    libRuntimeProbe_gt_MapInit = TriggerCreate("libRuntimeProbe_gt_MapInit_Func");
    TriggerAddEventMapInit(libRuntimeProbe_gt_MapInit);
    libRuntimeProbe_gt_Loop = TriggerCreate("libRuntimeProbe_gt_Loop_Func");

    // Direct BankLoad attempt during InitLib — verifies the Bank system is operational.
    libRuntimeProbe_gv_bank = BankLoad("RuntimeProbe", 1);
    if (libRuntimeProbe_gv_bank != null) {
        libRuntimeProbe_gv_heartbeat = 1;
        BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_state", "run_id", "initlib");
        BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_state", "phase", "initlib_ok");
        BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "heartbeat", libRuntimeProbe_gv_heartbeat);
        BankSave(libRuntimeProbe_gv_bank);
    }

    libRuntimeProbe_initialized = true;
}
