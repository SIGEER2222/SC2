include "TriggerLibs/natives"
include "LibRuntimeProbe_h"

//--------------------------------------------------------------------------------------------------
// RuntimeProbe Phase 1+2 Implementation
// Writes runtime diagnostics to RuntimeProbe.SC2Bank for external Python probe runner.
// All Bank keys/values use ASCII to avoid Galaxy encoding issues.
//
// Design note: BankLoad is performed in the periodic Tick trigger (not MapInit) because
// libRuntimeProbe_InitLib() is called early in InitLibs(), making our MapInit trigger the
// FIRST to fire — before gt_InitializeBank / gt_Initialization. At that point player data
// may not be fully initialized and BankLoad can return null. The Tick trigger fires every
// 1 second during gameplay, by which time the game is fully initialized.
//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
// Try to load the Bank. Returns true on success.
// Called from the Tick trigger until the bank is successfully loaded.
//--------------------------------------------------------------------------------------------------
bool libRuntimeProbe_gf_TryLoadBank() {
    if (libRuntimeProbe_gv_bank != null) {
        return true;
    }
    libRuntimeProbe_gv_bank = BankLoad("RuntimeProbe", 1);
    if (libRuntimeProbe_gv_bank == null) {
        return false;
    }
    // Initial state markers
    BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_state", "run_id", "pending");
    BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_state", "phase", "loading");
    BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_state", "is_in_mission", false);
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "heartbeat", 1);
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "unit_scan_id", 0);
    BankSave(libRuntimeProbe_gv_bank);
    return true;
}

//--------------------------------------------------------------------------------------------------
// Write probe_state: heartbeat, game time, resources, supply
// 不再单独 BankSave，由调用方批量保存
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_WriteState() {
    int lv_player = 1;

    libRuntimeProbe_gv_heartbeat = libRuntimeProbe_gv_heartbeat + 1;
    if (libRuntimeProbe_gv_heartbeat > 999999) {
        libRuntimeProbe_gv_heartbeat = 1;
    }

    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "heartbeat", libRuntimeProbe_gv_heartbeat);
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "game_time", FixedToInt(GameGetMissionTime()));
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "game_loop", FixedToInt(GameGetMissionTime() * 16.0));
    BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_state", "phase", "in_mission");
    BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_state", "is_in_mission", true);
    BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_state", "is_paused", false);
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "player_id", lv_player);
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "minerals", PlayerGetPropertyInt(lv_player, c_playerPropMinerals));
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "gas", PlayerGetPropertyInt(lv_player, c_playerPropVespene));
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "supply_used", PlayerGetPropertyInt(lv_player, c_playerPropSuppliesUsed));
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "supply_cap", PlayerGetPropertyInt(lv_player, c_playerPropSuppliesMade));
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "script_error_count", 0);
}

//--------------------------------------------------------------------------------------------------
// Scan all units for player 1, aggregate by type, write probe_units
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_ScanUnits() {
    unitgroup lv_all;
    int lv_total;
    int lv_unique;
    int lv_i;
    int lv_idx;
    bool lv_found;
    unit lv_u;
    string lv_type;
    fixed lv_life;
    fixed lv_energy;
    string lv_key;
    string lv_val;
    int lv_avgLife;
    int lv_avgEnergy;
    int lv_j;

    libRuntimeProbe_gv_scanId = libRuntimeProbe_gv_scanId + 1;

    lv_all = UnitGroup(null, 1, RegionEntireMap(), UnitFilter(0, 0, (1 << 0), (1 << 1)), 0);
    lv_total = UnitGroupCount(lv_all, c_unitCountAll);
    lv_unique = 0;

    // Reset arrays for this scan
    lv_i = 1;
    while (lv_i <= 255) {
        libRuntimeProbe_gv_unitTypes[lv_i] = "";
        libRuntimeProbe_gv_unitCounts[lv_i] = 0;
        lv_i = lv_i + 1;
    }

    lv_i = 1;
    while (lv_i <= lv_total) {
        lv_u = UnitGroupUnit(lv_all, lv_i);
        lv_type = UnitGetType(lv_u);
        lv_life = UnitGetPropertyFixed(lv_u, c_unitPropLife, c_unitPropCurrent);
        lv_energy = UnitGetPropertyFixed(lv_u, c_unitPropEnergy, c_unitPropCurrent);

        lv_idx = 1;
        lv_found = false;
        while (lv_idx <= lv_unique) {
            if (libRuntimeProbe_gv_unitTypes[lv_idx] == lv_type) {
                libRuntimeProbe_gv_unitCounts[lv_idx] = libRuntimeProbe_gv_unitCounts[lv_idx] + 1;
                libRuntimeProbe_gv_unitLifeSum[lv_idx] = libRuntimeProbe_gv_unitLifeSum[lv_idx] + FixedToInt(lv_life);
                libRuntimeProbe_gv_unitEnergySum[lv_idx] = libRuntimeProbe_gv_unitEnergySum[lv_idx] + FixedToInt(lv_energy);
                lv_found = true;
                break;
            }
            lv_idx = lv_idx + 1;
        }
        if (!lv_found) {
            if (lv_unique < 255) {
                lv_unique = lv_unique + 1;
                libRuntimeProbe_gv_unitTypes[lv_unique] = lv_type;
                libRuntimeProbe_gv_unitCounts[lv_unique] = 1;
                libRuntimeProbe_gv_unitLifeSum[lv_unique] = FixedToInt(lv_life);
                libRuntimeProbe_gv_unitEnergySum[lv_unique] = FixedToInt(lv_energy);
            }
        }
        lv_i = lv_i + 1;
    }

    lv_j = 1;
    while (lv_j <= lv_unique) {
        lv_key = "u_1_" + libRuntimeProbe_gv_unitTypes[lv_j];
        lv_avgLife = 0;
        lv_avgEnergy = 0;
        if (libRuntimeProbe_gv_unitCounts[lv_j] > 0) {
            lv_avgLife = libRuntimeProbe_gv_unitLifeSum[lv_j] / libRuntimeProbe_gv_unitCounts[lv_j];
            lv_avgEnergy = libRuntimeProbe_gv_unitEnergySum[lv_j] / libRuntimeProbe_gv_unitCounts[lv_j];
        }
        lv_val = "count:" + IntToString(libRuntimeProbe_gv_unitCounts[lv_j]) +
            ",completed:" + IntToString(libRuntimeProbe_gv_unitCounts[lv_j]) +
            ",in_progress:0" +
            ",life_avg:" + IntToString(lv_avgLife) + ".0" +
            ",energy_avg:" + IntToString(lv_avgEnergy) + ".0" +
            ",owner:1,is_structure:0,is_worker:0" +
            ",scan_id:" + IntToString(libRuntimeProbe_gv_scanId);
        BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_units", lv_key, lv_val);
        lv_j = lv_j + 1;
    }

    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "unit_scan_id", libRuntimeProbe_gv_scanId);
}

//--------------------------------------------------------------------------------------------------
// Scan upgrades: iterate upgrade catalog, write researched upgrades
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_ScanUpgrades() {
    int lv_count;
    int lv_i;
    string lv_upgradeId;
    int lv_resCount;
    string lv_key;
    string lv_val;

    lv_count = CatalogEntryCount(c_gameCatalogUpgrade);
    lv_i = 1;
    while (lv_i <= lv_count) {
        lv_upgradeId = CatalogEntryGet(c_gameCatalogUpgrade, lv_i);
        if (CatalogEntryIsValid(c_gameCatalogUpgrade, lv_upgradeId)) {
            lv_resCount = TechTreeUpgradeCount(1, lv_upgradeId, c_techCountCompleteOnly);
            if (lv_resCount > 0) {
                lv_key = "up_1_" + lv_upgradeId;
                lv_val = "upgrade_id:" + lv_upgradeId +
                    ",researched:1,in_progress:0,available:1,blocked_reason:None";
                BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_upgrades", lv_key, lv_val);
            }
        }
        lv_i = lv_i + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Scan production structures: enumerate by type, write probe_producers
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_ScanProducers() {
    unitgroup lv_structures;
    int lv_total;
    int lv_unique;
    int lv_i;
    int lv_idx;
    bool lv_found;
    unit lv_u;
    string lv_type;
    string lv_key;
    string lv_val;
    int lv_j;

    lv_structures = UnitGroup(null, 1, RegionEntireMap(),
        UnitFilter((1 << c_targetFilterStructure), 0, (1 << 0), (1 << 1)), 0);
    lv_total = UnitGroupCount(lv_structures, c_unitCountAll);
    lv_unique = 0;

    lv_i = 1;
    while (lv_i <= lv_total) {
        lv_u = UnitGroupUnit(lv_structures, lv_i);
        lv_type = UnitGetType(lv_u);

        lv_idx = 1;
        lv_found = false;
        while (lv_idx <= lv_unique) {
            if (libRuntimeProbe_gv_producerTypes[lv_idx] == lv_type) {
                libRuntimeProbe_gv_producerCounts[lv_idx] = libRuntimeProbe_gv_producerCounts[lv_idx] + 1;
                lv_found = true;
                break;
            }
            lv_idx = lv_idx + 1;
        }
        if (!lv_found) {
            if (lv_unique < 127) {
                lv_unique = lv_unique + 1;
                libRuntimeProbe_gv_producerTypes[lv_unique] = lv_type;
                libRuntimeProbe_gv_producerCounts[lv_unique] = 1;
            }
        }
        lv_i = lv_i + 1;
    }

    lv_j = 1;
    while (lv_j <= lv_unique) {
        lv_key = "p_1_" + libRuntimeProbe_gv_producerTypes[lv_j];
        lv_val = "producer_count:" + IntToString(libRuntimeProbe_gv_producerCounts[lv_j]) +
            ",trainable:,blocked:,queue:,last_order:None";
        BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_producers", lv_key, lv_val);
        lv_j = lv_j + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Periodic tick: 全量扫描 + 批量 BankSave
// 每 3 秒触发一次（由 StartProbe 注册的 TriggerAddEventTimePeriodic 控制）
// 所有 BankValueSet 调用完成后，只调用一次 BankSave
//--------------------------------------------------------------------------------------------------
bool libRuntimeProbe_gt_Tick_Func(bool testConds, bool runActions) {
    if (testConds) {
        return true;
    }
    if (runActions) {
        if (!libRuntimeProbe_gf_TryLoadBank()) {
            return true;
        }

        libRuntimeProbe_gf_WriteState();
        libRuntimeProbe_gf_ScanUnits();
        libRuntimeProbe_gf_ScanUpgrades();
        libRuntimeProbe_gf_ScanProducers();

        // 批量保存：整个 tick 只写一次磁盘
        BankSave(libRuntimeProbe_gv_bank);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// MapInit: try BankLoad immediately (tick trigger is already registered in InitLib).
//--------------------------------------------------------------------------------------------------
bool libRuntimeProbe_gt_MapInit_Func(bool testConds, bool runActions) {
    if (testConds) {
        return true;
    }
    if (runActions) {
        // Try to load the bank during MapInit (in case InitLib's BankLoad failed).
        libRuntimeProbe_gf_TryLoadBank();
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// StartProbe: register the periodic tick and perform an immediate state write.
// Called from gt_Initialization_Func (injected by launch-runtime-probe.ps1) after
// the game is fully initialized.
//
// 持续扫描模式：每 3 秒执行一次全量扫描（units + upgrades + producers），
// heartbeat 每 tick 更新。BankSave 在 tick 结束时只调用一次（批量化）。
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_StartProbe() {
    if (!libRuntimeProbe_initialized) {
        libRuntimeProbe_InitLib();
    }

    // 注册周期性 tick（3 秒一次，c_timeGame 在 briefing 期间不推进，但进入任务后正常）
    TriggerAddEventTimePeriodic(libRuntimeProbe_gt_Tick, 3.0, c_timeGame);

    // Immediate state write so the Bank has fresh data right away.
    if (libRuntimeProbe_gf_TryLoadBank()) {
        BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_state", "run_id", "startprobe");
        BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_state", "phase", "probe_started");
        libRuntimeProbe_gf_WriteState();
        libRuntimeProbe_gf_ScanUnits();
        libRuntimeProbe_gf_ScanUpgrades();
        libRuntimeProbe_gf_ScanProducers();
        BankSave(libRuntimeProbe_gv_bank);
    }
}

//--------------------------------------------------------------------------------------------------
// InitLib: create triggers and attempt BankLoad.
// Periodic tick registration is deferred to StartProbe() which is called from
// gt_Initialization_Func after the game is fully initialized.
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_InitLib() {
    if (libRuntimeProbe_initialized) {
        return;
    }
    libRuntimeProbe_gt_MapInit = TriggerCreate("libRuntimeProbe_gt_MapInit_Func");
    TriggerAddEventMapInit(libRuntimeProbe_gt_MapInit);
    libRuntimeProbe_gt_Tick = TriggerCreate("libRuntimeProbe_gt_Tick_Func");

    // Direct BankLoad attempt during InitLib — verifies the Bank system is operational.
    libRuntimeProbe_gv_bank = BankLoad("RuntimeProbe", 1);
    if (libRuntimeProbe_gv_bank != null) {
        libRuntimeProbe_gv_heartbeat = 1;
        BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_state", "run_id", "initlib");
        BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_state", "phase", "initlib_ok");
        BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "heartbeat", libRuntimeProbe_gv_heartbeat);
        BankSave(libRuntimeProbe_gv_bank);
    }

    libRuntimeProbe_initialized = true;
}
