include "TriggerLibs/natives"
include "LibRuntimeProbe_h"

//--------------------------------------------------------------------------------------------------
// RuntimeProbe Phase 1+2 Implementation
// Writes runtime diagnostics to RuntimeProbe.SC2Bank for external Python probe runner.
// All Bank keys/values use ASCII to avoid Galaxy encoding issues.
//
// 架构说明：
// - 使用引擎周期事件实现周期性扫描，不占用额外的 Wait 线程
// - c_timeReal 不受 cinematic/briefing 影响，确保循环在过场动画期间也能执行
// - StartProbe() 在 gt_Initialization_Func 中调用，执行首次全量扫描并注册周期事件
//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
// Try to load the Bank. Returns true on success.
// Called from the Tick trigger until the bank is successfully loaded.
//--------------------------------------------------------------------------------------------------
bool libRuntimeProbe_gf_TryLoadBank() {
    if (libRuntimeProbe_gv_bank != null) {
        return true;
    }
    libRuntimeProbe_gv_bank = BankLoad("RuntimeProbe", 1);
    if (libRuntimeProbe_gv_bank == null) {
        return false;
    }
    // Drop the prior state schema so removed diagnostic keys (including heartbeat) cannot
    // survive across launches in the persistent SC2 Bank file.
    libRuntimeProbe_gf_ClearBankSection("probe_state");
    // Initial state markers
    BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_state", "run_id", "pending");
    BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_state", "phase", "loading");
    BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_state", "is_in_mission", false);
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "unit_scan_id", 0);
    BankSave(libRuntimeProbe_gv_bank);
    return true;
}

//--------------------------------------------------------------------------------------------------
// Write probe_state: game time, resources, supply
// 不再单独 BankSave，由调用方批量保存
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_WriteState() {
    int lv_player = 1;

    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "game_time", FixedToInt(GameGetMissionTime()));
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "game_loop", FixedToInt(GameGetMissionTime() * 16.0));
    BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_state", "phase", "in_mission");
    BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_state", "is_in_mission", true);
    BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_state", "is_paused", false);
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "player_id", lv_player);
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "minerals", PlayerGetPropertyInt(lv_player, c_playerPropMinerals));
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "gas", PlayerGetPropertyInt(lv_player, c_playerPropVespene));
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "supply_used", PlayerGetPropertyInt(lv_player, c_playerPropSuppliesUsed));
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "supply_cap", PlayerGetPropertyInt(lv_player, c_playerPropSuppliesMade));
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "script_error_count", 0);
}

//--------------------------------------------------------------------------------------------------
// Clear all keys in a Bank section before writing fresh scan data.
// Prevents stale entries (e.g. removed units) from polluting the Bank.
// Uses BankSectionRemove for atomic deletion (逐个 BankKeyRemove 会导致触发器错误).
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_ClearBankSection(string lp_section) {
    if (libRuntimeProbe_gv_bank == null) {
        return;
    }
    if (!BankSectionExists(libRuntimeProbe_gv_bank, lp_section)) {
        return;
    }
    BankSectionRemove(libRuntimeProbe_gv_bank, lp_section);
}

//--------------------------------------------------------------------------------------------------
// Scan all units for player 1 and player 2, aggregate by type, write probe_units
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_ScanUnits() {
    unitgroup lv_all;
    int lv_total;
    int lv_unique;
    int lv_i;
    int lv_idx;
    bool lv_found;
    unit lv_u;
    string lv_type;
    fixed lv_life;
    fixed lv_energy;
    string lv_key;
    string lv_val;
    int lv_avgLife;
    int lv_avgEnergy;
    int lv_j;
    int lv_player;

    libRuntimeProbe_gv_scanId = libRuntimeProbe_gv_scanId + 1;

    libRuntimeProbe_gf_ClearBankSection("probe_units");

    for (lv_player = 1; lv_player <= 2; lv_player += 1) {
        lv_all = UnitGroup(null, lv_player, RegionEntireMap(),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_total = UnitGroupCount(lv_all, c_unitCountAll);
        lv_unique = 0;

        lv_i = 1;
        while (lv_i <= 255) {
            libRuntimeProbe_gv_unitTypes[lv_i] = "";
            libRuntimeProbe_gv_unitCounts[lv_i] = 0;
            lv_i = lv_i + 1;
        }

        lv_i = 1;
        while (lv_i <= lv_total) {
            lv_u = UnitGroupUnit(lv_all, lv_i);
            lv_type = UnitGetType(lv_u);
            lv_life = UnitGetPropertyFixed(lv_u, c_unitPropLife, c_unitPropCurrent);
            lv_energy = UnitGetPropertyFixed(lv_u, c_unitPropEnergy, c_unitPropCurrent);

            lv_idx = 1;
            lv_found = false;
            while (lv_idx <= lv_unique) {
                if (libRuntimeProbe_gv_unitTypes[lv_idx] == lv_type) {
                    libRuntimeProbe_gv_unitCounts[lv_idx] = libRuntimeProbe_gv_unitCounts[lv_idx] + 1;
                    libRuntimeProbe_gv_unitLifeSum[lv_idx] = libRuntimeProbe_gv_unitLifeSum[lv_idx] + FixedToInt(lv_life);
                    libRuntimeProbe_gv_unitEnergySum[lv_idx] = libRuntimeProbe_gv_unitEnergySum[lv_idx] + FixedToInt(lv_energy);
                    lv_found = true;
                    break;
                }
                lv_idx = lv_idx + 1;
            }
            if (!lv_found) {
                if (lv_unique < 255) {
                    lv_unique = lv_unique + 1;
                    libRuntimeProbe_gv_unitTypes[lv_unique] = lv_type;
                    libRuntimeProbe_gv_unitCounts[lv_unique] = 1;
                    libRuntimeProbe_gv_unitLifeSum[lv_unique] = FixedToInt(lv_life);
                    libRuntimeProbe_gv_unitEnergySum[lv_unique] = FixedToInt(lv_energy);
                }
            }
            lv_i = lv_i + 1;
        }

        lv_j = 1;
        while (lv_j <= lv_unique) {
            lv_key = "u_" + IntToString(lv_player) + "_" + libRuntimeProbe_gv_unitTypes[lv_j];
            lv_avgLife = 0;
            lv_avgEnergy = 0;
            if (libRuntimeProbe_gv_unitCounts[lv_j] > 0) {
                lv_avgLife = libRuntimeProbe_gv_unitLifeSum[lv_j] / libRuntimeProbe_gv_unitCounts[lv_j];
                lv_avgEnergy = libRuntimeProbe_gv_unitEnergySum[lv_j] / libRuntimeProbe_gv_unitCounts[lv_j];
            }
            lv_val = "count:" + IntToString(libRuntimeProbe_gv_unitCounts[lv_j]) +
                ",completed:" + IntToString(libRuntimeProbe_gv_unitCounts[lv_j]) +
                ",in_progress:0" +
                ",life_avg:" + IntToString(lv_avgLife) + ".0" +
                ",energy_avg:" + IntToString(lv_avgEnergy) + ".0" +
                ",owner:" + IntToString(lv_player) + ",is_structure:0,is_worker:0" +
                ",scan_id:" + IntToString(libRuntimeProbe_gv_scanId);
            BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_units", lv_key, lv_val);
            lv_j = lv_j + 1;
        }
    }

    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_state", "unit_scan_id", libRuntimeProbe_gv_scanId);
}

//--------------------------------------------------------------------------------------------------
// Alenger3 Unit Presence Probe: per-player breakdown of key unit types
// Includes: 3diguoqianshaojidi, 3diguolaogong, 3diguojianzhengzhe, Marine, CommandCenter, SCV
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_ScanAlengerPresence() {
    int lv_count;
    string lv_context;
    unitgroup lv_units;
    int lv_player;

    lv_context = "";
    for (lv_player = 1; lv_player <= 2; lv_player += 1) {
        if (lv_player == 1) {
            lv_context = "p1:";
        } else {
            lv_context = lv_context + "; p2:";
        }
        lv_units = UnitGroup("Marine", lv_player, RegionEntireMap(),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_count = UnitGroupCount(lv_units, c_unitCountAll);
        lv_context = lv_context + "Marine=" + IntToString(lv_count);

        lv_units = UnitGroup("3diguoqianshaojidi", lv_player, RegionEntireMap(),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_count = UnitGroupCount(lv_units, c_unitCountAll);
        lv_context = lv_context + ",3diguoqianshaojidi=" + IntToString(lv_count);

        lv_units = UnitGroup("3diguolaogong", lv_player, RegionEntireMap(),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_count = UnitGroupCount(lv_units, c_unitCountAll);
        lv_context = lv_context + ",3diguolaogong=" + IntToString(lv_count);

        lv_units = UnitGroup("3diguojianzhengzhe", lv_player, RegionEntireMap(),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_count = UnitGroupCount(lv_units, c_unitCountAll);
        lv_context = lv_context + ",3diguojianzhengzhe=" + IntToString(lv_count);

        lv_units = UnitGroup("CommandCenter", lv_player, RegionEntireMap(),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_count = UnitGroupCount(lv_units, c_unitCountAll);
        lv_context = lv_context + ",CommandCenter=" + IntToString(lv_count);

        lv_units = UnitGroup("SCV", lv_player, RegionEntireMap(),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_count = UnitGroupCount(lv_units, c_unitCountAll);
        lv_context = lv_context + ",SCV=" + IntToString(lv_count);

        lv_units = UnitGroup("3diguobingying", lv_player, RegionEntireMap(),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_count = UnitGroupCount(lv_units, c_unitCountAll);
        lv_context = lv_context + ",3diguobingying=" + IntToString(lv_count);

        lv_units = UnitGroup("3diguogongchang", lv_player, RegionEntireMap(),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_count = UnitGroupCount(lv_units, c_unitCountAll);
        lv_context = lv_context + ",3diguogongchang=" + IntToString(lv_count);

        lv_units = UnitGroup("3diguoxinggang", lv_player, RegionEntireMap(),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_count = UnitGroupCount(lv_units, c_unitCountAll);
        lv_context = lv_context + ",3diguoxinggang=" + IntToString(lv_count);

        lv_units = UnitGroup("3diguogongchengzhan", lv_player, RegionEntireMap(),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_count = UnitGroupCount(lv_units, c_unitCountAll);
        lv_context = lv_context + ",3diguogongchengzhan=" + IntToString(lv_count);

        lv_units = UnitGroup("3huangjiayaosai", lv_player, RegionEntireMap(),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_count = UnitGroupCount(lv_units, c_unitCountAll);
        lv_context = lv_context + ",3huangjiayaosai=" + IntToString(lv_count);

        lv_units = UnitGroup("3diguozhihuizhongxin", lv_player, RegionEntireMap(),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_count = UnitGroupCount(lv_units, c_unitCountAll);
        lv_context = lv_context + ",3diguozhihuizhongxin=" + IntToString(lv_count);

        lv_units = UnitGroup("3diguochongfengdui", lv_player, RegionEntireMap(),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_count = UnitGroupCount(lv_units, c_unitCountAll);
        lv_context = lv_context + ",3diguochongfengdui=" + IntToString(lv_count);

        lv_units = UnitGroup("3huoyanchongfengdui", lv_player, RegionEntireMap(),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_count = UnitGroupCount(lv_units, c_unitCountAll);
        lv_context = lv_context + ",3huoyanchongfengdui=" + IntToString(lv_count);

        lv_units = UnitGroup("3fengbaochongfengdui", lv_player, RegionEntireMap(),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_count = UnitGroupCount(lv_units, c_unitCountAll);
        lv_context = lv_context + ",3fengbaochongfengdui=" + IntToString(lv_count);
    }

    lv_context = lv_context + "; commander_p1=unknown; commander_p2=unknown";

    BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_alenger", "unit_presence", lv_context);
}

//--------------------------------------------------------------------------------------------------
// Alenger3 Structure Probe: building count, worker count, and training ability verification
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_ScanAlengerStructures() {
    string lv_structureType = "3diguoqianshaojidi";
    string lv_workerType = "3diguolaogong";
    unitgroup lv_structs;
    unitgroup lv_workers;
    unit lv_producer;
    int lv_structCount;
    int lv_workerCount;
    bool lv_canTrain;
    order lv_trainOrder;
    string lv_context;
    string lv_canTrainStr;

    lv_structs = UnitGroup(lv_structureType, c_playerAny, RegionEntireMap(),
        UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_structCount = UnitGroupCount(lv_structs, c_unitCountAll);

    lv_workers = UnitGroup(lv_workerType, c_playerAny, RegionEntireMap(),
        UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_workerCount = UnitGroupCount(lv_workers, c_unitCountAll);

    lv_canTrain = false;
    if (lv_structCount > 0) {
        lv_producer = UnitGroupUnit(lv_structs, 1);
        if (lv_producer != null) {
            lv_trainOrder = Order(AbilityCommand("3xunlian1", 0));
            lv_canTrain = UnitOrderIsValid(lv_producer, lv_trainOrder);
        }
    }

    lv_canTrainStr = "false";
    if (lv_canTrain) {
        lv_canTrainStr = "true";
    }

    lv_context = "structure_type=" + lv_structureType +
        "; structure_count=" + IntToString(lv_structCount) +
        "; worker_type=" + lv_workerType +
        "; worker_count=" + IntToString(lv_workerCount) +
        "; can_train_worker=" + lv_canTrainStr +
        "; producer_has_trainable=" + lv_canTrainStr;

    BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_alenger", "structure_probe", lv_context);
}

//--------------------------------------------------------------------------------------------------
// Alenger3 Command Card Dump: enumerate all abilities on 3diguoqianshaojidi
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_ScanAlengerCommandCard() {
    string lv_structureType = "3diguoqianshaojidi";
    unitgroup lv_structs;
    unit lv_producer;
    int lv_abilityCount;
    int lv_i;
    string lv_abilityId;
    string lv_context;
    bool lv_canIssue;
    int lv_validCount;
    int lv_maxAbilities = 20;

    lv_structs = UnitGroup(lv_structureType, c_playerAny, RegionEntireMap(),
        UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);

    if (UnitGroupCount(lv_structs, c_unitCountAll) == 0) {
        BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_alenger", "command_card", "structure_count=0; no producer to dump");
        return;
    }

    lv_producer = UnitGroupUnit(lv_structs, 1);
    if (lv_producer == null) {
        BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_alenger", "command_card", "producer=null");
        return;
    }

    lv_abilityCount = UnitAbilityCount(lv_producer);
    if (lv_abilityCount > lv_maxAbilities) {
        lv_abilityCount = lv_maxAbilities;
    }

    lv_context = "producer=" + lv_structureType + "; ability_count=" + IntToString(lv_abilityCount) + "; abilities:";
    lv_validCount = 0;

    for (lv_i = 1; lv_i <= lv_abilityCount; lv_i += 1) {
        lv_abilityId = UnitAbilityGet(lv_producer, lv_i);
        if (lv_abilityId != "") {
            lv_canIssue = UnitOrderIsValid(lv_producer, Order(AbilityCommand(lv_abilityId, 0)));
            if (lv_canIssue) {
                lv_validCount = lv_validCount + 1;
                lv_context = lv_context + " " + lv_abilityId + "(T);";
            } else {
                lv_context = lv_context + " " + lv_abilityId + "(F);";
            }
        }
    }

    lv_context = lv_context + " valid_count=" + IntToString(lv_validCount);
    BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_alenger", "command_card", lv_context);
}

//--------------------------------------------------------------------------------------------------
// Alenger3 Worker Build Dump: verify build abilities on 3diguolaogong
// CAbilBuild orders require a target point for UnitOrderIsValid to return
// true. Without OrderSetTargetPoint, every build cmd shows F even when the
// worker actually has the ability and it is unlocked.
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_ScanAlengerWorkerBuild() {
    string lv_workerType = "3diguolaogong";
    unitgroup lv_workers;
    unit lv_worker;
    int lv_workerCount;
    int lv_i;
    int lv_cmd;
    int[12] lv_jianzao1Cmds;
    int[12] lv_jianzao2Cmds;
    int lv_j1Count = 0;
    int lv_j2Count = 0;
    int lv_j1Valid = 0;
    int lv_j2Valid = 0;
    int lv_j1ValidWithPoint = 0;
    int lv_j2ValidWithPoint = 0;
    bool lv_canIssue;
    bool lv_canIssueWithPoint;
    bool lv_hasAbil1;
    bool lv_hasAbil2;
    string lv_hasAbil1Str = "F";
    string lv_hasAbil2Str = "F";
    string lv_canIssueStr = "F";
    string lv_canIssueWithPointStr = "-P";
    string lv_context;
    point lv_workerPos = null;
    order lv_order = null;
    int lv_player;
    bool lv_techAllowed1;
    bool lv_techAllowed2;
    int lv_j1TechAllowed = 0;
    int lv_j2TechAllowed = 0;
    string lv_techAllowedStr = "F";

    lv_jianzao1Cmds[1] = 0; lv_j1Count = 1;
    lv_jianzao1Cmds[2] = 3; lv_j1Count = 2;
    lv_jianzao1Cmds[3] = 10; lv_j1Count = 3;
    lv_jianzao1Cmds[4] = 11; lv_j1Count = 4;

    lv_jianzao2Cmds[1] = 1; lv_j2Count = 1;
    lv_jianzao2Cmds[2] = 4; lv_j2Count = 2;
    lv_jianzao2Cmds[3] = 5; lv_j2Count = 3;
    lv_jianzao2Cmds[4] = 6; lv_j2Count = 4;
    lv_jianzao2Cmds[5] = 9; lv_j2Count = 5;
    lv_jianzao2Cmds[6] = 12; lv_j2Count = 6;
    lv_jianzao2Cmds[7] = 13; lv_j2Count = 7;
    lv_jianzao2Cmds[8] = 15; lv_j2Count = 8;
    lv_jianzao2Cmds[9] = 18; lv_j2Count = 9;

    lv_workers = UnitGroup(lv_workerType, c_playerAny, RegionEntireMap(),
        UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_workerCount = UnitGroupCount(lv_workers, c_unitCountAll);

    if (lv_workerCount == 0) {
        BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_alenger", "worker_build", "worker_count=0; no worker to dump");
        return;
    }

    lv_worker = UnitGroupUnit(lv_workers, 1);
    if (lv_worker == null) {
        BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_alenger", "worker_build", "worker=null");
        return;
    }

    // Check if worker has the build abilities at all. If UnitAbilityExists
    // returns false, the ability was never added to the unit's AbilArray
    // (catalog problem), not a tech tree lock issue.
    lv_hasAbil1 = UnitAbilityExists(lv_worker, "3jianzao1");
    lv_hasAbil2 = UnitAbilityExists(lv_worker, "3jianzao2");
    if (lv_hasAbil1) { lv_hasAbil1Str = "T"; }
    if (lv_hasAbil2) { lv_hasAbil2Str = "T"; }

    // Get worker position for target point. CAbilBuild orders require a
    // target point for UnitOrderIsValid to return true.
    lv_workerPos = UnitGetPosition(lv_worker);
    lv_player = UnitGetOwner(lv_worker);

    lv_context = "worker_count=" + IntToString(lv_workerCount) +
        "; player=" + IntToString(lv_player) +
        "; has_abil1=" + lv_hasAbil1Str + "; has_abil2=" + lv_hasAbil2Str + "; jianzao1:";
    for (lv_i = 1; lv_i <= lv_j1Count; lv_i += 1) {
        lv_cmd = lv_jianzao1Cmds[lv_i];
        lv_canIssue = UnitOrderIsValid(lv_worker, Order(AbilityCommand("3jianzao1", lv_cmd)));
        lv_order = Order(AbilityCommand("3jianzao1", lv_cmd));
        OrderSetTargetPoint(lv_order, lv_workerPos);
        lv_canIssueWithPoint = UnitOrderIsValid(lv_worker, lv_order);
        lv_techAllowed1 = TechTreeAbilityIsAllowed(lv_player, AbilityCommand("3jianzao1", lv_cmd));
        lv_canIssueStr = "F";
        if (lv_canIssue) {
            lv_j1Valid = lv_j1Valid + 1;
            lv_canIssueStr = "T";
        }
        lv_canIssueWithPointStr = "-P";
        if (lv_canIssueWithPoint) {
            lv_j1ValidWithPoint = lv_j1ValidWithPoint + 1;
            lv_canIssueWithPointStr = "+P";
        }
        lv_techAllowedStr = "F";
        if (lv_techAllowed1) {
            lv_j1TechAllowed = lv_j1TechAllowed + 1;
            lv_techAllowedStr = "T";
        }
        lv_context = lv_context + " " + IntToString(lv_cmd) + "=" + lv_canIssueStr +
            lv_canIssueWithPointStr + "/" + lv_techAllowedStr + ";";
    }

    lv_context = lv_context + " jianzao2:";
    for (lv_i = 1; lv_i <= lv_j2Count; lv_i += 1) {
        lv_cmd = lv_jianzao2Cmds[lv_i];
        lv_canIssue = UnitOrderIsValid(lv_worker, Order(AbilityCommand("3jianzao2", lv_cmd)));
        lv_order = Order(AbilityCommand("3jianzao2", lv_cmd));
        OrderSetTargetPoint(lv_order, lv_workerPos);
        lv_canIssueWithPoint = UnitOrderIsValid(lv_worker, lv_order);
        lv_techAllowed2 = TechTreeAbilityIsAllowed(lv_player, AbilityCommand("3jianzao2", lv_cmd));
        lv_canIssueStr = "F";
        if (lv_canIssue) {
            lv_j2Valid = lv_j2Valid + 1;
            lv_canIssueStr = "T";
        }
        lv_canIssueWithPointStr = "-P";
        if (lv_canIssueWithPoint) {
            lv_j2ValidWithPoint = lv_j2ValidWithPoint + 1;
            lv_canIssueWithPointStr = "+P";
        }
        lv_techAllowedStr = "F";
        if (lv_techAllowed2) {
            lv_j2TechAllowed = lv_j2TechAllowed + 1;
            lv_techAllowedStr = "T";
        }
        lv_context = lv_context + " " + IntToString(lv_cmd) + "=" + lv_canIssueStr +
            lv_canIssueWithPointStr + "/" + lv_techAllowedStr + ";";
    }

    lv_context = lv_context + " valid_jianzao1=" + IntToString(lv_j1Valid) +
        "; valid_jianzao2=" + IntToString(lv_j2Valid) +
        "; valid_jianzao1_with_point=" + IntToString(lv_j1ValidWithPoint) +
        "; valid_jianzao2_with_point=" + IntToString(lv_j2ValidWithPoint) +
        "; tech_jianzao1=" + IntToString(lv_j1TechAllowed) +
        "; tech_jianzao2=" + IntToString(lv_j2TechAllowed);
    BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_alenger", "worker_build", lv_context);
}

//--------------------------------------------------------------------------------------------------
// Catalog-based build slot scan: read CAbilBuild InfoArray Unit field for
// each BuildN slot directly from catalog data. This bypasses UnitOrderIsValid
// (which requires a valid placement point) and confirms whether each slot
// is wired to a real unit entry.
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_ScanAlengerWorkerBuildCatalog () {
    string lv_abilId;
    int lv_i;
    int lv_count;
    string lv_unitField;
    string lv_context;
    int lv_filled;

    // 3jianzao1: scan Build1..Build16 (cmd index 0..15)
    lv_abilId = "3jianzao1";
    lv_context = "jianzao1:";
    lv_filled = 0;
    for (lv_i = 0; lv_i <= 15; lv_i += 1) {
        lv_unitField = CatalogFieldValueGet(c_gameCatalogAbil, lv_abilId,
            "InfoArray[Build" + IntToString(lv_i + 1) + "].Unit", 1);
        if (lv_unitField == "") {
            lv_context = lv_context + " B" + IntToString(lv_i + 1) + "=EMPTY;";
        } else {
            lv_context = lv_context + " B" + IntToString(lv_i + 1) + "=" + lv_unitField + ";";
            lv_filled = lv_filled + 1;
        }
    }
    lv_context = lv_context + " filled=" + IntToString(lv_filled);
    BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_alenger", "worker_build_catalog_j1", lv_context);

    // 3jianzao2: scan Build1..Build20 (cmd index 0..19)
    lv_abilId = "3jianzao2";
    lv_context = "jianzao2:";
    lv_filled = 0;
    for (lv_i = 0; lv_i <= 19; lv_i += 1) {
        lv_unitField = CatalogFieldValueGet(c_gameCatalogAbil, lv_abilId,
            "InfoArray[Build" + IntToString(lv_i + 1) + "].Unit", 1);
        if (lv_unitField == "") {
            lv_context = lv_context + " B" + IntToString(lv_i + 1) + "=EMPTY;";
        } else {
            lv_context = lv_context + " B" + IntToString(lv_i + 1) + "=" + lv_unitField + ";";
            lv_filled = lv_filled + 1;
        }
    }
    lv_context = lv_context + " filled=" + IntToString(lv_filled);
    BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_alenger", "worker_build_catalog_j2", lv_context);
}

//--------------------------------------------------------------------------------------------------
// Scan upgrades: iterate upgrade catalog, write researched upgrades
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_ScanUpgrades() {
    int lv_count;
    int lv_i;
    string lv_upgradeId;
    int lv_resCount;
    string lv_key;
    string lv_val;

    // Clear stale entries so removed upgrades do not linger in the Bank.
    libRuntimeProbe_gf_ClearBankSection("probe_upgrades");

    lv_count = CatalogEntryCount(c_gameCatalogUpgrade);
    lv_i = 1;
    while (lv_i <= lv_count) {
        lv_upgradeId = CatalogEntryGet(c_gameCatalogUpgrade, lv_i);
        if (CatalogEntryIsValid(c_gameCatalogUpgrade, lv_upgradeId)) {
            lv_resCount = TechTreeUpgradeCount(1, lv_upgradeId, c_techCountCompleteOnly);
            if (lv_resCount > 0) {
                lv_key = "up_1_" + lv_upgradeId;
                lv_val = "upgrade_id:" + lv_upgradeId +
                    ",researched:1,in_progress:0,available:1,blocked_reason:None";
                BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_upgrades", lv_key, lv_val);
            }
        }
        lv_i = lv_i + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Scan replacement status: detect residual zerg units and expected race mismatch
// 这是判定指挥官替换是否真正成功的核心证据来源
// 写入 probe_replacement section:
//   expected_commander, expected_race, zerg_units_count, terran_units_count, protoss_units_count
//   status: SUCCESS | FAILED_ZERG_RESIDUAL | FAILED_NO_EXPECTED_RACE | UNKNOWN_RACE
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_ScanReplacement () {
    bank lv_coreBank;
    string lv_commander;
    string lv_expectedRace;
    unitgroup lv_all;
    int lv_total;
    int lv_i;
    unit lv_u;
    string lv_type;
    string lv_race;
    int lv_zergCount;
    int lv_terranCount;
    int lv_protossCount;

    // 读取期望指挥官
    lv_coreBank = BankLoad("CampaignXCore", 1);
    if (lv_coreBank == null) {
        BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_replacement", "status", "NO_CORE_BANK");
        return;
    }
    lv_commander = BankValueGetAsString(lv_coreBank, "XMRuntimeControl", "PrimaryCommander");

    // 判定期望种族
    lv_expectedRace = "";
    if ((lv_commander == "Raynor") || (lv_commander == "TerranRaynor") ||
        (lv_commander == "Swann") || (lv_commander == "TerranSwann") ||
        (lv_commander == "Nova") || (lv_commander == "TerranNova") ||
        (lv_commander == "Horner") || (lv_commander == "TerranHorner") ||
        (lv_commander == "Mengsk") || (lv_commander == "TerranMengsk") ||
        (lv_commander == "Tychus") || (lv_commander == "TerranTychus") ||
        (lv_commander == "TychusXM")) {
        lv_expectedRace = "Terran";
    } else if ((lv_commander == "Kerrigan") || (lv_commander == "ZergKerrigan") ||
        (lv_commander == "Abathur") || (lv_commander == "ZergAbathur") ||
        (lv_commander == "Zagara") || (lv_commander == "ZergZagara") ||
        (lv_commander == "Stukov") || (lv_commander == "ZergStukov") ||
        (lv_commander == "Dehaka") || (lv_commander == "ZergDehaka") ||
        (lv_commander == "Stetmann") || (lv_commander == "ZergStetmann")) {
        lv_expectedRace = "Zerg";
    } else if ((lv_commander == "Artanis") || (lv_commander == "ProtossArtanis") ||
        (lv_commander == "Vorazun") || (lv_commander == "ProtossVorazun") ||
        (lv_commander == "Karax") || (lv_commander == "ProtossKarax") ||
        (lv_commander == "Fenix") || (lv_commander == "ProtossFenix") ||
        (lv_commander == "Alarak") || (lv_commander == "ProtossAlarak") ||
        (lv_commander == "Zeratul") || (lv_commander == "ProtossZeratul")) {
        lv_expectedRace = "Protoss";
    }

    // 统计 Player 1 各种族单位
    // 注意：SC2 CatalogFieldValueGet 返回的 Race 值为 "Terr"/"Zerg"/"Prot"，不是 "Terran"/"Zerg"/"Protoss"
    lv_all = UnitGroup(null, 1, RegionEntireMap(),
        UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_total = UnitGroupCount(lv_all, c_unitCountAll);
    lv_zergCount = 0;
    lv_terranCount = 0;
    lv_protossCount = 0;

    lv_i = 1;
    while (lv_i <= lv_total) {
        lv_u = UnitGroupUnit(lv_all, lv_i);
        lv_type = UnitGetType(lv_u);
        lv_race = CatalogFieldValueGet(c_gameCatalogUnit, lv_type, "Race", 1);
        if (lv_race == "Zerg") {
            lv_zergCount = lv_zergCount + 1;
        } else if (lv_race == "Terr") {
            lv_terranCount = lv_terranCount + 1;
        } else if (lv_race == "Prot") {
            lv_protossCount = lv_protossCount + 1;
        }
        lv_i = lv_i + 1;
    }

    // 写入 Bank
    BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_replacement", "expected_commander", lv_commander);
    BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_replacement", "expected_race", lv_expectedRace);
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_replacement", "zerg_units_count", lv_zergCount);
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_replacement", "terran_units_count", lv_terranCount);
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_replacement", "protoss_units_count", lv_protossCount);

    // 判定替换状态
    if (lv_expectedRace == "Terran") {
        if (lv_zergCount > 0) {
            BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_replacement", "status", "FAILED_ZERG_RESIDUAL");
        } else if (lv_terranCount == 0) {
            BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_replacement", "status", "FAILED_NO_TERRAN");
        } else {
            BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_replacement", "status", "SUCCESS");
        }
    } else if (lv_expectedRace == "Protoss") {
        if (lv_zergCount > 0) {
            BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_replacement", "status", "FAILED_ZERG_RESIDUAL");
        } else if (lv_protossCount == 0) {
            BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_replacement", "status", "FAILED_NO_PROTOSS");
        } else {
            BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_replacement", "status", "SUCCESS");
        }
    } else if (lv_expectedRace == "Zerg") {
        // 虫族指挥官：不检查虫族残留，只检查是否有虫族单位
        if (lv_zergCount == 0) {
            BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_replacement", "status", "FAILED_NO_ZERG");
        } else {
            BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_replacement", "status", "SUCCESS");
        }
    } else {
        BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_replacement", "status", "UNKNOWN_RACE");
    }
}

//--------------------------------------------------------------------------------------------------
// Scan production structures: enumerate by type, write probe_producers
// 对每个建筑类型，检查关键生产能力的 UnitOrderIsValid 状态
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_ScanProducers() {
    unitgroup lv_structures;
    int lv_total;
    int lv_unique;
    int lv_i;
    int lv_idx;
    bool lv_found;
    unit lv_u;
    unit lv_sample;
    string lv_type;
    string lv_key;
    string lv_val;
    string lv_trainable;
    int lv_j;
    int lv_k;
    string lv_abil;
    int lv_cmdIdx;
    order lv_order;
    // Alenger3 worker (3diguolaogong) 携带 3jianzao1/3jianzao2 建造能力，
    // 但它不是 Structure 不会被上面的 lv_structures UnitGroup 扫描到。
    // 单独扫描 3diguolaogong 写入 probe_producers，验证 BuildAllow 解锁生效。
    unitgroup lv_workers;
    int lv_workerCount;
    unit lv_worker;
    string lv_wTrainable;
    string lv_wKey;
    string lv_wVal;
    int lv_wk;
    string lv_wAbil;
    order lv_wOrder;

    // Clear stale entries so removed producers do not linger in the Bank.
    libRuntimeProbe_gf_ClearBankSection("probe_producers");

    lv_structures = UnitGroup(null, 1, RegionEntireMap(),
        UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_total = UnitGroupCount(lv_structures, c_unitCountAll);
    lv_unique = 0;

    lv_i = 1;
    while (lv_i <= lv_total) {
        lv_u = UnitGroupUnit(lv_structures, lv_i);
        lv_type = UnitGetType(lv_u);

        lv_idx = 1;
        lv_found = false;
        while (lv_idx <= lv_unique) {
            if (libRuntimeProbe_gv_producerTypes[lv_idx] == lv_type) {
                libRuntimeProbe_gv_producerCounts[lv_idx] = libRuntimeProbe_gv_producerCounts[lv_idx] + 1;
                lv_found = true;
                break;
            }
            lv_idx = lv_idx + 1;
        }
        if (!lv_found) {
            if (lv_unique < 127) {
                lv_unique = lv_unique + 1;
                libRuntimeProbe_gv_producerTypes[lv_unique] = lv_type;
                libRuntimeProbe_gv_producerCounts[lv_unique] = 1;
            }
        }
        lv_i = lv_i + 1;
    }

    lv_j = 1;
    while (lv_j <= lv_unique) {
        lv_key = "p_1_" + libRuntimeProbe_gv_producerTypes[lv_j];
        lv_trainable = "";

        // 取该类型的第一个实例作为样本，检测生产能力
        lv_sample = null;
        lv_i = 1;
        while (lv_i <= lv_total) {
            lv_u = UnitGroupUnit(lv_structures, lv_i);
            if (UnitGetType(lv_u) == libRuntimeProbe_gv_producerTypes[lv_j]) {
                lv_sample = lv_u;
                break;
            }
            lv_i = lv_i + 1;
        }

        if (lv_sample != null) {
            // 根据建筑类型检测关键生产能力
            // 注意：AbilityCommand 的 index 对应 InfoArray 的 Train1=0, Train2=1, ...
            // BarracksRaynor: BarracksTrainRaynor (Train1=Marine, Train4=Marauder, Train5=Medic, Train6=Firebat)
            if (libRuntimeProbe_gv_producerTypes[lv_j] == "BarracksRaynor") {
                lv_abil = "BarracksTrainRaynor";
                lv_k = 0;
                while (lv_k <= 7) {
                    lv_order = Order(AbilityCommand(lv_abil, lv_k));
                    if (UnitOrderIsValid(lv_sample, lv_order)) {
                        if (lv_trainable != "") { lv_trainable = lv_trainable + "|"; }
                        lv_trainable = lv_trainable + lv_abil + ":" + IntToString(lv_k);
                    }
                    lv_k = lv_k + 1;
                }
            }
            // OrbitalCommandRaynor / CommandCenterRaynor: CommandCenterTrainRaynor (Train1=SCV)
            else if ((libRuntimeProbe_gv_producerTypes[lv_j] == "OrbitalCommandRaynor") ||
                     (libRuntimeProbe_gv_producerTypes[lv_j] == "CommandCenterRaynor")) {
                lv_abil = "CommandCenterTrainRaynor";
                lv_k = 0;
                while (lv_k <= 3) {
                    lv_order = Order(AbilityCommand(lv_abil, lv_k));
                    if (UnitOrderIsValid(lv_sample, lv_order)) {
                        if (lv_trainable != "") { lv_trainable = lv_trainable + "|"; }
                        lv_trainable = lv_trainable + lv_abil + ":" + IntToString(lv_k);
                    }
                    lv_k = lv_k + 1;
                }
                // 也检查原版 CommandCenterTrain
                lv_abil = "CommandCenterTrain";
                lv_k = 0;
                while (lv_k <= 3) {
                    lv_order = Order(AbilityCommand(lv_abil, lv_k));
                    if (UnitOrderIsValid(lv_sample, lv_order)) {
                        if (lv_trainable != "") { lv_trainable = lv_trainable + "|"; }
                        lv_trainable = lv_trainable + lv_abil + ":" + IntToString(lv_k);
                    }
                    lv_k = lv_k + 1;
                }
            }
            // BarracksRaynorX: 检测 BarracksTrainRaynorX (RaynorX 版本生产能力)
            else if (libRuntimeProbe_gv_producerTypes[lv_j] == "BarracksRaynorX") {
                lv_abil = "BarracksTrainRaynorX";
                lv_k = 0;
                while (lv_k <= 7) {
                    lv_order = Order(AbilityCommand(lv_abil, lv_k));
                    if (UnitOrderIsValid(lv_sample, lv_order)) {
                        if (lv_trainable != "") { lv_trainable = lv_trainable + "|"; }
                        lv_trainable = lv_trainable + lv_abil + ":" + IntToString(lv_k);
                    }
                    lv_k = lv_k + 1;
                }
            }
            // Barracks (原版，已被 TechFilter 屏蔽原版单位，trainable 预期为空)
            else if (libRuntimeProbe_gv_producerTypes[lv_j] == "Barracks") {
                lv_abil = "BarracksTrain";
                lv_k = 0;
                while (lv_k <= 7) {
                    lv_order = Order(AbilityCommand(lv_abil, lv_k));
                    if (UnitOrderIsValid(lv_sample, lv_order)) {
                        if (lv_trainable != "") { lv_trainable = lv_trainable + "|"; }
                        lv_trainable = lv_trainable + lv_abil + ":" + IntToString(lv_k);
                    }
                    lv_k = lv_k + 1;
                }
            }
            // 3diguoqianshaojidi (Alenger3 前哨基地): 检测 3jianzao1/3jianzao2 建造 + 3xunlian1 训练
            // 用于验证 Alenger3Adapter 的 TechTreeAbilityAllow 是否真正生效
            else if (libRuntimeProbe_gv_producerTypes[lv_j] == "3diguoqianshaojidi") {
                lv_abil = "3jianzao1";
                lv_k = 0;
                while (lv_k <= 18) {
                    lv_order = Order(AbilityCommand(lv_abil, lv_k));
                    if (UnitOrderIsValid(lv_sample, lv_order)) {
                        if (lv_trainable != "") { lv_trainable = lv_trainable + "|"; }
                        lv_trainable = lv_trainable + lv_abil + ":" + IntToString(lv_k);
                    }
                    lv_k = lv_k + 1;
                }
                lv_abil = "3jianzao2";
                lv_k = 0;
                while (lv_k <= 18) {
                    lv_order = Order(AbilityCommand(lv_abil, lv_k));
                    if (UnitOrderIsValid(lv_sample, lv_order)) {
                        if (lv_trainable != "") { lv_trainable = lv_trainable + "|"; }
                        lv_trainable = lv_trainable + lv_abil + ":" + IntToString(lv_k);
                    }
                    lv_k = lv_k + 1;
                }
                lv_abil = "3xunlian1";
                lv_k = 0;
                while (lv_k <= 31) {
                    lv_order = Order(AbilityCommand(lv_abil, lv_k));
                    if (UnitOrderIsValid(lv_sample, lv_order)) {
                        if (lv_trainable != "") { lv_trainable = lv_trainable + "|"; }
                        lv_trainable = lv_trainable + lv_abil + ":" + IntToString(lv_k);
                    }
                    lv_k = lv_k + 1;
                }
            }
            // 3diguolaogong (Alenger3 劳工/worker): 检测 3jianzao1/3jianzao2 建造能力
            // 3jianzao1/3jianzao2 是 CAbilBuild，挂在 3diguolaogong 单位上（不在 3diguoqianshaojidi 上）
            // 通过 BuildAllow 列表解锁: 3jianzao1 cmd 0/3/10/11/14, 3jianzao2 cmd 1/4/5/6/9/12/13/14/15/18
            else if (libRuntimeProbe_gv_producerTypes[lv_j] == "3diguolaogong") {
                lv_abil = "3jianzao1";
                lv_k = 0;
                while (lv_k <= 18) {
                    lv_order = Order(AbilityCommand(lv_abil, lv_k));
                    if (UnitOrderIsValid(lv_sample, lv_order)) {
                        if (lv_trainable != "") { lv_trainable = lv_trainable + "|"; }
                        lv_trainable = lv_trainable + lv_abil + ":" + IntToString(lv_k);
                    }
                    lv_k = lv_k + 1;
                }
                lv_abil = "3jianzao2";
                lv_k = 0;
                while (lv_k <= 18) {
                    lv_order = Order(AbilityCommand(lv_abil, lv_k));
                    if (UnitOrderIsValid(lv_sample, lv_order)) {
                        if (lv_trainable != "") { lv_trainable = lv_trainable + "|"; }
                        lv_trainable = lv_trainable + lv_abil + ":" + IntToString(lv_k);
                    }
                    lv_k = lv_k + 1;
                }
            }
        }

        lv_val = "producer_count:" + IntToString(libRuntimeProbe_gv_producerCounts[lv_j]) +
            ",trainable:" + lv_trainable +
            ",blocked:,queue:,last_order:None";
        BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_producers", lv_key, lv_val);
        lv_j = lv_j + 1;
    }

    // Alenger3 worker (3diguolaogong) 携带 3jianzao1/3jianzao2 建造能力，
    // 但它不是 Structure 不会被上面的 lv_structures UnitGroup 扫描到。
    // 单独扫描 3diguolaogong 写入 probe_producers，验证 BuildAllow 解锁生效。
    lv_workers = UnitGroup("3diguolaogong", 1, RegionEntireMap(),
        UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_workerCount = UnitGroupCount(lv_workers, c_unitCountAll);
    if (lv_workerCount > 0) {
        lv_worker = UnitGroupUnit(lv_workers, 1);
        lv_wTrainable = "";
        lv_wKey = "p_1_3diguolaogong";
        // 3jianzao1: cmd 0-18 (BuildAllow: 0,3,10,11,14)
        lv_wAbil = "3jianzao1";
        lv_wk = 0;
        while (lv_wk <= 18) {
            lv_wOrder = Order(AbilityCommand(lv_wAbil, lv_wk));
            if (UnitOrderIsValid(lv_worker, lv_wOrder)) {
                if (lv_wTrainable != "") { lv_wTrainable = lv_wTrainable + "|"; }
                lv_wTrainable = lv_wTrainable + lv_wAbil + ":" + IntToString(lv_wk);
            }
            lv_wk = lv_wk + 1;
        }
        // 3jianzao2: cmd 0-18 (BuildAllow: 1,4,5,6,9,12,13,14,15,18)
        lv_wAbil = "3jianzao2";
        lv_wk = 0;
        while (lv_wk <= 18) {
            lv_wOrder = Order(AbilityCommand(lv_wAbil, lv_wk));
            if (UnitOrderIsValid(lv_worker, lv_wOrder)) {
                if (lv_wTrainable != "") { lv_wTrainable = lv_wTrainable + "|"; }
                lv_wTrainable = lv_wTrainable + lv_wAbil + ":" + IntToString(lv_wk);
            }
            lv_wk = lv_wk + 1;
        }
        lv_wVal = "producer_count:" + IntToString(lv_workerCount) +
            ",trainable:" + lv_wTrainable +
            ",blocked:,queue:,last_order:None";
        BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_producers", lv_wKey, lv_wVal);
    }
}

//--------------------------------------------------------------------------------------------------
// Scan tech availability: check if key Raynor abilities are allowed
// Uses TechTreeAbilityIsAllowed to check build/train/research abilities
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_ScanTechAvailability() {
    int lv_i;
    int lv_allowed;
    int lv_count;
    string lv_key;
    string lv_abil;
    int lv_cmdIdx;
    string[32] lv_abilNames;
    int[32] lv_abilMaxCmd;
    string[32] lv_upgrades;

    // Clear stale entries
    libRuntimeProbe_gf_ClearBankSection("probe_tech");

    // Check key build/train/research abilities via TechTreeAbilityIsAllowed
    // Each entry: ability name + max cmd index to check
    lv_abilNames[1] = "TerranBuildRaynor";          lv_abilMaxCmd[1] = 16;
    lv_abilNames[2] = "BarracksTrainRaynor";         lv_abilMaxCmd[2] = 5;
    lv_abilNames[3] = "BarracksTrainRaynorX";        lv_abilMaxCmd[3] = 6;
    lv_abilNames[4] = "FactoryTrainRaynor";          lv_abilMaxCmd[4] = 9;
    lv_abilNames[5] = "StarportTrainRaynor";         lv_abilMaxCmd[5] = 4;
    lv_abilNames[6] = "EngineeringBayResearchRaynor"; lv_abilMaxCmd[6] = 21;
    lv_abilNames[7] = "ArmoryResearchRaynor";        lv_abilMaxCmd[7] = 9;
    lv_abilNames[8] = "BarracksTechLabResearchRaynor"; lv_abilMaxCmd[8] = 15;
    lv_abilNames[9] = "FactoryTechLabResearchRaynor"; lv_abilMaxCmd[9] = 15;
    lv_abilNames[10] = "StarportTechLabResearchRaynor"; lv_abilMaxCmd[10] = 18;
    lv_abilNames[11] = "CommandCenterTrainRaynor";   lv_abilMaxCmd[11] = 0;
    lv_abilNames[12] = "UpgradeToOrbitalRaynor";     lv_abilMaxCmd[12] = 0;
    lv_abilNames[13] = "BarracksAddOnsRaynor";       lv_abilMaxCmd[13] = 3;
    lv_abilNames[14] = "FactoryAddOnsRaynor";        lv_abilMaxCmd[14] = 3;
    lv_abilNames[15] = "StarportAddOnsRaynor";       lv_abilMaxCmd[15] = 3;
    // Alenger3 key abilities — verify TechTreeAbilityAllow from Alenger3Adapter
    // 3jianzao1: builder ability on 3diguolaogong (BuildAllow: cmd 0,3,10,11,14)
    lv_abilNames[16] = "3jianzao1";                  lv_abilMaxCmd[16] = 18;
    // 3jianzao2: builder ability on 3diguolaogong (BuildAllow: cmd 1,4,5,6,9,12,13,14,15,18)
    lv_abilNames[17] = "3jianzao2";                  lv_abilMaxCmd[17] = 18;
    // 3xunlian1: training ability on 3diguoqianshaojidi and other Alenger3 structures
    lv_abilNames[18] = "3xunlian1";                  lv_abilMaxCmd[18] = 31;
    // 3bianxingweihuangjiayaosai: morph 3diguoqianshaojidi -> 3huangjiayaosai
    lv_abilNames[19] = "3bianxingweihuangjiayaosai"; lv_abilMaxCmd[19] = 0;
    // 3bianxingweidiguozhihuizhongxin: morph 3diguoqianshaojidi -> 3diguozhihuizhongxin
    lv_abilNames[20] = "3bianxingweidiguozhihuizhongxin"; lv_abilMaxCmd[20] = 0;
    // 3shengkong1: lift off (3diguoqianshaojidi -> 3diguoqianshaojidiFlying)
    lv_abilNames[21] = "3shengkong1";                lv_abilMaxCmd[21] = 0;

    lv_i = 1;
    while (lv_i <= 21) {
        lv_abil = lv_abilNames[lv_i];
        if (lv_abil != "" && CatalogEntryIsValid(c_gameCatalogAbil, lv_abil)) {
            lv_cmdIdx = 0;
            while (lv_cmdIdx <= lv_abilMaxCmd[lv_i]) {
                if (TechTreeAbilityIsAllowed(1, AbilityCommand(lv_abil, lv_cmdIdx))) {
                    lv_key = "a_" + lv_abil + "_" + IntToString(lv_cmdIdx);
                    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_tech", lv_key, 1);
                }
                lv_cmdIdx = lv_cmdIdx + 1;
            }
        }
        lv_i = lv_i + 1;
    }

    // Check key upgrade availability (researched count)
    lv_upgrades[1] = "Stimpack";
    lv_upgrades[2] = "ShieldWall";
    lv_upgrades[3] = "TerranInfantryWeaponsLevel1";
    lv_upgrades[4] = "TerranInfantryArmorsLevel1";
    lv_upgrades[5] = "TerranVehicleAndShipWeaponsLevel1";
    lv_upgrades[6] = "TerranVehicleAndShipPlatingLevel1";
    lv_upgrades[7] = "HiSecAutoTracking";
    lv_upgrades[8] = "NeosteelFrame";
    lv_upgrades[9] = "BuildingArmor";
    lv_upgrades[10] = "RaynorCommanderStimUpgrade";
    lv_upgrades[11] = "RaynorFirebatMedicRange";
    lv_upgrades[12] = "RaynorUnlockBattlecruiser";

    lv_i = 1;
    while (lv_i <= 12) {
        if (lv_upgrades[lv_i] != "" && CatalogEntryIsValid(c_gameCatalogUpgrade, lv_upgrades[lv_i])) {
            lv_count = TechTreeUpgradeCount(1, lv_upgrades[lv_i], c_techCountCompleteOnly);
            BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_tech", "up_" + lv_upgrades[lv_i], lv_count);
        }
        lv_i = lv_i + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// ScanUI: 采集 GlobalCastingPanel 顶部技能面板的 UI 控件状态
// 两套查询方式:
//   1. DialogControlHookupStandard (按完整路径) → 可能找到 libKCUI 创建的另一套面板
//   2. DialogControlHookup (在父控件内按名称) → 找到 lib67C0F0E7 创建的真正面板
// 写入 probe_ui section (path 前缀=路径查询) 和 probe_ui_real section (hookup=内部查询)
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_ScanUI() {
    int lv_holder;
    int lv_panel;
    int lv_cutscene;
    int lv_btnholder;
    int lv_cmdpanel;
    int lv_btn;
    int lv_real_panel;
    int lv_real_cutscene;
    int lv_real_btnholder;
    int lv_real_cmdpanel;

    if (libRuntimeProbe_gv_bank == null) {
        return;
    }

    libRuntimeProbe_gf_ClearBankSection("probe_ui");
    libRuntimeProbe_gf_ClearBankSection("probe_ui_real");

    // === 方法1: DialogControlHookupStandard (按完整路径查询) ===

    // 1a. GlobalCastingPanel holder
    DialogControlHookupStandard(c_triggerControlTypePanel, "UIContainer/FullscreenUpperContainer/GlobalCastingPanel");
    lv_holder = DialogControlLastCreated();
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_ui", "gp_holder_id", lv_holder);
    BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui", "gp_holder_exists", (lv_holder != c_invalidDialogControlId));
    if (lv_holder != c_invalidDialogControlId) {
        BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui", "gp_holder_visible", true);
    }

    // 1b. TerranCasterPanelTemplate (路径查询)
    DialogControlHookupStandard(c_triggerControlTypePanel, "UIContainer/FullscreenUpperContainer/GlobalCastingPanel/Coop_GlobalCastingTemplates/TerranCasterPanelTemplate");
    lv_panel = DialogControlLastCreated();
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_ui", "gp_panel_id", lv_panel);
    BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui", "gp_panel_exists", (lv_panel != c_invalidDialogControlId));
    if (lv_panel != c_invalidDialogControlId) {
        BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui", "gp_panel_visible", true);
    }

    // 1c. TerranCommandCutscene (路径查询)
    DialogControlHookupStandard(c_triggerControlTypeCutscene, "UIContainer/FullscreenUpperContainer/GlobalCastingPanel/Coop_GlobalCastingTemplates/TerranCasterPanelTemplate/TerranCommandCutscene");
    lv_cutscene = DialogControlLastCreated();
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_ui", "gp_cutscene_id", lv_cutscene);
    BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui", "gp_cutscene_exists", (lv_cutscene != c_invalidDialogControlId));
    if (lv_cutscene != c_invalidDialogControlId) {
        BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui", "gp_cutscene_visible", true);
    }

    // 1d. ButtonHolder (路径查询)
    DialogControlHookupStandard(c_triggerControlTypePanel, "UIContainer/FullscreenUpperContainer/GlobalCastingPanel/Coop_GlobalCastingTemplates/TerranCasterPanelTemplate/ButtonHolder");
    lv_btnholder = DialogControlLastCreated();
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_ui", "gp_btnholder_id", lv_btnholder);
    BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui", "gp_btnholder_exists", (lv_btnholder != c_invalidDialogControlId));
    if (lv_btnholder != c_invalidDialogControlId) {
        BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui", "gp_btnholder_visible", true);
    }

    // 1e. RaynorGlobalCommandPanel (路径查询)
    DialogControlHookupStandard(c_triggerControlTypeCommandPanel, "UIContainer/FullscreenUpperContainer/GlobalCastingPanel/Coop_GlobalCastingTemplates/TerranCasterPanelTemplate/ButtonHolder/RaynorGlobalCommandPanelTemplate");
    lv_cmdpanel = DialogControlLastCreated();
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_ui", "gp_cmdpanel_id", lv_cmdpanel);
    BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui", "gp_cmdpanel_exists", (lv_cmdpanel != c_invalidDialogControlId));
    if (lv_cmdpanel != c_invalidDialogControlId) {
        BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui", "gp_cmdpanel_visible", true);
    }

    // 1f. ArmySelectButton
    DialogControlHookupStandard(c_triggerControlTypeButton, "UIContainer/ConsoleUIContainer/ArmySelectButton");
    lv_btn = DialogControlLastCreated();
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_ui", "army_btn_id", lv_btn);
    BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui", "army_btn_exists", (lv_btn != c_invalidDialogControlId));
    if (lv_btn != c_invalidDialogControlId) {
        BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui", "army_btn_visible", true);
    }

    // === 方法2: DialogControlHookup (在父控件内按名称查找 lib67C0F0E7 创建的真正面板) ===
    // holder 是两套共用的，ID 一致
    if (false && (lv_holder != c_invalidDialogControlId)) {
        // 2a. TerranCasterPanelTemplate - 在 holder 内查找
        DialogControlHookup(lv_holder, c_triggerControlTypePanel, "TerranCasterPanelTemplate");
        lv_real_panel = DialogControlLastCreated();
        BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_ui_real", "gp_panel_id", lv_real_panel);
        BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui_real", "gp_panel_exists", (lv_real_panel != c_invalidDialogControlId));
        if (lv_real_panel != c_invalidDialogControlId) {
            BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui_real", "gp_panel_visible", true);
        }

        // 2b. TerranCommandCutscene - 在 panel 内查找
        if (lv_real_panel != c_invalidDialogControlId) {
            DialogControlHookup(lv_real_panel, c_triggerControlTypeCutscene, "TerranCommandCutscene");
            lv_real_cutscene = DialogControlLastCreated();
            BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_ui_real", "gp_cutscene_id", lv_real_cutscene);
            BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui_real", "gp_cutscene_exists", (lv_real_cutscene != c_invalidDialogControlId));
            if (lv_real_cutscene != c_invalidDialogControlId) {
                BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui_real", "gp_cutscene_visible", true);
            }

            // 2c. ButtonHolder - 在 panel 内查找
            DialogControlHookup(lv_real_panel, c_triggerControlTypePanel, "ButtonHolder");
            lv_real_btnholder = DialogControlLastCreated();
            BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_ui_real", "gp_btnholder_id", lv_real_btnholder);
            BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui_real", "gp_btnholder_exists", (lv_real_btnholder != c_invalidDialogControlId));
            if (lv_real_btnholder != c_invalidDialogControlId) {
                BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui_real", "gp_btnholder_visible", true);

                // 2d. RaynorGlobalCommandPanelTemplate - 在 btnholder 内查找
                DialogControlHookup(lv_real_btnholder, c_triggerControlTypeCommandPanel, "RaynorGlobalCommandPanelTemplate");
                lv_real_cmdpanel = DialogControlLastCreated();
                BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_ui_real", "gp_cmdpanel_id", lv_real_cmdpanel);
                BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui_real", "gp_cmdpanel_exists", (lv_real_cmdpanel != c_invalidDialogControlId));
                if (lv_real_cmdpanel != c_invalidDialogControlId) {
                    BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui_real", "gp_cmdpanel_visible", true);
                }
            }
        }
    }

    // 对比: 记录两套控件的 ID 差异
    BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui_real", "panel_id_mismatch", (lv_panel != lv_real_panel));
    BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui_real", "cmdpanel_id_mismatch", (lv_cmdpanel != lv_real_cmdpanel));

    // === 方法3: 直接检查 probe_raynor 中记录的真实控件 ID 的可见性 ===
    // probe_raynor 由 RaynorRuntimeInit 在 GPInit/GPShowHide 时写入
    // 这些 ID 是 lib67C0F0E7 全局变量中的真正控件 ID
    lv_real_panel = BankValueGetAsInt(libRuntimeProbe_gv_bank, "probe_raynor", "gpshowhide_panel");
    lv_real_cmdpanel = BankValueGetAsInt(libRuntimeProbe_gv_bank, "probe_raynor", "gpshowhide_cmdpanel");
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_ui_real", "true_panel_id", lv_real_panel);
    BankValueSetFromInt(libRuntimeProbe_gv_bank, "probe_ui_real", "true_cmdpanel_id", lv_real_cmdpanel);
    if (lv_real_panel > 0) {
        BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui_real", "true_panel_visible", true);
    }
    if (lv_real_cmdpanel > 0) {
        BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_ui_real", "true_cmdpanel_visible", true);
    }
}

//--------------------------------------------------------------------------------------------------
// Periodic loop: 每次周期事件执行一次全量扫描 + 批量 BankSave
//--------------------------------------------------------------------------------------------------
bool libRuntimeProbe_gt_Loop_Func(bool testConds, bool runActions) {
    if (testConds) {
        return true;
    }
    if (!runActions) {
        return true;
    }

    if (libRuntimeProbe_gf_TryLoadBank()) {
        libRuntimeProbe_gf_WriteState();
        libRuntimeProbe_gf_ScanUnits();
        libRuntimeProbe_gf_ScanUpgrades();
        libRuntimeProbe_gf_ScanProducers();
        libRuntimeProbe_gf_ScanReplacement();
        libRuntimeProbe_gf_ScanTechAvailability();
        libRuntimeProbe_gf_ScanUI();
        libRuntimeProbe_gf_ScanAlengerPresence();
        libRuntimeProbe_gf_ScanAlengerStructures();
        libRuntimeProbe_gf_ScanAlengerCommandCard();
        libRuntimeProbe_gf_ScanAlengerWorkerBuild();
        libRuntimeProbe_gf_ScanAlengerWorkerBuildCatalog();
        BankSave(libRuntimeProbe_gv_bank);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// MapInit: try BankLoad immediately (Loop trigger is created in InitLib, started by StartProbe).
//--------------------------------------------------------------------------------------------------
bool libRuntimeProbe_gt_MapInit_Func(bool testConds, bool runActions) {
    if (testConds) {
        return true;
    }
    if (runActions) {
        // Try to load the bank during MapInit (in case InitLib's BankLoad failed).
        libRuntimeProbe_gf_TryLoadBank();
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// StartProbe: perform an immediate state write and start the periodic loop.
// Called from gt_Initialization_Func (injected by launch script) after
// InitializeConfiguredMapScenario completes.
//
// 首次全量扫描后注册每 3 秒触发一次的 Loop_Func。
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_gf_StartProbe() {
    if (!libRuntimeProbe_initialized) {
        libRuntimeProbe_InitLib();
    }

    // Immediate state write so the Bank has fresh data right away.
    if (libRuntimeProbe_gf_TryLoadBank()) {
        BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_state", "run_id", "startprobe");
        BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_state", "phase", "replacement_complete");
        libRuntimeProbe_gf_WriteState();
        libRuntimeProbe_gf_ScanUnits();
        libRuntimeProbe_gf_ScanUpgrades();
        libRuntimeProbe_gf_ScanProducers();
        libRuntimeProbe_gf_ScanReplacement();
        libRuntimeProbe_gf_ScanTechAvailability();
        libRuntimeProbe_gf_ScanUI();
        libRuntimeProbe_gf_ScanAlengerPresence();
        libRuntimeProbe_gf_ScanAlengerStructures();
        libRuntimeProbe_gf_ScanAlengerCommandCard();
        libRuntimeProbe_gf_ScanAlengerWorkerBuild();
        libRuntimeProbe_gf_ScanAlengerWorkerBuildCatalog();
        BankValueSetFromFlag(libRuntimeProbe_gv_bank, "probe_state", "replacement_complete", true);
        BankSave(libRuntimeProbe_gv_bank);
    }

    TriggerAddEventTimePeriodic(libRuntimeProbe_gt_Loop, 3.0, c_timeReal);
}

//--------------------------------------------------------------------------------------------------
// InitLib: create triggers and attempt BankLoad.
// Loop_Func 的周期事件由 StartProbe 注册，确保只在探针启用时运行。
//--------------------------------------------------------------------------------------------------
void libRuntimeProbe_InitLib() {
    if (libRuntimeProbe_initialized) {
        return;
    }
    libRuntimeProbe_gt_MapInit = TriggerCreate("libRuntimeProbe_gt_MapInit_Func");
    TriggerAddEventMapInit(libRuntimeProbe_gt_MapInit);
    libRuntimeProbe_gt_Loop = TriggerCreate("libRuntimeProbe_gt_Loop_Func");

    // Direct BankLoad attempt during InitLib — verifies the Bank system is operational.
    libRuntimeProbe_gv_bank = BankLoad("RuntimeProbe", 1);
    if (libRuntimeProbe_gv_bank != null) {
        libRuntimeProbe_gf_ClearBankSection("probe_state");
        BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_state", "run_id", "initlib");
        BankValueSetFromString(libRuntimeProbe_gv_bank, "probe_state", "phase", "initlib_ok");
        BankSave(libRuntimeProbe_gv_bank);
    }

    libRuntimeProbe_initialized = true;
}
