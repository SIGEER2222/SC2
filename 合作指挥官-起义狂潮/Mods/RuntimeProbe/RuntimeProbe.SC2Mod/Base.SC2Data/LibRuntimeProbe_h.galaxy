include "TriggerLibs/natives"

//--------------------------------------------------------------------------------------------------
// Library: RuntimeProbe
// Phase 1: NoActionProbe - heartbeat, unit scan, upgrade scan
// Phase 2: Producer scan - structure count
// ASCII only for all internal IDs, variable names, and Bank keys.
//--------------------------------------------------------------------------------------------------

bool    libRuntimeProbe_initialized;
bank    libRuntimeProbe_gv_bank;
int     libRuntimeProbe_gv_heartbeat;
int     libRuntimeProbe_gv_scanId;
int     libRuntimeProbe_gv_unitScanCounter;
int     libRuntimeProbe_gv_upgradeScanCounter;
int     libRuntimeProbe_gv_producerScanCounter;
trigger libRuntimeProbe_gt_MapInit;
trigger libRuntimeProbe_gt_Loop;

// Global arrays for unit aggregation (Galaxy does not support local arrays)
// Galaxy array declaration syntax: type[size] varname;
string[256] libRuntimeProbe_gv_unitTypes;
int[256]    libRuntimeProbe_gv_unitCounts;
int[256]    libRuntimeProbe_gv_unitLifeSum;
int[256]    libRuntimeProbe_gv_unitEnergySum;

// Global arrays for producer aggregation
string[128] libRuntimeProbe_gv_producerTypes;
int[128]    libRuntimeProbe_gv_producerCounts;

void libRuntimeProbe_InitLib();
bool libRuntimeProbe_gf_TryLoadBank();
void libRuntimeProbe_gf_WriteState();
void libRuntimeProbe_gf_ScanUnits();
void libRuntimeProbe_gf_ScanUpgrades();
void libRuntimeProbe_gf_ScanProducers();
void libRuntimeProbe_gf_StartProbe();
bool libRuntimeProbe_gt_MapInit_Func(bool testConds, bool runActions);
bool libRuntimeProbe_gt_Loop_Func(bool testConds, bool runActions);
