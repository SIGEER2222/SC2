* text=auto

# Keep Windows scripts runnable in local shells.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Core text assets in normalized form.
*.md text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.version text eol=lf
*.galaxy text eol=lf
*.SC2Components text eol=lf
*.SC2Layout text eol=lf
*.SC2Style text eol=lf

# Binary assets.
*.dds binary
*.tga binary
*.jpg binary
*.jpeg binary
*.png binary
*.m3 binary
*.ogg binary
*.wav binary
